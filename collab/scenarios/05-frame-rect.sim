# Story: someone frames what they care about by drawing a rectangle around it
# (the ⌃⌥-drag sends exactly this command). Reference: T38.
open Safari
open Notes
open Mail
dock 101 left
dock 102 right
dock 103 beside 101 bottom
# A rectangle around Safari frames Safari.
frame-rect 12 37 472 400
expect ok
expect camera 101
expect hidden 102
back
expect camera root
# Too small to mean anything.
frame-rect 600 400 30 30
expect fail
# A rectangle around the left column frames the column.
frame-rect 12 37 472 851
expect ok
expect visible 101
expect visible 103
expect hidden 102
