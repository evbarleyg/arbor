# Story: the ten things of scenario 90 once more, on the display of a larger laptop,
# with windows that refuse to be smaller than the real apps do (Safari, Terminal and Notes measured by the compatibility lab; the chat as measured on Slack).
# A third of that display is 560 points and Safari stops at 574: without F61, which makes room before it makes a tile, step 1 ends
# with the browser as a tile and the tour falls apart.
# Reference: T01 T02 T03 T10 T17 T20 T30 T32 T34 T40, A01 A05 A40 A41 A42 A51; F61. Window ids start at 101.
# The three tiling switches of the guide's section 2 are off: with macOS's own tiling on, the left, right and top edges of the screen are macOS's (Q23).
# As the first build shipped it: the whole map of shortcuts, of which nine ship now (22-nine-keys.sim).
set shortcuts all
mac-tiling off
display-size 1728x1117 33
open Safari 1324x800 min 574x240
open Terminal 585x400 min 177x100
open Slack 1100x750 min 760x500
open Notes 1000x660 min 709x300
# 1. Dock: drag Safari to the left edge of the screen and Terminal to the right one: two halves. The rest floats, over them.
drag 101 2 400 cmd
expect docked 101
drag 102 1726 400 cmd
expect docked 102
expect left-of 101 102
expect floating 103
expect floating 104
expect visible 103
expect visible 104
# 2. Frame: ⌃⌥↩ on Safari. The others are out of view, not closed. The same keys again return.
focus 101
key ctrl+opt+return
expect fills 101
expect hidden 102
expect hidden 103
key ctrl+opt+return
expect camera root
expect visible 102
expect visible 103
# 3. Walk: framed again, ⌃⌥→ goes to Terminal; ⌃⌥[ goes back like a browser.
key ctrl+opt+return
key ctrl+opt+right
expect camera 102
key ctrl+opt+[
expect camera 101
key ctrl+opt+space
expect camera root
# 4. A group: drag Slack onto the lower half of Terminal. ⌃⌥↩ frames Slack, ⌃⌥↑ steps out to the two of them.
#    Then everything, and the gap between the two is dragged upwards: both change size, nothing overlaps.
drag 103 1500 950 cmd
expect docked 103
expect above 102 103
focus 103
key ctrl+opt+return
expect fills 103
key ctrl+opt+up
expect visible 102
expect visible 103
expect hidden 101
key ctrl+opt+space
seam 0 -120
expect ok
expect above 102 103
# 5. Numbers: ⌃⌥⇧1 on Safari framed; ⌃⌥Space, Terminal framed, ⌃⌥↑, ⌃⌥⇧2 on the group; then ⌃⌥1 and ⌃⌥2 from anywhere.
focus 101
key ctrl+opt+return
key ctrl+opt+shift+1
# By way of everything: what a switch from one framed window to another does is step 7's business.
key ctrl+opt+space
focus 102
key ctrl+opt+return
key ctrl+opt+up
key ctrl+opt+shift+2
key ctrl+opt+1
expect fills 101
key ctrl+opt+2
expect visible 102
expect visible 103
expect hidden 101
key ctrl+opt+1
# 6. Peek: hold ⌃⌥Space, point at Terminal, let go.
cursor 300 400
keydown ctrl+opt+space
wait 0.4
expect camera root
cursor 1500 200
wait 0.1
expect outline 102
keyup ctrl+opt+space
expect fills 102
# 7. ⌘Tab to Safari, which is out of view: the view moves to show it.
expect hidden 101
focus 101
expect visible 101
# 8. The keyboard arranges too: ⌃⌥⌘← docks Notes at the left edge, ⌃⌥⌘→ moves it one place to the right, ⌃⌥F floats it.
key ctrl+opt+0
focus 104
key ctrl+opt+cmd+left
expect docked 104
expect visible 104
# Notes 709, Safari 574, the chat 760 and a Desktop do not fit this display: the window docked first is the tile. Nothing is lost.
expect tile 101
key ctrl+opt+cmd+right
expect docked 104
expect visible 104
expect tile 101
key ctrl+opt+f
expect floating 104
expect visible 101
expect left-of 101 102
# 9. Pause: framed on Safari, ⌃⌥⎋ brings everything into view and lets go; ⌃⌥⎋ again, and the view is back.
focus 101
key ctrl+opt+return
expect hidden 102
key ctrl+opt+escape
expect visible 102
expect visible 103
expect visible 104
key ctrl+opt+escape
expect fills 101
expect hidden 102
# 10. Arrange Windows in the menu docks every window in a grid; ⌃⌥⇧F floats them all: a normal Mac.
from menu arrange
expect count docked 4
expect camera root
key ctrl+opt+shift+f
expect count docked 0
expect visible 101
expect visible 102
expect visible 103
expect visible 104
# The ways back of section 3 that the ten things have not used, from a terminal.
dock 101 left
zoom 101
home
expect camera root
pause
expect ok
resume
expect ok
float-all
expect ok
expect count docked 0
# Motion: on, and back to the default, which is none.
set animationDuration 0.46
expect ok
reset animationDuration
expect ok
