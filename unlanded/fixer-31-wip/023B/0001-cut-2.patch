+  /// Nor when it was taken back, when the window has gone, or when Arbor pauses or quits in that second.
+  @Test(arguments: ["taken back", "closed", "pause", "quit"])
+  func nothingIsLeftBehind(after what: String) {
+    let h = make()
+    h.system.userMove(WindowID(105), to: CGRect(x: 300, y: 200, width: 480, height: 348))
+    h.scheduler.advance(by: 0.2)
+    switch what {
+    case "taken back":
+      h.system.displayList = [Self.laptop]
+      h.system.userMove(WindowID(104), to: CGRect(x: 200, y: 200, width: 480, height: 348))
+      #expect(!h.scheduler.pendingKeys.contains("spoke-ahead"))
+    case "closed": h.system.close(WindowID(105))
+    case "pause": #expect(h.run("pause").ok)
+    default: h.controller.shutdown()
+    }
+    h.system.clearFrameLog()
+    let books = h.controller.workspaces
+    h.scheduler.advance(by: 1.05)
+    #expect(!h.scheduler.pendingKeys.contains("spoke-ahead"))
+    if what != "taken back" {
+      #expect(h.controller.workspaces == books)
+      #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    }
+  }
