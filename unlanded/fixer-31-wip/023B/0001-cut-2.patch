+    h.system.clearFrameLog()
+    h.system.userMove(moves[0].0, to: moves[0].1)
+    h.scheduler.advance(by: 0.3)
+    h.system.displayList = displays
+    for (window, frame) in moves.dropFirst() { h.system.userMove(window, to: frame) }
