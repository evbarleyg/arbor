+
+  // MARK: All that the report wrote is taken back
+
+  /// 104 is docked on the side and fills its view, and 107 has opened over it: a guest of that view. Filed under another display it would be no
+  /// guest any more, and being filed back alone does not make it one.
+  @Test(arguments: Change.allCases)
+  func aGuestThatSpeaksFirstIsStillAGuest(_ change: Change) {
+    func make() -> Harness {
+      let h = self.make()
+      #expect(h.run("dock 104 left").ok && h.run("zoom 104").ok)
+      h.system.open(app: "App3", pid: 1004, frame: CGRect(x: 1800, y: 300, width: 480, height: 348))
+      h.scheduler.advance(by: 5)
+      #expect(h.controller.workspaces[Self.side.id]?.guests?[WindowID(107)] != nil, "the story needs a guest")
+      return h
+    }
+    let (early, late) = (make(), make())
+    play(change, ahead: [WindowID(107)], on: early)
+    play(change, ahead: [], on: late)
+    expectTheSameEnd(early, late, "\(change)")
+  }
+
+  /// 105 fills the side's view: its size is Arbor's, and its own frame is kept for the end of the fill.
+  @Test(arguments: Change.allCases)
+  func aWindowThatFillsTheViewSpeaksFirst(_ change: Change) {
+    func make() -> Harness {
+      let h = self.make()
+      #expect(h.run("zoom 105").ok)
+      h.scheduler.advance(by: 5)
+      #expect(h.controller.workspaces[Self.side.id]?.isFilled(WindowID(105)) == true, "the story needs a fill")
+      return h
+    }
+    let (early, late) = (make(), make())
+    play(change, ahead: [WindowID(105)], on: early)
+    play(change, ahead: [], on: late)
+    expectTheSameEnd(early, late, "\(change)")
+    for h in [early, late] {
+      h.system.setDisplays([Self.laptop, Self.side])
+      h.scheduler.advance(by: 5)
+    }
+    expectTheSameEnd(early, late, "\(change), and back")
+  }
+
+  /// Where floating windows make way the layout places them, by the books.
+  @Test(arguments: Change.allCases, [false, true])
+  func whereFloatingWindowsMakeWay(_ change: Change, aloneItTakesTheDesktop: Bool) {
+    var settings = Settings.makingWay
+    settings.soleFloatTakesDesktop = aloneItTakesTheDesktop
+    let (early, late) = (make(settings), make(settings))
+    for h in [early, late] {
+      for window in [WindowID(105), WindowID(106)] { h.system.close(window) }
+      h.scheduler.advance(by: 5)
+    }
+    play(change, ahead: [WindowID(104)], on: early)
+    play(change, ahead: [], on: late)
+    expectTheSameEnd(early, late, "\(change)")
+    for h in [early, late] {
+      h.system.setDisplays([Self.laptop, Self.side])
+      h.scheduler.advance(by: 5)
+    }
+    expectTheSameEnd(early, late, "\(change), and back")
+  }
+
+  /// Alone on the Desktop of the display that stays, which it fills, and macOS nudges it. Booked as its user's move it would count as taken in hand.
+  @Test func aloneOnTheDesktopThatStays() {
+    var settings = Settings.makingWay
+    settings.soleFloatTakesDesktop = true
+    func play(early: Bool) -> Harness {
+      let h = make(settings)
+      for window in [WindowID(102), WindowID(103)] { h.system.close(window) }
+      h.scheduler.advance(by: 5)
+      let nudged = h.frame(WindowID(101))!.offsetBy(dx: 60, dy: 40)
+      if early { h.system.userMove(WindowID(101), to: nudged) }
+      h.scheduler.advance(by: 0.3)
+      h.system.displayList = [Self.laptop]
+      if !early { h.system.userMove(WindowID(101), to: nudged) }
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays([Self.laptop])
+      h.scheduler.advance(by: 5)
+      return h
+    }
+    expectTheSameEnd(play(early: true), play(early: false), "nudged")
+  }
+
+  /// That it moved, and then that its size changed: what counts is where it was before the first.
+  @Test(arguments: Change.allCases)
+  func itSpeaksTwice(_ change: Change) {
+    func play(early: Bool) -> Harness {
+      let h = make()
+      let (displays, moves) = plan(change, h)
+      func speaks(_ window: WindowID, _ frame: CGRect) {
+        h.system.userMove(window, to: CGRect(origin: frame.origin, size: h.frame(window)!.size))
+        h.system.userMove(window, to: frame)
+      }
+      let smaller = moves.map { ($0.0, $0.0 == WindowID(105) ? $0.1.insetBy(dx: 40, dy: 30) : $0.1) }
+      for (window, frame) in smaller where early && window == WindowID(105) { speaks(window, frame) }
+      h.scheduler.advance(by: 0.3)
+      h.system.displayList = displays
+      for (window, frame) in smaller where !early || window != WindowID(105) { speaks(window, frame) }
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays(displays)
+      h.scheduler.advance(by: 5)
+      return h
+    }
+    expectTheSameEnd(play(early: true), play(early: false), "\(change)")
+  }
