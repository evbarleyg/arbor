+  /// The Dock is shown or hidden in that second: a report of the displays, and they are the same. It decides nothing.
+  @Test func aReportThatIsOnlyAboutTheDockEndsNoMoment() {
+    var withDock = Self.laptop
+    withDock.visibleFrame.size.height -= 60
+    func play(ahead: Set<WindowID>) -> Harness {
+      let h = make()
+      let (displays, moves) = plan(.theSideGoes, h)
+      for (window, frame) in moves where ahead.contains(window) { h.system.userMove(window, to: frame) }
+      h.scheduler.advance(by: 0.1)
+      h.system.setDisplays([withDock, Self.side])
+      h.scheduler.advance(by: 0.2)
+      h.system.displayList = [withDock]
+      for (window, frame) in moves where !ahead.contains(window) { h.system.userMove(window, to: frame) }
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays([withDock])
+      h.scheduler.advance(by: 5)
+      _ = displays
+      return h
+    }
+    expectTheSameEnd(play(ahead: [WindowID(105)]), play(ahead: []), "the Dock, then the side goes")
+  }
