+++ b/Sources/ArborKit/Controller/Controller+SpokeAhead.swift
@@ -0,0 +1,87 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+
+/// The window that speaks before the displays have changed.
+///
+/// At a change of displays macOS moves windows and their apps say so. Those reports find macOS with other displays than Arbor was told of
+/// and are turned away (`knowsTheDisplays`). One comes earlier. With eleven real apps on a hosted Mac, in 10 of 13 changes exactly one
+/// window reported its new frame 0.003 to 0.7 s before macOS's own list was new. At that moment nothing tells it from an app's or a
+/// tool's own move, so it is booked like one, by the displays that are about to change: a new place, a hand's note, and a new home where
+/// it crossed a border. It had then left the arrangement that goes to sleep with its display, and did not come back with it; or it kept
+/// the home its report gave it where a display came under it.
+///
+/// So it is booked, and what the books said before is kept for a moment. If macOS turns out to have other displays by then, the entry is
+/// taken back and the window counts as one that macOS moved behind Arbor's back, like all the others. From there on it is one of them:
+/// it is taken from where it is, by the displays that are (`takeFloatingWindowsFromWhereTheyAre`). Books only: no frame is set here.
+///
+/// A hand's or a tool's own move in that second is overtaken the same way and loses nothing: the window is taken from where it is.
+extension Controller {
+  /// What the books said of a floating window before a report gave it another place.
+  struct BookedAhead {
+    var at: Date
+    var home: DisplayID
+    var place: CGRect
+    var chosen: (frame: CGRect, display: CGRect, showing: CGFloat)?
+    var spoke: Date?
+    var fitted: FittedWindow?
+  }
+
+  /// How long before macOS's list of displays is new a window may speak of what the change did to it. 0.7 s is the longest recorded.
+  static let aheadOfTheDisplays: TimeInterval = 1
+
+  /// Called before a report of `window`, floating on `home`, is booked as a move of its user's. With a button down it is one, and a window
+  /// with a part to play (kept in view, summoned, stashed) is not taken from where it is either. Returns whether the entry may yet be taken
+  /// back: then nothing is laid out for it until it is known to stay.
+  func keepWhatTheBooksSay(of window: WindowID, on home: DisplayID) -> Bool {
+    guard !system.isMouseButtonDown(), floatingEdgeInHand != window, let place = workspaces[home]?.floating[window],
+      workspaces[home]!.role(of: window) == nil
+    else { return false }
+    // It may speak more than once on its way: that it moved, then that its size changed. What counts is where it was before the first.
+    if let kept = bookedAhead[window], isYoung(kept) { return true }
+    bookedAhead[window] = BookedAhead(
+      at: now(), home: home, place: place, chosen: chosenOnShape[window], spoke: spokeOfItsPlace[window], fitted: fittedToADisplay[window])
+    // Nobody else may speak and no key be pressed: Arbor looks by itself.
+    scheduler.schedule("spoke-ahead", after: Self.aheadOfTheDisplays) { [weak self] in self?.theMomentIsOver() }
+    return true
+  }
+
+  private func isYoung(_ kept: BookedAhead) -> Bool { now().timeIntervalSince(kept.at) <= Self.aheadOfTheDisplays + 0.01 }
+
+  /// Called at every sign that macOS has other displays than Arbor was told of, and at the report of the displays. With the displays
+  /// as Arbor knows them nothing is decided yet: a report that is only about the Dock ends no moment.
+  func takeBackWhatWasBookedAhead() {
+    guard !bookedAhead.isEmpty, isRunning, !knowsTheDisplays else { return }
+    let entries = bookedAhead.sorted { $0.key < $1.key }
+    bookedAhead = [:]
+    scheduler.cancel("spoke-ahead")
+    for (window, kept) in entries where isYoung(kept) {
+      // Docked, closed, given a part or let go of meanwhile: somebody has decided since.
+      guard let home = workspaceID(containing: window), workspaces[home]!.isFloating(window), workspaces[home]!.role(of: window) == nil,
+        workspaces[kept.home] != nil
+      else { continue }
+      if home != kept.home { workspaces[home]!.floating[window] = nil }
+      workspaces[kept.home]!.floating[window] = kept.place
+      chosenOnShape[window] = kept.chosen
+      spokeOfItsPlace[window] = kept.spoke
+      fittedToADisplay[window] = kept.fitted
+      Log.debug("window \(window) spoke before the displays changed: not its user's move")
+      if home != kept.home { notify(.windows) }
+      noteMoveBehindArborsBack(of: window)
+    }
+    scheduleSave()
+  }
+
+  /// A moment after the last entry. The displays are other: see above. They are as they were: the moves were what they looked like, they
+  /// stay booked, and what was owed to them is laid out now.
+  private func theMomentIsOver() {
+    takeBackWhatWasBookedAhead()
+    let entries = bookedAhead.sorted { $0.key < $1.key }
+    bookedAhead = [:]
+    guard isRunning else { return }
+    for (window, kept) in entries {
+      guard let home = workspaceID(containing: window), home != kept.home, workspaces[home]!.isFloating(window) else { continue }
+      floatingWindowMoved(window, from: kept.home)
+    }
+  }
+}
