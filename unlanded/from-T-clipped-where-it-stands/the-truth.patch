+  /// macOS lets no call make a window grow past the Dock or past its display's right edge. The origin stays, and the bottom edge comes to
+  /// the visible frame's bottom less 1 (23 answers of 23 on a hosted Mac: asked 494×650 at 170,220 with the Dock's top at 705, a window
+  /// took 494×484), the right edge to the display's right edge (asked 494 wide at x 687 of 1024, it took 337). What counts is where the
+  /// window is when the size arrives. It only holds growth back: it shrinks nothing, the window's minimum beats it, and an edge that is
+  /// past the line already is not held (a parked window took 1000×650 where it was parked). Moving is another matter (`whereMacOSPuts`).
+  /// Measured with one display, the Dock at the bottom and both edges on the same side of their lines. That each edge goes by itself, and
+  /// that with several displays the one with the window's middle counts, are guesses.
+  public func asFarAsItMayGrow(_ frame: CGRect, to size: CGSize, atLeast minimum: CGSize = .zero) -> CGSize {
+    let middle = CGPoint(x: frame.midX, y: frame.midY)
+    guard let room = (displayList.first { $0.frame.contains(middle) } ?? displayList.first { $0.frame.overlaps(frame) })?.visibleFrame
+    else { return size }
+    var size = size
+    let (right, bottom) = (room.maxX, room.maxY - 1)
+    if frame.maxX <= right { size.width = min(size.width, max(frame.width, right - frame.minX, minimum.width)) }
+    if frame.maxY <= bottom { size.height = min(size.height, max(frame.height, bottom - frame.minY, minimum.height)) }
+    return size
   }
 
