diff --git a/Sources/ArborKit/Controller/Controller+RelaunchedApps.swift b/Sources/ArborKit/Controller/Controller+RelaunchedApps.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cff9f08f8657aaf809ca2913c465aa6bff22478b
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+RelaunchedApps.swift
@@ -0,0 +1,138 @@
+import ArborCore
+
+/// An app that is quit and opened again while Arbor runs goes back to its place.
+///
+/// Someone who quits Mail and opens it again, or whose browser restarts for an update, expects it where it was;
+/// someone who closes a window expects its neighbours to close over the gap for good. Both arrive as "this
+/// window is gone". What tells them apart is that the app ended, and that news comes after the windows of
+/// an app that closes them as it quits, and before those of one that is killed or simply exits.
+///
+/// People quit apps all day and mostly do not open them again, so quitting must cost nothing: a window that goes is
+/// forgotten there and then, exactly as a closed one, and nothing moves later on its account. Arbor only
+/// keeps a note beside the tree: how the display was arranged before, and which windows have gone since. If the
+/// app of one of them ended (within `closedPlaceGrace` of the window's going), and a window of that app
+/// appears within `pendingSlotLifetime`, and **the arrangement has not been changed meanwhile** (gaps aside: Arbor
+/// moves them by itself, and a person's `resize` fitted the arrangement without the app), the earlier
+/// arrangement is put back with waiting slots where the windows were, and from there on it is a login: the
+/// window claims its slot by title, or by app alone if there is nothing to confuse (Controller+PendingSlots.swift).
+/// Someone who has rearranged things meanwhile has decided otherwise, and the window is a new window.
+extension Controller {
+  /// How long after a window went its app can end and still count as having quit, in seconds. Apps that ask
+  /// about unsaved changes do so before they close anything; what takes time afterwards is saving state.
+  public static let closedPlaceGrace: Double = 5
+
+  struct ClosedPlaces {
+    struct Closed {
+      var pid: Int32
+      var hint: WindowHint
+      var appEnded: Bool
+      /// Other processes of the same app that were running when it went (`open -n`). A window of theirs is not the app
+      /// coming back.
+      var otherCopies: Set<Int32>
+    }
+
+    /// The display's workspace before the first of `windows` went.
+    var before: Workspace
+    /// The same after the last of them went. While the display's arrangement is still this one's, nothing else has
+    /// changed in it.
+    var after: Workspace
+    /// Docked in `before`, and gone.
+    var windows: [WindowID: Closed]
+  }
+
+  /// `window` has gone and has just been forgotten on `display`, whose workspace was `before` until then.
+  func rememberPlace(of window: WindowSnapshot?, in before: Workspace, on display: DisplayID) {
+    guard let window, window.bundleID != nil, filter.manages(window), before.isDocked(window.id),
+      let after = workspaces[display]
+    else { return }
+    // One note per display, for as long as windows going is all that happens to its tree.
+    var places = closedPlaces[display].flatMap { $0.after.tree.isSameArrangement(as: before.tree) ? $0 : nil }
+      ?? ClosedPlaces(before: before, after: before, windows: [:])
+    // What the person saved or named since the last going is theirs.
+    places.before.follow(viewsAndNamesOf: before, since: places.after)
+    let appEnded = endedApps.contains(window.pid)
+    let otherCopies = Set(windows.values.filter { $0.bundleID == window.bundleID && $0.pid != window.pid }.map(\.pid))
+    places.windows[window.id] = ClosedPlaces.Closed(
+      pid: window.pid, hint: WindowHint(bundleID: window.bundleID, title: window.title), appEnded: appEnded,
+      otherCopies: otherCopies)
+    places.after = after
+    closedPlaces[display] = places
+    if appEnded {
+      scheduleEndOfClosedPlaces()
+    } else {
+      scheduler.schedule("closed-places-grace", after: Self.closedPlaceGrace) { [weak self] in
+        self?.forgetPlacesOfClosedWindows()
+      }
+    }
+  }
+
+  public func applicationTerminated(_ pid: Int32) {
+    guard isRunning else { return }
+    // Its windows may be reported next, in this turn of the run loop. Not for long: numbers are used again.
+    endedApps.insert(pid)
+    scheduler.schedule("ended-apps", after: 1) { [weak self] in self?.endedApps.removeAll() }
+    var count = 0
+    for display in closedPlaces.keys.sorted() {
+      for window in closedPlaces[display]!.windows.keys where closedPlaces[display]!.windows[window]!.pid == pid {
+        closedPlaces[display]!.windows[window]!.appEnded = true
+        count += 1
+      }
+    }
+    guard count > 0 else { return }
+    Log.info("an app with \(count) docked window(s) ended; they go back to their places if it is opened again soon")
+    scheduleEndOfClosedPlaces()
+  }
+
+  private func scheduleEndOfClosedPlaces() {
+    scheduler.schedule("closed-places", after: Self.pendingSlotLifetime) { [weak self] in self?.forgetClosedPlaces() }
+  }
+
+  /// Their apps live on: the windows were closed, and the note is as if they had never been there.
+  private func forgetPlacesOfClosedWindows() {
+    for display in closedPlaces.keys.sorted() {
+      var places = closedPlaces[display]!
+      for window in places.windows.keys.sorted() where !places.windows[window]!.appEnded {
+        places.windows[window] = nil
+        places.before.forget(window, shareSpace: settings.shareRemovedSpace)
+      }
+      closedPlaces[display] = places.windows.isEmpty ? nil : places
+    }
+  }
+
+  func forgetClosedPlaces() {
+    closedPlaces.removeAll()
+    endedApps.removeAll()
+    for key in ["closed-places", "closed-places-grace", "ended-apps"] { scheduler.cancel(key) }
+  }
+
+  /// `window` has appeared. If its app ended lately with docked windows, their places are made to wait for them.
+  func putBackClosedPlaces(for window: WindowSnapshot) {
+    guard !closedPlaces.isEmpty, let bundleID = window.bundleID else { return }
+    for display in closedPlaces.keys.sorted() {
+      let places = closedPlaces[display]!
+      guard
+        places.windows.values.contains(where: {
+          $0.appEnded && $0.hint.bundleID == bundleID && !$0.otherCopies.contains(window.pid)
+        })
+      else { continue }
+      // Either way the note has served: the tree is about to change, or it has.
+      closedPlaces[display] = nil
+      guard var workspace = workspaces[display], workspace.tree.isSameArrangement(as: places.after.tree) else { continue }
+      var earlier = places.before
+      for (gone, closed) in places.windows.sorted(by: { $0.key < $1.key }) {
+        if closed.appEnded {
+          // Those of other apps that ended too: once the tree changes there is no other way to keep them.
+          moveToStandIn(gone, hint: closed.hint, in: &earlier)
+        } else {
+          earlier.forget(gone, shareSpace: settings.shareRemovedSpace)
+        }
+      }
+      workspace.restoreStructure(from: earlier, left: places.after)
+      workspaces[display] = workspace
+      scheduleCheckOfPendingSlots()
+      relayout(display, reason: .structure)
+      scheduleSave()
+    }
+    if closedPlaces.isEmpty { forgetClosedPlaces() }
+  }
+}
