@@ -42,6 +42,8 @@
 #
 # Everything a script leaves in mac-shell/ comes back to the caller. Written for bash 3.2, macOS's own.
 # Sets -u and pipefail but not -e: a step that fails should not cost the steps after it.
+# Under -u a variable that is not set ends the shell on the spot. In the clean-up that is before the failures are counted, so
+# a script that ends with 0 or 1 and has not counted ends with 2, and the supervisor says why. Do not unset what this file has set.
 #
 # Whose Mac is this?
 #   on_throwaway_mac                whether this is one of GitHub's Macs ($GITHUB_ACTIONS is true)
@@ -1052,6 +1054,12 @@ arbor_supervise() {
     interrupted) code=130 ;;
     *) code=124 ;;
   esac
+  # Under `set -u` one variable that is not set ends the clean-up where it stands (arbor_exit, or what the script gave at_exit), before the
+  # failures are counted, and bash hands on what the script's last command came to: on a hosted Mac 0, with six checks failed.
+  if [ -z "$reason" ] && [ "$code" -lt 2 ] && [ ! -f "$ARBOR_LEDGER/counted.$child" ]; then
+    echo "  ✘ $(basename "$ARBOR_SCRIPT") ended before it had counted its failures: its clean-up died, see the last lines above"
+    code=2
+  fi
 
   arbor_sweep
   if ! on_throwaway_mac; then
@@ -1528,7 +1536,11 @@ arbor_exit() {
     rmdir "$ARBOR_OUT/evidence" 2>/dev/null
   fi
   [ "$code" -eq 0 ] && [ "$ARBOR_FAILED" -gt "$ARBOR_KNOWN_FAILED" ] && code=1
-  if ! arbor_supervised; then
+  if arbor_supervised; then
+    # For the supervisor: the failures have been counted, so the exit code means what it says. By its number: a script that this one
+    # started (a section of the suite) is on the same record, and does not vouch for it.
+    : > "$ARBOR_LEDGER/counted.$$"
+  else
     arbor_sweep
     scratch_remove "$ARBOR_LEDGER"
   fi
