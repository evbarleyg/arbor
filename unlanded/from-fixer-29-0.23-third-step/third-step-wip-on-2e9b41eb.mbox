diff --git a/Tests/ArborKitTests/AtADisplaysReturnTests.swift b/Tests/ArborKitTests/AtADisplaysReturnTests.swift
new file mode 100644
index 00000000..38bdfea5
--- /dev/null
+++ b/Tests/ArborKitTests/AtADisplaysReturnTests.swift
@@ -0,0 +1,178 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// At a display's return Arbor fetches no floating window (board 0.23, the third step): where macOS puts it, it is, and where macOS leaves it on the display that
+/// stayed, it stays. That is the Mac alone, and the bar. On hosted Macs the fetching was either a frame that changed nothing, because macOS had
+/// the window there already, or a frame against macOS; and the one time the two differed it made things worse.
+/// `MacOSsAtAChangeOfDisplaysTests` has the ground: what macOS does to a floating window at a change of displays is macOS's.
+@Suite @MainActor struct AtADisplaysReturnTests {
+  static let main = MacOSsAtAChangeOfDisplaysTests.main
+  static let side = MacOSsAtAChangeOfDisplaysTests.side
+  /// The same display at another resolution.
+  static let smaller = DisplaySnapshot(
+    id: side.id, frame: CGRect(x: 1600, y: 0, width: 1280, height: 800), visibleFrame: CGRect(x: 1600, y: 31, width: 1280, height: 769), isMain: false)
+  static let there = CGRect(x: 2056, y: 208, width: 1000, height: 600)
+  static let home = CGRect(x: 300, y: 165, width: 1000, height: 600)
+
+  /// Notes lives on the second display, an editor on the main one. Nothing is docked.
+  func desk() -> (h: Harness, notes: WindowID, editor: WindowID) {
+    let h = Harness(displays: [Self.main, Self.side], settings: Settings())
+    let notes = h.system.open(app: "Notes", pid: 11, frame: Self.there)
+    let editor = h.system.open(app: "TextEdit", pid: 12, frame: CGRect(x: 100, y: 65, width: 500, height: 400))
+    h.start()
+    h.scheduler.advance(by: 40)
+    return (h, notes, editor)
+  }
+
+  /// The displays become `displays`, as a Mac does it. The editor is nudged. Whoever is named first speaks before macOS's list is new.
+  func change(_ h: Harness, to displays: [DisplaySnapshot], _ notes: WindowID, at frame: CGRect?, _ editor: WindowID, notesSpeaksFirst: Bool = false) {
+    let nudge = (editor, h.frame(editor)!.offsetBy(dx: 0, dy: 12))
+    let moving = frame.map { notesSpeaksFirst ? [(notes, $0), nudge] : [nudge, (notes, $0)] } ?? [nudge]
+    h.system.changeDisplaysAsAMacDoes(displays, moving: moving)
+    h.scheduler.advance(by: 5)
+  }
+
+  func place(of window: WindowID, _ h: Harness) -> [DisplayID: CGRect] { h.controller.workspaces.compactMapValues { $0.floating[window] } }
+  func framesSet(to window: WindowID, _ h: Harness) -> [CGRect] { h.system.frameLog.filter { $0.window == window }.map(\.frame) }
+
+  /// As it was recorded. The display goes and macOS takes the window home. It comes back SMALLER, and macOS by itself puts the window wholly on it, with Arbor running and
+  /// without. Arbor then fetched it to the place it remembered, a place on the larger display: 176 points over the right edge, where there is no
+  /// display, 82 % of its width showing where macOS had left all of it.
+  @Test(arguments: [false, true]) func itComesBackSmallerAndMacOSPutsTheWindowWhollyOnIt(notesSpeaksFirst: Bool) {
+    let (h, notes, editor) = desk()
+    change(h, to: [Self.main], notes, at: Self.home, editor)
+    h.scheduler.advance(by: 20)
+    h.system.clearFrameLog()
+    let macOSs = CGRect(x: 1740, y: 115, width: 1000, height: 600)
+    change(h, to: [Self.main, Self.smaller], notes, at: macOSs, editor, notesSpeaksFirst: notesSpeaksFirst)
+    #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    #expect(h.frame(notes) == macOSs)
+    #expect(place(of: notes, h) == [Self.side.id: macOSs])
+  }
+
+  /// It comes back as it was, and macOS has the window at its old place already. Arbor used to send a call after it that moved nothing.
+  @Test func whereMacOSHasItThereAlreadyNothingIsAsked() {
+    let (h, notes, editor) = desk()
+    for round in 1...3 {
+      change(h, to: [Self.main], notes, at: Self.home, editor)
+      h.system.clearFrameLog()
+      change(h, to: [Self.main, Self.side], notes, at: Self.there, editor)
+      #expect(h.system.frameLog.isEmpty, "round \(round): \(h.system.frameLog)")
+      #expect(place(of: notes, h) == [Self.side.id: Self.there])
+    }
+  }
+
+  /// macOS leaves it on the display that stayed. It stays.
+  @Test func whereMacOSLeavesItOnTheDisplayThatStayedItStays() {
+    let (h, notes, editor) = desk()
+    change(h, to: [Self.main], notes, at: Self.home, editor)
+    h.scheduler.advance(by: 20)
+    h.system.clearFrameLog()
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    #expect(h.frame(notes) == Self.home)
+    #expect(place(of: notes, h) == [Self.main.id: Self.home])
+    // Nor later, at a change that has nothing to do with it.
+    change(h, to: [Self.main], notes, at: nil, editor)
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(framesSet(to: notes, h).isEmpty)
+    #expect(h.frame(notes) == Self.home)
+  }
+
+  // MARK: It filled the display that went
+
+  /// Notes fills the second display. That display goes, macOS brings the window over, and it has its own size on the laptop: the fill ended with its display.
+  func filledAndGone() -> (h: Harness, notes: WindowID, editor: WindowID, fills: CGRect, onTheLaptop: CGRect) {
+    let (h, notes, editor) = desk()
+    h.system.cursor = CGPoint(x: 2300, y: 400)
+    h.system.userFocus(notes)
+    h.scheduler.advance(by: 2)
+    h.run("zoom")
+    h.scheduler.advance(by: 3)
+    #expect(h.controller.isFilled(notes), "the situation")
+    let fills = h.frame(notes)!
+    change(h, to: [Self.main], notes, at: CGRect(x: 0, y: 31, width: 1600, height: 791), editor)
+    h.scheduler.advance(by: 20)
+    #expect(h.frame(notes)?.size == Self.there.size && !h.controller.isFilled(notes), "the situation: \(h.frame(notes)!)")
+    h.system.clearFrameLog()
+    return (h, notes, editor, fills, h.frame(notes)!)
+  }
+
+  /// macOS leaves it on the laptop: it stays, at its own size, and nothing happens.
+  @Test func havingFilledWhatWentItStaysWhereMacOSLeavesIt() {
+    let (h, notes, editor, _, onTheLaptop) = filledAndGone()
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    #expect(h.frame(notes) == onTheLaptop && !h.controller.isFilled(notes))
+    #expect(place(of: notes, h) == [Self.main.id: onTheLaptop])
+  }
+
+  /// macOS brings a window back to the frame it last had on a display, and that frame is the fill's. It fills again: nothing moves, and the key gives it its own frame.
+  /// Taken for its own, the fill's size would have cost it its own for good.
+  @Test(arguments: [false, true]) func broughtBackToWhereTheFillHadLeftItItFillsAgain(notesSpeaksFirst: Bool) {
+    let (h, notes, editor, fills, _) = filledAndGone()
+    change(h, to: [Self.main, Self.side], notes, at: fills, editor, notesSpeaksFirst: notesSpeaksFirst)
+    #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    #expect(h.frame(notes) == fills && h.controller.isFilled(notes))
+    #expect(place(of: notes, h) == [Self.side.id: Self.there])
+    h.system.userFocus(notes)
+    h.run("zoom")
+    h.scheduler.advance(by: 3)
+    #expect(h.frame(notes) == Self.there && !h.controller.isFilled(notes))
+  }
+
+  /// Anywhere else it is macOS's, like any other.
+  @Test func broughtBackElsewhereItIsMacOSs() {
+    let (h, notes, editor, _, _) = filledAndGone()
+    let macOSs = CGRect(x: 1900, y: 150, width: 1000, height: 600)
+    change(h, to: [Self.main, Self.side], notes, at: macOSs, editor)
+    #expect(h.system.frameLog.isEmpty, "\(h.system.frameLog)")
+    #expect(h.frame(notes) == macOSs && !h.controller.isFilled(notes))
+    #expect(place(of: notes, h) == [Self.side.id: macOSs])
+  }
+
+  // MARK: What stays Arbor's
+
+  /// A docked window goes back to its slot with its display's arrangement.
+  @Test func aDockedWindowGoesHome() {
+    let (h, notes, editor) = desk()
+    h.system.cursor = CGPoint(x: 2300, y: 400)
+    h.run("dock \(notes.rawValue) left")
+    h.scheduler.advance(by: 3)
+    let slot = h.frame(notes)!
+    change(h, to: [Self.main], notes, at: Self.home, editor)
+    h.scheduler.advance(by: 20)
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(h.frame(notes) == slot)
+    #expect(h.controller.workspaces[Self.side.id]?.isDocked(notes) == true)
+  }
+
+  /// A window kept in view goes home as before.
+  @Test func aWindowKeptInViewGoesHome() {
+    let (h, notes, editor) = desk()
+    h.run("pin \(notes.rawValue)")
+    h.scheduler.advance(by: 3)
+    change(h, to: [Self.main], notes, at: Self.home, editor)
+    h.scheduler.advance(by: 20)
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(place(of: notes, h).keys.sorted() == [Self.side.id])
+    #expect(h.frame(notes) == Self.there)
+  }
+
+  /// Where floating windows make way the layout places them, as ever.
+  @Test func whereFloatingWindowsMakeWayItGoesHome() {
+    let h = Harness(displays: [Self.main, Self.side], settings: .makingWay)
+    let notes = h.system.open(app: "Notes", pid: 11, frame: Self.there)
+    let editor = h.system.open(app: "TextEdit", pid: 12, frame: CGRect(x: 100, y: 65, width: 500, height: 400))
+    h.start()
+    h.scheduler.advance(by: 40)
+    change(h, to: [Self.main], notes, at: Self.home, editor)
+    h.scheduler.advance(by: 20)
+    change(h, to: [Self.main, Self.side], notes, at: nil, editor)
+    #expect(place(of: notes, h).keys.sorted() == [Self.side.id])
+  }
+}
