+  /// At a display's return Arbor fetches no floating window (board 0.23, the third step): where macOS puts it, it is, and where macOS leaves it on the display
+  /// that stayed, it stays (`takeFloatingWindowsFromWhereTheyAre`, later in the same pass). On hosted Macs the fetching was a frame that changed
+  /// nothing, macOS having the window there already, or a frame against macOS: a display came back smaller, macOS put the window wholly on
+  /// it, and Arbor fetched it to a place remembered for the larger one, 176 points over the edge.
+  ///
+  /// What stays Arbor's: docked windows, windows kept in view, summoned or stashed, what Arbor has out of view just now, whose place is a corner it was
+  /// sent to, what nobody could get hold of, what is still as Arbor fitted it, which is given back, one that is in the Dock, hidden or on another
+  /// Space, and everything where floating windows make way.
+  private func isLeftToMacOSAtAReturn(_ window: WindowID, in sleeping: Workspace) -> Bool {
+    guard !settings.floatingWindowsMakeWay, sleeping.isFloating(window), sleeping.role(of: window) == nil, role(of: window) == nil,
+      !parked.contains(window), let current = windows[window], current.isPresent, titleBarIsWithinReach(current.frame),
+      let own = workspaceID(containing: window).flatMap({ workspaces[$0]!.floating[window] })
+    else { return false }
+    // The fill ended with its display, for good.
+    if sleeping.isFilled(window) { return true }
+    // (One that macOS left on no display when its own went, and that Arbor took in, stays too: it lies in view and its person has seen it there. No Mac
+    // was seen to leave a window in sight so. Should one: a note of where Arbor placed it, which counts while it lies there, and it goes home.)
+    return !isAsArborFittedIt(window, at: current.frame, whoseOwnSizeIs: own.size)
+  }
+
+  /// A window that filled the display that went: the fill ended with its display. macOS brings a window back to the frame it last had on a display, and that
+  /// frame is the fill's. Taken for the window's own it would cost it its own size for good. Found to the point where the fill had left it, it
+  /// fills again: the mark is back, its own frame is the one on record, and nothing moves.
+  private func fillsAgain(_ window: WindowID, in sleeping: Workspace) -> Bool {
+    guard !settings.floatingWindowsMakeWay, sleeping.isFilled(window), let filled = sleeping.filled?[window], !parked.contains(window),
+      let current = windows[window], current.isPresent
+    else { return false }
+    return current.frame.approximatelyEquals(filled, tolerance: 0.99)
+  }
+
   /// Sends windows that changed workspace because of a display change where
   /// that workspace wants them. Docked windows are left to the next relayout,
   /// which puts them in their slots or parks them. Floating windows go onto
@@ -721,7 +765,7 @@ extension Controller {
       forgetWhatFloatsInView(inTheArrangementRememberedFor: id)
       // What is let be has its own display back all the same: whatever it visited since has no claim on it either.
       for window in remembered.subtracting(dormant[id]!.workspace.floating.keys).sorted() { endStays(of: window, begunAfter: since) }
-      returning += restoreDormantWorkspace(of: id)
+      returning += restoreDormantWorkspace(of: id, atAStart: true)
     }
