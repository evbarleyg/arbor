-  public mutating func wasSeen(at size: CGSize, app: String) -> Bool {
+  public mutating func wasSeen(at size: CGSize, app: String, shipped: (size: CGSize, macOS: Int, at: Date)? = nil) -> Bool {
+    var kept = apps[app]
+    if let shipped {
+      // What is gone by: what is too old, or from another macOS, and has not been swept out yet does not stand before what ships.
+      kept =
+        entry(for: app, at: shipped.at, macOS: shipped.macOS)
+        ?? Entry(width: Double(shipped.size.width), height: Double(shipped.size.height), macOS: shipped.macOS, seen: shipped.at)
+    }
     // A window with next to no size is coming or going, not one that goes down to nothing.
-    guard var entry = apps[app], Double(size.width) >= Self.leastSide, Double(size.height) >= Self.leastSide else { return false }
+    guard var entry = kept, Double(size.width) >= Self.leastSide, Double(size.height) >= Self.leastSide else { return false }
+    let before = entry
     if Double(size.width) < entry.width - Self.tolerance { entry.width = 0 }
     if Double(size.height) < entry.height - Self.tolerance { entry.height = 0 }
-    guard entry != apps[app] else { return false }
-    apps[app] = entry.width > 0 || entry.height > 0 ? entry : nil
+    guard entry != before else { return false }
+    guard entry.width > 0 || entry.height > 0 else {
+      apps[app] = nil
+      // That nothing is known holds for as long as anything else, from now.
+      if let shipped { knowNothing(of: app, macOS: shipped.macOS, at: shipped.at) }
+      return true
+    }
+    apps[app] = entry
+    trim()
+    return true
+  }
+
+  /// Nothing is known of `app` from now on, and that is kept: for an app of which something ships, which would be believed again at once.
+  @discardableResult
+  public mutating func knowNothing(of app: String, macOS: Int, at date: Date) -> Bool {
+    guard Self.isName(app) else { return false }
+    apps[app] = Entry(width: 0, height: 0, macOS: macOS, seen: date)
+    trim()
     return true
   }
 
@@ -175,3 +208,17 @@ extension AppSizes: Codable {
     for (app, entry) in apps { try container.encode(entry, forKey: StringKey(app)) }
   }
 }
+
+extension AppSizes {
+  /// What Arbor ships knowing of `app` on this major version of macOS: what a hosted Mac measured (AppSizes+Shipped.swift), so that a person's first
+  /// minute meets no stranger among the apps that come with a Mac. On another version nothing: it is measured, not guessed.
+  public static func shipped(_ app: String, macOS: Int) -> CGSize? {
+    measured[macOS]?[app].map { CGSize(width: $0.width, height: $0.height) }
+  }
+
+  /// The major versions of macOS for which something ships, the newest first.
+  public static var measuredVersions: [Int] { measured.keys.sorted(by: >) }
+
+  /// The apps of which something ships for this version of macOS, in a fixed order.
+  public static func shippedApps(macOS: Int) -> [String] { (measured[macOS] ?? [:]).keys.sorted() }
+}
