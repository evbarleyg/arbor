+#!/usr/bin/env python3
+"""Makes the table of how small apps go that Arbor ships with (F68) out of what hosted Macs measured.
+
+  scripts/app-sizes.py            rewrite Sources/ArborCore/AppSizes+Shipped.swift
+  scripts/app-sizes.py --check    fail if that file is not what the measurements make it (`make lint`)
+  scripts/app-sizes.py --self-test
+
+The measurements are collab/evidence/app-sizes/macos-<major>.tsv, one file for each major version of macOS, each as
+scripts/mac-shell/app-sizes.sh brought it back from a hosted Mac: bundle id, the app's version, macOS's version, the display's size, a
+verdict, the smallest and the largest size its first ordinary window took, and what else was seen. THE TABLE IS MEASURED, NOT GUESSED: nobody
+writes a line of either file by hand. To measure again: run the script (its header says how), copy its app-sizes.tsv over the file, run this.
+
+Only lines whose verdict is `clean` enter the table: a window with a sheet open goes less small than it does without. Of those, not one during
+which Accessibility reported an error (which request failed is not on record: it may have been the small one, and then the size is too high), nor one
+whose smallest size is its largest: that is a window of one size, which says nothing of how small its app goes (as in the store). They stay in the
+file, which is what the Mac brought back. A size that is no size (under 20 points or over 10,000 either way, as AppSizes has it), a verdict the
+measuring script does not give and two files for one version of macOS fail the run: then the measuring is at fault, and is to be looked at.
+"""
+
+import glob
+import os
+import re
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+EVIDENCE = os.path.join(ROOT, "collab", "evidence", "app-sizes")
+TABLE = os.path.join(ROOT, "Sources", "ArborCore", "AppSizes+Shipped.swift")
+
+HEAD = '''// Generated by scripts/app-sizes.py from collab/evidence/app-sizes/. Not to be edited: measure again instead.
+
+extension AppSizes {
+  /// How small the first ordinary window of each app went on a hosted Mac, asked through Accessibility for 40×40, by the major version of macOS
+  /// and the bundle id: width, height. Measured, not guessed (scripts/mac-shell/app-sizes.sh).
+  static let measured: [Int: [String: (width: Double, height: Double)]] = [
+'''
+TAIL = '''  ]
+}
+'''
+
+
+# What scripts/mac-shell/app-sizes.sh says of an app.
+VERDICTS = {"clean", "in-the-way", "no-answer", "no-window", "absent"}
+
+
+class Fault(Exception):
+    pass
+
+
+def number(text):
+    return int(text) if re.fullmatch(r"\d+", text) else float(text)
+
+
+def read(path, text):
+    """The clean lines of one file: {bundle id: (width, height)}, and the major version they were measured on."""
+    name = os.path.basename(path)
+    match = re.fullmatch(r"macos-(\d+)\.tsv", name)
+    if not match:
+        raise Fault("%s: measurements are called macos-<major>.tsv" % name)
+    major = int(match.group(1))
+    sizes, doubted = {}, set()
+    for count, line in enumerate(text.splitlines(), 1):
+        if not line.strip() or line.startswith("#"):
+            continue
+        fields = line.split("\t")
+        if len(fields) != 8:
+            raise Fault("%s:%d: %d fields, not 8" % (name, count, len(fields)))
+        bundle, _, system, _, verdict, smallest, largest, notes = fields
+        if verdict not in VERDICTS:
+            raise Fault("%s:%d: %r is no verdict" % (name, count, verdict))
+        if verdict != "clean":
+            continue
+        if system.split(".")[0] != str(major):
+            raise Fault("%s:%d: measured on macOS %s, in the file for %d" % (name, count, system, major))
+        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{2,254}", bundle):
+            raise Fault("%s:%d: %r is no bundle id" % (name, count, bundle))
+        size = re.fullmatch(r"(\d+(?:\.\d+)?)x(\d+(?:\.\d+)?)", smallest)
+        if not size:
+            raise Fault("%s:%d: %r is no size" % (name, count, smallest))
+        width, height = number(size.group(1)), number(size.group(2))
+        if not (20 <= width <= 10000 and 20 <= height <= 10000):
+            raise Fault("%s:%d: no window goes down to %s" % (name, count, smallest))
+        if bundle in sizes:
+            raise Fault("%s:%d: %s is there twice" % (name, count, bundle))
+        sizes[bundle] = (width, height)
+        errors = re.search(r"\berrors (\S+)", notes)
+        if smallest == largest or not errors or errors.group(1) != "none":
+            doubted.add(bundle)
+    return major, {bundle: size for bundle, size in sizes.items() if bundle not in doubted}
+
+
+def table(files):
+    """The Swift file for {path: text}."""
+    body = []
+    tables = sorted((read(path, text) for path, text in files.items()), key=lambda one: one[0])
+    for one, next_one in zip(tables, tables[1:]):
+        if one[0] == next_one[0]:
+            raise Fault("two files for macOS %d" % one[0])
+    for major, sizes in tables:
+        body.append("    %d: [\n" % major)
+        for bundle in sorted(sizes, key=str.lower):
+            body.append('      "%s": (%s, %s),\n' % (bundle, sizes[bundle][0], sizes[bundle][1]))
+        if not sizes:
+            body.append("      :\n")
+        body.append("    ],\n")
+    if not body:
+        body.append("    :\n")
+    return HEAD + "".join(body) + TAIL
+
+
+def self_test():
+    row = "com.apple.Safari\t26.0\t26.0.1\t1920x1080\t%s\t%s\t1916x1040\tlate no errors none restored yes"
+    good = {"macos-26.tsv": "# head\n" + row % ("clean", "574x240") + "\n" + (row % ("in-the-way", "900x600")).replace("Safari", "mail") + "\n"}
+    made = table(good)
+    checks = [
+        ("a clean line is in the table", '"com.apple.Safari": (574, 240),' in made),
+        ("one with something in the way is not", "mail" not in made),
+        ("under its version of macOS", "    26: [\n" in made),
+        ("no measurements make an empty table", "    :\n" in table({})),
+        ("half points stay", "(574.5, 240)" in table({"macos-26.tsv": row % ("clean", "574.5x240")})),
+        ("a line during which Accessibility failed is left out", "Safari" not in table({"macos-26.tsv": (row % ("clean", "574x240")).replace("errors none", "errors -25205")})),
+        ("so is one that does not say", "Safari" not in table({"macos-26.tsv": (row % ("clean", "574x240")).replace(" errors none", "")})),
+        ("so is a window of one size", "Safari" not in table({"macos-26.tsv": row % ("clean", "1916x1040")})),
+        ("one side that cannot change is a size like any other", '(1916, 240)' in table({"macos-26.tsv": row % ("clean", "1916x240")})),
+    ]
+    for what, text in [
+        ("a size that is none", row % ("clean", "wide")), ("a window a point wide", row % ("clean", "1x1")),
+        ("a line cut short", "com.apple.Safari\tclean"), ("another macOS", (row % ("clean", "574x240")).replace("26.0.1", "15.6")),
+        ("the same app twice", row % ("clean", "574x240") + "\n" + row % ("clean", "574x240")),
+        ("no bundle id", (row % ("clean", "574x240")).replace("com.apple.Safari", 'x"; evil')),
+        ("a verdict nobody gives", row % ("Clean", "574x240")), ("a verdict with a blank after it", row % ("clean ", "574x240")),
+        ("the same app twice, once in doubt", row % ("clean", "574x240") + "\n" + (row % ("clean", "574x240")).replace("errors none", "errors -1")),
+    ]:
+        try:
+            table({"macos-26.tsv": text})
+            checks.append((what + " is refused", False))
+        except Fault:
+            checks.append((what + " is refused", True))
+    for what, second in [("the same", row % ("clean", "574x240")), ("another", row % ("clean", "600x240"))]:
+        try:
+            table({"macos-26.tsv": row % ("clean", "574x240"), "macos-026.tsv": second})
+            checks.append(("two files for one macOS are refused, holding " + what, False))
+        except Fault:
+            checks.append(("two files for one macOS are refused, holding " + what, True))
+    try:
+        table({"sizes.tsv": ""})
+        checks.append(("a file by another name is refused", False))
+    except Fault:
+        checks.append(("a file by another name is refused", True))
+    for what, held in checks:
+        print("  %s %s" % ("✔" if held else "✘", what))
+    return 0 if all(held for _, held in checks) else 1
+
+
+def main(arguments):
+    if arguments == ["--self-test"]:
+        return self_test()
+    if arguments not in ([], ["--check"]):
+        print(__doc__)
+        return 64
+    files = {path: open(path, encoding="utf-8").read() for path in glob.glob(os.path.join(EVIDENCE, "*.tsv"))}
+    try:
+        made = table(files)
+    except Fault as fault:
+        print("app-sizes.py: %s" % fault)
+        return 1
+    have = open(TABLE, encoding="utf-8").read() if os.path.exists(TABLE) else ""
+    if arguments == ["--check"]:
+        if made != have:
+            print("Sources/ArborCore/AppSizes+Shipped.swift is not what collab/evidence/app-sizes/ makes it: run scripts/app-sizes.py")
+            return 1
+        print("the table of how small apps go is what was measured")
+        return 0
+    if made != have:
+        with open(TABLE, "w", encoding="utf-8") as file:
+            file.write(made)
+    print("%s: %d apps" % (os.path.relpath(TABLE, ROOT), made.count('": (')))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
