+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+private let laptop = DisplaySnapshot(
+  id: DisplayID("main"), frame: CGRect(x: 0, y: 0, width: 1280, height: 800),
+  visibleFrame: CGRect(x: 0, y: 25, width: 1280, height: 775), isMain: true, isBuiltIn: true)
+private let day: TimeInterval = 24 * 3600
+/// How many `ShippedSizesTests.days` there are: arguments of a test cannot be read off the main actor.
+private let numberOfDays = 9
+/// The version of macOS the table was measured on first.
+private let measuredOn = 26
+
+/// The apps of the table that can be shown on the laptop's display at all, the widest first.
+private let stock: [String] = AppSizes.shippedApps(macOS: measuredOn)
+  .filter { AppSizes.shipped($0, macOS: measuredOn)!.width <= 1200 && AppSizes.shipped($0, macOS: measuredOn)!.height <= 700 }
+  .sorted { (AppSizes.shipped($0, macOS: measuredOn)!.width, $0) > (AppSizes.shipped($1, macOS: measuredOn)!.width, $1) }
+
+/// Pairs of them that are too wide for that display together. Not all: the widest dozen gives sixty-six at most.
+private let pairs: [[String]] = stock.prefix(12).flatMap { first in
+  stock.prefix(12).filter { $0 != first }.map { [first, $0] }
+}.filter { AppSizes.shipped($0[0], macOS: measuredOn)!.width + AppSizes.shipped($0[1], macOS: measuredOn)!.width > 1244 }
+
+/// Threes of the widest seven, to be arranged at once: where strangers are asked one after the other, a column is widened by one that refuses after
+/// another in it has shrunk.
+private let threes: [[String]] = stock.prefix(7).indices.flatMap { a in
+  stock.prefix(7).indices.filter { $0 > a }.flatMap { b in
+    stock.prefix(7).indices.filter { $0 > b }.map { c in [stock[a], stock[b], stock[c]] }
+  }
+}
+
+/// Arbor ships knowing how small the apps go that come with a Mac (docs/features/F68-how-small-apps-go.md, the second step), so that a person's first
+/// minute meets no stranger among them. These tests go by whatever the table holds: it is measured, and measured again.
+@Suite @MainActor struct ShippedSizesTests {
+  static var still: Settings {
+    var settings = Settings()
+    settings.animationDuration = 0
+    return settings
+  }
+
+  /// A run of Arbor that ships with the table, on a Mac on which `apps` are open, each as small as the table says unless `really` says otherwise.
+  private func run(
+    _ apps: [String], really: [String: CGSize] = [:], knowing saved: PersistedState? = nil, later: TimeInterval = 0, macOS: Int = measuredOn
+  ) -> Harness {
+    let h = Harness(displays: [laptop], settings: Self.still, saved: saved)
+    h.controller.goesByTheShippedSizes = true
+    h.controller.macOSVersion = macOS
+    h.scheduler.advance(by: later)
+    for (index, app) in apps.enumerated() { open(app, really: really[app], in: h, pid: Int32(2000 + index)) }
+    h.start()
+    return h
+  }
+
+  @discardableResult
+  private func open(_ app: String, really: CGSize? = nil, in h: Harness, pid: Int32) -> WindowID {
+    let smallest = really ?? AppSizes.shipped(app, macOS: measuredOn)!
+    return h.system.open(
+      app: app, bundleID: app, pid: pid,
+      frame: CGRect(x: 20, y: 45, width: max(smallest.width + 100, 900).clamped(to: 0...1240), height: max(smallest.height + 60, 500).clamped(to: 0...735)),
+      minimumSize: smallest)
+  }
+
+  private func dock(_ window: UInt32, _ side: String, _ h: Harness) {
+    h.system.userFocus(WindowID(window))
+    h.run("dock \(window) \(side)")
+    h.scheduler.advance(by: 1)
+  }
+
+  private func shows(_ frame: CGRect, _ h: Harness) -> Bool {
+    h.system.displayList.contains {
+      let part = frame.intersection($0.frame)
+      return !part.isNull && part.width > 2 && part.height > 2
+    }
+  }
+
+  /// What is wrong with the road each docked window was seen to take since `mark` (Roads.swift). What floats is board 1.18's.
+  private func detours(since mark: Int, _ h: Harness) -> [String] {
+    let docked = Set(h.workspace.tree.allWindows)
+    let seen = Dictionary(
+      grouping: h.system.moveLog.dropFirst(mark).filter {
+        docked.contains($0.window) && $0.before != $0.after && (shows($0.before, h) || shows($0.after, h))
+      }, by: \.window)
+    return seen.sorted { $0.key < $1.key }.compactMap { window, moves in
+      FakeWindowSystem.detour([moves[0].before] + moves.map(\.after)).map { "\(window) \($0)" }
+    }
+  }
+
+  // MARK: The row's own words: pairs from an empty home, no stage: each window moves once
+
+  @Test func thereArePairsToTry() {
+    #expect(stock.count >= 12, "the table has shrunk: \(stock.count)")
+    #expect(pairs.count >= 10, "\(pairs.count)")
+  }
+
+  @Test(arguments: pairs.indices) func fromAnEmptyHomeEachOfAPairThatCannotBothFitMovesOnce(index: Int) {
+    let pair = pairs[index]
+    let h = run(pair)
+    for (window, side) in [(UInt32(101), "left"), (UInt32(102), "right")] {
+      let mark = h.system.moveLog.count
+      dock(window, side, h)
+      #expect(detours(since: mark, h) == [], "\(pair[0]) and \(pair[1]): docking \(window)")
+    }
+    expectWindowsMatchLayout(h)
+  }
+
+  private func arrange(_ h: Harness) -> [String] {
+    h.system.userFocus(WindowID(101))
+    let mark = h.system.moveLog.count
+    h.run("arrange")
+    h.scheduler.advance(by: 1)
+    return detours(since: mark, h)
+  }
+
+  @Test(arguments: threes.indices) func fromAnEmptyHomeThreeArrangedAtOnceGoStraightToTheirPlaces(index: Int) {
+    let h = run(threes[index])
+    #expect(arrange(h) == [], "\(threes[index])")
+    expectWindowsMatchLayout(h)
+  }
+
+  /// The control: without the table some of the same threes are narrower or lower on the way than they end up. If this stops failing the test above
+  /// proves nothing any more. (The pairs, docked one after the other, go straight without the table too since a stranger is asked where it stands.)
+  @Test func withoutTheTableSuchThreesGoOutOfTheirWay() {
+    var faults = 0
+    for three in threes {
+      let innocent = Harness(displays: [laptop], settings: Self.still)
+      // On the very macOS for which something ships: that it is not gone by is the harness's word alone.
+      innocent.controller.macOSVersion = measuredOn
+      for (index, app) in three.enumerated() { open(app, in: innocent, pid: Int32(2000 + index)) }
+      innocent.start()
+      faults += arrange(innocent).count
+    }
+    #expect(faults > 0, "of \(threes.count) threes")
+  }
+
+  // MARK: Measured, not guessed
+
+  @Test func onAnotherMacOSNothingShips() throws {
+    let app = try #require(stock.first)
+    #expect(AppSizes.shipped(app, macOS: measuredOn) != nil)
+    #expect(AppSizes.shipped(app, macOS: 3) == nil)
+    #expect(AppSizes.shippedApps(macOS: 3).isEmpty)
+    #expect(AppSizes.shipped("com.example.unheard-of", macOS: measuredOn) == nil)
+  }
+
+  @Test func everySizeInTheTableIsASizeAWindowCouldHave() {
+    for app in AppSizes.shippedApps(macOS: measuredOn) {
+      let size = AppSizes.shipped(app, macOS: measuredOn)!
+      #expect(size.width >= 20 && size.width <= 3000 && size.height >= 20 && size.height <= 3000, "\(app): \(size)")
+    }
+  }
+
+  @Test func aTestKnowsNothingUnlessItSaysSo() {
+    #expect(!Harness().controller.goesByTheShippedSizes)
+  }
+
+  @Test func nothingIsWrittenBecauseSomethingShips() throws {
+    let h = run(Array(stock.prefix(2)))
+    h.scheduler.advance(by: 5)
+    h.controller.saveNow()
+    #expect(h.system.moveLog.isEmpty)
+    #expect(h.store.saved?.appSizes == nil)
+  }
+
+  // MARK: What was learned on this Mac outranks it
+
+  @Test func whatAWindowStoodByOutranksTheTable() throws {
+    let app = try #require(stock.first { AppSizes.shipped($0, macOS: measuredOn)!.width >= 650 })
+    let shipped = AppSizes.shipped(app, macOS: measuredOn)!
+    // Wider here than on the hosted Mac: a sidebar is showing.
+    let here = CGSize(width: shipped.width + 60, height: shipped.height)
+    let first = run([app], really: [app: here])
+    dock(101, "right", first)
+    // Or the next start would find it docked.
+    first.run("float-all")
+    first.scheduler.advance(by: 1)
+    first.controller.saveNow()
+    #expect(first.store.saved?.appSizes?.entry(for: app)?.width == Double(here.width))
+
+    let next = run([app], really: [app: here], knowing: first.store.saved, later: day)
+    let mark = next.system.moveLog.count
+    dock(101, "right", next)
+    #expect(detours(since: mark, next) == [])
+    let moves = next.system.moveLog.dropFirst(mark).filter { $0.window == WindowID(101) }
+    #expect(moves.contains { $0.requested.width == here.width - 40 }, "a step less than was learned here")
+    #expect(!moves.contains { $0.requested.width == shipped.width - 40 }, "not than ships")
+    #expect(moves.filter { $0.before.origin != $0.after.origin }.count == 1, "and it changes place once")
+    #expect(next.frame(WindowID(101))?.width == here.width)
+  }
+
+  /// What the table says of an app and a window of it disproves has to be kept, or the next window would be foreseen by the table again.
+  @Test func whatIsDisprovedOfTheTableStaysDisproved() throws {
+    let app = try #require(stock.first { AppSizes.shipped($0, macOS: measuredOn)!.width >= 650 })
+    let slim = CGSize(width: 200, height: 150)
+    let first = run([app], really: [app: slim])
+    dock(101, "right", first)
+    first.run("float-all")
+    first.scheduler.advance(by: 1)
+    first.controller.saveNow()
+    let entry = try #require(first.store.saved?.appSizes?.entry(for: app))
+    #expect(entry.width == 0)
+
+    let next = run([app], really: [app: slim], knowing: first.store.saved, later: day)
+    let mark = next.system.moveLog.count
+    dock(101, "right", next)
+    #expect(detours(since: mark, next) == [])
+    for move in next.system.moveLog.dropFirst(mark) where move.window == WindowID(101) {
+      #expect(move.requested.size == move.after.size, "it is offered its share like a stranger, not a step less than the table says")
+    }
+  }
+
+  @Test func thatSurvivesTheFileAndIsGoneAfterThirtyDaysLikeEverythingElse() throws {
+    let app = try #require(stock.first { AppSizes.shipped($0, macOS: measuredOn)!.width >= 650 })
+    let first = run([app], really: [app: CGSize(width: 100, height: 100)])
+    dock(101, "right", first)
+    first.run("dock 101 top")
+    first.scheduler.advance(by: 1)
+    first.run("float-all")
+    first.scheduler.advance(by: 1)
+    first.controller.saveNow()
+    let saved = try #require(first.store.saved)
+    guard case .loaded(let read) = PersistedState.read(try JSONEncoder().encode(saved)) else {
+      Issue.record("the file does not load")
+      return
+    }
+    #expect(read.appSizes == saved.appSizes)
+    #expect(read.appSizes?.entry(for: app) != nil)
+    let late = run([app], knowing: read, later: 31 * day)
+    #expect(late.controller.appSizes.isEmpty, "and the table is gone by again, and asked about again")
+  }
+
+  // MARK: What ships is foresight like what was learned
+
+  /// A home that learned the day before exactly what ships of `apps`.
+  private func learned(_ apps: [String]) -> PersistedState {
+    var known = AppSizes()
+    for app in apps {
+      if let size = AppSizes.shipped(app, macOS: measuredOn) {
+        known.stoodBy(size, app: app, macOS: measuredOn, at: Date(timeIntervalSinceReferenceDate: 800_000_000))
+      }
+    }
+    var home = PersistedState(workspaces: [:], hints: [:])
+    home.appSizes = known
+    return home
+  }
+
+  private static let easy = "com.example.easy"
+
+  /// What a person may do with three windows, by name. Each begins with nothing docked.
+  private static let days: [(name: String, acts: @MainActor (ShippedSizesTests, Harness) -> Void)] = [
+    ("docked left and right", { t, h in t.dock(101, "left", h); t.dock(102, "right", h) }),
+    ("docked right and left", { t, h in t.dock(101, "right", h); t.dock(102, "left", h) }),
+    ("docked top and bottom", { t, h in t.dock(101, "top", h); t.dock(102, "bottom", h) }),
+    ("all three docked", { t, h in t.dock(103, "left", h); t.dock(101, "right", h); t.dock(102, "bottom", h) }),
+    ("arranged", { t, h in _ = t.arrange(h) }),
+    ("arranged, and each looked at", { t, h in
+      _ = t.arrange(h)
+      for window in [101, 102, 103] {
+        h.run("zoom \(window)")
+        h.scheduler.advance(by: 1)
+        h.run("show-all")
+        h.scheduler.advance(by: 1)
+      }
+    }),
+    ("arranged, and laid out afresh", { t, h in
+      _ = t.arrange(h)
+      h.run("relayout")
+      h.scheduler.advance(by: 1)
+    }),
+    ("docked, and its edge pulled in to two points less than ships", { t, h in
+      t.dock(101, "left", h)
+      guard let width = h.frame(WindowID(101))?.width, let app = h.controller.windows[WindowID(101)]?.bundleID,
+        let ships = AppSizes.shipped(app, macOS: measuredOn)
+      else { return }
+      h.run("resize 101 right \(Int(ships.width - 2 - width))")
+      h.scheduler.advance(by: 1)
+      h.run("show-all")
+      h.scheduler.advance(by: 1)
+    }),
+    ("docked, refused, and made narrower by its own edge", { t, h in
+      t.dock(101, "left", h)
+      t.dock(102, "right", h)
+      guard var frame = h.frame(WindowID(101)) else { return }
+      h.system.setMinimumSize(WindowID(101), CGSize(width: 200, height: 150))
+      frame.size.width -= 80
+      h.system.userMove(WindowID(101), to: frame)
+      h.scheduler.advance(by: 2)
+    }),
+  ]
+
+  private func story(_ h: Harness) -> [String] {
+    h.system.moveLog.map { "\($0.window) asked \($0.requested.brief) took \($0.after.brief)" }
+      + (h.layout?.windowFrames.sorted { $0.key < $1.key }.map { "\($0.key) has \($0.value.brief)" } ?? [])
+  }
+
+  /// **Whatever the apps are really like, Arbor asks the same of every window, in the same order, from an empty home with the table as from a home
+  /// that learned the table's numbers the day before; and so the day after, from what each has saved.** So whatever holds of the store (its own
+  /// suite: that it is asked about, that what is wrong is put right, that things end as in a home that knows nothing) holds of what ships.
+  @Test(arguments: 0..<numberOfDays) func whatShipsIsGoneByExactlyAsIfItHadBeenLearned(day index: Int) throws {
+    #expect(Self.days.count == numberOfDays, "or some are not played")
+    let acts = Self.days[index].acts
+    let cast = [stock[8], stock[11], Self.easy]
+    for (who, more) in [(0, CGSize.zero), (0, CGSize(width: -300, height: 0)), (0, CGSize(width: -60, height: 0)), (0, CGSize(width: 60, height: 0)),
+      (0, CGSize(width: 0, height: -200)), (0, CGSize(width: 0, height: 60)), (0, CGSize(width: -300, height: -200)), (1, CGSize(width: -300, height: 0)),
+      (1, CGSize(width: 60, height: 60)), (1, CGSize(width: -60, height: -200))]
+    {
+      let ships = AppSizes.shipped(cast[who], macOS: measuredOn)!
+      let really = [cast[who]: CGSize(width: ships.width + more.width, height: ships.height + more.height), Self.easy: CGSize(width: 100, height: 100)]
+      var homes: [PersistedState?] = [nil, learned(cast)]
+      for today in 1...2 {
+        var stories: [[String]] = []
+        for (home, table) in [(0, true), (1, false)] {
+          let h = run(cast, really: really, knowing: homes[home], later: Double(today) * day)
+          h.controller.goesByTheShippedSizes = table
+          acts(self, h)
+          stories.append(story(h))
+          h.run("float-all")
+          h.scheduler.advance(by: 1)
+          h.controller.saveNow()
+          homes[home] = h.store.saved
+        }
+        #expect(stories[0] == stories[1], "\(Self.days[index].name), day \(today), \(cast[who]) really \(really[cast[who]]!)")
+      }
+    }
+  }
+
+  /// As in the store's suite, from an empty home. Under the hand a window is offered two points less than ships and stops two points over, which is
+  /// no refusal. It has been asked: the next layout must not make a tile of it.
+  @Test func aPointOrTwoOverUnderTheHandMakesNoTileAfterwards() throws {
+    let app = try #require(stock.last { (450...600).contains(AppSizes.shipped($0, macOS: measuredOn)!.width) })
+    let ships = AppSizes.shipped(app, macOS: measuredOn)!
+    let h = run([app, Self.easy], really: [Self.easy: CGSize(width: 100, height: 100)])
+    dock(101, "left", h)
+    let width = try #require(h.frame(WindowID(101))).width
+    #expect(width > ships.width + 1, "or this proves nothing: it has more than ships, and has not been asked")
+    #expect(h.run("resize 101 right \(Int(ships.width - 2 - width))").ok)
+    h.scheduler.advance(by: 1)
+    #expect(h.controller.freshLayout(of: h.display)?.windowFrames[WindowID(101)] != nil, "what a layout made now would say")
+    h.run("show-all")
+    h.scheduler.advance(by: 1)
+    #expect(h.layout?.windowFrames[WindowID(101)] != nil)
+  }
+
+  /// Found by a reader. A lender is believed unasked (the store's spec); `relayout` is one of the cures it names, and what ships came back at once.
+  @Test func layingOutAfreshCuresWhatShipsTooHigh() throws {
+    let wide = DisplaySnapshot(
+      id: DisplayID("main"), frame: CGRect(x: 0, y: 0, width: 1728, height: 1117), visibleFrame: CGRect(x: 0, y: 37, width: 1728, height: 1080),
+      isMain: true, isBuiltIn: true)
+    let h = Harness(displays: [wide], settings: Self.still)
+    h.controller.goesByTheShippedSizes = true
+    h.controller.macOSVersion = measuredOn
+    open("com.apple.finder", really: CGSize(width: 300, height: 200), in: h, pid: 2000)
+    open("com.example.large", really: CGSize(width: 1188, height: 600), in: h, pid: 2001)
+    h.start()
+    dock(101, "left", h)
+    dock(102, "right", h)
+    #expect(h.layout?.windowFrames[WindowID(102)] == nil, "or this proves nothing: Finder is believed to have nothing to spare")
+    h.run("relayout")
+    h.scheduler.advance(by: 1)
+    #expect(h.layout?.windowFrames[WindowID(102)] != nil, "both fit")
+    expectWindowsMatchLayout(h)
+  }
+
+  // MARK: Traces
+
+  /// A scenario's trace begins before anything is open, and so does many a recording on a Mac.
+  @Test(arguments: [TraceReplayer.Mode.free, .strict]) func aReplayForeseesAStockAppThatOpenedDuringTheRecording(mode: TraceReplayer.Mode) throws {
+    let three = try #require(threes.first)
+    let h = run([])
+    h.run("trace on later")
+    for (index, app) in three.enumerated() { open(app, in: h, pid: Int32(2000 + index)) }
+    #expect(arrange(h) == [], "or this proves nothing: the recording foresaw them")
+    h.run("trace off")
+    let trace = try Trace(text: try #require(h.lastTrace))
+    let replayer = TraceReplayer(trace, mode: mode)
+    #expect(replayer.run().problems == [])
+    for window in [WindowID(101), WindowID(102), WindowID(103)] { #expect(replayer.harness.frame(window) == h.frame(window)) }
+  }
+
+  /// Found by a reader: in the recording what ships came back after `relayout`; in the replay, which was told it as if learned, it was forgotten.
+  @Test(arguments: [TraceReplayer.Mode.free, .strict]) func aReplayLaysOutAfreshAsTheRecordingDid(mode: TraceReplayer.Mode) throws {
+    let three = Array(stock[8...10])
+    let h = run(three, really: Dictionary(uniqueKeysWithValues: three.map { app in
+      let ships = AppSizes.shipped(app, macOS: measuredOn)!
+      return (app, CGSize(width: ships.width + 60, height: ships.height))
+    }))
+    h.run("trace on afresh")
+    _ = arrange(h)
+    h.run("relayout")
+    h.scheduler.advance(by: 1)
+    h.run("show-all")
+    h.scheduler.advance(by: 1)
+    h.run("trace off")
+    #expect(TraceReplayer(try Trace(text: try #require(h.lastTrace)), mode: mode).run().problems == [])
+  }
+
+  @Test func inATraceWhatShipsIsADayOldAndWhatWasLearnedOutranksIt() throws {
+    let apps = Array(stock.prefix(2))
+    var home = PersistedState(workspaces: [:], hints: [:])
+    var known = AppSizes()
+    known.stoodBy(CGSize(width: 1111, height: 0), app: apps[0], macOS: measuredOn, at: Date(timeIntervalSinceReferenceDate: 800_000_000))
+    home.appSizes = known
+    let h = run(apps, knowing: home, later: 3600)
+    h.run("trace on sizes")
+    h.run("trace off")
+    let header = try JSONDecoder().decode(TraceHeader.self, from: Data(try #require(h.lastTrace?.split(separator: "\n").first).utf8))
+    #expect(header.appSizes?.entry(for: apps[0])?.width == 1111)
+    let age = try #require(header.appSizes?.entry(for: apps[1])).seen.distance(to: h.controller.now())
+    #expect(abs(age - day) < 60, "old enough to be asked about, and far from too old: \(age)")
+  }
+
+  /// Everything above says so itself. The app says nothing, and goes by it.
+  @Test func asArborComesItGoesByWhatShips() {
+    let controller = Controller(
+      system: FakeWindowSystem(), overlays: FakeOverlays(), store: MemoryStateStore(saved: nil), scheduler: ManualScheduler(), settings: Settings(),
+      filter: WindowFilter(ownPID: 1))
+    #expect(controller.goesByTheShippedSizes)
+  }
+
+  @Test func aReplayGoesByItsTraceWhateverTheArborThatReplaysItShipsWith() throws {
+    let apps = Array(stock.prefix(2))
+    let h = run(apps)
+    h.run("trace on sizes")
+    h.run("trace off")
+    let first = try #require(h.lastTrace?.split(separator: "\n").first)
+    let header = try JSONDecoder().decode(TraceHeader.self, from: Data(first.utf8))
+    #expect(header.appSizes?.apps.keys.sorted() == apps.sorted(), "what shipped is told like what was learned")
+
+    let replay = Harness(displays: [laptop], settings: Self.still)
+    replay.controller.goesByTheShippedSizes = true
+    replay.controller.restore(from: header)
+    #expect(!replay.controller.goesByTheShippedSizes)
+    #expect(replay.controller.appSizes.entry(for: apps[0])?.width == Double(AppSizes.shipped(apps[0], macOS: measuredOn)!.width))
+  }
+}
+
+extension CGFloat {
+  fileprivate func clamped(to range: ClosedRange<CGFloat>) -> CGFloat { Swift.min(Swift.max(self, range.lowerBound), range.upperBound) }
+}
