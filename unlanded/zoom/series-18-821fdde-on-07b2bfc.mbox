+/// F16: a view that follows the fingers, from the controller's side. The arithmetic is tested in ArborCoreTests
+/// (`ZoomGestureTests`, `FollowSceneTests`).
+@Suite @MainActor struct FollowGestureTests {
+  let screen = FakeWindowSystem.standardDisplay.frame
+  let content = FakeWindowSystem.standardDisplay.visibleFrame.insetBy(dx: 12, dy: 12)
+
+  /// [a | Desktop | column[b, c]] with d floating on the Desktop, showing everything.
+  struct Set4 {
+    let h: Harness
+    let a: WindowID, b: WindowID, c: WindowID, d: WindowID
+  }
+
+  /// The defaults, with the view following the fingers.
+  static var following: Settings {
+    var settings = Settings()
+    settings.continuousZoom = true
+    return settings
+  }
+
+  func makeHarness(settings: Settings = following, displays: [DisplaySnapshot] = [FakeWindowSystem.standardDisplay]) -> Set4 {
+    let h = Harness(displays: displays, settings: settings)
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let b = h.system.open(app: "Notes", pid: 12, frame: CGRect(x: 300, y: 200, width: 600, height: 400))
+    let c = h.system.open(app: "Mail", pid: 13, frame: CGRect(x: 320, y: 220, width: 600, height: 400))
+    let d = h.system.open(app: "Music", pid: 14, frame: CGRect(x: 520, y: 300, width: 400, height: 300))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) right")
+    h.run("dock \(c.rawValue) beside \(b.rawValue) bottom")
+    h.system.userMove(d, to: CGRect(x: 520, y: 300, width: 400, height: 300))
+    h.scheduler.runPending()
+    forget(h)
+    return Set4(h: h, a: a, b: b, c: c, d: d)
+  }
+
+  func forget(_ h: Harness) {
+    h.overlays.clearTransitions()
+    h.system.clearFrameLog()
+  }
+
+  func send(
+    _ h: Harness, _ phase: GestureUpdate.Phase, magnification: Double = 0, pan: CGSize = .zero, at point: CGPoint? = nil
+  ) {
+    h.controller.gesture(
+      GestureUpdate(phase: phase, location: point ?? h.system.cursor, magnification: magnification, pan: pan))
+  }
+
+  /// A whole gesture over `window`, in ten updates.
+  func pinch(_ h: Harness, by magnification: Double = 0, pan: CGSize = .zero, over window: WindowID? = nil) {
+    if let window { h.system.cursor = h.frame(window)!.center }
+    send(h, .began)
+    for _ in 0..<10 {
+      send(h, .changed, magnification: magnification / 10, pan: CGSize(width: pan.width / 10, height: pan.height / 10))
+    }
+    send(h, .ended)
+    h.system.reportFocus()
+  }
+
+  func frames(_ s: Set4) -> [CGRect?] { [s.a, s.b, s.c, s.d].map { s.h.frame($0) } }
+
+  /// Everything a user could tell two Arbors apart by.
+  func expectSame(_ x: Set4, _ y: Set4, sourceLocation: SourceLocation = #_sourceLocation) {
+    #expect(frames(x) == frames(y), sourceLocation: sourceLocation)
+    #expect(x.h.workspace == y.h.workspace, "camera, history, tree and floating windows", sourceLocation: sourceLocation)
+    #expect(x.h.layout == y.h.layout, sourceLocation: sourceLocation)
+    #expect(x.h.controller.parked == y.h.controller.parked, sourceLocation: sourceLocation)
+    #expect(x.h.system.focused == y.h.system.focused, sourceLocation: sourceLocation)
+    #expect(x.h.overlays.scenes == y.h.overlays.scenes, sourceLocation: sourceLocation)
+  }
+
+  // MARK: Beginning and following
+
+  @Test func whenAGestureBeginsTheStageGoesUpAndNothingElseHappens() throws {
+    let s = makeHarness()
+    let before = (frames(s), s.h.workspace, s.h.layout)
+    send(s.h, .began)
+    let scene = try #require(s.h.overlays.held[s.h.display])
+    #expect(s.h.controller.isFollowingGesture(on: s.h.display))
+    #expect(scene.frame == screen && scene.opening == s.h.visibleFrame)
+    #expect(Set(scene.items.map(\.window)) == [s.a, s.b, s.c, s.d])
+    for item in scene.items {
+      #expect(item.from == s.h.frame(item.window), "each stand-in is where its window is")
+      #expect(item.pid == s.h.controller.windows[item.window]?.pid, "for the tile's colour and icon")
+      #expect(item.bundleID != nil && item.bundleID == s.h.controller.windows[item.window]?.bundleID, "and its app's colour")
+    }
+    #expect(scene.fixed.isEmpty)
+    #expect(s.h.system.frameLog.isEmpty && s.h.overlays.transitions.isEmpty)
+    #expect((frames(s), s.h.workspace, s.h.layout) == before)
+  }
+
+  @Test func whileItLastsOnlyTheStandInsMove() throws {
+    let s = makeHarness()
+    let before = (frames(s), s.h.workspace, s.h.layout)
+    s.h.system.cursor = s.h.frame(s.a)!.center
+    send(s.h, .began)
+    var width = s.h.frame(s.a)!.width
+    for step in 1...8 {
+      send(s.h, .changed, magnification: 0.1)
+      #expect(s.h.overlays.followFrames.count == step + 1, "one for each update, the first included")
+      let standIn = try #require(s.h.overlays.standIn(s.a))
+      #expect(standIn.width > width, "a grows")
+      #expect(standIn.minX == content.minX && standIn.minY == content.minY && standIn.height == content.height)
+      width = standIn.width
+    }
+    #expect(abs(width - s.h.frame(s.a)!.width * CGFloat(exp(0.8))) < 0.01, "as the fingers say")
+    #expect(s.h.overlays.standIn(s.b)!.minX > s.h.frame(s.b)!.minX, "and pushes the others off to the right")
+    #expect(s.h.system.frameLog.isEmpty && s.h.overlays.transitions.isEmpty)
+    #expect((frames(s), s.h.workspace, s.h.layout) == before)
+  }
+
+  @Test func theMovementThatComesWithTheBeginningCounts() {
+    let s = makeHarness()
+    send(s.h, .began, magnification: -0.3)
+    #expect(s.h.overlays.followFrames.last!.map.scaleX < 0.9)
+  }
+
+  // MARK: Acceptance criterion 2: a gesture ends like the command that leads to the same space
+
+  @Test func aPinchInEndsLikeIn() {
+    let (s, other) = (makeHarness(), makeHarness())
+    pinch(s.h, by: 0.4, over: s.b)
+    other.h.system.cursor = other.h.frame(other.b)!.center
+    other.h.run("in")
+    expectSame(s, other)
+    #expect(s.h.workspace.camera == s.h.workspace.tree.parent(of: s.h.workspace.tree.leaf(containing: s.b)!))
+    expectWindowsMatchLayout(s.h, on: s.h.display)
+  }
+
+  // MARK: Where F16 meets F55: with `continuousZoom` the router streams a scroll with ⌃⌥ held, and a wheel's notches
+
+  /// What the taps do: the router gathers, the main actor collects.
+  private func scroll(
+    _ h: Harness, _ router: inout GestureRouter, _ phase: ScrollClaim.Phase, _ pan: CGSize = .zero, notch: Bool = false
+  ) {
+    let answer = router.scroll(phase, pan: pan, at: h.system.cursor, keys: .arbors, hasNotches: notch)
+    #expect(answer.swallow)
+    #expect(answer.commands.isEmpty, "streamed, not stepped")
+    for update in router.drain() { h.controller.gesture(update) }
+    if phase != .began, phase != .changed { h.system.reportFocus() }
+  }
+
+  private func makeRouter() -> GestureRouter {
+    var router = GestureRouter()
+    router.zoomsWithScroll = true
+    _ = router.setContinuous(true)
+    return router
+  }
+
+  @Test func aNotchOfAWheelEndsLikeInAndTheNextLikeOut() {
+    let (s, other) = (makeHarness(), makeHarness())
+    var router = makeRouter()
+    for set in [s, other] { set.h.system.cursor = set.h.frame(set.b)!.center }
+    scroll(s.h, &router, .none, CGSize(width: 0, height: 1), notch: true)
+    other.h.run("in")
+    expectSame(s, other)
+    #expect(s.h.workspace.camera != s.h.workspace.tree.root, "a notch is worth exactly what commits a pinch")
+    #expect(s.h.overlays.held.isEmpty)
+    scroll(s.h, &router, .none, CGSize(width: 0, height: -1), notch: true)
+    other.h.run("out")
+    expectSame(s, other)
+    #expect(s.h.workspace.camera == s.h.workspace.tree.root)
+  }
+
+  @Test func aScrollUpWithTheKeysHeldIsFollowedLikeAPinchAndEndsLikeIn() {
+    let (s, other) = (makeHarness(), makeHarness())
+    var router = makeRouter()
+    for set in [s, other] { set.h.system.cursor = set.h.frame(set.b)!.center }
+    let before = frames(s)
+    scroll(s.h, &router, .began)
+    // 64 points of travel at 40 to a step are 0.4 of a pinch.
+    for _ in 0..<8 { scroll(s.h, &router, .changed, CGSize(width: 0, height: 8)) }
+    #expect(s.h.overlays.held[s.h.display] != nil)
+    #expect(frames(s) == before, "nothing real moves under the fingers")
+    #expect((s.h.overlays.followFrames.last?.map.scaleX ?? 0) > 1)
+    scroll(s.h, &router, .ended)
+    other.h.run("in")
+    expectSame(s, other)
+  }
