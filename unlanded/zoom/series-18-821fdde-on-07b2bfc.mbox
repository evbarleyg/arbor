+  /// Whether the view on `display` is following the fingers right now.
+  public func isFollowingGesture(on display: DisplayID) -> Bool { followed?.display == display }
+
+  // MARK: Beginning
+
+  /// Puts the stage up. Everything that takes time happens here, once per gesture.
+  private func beginFollowing(at point: CGPoint) {
+    guard settings.continuousZoom, let id = displayID(at: point), let display = display(id),
+      let workspace = workspaces[id], let layout = layouts[id],
+      // While nothing is docked there is nowhere to go, and Arbor shows nothing of itself.
+      !workspace.tree.allWindows.isEmpty
+    else { return }
+    let visible = framesInView(on: display)
+    if settings.desktopPinchSteps, layout.leafOrTile(at: point, in: workspace.tree) == workspace.tree.desktop,
+      !visible.values.contains(where: { $0.contains(point) })
+    {
+      return
+    }
+    let present = presentWindowIDs()
+    // What the layout was made with, or the stand-ins would not lie on their windows.
+    let options = options(for: id).layoutOptions
+    let plane = Plane(
+      tree: workspace.tree, layout: layout, ancestor: workspace.tree.root, options: options,
+      isPresent: { present.contains($0) })
+    var feel = ZoomFeel()
+    feel.panSensitivity = settings.panSpeed
+    gestureSteps.threshold = settings.pinchThreshold
+    feel.commitment = gestureSteps.effectiveThreshold
+    let stack = system.stackedWindows().map(\.id)
+    guard
+      let zoom = ZoomGesture(
+        plane: plane, tree: workspace.tree, isPresent: { present.contains($0) },
+        toward: aim(of: point, stack: stack, visible: visible, workspace: workspace, plane: plane), feel: feel)
+    else { return }
+
+    let minimums = minimumSizes
+    var scene = FollowScene(
+      display: id, frame: display.frame, opening: layout.frame, plane: plane, visible: visible,
+      away: floatingWindowsOutOfView(on: display, plane: plane),
+      fixed: Set(visible.keys.filter { !ridesThePlane($0, of: workspace) }),
+      minimumUsableSize: options.minimumUsableSize, minimumSize: { minimums[$0] },
+      frontToBack: stack)
