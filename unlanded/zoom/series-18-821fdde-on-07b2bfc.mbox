+      return returnFromFollowing()
+    }
+    gesture.zoom.move(magnification: update.magnification, pan: update.pan)
+    let map = gesture.zoom.map
+    gesture.frame = FollowFrame(display: gesture.display, map: map, covers: gesture.scene.covers(under: map))
+    gesture.lastUpdate = now()
