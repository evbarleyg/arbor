--- /dev/null
+++ b/Sources/ArborTesting/ChaosFollow.swift
@@ -0,0 +1,50 @@
+import ArborCore
+import ArborKit
+import CoreGraphics
+
+/// What a view that follows the fingers (F16) has to keep to, whatever else is going on.
+extension ChaosRunner {
+  /// The display whose view is following the fingers.
+  var followedDisplay: DisplayID? {
+    guard isRunning else { return nil }
+    return displayIDsSeen.sorted().first { controller.isFollowingGesture(on: $0) }
+  }
+
+  func followViolations(after action: ChaosAction, _ problems: inout [InvariantViolation]) {
+    let held = harness.overlays.held.keys.sorted()
+    // The stage hides the real windows, and only the gesture it belongs to ever takes it down.
+    for display in held where !controller.isFollowingGesture(on: display) {
+      problems.append(.init("stage-left-up", "the stage on \(display) is held and no gesture is followed there"))
+    }
+    if held.count > 1 { problems.append(.init("stage-left-up", "stages are held on \(held)")) }
+    if let display = followedDisplay {
+      if !controller.displays.contains(where: { $0.id == display }) {
+        problems.append(.init("follows-nothing", "a gesture is followed on \(display), which is gone"))
+      }
+      if !held.contains(display) {
+        problems.append(.init("follows-nothing", "a gesture is followed on \(display), where no stage is held"))
+      }
+      // The net under an end that got lost.
+      if !harness.scheduler.pendingKeys.contains("gesture") {
+        problems.append(.init("follows-for-ever", "a gesture is followed on \(display) and no timer would end it"))
+      }
+    } else if harness.scheduler.pendingKeys.contains("gesture") {
+      problems.append(.init("timers", "the timer `gesture` is pending and no gesture is followed"))
+    }
+    for frame in harness.overlays.followFrames.suffix(1) {
+      let map = frame.map
+      if !(map.scaleX.isFinite && map.scaleY.isFinite && map.offsetX.isFinite && map.offsetY.isFinite && map.scaleX > 0 && map.scaleY > 0) {
+        problems.append(.init("follow-map", "the stand-ins on \(frame.display) were sent to \(map)"))
+      }
+    }
+    // Under the fingers nothing real changes: that is what makes taking the stage down the same as cancelling.
+    guard case .fingers = action, let display = followedBefore, followedDisplay == display else { return }
+    if system.frameLog.count != frameLogMark {
+      let moved = system.frameLog[frameLogMark...].map(\.window).sorted()
+      problems.append(.init("moved-under-the-fingers", "\(moved) moved while the view on \(display) followed the fingers"))
+    }
+    if controller.workspaces != workspacesBefore {
+      problems.append(.init("moved-under-the-fingers", "the arrangement changed while the view on \(display) followed the fingers"))
+    }
+  }
+}
