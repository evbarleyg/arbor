diff --git a/Sources/ArborCore/FollowScene.swift b/Sources/ArborCore/FollowScene.swift
new file mode 100644
index 0000000..2579300
--- /dev/null
+++ b/Sources/ArborCore/FollowScene.swift
@@ -0,0 +1,196 @@
+import CoreGraphics
+
+/// What a stage shows while the view follows the fingers (docs/features/F16-continuous-zoom-and-pan.md): one
+/// stand-in per window, each where the window is on the plane when the gesture begins. On the display
+/// that is exactly where the real windows are, so nobody sees the stage go up.
+///
+/// It is made once per gesture. After that a `FollowFrame` per update says how the plane lies.
+public struct FollowScene: Equatable, Sendable {
+  /// A floating window that is out of view, and so has no frame to go by.
+  public struct Away: Equatable, Sendable {
+    /// The frame it gets in a view that shows `host` at `hostFrame`.
+    public var frame: CGRect
+    /// The space it belongs to: the Desktop, or for a guest the space it opened over.
+    public var host: NodeID
+    public var hostFrame: CGRect
+
+    public init(frame: CGRect, host: NodeID, hostFrame: CGRect) {
+      self.frame = frame
+      self.host = host
+      self.hostFrame = hostFrame
+    }
+  }
+
+  /// A docked window's room, which decides whether it shows as itself or as a tile.
+  struct Room: Equatable, Sendable {
+    /// The size of its slot on the plane.
+    var slot: CGSize
+    /// A slot smaller than this on the display is a tile.
+    var least: CGSize
+  }
+
+  public var display: DisplayID
+  /// The display's full frame, which the stage covers.
+  public var frame: CGRect
+  /// The part of the display the arrangement is seen through: its visible frame. Beyond it (behind the menu bar,
+  /// around the Dock) nothing that rides the plane shows. A window just out of view begins there, and
+  /// would come into sight with the stage.
+  public var opening: CGRect
+  /// Back to front. `from` and `to` are both the window's place on the plane, and so with the looks and
+  /// opacities. The window's app is left for the caller to fill in, as in a planned `Transition`.
+  public var items: [Transition.Item]
+  /// The windows that stay where they are on the display whatever the plane does.
+  public var fixed: Set<WindowID>
+  var rooms: [WindowID: Room] = [:]
+
+  /// - Parameters:
+  ///   - frame, opening: the display's full frame and its visible frame.
+  ///   - plane: the display as it is now, wide enough to hold everything.
+  ///   - visible: where every window that shows as itself on the display really is (`Keyframe.visible`).
+  ///   - away: the floating windows that are out of view.
+  ///   - fixed: those of `visible` that do not belong to the plane: windows Arbor leaves alone, which
+  ///     the stage hides like any other, and windows that are kept in view (pinned).
+  ///   - minimumUsableSize, minimumSize: what the layout was made with.
+  ///   - frontToBack: how the real windows are stacked. Windows it does not list are drawn at the back.
+  public init(
+    display: DisplayID, frame: CGRect, opening: CGRect, plane: Plane, visible: [WindowID: CGRect],
+    away: [WindowID: Away] = [:], fixed: Set<WindowID> = [], minimumUsableSize: CGSize = .zero,
+    minimumSize: (WindowID) -> CGSize? = { _ in nil }, frontToBack: [WindowID] = []
+  ) {
+    self.display = display
+    self.frame = frame
+    self.opening = opening
+    self.fixed = fixed.intersection(visible.keys)
+
+    var places: [WindowID: (frame: CGRect, look: Plane.Look)] = [:]
+    for (window, frame) in visible { places[window] = (frame, .picture) }
+    for (window, spot) in plane.windows {
+      if !fixed.contains(window) {
+        let learned = minimumSize(window) ?? .zero
+        rooms[window] = Room(
+          slot: spot.frame.size,
+          least: CGSize(
+            width: max(minimumUsableSize.width, learned.width), height: max(minimumUsableSize.height, learned.height)))
+      }
+      guard places[window] == nil else { continue }
+      switch (spot.visibility, spot.look) {
+      case (.outside, _), (.inView, .cover):
+        places[window] = (spot.frame, spot.look)
+      case (.behind, _), (.inView, .picture):
+        // An inactive tab is covered by the active one wherever the tab group goes. And a window that
+        // should show as itself but is not in `visible` is not there: its app did not let it be moved.
+        rooms[window] = nil
+      }
+    }
+    for (window, away) in away where places[window] == nil {
+      guard let host = plane.nodes[away.host], let map = PlaneMap(carrying: away.hostFrame, onto: host) else { continue }
+      places[window] = (map.apply(away.frame), .picture)
+    }
+
+    var depth: [WindowID: Int] = [:]
+    for (index, window) in frontToBack.enumerated() where depth[window] == nil { depth[window] = index }
+    items =
+      places.filter { $0.value.frame.isFinite }
+      .map { window, place in
+        Transition.Item(window: window, from: place.frame, to: place.frame, fromLook: place.look, toLook: place.look)
+      }
+      .sorted { a, b in
+        let (da, db) = (depth[a.window] ?? .max, depth[b.window] ?? .max)
+        return da != db ? da > db : a.window < b.window
+      }
+  }
+
+  public subscript(window: WindowID) -> Transition.Item? { items.first { $0.window == window } }
+
+  /// The docked windows that are too small to show as themselves when the plane lies as `map` says. It is the
+  /// layout's own rule for tiles, so a window turns into a tile, and a tile into a window, about where
+  /// it will if the fingers lift there.
+  public func covers(under map: PlaneMap) -> Set<WindowID> {
+    var covers: Set<WindowID> = []
+    for (window, room) in rooms
+    where room.slot.width * map.scaleX < room.least.width - 0.5 || room.slot.height * map.scaleY < room.least.height - 0.5 {
+      covers.insert(window)
+    }
+    return covers
+  }
+
+  /// Where the stand-in of `item` is when the plane lies as `map` says.
+  public func place(of item: Transition.Item, under map: PlaneMap) -> CGRect {
+    fixed.contains(item.window) ? item.from : map.apply(item.from)
+  }
+}
+
+/// One moment of a view that follows the fingers: all a stage needs to place the stand-ins of its `FollowScene`.
+public struct FollowFrame: Equatable, Sendable {
+  public var display: DisplayID
+  /// Carries each stand-in from its place on the plane to its place on the display.
+  public var map: PlaneMap
+  /// The windows that look like tiles now. All others show as themselves.
+  public var covers: Set<WindowID>
+
+  public init(display: DisplayID, map: PlaneMap, covers: Set<WindowID> = []) {
+    self.display = display
+    self.map = map
+    self.covers = covers
+  }
+}
+
+/// How a layer has to be scaled and shifted for what it draws to ride the plane.
+public struct LayerShift: Equatable, Sendable {
+  public var scaleX: CGFloat
+  public var scaleY: CGFloat
+  public var x: CGFloat
+  public var y: CGFloat
+
+  public static let none = LayerShift(scaleX: 1, scaleY: 1, x: 0, y: 0)
+
+  /// For a layer that covers `frame` (a rectangle in global coordinates) and draws in coordinates of its own, origin at the
+  /// bottom-left corner and y up, as Core Animation has it. A layer's transform turns about its middle, so that is what
+  /// the shift is reckoned from. `none` for a map or a frame that is not finite: Core Animation raises an exception for those.
+  /// A scale is never less than a thousandth: nothing would make a transform that cannot be turned back.
+  public init(carrying map: PlaneMap, in frame: CGRect) {
+    let (scaleX, scaleY) = (max(map.scaleX, 0.001), max(map.scaleY, 0.001))
+    // A point p of the layer is (x - minX, maxY - y) of the display. Where the map takes it is scale * p + d.
+    let d = CGPoint(x: (scaleX - 1) * frame.minX + map.offsetX, y: (1 - scaleY) * frame.maxY - map.offsetY)
+    self.init(
+      scaleX: scaleX, scaleY: scaleY, x: d.x + (scaleX - 1) * frame.width / 2, y: d.y + (scaleY - 1) * frame.height / 2)
+    if !(scaleX.isFinite && scaleY.isFinite && x.isFinite && y.isFinite) { self = .none }
+  }
+
+  init(scaleX: CGFloat, scaleY: CGFloat, x: CGFloat, y: CGFloat) {
+    (self.scaleX, self.scaleY, self.x, self.y) = (scaleX, scaleY, x, y)
+  }
+}
+
+// MARK: Text form
+
+extension FollowScene {
+  /// The stage drawn as text, for arbor-sim and tests: windows that show as themselves are boxes drawn with `+-|`,
+  /// tiles with `#`, windows that do not ride the plane with `~`. What lies beyond the opening is cut off.
+  public func ascii(
+    under frame: FollowFrame, columns: Int = 72, rows: Int = 22, label: (WindowID) -> String = { $0.description }
+  ) -> String {
+    var drawing = Layout(camera: NodeID(0), frame: opening)
+    var still: [WindowID: CGRect] = [:]
+    for item in items {
+      let place = place(of: item, under: frame.map)
+      guard place.overlaps(opening) else { continue }
+      if fixed.contains(item.window) {
+        still[item.window] = place
+      } else if frame.covers.contains(item.window) {
+        drawing.tiles.append(
+          Tile(node: NodeID(0), kind: .window, frame: place.intersection(opening), windows: [item.window], miniature: [:]))
+      } else {
+        drawing.windowFrames[item.window] = place.intersection(opening)
+      }
+    }
+    let lines = AsciiRenderer.render(
+      drawing, tree: LayoutTree(), floating: still, columns: columns, rows: rows, label: label
+    ).split(separator: "\n", omittingEmptySubsequences: false)
+    func percent(_ scale: CGFloat) -> String {
+      scale.isFinite && abs(scale) < 1e9 ? "\(Int((scale * 100).rounded()))%" : "\(scale)"
+    }
+    return (lines.dropLast() + ["following the fingers: \(percent(frame.map.scaleX)) wide, \(percent(frame.map.scaleY)) high"])
+      .joined(separator: "\n")
+  }
+}
diff --git a/Sources/ArborCore/PanSteps.swift b/Sources/ArborCore/PanSteps.swift
new file mode 100644
index 0000000..372bc90
--- /dev/null
+++ b/Sources/ArborCore/PanSteps.swift
@@ -0,0 +1,59 @@
+import CoreGraphics
+
+/// Turns a two-finger pan into steps to neighbouring spaces, for where the view cannot follow the fingers (macOS's Reduce
+/// motion). It ends where a view that followed would land (`ZoomGesture.landing`): a third of the view's width or
+/// height is enough for the first neighbour, and each one after that takes a whole view more.
+///
+/// A step is taken at once, so the way back needs a threshold of its own, or fingers that tremble on the line would step to
+/// and fro: a step is taken back when half of what it took is left.
+public struct PanSteps: Equatable, Sendable {
+  /// How far the content has travelled since the gesture began.
+  public private(set) var travel = CGSize.zero
+  /// The steps taken so far, right and down counted as positive.
+  private var taken = (across: 0, down: 0)
+
+  public init() {}
+
+  public static func == (a: PanSteps, b: PanSteps) -> Bool { a.travel == b.travel && a.taken == b.taken }
+
+  /// Forgets the gesture in progress.
+  public mutating func reset() { self = PanSteps() }
+
+  /// Adds what the fingers did since the last call and says which way to step, in order.
+  ///
+  /// - Parameters:
+  ///   - pan: `GestureUpdate.pan`: the way the content moves.
+  ///   - speed: `Settings.panSpeed`.
+  ///   - view: the size of what a space in view fills.
+  public mutating func feed(pan: CGSize, speed: Double, view: CGSize) -> [Edge] {
+    guard pan.width.isFinite, pan.height.isFinite, speed.isFinite, speed > 0, view.width >= 1, view.height >= 1 else {
+      return []
+    }
+    // No gesture means more than a few views.
+    func bounded(_ value: CGFloat, _ length: CGFloat) -> CGFloat { min(max(value, -4 * length), 4 * length) }
+    travel.width = bounded(travel.width + pan.width * CGFloat(speed), view.width)
+    travel.height = bounded(travel.height + pan.height * CGFloat(speed), view.height)
+    var steps: [Edge] = []
+    // The content moves one way, so the view goes the other.
+    Self.step(&taken.across, to: -travel.width / view.width, .right, .left, &steps)
+    Self.step(&taken.down, to: -travel.height / view.height, .bottom, .top, &steps)
+    return steps
+  }
+
+  /// `place` is how many views the view has travelled.
+  private static func step(_ taken: inout Int, to place: CGFloat, _ onward: Edge, _ back: Edge, _ steps: inout [Edge]) {
+    let (commit, retreat): (CGFloat, CGFloat) = (1.0 / 3, 1.0 / 6)
+    while true {
+      let here = CGFloat(taken)
+      if place >= (taken >= 0 ? here + commit : here + 1 - retreat) {
+        taken += 1
+        steps.append(onward)
+      } else if place <= (taken <= 0 ? here - commit : here - 1 + retreat) {
+        taken -= 1
+        steps.append(back)
+      } else {
+        return
+      }
+    }
+  }
+}
