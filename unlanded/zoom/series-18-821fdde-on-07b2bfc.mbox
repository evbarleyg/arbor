+/// Two fingers in the chaos test (docs/TESTING.md, "Chaos"; `ChaosFollow.swift`).
+@Suite @MainActor struct ChaosFollowTests {
+  func isFollowing(_ world: ChaosRunner) -> Bool {
+    world.isRunning && world.controller.displays.contains { world.controller.isFollowingGesture(on: $0.id) }
+  }
+
+  static let three = """
+    open 101 Safari pid 1000 at 100 100 600 400
+    open 102 Notes pid 1001 at 300 200 600 400
+    open 103 Mail pid 1002 at 500 300 600 400
+    settings {"continuousZoom":true}
+    launch
+    dock 101 left
+    dock 102 right
+    settle
+    cursor 200 400
+    """
+
+  /// A rule that is never put to the test holds for ever.
+  @Test func theWalkOftenFindsTheFingersDown() {
+    var (followed, interrupted, cameras) = (0, 0, 0)
+    for seed in UInt64(1)...30 {
+      let world = ChaosRunner()
+      var generator = ChaosGenerator(seed: seed)
+      Log.silenced {
+        for _ in 0..<200 {
+          let (was, before) = (isFollowing(world), world.controller.workspaces.mapValues(\.camera))
+          let action = generator.next(world)
+          _ = world.step(action)
+          guard was else { continue }
+          followed += 1
+          if case .fingers = action {
+            if !isFollowing(world), world.controller.workspaces.mapValues(\.camera) != before { cameras += 1 }
+          } else {
+            interrupted += 1
+          }
+        }
+      }
+    }
+    // About half of what it is today (420, 60 and 12): every new kind of event moves the walk, and only a collapse matters. The first
+    // version followed the fingers in 137 steps, landed six times, and a hunt that found nothing proved nothing.
+    #expect(followed > 200, "\(followed) steps began with the fingers down")
+    #expect(interrupted > 30, "\(interrupted) of them were something else happening")
+    #expect(cameras > 5, "\(cameras) gestures moved the view")
+  }
+
+  @Test func aScriptCanPinchAndTheRulesHold() {
+    let world = ChaosRunner()
+    for action in ChaosAction.script(Self.three + "\nfingers began 0 0 0\nfingers changed 0.4 0 0") {
+      #expect(world.step(action).isEmpty, "\(action)")
+    }
+    #expect(isFollowing(world))
+    #expect(world.step(ChaosAction(text: "fingers ended 1.5 0 0")).isEmpty)
+    #expect(!isFollowing(world))
+    #expect(world.controller.parked.contains(WindowID(102)), "the view is on 101")
+  }
+
+  @Test func withReduceMotionThereIsNoStageAndTheSettingOutlivesArbor() {
+    let world = ChaosRunner()
+    for action in ChaosAction.script(Self.three + "\nreduce-motion on\ncrash\nlaunch\nsettle\nfingers began 0 0 0\nfingers changed 0.4 0 0") {
+      #expect(world.step(action).isEmpty, "\(action)")
+    }
+    #expect(!isFollowing(world))
+    #expect(world.harness.overlays.heldScenes.isEmpty)
+  }
+
+  @Test func theWordsReadBack() {
+    for line in [
+      "fingers began 0 0 0", "fingers changed 0.25 -12 7", "fingers ended -1e+300 1e+300 0", "fingers cancelled 0 0 0", "reduce-motion on",
+      "reduce-motion off",
+    ] {
+      let action = ChaosAction(text: line)
+      if case .command = action { Issue.record("`\(line)` was taken for a command") }
+      #expect(ChaosAction(text: action.text) == action)
+    }
+    // What `fingers` was called before it could slide.
+    #expect(ChaosAction(text: "pinch changed -0.3") == .fingers(.changed, magnification: -0.3, pan: .zero))
+    #expect(ChaosAction(text: "pinch changed -0.3").text == "fingers changed -0.3 0 0")
+    // What is not one of the forms is a command, which Arbor turns down.
+    for line in ["fingers", "fingers up 0 0 0", "fingers began nan 0 0", "reduce-motion", "reduce-motion perhaps"] {
+      #expect(ChaosAction(text: line) == .command(line))
+    }
+  }
+
+  // MARK: What the walk has found
+
+  @Test func aGestureEndsWhenTheLastDisplayGoes() {
+    let world = ChaosRunner()
+    for action in ChaosAction.script(Self.three + "\nfingers began 0 0 0\ndisplays windows-first\nfingers changed 0.3 0 0\nsettle") {
+      #expect(world.step(action).isEmpty, "\(action)")
+    }
+  }
+
+  /// The rules themselves, against what they are there to notice.
+  @Test func aStageThatNobodyWouldTakeDownIsNoticed() throws {
+    let world = ChaosRunner()
+    for action in ChaosAction.script(Self.three + "\nfingers began 0 0 0") { _ = world.step(action) }
+    let scene = try #require(world.harness.overlays.held.values.first)
+    #expect(world.step(ChaosAction(text: "fingers cancelled 0 0 0")).isEmpty)
+    // As if the controller had forgotten the gesture without a word to the presenter.
+    _ = world.harness.overlays.hold(scene)
+    #expect(world.step(.cursor(CGPoint(x: 300, y: 300))).map(\.rule).contains("stage-left-up"))
+  }
+
+  @Test func aStageThatCameDownBehindTheControllersBackIsNoticedUntilTheNextUpdate() {
+    let world = ChaosRunner()
+    for action in ChaosAction.script(Self.three + "\nfingers began 0 0 0") { _ = world.step(action) }
+    // A click or a key, which the stage's own monitors see first. The controller hears of it from the next `follow`.
+    world.harness.overlays.userInterruptsStage()
+    #expect(world.step(.cursor(CGPoint(x: 300, y: 300))).map(\.rule) == ["follows-nothing"])
+    #expect(world.step(ChaosAction(text: "fingers changed 0.1 0 0")).isEmpty)
+    #expect(!isFollowing(world))
+  }
