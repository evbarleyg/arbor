+import CoreGraphics
+import Foundation
 
+/// A view that follows the fingers (docs/features/F16-continuous-zoom-and-pan.md).
+///
+/// Real windows cannot be scaled through the Accessibility API, so a gesture never touches them. When it begins
+/// the presenter covers the display with F02's stage, each stand-in where its window is. While it lasts
+/// the controller only tells the stage how the plane lies (`FollowFrame`, worked out by `ZoomGesture`): no
+/// window is asked anything and nothing is laid out. When the fingers lift, the view moves once, as a command would
+/// move it, and the ordinary motion of that move takes the stand-ins from where they are to where the windows went.
+///
+/// So at every moment of a gesture the real windows are where they were when it began, and whatever takes the
+/// stage down (a click, a key, sleep, a display unplugged) leaves things as if it had never begun.
 extension Controller {
-  /// Takes what the fingers have done since the last call (docs/features/F16-continuous-zoom-and-pan.md).
-  /// With `continuousZoom` on, the gesture taps call this on the main actor, at most once per burst of
-  /// events: one `began`, any number of `changed`, one `ended` or `cancelled`, each with the movement
-  /// since the update before it. Tests and arbor-sim can call it with plain values.
+  /// A gesture the view is following.
+  struct FollowedGesture {
+    var display: DisplayID
+    var zoom: ZoomGesture
+    var scene: FollowScene
+    /// What the stage was last told.
+    var frame: FollowFrame
+    var began: Date
+    var lastUpdate: Date
+    var updates = 0
+  }
+
+  /// Fingers that lie still send nothing, so silence does not mean that a gesture is over. But if its end is ever
+  /// lost, a stage would hide the windows until the next click. After this many seconds of silence the view returns.
+  static let gesturePatience: TimeInterval = 30
+
+  /// Takes what the fingers have done since the last call. With `continuousZoom` on, the gesture taps call
+  /// this on the main actor, at most once per burst of events: one `began`, any number of `changed`, one
+  /// `ended` or `cancelled`, each with the movement since the update before it. Anything else that
+  /// zooms by degrees (a mouse wheel, a test, arbor-sim's `pinch` and `pan`) can call it with plain values.
   ///
-  /// This is where F16's model goes: a view that scales and pans with the fingers and settles when they
-  /// lift. Until it does, a streamed pinch steps a level per `pinchThreshold`, as F03's does,
-  /// and the pan is ignored, so that turning the setting on early changes nothing to look at.
+  /// Where there is no stage to follow on (macOS's Reduce motion) and with `continuousZoom` off, a pinch steps a level
+  /// per `pinchThreshold`, as F03's does, and a pan steps to the neighbours (`PanSteps`).
   public func gesture(_ update: GestureUpdate) {
     // A held view follows no fingers (Controller+Hold.swift). The taps are gone then; one that was under way is not.
     guard isRunning, holdLevel != .view else {
+      // Stopping took the stage down already. But whatever else is ever added to this guard must not leave one up.
+      if followed != nil {
+        forgetFollowing()
+        overlays.finishAnimations()
+      }
       gestureSteps.reset()
+      panSteps.reset()
       return
     }
+    if update.phase == .began {
+      // In case the last end was lost.
+      returnFromFollowing()
+      gestureSteps.reset()
+      panSteps.reset()
+      // Someone who is holding a window has no hand free to mean this.
+      guard drag == nil, edgeResize == nil else { return }
+      stats.time("controller", "begin to follow the fingers") { beginFollowing(at: update.location) }
+    }
+    // Timed with what the stage does, so that `stats` on a Mac says whether the view keeps up.
+    if followed != nil { stats.time("controller", "follow the fingers") { follow(update) } } else { step(update) }
+  }
