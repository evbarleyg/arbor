@@ -0,0 +1,110 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+@Suite struct PanStepsTests {
+  let view = CGSize(width: 1200, height: 900)
+
+  @Test func aThirdOfTheViewIsEnoughForTheFirstNeighbour() {
+    var steps = PanSteps()
+    // The content moves left, so the view goes right.
+    #expect(steps.feed(pan: CGSize(width: -399, height: 0), speed: 1, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: -1, height: 0), speed: 1, view: view) == [.right])
+    #expect(steps.feed(pan: CGSize(width: -1, height: 0), speed: 1, view: view) == [], "once")
+  }
+
+  @Test func eachFurtherNeighbourTakesAWholeView() {
+    var steps = PanSteps()
+    #expect(steps.feed(pan: CGSize(width: 400, height: 0), speed: 1, view: view) == [.left])
+    #expect(steps.feed(pan: CGSize(width: 1199, height: 0), speed: 1, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: 1, height: 0), speed: 1, view: view) == [.left])
+    var fast = PanSteps()
+    #expect(fast.feed(pan: CGSize(width: 1600, height: 0), speed: 1, view: view) == [.left, .left])
+  }
+
+  @Test func aStepIsTakenBackWhenHalfOfWhatItTookIsLeft() {
+    var steps = PanSteps()
+    #expect(steps.feed(pan: CGSize(width: -400, height: 0), speed: 1, view: view) == [.right])
+    // Fingers that tremble on the line do not step to and fro.
+    for _ in 0..<5 {
+      #expect(steps.feed(pan: CGSize(width: 30, height: 0), speed: 1, view: view) == [])
+      #expect(steps.feed(pan: CGSize(width: -30, height: 0), speed: 1, view: view) == [])
+    }
+    #expect(steps.feed(pan: CGSize(width: 199, height: 0), speed: 1, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: 1, height: 0), speed: 1, view: view) == [.left])
+    #expect(steps.travel.width == -200)
+    // And on to the other side.
+    #expect(steps.feed(pan: CGSize(width: 600, height: 0), speed: 1, view: view) == [.left])
+    #expect(steps.feed(pan: CGSize(width: -199, height: 0), speed: 1, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: -1, height: 0), speed: 1, view: view) == [.right])
+  }
+
+  @Test func fromTheSecondNeighbourTheSameHolds() {
+    var steps = PanSteps()
+    #expect(steps.feed(pan: CGSize(width: -1600, height: 0), speed: 1, view: view) == [.right, .right])
+    #expect(steps.feed(pan: CGSize(width: 199, height: 0), speed: 1, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: 1, height: 0), speed: 1, view: view) == [.left])
+  }
+
+  @Test func upAndDownWorkTheSameAndBothCanHappenAtOnce() {
+    var steps = PanSteps()
+    #expect(steps.feed(pan: CGSize(width: 0, height: -300), speed: 1, view: view) == [.bottom])
+    steps.reset()
+    #expect(steps.feed(pan: CGSize(width: 0, height: 300), speed: 1, view: view) == [.top])
+    steps.reset()
+    #expect(steps.feed(pan: CGSize(width: -400, height: 300), speed: 1, view: view) == [.right, .top])
+  }
+
+  @Test func theSensitivityCounts() {
+    var steps = PanSteps()
+    #expect(steps.feed(pan: CGSize(width: -223, height: 0), speed: 1.8, view: view) == [.right])
+    steps.reset()
+    #expect(steps.feed(pan: CGSize(width: -5000, height: 0), speed: 0, view: view) == [], "0 turns panning off")
+  }
+
+  @Test func travelIsNotCarriedFromOneGestureToTheNext() {
+    var steps = PanSteps()
+    _ = steps.feed(pan: CGSize(width: -399, height: 0), speed: 1, view: view)
+    steps.reset()
+    #expect(steps == PanSteps())
+    #expect(steps.feed(pan: CGSize(width: -399, height: 0), speed: 1, view: view) == [])
+    _ = steps.feed(pan: CGSize(width: -1, height: 0), speed: 1, view: view)
+    steps.reset()
+    #expect(steps.feed(pan: CGSize(width: -400, height: 0), speed: 1, view: view) == [.right], "nor are the steps taken")
+  }
+
+  @Test func theSameTravelAfterDifferentWaysIsNotTheSameState() {
+    var there = PanSteps()
+    _ = there.feed(pan: CGSize(width: -400, height: 0), speed: 1, view: view)
+    _ = there.feed(pan: CGSize(width: 150, height: 0), speed: 1, view: view)
+    var direct = PanSteps()
+    _ = direct.feed(pan: CGSize(width: -250, height: 0), speed: 1, view: view)
+    #expect(there.travel == direct.travel && there != direct, "one has taken a step")
+    var further = direct
+    _ = further.feed(pan: CGSize(width: -10, height: 0), speed: 1, view: view)
+    #expect(further != direct)
+  }
+
+  @Test func aViewOfAPointEachWayIsTheLeast() {
+    for (size, pan, steps) in [
+      (CGSize(width: 1, height: 900), CGSize(width: 0, height: -300), [Edge.bottom]),
+      (CGSize(width: 900, height: 1), CGSize(width: -300, height: 0), [Edge.right]),
+      (CGSize(width: 0.9, height: 900), CGSize(width: 0, height: -300), []),
+      (CGSize(width: 900, height: 0.9), CGSize(width: -300, height: 0), []),
+    ] {
+      var state = PanSteps()
+      #expect(state.feed(pan: pan, speed: 1, view: size) == steps, "\(size)")
+    }
+  }
+
+  @Test func nonsenseStepsNowhereAndNeverLoops() {
+    var steps = PanSteps()
+    for pan in [CGSize(width: CGFloat.nan, height: 0), CGSize(width: 0, height: CGFloat.infinity)] {
+      #expect(steps.feed(pan: pan, speed: 1, view: view) == [])
+    }
+    #expect(steps.feed(pan: CGSize(width: 10, height: 10), speed: .nan, view: view) == [])
+    #expect(steps.feed(pan: CGSize(width: 500, height: 500), speed: 1, view: .zero) == [])
+    #expect(steps.travel == .zero)
+    #expect(steps.feed(pan: CGSize(width: 1e300, height: -1e300), speed: 10, view: view).count <= 10)
+  }
+}
