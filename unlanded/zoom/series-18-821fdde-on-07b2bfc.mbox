+
+  func layout(camera: NodeID, options: LayoutOptions = roomy, minimumSize: @escaping (WindowID) -> CGSize? = { _ in nil }) -> Layout {
+    LayoutEngine.layout(
+      tree, camera: camera, in: visible, options: options, isPresent: { _ in true }, minimumSize: minimumSize)
+  }
+
+  func plane(camera: NodeID, options: LayoutOptions = roomy, minimumSize: @escaping (WindowID) -> CGSize? = { _ in nil }) -> Plane {
+    Plane(
+      tree: tree, layout: layout(camera: camera, options: options, minimumSize: minimumSize), ancestor: tree.root,
+      options: options, isPresent: { _ in true })
+  }
+
+  /// The scene of a gesture that begins with the view on `camera` and every window where the layout puts it.
+  func scene(
+    camera: NodeID, options: LayoutOptions = roomy, also: [WindowID: CGRect] = [:], away: [WindowID: FollowScene.Away] = [:],
+    fixed: Set<WindowID> = [], minimumSize: @escaping (WindowID) -> CGSize? = { _ in nil }, frontToBack: [WindowID] = []
+  ) -> FollowScene {
+    let layout = layout(camera: camera, options: options, minimumSize: minimumSize)
+    return FollowScene(
+      display: main, frame: screen, opening: visible,
+      plane: plane(camera: camera, options: options, minimumSize: minimumSize),
+      visible: layout.windowFrames.merging(also) { $1 }, away: away, fixed: fixed,
+      minimumUsableSize: options.minimumUsableSize, minimumSize: minimumSize, frontToBack: frontToBack)
+  }
+}
