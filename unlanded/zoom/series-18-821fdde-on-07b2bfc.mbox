+  /// The feature is that it keeps up with the fingers. An update must not ask a window anything, lay anything out,
+  /// redraw an overlay, save or schedule: all it may do is tell the stage how the plane lies.
+  @Test(arguments: [4, 30]) func twoHundredUpdatesCostTwoHundredMaps(windows: Int) {
+    let h = Harness(settings: Self.following)
+    var ids: [WindowID] = []
+    for index in 0..<windows { ids.append(h.system.open(app: "App\(index)", pid: Int32(100 + index))) }
+    h.start()
+    h.run("arrange")
+    h.scheduler.runPending()
+    forget(h)
+    h.system.cursor = h.frame(ids[0])!.center
+    send(h, .began)
+
+    let scenes = h.overlays.scenes
+    let (layout, saves, waiting) = (h.layout, h.store.saveCount, h.scheduler.pendingKeys)
+    let laidOut = h.controller.stats["controller", "lay out a display"]?.count
+    var changes = 0
+    h.controller.observe { _ in changes += 1 }
+    for step in 0..<200 {
+      send(h, .changed, magnification: step < 100 ? 0.02 : -0.03, pan: CGSize(width: step % 7 - 3, height: 1))
+    }
+    #expect(h.overlays.followFrames.count == 201)
+    #expect(h.system.frameLog.isEmpty)
+    #expect(h.overlays.heldScenes.count == 1 && h.overlays.transitions.isEmpty)
+    #expect(h.overlays.scenes == scenes && h.layout == layout)
+    #expect(h.controller.stats["controller", "lay out a display"]?.count == laidOut)
+    #expect(h.controller.stats["controller", "follow the fingers"]?.count == 201, "`stats` says how long they took")
+    #expect(h.store.saveCount == saves && h.scheduler.pendingKeys == waiting && changes == 0)
+    for frame in h.overlays.followFrames {
+      #expect(frame.map.apply(screen).isFinite)
+    }
+  }
