+  /// Many hands add to the controller. `finishAnimations` takes down the stage a gesture is followed on as well, and a gesture that
+  /// is not told goes on being followed, with its timer, until its next update. It has happened twice.
+  @Test func nothingInTheControllerTakesTheStagesDownWithoutEndingTheGesture() throws {
+    let folder = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+      .appendingPathComponent("Sources/ArborKit/Controller")
+    var (files, calls) = (0, 0)
+    for name in try FileManager.default.contentsOfDirectory(atPath: folder.path).sorted() where name.hasSuffix(".swift") {
+      files += 1
+      let lines = try String(contentsOf: folder.appendingPathComponent(name), encoding: .utf8)
+        .split(separator: "\n", omittingEmptySubsequences: false)
+      for (number, line) in lines.enumerated() where line.contains("overlays.finishAnimations()") {
+        calls += 1
+        // On the line before, or on the line itself where it asks whether a gesture was followed.
+        let told = lines[max(number - 1, 0)...number].contains { $0.contains("forgetFollowing()") || $0.contains("followed != nil") }
+        #expect(told, "\(name):\(number + 1) takes every stage down: put `forgetFollowing()` on the line before (Controller+Gesture.swift)")
+      }
+    }
+    #expect(files > 10 && calls >= 8)
+  }
