+    let scene = f.scene(
+      camera: f.leafB, away: [e: FollowScene.Away(frame: there, host: f.tree.desktop, hostFrame: desktop)])
+    let onThePlane = try #require(f.plane(camera: f.leafB).nodes[f.tree.desktop])
+    let item = try #require(scene[e])
+    #expect(item.from.approximatelyEquals(onThePlane.insetBy(dx: onThePlane.width / 4, dy: onThePlane.height / 4), tolerance: 0.01))
+    #expect(!item.from.overlaps(visible))
+    // Zoomed out to everything it is where it will be.
+    var gesture = try #require(
+      ZoomGesture(plane: f.plane(camera: f.leafB), tree: f.tree, isPresent: { _ in true }, toward: content.center))
+    gesture.move(magnification: gesture.reach.lowerBound)
+    #expect(scene.place(of: item, under: gesture.map).approximatelyEquals(there, tolerance: 2))
+  }
+
+  @Test func aFloatingWindowWhoseHostIsNowhereHasNoStandIn() {
+    let f = Fixture()
+    let lost = FollowScene.Away(frame: content, host: NodeID(999), hostFrame: content)
+    let flat = FollowScene.Away(frame: content, host: f.tree.desktop, hostFrame: .zero)
+    let scene = f.scene(camera: f.leafB, away: [e: lost, WindowID(6): flat])
+    #expect(scene[e] == nil && scene[WindowID(6)] == nil)
+  }
+
+  @Test func windowsThatDoNotBelongToThePlaneKeepTheirPlace() {
+    let f = Fixture()
+    let frame = CGRect(x: 900, y: 500, width: 300, height: 200)
+    let scene = f.scene(camera: f.tree.root, also: [e: frame], fixed: [e, WindowID(77)])
+    #expect(scene.fixed == [e], "only windows that have a stand-in")
+    let map = PlaneMap(scaleX: 3, scaleY: 0.2, offsetX: -500, offsetY: 40)
+    #expect(scene.place(of: scene[e]!, under: map) == frame)
+    #expect(scene.place(of: scene[a]!, under: map) == map.apply(scene[a]!.from))
+    #expect(!scene.covers(under: PlaneMap(scaleX: 0.01, scaleY: 0.01, offsetX: 0, offsetY: 0)).contains(e))
+  }
+
+  @Test func standInsAreStackedLikeTheirWindows() {
+    let f = Fixture()
+    let scene = f.scene(camera: f.tree.root, frontToBack: [c, a, c, WindowID(50)])
+    #expect(scene.items.map(\.window) == [b, d, a, c], "back to front; windows nobody knows about at the back, by id")
+  }
+
+  @Test func aFrameThatIsNotFiniteHasNoStandIn() {
+    let f = Fixture()
+    let scene = f.scene(camera: f.tree.root, also: [e: CGRect(x: CGFloat.infinity, y: 0, width: 10, height: 10)])
+    #expect(scene[e] == nil)
+  }
+
+  @Test func theStageCanBeDrawnAsText() {
+    let f = Fixture()
+    let options = LayoutOptions(minimumUsableSize: CGSize(width: 240, height: 160))
+    let scene = f.scene(
+      camera: f.tree.root, options: options, also: [e: CGRect(x: 600, y: 300, width: 300, height: 300)], fixed: [e])
+    let map = PlaneMap(scaleX: 0.6, scaleY: 0.6, offsetX: 288, offsetY: 185)
+    let text = scene.ascii(under: FollowFrame(display: main, map: map, covers: scene.covers(under: map)), columns: 48, rows: 12)
+    #expect(text.contains("following the fingers: 60% wide, 60% high"))
+    #expect(text.contains("#") && text.contains("~w5") && text.contains("|w1"))
+    #expect(text.split(separator: "\n", omittingEmptySubsequences: false).count == 13)
+    let usual = scene.ascii(under: FollowFrame(display: main, map: .identity)).split(separator: "\n", omittingEmptySubsequences: false)
+    #expect(usual.count == 23 && usual[0].count == 72, "the size of `ascii`'s drawing")
+    // Whatever the numbers.
+    for scale in [CGFloat.infinity, .nan, 1e300, -1e300, 0] {
+      let wild = PlaneMap(scaleX: scale, scaleY: scale, offsetX: scale, offsetY: 0)
+      #expect(scene.ascii(under: FollowFrame(display: main, map: wild)).contains("following the fingers"))
+    }
+  }
+
+  // MARK: What else rides the plane
+
+  /// What Core Animation does with an affine transform: about the middle of the layer.
+  private func transformed(_ point: CGPoint, by shift: LayerShift, size: CGSize) -> CGPoint {
+    let middle = CGPoint(x: size.width / 2, y: size.height / 2)
+    return CGPoint(
+      x: middle.x + shift.scaleX * (point.x - middle.x) + shift.x, y: middle.y + shift.scaleY * (point.y - middle.y) + shift.y)
+  }
+
+  @Test func aLayerThatIsShiftedShowsEveryPointWhereTheMapTakesIt() {
+    // A display to the left of and below the main one, so that no origin is nothing.
+    let frame = CGRect(x: -1920, y: 300, width: 1920, height: 1080)
+    func local(_ point: CGPoint) -> CGPoint { CGPoint(x: point.x - frame.minX, y: frame.maxY - point.y) }
+    let maps = [
+      PlaneMap.identity, PlaneMap(scaleX: 2, scaleY: 2, offsetX: 0, offsetY: 0), PlaneMap(scaleX: 1, scaleY: 1, offsetX: 130, offsetY: -70),
+      PlaneMap(scaleX: 0.4, scaleY: 1.7, offsetX: -812.5, offsetY: 44),
+    ]
+    for map in maps {
+      let shift = LayerShift(carrying: map, in: frame)
+      for point in [frame.origin, frame.center, CGPoint(x: frame.maxX, y: frame.maxY), CGPoint(x: -1000, y: 512), CGPoint(x: 50, y: -9)] {
+        let (got, wanted) = (transformed(local(point), by: shift, size: frame.size), local(map.apply(point)))
+        #expect(abs(got.x - wanted.x) < 1e-6 && abs(got.y - wanted.y) < 1e-6, "\(map) \(point): \(got), not \(wanted)")
+      }
+    }
+    #expect(LayerShift(carrying: .identity, in: frame) == .none)
+  }
+
+  @Test func aShiftIsAlwaysFinite() {
+    let frame = CGRect(x: 0, y: 0, width: 1440, height: 900)
+    // Nor is anything scaled to nothing, or turned over.
+    for scale: CGFloat in [0, -2, 1e-9] {
+      let shift = LayerShift(carrying: PlaneMap(scaleX: scale, scaleY: scale, offsetX: 0, offsetY: 0), in: frame)
+      #expect(shift.scaleX == 0.001 && shift.scaleY == 0.001)
+    }
+    for map in [
+      PlaneMap(scaleX: .nan, scaleY: 1, offsetX: 0, offsetY: 0), PlaneMap(scaleX: 1, scaleY: .infinity, offsetX: 0, offsetY: 0),
+      PlaneMap(scaleX: 1, scaleY: 1, offsetX: .infinity, offsetY: 0), PlaneMap(scaleX: 1e308, scaleY: 1, offsetX: 1e308, offsetY: -.nan),
+    ] {
+      #expect(LayerShift(carrying: map, in: frame) == .none)
+    }
+    #expect(LayerShift(carrying: PlaneMap(scaleX: 2, scaleY: 2, offsetX: 0, offsetY: 0), in: CGRect(x: 0, y: 0, width: CGFloat.infinity, height: 900)) == .none)
+  }
+}
