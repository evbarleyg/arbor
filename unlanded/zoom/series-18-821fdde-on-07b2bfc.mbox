diff --git a/collab/scenarios/41-pinch-and-pan.sim b/collab/scenarios/41-pinch-and-pan.sim
new file mode 100644
index 0000000..94ebabe
--- /dev/null
+++ b/collab/scenarios/41-pinch-and-pan.sim
@@ -0,0 +1,110 @@
+# Story: someone with a trackpad never touches the keyboard. They pinch in on a window until it fills the
+# view, slide over to its neighbours with two fingers, change their mind half-way, and pinch out past everything.
+# While the fingers are down nothing real moves: only when they lift does the view move, once.
+# Reference: T36 T37 T41. Window ids start at 101. `pinch 0.7` doubles the size.
+set continuousZoom true
+expect ok
+open Safari
+open Mail
+open Notes
+open Music
+dock 101 left
+dock 102 right
+dock 103 beside 102 bottom
+# Music (104) floats on the Desktop between them.
+expect floating 104
+# A pinch in over Mail, fingers still down: the stage shows it growing, the real windows stay.
+cursor 1200 200
+pinch 0.5 down
+expect camera root
+expect visible 101
+expect left-of 101 102
+# They lift: the view settles on the nearest level, the column of Mail and Notes.
+lift
+expect ok
+expect visible 102
+expect visible 103
+expect hidden 101
+expect hidden 104
+# Once more, further: Mail on its own.
+cursor 700 200
+pinch 1.2
+expect fills 102
+expect hidden 103
+# Back takes the pinches back one at a time, like any other move of the view.
+back
+expect visible 103
+back
+expect camera root
+# One long pinch is one move.
+cursor 1200 200
+pinch 2.5
+expect fills 102
+back
+expect camera root
+# A twitch of the fingers goes nowhere and leaves no history.
+pinch 0.1
+expect camera root
+back
+expect fail
+# Framed on Safari, ⌃⌥ and two fingers to the left bring the Desktop in from the right...
+zoom 101
+cursor 700 400
+pan -500 0
+expect camera desktop
+expect visible 104
+expect hidden 101
+# ...a short slide springs back...
+pan -100 0
+expect camera desktop
+# ...and a long one goes on to the column.
+pan -600 0
+expect visible 102
+expect visible 103
+expect hidden 104
+# There is nothing to the right of the column: the view gives a little and returns.
+pan -900 0
+expect visible 102
+expect visible 103
+# Changing one's mind: out, in again, and macOS cancels the gesture. Nothing has happened.
+pinch -0.9 down
+pinch 0.3 down
+lift cancelled
+expect visible 102
+expect hidden 101
+# Pinching out past everything shrinks the arrangement for as long as the fingers stay down, and lands on everything.
+pinch -3 down
+expect hidden 101
+lift
+expect camera root
+expect visible 101
+expect visible 104
+# A shortcut in the middle of a pinch wins, and the rest of the pinch is ignored.
+cursor 200 400
+pinch 0.6 down
+zoom 103
+expect fills 103
+pinch 2 down
+lift
+expect fills 103
+# Music lies over Safari now. A pinch on it leads to the Desktop, where it lives, not to Safari beneath it.
+show-all
+move 104 100 100 350 400
+focus 104
+cursor 200 300
+pinch 0.8
+expect camera desktop
+expect visible 104
+# With Reduce motion there is nothing to follow with: a pinch steps, at once.
+show-all
+reduce-motion on
+cursor 200 400
+pinch 0.3 down
+expect fills 101
+lift
+expect fills 101
+# And two fingers step to the neighbour.
+pan -300 0 down
+expect camera desktop
+lift
+expect camera desktop
-- 
