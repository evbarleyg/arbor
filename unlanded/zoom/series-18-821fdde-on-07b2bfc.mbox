+  @Test func whereTwoLevelsFitEquallyWellTheDirectionOfTheGestureDecides() throws {
+    let f = Fixture()
+    for (camera, nearer, further) in [(f.tree.root, f.column, f.row), (f.leafC, f.row, f.column)] {
+      let fresh = try f.gesture(from: camera, over: f.leafC)
+      let (a, b) = (fresh.levels.first { $0.node == nearer }!.rect, fresh.levels.first { $0.node == further }!.rect)
+      func lead(_ magnification: Double) -> CGFloat {
+        let view = fresh.pinched(magnification).camera
+        return a.intersectionOverUnion(view) - b.intersectionOverUnion(view)
+      }
+      // Halve the span between a pinch that lands on the one and a pinch that lands on the other.
+      var low = try #require(fresh.magnification(landingOn: nearer))
+      var high = try #require(fresh.magnification(landingOn: further))
+      for _ in 0..<80 {
+        let middle = (low + high) / 2
+        if lead(middle) > 0 { low = middle } else { high = middle }
+      }
+      #expect(abs(lead(low)) < 1e-10)
+      #expect(fresh.pinched(low).landing == further, "from \(camera)")
+    }
+  }
