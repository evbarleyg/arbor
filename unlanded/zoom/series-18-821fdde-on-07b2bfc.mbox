+    #expect(s.h.controller.parked.contains(guest))
+    send(s.h, .began)
+    let host = try #require(s.h.overlays.standIn(s.a))
+    #expect(s.h.overlays.standIn(guest) == place.offsetBy(dx: host.minX - content.minX, dy: 0))
