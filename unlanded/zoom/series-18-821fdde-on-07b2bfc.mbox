+                                        during it. Prints `<ms since 1970> G <magnification> <dx> <dy>`, the sums so far, for
+                                        every event it posts, in the grammar of the camera's log. --tell: writes `mark fingers
+                                        down` and `mark fingers up` there at those very moments (the camera's commands)
     hold <seconds> [--opt] [--ctrl]     keep ⌥ or ⌃ down that long
     wheel x y <notches> [--opt] [--ctrl] [--tap hid|session]
                                         a mouse wheel turned that many notches, up if positive, with ⌥ or ⌃ held
@@ -190,7 +200,7 @@ func number(_ index: Int) -> Double {
 var postAt = CGEventTapLocation.cgSessionEventTap
 
 enum Phase: Double {
-  case began = 1, changed = 2, ended = 4
+  case began = 1, changed = 2, ended = 4, cancelled = 8
 }
 
 /// subtype 8 is a magnification, whose amount is field 113; subtype 5 a rotation, field 114.
@@ -327,6 +337,97 @@ case "scroll":
     scroll(dx: 0, dy: 0, phase: 0, momentum: 3, at: point, flags: [])
   }
 
+case "fingers":
+  enum Move {
+    case pinch(Double, seconds: Double)
+    case slide(dx: Double, dy: Double, seconds: Double)
+    case rest(Double)
+  }
+  let withOption = flag("--opt")
+  let withControl = flag("--ctrl")
+  let listener = option("--tell")
+  let point = CGPoint(x: number(0), y: number(1))
+  var words = Array(arguments.dropFirst(2))
+  let cancelled = words.last == "cancel"
+  if cancelled { words.removeLast() }
+  // All of it is read before any of it is posted: half a gesture leaves fingers down that nobody lifts.
+  let moves: [Move] = words.map { word in
+    let parts = word.split(separator: ":", omittingEmptySubsequences: false).map(String.init)
+    let numbers = parts.dropFirst().compactMap(Double.init).filter(\.isFinite)
+    guard numbers.count == parts.count - 1, let seconds = numbers.last, (0...10).contains(seconds) else {
+      fail("fingers: cannot read the move \(word)\n\(usage)")
+    }
+    switch (parts[0], numbers.count) {
+    case ("pinch", 2): return .pinch(max(-20, min(20, numbers[0])), seconds: seconds)
+    case ("slide", 3): return .slide(dx: max(-10_000, min(10_000, numbers[0])), dy: max(-10_000, min(10_000, numbers[1])), seconds: seconds)
+    case ("rest", 1): return .rest(seconds)
+    default: fail("fingers: cannot read the move \(word)\n\(usage)")
+    }
+  }
+  guard !moves.isEmpty else { fail("fingers: no moves\n\(usage)") }
+  let pinches = moves.contains { if case .pinch = $0 { true } else { false } }
+  var (magnification, dx, dy) = (0.0, 0.0, 0.0)
+  func said() { print("\(Int(Date().timeIntervalSince1970 * 1000)) G \(magnification) \(Int(dx)) \(Int(dy))") }
+  /// Never waits: with nobody listening nothing is told.
+  func tell(_ text: String) {
+    guard let listener else { return }
+    let file = open(listener, O_WRONLY | O_APPEND | O_NONBLOCK)
+    guard file >= 0 else { return }
+    _ = Array("mark \(text)\n".utf8).withUnsafeBytes { write(file, $0.baseAddress, $0.count) }
+    close(file)
+  }
+  let flags = hold(control: withControl, option: withOption, down: true)
+  if pinches {
+    magnify(0, .began, at: point, flags: flags)
+    tell("fingers down")
+    said()
+    rest(0.01)
+  }
+  var sliding = false
+  for move in moves {
+    switch move {
+    case .pinch(let total, let seconds):
+      let steps = max(1, Int(seconds * 100))
+      for _ in 1...steps {
+        magnify(total / Double(steps), .changed, at: point, flags: flags)
+        magnification += total / Double(steps)
+        said()
+        rest(seconds / Double(steps))
+      }
+    case .slide(let across, let down, let seconds):
+      if !sliding {
+        scroll(dx: 0, dy: 0, phase: 1, momentum: 0, at: point, flags: flags)
+        if !pinches { tell("fingers down") }
+        said()
+        sliding = true
+        rest(0.01)
+      }
+      let steps = max(1, Int(seconds * 100))
+      let (fromX, fromY) = (dx, dy)
+      for step in 1...steps {
+        // Scrolls come in whole points. What a step leaves over goes into the next.
+        let (toX, toY) = ((fromX + across * Double(step) / Double(steps)).rounded(), (fromY + down * Double(step) / Double(steps)).rounded())
+        scroll(dx: Int32(toX - dx), dy: Int32(toY - dy), phase: 2, momentum: 0, at: point, flags: flags)
+        (dx, dy) = (toX, toY)
+        said()
+        rest(seconds / Double(steps))
+      }
+    case .rest(let seconds):
+      rest(seconds)
+    }
+  }
+  if sliding {
+    scroll(dx: 0, dy: 0, phase: cancelled ? 8 : 4, momentum: 0, at: point, flags: flags)
+    said()
+  }
+  if pinches {
+    magnify(0, cancelled ? .cancelled : .ended, at: point, flags: flags)
+    said()
+  }
+  tell("fingers up")
+  rest(0.01)
+  _ = hold(control: withControl, option: withOption, down: false)
+
 case "hold":
   let withOption = flag("--opt")
   let withControl = flag("--ctrl")
