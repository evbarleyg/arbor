diff --git a/Sources/ArborCore/ZoomGesture.swift b/Sources/ArborCore/ZoomGesture.swift
new file mode 100644
index 0000000..8647ea8
--- /dev/null
+++ b/Sources/ArborCore/ZoomGesture.swift
@@ -0,0 +1,283 @@
+import CoreGraphics
+import Foundation
+
+/// The numbers that decide how a view that follows the fingers feels. Nobody has measured TrellisWM's,
+/// except `panSensitivity`, so they are kept in one place for whoever tunes them on a trackpad.
+public struct ZoomFeel: Equatable, Sendable {
+  /// Points the view travels for each point the fingers report (TrellisWM's `panSensitivity`). 0 turns panning off.
+  public var panSensitivity: Double = 1.8
+  /// The magnification that is enough to leave the space the gesture began on. Less than this and the
+  /// view returns. It is F03's `pinchThreshold`: a pinch that steps there goes somewhere here.
+  public var commitment: Double = GestureInterpreter.defaultThreshold
+  /// How much smaller than the display everything can get, pinching out past it: 0.35 is 65%.
+  public var shrinkLimit: Double = 0.35
+  /// How much larger than the display a single window can get, pinching in past it.
+  public var growLimit: Double = 0.08
+  /// How much magnification past either end is remembered. The rest is forgotten, so that
+  /// turning back shows at once.
+  public var overshoot: Double = 0.75
+  /// How far the view can be pulled past the edge of everything, as a part of its own size.
+  public var panSlack: Double = 0.12
+  /// A pan lands a little ahead of where it was let go: at most this part of the view's size, and at most
+  /// half as far again. With 1/6 a third of the way to the neighbour is enough to get there.
+  public var panLead: Double = 1.0 / 6
+
+  public init() {}
+}
+
+/// A view that follows the fingers (docs/features/F16-continuous-zoom-and-pan.md): where the virtual camera
+/// is after any amount of pinching and panning, and which space it lands on when the fingers lift.
+///
+/// It works on the plane as it looks when the gesture begins (`Plane`), on which the virtual
+/// camera is a rectangle: at first the rectangle of the space in view. What the display shows is the
+/// plane under `map`, which carries that rectangle onto the display. Nothing here lays
+/// anything out or looks at a window, so an update costs a few multiplications.
+///
+/// **Pinching in** leads straight to the window (or tab group, tile, Desktop) under the pointer, and **pinching out**
+/// straight to everything. On the way the map is a blend of the two ends', which is what F02's motion between
+/// them shows: a pinch scrubs through the motion of `zoom` or `show-all`. A free camera that scaled evenly about the
+/// pointer would not do: a window in the left half of the display is as tall as it can get, and zooming in on it
+/// only makes it wider. The side that has furthest to go follows the fingers (a magnification of 0.69
+/// doubles it) and the other arrives at the same moment, so a window's picture is never stretched
+/// more than it will be when it has arrived. Going level by level would be: in a grid of three by three the
+/// column would first grow to three times its width, at the same height.
+///
+/// The `levels` in between (the spaces `out` and `in` would visit) are where the view can land.
+///
+/// Past everything the arrangement goes on shrinking, centred, and past a single window it grows a little,
+/// both against growing resistance.
+///
+/// **Panning** slides the camera over the plane, as far as the edge of everything and, against
+/// resistance, a little further.
+public struct ZoomGesture: Equatable, Sendable {
+  /// A space the pinch can land on.
+  public struct Level: Equatable, Sendable {
+    public var node: NodeID
+    /// Where it is on the plane.
+    public var rect: CGRect
+  }
+
+  /// The rectangle a space in view fills.
+  public let content: CGRect
+  /// From everything inward: the spaces `out` would visit from where the gesture began, that one, and the
+  /// ones `in` would visit toward the pointer. Never empty.
+  public let levels: [Level]
+  /// The index of the level the gesture began on.
+  public let start: Int
+  /// The magnification that leads from where the gesture began to the first level (0 or less) and to the last (0 or more).
+  public let reach: ClosedRange<Double>
+  public var feel: ZoomFeel
+
+  /// The sum of the magnification so far, kept within `feel.overshoot` of the ends.
+  public private(set) var zoom: Double = 0
+  /// How far the pan has moved the camera over the plane, before resistance.
+  public private(set) var slide = CGPoint.zero
+
+  /// Every space on the plane, for a pan to land on.
+  private let spaces: [NodeID: CGRect]
+  private let tree: LayoutTree
+
+  /// - Parameters:
+  ///   - plane: the display as it is now, wide enough to hold everything (`ancestor` is the root).
+  ///   - tree, isPresent: what `plane` was made of.
+  ///   - point: where the pointer is, which decides what pinching in leads to.
+  /// Nil if the plane has no room to show anything.
+  public init?(
+    plane: Plane, tree: LayoutTree, isPresent: @escaping (WindowID) -> Bool, toward point: CGPoint,
+    feel: ZoomFeel = ZoomFeel()
+  ) {
+    guard let home = plane.nodes[plane.camera], Self.isUsable(home), Self.isUsable(plane.content) else { return nil }
+    let view = TreeView(tree: tree, isPresent: isPresent)
+    // The plane in the shape `Navigation` reads.
+    var chart = Layout(camera: plane.camera, frame: plane.content)
+    chart.nodeFrames = plane.nodes
+
+    var outward: [Level] = []
+    while let wider = Navigation.stepOut(from: outward.last?.node ?? plane.camera, in: view),
+      let frame = plane.nodes[wider], Self.isUsable(frame)
+    {
+      outward.append(Level(node: wider, rect: frame))
+    }
+    var inward: [Level] = []
+    // The nodes inside a tile have no place on the plane: a tile is as far in as this gesture goes.
+    while let inner = Navigation.stepIn(
+      from: inward.last?.node ?? plane.camera, toward: point, focused: nil, in: view, layout: chart),
+      let frame = plane.nodes[inner], Self.isUsable(frame)
+    {
+      inward.append(Level(node: inner, rect: frame))
+    }
+
+    /// How many times larger the side of `inner` that has furthest to go must get to match `outer`.
+    func ratio(_ outer: CGRect, _ inner: CGRect) -> Double {
+      Double(max(outer.width / inner.width, outer.height / inner.height, 1))
+    }
+    content = plane.content
+    levels = outward.reversed() + [Level(node: plane.camera, rect: home)] + inward
+    start = outward.count
+    reach = -log(ratio(outward.last?.rect ?? home, home))...log(ratio(home, inward.last?.rect ?? home))
+    spaces = plane.nodes.filter { Self.isUsable($0.value) }
+    self.tree = tree
+    self.feel = feel
+  }
+
+  /// `PlaneMap` cannot carry a rectangle thinner than a point.
+  private static func isUsable(_ rect: CGRect) -> Bool { rect.isFinite && rect.width >= 1 && rect.height >= 1 }
+
+  // MARK: Following
+
+  /// Adds what the fingers did since the last call: `GestureUpdate`'s magnification (spreading is positive) and
+  /// pan (the way the content moves, in points on the display).
+  public mutating func move(magnification: Double = 0, pan: CGSize = .zero) {
+    if magnification.isFinite {
+      let reach = max(feel.overshoot, 0)
+      zoom = min(max(zoom + magnification, self.reach.lowerBound - reach), self.reach.upperBound + reach)
+    }
+    guard pan.width.isFinite, pan.height.isFinite, feel.panSensitivity.isFinite else { return }
+    // The content follows the fingers, so the camera goes the other way, by as much of the plane as
+    // those points on the display show.
+    let still = unpanned
+    let speed = CGFloat(feel.panSensitivity)
+    slide.x = Self.kept(
+      slide.x - pan.width * speed * still.width / content.width, within: room(still, \.minX, \.maxX),
+      slack: still.width * CGFloat(feel.panSlack))
+    slide.y = Self.kept(
+      slide.y - pan.height * speed * still.height / content.height, within: room(still, \.minY, \.maxY),
+      slack: still.height * CGFloat(feel.panSlack))
+  }
+
+  /// The virtual camera: the part of the plane that fills the view.
+  public var camera: CGRect {
+    let still = unpanned
+    return still.offsetBy(
+      dx: Self.resisted(slide.x, within: room(still, \.minX, \.maxX), slack: still.width * CGFloat(feel.panSlack)),
+      dy: Self.resisted(slide.y, within: room(still, \.minY, \.maxY), slack: still.height * CGFloat(feel.panSlack)))
+  }
+
+  /// Carries everything on the plane to where the display shows it.
+  public var map: PlaneMap { PlaneMap(carrying: camera, onto: content) ?? .identity }
+
+  /// Whether the fingers have moved anything.
+  public var hasMoved: Bool { zoom != 0 || slide != .zero }
+
+  /// The camera as the pinch alone leaves it.
+  private var unpanned: CGRect {
+    let (first, home, last) = (levels[0].rect, levels[start].rect, levels[levels.count - 1].rect)
+    if zoom <= reach.lowerBound {
+      let shrink = Self.resisted(reach.lowerBound - zoom, limit: feel.shrinkLimit)
+      return Self.scaled(first, by: 1 / (1 - shrink))
+    }
+    if zoom >= reach.upperBound {
+      let growth = Self.resisted(zoom - reach.upperBound, limit: feel.growLimit)
+      return Self.scaled(last, by: 1 / (1 + growth))
+    }
+    let (from, to, travelled, whole) =
+      zoom < 0 ? (first, home, zoom - reach.lowerBound, -reach.lowerBound) : (home, last, zoom, reach.upperBound)
+    // The size on the display grows evenly from one end's to the other's, as it does in a motion
+    // between the two. `progress` is how far along that is when the side that has furthest to go has
+    // grown by what the fingers say.
+    let progress = CGFloat((exp(travelled) - 1) / (exp(whole) - 1))
+    func blend(_ a: CGFloat, _ lengthA: CGFloat, _ b: CGFloat, _ lengthB: CGFloat) -> (CGFloat, CGFloat) {
+      let part = progress * lengthA / ((1 - progress) * lengthB + progress * lengthA)
+      return (a + (b - a) * part, lengthA + (lengthB - lengthA) * part)
+    }
+    let (x, width) = blend(from.minX, from.width, to.minX, to.width)
+    let (y, height) = blend(from.minY, from.height, to.minY, to.height)
+    return CGRect(x: x, y: y, width: width, height: height)
+  }
+
+  /// How far `rect` can slide along one axis before it leaves everything: from a number that is not
+  /// positive to one that is not negative. A camera that sees past everything stays centred.
+  private func room(
+    _ rect: CGRect, _ low: KeyPath<CGRect, CGFloat>, _ high: KeyPath<CGRect, CGFloat>
+  ) -> ClosedRange<CGFloat> {
+    let everything = levels[0].rect
+    return min(everything[keyPath: low] - rect[keyPath: low], 0)...max(everything[keyPath: high] - rect[keyPath: high], 0)
+  }
+
+  private static func scaled(_ rect: CGRect, by factor: Double) -> CGRect {
+    let (width, height) = (rect.width * CGFloat(factor), rect.height * CGFloat(factor))
+    return CGRect(x: rect.midX - width / 2, y: rect.midY - height / 2, width: width, height: height)
+  }
+
+  /// Follows `excess` at first and never gets past `limit`, like the end of a scroll view.
+  static func resisted(_ excess: Double, limit: Double) -> Double {
+    guard excess > 0, limit > 0 else { return 0 }
+    return limit * excess / (excess + limit)
+  }
+
+  private static func resisted(_ value: CGFloat, within room: ClosedRange<CGFloat>, slack: CGFloat) -> CGFloat {
+    if value > room.upperBound {
+      return room.upperBound + CGFloat(resisted(Double(value - room.upperBound), limit: Double(slack)))
+    }
+    if value < room.lowerBound {
+      return room.lowerBound - CGFloat(resisted(Double(room.lowerBound - value), limit: Double(slack)))
+    }
+    return value
+  }
+
+  /// What is remembered of a slide: no more than shows, roughly, so that turning back shows at once.
+  private static func kept(_ value: CGFloat, within room: ClosedRange<CGFloat>, slack: CGFloat) -> CGFloat {
+    min(max(value, room.lowerBound - 2 * slack), room.upperBound + 2 * slack)
+  }
+
+  // MARK: Landing
+
+  /// The space the view settles on when the fingers lift now. `levels[start].node` means back to where it began.
+  ///
+  /// The pinch picks the level and the pan picks the space:
+  ///
+  /// - The level that best fits what the pinch has brought into view wins, by `Navigation.bestFit`'s measure. Where two
+  ///   fit equally well, the direction of the gesture decides. But less than `feel.commitment` returns to where
+  ///   the gesture began, and that much is meant, however far away the next level is: it never falls back.
+  /// - A pan moves that level's rectangle over the plane, and the space that fits it best wins. Spaces around
+  ///   or inside the level do not take part: between two windows, "both" would fit best, and
+  ///   nobody who slides sideways means to zoom out.
+  public var landing: NodeID {
+    let level = levels[landingLevel]
+    let (roomX, roomY) = (room(level.rect, \.minX, \.maxX), room(level.rect, \.minY, \.maxY))
+    func ahead(_ slide: CGFloat, _ length: CGFloat, _ room: ClosedRange<CGFloat>) -> CGFloat {
+      let slide = min(max(slide, room.lowerBound), room.upperBound)
+      let lead = min(abs(slide) / 2, length * CGFloat(max(feel.panLead, 0)))
+      return slide + (slide < 0 ? -lead : lead)
+    }
+    let shift = CGPoint(x: ahead(slide.x, level.rect.width, roomX), y: ahead(slide.y, level.rect.height, roomY))
+    guard abs(shift.x) >= 1 || abs(shift.y) >= 1 else { return level.node }
+    let wanted = level.rect.offsetBy(dx: shift.x, dy: shift.y)
+
+    /// Larger is better, field by field: the fit; leaving rather than staying, which is the direction of the
+    /// gesture; the smaller space; the inner of two that look the same. Then the lower id, so that the
+    /// order a dictionary is walked in never matters.
+    typealias Rank = (fit: CGFloat, leaves: Int, area: CGFloat, depth: Int)
+    var best: (node: NodeID, rank: Rank)?
+    for (node, rect) in spaces.sorted(by: { $0.key < $1.key }) {
+      guard node == level.node || !(tree.subtree(node, contains: level.node) || tree.subtree(level.node, contains: node))
+      else { continue }
+      // Rounded, so that two fits that are equal on paper are equal here.
+      let fit = (rect.intersectionOverUnion(wanted) * 1e6).rounded()
+      guard fit > 0 else { continue }
+      let rank: Rank = (fit, node == level.node ? 0 : 1, -rect.area, tree.depth(of: node))
+      if best == nil || rank > best!.rank { best = (node, rank) }
+    }
+    return best?.node ?? level.node
+  }
+
+  /// The index of the level the pinch alone lands on.
+  public var landingLevel: Int {
+    guard zoom != 0 else { return start }
+    let step = zoom > 0 ? 1 : -1
+    guard levels.indices.contains(start + step) else { return start }
+    // Where everything is close by, half the way there is enough.
+    let commitment = min(max(feel.commitment, 0), (zoom > 0 ? reach.upperBound : -reach.lowerBound) / 2)
+    // Allows for rounding, so that five deltas of 0.05 make 0.25.
+    guard abs(zoom) >= commitment - 1e-9 else { return start }
+    let view = unpanned
+    var best = (index: start + step, fit: levels[start + step].rect.intersectionOverUnion(view))
+    var index = best.index + step
+    while levels.indices.contains(index) {
+      let fit = levels[index].rect.intersectionOverUnion(view)
+      if fit >= best.fit - 1e-9 { best = (index, fit) }
+      index += step
+    }
+    return best.index
+  }
+}
