index 927adda..c9cc4c1 100644
--- a/scripts/mac-shell/witness.swift
+++ b/scripts/mac-shell/witness.swift
@@ -36,6 +36,16 @@ let usage = """
                                         a pinch of that much magnification, with ⌥ held, with a rotation inside it
     scroll x y <dx> <dy> [--steps n] [--opt] [--ctrl] [--momentum n] [--tap hid|session]
                                         a two-finger scroll of that many points in all, with ⌥ or ⌃ held, then coasting for n events
+    fingers x y <move>… [--opt] [--ctrl] [--tap hid|session] [--tell <fifo>]
+                                        one gesture made of moves, in order, a hundred events a second:
