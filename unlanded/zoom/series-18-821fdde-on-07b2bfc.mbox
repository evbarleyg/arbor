+  /// Whether a window in view moves with the arrangement. The others keep their place on the display: windows
+  /// Arbor leaves alone, windows that stay in view (pinned, F49, or summoned, F53), and another display's windows that reach over.
+  private func ridesThePlane(_ window: WindowID, of workspace: Workspace) -> Bool {
+    isManaged(window) && workspace.contains(window) && !workspace.staysInView(window)
+  }
