+  /// Floating windows live on the Desktop. Out of view, they are where they will be when it comes back: in the
+  /// view of everything, which is where most pinches that bring it back end, or else, if the Desktop
+  /// is a tile there, with the Desktop on its own. A guest (F57) waits over the space it opened over, where it was left.
+  /// A summoned window that was sent away (F53) is nowhere: no view brings it back.
+  private func floatingWindowsOutOfView(on display: DisplaySnapshot, plane: Plane) -> [WindowID: FollowScene.Away] {
+    guard let workspace = workspaces[display.id] else { return [:] }
+    let waiting = workspace.floating.filter {
+      parked.contains($0.key) && windows[$0.key]?.isPresent == true && isManaged($0.key) && !workspace.isStashed($0.key)
+    }
+    guard !waiting.isEmpty else { return [:] }
+    let desktop = self.layout(of: display.id, camera: workspace.tree.root)?.desktopFrame ?? plane.content
+    var away: [WindowID: FollowScene.Away] = [:]
+    for (window, preferred) in waiting {
+      if let host = workspace.guests?[window], plane.nodes[host] != nil {
+        away[window] = FollowScene.Away(
+          frame: preferred.fitted(into: display.visibleFrame), host: host, hostFrame: plane.content)
+      } else {
+        away[window] = FollowScene.Away(
+          frame: floatingFrame(preferred, on: floatingRegion(desktop, on: display), of: display, minimum: nil),
+          host: workspace.tree.desktop, hostFrame: desktop)
+      }
