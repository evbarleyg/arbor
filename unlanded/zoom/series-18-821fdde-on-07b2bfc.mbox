index 0000000..2f09c6d
--- /dev/null
+++ b/Tests/ArborKitTests/FollowGestureInvariantTests.swift
@@ -0,0 +1,205 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// A few thousand random steps, with fingers coming down, moving and lifting among everything else that can happen, and
+/// after each one the promises a view that follows the fingers has to keep, whatever led there.
+@Suite @MainActor struct FollowGestureInvariantTests {
+  /// Small, fast and the same on every platform.
+  struct Random {
+    var state: UInt64
+    mutating func next() -> UInt64 {
+      state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+      return state >> 33
+    }
+    mutating func below(_ bound: Int) -> Int { Int(next() % UInt64(bound)) }
+    mutating func pick<T>(_ items: [T]) -> T? { items.isEmpty ? nil : items[below(items.count)] }
+  }
+
+  static let side = DisplaySnapshot(
+    id: DisplayID("side"), frame: CGRect(x: 1440, y: 0, width: 1920, height: 1080),
+    visibleFrame: CGRect(x: 1440, y: 0, width: 1920, height: 1040), isMain: false)
+
+  func run(_ h: Harness, _ command: String) -> String {
+    h.run(command)
+    return command
+  }
+
+  /// What the fingers do. Mostly sensible, in sensible order; sometimes neither.
+  func fingers(_ h: Harness, _ random: inout Random) -> String {
+    let phase: GestureUpdate.Phase
+    let isDown = h.system.displayList.contains { h.controller.isFollowingGesture(on: $0.id) }
+    switch random.below(40) {
+    case 0: phase = .began
+    case 1, 2, 3, 4, 5: phase = .ended
+    case 6: phase = .cancelled
+    case 7: phase = .changed
+    default: phase = isDown ? .changed : .began
+    }
+    let odd: [Double] = [.nan, .infinity, -.infinity, 1e300, -1e300, 2, -2]
+    // A gesture mostly keeps its direction.
+    let sign = h.overlays.followFrames.last.map { $0.map.scaleX < 1 ? -1.0 : 1.0 } ?? 1
+    let magnification =
+      random.below(40) == 0 ? random.pick(odd)! : Double(random.below(41) - 10) / 100 * (random.below(6) == 0 ? -sign : sign)
+    let pan =
+      random.below(40) == 0
+      ? CGSize(width: random.pick(odd)!, height: random.pick(odd)!)
+      : random.below(3) == 0 ? CGSize(width: random.below(201) - 100, height: random.below(101) - 50) : .zero
+    if phase == .began { h.system.cursor = CGPoint(x: random.below(3400) - 20, y: random.below(1100) - 10) }
+    h.controller.gesture(GestureUpdate(phase: phase, location: h.system.cursor, magnification: magnification, pan: pan))
+    h.system.reportFocus()
+    return "\(phase) \(magnification) \(pan)"
+  }
+
+  /// Everything else.
+  func world(_ h: Harness, _ random: inout Random) -> String {
+    let windows = h.system.allWindows().map(\.id)
+    let window = random.pick(windows)?.rawValue ?? 0
+    let other = random.pick(windows)?.rawValue ?? 0
+    let edge = random.pick(["left", "right", "up", "down"])!
+    // What keeps the view from following does not last, or little else would be tried.
+    if h.controller.isPaused { return run(h, "resume") }
+    if h.workspace.tree.allWindows.isEmpty, random.below(2) == 0 { return run(h, "arrange all") }
+    if h.overlays.reduceMotion, random.below(2) == 0 {
+      h.overlays.reduceMotion = false
+      return "Reduce motion off"
+    }
+    if !h.controller.settings.continuousZoom, random.below(2) == 0 {
+      var settings = h.controller.settings
+      settings.continuousZoom = true
+      h.controller.apply(settings: settings)
+      return "continuousZoom on"
+    }
+    switch random.below(22) {
+    case 0:
+      guard windows.count < 10 else { return "nothing" }
+      let id = h.system.open(
+        app: "App\(random.below(4))",
+        frame: CGRect(x: 50 + random.below(2600), y: 60 + random.below(400), width: 300 + random.below(400), height: 200 + random.below(300)),
+        minimumSize: random.below(5) == 0 ? CGSize(width: 900, height: 600) : .zero)
+      return "open \(id)"
+    case 1:
+      guard windows.count > 1, let id = random.pick(windows) else { return "nothing" }
+      h.system.close(id)
+      return "close \(id)"
+    case 2, 3: return run(h, "dock \(window) \(edge)")
+    case 4: return run(h, "dock \(window) beside \(other) \(edge)")
+    case 5: return run(h, "float \(window)")
+    case 6, 7: return run(h, "zoom \(window)")
+    case 8: return run(h, random.below(2) == 0 ? "back" : "forward")
+    case 9: return run(h, "neighbor \(edge)")
+    case 10: return run(h, random.below(2) == 0 ? "out" : "in")
+    case 11: return run(h, random.below(2) == 0 ? "show-all" : "desktop")
+    case 12:
+      guard let id = random.pick(windows) else { return "nothing" }
+      let minimized = h.controller.windows[id]?.isMinimized ?? false
+      h.system.setMinimized(id, !minimized)
+      return "\(minimized ? "restore" : "minimize") \(id)"
+    case 13: return run(h, random.below(3) == 0 ? "float-all" : "arrange")
+    case 14: return run(h, random.pick(["status", "state", "save-view 2", "view 2", "help", "toggle-pin \(window)"])!)
+    case 15:
+      // The stage's own monitors see it first, or the controller does.
+      if random.below(2) == 0 { h.overlays.userInterruptsStage() } else { h.system.click() }
+      return "click or key"
+    case 16:
+      let seconds = Double(random.pick([0, 1, 5, 31])!)
+      h.scheduler.advance(by: seconds)
+      return "\(seconds) s pass"
+    case 17:
+      let two = h.system.displayList.count == 1
+      h.system.setDisplays(two ? [FakeWindowSystem.standardDisplay, Self.side] : [FakeWindowSystem.standardDisplay])
+      return two ? "plug in" : "unplug"
+    case 18: return run(h, "toggle-pause")
+    case 19:
+      h.overlays.reduceMotion.toggle()
+      return "Reduce motion \(h.overlays.reduceMotion)"
+    case 20:
+      var settings = h.controller.settings
+      switch random.below(4) {
+      case 0: settings.animationDuration = settings.animationDuration == 0 ? 0.46 : 0
+      case 1: settings.continuousZoom.toggle()
+      case 2: settings.desktopPinchSteps.toggle()
+      default: settings.gap = Double(random.below(30))
+      }
+      h.controller.apply(settings: settings)
+      return "settings"
+    default:
+      guard let id = random.pick(windows), let frame = h.frame(id), h.system.isVisible(id) else { return "nothing" }
+      h.system.drag(
+        id,
+        through: [
+          CGPoint(x: frame.midX, y: frame.minY + 10), CGPoint(x: 700, y: 400),
+          CGPoint(x: random.below(1440), y: 30 + random.below(860)),
+        ])
+      return "drag \(id)"
+    }
+  }
+
+  @Test(arguments: [1, 2, 3, 4, 5, 6]) func whateverHappensTheStageIsNeverLeftUpAndNothingRealMovesUnderTheFingers(seed: UInt64) {
+    var settings = Settings()
+    settings.continuousZoom = true
+    settings.tabsEnabled = seed % 2 == 0
+    let h = Harness(settings: settings)
+    for index in 0..<5 {
+      h.system.open(app: "App\(index)", frame: CGRect(x: 100 + index * 90, y: 100 + index * 60, width: 500, height: 350))
+    }
+    h.start()
+    h.run("arrange")
+    var random = Random(state: seed)
+    var (followed, landed) = (0, 0)
+
+    for count in 0..<1500 {
+      let displays = h.system.displayList.map(\.id)
+      let wasFollowing = displays.first { h.controller.isFollowingGesture(on: $0) }
+      let before = (h.controller.workspaces, h.controller.layouts, h.system.frameLog.count, h.overlays.followFrames.count)
+      let byFingers = random.below(10) < 8
+      let what = byFingers ? fingers(h, &random) : world(h, &random)
+      let context = "seed \(seed), step \(count): \(what)"
+      let following = displays.first { h.controller.isFollowingGesture(on: $0) }
+
+      // A stage that is held belongs to a gesture that is followed. Nothing else would ever take it down.
+      for display in h.overlays.held.keys {
+        #expect(h.controller.isFollowingGesture(on: display), "a stage is left up\n\(context)")
+      }
+      #expect(h.overlays.held.count <= 1, "\(context)")
+      #expect(h.scheduler.pendingKeys.contains("gesture") == (following != nil), "\(context)")
+
+      for frame in h.overlays.followFrames[before.3...] {
+        let map = frame.map
+        #expect(
+          map.scaleX.isFinite && map.scaleY.isFinite && map.offsetX.isFinite && map.offsetY.isFinite
+            && map.scaleX > 0 && map.scaleY > 0, "\(map)\n\(context)")
+      }
+
+      // While the fingers are down nothing real changes.
+      if byFingers, wasFollowing != nil, following == wasFollowing {
+        followed += 1
+        #expect(h.controller.workspaces == before.0 && h.controller.layouts == before.1, "\(context)")
+        #expect(h.system.frameLog.count == before.2, "a window was moved under the fingers\n\(context)")
+      }
+      // When they lift, the view moves at most once.
+      if byFingers, let display = wasFollowing, following == nil, let now = h.controller.workspaces[display],
+        let then = before.0[display]
+      {
+        // A move of the view may give room back (F61) or let a group go that nothing keeps (F62), as after a command: that a
+        // landing does what the command does is `FollowGestureTests`' to say. No window changes sides.
+        #expect(now.tree.allWindows.sorted() == then.tree.allWindows.sorted(), "\(context)")
+        #expect(now.floating.keys.sorted() == then.floating.keys.sorted(), "\(context)")
+        if now.camera != then.camera {
+          landed += 1
+          #expect(now.back == then.back + [then.camera] || now.back.count == Workspace.historyLimit, "\(context)")
+        } else {
+          #expect(now == then, "\(context)")
+          // Fingers that come down again at once on another display may step there.
+          #expect(
+            !h.system.frameLog[before.2...].contains { now.contains($0.window) }, "it returned, and yet a window was moved\n\(context)")
+        }
+      }
+    }
+    #expect(followed > 400 && landed > 8, "followed \(followed) updates, landed \(landed) times")
+    h.controller.shutdown()
+    #expect(h.overlays.held.isEmpty)
+  }
+}
