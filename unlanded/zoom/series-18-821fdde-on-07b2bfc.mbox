   }
 
+  /// What the chaos lab found with its rule that nothing a held stage shows is moved behind it (seed 300): a window of the display beside
+  /// reaches over, so it has a stand-in here, and a command for its own display moves it.
+  @Test func aWindowOfAnotherDisplayThatReachesOverAndIsMovedThereEndsTheGesture() {
+    let (s, e, _) = makeTwoDisplays()
+    s.h.system.userMove(s.d, to: CGRect(x: 1200, y: 300, width: 400, height: 300))
+    #expect(s.h.workspace.isFloating(s.d), "most of it is on the main display, which it belongs to")
+    send(s.h, .began, at: s.h.frame(e)!.center)
+    send(s.h, .changed, magnification: 0.3)
+    #expect(s.h.overlays.held[Self.side.id]?.fixed == [s.d])
+    // Out of view it goes, with the main display's Desktop.
+    s.h.run("zoom \(s.a.rawValue)")
+    #expect(s.h.controller.parked.contains(s.d))
+    #expect(s.h.overlays.held.isEmpty && !s.h.controller.isFollowingGesture(on: Self.side.id))
+  }
