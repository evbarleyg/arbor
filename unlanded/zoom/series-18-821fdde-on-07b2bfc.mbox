@@ -0,0 +1,77 @@
+#!/bin/bash
+# Stands in for what witness.swift posts in a rehearsal (scripts/mac-shell/rehearse.sh): `fingers`, `pinch` and `scroll`, through the
+# real GestureRouter (arbor-fakemac's `witness`). The fake Mac's clock does not run by itself, so a move is made at once and then
+# takes its time by the real clock: a script that started the gesture in the background can look at things with the fingers down.
+# `pinch` and `scroll` of a hundred steps or more rest half-way for ARBOR_REHEARSAL_FINGERS seconds (2), for the same reason.
+what=${1:-} x=${2:-} y=${3:-}
+refuse() { echo "witness (rehearsal): no stand-in for $*" >&2; exit 64; }
+[ $# -ge 3 ] || refuse "witness $*"
+shift 3
+mac() { "$ARBOR_FAKEMAC" witness "$@" || exit $?; }
+half() { python3 -c "print($1 / 2)"; }
+
+steps=10 opt="" ctrl="" tell="" words=()
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --steps) steps=${2:-}; shift ;;
+    --opt) opt=opt ;;
+    --ctrl) ctrl=ctrl ;;
+    --tap) shift ;;
+    --tell) tell=${2:-}; shift ;;
+    --*) refuse "the option $1" ;;
+    *) words+=("$1") ;;
+  esac
+  shift
+done
+
+case "$what" in
+  pinch | scroll)
+    if [ "$what" = pinch ]; then total=${words[0]:-} dx=0 dy=0; else total=0 dx=${words[0]:-} dy=${words[1]:-}; fi
+    mac "$what" began "$x" "$y" $opt $ctrl
+    mac "$what" changed "$(half "$total")" "$(half "$dx")" "$(half "$dy")" "$((steps / 2 + 1))"
+    [ "$steps" -ge 100 ] && /bin/sleep "${ARBOR_REHEARSAL_FINGERS:-2}"
+    mac "$what" changed "$(half "$total")" "$(half "$dx")" "$(half "$dy")" "$((steps / 2 + 1))"
+    mac "$what" ended
+    ;;
+  fingers)
+    end=ended pinches="" sliding=""
+    [ "${#words[@]}" -gt 0 ] || refuse "fingers without a move"
+    if [ "${words[${#words[@]} - 1]}" = cancel ]; then
+      end=cancelled
+      unset "words[${#words[@]} - 1]"
+    fi
+    # Read first, as the real one does.
+    for word in "${words[@]}"; do
+      case "$word" in
+        pinch:*:*) pinches=yes ;;
+        slide:*:*:* | rest:*) ;;
+        *) refuse "the move $word" ;;
+      esac
+    done
+    [ -n "$pinches" ] && mac pinch began "$x" "$y" $opt $ctrl
+    [ -n "$tell" ] && echo "mark fingers down" >> "$tell"
+    for word in "${words[@]}"; do
+      IFS=: read -r kind a b c <<< "$word"
+      case "$kind" in
+        pinch)
+          mac pinch changed "$a" 0 0 "$(python3 -c "print(max(1, int($b * 100)))")"
+          /bin/sleep "$b"
+          ;;
+        slide)
+          if [ -z "$sliding" ]; then
+            mac scroll began "$x" "$y" $opt $ctrl
+            sliding=yes
+          fi
+          mac scroll changed 0 "$a" "$b" "$(python3 -c "print(max(1, int($c * 100)))")"
+          /bin/sleep "$c"
+          ;;
+        rest) /bin/sleep "$a" ;;
+      esac
+    done
+    [ -n "$sliding" ] && mac scroll "$end" ${pinches:+held}
+    [ -n "$pinches" ] && mac pinch "$end"
+    [ -n "$tell" ] && echo "mark fingers up" >> "$tell"
+    ;;
+  *) refuse "witness $what" ;;
+esac
+exit 0
