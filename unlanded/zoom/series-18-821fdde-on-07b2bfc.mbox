From b79939bc04b62005bac79bf215ef55bbc267153f Mon Sep 17 00:00:00 2001
From: ebg-ant <296364998+ebg-ant@users.noreply.github.com>
Date: Thu, 15 Oct 2026 00:32:43 +0000
Subject: [PATCH 14/18] test(mac-shell): film-F16.sh: every way a gesture can
 go, posted, filmed, sampled and checked on a hosted Mac

Resting fingers, a twitch, slow, fast, reversed, cancelled, past everything,
pinch and slide in one, at macOS's tiling on and off; then, with the fingers
resting half-way, what is true in the middle and what a click, a key, a command,
`hold` and a pause do there; a click and a key during the settle; eight windows;
dark; `animationDuration` 0, the setting off, Reduce Motion. In the look that
ships: colour and icon, no pictures of windows.

While a film runs nothing asks Arbor anything, so the cadence measured is its
own. Beside each film lies what the fingers had said at every moment. Scrolls
that are not Arbor's are counted and timed at the far end of the taps, with and
without Arbor. Every session records a trace.

The camera and the sampler are other people's tools: where a checkout does not
have them yet, the script plays and checks all the same and says so.

Rehearsed on the fake Mac: 126 checks.
---
 scripts/mac-shell/film-F16.sh | 568 ++++++++++++++++++++++++++++++++++
 1 file changed, 568 insertions(+)
 create mode 100755 scripts/mac-shell/film-F16.sh

diff --git a/scripts/mac-shell/film-F16.sh b/scripts/mac-shell/film-F16.sh
new file mode 100755
index 0000000..5fdea2b
--- /dev/null
+++ b/scripts/mac-shell/film-F16.sh
@@ -0,0 +1,568 @@
+#!/bin/bash
+# F16, a view that follows the fingers, on real windows: whole gestures posted by a script (witness.swift's `fingers`), filmed frame by
+# frame, with every window's frame sampled meanwhile, in the look that ships: each app's colour and icon, no pictures of windows.
+#
+#   scripts/mac-shell/rehearse.sh scripts/mac-shell/film-F16.sh   on Linux, first, for nothing
+#   scripts/mac-shell/run.sh scripts/mac-shell/film-F16.sh        about six minutes on a hosted Mac
+#
+# What only a Mac can answer: do posted gestures reach Arbor's taps whole, cancelled ones too; does the stage keep up with a hundred
+# updates a second; what does the display really show from the first movement to the end of the settle.
+# What the script checks itself: that the real windows stay put until the fingers lift, that every gesture ends where the command would,
+# that a floating window comes back exactly where it was, that the stage always comes down, that scrolls that are not Arbor's arrive.
+# What is judged afterwards, anywhere: the films against docs/POLISH.md (does it follow without lag or steps, does it settle eased, does
+# anything flicker; `fingers.log` beside each film says what the fingers said at every moment), and the samples by jolts.py (no jolt,
+# nothing moved that no gesture moved, nothing lost).
+#
+# 1. Without Arbor: scrolls with no key held, for the delays to compare with.
+# 2. The films, at macOS's own tiling switched on and then off: nothing asks Arbor anything while the fingers are down.
+# 3. The checks, with the fingers resting half-way: what is true in the middle, and what a click, a key, a command or a pause does there.
+# 4. Eight windows. 5. Dark. 6. No motion to be had: `animationDuration` 0, Reduce Motion, this setting off, and Arbor as it ships: no event tap at all.
+#
+# No hosted Mac has a trackpad. Nothing here says how real fingers feel; what it says is that every gesture, however it ends, leaves the
+# real windows where a command would have put them.
+#
+# The camera (lib-film.sh) and the sampler (sampler.swift, jolts.py) are other people's tools. Where a checkout does not have them yet the
+# script plays and checks all the same, and says that nothing was filmed or sampled.
+ARBOR_TIME_LIMIT=580
+if [ -f "$(dirname "$0")/lib-film.sh" ]; then
+  source "$(dirname "$0")/lib-film.sh"
+else
+  source "$(dirname "$0")/lib.sh"
+  needs_throwaway_mac "post gestures, and change Reduce Motion, macOS's tiling, the appearance and the wallpaper"
+  echo "no camera in this checkout (scripts/mac-shell/lib-film.sh): nothing is filmed"
+  FILM_SCENE=""
+  FILM_WITNESS="$ARBOR_ROOT/.build/mac-shell/witness"
+  film_build() {
+    arbor_build
+    [ -n "${ARBOR_REHEARSAL:-}" ] && return 0
+    swiftc -O -swift-version 5 "$ARBOR_ROOT/scripts/mac-shell/witness.swift" -o "$FILM_WITNESS" > "$ARBOR_OUT/build-witness.log" 2>&1 || FILM_WITNESS=""
+  }
+  camera_start() { :; }
+  camera_stop() { :; }
+  cast_build() { :; }
+  cast_start() { arbor_start "$@"; }
+  cast_stop() { arbor_stop "$@"; }
+  scene() {
+    step "scene $1: $3"
+    sleep 0.4
+  }
+  scene_end() { sleep "${1:-2.5}"; }
+fi
+
+source "$(dirname "$0")/lib-gestures.sh"
+# As it ships Arbor installs no event tap (`pointerGestures`), so every session but one asks for the gestures, and for this one.
+FOLLOWING="$ARBOR_GESTURES_ON, \"continuousZoom\": true"
+
+film_build
+# Every test window another app's, as a person's windows are: in colour and icon the cards then differ.
+cast_build
+WITNESS=$FILM_WITNESS
+# A rehearsal (rehearse.sh) points it at a stand-in. Elsewhere the environment has no say.
+[ -n "${ARBOR_REHEARSAL:-}" ] && WITNESS=${ARBOR_WITNESS:-}
+[ -n "$WITNESS" ] || die "scripts/mac-shell/witness.swift did not compile: there are no fingers"
+
+# MARK: What is written down
+
+# sampler.swift and jolts.py, as lib-day.sh uses them, on test windows. A rehearsal has no window server to sample.
+SAMPLER="$ARBOR_ROOT/.build/mac-shell/sampler"
+SAMPLES="$ARBOR_OUT/samples.log"
+SAMPLER_PID=""
+STEP=0
+sampler_start() {
+  [ -z "${ARBOR_REHEARSAL:-}" ] || return 0
+  if [ ! -f "$ARBOR_ROOT/scripts/mac-shell/sampler.swift" ]; then
+    echo "no sampler in this checkout (scripts/mac-shell/sampler.swift): nothing is sampled"
+    return 0
+  fi
+  if ! swiftc -O -swift-version 5 "$ARBOR_ROOT/scripts/mac-shell/sampler.swift" -o "$SAMPLER" > "$ARBOR_OUT/build-sampler.log" 2>&1; then
+    grep -A 6 "error:" "$ARBOR_OUT/build-sampler.log" | head -n 40
+    die "scripts/mac-shell/sampler.swift did not compile"
+  fi
+  scratch_dir sampler SAMPLER_TEMP
+  mkfifo "$SAMPLER_TEMP/in" "$SAMPLER_TEMP/out" || die "no fifos in $SAMPLER_TEMP"
+  "$SAMPLER" "$SAMPLES" "$SAMPLER_TEMP/in" "$SAMPLER_TEMP/out" --hz 60 2>> "$ARBOR_OUT/sampler.log" 4>&- 8>&- 9>&- &
+  SAMPLER_PID=$!
+  started "$SAMPLER_PID"
+  exec 6> "$SAMPLER_TEMP/in" 5< "$SAMPLER_TEMP/out"
+}
+sampler_stop() {
+  [ -n "$SAMPLER_PID" ] || return 0
+  echo stop >&6
+  exec 6>&- 5<&-
+  ended "$SAMPLER_PID" 30 || kill_started "$SAMPLER_PID"
+  SAMPLER_PID=""
+}
+sample() { [ -n "$SAMPLER_PID" ] && echo "mark $*" >&6; }
+
+# play <slug> "<what the person does>" [kind]: a film and a step begin. played [seconds] [key=value…]: things come to rest, both end. The keys are
+# jolts.py's: what the step may move (default: nothing).
+SLUG=""
+LOG_MARK=0
+play() {
+  STEP=$((STEP + 1))
+  SLUG=$1
+  LOG_MARK=$(wc -l < "$ARBOR_HOME/arbor.log")
+  sample "begin $STEP $1"
+  sample "text $STEP $2"
+  # docs/POLISH.md's kind for what follows the fingers: judged against fingers.log until the mark `fingers up`, as a settle after it.
+  scene "$1" "${3:-follow}" "$2"
+}
+played() {
+  local rest=1.6
+  case "${1:-}" in [0-9]*) rest=$1; shift ;; esac
+  helper_done
+  scene_end "$rest"
+  sample "end $STEP act=view $*"
+}
+# What Arbor wrote since the step began.
+logged() { tail -n "+$((LOG_MARK + 1))" "$ARBOR_HOME/arbor.log" | cut -c 26-; }
+
+# The log says what the stage does. Levels and sizes are the stage's own business.
+stage_lines() { grep -E "stage (held|up|retargeted|down)" "$ARBOR_HOME/arbor.log" | cut -c 26-; }
+stage_down() { [ -z "$(stage_lines)" ] || stage_lines | tail -n 1 | grep -q "stage down"; }
+stage_held() { stage_lines | tail -n 1 | grep -q "stage held"; }
+times_held() { stage_lines | grep -c "stage held"; }
+never_in_sight() { ! logged | grep -q "stage in sight"; }
+frames() { for id in $ARBOR_WINDOW_IDS; do echo "$id $(real_frame_of "$id")"; done; }
+all_in_view() {
+  for id in $ARBOR_WINDOW_IDS; do
+    if is parked "$id"; then return 1; fi
+  done
+}
+
+# MARK: The fingers
+
+# The witness with its fingers down. Left to itself after ⌃C it would go on for seconds, its keys held, over whatever lies there by
+# then. One that is killed never lets go of its keys, so that is done for it.
+HELPER=""
+end_helper() {
+  [ -n "$HELPER" ] || return 0
+  kill_started "$HELPER"
+  "$ARBOR_POINTER" calm
+  HELPER=""
+}
+at_exit end_helper
+helper_done() {
+  [ -n "$HELPER" ] || return 0
+  if arbor_await_exit "$HELPER" 200; then HELPER=""; else end_helper; fi
+}
+
+# fingers_over <id> <keys and moves, as witness.swift's `fingers` takes them>: in the middle of a test window, in the background. What was
+# posted, and when, is kept beside the film.
+fingers_over() {
+  local id=$1 x y log=/dev/null tell=""
+  shift
+  helper_done
+  read -r x y <<< "$(center_of "$id")"
+  pointer move "$x" "$y"
+  # The witness posts past the harness's nets. What would get a press there gets the gesture, so that net is asked.
+  arbor_input_is_ours click "$x" "$y" || return 1
+  echo "> fingers over $id: $*"
+  if [ -n "$FILM_SCENE" ]; then
+    log="$ARBOR_OUT/films/$FILM_SCENE/fingers.log"
+    # The camera is told by the witness itself when the fingers come down and lift: a shell would be a tenth of a second late.
+    tell="--tell $FILM_TEMP/commands"
+  fi
+  # safe anywhere: the net was asked above
+  # shellcheck disable=SC2086
+  "$WITNESS" fingers "$x" "$y" "$@" --tap "$TAP" $tell > "$log" &
+  HELPER=$!
+  # A short one may be over already, which `started` would remark on.
+  started "$HELPER" > /dev/null
+}
+
+# [1 | Desktop | 2 over 3], 4 floating.
+four_windows() {
+  arbor_settings "$1"
+  cast_start 4 ARBOR_NO_HOTKEYS=0 ARBOR_PANELS_IN_PICTURES=1
+  sleep 1
+  sample "arbor $ARBOR_PID"
+  "$ARBOR_BIN/arborctl" trace on "F16-$2" | sed "s|$ARBOR_HOME/||"
+  ctl dock "$W1" left
+  ctl dock "$W2" right
+  ctl dock "$W3" beside "$W2" bottom
+  sleep 1.5
+}
+session_over() {
+  "$ARBOR_BIN/arborctl" trace off > /dev/null 2>&1
+  if [ -d "$ARBOR_HOME/traces" ]; then
+    mkdir -p "$ARBOR_OUT/traces"
+    cp "$ARBOR_HOME"/traces/* "$ARBOR_OUT/traces/" 2>/dev/null
+  fi
+  cast_stop "$@"
+}
+
+# MARK: 1. Without Arbor
+
+# GitHub's Macs come with Reduce Motion on, which leaves nothing to film.
+macos_reduce_motion off
+camera_start || die "no camera"
+sampler_start
+
+SEEN="$ARBOR_OUT/witness.txt"
+# foreign_scrolls <name> [x y]: a hundred scroll events with no key held, over the first test window or at that place, and how late each
+# reached the end of the taps, where only apps come after. Sets ARRIVED and LATEST (µs, the 99th of a hundred).
+foreign_scrolls() {
+  local name=$1 x=${2:-} y=${3:-} watcher
+  ARRIVED=0 LATEST=0
+  [ -z "${ARBOR_REHEARSAL:-}" ] || { echo "> foreign scrolls (not rehearsed)"; return 0; }
+  [ -n "$x" ] || read -r x y <<< "$(center_of "$W1")"
+  pointer move "$x" "$y"
+  arbor_input_is_ours click "$x" "$y" || return 1
+  "$WITNESS" watch 4 > "$SEEN" 2>&1 &
+  watcher=$!
+  started "$watcher"
+  eventually grep -q witness-ready "$SEEN" || return 1
+  # safe anywhere: the net was asked five lines up
+  "$WITNESS" scroll "$x" "$y" 0 -98 --steps 98
+  arbor_await_exit "$watcher" 60 || kill_started "$watcher"
+  ARRIVED=$(grep -c "^scroll " "$SEEN")
+  LATEST=$(grep "^scroll " "$SEEN" | sed 's/.*delay_us=\([0-9-]*\).*/\1/' | sort -n | awk '{ v[NR] = $1 } END { print v[int(NR * 0.99)] + 0 }')
+  cp "$SEEN" "$ARBOR_OUT/witness-$name.txt"
+  echo "$name: $ARRIVED of 100 scroll events arrived, the 99th of a hundred $LATEST µs after it was posted"
+}
+all_arrived() { [ -n "${ARBOR_REHEARSAL:-}" ] || [ "$ARRIVED" -eq 100 ]; }
+
+# MARK: 2. The films
+
+# films <prefix>: every way a gesture can go, from everything and back to it.
+films() {
+  local home there first=$((STEP + 1))
+  home=$(frames)
+  sample "label $W1 one"
+  sample "label $W2 two"
+  sample "label $W3 three"
+  sample "label $W4 floating"
+
+  play "$1-rest" "holds ⌥, lays two fingers on the trackpad over a window for half a second, lifts them"
+  fingers_over "$W1" --opt pinch:0:0.5
+  played 0.8
+  check "fingers that only rest bring no stage into sight" never_in_sight
+  check "and the stage is down" eventually stage_down
+
+  play "$1-twitch" "spreads the fingers a little and lifts them"
+  fingers_over "$W1" --opt pinch:0.12:0.3
+  played
+  check "a twitch goes nowhere" all_in_view
+  check "no window has moved" test "$(frames)" = "$home"
+
+  play "$1-in-slow" "spreads two fingers slowly over the left window until it fills the view"
+  fingers_over "$W1" --opt pinch:1.4:2
+  played moves=any
+  check "the window fills the view" eventually is parked "$W2"
+  check "the floating window went out of view with the Desktop" is parked "$W4"
+  check "the stage comes down" eventually stage_down
+
+  play "$1-back" "presses ⌃⌥[" camera
+  key ctrl+opt+[
+  played moves=any returns=$first everything=1
+
+  # The rubric's own scene for the fifth of the five moves, under its name where macOS is as it comes.
+  if [ "$1" = tiling-on ]; then there=zoom-continuous; else there=$1-zoom-continuous; fi
+  play "$there" "spreads two fingers slowly over the left window, holds them still half-way, lets go"
+  fingers_over "$W1" --opt pinch:0.8:1.2 rest:0.8
+  played moves=any
+  check "it settles on the window" eventually is parked "$W2"
+
+  play "$1-slide" "holds ⌃⌥ and slides two fingers to the left: the Desktop comes in from the right"
+  fingers_over "$W1" --ctrl --opt slide:-600:0:1.2
+  played moves=any
+  check "the view is on the Desktop" eventually is parked "$W1"
+  check "where the floating window is" eventually is on_screen "$W4"
+  there=$(real_frame_of "$W4")
+
+  play "$1-out-past-everything" "pinches far out, holds the fingers still for a moment, lifts them"
+  fingers_over "$W4" --opt pinch:-2.6:1.4 rest:0.6
+  played moves=any returns=$first everything=1
+  check "it lands on everything" eventually all_in_view
+  check "every window is exactly where it was before the first gesture" test "$(frames)" = "$home"
+  echo "the floating window with the Desktop on its own: $there; in the view of everything: $(real_frame_of "$W4")"
+
+  play "$1-in-fast" "flicks two fingers apart over the upper right window"
+  fingers_over "$W2" --opt pinch:2.2:0.15
+  played moves=any
+  check "the window fills the view" eventually is parked "$W3"
+
+  play "$1-out-fast" "flicks them together"
+  fingers_over "$W2" --opt pinch:-2.6:0.15
+  played moves=any returns=$first everything=1
+  check "it lands on everything" eventually all_in_view
+
+  play "$1-reversed" "spreads the fingers nearly all the way, thinks better of it, and brings them back"
+  fingers_over "$W1" --opt pinch:1:0.9 pinch:-1:0.9
+  played
+  check "it is back where it began" all_in_view
+  check "no window has moved" test "$(frames)" = "$home"
+
+  # Fast, slow, still, fast: on an even ramp a lag cannot be told from an offset, whoever measures.
+  play "$1-uneven" "spreads the fingers quickly, then slowly, stops for a moment, and goes on quickly"
+  fingers_over "$W1" --opt pinch:0.4:0.2 pinch:0.2:0.6 rest:0.15 pinch:0.6:0.3
+  played moves=any
+  check "the window fills the view" eventually is parked "$W2"
+
+  play "$1-uneven-back" "presses ⌃⌥[" camera
+  key ctrl+opt+[
+  played moves=any returns=$first everything=1
+
+  play "$1-cancelled" "spreads the fingers, and macOS calls the gesture off"
+  fingers_over "$W1" --opt pinch:1.1:0.8 cancel
+  played
+  check "a cancelled gesture returns, however far it went" all_in_view
+  check "no window has moved" test "$(frames)" = "$home"
+  check "the stage comes down" eventually stage_down
+
+  play "$1-pinch-and-slide" "spreads the fingers over the left window and slides them to the left in the same gesture"
+  fingers_over "$W1" --opt pinch:1.4:0.9 slide:-500:0:0.9
+  played moves=any
+  check "the view has left the window it began on" eventually is parked "$W1"
+  check "the stage comes down" eventually stage_down
+
+  play "$1-home" "presses ⌃⌥Space" camera
+  key ctrl+opt+space
+  played moves=any returns=$first everything=1
+  check "every window is exactly where it was" test "$(frames)" = "$home"
+}
+
+TAP=session
+step "1. without Arbor: how late does a scroll reach the end of the taps?"
+foreign_scrolls without-arbor 512 400
+check "every scroll arrives" all_arrived
+WITHOUT=$LATEST
+
+for tiling in on off; do
+  step "2. the films, with macOS's own tiling $tiling"
+  macos_tiling "$tiling"
+  four_windows "{$FOLLOWING}" "tiling-$tiling"
+  summary
+  if [ "$tiling" = on ]; then
+    step "do posted gestures reach Arbor?"
+    fingers_over "$W1" --opt pinch:0.05:0.1
+    helper_done
+    sleep 0.6
+    if [ "$(times_held)" -eq 0 ]; then
+      TAP=hid
+      fingers_over "$W1" --opt pinch:0.05:0.1
+      helper_done
+      sleep 0.6
+    fi
+    echo "posted at the $TAP tap; the stage was held $(times_held) time(s)"
+    check "a posted pinch is followed" test "$(times_held)" -ge 1
+    sleep 1
+  fi
+  films "tiling-$tiling"
+  foreign_scrolls "following-tiling-$tiling"
+  check "with the setting on, every scroll that is not Arbor's arrives" all_arrived
+  check "none more than 10 ms later than without Arbor" test "$((LATEST - WITHOUT))" -le 10000
+  session_over
+done
+
+# MARK: 3. The checks
+
+step "3. in the middle of a gesture: nothing real moves until the fingers lift"
+four_windows "{$FOLLOWING}" checks
+BEFORE=$(frames)
+fingers_over "$W1" --opt pinch:0.9:0.6 rest:1.6 pinch:0.5:0.3
+sleep 1
+check "the stage is held while the fingers are down" eventually stage_held
+check "the real windows are where they were" test "$(frames)" = "$BEFORE"
+check "the view has not moved" all_in_view
+helper_done
+check "the window fills the view" eventually is parked "$W2"
+check "the stage comes down" eventually stage_down
+ctl show-all
+sleep 1
+
+step "one gesture after another, faster than the settle takes"
+fingers_over "$W2" --opt pinch:0.5:0.25
+helper_done
+fingers_over "$W2" --opt pinch:0.9:0.4
+helper_done
+check "the second went on from the first" eventually is parked "$W3"
+check "the stage comes down" eventually stage_down
+ctl show-all
+sleep 1
+
+step "a click in the middle leaves things as they were"
+# The click below is made with the witness's ⌥ down, and an ⌥-click on a window of another app hides the app in front, which
+# nothing would bring back. So the test windows' app comes to the front first, with no key held.
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+sleep 0.3
+BEFORE=$(frames)
+fingers_over "$W1" --opt pinch:1.1:0.6 rest:1.4 pinch:0.4:0.3
+sleep 1
+check "the stage is held" eventually stage_held
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+check "the click took the stage down" eventually stage_down
+helper_done
+sleep 0.8
+check "the view has not moved" all_in_view
+check "nor has any window" test "$(frames)" = "$BEFORE"
+check "the stage did not come up again" stage_down
+
+step "so does a key"
+# The test window has the keyboard, so that the x is typed into nothing of anybody's.
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+sleep 0.3
+fingers_over "$W1" --opt pinch:1.1:0.6 rest:1.4 pinch:0.4:0.3
+sleep 1
+check "the stage is held" eventually stage_held
+key x
+check "the key took the stage down" eventually stage_down
+helper_done
+sleep 0.8
+check "the view has not moved" all_in_view
+
+step "a click during the settle ends it, and the windows are where the gesture put them"
+fingers_over "$W1" --opt pinch:1.4:0.5
+helper_done
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+check "the stage is down" eventually stage_down
+check "the window fills the view" eventually is parked "$W2"
+ctl show-all
+sleep 1
+
+step "and so does a key"
+fingers_over "$W1" --opt pinch:1.4:0.5
+helper_done
+key x
+check "the stage is down" eventually stage_down
+check "the window fills the view" eventually is parked "$W2"
+ctl show-all
+sleep 1
+
+step "a command in the middle takes over"
+fingers_over "$W1" --opt pinch:1.1:0.6 rest:1.4 pinch:0.4:0.3
+sleep 1
+ctl zoom "$W2"
+helper_done
+check "the command won" eventually is parked "$W1"
+check "the stage comes down" eventually stage_down
+ctl show-all
+sleep 1
+
+step "holding the view in the middle wins too"
+fingers_over "$W1" --opt pinch:1.1:0.6 rest:1.4 pinch:0.4:0.3
+sleep 1
+ctl hold
+check "the stage comes down" eventually stage_down
+helper_done
+check "the view has not moved" all_in_view
+ctl release
+sleep 0.5
+
+step "a pause in the middle"
+fingers_over "$W1" --opt pinch:1.1:0.6 rest:1.4 pinch:0.4:0.3
+sleep 1
+ctl pause
+check "pausing takes the stage down" eventually stage_down
+helper_done
+ctl resume
+sleep 1
+session_over 30-after-quit
+
+# MARK: 4. to 6.
+
+step "4. eight windows: does it keep up?"
+arbor_settings "{$FOLLOWING}"
+arbor_start 8 ARBOR_NO_HOTKEYS=0
+sleep 1
+sample "arbor $ARBOR_PID"
+ctl arrange
+sleep 1.5
+play eight-in "spreads two fingers over one of eight windows"
+fingers_over "$W1" --opt pinch:1.6:2
+played moves=any
+play eight-out "and pinches out again, past everything"
+fingers_over "$W1" --opt pinch:-2.4:2
+played moves=any
+check "the stage comes down" eventually stage_down
+echo "updates that reached the stage (two hundred events in two seconds were posted each time):"
+grep "gesture over" "$ARBOR_HOME/arbor.log" | cut -c 26-
+echo "and what each cost, the stage's work included (milliseconds):"
+ctl stats | grep -E "count|follow the fingers"
+arbor_stop
+
+step "5. dark, on a gradient"
+appearance dark
+wallpaper gradient
+four_windows "{$FOLLOWING}" dark
+play dark-in-slow "spreads two fingers slowly over the left window until it fills the view"
+fingers_over "$W1" --opt pinch:1.4:2
+played moves=any
+play dark-back "presses ⌃⌥[" camera
+key ctrl+opt+[
+played moves=any everything=1
+play dark-zoom-continuous "spreads two fingers slowly over the left window, holds them still half-way, lets go"
+fingers_over "$W1" --opt pinch:0.8:1.2 rest:0.8
+played moves=any
+play dark-slide "holds ⌃⌥ and slides two fingers to the left"
+fingers_over "$W1" --ctrl --opt slide:-600:0:1.2
+played moves=any
+play dark-out-past-everything "pinches far out, holds the fingers still for a moment, lifts them"
+fingers_over "$W4" --opt pinch:-2.6:1.4 rest:0.6
+played moves=any everything=1
+check "it lands on everything" eventually all_in_view
+session_over
+appearance light
+
+step "6. animationDuration 0: the view follows, and lands at once"
+four_windows "{$FOLLOWING, \"animationDuration\": 0}" no-duration
+fingers_over "$W1" --opt pinch:0.9:0.5 rest:1 pinch:0.5:0.3
+sleep 0.9
+check "the stage is held" eventually stage_held
+helper_done
+check "the window fills the view" eventually is parked "$W2"
+check "the stage is down at once" stage_down
+session_over
+
+step "the gestures on and this setting off: a pinch steps, and no stage is held"
+four_windows "{$ARBOR_GESTURES_ON}" stepping
+fingers_over "$W1" --opt pinch:0.4:0.2
+helper_done
+check "the view stepped in" eventually is parked "$W2"
+check "no stage was held" test "$(times_held)" -eq 0
+session_over
+
+step "as it ships: a pinch is nobody's business of Arbor's"
+four_windows '{}' as-it-ships
+BEFORE=$(frames)
+fingers_over "$W1" --opt pinch:0.9:0.4
+helper_done
+sleep 0.8
+check "the view has not moved" all_in_view
+check "nor has any window" test "$(frames)" = "$BEFORE"
+check "no stage was held" test "$(times_held)" -eq 0
+session_over
+
+step "Reduce Motion: a pinch steps, two fingers step to the neighbour, and there is never a stage"
+macos_reduce_motion on
+four_windows "{$FOLLOWING}" reduce-motion
+fingers_over "$W1" --opt pinch:0.4:0.2
+helper_done
+check "the view stepped in" eventually is parked "$W2"
+fingers_over "$W1" --ctrl --opt slide:-400:0:0.4
+helper_done
+check "and over to the Desktop" eventually is parked "$W1"
+check "no stage was put up" test -z "$(stage_lines)"
+session_over
+macos_reduce_motion off
+
+camera_stop
+sampler_stop
+
+step "what the detectors say"
+if [ -s "$SAMPLES" ]; then
+  python3 "$ARBOR_ROOT/scripts/mac-shell/jolts.py" report "$SAMPLES" --json "$ARBOR_OUT/findings.json" > "$ARBOR_OUT/jolts.txt"
+  JOLTS=$?
+  head -n 60 "$ARBOR_OUT/jolts.txt"
+  check "no jolt, nothing moved that no gesture moved, nothing lost" test "$JOLTS" -eq 0
+else
+  echo "no samples"
+fi
+
+step "what the logs say"
+grep -hE "stage|gesture" "$ARBOR_OUT"/arbor*.log | cut -c 1-160 | sed -n "1,120p"
