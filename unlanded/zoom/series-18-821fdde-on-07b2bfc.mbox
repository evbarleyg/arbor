diff --git a/Tests/ArborCoreTests/ZoomGestureTests.swift b/Tests/ArborCoreTests/ZoomGestureTests.swift
new file mode 100644
index 0000000..1b4d6d8
--- /dev/null
+++ b/Tests/ArborCoreTests/ZoomGestureTests.swift
@@ -0,0 +1,680 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+import Testing
+
+private let visible = CGRect(x: 0, y: 25, width: 1440, height: 875)
+private let content = visible.insetBy(dx: 12, dy: 12)
+private let a = WindowID(1)
+private let b = WindowID(2)
+private let c = WindowID(3)
+private let d = WindowID(4)
+
+/// Small enough that nothing in the fixture is a tile unless a test asks for it.
+private let roomy = LayoutOptions(minimumUsableSize: CGSize(width: 120, height: 120))
+
+/// root(h)[ column(v)[a, row(h)[c, d]], desktop, b ]: three levels below the root.
+private struct Fixture {
+  var tree = LayoutTree()
+  let leafA: NodeID
+  let leafB: NodeID
+  let leafC: NodeID
+  let leafD: NodeID
+  var column: NodeID { tree.parent(of: leafA)! }
+  var row: NodeID { tree.parent(of: leafC)! }
+  var absent: Set<WindowID> = []
+
+  init() {
+    leafA = tree.dock(a, beside: tree.root, edge: .left)
+    leafB = tree.dock(b, beside: tree.root, edge: .right)
+    leafC = tree.dock(c, beside: leafA, edge: .bottom)
+    leafD = tree.dock(d, beside: leafC, edge: .right)
+  }
+
+  func plane(camera: NodeID, options: LayoutOptions = roomy, in frame: CGRect = visible) -> Plane {
+    let absent = absent
+    return Plane(
+      tree: tree, camera: camera, ancestor: tree.root, in: frame, options: options,
+      isPresent: { !absent.contains($0) })
+  }
+
+  /// A gesture that begins with the view on `camera` and the pointer in the middle of `target`.
+  func gesture(from camera: NodeID, over target: NodeID? = nil, options: LayoutOptions = roomy) throws -> ZoomGesture {
+    let plane = plane(camera: camera, options: options)
+    let absent = absent
+    let spot = try #require(plane.nodes[target ?? camera])
+    return try #require(
+      ZoomGesture(plane: plane, tree: tree, isPresent: { !absent.contains($0) }, toward: spot.center))
+  }
+}
+
+private func near(_ x: CGRect, _ y: CGRect, _ tolerance: CGFloat = 0.001) -> Bool {
+  x.approximatelyEquals(y, tolerance: tolerance)
+}
+
+private func near(_ x: CGFloat, _ y: CGFloat, _ tolerance: CGFloat = 0.001) -> Bool { abs(x - y) <= tolerance }
+
+extension ZoomGesture {
+  /// This gesture after a pinch of `magnification`.
+  fileprivate func pinched(_ magnification: Double) -> ZoomGesture {
+    var copy = self
+    copy.move(magnification: magnification)
+    return copy
+  }
+
+  /// A magnification in the middle of those that land on `node`.
+  fileprivate func magnification(landingOn node: NodeID) -> Double? {
+    let all = stride(from: reach.lowerBound, through: reach.upperBound, by: 0.005).filter { pinched($0).landing == node }
+    return all.isEmpty ? nil : all[all.count / 2]
+  }
+}
+
+@Suite struct ZoomLevelTests {
+  @Test func theLevelsAreTheSpacesOutAndInWouldVisit() throws {
+    let f = Fixture()
+    let whole = [f.tree.root, f.column, f.row, f.leafC]
+    let fromEverything = try f.gesture(from: f.tree.root, over: f.leafC)
+    #expect(fromEverything.levels.map(\.node) == whole)
+    #expect(fromEverything.start == 0)
+
+    let fromTheWindow = try f.gesture(from: f.leafC)
+    #expect(fromTheWindow.levels.map(\.node) == whole)
+    #expect(fromTheWindow.start == 3)
+
+    let fromBetween = try f.gesture(from: f.column, over: f.leafA)
+    #expect(fromBetween.levels.map(\.node) == [f.tree.root, f.column, f.leafA], "the pointer decides what is further in")
+    #expect(fromBetween.start == 1)
+
+    let overTheDesktop = try f.gesture(from: f.tree.root, over: f.tree.desktop)
+    #expect(overTheDesktop.levels.map(\.node) == [f.tree.root, f.tree.desktop])
+  }
+
+  @Test func eitherEndIsAsFarAwayAsTheSideThatHasFurthestToGo() throws {
+    let f = Fixture()
+    let g = try f.gesture(from: f.column, over: f.leafA)
+    #expect(g.levels[1].rect == content, "the space in view fills the view")
+    // Everything is about three times as wide as the column, and a is about half as high.
+    #expect(near(CGFloat(g.reach.lowerBound), -log(g.levels[0].rect.width / content.width)))
+    #expect(near(CGFloat(g.reach.upperBound), log(content.height / g.levels[2].rect.height)))
+    #expect(g.reach.lowerBound < -1 && g.reach.upperBound > 0.69)
+    // c is a sixth as wide as everything and half as high.
+    let deep = try f.gesture(from: f.tree.root, over: f.leafC)
+    #expect(deep.reach.lowerBound == 0)
+    #expect(near(CGFloat(deep.reach.upperBound), log(content.width / deep.levels[3].rect.width)))
+    #expect(try f.gesture(from: f.leafC).reach.upperBound == 0)
+  }
+
+  @Test func inAGapThePointerMeansTheNearestSpace() throws {
+    let f = Fixture()
+    let plane = f.plane(camera: f.tree.root)
+    let gap = CGPoint(x: plane.nodes[f.leafB]!.minX - 2, y: 400)
+    let g = try #require(ZoomGesture(plane: plane, tree: f.tree, isPresent: { _ in true }, toward: gap))
+    #expect(g.levels.map(\.node) == [f.tree.root, f.leafB])
+    // And in the menu bar.
+    let above = try #require(
+      ZoomGesture(plane: plane, tree: f.tree, isPresent: { _ in true }, toward: CGPoint(x: 100, y: 3)))
+    #expect(above.levels.map(\.node) == [f.tree.root, f.column, f.leafA])
+  }
+
+  @Test func aTileIsAsFarInAsAGestureGoes() throws {
+    let f = Fixture()
+    // The row is too low to use, so it is one tile for both of its windows.
+    let cramped = LayoutOptions(minimumUsableSize: CGSize(width: 240, height: 430))
+    let g = try f.gesture(from: f.tree.root, over: f.row, options: cramped)
+    #expect(g.levels.map(\.node) == [f.tree.root, f.column, f.row])
+  }
+
+  @Test func aSpaceThatLooksLikeTheOneAroundItIsNoLevel() throws {
+    var f = Fixture()
+    f.absent = [c, d]
+    // The column shows only a, so stepping in from it leads nowhere, as with `in`.
+    #expect(try f.gesture(from: f.tree.root, over: f.column).levels.map(\.node) == [f.tree.root, f.column])
+    // And stepping out from a skips it, as with `out`.
+    #expect(try f.gesture(from: f.leafA).levels.map(\.node) == [f.tree.root, f.leafA])
+  }
+
+  @Test func withNothingDockedThereIsOneLevel() throws {
+    let tree = LayoutTree()
+    let plane = Plane(tree: tree, camera: tree.root, ancestor: tree.root, in: visible, isPresent: { _ in true })
+    var g = try #require(ZoomGesture(plane: plane, tree: tree, isPresent: { _ in true }, toward: content.center))
+    #expect(g.levels.map(\.node) == [tree.root])
+    g.move(magnification: 3, pan: CGSize(width: 500, height: 500))
+    #expect(g.landing == tree.root)
+    g.move(magnification: -9)
+    #expect(g.landing == tree.root)
+  }
+
+  @Test func aDisplayWithoutRoomHasNoGesture() {
+    // A point each way is the least a map can carry. (What a space in view fills is cut down to whole points.)
+    let tree = LayoutTree()
+    for (width, height, isEnough) in [
