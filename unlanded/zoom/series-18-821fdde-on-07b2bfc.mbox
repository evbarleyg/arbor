index b5a98ea..e0e469c 100644
--- a/Sources/ArborKit/Controller/Controller+Transitions.swift
+++ b/Sources/ArborKit/Controller/Controller+Transitions.swift
@@ -37,6 +37,13 @@ extension Controller {
     on displayID: DisplayID, to layout: Layout, reason: RelayoutReason, motion: Motion,
     puttingBack: [(window: WindowID, frame: CGRect)] = []
   ) -> StagedTransition? {
+    // A window of this display that reaches over onto the one where a gesture is followed has a stand-in there, which would go on
+    // showing it where it was (Controller+Gesture.swift).
+    if let gesture = followed, gesture.display != displayID, let workspace = workspaces[displayID],
+      gesture.scene.items.contains(where: { workspace.contains($0.window) })
+    {
+      returnFromFollowing()
+    }
     guard reason != .enforce else { return nil }
     guard motion == .animated, settings.motionDuration > 0,
       // The user is holding a window. Its stand-in would stay behind while the window goes on.
