index 00000000..0de89aae
--- /dev/null
+++ b/scripts/mac-on-linux/tests/FlightJudged.swift
@@ -0,0 +1,619 @@
+import ArborCore
+@testable import ArborKit
+import CoreGraphics
+import FakeMacOS
+import Foundation
+
+// The judge's stories about the cure of board 1.63 ("ask the window first, whether it is in the Dock"). They compile against Arbor with the cure and without it, so that each can be told of both; what calls the new
+// member of `WindowSystem` itself is behind HAS_THE_CURE, which build.sh sets when the sources have it.
+// Lines that begin with "·" are measurements, printed whether the checks pass or not.
+
+extension FakeMac {
+  /// Arbor's calls of one kind about one window since `since`.
+  func calls(_ verb: String, _ name: String, of window: Window, since: TimeInterval) -> [Call] {
+    account.filter { $0.time >= since && $0.verb == verb && $0.name == name && $0.window == window.number }
+  }
+  /// The reads of `AXMinimized` that are a question of their own. When a window is reported changed the layer reads title, position, size, minimized and full screen in a row (`refresh`): those are not counted.
+  func questionsWhetherItIsMinimized(_ window: Window?, since: TimeInterval) -> [Call] {
+    account.indices.filter { index in
+      let call = account[index]
+      guard call.time >= since, call.verb == "read", call.name == "AXMinimized", window == nil || call.window == window?.number else { return false }
+      return !(index > 0 && account[index - 1].verb == "read" && account[index - 1].name == "AXSize" && account[index - 1].window == call.window)
+    }.map { account[$0] }
+  }
+  /// What was asked of one window since `since`, in short: when, and how long it took. Of the reads only the question whether it is minimized; what sets a place or a size is counted.
+  func told(of window: Window, since: TimeInterval) -> String {
+    let questions = Set(questionsWhetherItIsMinimized(window, since: since).map(\.time))
+    let mine = account.filter { $0.time >= since && $0.window == window.number }
+    let frames = mine.filter { $0.verb == "write" && ($0.name == "AXPosition" || $0.name == "AXSize") }.count
+    let lines = mine.filter { ($0.verb != "read" && $0.name != "AXPosition" && $0.name != "AXSize") || ($0.name == "AXMinimized" && questions.contains($0.time)) }
+      .map { "\($0.verb) \($0.name) at \(String(format: "%.3f", $0.time - since)) took \(String(format: "%.3f", $0.took)) \($0.answer)" }
+    return "[" + (lines + (frames > 0 ? ["\(frames) places or sizes set"] : [])).joined(separator: "; ") + "]"
+  }
+  /// Whether the window server has `one` in front of `other`. False if either does not show.
+  func has(_ one: Window, inFrontOf other: Window) -> Bool {
+    let numbers = (windowList(onScreenOnly: true, withoutDesktop: true, only: nil) ?? []).map(\.number)
+    guard let a = numbers.firstIndex(of: one.number), let b = numbers.firstIndex(of: other.number) else { return false }
+    return a < b
+  }
+}
+
+private func measured(_ text: String) { print("  · \(text)") }
+private func seconds(_ value: TimeInterval) -> String { String(format: "%.3f s", value) }
+
+@MainActor
+func tellOfTheFlightJudged(_ book: Book) {
+  // MARK: 3. The calls in the story of the fault
+
+  for held in [true, false] {
+    book.story("judged: the calls while the window that fills the view flies to the Dock\(held ? ", the view held" : "")") { story in
+      var a: FakeMac.Window!, b: FakeMac.Window!, mine: FakeMac.Window!
+      let two = StoreyTwo(story) { mac in
+        let app = mac.launch("Notes")
+        b = mac.open("b", in: app, frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+        a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 400, width: 400, height: 250))
+      }
+      two.run("arrange")
+      two.mac.click(a)
+      two.mac.pass(1)
+      two.run("zoom \(a.number)")
+      if held { two.run("hold") }
+      two.mac.keepsAccountOfCalls = true
+      let (began, stoodStill, calls) = (two.mac.now, two.mac.secondsTheMainThreadWaited, two.mac.calls)
+      two.mac.minimize(a)
+      two.mac.pass(4)
+      let alone = two.mac.questionsWhetherItIsMinimized(a, since: began)
+      measured("asked whether it is minimized, as a question of its own: \(alone.map { String(format: "%.4f", $0.time - began) + " s" }.joined(separator: ", "))")
+      measured("asked the same of others: \(two.mac.questionsWhetherItIsMinimized(nil, since: began).filter { $0.window != a.number }.map { "w\($0.window ?? 0) at " + String(format: "%.4f", $0.time - began) + " s" }.joined(separator: ", "))")
+      measured("asked of w\(a.number), the window that flew: \(two.mac.told(of: a, since: began))")
+      measured("\(two.mac.calls - calls) calls in all; the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+      story.check("it is in the Dock", a.isMinimized)
+      story.check("it was asked once at most whether it is minimized", alone.count <= 1, "\(alone.count) times")
+      story.check("nobody made it the main window", two.mac.calls("write", "AXMain", of: a, since: began).isEmpty)
+      story.check("nobody raised it", two.mac.calls("perform", "AXRaise", of: a, since: began).isEmpty)
+      story.check("the main thread stood still for a hundredth of a second at most", two.mac.secondsTheMainThreadWaited - stoodStill < 0.01, seconds(two.mac.secondsTheMainThreadWaited - stoodStill))
+      story.check("the window with the keyboard is in view", two.mac.keyWindow.map { two.isInView($0) } ?? false, "w\(two.mac.keyWindow?.number ?? 0); \(two.whereabouts(b)); \(two.whereabouts(mine))")
+    }
+  }
+
+  // MARK: 4a. A window kept in view
+
+  /// Two docked windows of two apps, and a window of a third app, with a sibling or without, kept in view over them.
+  @MainActor
+  final class Pinned {
+    var left: FakeMac.Window!, right: FakeMac.Window!, pin: FakeMac.Window!, sibling: FakeMac.Window?
+    let two: StoreyTwo
+    init(_ story: Story, sibling withSibling: Bool) {
+      var left: FakeMac.Window!, right: FakeMac.Window!, pin: FakeMac.Window!, sibling: FakeMac.Window?
+      two = StoreyTwo(story) { mac in
+        left = mac.open("left", in: mac.launch("Notes"), frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+        right = mac.open("right", in: mac.launch("Mine"), frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+        let call = mac.launch("Call")
+        if withSibling { sibling = mac.open("sibling", in: call, frame: CGRect(x: 100, y: 420, width: 300, height: 200)) }
+        pin = mac.open("pin", in: call, frame: CGRect(x: 380, y: 200, width: 300, height: 220))
+      }
+      (self.left, self.right, self.pin, self.sibling) = (left, right, pin, sibling)
+      story.check("two windows are docked", two.run("dock \(left.number) left").ok && two.run("dock \(right.number) right").ok)
+      story.check("one is kept in view", two.run("pin \(pin.number)").ok, two.whereabouts(pin))
+      // Docking has pushed it onto the Desktop between the two. Its person wants it over the right one.
+      two.mac.drag(from: CGPoint(x: pin.bounds.midX, y: pin.bounds.minY + 10), to: CGPoint(x: pin.bounds.midX + 200, y: pin.bounds.minY + 10))
+      two.mac.release()
+      two.mac.pass(2)
+      story.check("it lies over part of the right one, in front of it", pin.bounds.intersects(right.bounds) && two.mac.has(pin, inFrontOf: right) && pin.bounds.maxX < right.bounds.maxX - 60, "\(two.whereabouts(pin)); \(two.whereabouts(right))")
+    }
+  }
+
+  // The look that falls between the landing and the report: 0.2, 0.4 and 0.6 s after the press, so it depends on how long the button is held.
+  for sibling in [false, true] {
+    for hasTheKeyboard in [false, true] {
+      for held in [0.040, 0.046, 0.048, 0.050, 0.052, 0.080, 0.250] {
+        book.story("judged: a window kept in view\(sibling ? ", which has a sibling," : "")\(hasTheKeyboard ? " with the keyboard" : "") goes to the Dock by its yellow button, held \(Int(held * 1000)) ms") { story in
+          let set = Pinned(story, sibling: sibling)
+          let (two, pin) = (set.two, set.pin!)
+          two.mac.click(hasTheKeyboard ? pin : set.left)
+          two.mac.pass(2)
+          two.mac.keepsAccountOfCalls = true
+          let (began, stoodStill) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+          two.mac.clickYellowButton(of: pin, heldFor: held)
+          two.mac.pass(4)
+          measured("asked of the window: \(two.mac.told(of: pin, since: began)); the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+          story.check("it is in the Dock, and stays there", pin.isMinimized, "it is out again: \(two.whereabouts(pin))")
+          story.check("nobody raised it", two.mac.calls("perform", "AXRaise", of: pin, since: began).isEmpty)
+          story.check("the main thread stood still for a tenth of a second at most", two.mac.secondsTheMainThreadWaited - stoodStill < 0.1, seconds(two.mac.secondsTheMainThreadWaited - stoodStill))
+        }
+      }
+    }
+  }
+
+  // Covered in mid-flight: the person sends the call to the Dock and goes on working in the window beneath.
+  for fetches in [false, true] {
+    for gap in [0.1, 0.3, 0.5, 0.56] {
+      book.story("judged: a window kept in view flies to the Dock, and \(gap) s later the window beneath it is clicked\(fetches ? " (a raise that waited fetches)" : "")") { story in
+        let set = Pinned(story, sibling: false)
+        let (two, pin) = (set.two, set.pin!)
+        two.mac.aRaiseThatWaitedFetches = fetches
+        two.mac.click(set.left)
+        two.mac.pass(2)
+        two.mac.keepsAccountOfCalls = true
+        let (began, stoodStill) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+        two.mac.clickYellowButton(of: pin, heldFor: 0)
+        two.mac.pass(gap)
+        // Beside the window kept in view, which lies over part of it.
+        two.mac.press(at: CGPoint(x: set.right.bounds.maxX - 40, y: 300))
+        two.mac.pass(0.08)
+        two.mac.release()
+        two.mac.pass(4)
+        measured("asked of the window: \(two.mac.told(of: pin, since: began)); the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+        story.check("it is in the Dock, and stays there", pin.isMinimized, "it is out again: \(two.whereabouts(pin))")
+        story.check("the window that was clicked has the keyboard", two.mac.keyWindow === set.right, "w\(two.mac.keyWindow?.number ?? 0)")
+        story.check("the main thread stood still for a tenth of a second at most", two.mac.secondsTheMainThreadWaited - stoodStill < 0.1, seconds(two.mac.secondsTheMainThreadWaited - stoodStill))
+      }
+    }
+  }
+
+  book.story("judged: a window kept in view that another covers is still raised") { story in
+    let set = Pinned(story, sibling: false)
+    let (two, pin) = (set.two, set.pin!)
+    two.mac.keepsAccountOfCalls = true
+    let (began, calls) = (two.mac.now, two.mac.calls)
+    two.mac.press(at: CGPoint(x: set.right.bounds.maxX - 40, y: 300))
+    two.mac.pass(0.08)
+    two.mac.release()
+    two.mac.pass(2)
+    measured("asked of the window: \(two.mac.told(of: pin, since: began)); \(two.mac.calls - calls) calls in all")
+    story.check("it is in front of the window that was clicked", two.mac.has(pin, inFrontOf: set.right))
+    story.check("which has the keyboard", two.mac.keyWindow === set.right, "w\(two.mac.keyWindow?.number ?? 0)")
+  }
+
+  // MARK: 4b. Asked for by name
+
+  for command in ["reveal", "zoom", "focus"] {
+    for kept in [false, true] {
+      book.story("judged: \(command) of a \(kept ? "window kept in view" : "docked window") that lies in the Dock") { story in
+        var a: FakeMac.Window!, b: FakeMac.Window!, mine: FakeMac.Window!
+        let two = StoreyTwo(story) { mac in
+          let app = mac.launch("Notes")
+          b = mac.open("b", in: app, frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+          a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+          mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 400, width: 400, height: 250))
+        }
+        two.run("arrange")
+        if kept { story.check("it is kept in view", two.run("pin \(a.number)").ok) }
+        two.mac.click(a)
+        two.mac.pass(1)
+        two.mac.minimize(a)
+        two.mac.pass(3)
+        two.mac.click(mine)
+        two.mac.pass(1)
+        story.check("it lies in the Dock", a.isMinimized)
+        two.mac.keepsAccountOfCalls = true
+        let (began, stoodStill) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+        let result = two.run("\(command) \(a.number)", then: 3)
+        measured("\(command): \(result.ok ? "ok" : "refused"): \(result.message)")
+        measured("asked of the window: \(two.mac.told(of: a, since: began)); the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+        story.check("it is out of the Dock", !a.isMinimized)
+        story.check("in view", two.isInView(a), two.whereabouts(a))
+        story.check("with the keyboard", two.mac.keyWindow === a, "w\(two.mac.keyWindow?.number ?? 0)")
+      }
+    }
+  }
+
+  // MARK: 4c. While its sibling is being laid out
+
+  for (gap, flight) in [(0.0, 0.55), (0.1, 0.55), (0.4, 0.55), (0.54, 0.55), (0.1, 0.66)] {
+    for command in ["swap-siblings", "dock-sibling", "dock-itself", "show-all"] {
+      book.story("judged: \(gap) s into a docked window's flight of \(flight) s to the Dock: \(command)") { story in
+        var a: FakeMac.Window!, b: FakeMac.Window!, mine: FakeMac.Window!
+        let two = StoreyTwo(story) { mac in
+          let app = mac.launch("Notes")
+          b = mac.open("b", in: app, frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+          a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+          mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 400, width: 400, height: 250))
+        }
+        two.run("arrange")
+        two.mac.click(a)
+        two.mac.pass(1)
+        if command == "show-all" { two.run("zoom \(a.number)") }
+        two.mac.timing.minimizing = flight
+        two.mac.keepsAccountOfCalls = true
+        let (began, stoodStill) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+        two.mac.minimize(a)
+        two.mac.pass(gap)
+        let text =
+          switch command {
+          case "swap-siblings": "swap \(b.number) \(mine.number)"
+          case "dock-sibling": "dock \(b.number) left"
+          case "dock-itself": "dock \(a.number) left"
+          default: "show-all"
+          }
+        let result = two.run(text, then: 4)
+        measured("\(text): \(result.ok ? "ok" : "refused"): \(result.message)")
+        measured("asked of the window that flew: \(two.mac.told(of: a, since: began)); the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+        story.check("the window is in the Dock, and stays there", a.isMinimized, "it is out again: \(two.whereabouts(a))")
+        story.check("the main thread stood still for the rest of the flight at most", two.mac.secondsTheMainThreadWaited - stoodStill < flight + 0.05 - gap, seconds(two.mac.secondsTheMainThreadWaited - stoodStill))
+        story.check("the two that are left are in view, side by side", two.isInView(b) && two.isInView(mine) && !b.frame.intersects(mine.frame), "\(two.whereabouts(b)); \(two.whereabouts(mine))")
+        story.check("the window with the keyboard is in view", two.mac.keyWindow.map { two.isInView($0) } ?? false, "w\(two.mac.keyWindow?.number ?? 0)")
+        story.check("the app is not written off: its window still takes a frame", two.run("swap \(b.number) \(mine.number)", then: 2).ok && two.isInView(b) && !b.frame.intersects(mine.frame), "\(two.whereabouts(b)); \(two.whereabouts(mine))")
+      }
+    }
+  }
+
+  // MARK: 4d. To the Dock by hand, and out again by hand
+
+  for held in [false, true] {
+    for gap in [0.3, 0.551, 0.56, 0.7, 1.0] {
+      book.story("judged: the window that fills the view goes to the Dock by hand and is fetched by hand \(gap) s later\(held ? ", the view held" : "")") { story in
+        var a: FakeMac.Window!, b: FakeMac.Window!, mine: FakeMac.Window!
+        let two = StoreyTwo(story) { mac in
+          let app = mac.launch("Notes")
+          b = mac.open("b", in: app, frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+          a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+          mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 400, width: 400, height: 250))
+        }
+        two.run("arrange")
+        two.mac.click(a)
+        two.mac.pass(1)
+        two.run("zoom \(a.number)")
+        let filled = a.frame
+        if held { two.run("hold") }
+        two.mac.keepsAccountOfCalls = true
+        let (began, stoodStill) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+        two.mac.minimize(a)
+        two.mac.pass(gap)
+        let wasInFlight = a.isInFlight
+        two.mac.restore(a, byHand: true)
+        two.mac.pass(5)
+        measured("asked of the window: \(two.mac.told(of: a, since: began)); the main thread stood still \(seconds(two.mac.secondsTheMainThreadWaited - stoodStill))")
+        _ = (b, mine)
+        if wasInFlight {
+          // There is nothing in the Dock to click yet: the model takes no notice. Not a story about Arbor.
+          story.check("(in flight the model lets nobody fetch it) it is in the Dock", a.isMinimized)
+        } else {
+          story.check("it is out of the Dock", !a.isMinimized)
+          story.check("it fills the view as before", two.isInView(a) && a.frame == filled, "\(two.whereabouts(a)), it was at \(filled.text)")
+          story.check("it has the keyboard", two.mac.keyWindow === a, "w\(two.mac.keyWindow?.number ?? 0)")
+        }
+        story.check("Arbor has raised nothing and sent nothing to the Dock or out of it", two.mac.calls("perform", "AXRaise", of: a, since: began).isEmpty && two.mac.calls("write", "AXMinimized", of: a, since: began).isEmpty)
+        story.check("the main thread stood still for a tenth of a second at most", two.mac.secondsTheMainThreadWaited - stoodStill < 0.1, seconds(two.mac.secondsTheMainThreadWaited - stoodStill))
+      }
+    }
+  }
+
+  // MARK: 4e. The question itself falls into the deaf half second, or is put to an app that hangs
+
+  #if HAS_THE_CURE
+    for flight in [0.55, 0.66, 1.2] {
+      book.story("judged: the layer is asked in mid-flight whether a window is in the Dock, a flight of \(flight) s") { story in
+        var a: FakeMac.Window!, b: FakeMac.Window!
+        let one = StoreyOne(story) { mac in
+          let app = mac.launch("Notes")
+          b = mac.open("b", in: app, frame: CGRect(x: 560, y: 60, width: 400, height: 300))
+          a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+        }
+        one.mac.timing.minimizing = flight
+        one.mac.minimize(a)
+        one.mac.pass(0.1)
+        var stoodStill = one.mac.secondsTheMainThreadWaited
+        let ofItself = one.layer.isInTheDockOrGone(WindowID(a.number))
+        measured("the window that flies: \(ofItself ? "in the Dock or gone" : "there"), after \(seconds(one.mac.secondsTheMainThreadWaited - stoodStill))")
+        story.check("the window that flies counts as in the Dock", ofItself)
+        stoodStill = one.mac.secondsTheMainThreadWaited
+        let ofItsSibling = one.layer.isInTheDockOrGone(WindowID(b.number))
+        measured("its sibling, asked next: \(ofItsSibling ? "in the Dock or gone" : "there"), after \(seconds(one.mac.secondsTheMainThreadWaited - stoodStill))")
+        story.check("its sibling counts as being there", !ofItsSibling)
+        one.mac.pass(3)
+        story.check("three seconds later the sibling counts as being there", !one.layer.isInTheDockOrGone(WindowID(b.number)))
+      }
+    }
+
+    book.story("judged: the layer is asked whether the window of an app that hangs is in the Dock") { story in
+      var a: FakeMac.Window!
+      var app: FakeMac.App!
+      let one = StoreyOne(story) { mac in
+        app = mac.launch("Notes")
+        a = mac.open("a", in: app, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+      }
+      one.mac.hang(app)
+      for turn in 1...3 {
