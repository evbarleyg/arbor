+  // MARK: Floating windows that will not be as small as the Desktop
+
+  /// After `command`, and after each layout that follows with nothing changed: where `window` is, which is one place.
+  func placeThatHolds(_ h: Harness, _ window: WindowID, sourceLocation: SourceLocation = #_sourceLocation) throws -> CGRect {
+    let frame = try #require(h.frame(window), sourceLocation: sourceLocation)
+    h.system.clearFrameLog()
+    // (Not `relayout`, which forgets on purpose what windows have refused, and asks them all again.)
+    for command in ["home", "show-all", "home"] {
+      h.run(command)
+      h.scheduler.runPending()
+    }
+    let moved = h.system.frameLog.filter { $0.window == window }.map(\.frame)
+    #expect(moved.isEmpty, "it was at \(frame) and then went to \(moved)", sourceLocation: sourceLocation)
+    return frame
+  }
+
+  /// On the Desktop, over no docked window, and there to stay. To a floating window the Desktop reaches to the edge of the screen where
+  /// nothing is docked beside it: the gap there is a margin for docked windows (`floatingRegion`). Every layout places by that, so
+  /// a window that `layout` fitted between the gaps was made 12 points wider by the next `home`.
+  func expectOnTheDesktopToStay(_ h: Harness, _ window: WindowID, sourceLocation: SourceLocation = #_sourceLocation) throws {
+    let frame = try placeThatHolds(h, window, sourceLocation: sourceLocation)
+    let gap = CGFloat(Settings().gap)
+    let desktop = try #require(h.layout?.desktopFrame, sourceLocation: sourceLocation)
+    #expect(h.visibleFrame.contains(frame), "\(window) at \(frame)", sourceLocation: sourceLocation)
+    #expect(desktop.insetBy(dx: -gap, dy: -gap).contains(frame), "\(window) at \(frame)", sourceLocation: sourceLocation)
+    for docked in h.workspace.tree.allWindows {
+      #expect(!frame.overlaps(try #require(h.frame(docked))), "\(window) at \(frame) lies over \(docked)", sourceLocation: sourceLocation)
+    }
+  }
+
+  /// Arbor has never asked Xcode to be smaller, so it does not know that Xcode will not fit on the Desktop that is left. Xcode
+  /// refuses, and where it was to begin it would hang over the edge of the screen by half.
+  @Test func aFloatingWindowThatWillNotBeAsSmallAsTheDesktopIsPlacedOnceMore() throws {
+    let h = Harness()
+    let size = CGSize(width: 1181, height: 697)
+    let terminal = h.system.open(
+      app: "Terminal", frame: CGRect(origin: CGPoint(x: -164, y: 507), size: size), minimumSize: size)
+    let safari = h.system.open(
+      app: "Safari", frame: CGRect(x: 33, y: 60, width: 484, height: 296), minimumSize: CGSize(width: 484, height: 296))
+    h.start()
+    h.run("zoom \(terminal.rawValue)")
+    h.run("toggle-float")
+    let own = CGSize(width: 977, height: 621)
+    let xcode = h.system.open(app: "Xcode", frame: CGRect(origin: CGPoint(x: 811, y: 404), size: own), minimumSize: own)
+    #expect(h.run("layout Notes | Safari").ok)
+    #expect(h.workspace.isDocked(safari))
+    // What it has learnt it knows: the next layout does not send Xcode over the edge again to fetch it back.
+    let frame = try placeThatHolds(h, xcode)
+    #expect(frame.size == own)
+    #expect(h.visibleFrame.contains(frame), "\(frame)")
+    _ = try placeThatHolds(h, terminal)
+    expectWindowsMatchLayout(h)
+  }
+
+  /// The same, but it is a person who left Xcode hanging over the edge of the screen, and there it may go on hanging: every layout
+  /// says so. `layout` fetched it, and the next `home` sent it back.
+  @Test func oneThatItsUserLeftHangingOverTheEdgeIsNotFetchedToBeSentBack() throws {
+    let h = harness("Safari")
+    let own = CGSize(width: 977, height: 621)
+    let xcode = h.system.open(app: "Xcode", frame: CGRect(origin: CGPoint(x: 300, y: 200), size: own), minimumSize: own)
+    let left = CGRect(origin: CGPoint(x: 811, y: 404), size: own)
+    h.system.userMove(xcode, to: left)
+    h.scheduler.runPending()
+    #expect(h.run("layout Notes | Safari").ok)
+    #expect(try placeThatHolds(h, xcode) == left)
+  }
+
+  /// Safari and Mail docked, and `size` the least that Xcode, which floats, will be.
+  func besideXcode(atLeast size: CGSize, frame: CGRect = CGRect(x: 300, y: 200, width: 700, height: 500)) -> (Harness, WindowID) {
+    let h = harness("Safari", "Mail")
+    let xcode = h.system.open(app: "Xcode", frame: frame, minimumSize: size)
+    return (h, xcode)
+  }
+
+  /// It has to hang over a docked window, and a window that hangs over another from behind is half a window.
+  @Test func itHangsOverTheDockedWindowsFromTheFront() throws {
+    let (h, xcode) = besideXcode(atLeast: CGSize(width: 600, height: 500))
+    h.system.userFocus(w(102))
+    h.system.userFocus(w(101))
+    let raised = h.system.raiseLog.count
+    #expect(h.run("layout Safari | Mail").ok)
+    #expect(h.system.raiseLog.dropFirst(raised).contains(xcode))
+    let frame = try placeThatHolds(h, xcode)
+    #expect(h.visibleFrame.contains(frame), "\(frame)")
+    #expect(try #require(h.frame(w(102))).overlaps(frame), "there is no room for it beside Mail")
+  }
+
+  /// The size it floated at is then no size to go back to.
+  @Test func oneWhoseAppHasRaisedItsMinimumSinceItFloatedDoesNotHangOverTheEdgeEither() throws {
+    let (h, xcode) = besideXcode(atLeast: .zero)
+    h.system.userMove(xcode, to: CGRect(x: 300, y: 200, width: 700, height: 500))
+    h.system.setMinimumSize(xcode, CGSize(width: 977, height: 621))
+    #expect(h.run("layout Safari | Mail").ok)
+    let frame = try placeThatHolds(h, xcode)
+    #expect(frame.size == CGSize(width: 977, height: 621))
+    #expect(h.visibleFrame.contains(frame), "\(frame)")
+  }
+
+  /// All of it is on the screen wherever it begins, so nothing but its size says that it refused.
+  @Test func onADesktopInTheMiddleItHangsOverBothNeighboursAlike() throws {
+    let (h, xcode) = besideXcode(atLeast: CGSize(width: 700, height: 500))
+    #expect(h.run("layout Safari | Desktop:0.6 | Mail").ok)
+    let desktop = try #require(h.layout?.desktopFrame)
+    #expect(desktop.width < 700)
+    let frame = try placeThatHolds(h, xcode)
+    #expect(abs(frame.midX - desktop.midX) <= 1, "\(frame) on \(desktop)")
+  }
+
+  /// A terminal takes whole character cells: a few points more than it was asked for are not a refusal.
+  @Test func aWindowThatComesInStepsIsAskedForOneStepLess() throws {
+    let h = harness("Safari", "Mail")
+    let terminal = h.system.open(app: "Terminal", frame: CGRect(x: 300, y: 100, width: 720, height: 720))
+    h.system.setSizeStep(terminal, CGSize(width: 36, height: 36))
+    #expect(h.run("layout Safari | Mail").ok)
+    let frame = try placeThatHolds(h, terminal)
+    #expect(h.visibleFrame.contains(frame), "\(frame)")
+    #expect(!frame.overlaps(try #require(h.frame(w(102)))), "\(frame) reaches over Mail")
+  }
+
+  /// With `soleFloatTakesDesktop` the layout has just given it all of the Desktop.
+  @Test func theWindowThatHasTheDesktopToItselfKeepsIt() throws {
+    var settings = Settings()
+    settings.soleFloatTakesDesktop = true
+    let h = harness("Safari", "Mail", settings: settings)
+    h.run("arrange")
+    h.system.clearFrameLog()
+    #expect(h.run("layout Safari").ok)
+    let moves = h.system.frameLog.filter { $0.window == w(102) }.map(\.frame)
+    #expect(moves.count == 1, "\(moves)")
+    #expect(try placeThatHolds(h, w(102)) == h.layout?.desktopFrame)
   }
 
