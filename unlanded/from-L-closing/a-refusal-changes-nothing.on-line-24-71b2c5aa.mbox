+  /// A command that Arbor refuses has changed nothing: not the arrangement, its gaps or the view, not who is out of view, no window's frame, not who has the
+  /// keyboard, and not what Undo would take back. The nets for the road a window takes do not see it: this one looks at the end.
+  func refusalViolations(after action: ChaosAction, _ problems: inout [InvariantViolation]) {
+    guard !refusals.isEmpty, action.isACommand, action.parsedCommand != nil, isRunning, wasRunningBefore, !seven.pausedBefore else { return }
+    asked("refused")
+    var changed: [String] = []
+    for (display, before) in workspacesBefore.sorted(by: { $0.key < $1.key }) where controller.workspaces[display] != before {
+      let now = controller.workspaces[display]
+      changed.append(now?.tree != before.tree ? "the arrangement on \(display)" : now?.floating != before.floating ? "what it remembers of floating windows on \(display)" : "the view on \(display)")
+    }
+    if controller.parked != parkedBefore { changed.append("who is out of view") }
+    changed += Set(movesSeenInThisStep.map(\.window)).sorted().map { "the frame of \($0)" }
+    if system.focusLog.count != seven.focusCallsWhenTheStepBegan { changed.append("who has the keyboard") }
+    // An Undo that cannot take a step back (the closing of a window, say) lets go of that step, so that the next one reaches further.
+    if undoSteps != seven.undoStepsBefore, action.parsedCommand != .undo, action.parsedCommand != .redo { changed.append("what Undo takes back") }
+    if !changed.isEmpty {
+      problems.append(.init("refused-and-changed-something", "Arbor refused `\(action.text)` (\(refusals[0])) and changed \(changed.joined(separator: ", "))"))
+    }
+  }
+
   /// At a change of displays Arbor fits only what the change took out of reach (decided 2026-10-15): a floating window that nobody named, whose title bar is
   /// within reach where macOS left it, is not set by Arbor at all, however little of it shows. Whoever misses it has a key.
   func fetchedAtAChangeViolations(after action: ChaosAction, _ problems: inout [InvariantViolation]) {
@@ -1143,18 +1168,24 @@ extension ChaosRunner {
   /// A key that docks takes no window out of view that was in view (Q29, 8): not the one it names, which would have the keyboard, and not one that was docked
   /// before, which becomes a tile for want of room.
   func dockViolations(after action: ChaosAction, _ problems: inout [InvariantViolation]) {
+    // Nor does a gap that a hand drags: the window that cannot be made smaller stops the gap, it does not leave.
+    var isAGap = false
+    if case .seam = action { isAGap = true }
     switch action.parsedCommand {
     case .dock, .dockBeside, .toggleFloat, .arrange, .arrangeAll: break
-    default: return
+    default: if !isAGap { return }
     }
     if case .key(_, .released) = action { return }
     guard isRunning, wasRunningBefore, controller.holdLevel == nil else { return }
-    asked("dock")
+    asked(isAGap ? "gap" : "dock")
     for window in Set(movesSeenInThisStep.map(\.window)).sorted() {
       guard let fake = isFairGame(window), presentBefore.contains(window), let before = framesBefore[window], isInView(before), !parkedBefore.contains(window),
         !isInView(fake.snapshot.frame), controller.workspaces.values.contains(where: { $0.isDocked(window) })
       else { continue }
-      problems.append(.init("dock-took-out-of-view", "`\(action.text)` took \(window), which is docked, out of view: from \(before.brief) to \(fake.snapshot.frame.brief)"))
+      problems.append(
+        .init(
+          isAGap ? "gap-took-out-of-view" : "dock-took-out-of-view",
+          "`\(action.text)` took \(window), which is docked, out of view: from \(before.brief) to \(fake.snapshot.frame.brief)"))
     }
   }
 
