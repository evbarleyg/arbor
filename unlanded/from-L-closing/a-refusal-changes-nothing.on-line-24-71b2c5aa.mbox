From e7f166628534242d4c056b98044ad0a45fbfdc7e Mon Sep 17 00:00:00 2001
From: ebg-ant <296364998+ebg-ant@users.noreply.github.com>
Date: Thu, 15 Oct 2026 14:14:48 +0000
Subject: [PATCH] test: a command that is refused has changed nothing; a gap
 takes nobody out of view; forgetting right before a key that depends on sizes

refused-and-changed-something, a number that is not yet a gate, looks at the end and not at the road: a command that Arbor refuses has changed neither the arrangement,
its gaps or the view, nor who is out of view, nor a window's frame, nor who has the keyboard, nor what Undo would take back.

gap-took-out-of-view, likewise: a gap that a hand drags takes no docked window out of view. The net for docks asked that of commands only.

In walks of seeds beyond the frozen versions six in a hundred of the keys that depend on sizes are pressed right after Arbor has forgotten what it had learnt of the apps'
smallest sizes: a quit and a start, or Lay Out Again.
---
 .../ChaosGenerator+Ordinary.swift             | 11 ++++++
 .../ChaosInvariants+SevenRules.swift          | 39 +++++++++++++++++--
 Sources/ArborTesting/ChaosKnownFailures.swift |  2 +-
 .../ArborKitTests/ChaosSevenRulesTests.swift  | 17 ++++++++
 4 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/Sources/ArborTesting/ChaosGenerator+Ordinary.swift b/Sources/ArborTesting/ChaosGenerator+Ordinary.swift
index 431f25ad..a62d4ec6 100644
--- a/Sources/ArborTesting/ChaosGenerator+Ordinary.swift
+++ b/Sources/ArborTesting/ChaosGenerator+Ordinary.swift
@@ -336,6 +336,17 @@ extension ChaosGenerator {
         ["zoom", "out", "in", "home", "desktop", "neighbor left", "neighbor right"].contains(line) && random.chance(30)
         ? [.react, .advance(1), .react, .key("back", .pressed), .key("back", .released)] : []
       thenAMoment([.key(line, .released)] + andBack)
+      // What Arbor has learnt of the apps' smallest sizes is forgotten right before a key that depends on them: a quit and a start, or Lay Out Again. Walks did
+      // both seldom, and never just then.
+      if drawsFromEverything, random.chance(6), ["dock", "arrange", "rotate", "balance", "shrink", "grow", "toggle-float", "swap"].contains(where: line.hasPrefix) {
+        planned.insert(.key(line, .pressed), at: 0)
+        if random.chance(50) {
+          planned.insert(contentsOf: [.launch, .react, .advance(1), .react], at: 0)
+          return .command("quit")
+        }
+        planned.insert(contentsOf: [.react], at: 0)
+        return .via(.menu, "relayout")
+      }
       return .key(line, .pressed)
     case .hold:
       // Show Everything kept down is a look around.
