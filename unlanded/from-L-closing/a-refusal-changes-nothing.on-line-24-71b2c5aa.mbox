+  /// Two docked windows and the gap between them, dragged by ten points.
+  @Test func aGapThatIsDraggedTakesNoWindowOutOfView() {
+    let arranged = oneDocked + ["dock 102 right", "react", "settle"]
+    #expect(!numbers(after: arranged, then: "seam main 0 -10").contains("gap-took-out-of-view"))
+    #expect(numbers(after: arranged, then: "seam main 0 -10") { _ = $0.setFrame(self.rect(1439, 868, 500, 400), of: b) }.contains("gap-took-out-of-view"))
+  }
+
+  /// `dock 999 left` names a window that is not there.
+  @Test func aCommandThatIsRefusedHasChangedNothing() {
+    let rule = "refused-and-changed-something"
+    #expect(!numbers(after: oneDocked, then: "dock 999 left").contains(rule))
+    #expect(numbers(after: oneDocked, then: "dock 999 left") { _ = $0.setFrame(self.rect(820, 300, 500, 400), of: b) }.contains(rule))
+    #expect(numbers(after: oneDocked, then: "dock 999 left") { $0.focus(b) }.contains(rule))
+    // One that is carried out may change what it likes.
+    #expect(!numbers(after: oneDocked, then: "dock 102 right").contains(rule))
+  }
