+# trace_clock <step>: ties the trace's own seconds to the Mac's clock: a remark, and the moments before it was sent and after it was taken
+trace_clock() {
+  arbor_answers || return 0
+  echo "trace-clock $1 $(perl -MTime::HiRes=time -e '$a = time; if (open(my $said, "-|", @ARGV)) { my @words = <$said>; close $said } $b = time; printf "%d %d", $a * 1000, $b * 1000' \
+    "$ARBOR_BIN/arborctl" trace note "clock $1" 2> /dev/null)" | tee -a "$ARBOR_OUT/trace-clock.txt"
+}
+
+# new_trace: with Arbor, a trace of the part's own, numbered
+new_trace() {
+  arbor_answers || return 0
+  G_TRACES=$((G_TRACES + 1))
+  G_TRACE="went-and-came-back-G$G_TRACES"
+  G_TRACE_BEGAN=$SECONDS
+  record "$G_TRACE" || loud "part G: NO TRACE is being recorded ($(arborctl trace status 2>&1 | head -n 1))"
+}
+
+# in_the_trace_G <step> <the step's name in the marks>: see THE LINES
+in_the_trace_G() {
+  local step=$1 file name id pairs=""
+  file=$(trace_of "$G_TRACE")
+  if [ -z "$file" ]; then
+    echo "SKIPPED: $step: what the trace says: Arbor's home holds no trace $G_TRACE"
+    return 0
+  fi
+  for name in $CAST; do
+    eval "id=\$W_$name"
+    pairs="$pairs $id=$name"
+  done
+  # shellcheck disable=SC2086
+  python3 -c '
+import json, sys
+path, clocks, step, wanted = sys.argv[1:5]
+names = dict(pair.split("=") for pair in sys.argv[5:])
+sent = {}
+try:
+    with open(clocks, encoding="utf-8") as lines:
+        for words in (line.split() for line in lines):
+            if len(words) == 4:
+                sent[words[1]] = (int(words[2]), int(words[3]))
+except OSError:
+    pass
+trace = []
+with open(path, encoding="utf-8", errors="replace") as lines:
+    for text in lines:
+        try:
+            trace.append(json.loads(text))
+        except ValueError:
+            continue  # the last line, if Arbor is writing it at this moment
+# When was t = 0? After the latest of the moments before a remark was sent, before the earliest of those after one was taken, each less the t the remark has.
+low, high = None, None
+for line in trace:
+    words = str(line.get("note", "")).split()
+    if len(words) == 2 and words[0] == "clock" and words[1] in sent and isinstance(line.get("t"), (int, float)):
+        first, second = (moment - line["t"] * 1000 for moment in sent[words[1]])
+        low = first if low is None else max(low, first)
+        high = second if high is None else min(high, second)
+if low is None:
+    print("trace-zero", step, "not known")
+else:
+    print("trace-zero", step, "between %.1f and %.1f" % (low, high))
+def four(frame):
+    return " ".join("%g" % number for number in frame) if isinstance(frame, list) and len(frame) == 4 else "- - - -"
+def when(line):
+    t = line.get("t")
+    known = low is not None and isinstance(t, (int, float))
+    return "t %s ms %s" % ("-" if t is None else t, "%d" % ((low + high) / 2 + t * 1000) if known else "-")
+inside, told, sets = False, False, 0
+for line in trace:
+    words = str(line.get("note", "")).split()
+    raw = str(line.get("raw", ""))
+    if len(words) >= 3 and words[0] == "step":
+        if inside:
+            break
+        inside = words[2] == wanted
+    elif not inside:
+        continue
+    elif raw == "didChangeScreenParameters":
+        print("heard", step, when(line))
+    elif raw.startswith("screens "):
+        print("screens", step, when(line), "|", raw[8:])
+    elif line.get("event") == "displaysChanged":
+        told = True
+        print("told", step, when(line), "|", " ; ".join(
+            "%s %s" % (four(display.get("frame")), "main" if display.get("main") else "-") for display in line.get("to", [])))
+    elif line.get("event") == "changed" and str(line.get("window", {}).get("id")) in names:
+        window = line["window"]
+        print("reported", step, names[str(window["id"])], window["id"], "after-told" if told else "before-told", when(line),
+              "user", "true" if line.get("user") else "false", "frame", four(window.get("frame")))
+    elif line.get("call") == "setFrame" and str(line.get("id")) in names:
+        sets += 1
+        print("arbor-set", step, names[str(line["id"])], line["id"], "after-told" if told else "before-told", when(line),
+              "asked", four(line.get("frame")), "took", four(line.get("result")))
+if not told:
+    print("told", step, "no")
+if not sets:
+    print("arbor-set", step, "none")' "$file" "$ARBOR_OUT/trace-clock.txt" "$step" "$2" $pairs 2>&1
+}
+
+# looks_G <step>: the two looks after the marker. RESTING_<NAME>: the window server's frame at the second
+looks_G() {
+  local step=$1 moment list name id before on by from to put puton putfrom when said server glass home
+  for moment in 0.5 3.5; do
+    sleep "$(echo "$CHANGED $moment $(now_ms)" | awk '{ left = $2 - ($3 - $1) / 1000; printf "%.3f", (left > 0 ? left : 0) }')"
+    when=$(now_ms)
+    list=$("$ARBOR_VDISPLAY" list)
+    echo "list $step $(short_list "$list") | after $(since_change "$when")"
+    for name in $CAST; do
+      eval "id=\$W_$name before=\$BEFORE_$name on=\$BEFORE_ON_$name by=\$BEFORE_BY_$name from=\$BEFORE_FROM_$name"
+      eval "put=\${PUT_$name:-} puton=\${PUT_ON_$name:-none} putfrom=\${PUT_FROM_$name:-}"
+      when=$(now_ms)
+      said=$(apptool describe "$id" 2>/dev/null | awk 'NF >= 7 { print $4, $5, $6, $7 }')
+      server=$(real_frame_of "$id" 2>/dev/null)
+      to=$(origin_of "$by" "$list")
+      # Its own display has gone: where that glass was, counted as H is counted now.
+      if [ -z "$to" ]; then from=$H_FROM to=$(origin_of H "$list"); fi
+      glass=$(carried_along "$before" "$from" "$to")
+      home=$(carried_along "$put" "$putfrom" "$(origin_of "$puton" "$list")")
+      echo "main $step $name $id before ${before:-- - - -} on $on | glass $glass | home $home | accessibility ${said:-- - - -} | server ${server:-- - - -} is $(which_of "$server" "$glass" "$before" "$home") | shown $("$ARBOR_POINTER" visible "$id" 2>/dev/null || echo -) on $(lies "$server" "$list" | cut -d ' ' -f 2) | after $(since_change "$when")"
+      eval "RESTING_$name=\$server"
+    done
+  done
+}
+
+# after_G <round> <change> <lines arbor.log had before, or nothing> [unlooked]: four seconds are over, the picture, the step's end, the arrangement, the lines for words-before-the-news.py, and Arbor's side
+after_G() {
+  local round=$1 what=$2 step="$1-$2" lines=$3 list held=no moved over name id before resting
+  sleep "$(echo "$CHANGED $(now_ms)" | awk '{ left = 4 - ($2 - $1) / 1000; printf "%.3f", (left > 0 ? left : 0) }')"
+  over=$(now_ms)
+  [ -z "$G_PICTURE" ] || ARBOR_SETTLE=0 shot "main-$step"
+  REST_NOW=0 rested
+  list=$("$ARBOR_VDISPLAY" list)
+  # The displays move on purpose here: `tell` is to hold A to where it is now.
+  if A_is_there; then DISPLAY_AT_A=$(frame_in "$list" A); fi
+  if [ "$(origin_of H "$list")" = "$PLAN_H" ] && [ "$(origin_of A "$list")" = "$PLAN_A" ] && [ "$(main_is "$list")" = "$PLAN_MAIN" ]; then held=yes; fi
+  moved=$(echo "$(origin_of H "$list") $H_FROM" | awk 'NF == 4 { print $1 - $3, $2 - $4; next } { print "? ?" }')
+  echo "arrangement $step $(short_list "$list") | main $(main_is "$list") | as planned $held | shift $moved"
+  echo "$list" | sed 's/^/  vdisplay list: /'
+  awk -v from="$CHANGED" -v step="$step" '$1 >= from { printf "screens-log %s +%d %s\n", step, $1 - from, substr($0, index($0, " ") + 1) }' "$ARBOR_OUT/screens.log" 2>/dev/null
+  if [ -z "${4:-}" ] && [ "$moved" != "? ?" ]; then
+    {
+      echo "change $step round $round kind $what marker $CHANGED until $over main-before ${MAIN_WAS:-?} main-after $(main_is "$list") shift $moved trace ${G_TRACE:--} slug $DAY_SLUG"
+      for name in $CAST; do
+        eval "id=\$W_$name before=\$BEFORE_$name resting=\$RESTING_$name"
+        echo "window $step $name $id old ${before:-- - - -} resting ${resting:-- - - -}"
+      done
+    } >> "$ARBOR_OUT/changes.txt"
+  fi
+  if arbor_answers; then
+    summary 2>&1 | sed "s/^/arbor $step | /"
+    [ -z "$lines" ] || arbor_log_since "$lines" | grep -i "display" | sed "s/^/log $step /"
+    in_the_trace_G "$step" "$DAY_SLUG"
+  elif [ -n "$ARBOR_PID" ]; then
+    loud "$step: ARBOR'S PROCESS HAS ENDED, and nobody asked it to: from here on this is macOS alone"
+  fi
+  clock "$step done"
+}
+
+# change_G <round> <goes|comes>: A is unplugged, or plugged in and left where it comes; and is looked at
+change_G() {
+  local round=$1 what=$2 step="$1-$2" lines=""
+  if arbor_answers; then lines=$(arbor_log_lines); fi
+  begin_step display-change "display-$step" "$step: display A $what"
+  before_G "$round" "$what"
+  trace_clock "$step"
+  mark_G "change $step"
+  CHANGED=$(now_ms)
+  if [ "$what" = goes ]; then unplug A; else plug A as-it-comes; fi
+  mark_G "changed $step"
+  echo "changed $step at $CHANGED, and the command had returned $(since_change "$(now_ms)") s later"
+  looks_G "$step"
+  if [ "$what" = goes ]; then LITTLE_BEFORE=${BEFORE_LITTLE:-} LITTLE_FROM=$H_FROM LITTLE_WENT=${RESTING_LITTLE:-}; fi
+  after_G "$round" "$what" "$lines"
+}
+
+# make_main <round> <H|A>: fails, loudly, if the display is not the main one afterwards. REFUSAL: what the tools said then
+make_main() {
+  local round=$1 name=$2 step="$1-$2-main" id other said code how lines="" list want at
+  id=$(id_of "$name")
+  if [ "$name" = H ]; then other=A; else other=H; fi
+  if [ -z "$id" ]; then
+    REFUSAL="display $name is not there"
+    echo "SKIPPED: $step: $REFUSAL"
+    return 1
+  fi
+  if arbor_answers; then lines=$(arbor_log_lines); fi
+  begin_step display-change "display-$step" "$step: display $name is made the main display"
+  before_G "$round" "$name-main"
+  trace_clock "$step"
+  REFUSAL=""
+  if [ -n "$SCREENS" ] && [ "$JOURNEY_MAIN_BY" = screens ]; then
+    how="screens main $id"
+    mark_G "change $step"
+    CHANGED=$(now_ms)
+    said=$("$SCREENS" main "$id" 2>&1)
+    code=$?
+    mark_G "changed $step"
+    echo "> $how: exit code $code: $said"
+    if ! within 2 is_main "$name" > /dev/null; then
+      loud "$step: \`$how\` did not make $name the main display: \`vdisplay move\` is tried"
+      REFUSAL="\`$how\`: $said (exit code $code); "
+      how=""
+    fi
+  fi
+  if [ -z "${how:-}" ]; then
+    how="vdisplay move $id 0 0"
+    mark_G "change $step"
+    CHANGED=$(now_ms)
+    said=$("$ARBOR_VDISPLAY" move "$id" 0 0 2>&1)
+    code=$?
+    mark_G "changed $step"
+    echo "> $how: exit code $code: $said"
+  fi
+  echo "changed $step at $CHANGED, and the command had returned $(since_change "$(now_ms)") s later"
+  if ! within 2 is_main "$name" > /dev/null; then
+    REFUSAL="$REFUSAL\`$how\`: $said (exit code $code); \`vdisplay list\` then: $(short_list "$("$ARBOR_VDISPLAY" list)")"
+    loud "$step: DISPLAY $name COULD NOT BE MADE THE MAIN DISPLAY. $REFUSAL"
+    REFUSED=$((REFUSED + 1))
+    after_G "$round" "$name-main" "$lines" unlooked
+    return 1
+  fi
+  REFUSAL=""
+  MADE_BY=$how
+  list=$("$ARBOR_VDISPLAY" list)
+  eval "want=\$PLAN_$other"
+  at=$(origin_of "$other" "$list")
+  if [ -n "$want" ] && [ -n "$at" ] && [ "$at" != "$want" ]; then
+    mark_G "change $step the-other-display"
+    # shellcheck disable=SC2086
+    echo "$step IS TWO CHANGES, NOT ONE: macOS put display $other at $at, and it is moved to $want, where the arrangement has it, $(since_change "$(now_ms)") s after the first: now at $("$ARBOR_VDISPLAY" move "$(id_of "$other")" $want 2>&1)"
+  fi
+  looks_G "$step"
+  after_G "$round" "$name-main" "$lines"
+}
+
+# ready_G <round>: A is plugged in, H is the main display, and A lies at its right. Whatever the clock says. Silent where all that is so.
+ready_G() {
+  local round=$1 list want at
+  A_is_there || change_G "$round-again" comes
+  is_main H || make_main "$round" H || return 1
+  list=$("$ARBOR_VDISPLAY" list)
+  want=$(frame_in "$list" H | awk 'NF == 4 { print $1 + $3, $2 }')
+  at=$(origin_of A "$list")
+  [ "$at" != "$want" ] || return 0
+  begin_step display-change "display-$round-A-right" "$round-A-right: display A is moved to the right of H"
+  PLAN_H=$(origin_of H "$list") PLAN_A=$want PLAN_MAIN=H H_FROM=$PLAN_H
+  CHANGED=$(now_ms)
+  # shellcheck disable=SC2086
+  echo "> vdisplay move: A lay at ${at:-no place} and is moved to $want: now at $("$ARBOR_VDISPLAY" move "$DISPLAY_ID_A" $want 2>&1)"
+  G_PICTURE="" after_G "$round" A-right "" unlooked
+  [ "$(origin_of A "$("$ARBOR_VDISPLAY" list)")" = "$want" ]
+}
+
+# little <round>: after A has gone and come back: where LITTLE was before, after the one and after the other, each in the numbers of the list in force at that moment
+little() {
+  local now there
+  in_cast LITTLE || return 0
+  now=$(origin_of H "$("$ARBOR_VDISPLAY" list)")
+  there=$(carried_along "$LITTLE_BEFORE" "$LITTLE_FROM" "$now")
+  echo "little $1 LITTLE $W_LITTLE before ${LITTLE_BEFORE:-- - - -} after-it-went ${LITTLE_WENT:-- - - -} after-it-came-back ${RESTING_LITTLE:-- - - -} same-as-before $(alike "$RESTING_LITTLE" "$there") | before, in the numbers of the list now: $there"
