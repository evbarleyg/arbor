index 00000000..113a0fea
--- /dev/null
+++ b/scripts/mac-shell/screens.swift
@@ -0,0 +1,235 @@
+// screens: when macOS says that its displays have changed, when its lists of them are new, what the windows say meanwhile, and a way to make another display the main one.
+// apptool watch hears the apps and the sampler asks for the displays four times a second; neither hears macOS's own notice of its screens, and no one process hears both.
+//
+//   screens watch <log file> [pid…]     writes until it is killed. A line is `<milliseconds since 1970> <kind> …`: the clock and the form of the sampler's samples.log, so
+//                                that the two files sort into one. All of it happens on the main thread of ONE process, as it does in Arbor, so the order of the lines is the
+//                                order in which a process that listens to all of it hears of things (an R that came on another thread ends with `off-main`).
+//       N                                           NSApplication.didChangeScreenParametersNotification arrived, which is what Arbor listens to
+//       R <display> <flags> <words>                 the callback of CGDisplayRegisterReconfigurationCallback was called for that display. The flags as a number and in
+//                                                   words, joined by +: begin moved main mode add remove enabled disabled mirror unmirror shape
+//       C <id> <x> <y> <w> <h> <main|-> <serial> ; …     CoreGraphics' list is not what it was (CGGetActiveDisplayList, CGDisplayBounds, CGDisplayIsMain)
+//       X <id> <x> <y> <w> <h> ; …                  AppKit's list is not what it was (NSScreen.screens, the first of which is the main one), counted from the top left
+//                                                   corner of the main display like everything else here
+//       H <AXMoved|AXResized> <window> <x> <y> <w> <h> | C … | X …      a window of one of the pids said that it has moved or changed its size. The time is that of the
+//                                                   word's arrival. Both lists are as this process read them at that moment, BEFORE it asked the window for the frame, which
+//                                                   is Accessibility's answer a moment later (`- - - -`: none)
+//       M …                                         `screens watch`: it has begun, and both lists follow; `hears <window> of <pid>`; `cannot hear <pid>`
+//     Both lists are asked for every 4 ms, and at once at every N, R and H: a C or an X between two lines says that the list was new by the second.
+//   screens main <display>       makes it the main display and leaves the arrangement as it is, as after the menu bar has been dragged to it in System Settings: in
+//                                one configuration every display is moved by the same distance, so that this one comes to lie at 0 0. The display at 0 0 is the main one.
+//                                Prints the list as a C line has it. Exit code 1 with macOS's error if it is refused.
+// `watch` with pids needs Accessibility permission, as apptool does. It never reads a window's title.
+import AppKit
+import ApplicationServices
+import CoreGraphics
+import Foundation
+
+/// The window server's number for an Accessibility window, as in apptool.swift.
+@_silgen_name("_AXUIElementGetWindow")
+func _AXUIElementGetWindow(_ element: AXUIElement, _ identifier: UnsafeMutablePointer<CGWindowID>) -> AXError
+
+func fail(_ message: String, code: Int32 = 64) -> Never {
+  FileHandle.standardError.write(Data("screens: \(message)\n".utf8))
+  exit(code)
+}
+
+let arguments = Array(CommandLine.arguments.dropFirst())
+guard arguments.count >= 2, arguments[0] == "watch" || (arguments[0] == "main" && arguments.count == 2) else {
+  fail("usage: screens watch <log file> [pid…] | screens main <display>")
+}
+
+@Sendable func active() -> [CGDirectDisplayID] {
+  var count: UInt32 = 0
+  CGGetActiveDisplayList(0, nil, &count)
+  var ids = [CGDirectDisplayID](repeating: 0, count: Int(count))
+  CGGetActiveDisplayList(count, &ids, &count)
+  return Array(ids.prefix(Int(count)))
+}
+
+@Sendable func listed() -> String {
+  var parts: [String] = []
+  for id in active() {
+    let bounds = CGDisplayBounds(id)
+    let main = CGDisplayIsMain(id) != 0 ? "main" : "-"
+    parts.append(
+      "\(id) \(Int(bounds.minX)) \(Int(bounds.minY)) \(Int(bounds.width)) \(Int(bounds.height)) \(main) \(CGDisplaySerialNumber(id))")
+  }
+  return parts.joined(separator: " ; ")
+}
+
+if arguments[0] == "main" {
+  guard let display = CGDirectDisplayID(arguments[1]), active().contains(display) else {
+    fail("no display \(arguments[1])", code: 1)
+  }
+  let origin = CGDisplayBounds(display).origin
+  var configuration: CGDisplayConfigRef?
+  var result = CGBeginDisplayConfiguration(&configuration)
+  for each in active() where result == .success {
+    let bounds = CGDisplayBounds(each)
+    result = CGConfigureDisplayOrigin(configuration, each, Int32(bounds.minX - origin.x), Int32(bounds.minY - origin.y))
+  }
+  if result != .success {
+    if configuration != nil { CGCancelDisplayConfiguration(configuration) }
+    fail("could not configure the displays (error \(result.rawValue))", code: 1)
+  }
+  // For the session: it has to outlive this process.
+  result = CGCompleteDisplayConfiguration(configuration, .forSession)
+  if result != .success { fail("the arrangement was refused (error \(result.rawValue))", code: 1) }
+  print(listed())
+  exit(0)
+}
+
+/// Not `guard let`: what that binds at the top of a file is no global, and the functions below could not use it.
+nonisolated(unsafe) let logFile: UnsafeMutablePointer<FILE> = {
+  guard let file = fopen(arguments[1], "a") else { fail("cannot write to \(arguments[1])") }
+  return file
+}()
+
+@Sendable func now() -> Int64 { Int64(Date().timeIntervalSince1970 * 1000) }
+
+/// At once: the process is killed, not asked to end.
+@Sendable func write(_ line: String, at time: Int64 = now()) {
+  fputs("\(time) \(line)\n", logFile)
+  fflush(logFile)
+}
+
+@MainActor final class Lists {
+  private(set) var coreGraphics = ""
+  private(set) var appKit = ""
+
+  func note() {
+    let current = listed()
+    if current != coreGraphics {
+      coreGraphics = current
+      write("C \(current)")
+    }
+    guard let first = NSScreen.screens.first else { return }
+    var parts: [String] = []
+    for screen in NSScreen.screens {
+      let id = (screen.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber)?.stringValue ?? "?"
+      let frame = screen.frame
+      // AppKit counts from the bottom of the main display.
+      parts.append("\(id) \(Int(frame.minX)) \(Int(first.frame.maxY - frame.maxY)) \(Int(frame.width)) \(Int(frame.height))")
+    }
+    let seen = parts.joined(separator: " ; ")
+    if seen != appKit {
+      appKit = seen
+      write("X \(seen)")
+    }
+  }
+}
+
+let app = NSApplication.shared
+app.setActivationPolicy(.prohibited)
+// As in the sampler: a process without a window is put to sleep between its timers, and its timers are run together with others'.
+let awake = ProcessInfo.processInfo.beginActivity(
+  options: [.userInitiated, .latencyCritical], reason: "asking for the list of displays at a steady rate")
+let lists = MainActor.assumeIsolated { Lists() }
+
+/// A function and no closure: macOS takes a C function pointer, which can capture nothing.
+func reconfigured(_ display: CGDirectDisplayID, _ flags: CGDisplayChangeSummaryFlags, _ context: UnsafeMutableRawPointer?) {
+  let names: [(UInt32, String)] = [
+    (1 << 0, "begin"), (1 << 1, "moved"), (1 << 2, "main"), (1 << 3, "mode"), (1 << 4, "add"), (1 << 5, "remove"), (1 << 8, "enabled"),
+    (1 << 9, "disabled"), (1 << 10, "mirror"), (1 << 11, "unmirror"), (1 << 12, "shape"),
+  ]
+  var words: [String] = []
+  for (bit, name) in names where flags.rawValue & bit != 0 { words.append(name) }
+  // On the main thread as far as anybody knows. Should it come on another, that is said, and the lists wait for the timer.
+  let here = Thread.isMainThread
+  write("R \(display) \(flags.rawValue) \(words.isEmpty ? "-" : words.joined(separator: "+"))\(here ? "" : " off-main")")
+  if here { MainActor.assumeIsolated { lists.note() } }
+}
+
+// MARK: What the windows say. The helpers are apptool.swift's.
+
+extension AXUIElement {
+  func attribute(_ name: String) -> CFTypeRef? {
+    var raw: CFTypeRef?
+    guard AXUIElementCopyAttributeValue(self, name as CFString, &raw) == .success else { return nil }
+    return raw
+  }
+
+  func elements(_ name: String) -> [AXUIElement] {
+    guard let raw = attribute(name), CFGetTypeID(raw) == CFArrayGetTypeID() else { return [] }
+    return (raw as? [AnyObject] ?? []).compactMap { item in
+      CFGetTypeID(item) == AXUIElementGetTypeID() ? (item as! AXUIElement) : nil
+    }
+  }
+
+  var position: CGPoint? {
+    guard let raw = attribute(kAXPositionAttribute), CFGetTypeID(raw) == AXValueGetTypeID() else { return nil }
+    var point = CGPoint.zero
+    return AXValueGetValue(raw as! AXValue, .cgPoint, &point) ? point : nil
+  }
+
+  var size: CGSize? {
+    guard let raw = attribute(kAXSizeAttribute), CFGetTypeID(raw) == AXValueGetTypeID() else { return nil }
+    var extent = CGSize.zero
+    return AXValueGetValue(raw as! AXValue, .cgSize, &extent) ? extent : nil
+  }
+
+  var windowNumber: UInt32? {
+    var identifier = CGWindowID(0)
+    guard _AXUIElementGetWindow(self, &identifier) == .success, identifier != 0 else { return nil }
+    return identifier
+  }
+}
+
+/// `12` for 12.0 and `12.5` for 12.5.
+func text(_ value: CGFloat) -> String {
+  let number = Double(value)
+  return number == number.rounded() ? String(Int(number)) : String(format: "%.1f", number)
+}
+
+/// Kept: an observer that nobody holds hears nothing.
+var observers: [AXObserver] = []
+
+/// A function and no closure, for the same reason as `reconfigured`. It comes on the run loop its source was added to, which is the main one.
+func heard(_ observer: AXObserver, _ element: AXUIElement, _ notification: CFString, _ refcon: UnsafeMutableRawPointer?) {
+  let arrived = now()
+  let id = refcon.map { UInt32(truncatingIfNeeded: UInt(bitPattern: $0)) } ?? 0
+  // The lists first: asking the window takes a moment, in which they may change.
+  let (coreGraphics, appKit) = MainActor.assumeIsolated { () -> (String, String) in
+    lists.note()
+    return (lists.coreGraphics, lists.appKit)
+  }
+  var frame = "- - - -"
+  if let origin = element.position, let extent = element.size {
+    frame = "\(text(origin.x)) \(text(origin.y)) \(text(extent.width)) \(text(extent.height))"
+  }
+  write("H \(notification as String) \(id) \(frame) | C \(coreGraphics) | X \(appKit)", at: arrived)
+}
+
+func hear(_ pid: pid_t) {
+  var created: AXObserver?
+  let element = AXUIElementCreateApplication(pid)
+  // An app that is busy must not hold up the lines that follow for long.
+  AXUIElementSetMessagingTimeout(element, 2)
+  guard AXObserverCreate(pid, heard, &created) == .success, let observer = created else {
+    write("M cannot hear \(pid)")
+    return
+  }
+  CFRunLoopAddSource(CFRunLoopGetMain(), AXObserverGetRunLoopSource(observer), .defaultMode)
+  observers.append(observer)
+  for window in element.elements(kAXWindowsAttribute) {
+    guard let id = window.windowNumber else { continue }
+    let refcon = UnsafeMutableRawPointer(bitPattern: UInt(id))
+    for name in [kAXMovedNotification, kAXResizedNotification] { AXObserverAddNotification(observer, window, name as CFString, refcon) }
+    write("M hears \(id) of \(pid)")
+  }
+}
+
+write("M screens watch")
+MainActor.assumeIsolated { lists.note() }
+for word in arguments.dropFirst(2) {
+  if let pid = pid_t(word) { hear(pid) }
+}
+CGDisplayRegisterReconfigurationCallback(reconfigured, nil)
+NotificationCenter.default.addObserver(
+  forName: NSApplication.didChangeScreenParametersNotification, object: nil, queue: .main
+) { _ in
+  write("N")
+  MainActor.assumeIsolated { lists.note() }
+}
+Timer.scheduledTimer(withTimeInterval: 0.004, repeats: true) { _ in MainActor.assumeIsolated { lists.note() } }
+app.run()
diff --git a/scripts/mac-shell/words-before-the-news.py b/scripts/mac-shell/words-before-the-news.py
