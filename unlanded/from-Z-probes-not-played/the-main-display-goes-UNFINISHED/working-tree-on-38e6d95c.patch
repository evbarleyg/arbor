+        w=""
+        read -r _ _ w _ <<< "$(real_of "$W_WIDE")"
+        [ "${w:-0}" -gt "$hw" ] || loud "$step: WIDE is ${w:-?} points wide, which is not wider than H ($hw)" ;;
+      STRADDLES)
