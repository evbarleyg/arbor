+  if [ $((hx + hw)) -eq "$ax" ]; then edge=$ax; elif [ $((ax + aw)) -eq "$hx" ]; then edge=$hx; fi
+  if [ "$hy" -gt "$ay" ]; then top=$hy; else top=$ay; fi
+  for name in $CAST; do
+    case "$name" in
+      TEXT) put "$step" TEXT "$((ax + 90))" "$((ay + 70))" 640 420 wholly_on "$ax $ay $aw $ah" ;;
+      LIVES) put "$step" LIVES "$((ax + 860))" "$((ay + 330))" 1000 660 wholly_on "$ax $ay $aw $ah" ;;
+      WIDE)
