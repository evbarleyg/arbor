+      echo "SKIPPED: the rest of $half-$round"
+    fi
+  done
+  echo "rounds played to the end:${whole:- none} | cut short:${short:- none} | not played:${never:- none}"
+  G_PICTURE=""
+  ready_G "$half-end" || loud "$half-end: H IS NOT THE MAIN DISPLAY WITH A AT ITS RIGHT at the end of the part"
+  with_arbor || no_arbor "$half-end"
