+# before_G <round> <goes|comes|A-main|H-main>: where the displays will be if the arrangement stays, where each window lies, and what its numbers will be if it stays on the glass
+before_G() {
+  local round=$1 what=$2 step="$1-$2" list oh oa o="" name id frame on by from put puton putfrom putto
+  screens_lives "$step"
+  list=$("$ARBOR_VDISPLAY" list)
+  oh=$(origin_of H "$list") oa=$(origin_of A "$list")
+  H_FROM=$oh
+  MAIN_WAS=$(main_is "$list")
+  case "$what" in
+    *-main)
+      if [ "$what" = H-main ]; then o=$oh; else o=$oa; fi
+      PLAN_H=$(echo "$oh $o" | awk 'NF == 4 { print $1 - $3, $2 - $4 }')
+      PLAN_A=$(echo "$oa $o" | awk 'NF == 4 { print $1 - $3, $2 - $4 }')
+      PLAN_MAIN=${what%-main} ;;
+    goes)
+      # A display that is alone is the main one, at 0 0.
+      PLAN_H="0 0" PLAN_A="" PLAN_MAIN=H ;;
+    comes)
+      PLAN_H=$oh PLAN_MAIN=H
+      PLAN_A=$(frame_in "$list" H | awk 'NF == 4 { print $1 + $3, $2 }') ;;
+  esac
+  echo "plan $step H ${PLAN_H:-gone} A ${PLAN_A:-gone} main $PLAN_MAIN$([ "$what" != comes ] || echo " (if H stays the main display and A comes at its right)")"
+  for name in $CAST; do
+    eval "id=\$W_$name put=\${PUT_$name:-} puton=\${PUT_ON_$name:-none} putfrom=\${PUT_FROM_$name:-}"
+    frame=$(real_frame_of "$id" 2>/dev/null)
+    on=$(lies "$frame" "$list" | cut -d ' ' -f 2)
+    by=$(counted_from "$name" "$on")
+    from=$(origin_of "$by" "$list")
+    eval "BEFORE_$name=\$frame BEFORE_ON_$name=\$on BEFORE_BY_$name=\$by BEFORE_FROM_$name=\$from"
+    eval "putto=\${PLAN_$puton:-}"
+    # Every place on the glass changes its numbers as H's corner does, if the arrangement stays.
+    echo "expects $round $what $name $id old ${frame:-- - - -} on $on same-glass-in-new $(carried_along "$frame" "$oh" "$PLAN_H") | home $(carried_along "$put" "$putfrom" "$putto")"
+  done
+}
