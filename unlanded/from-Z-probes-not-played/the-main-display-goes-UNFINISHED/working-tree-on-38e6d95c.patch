+
+# staged <round>: the one plain line: is A the main display now, by `vdisplay list`?
+staged() {
+  if is_main A; then
+    echo "staged: yes ($1: A is the main display by \`vdisplay list\`, made so by \`$MADE_BY\`)"
+  else
+    echo "staged: no: ${REFUSAL:-\`$MADE_BY\` made A the main display, and by \`vdisplay list\` it is not any more: $(short_list "$("$ARBOR_VDISPLAY" list)")} ($1)"
+    return 1
+  fi
+}
