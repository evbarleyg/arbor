+      [ "${round%-*}" = R1 ] || echo "staged: no: the clock left no time for it ($half-$round)"
+      continue
+    fi
+    if [ "${round%-*}" != R1 ] && [ "$REFUSED" -ge 2 ]; then
+      echo "SKIPPED: $half-$round: twice a display could not be made the main one, and it is not tried again"
+      echo "staged: no: not tried again. The last time: $REFUSAL ($half-$round)"
+      continue
+    fi
+    step "G, $half-$round"
+    if ! ready_G "$half-$round"; then
+      echo "SKIPPED: $half-$round: H is not the main display with A at its right, and could not be made so"
+      [ "${round%-*}" = R1 ] || echo "staged: no: H is not the main display with A at its right to begin with, and could not be made so ($half-$round)"
+      continue
+    fi
