+          loud "$step: H and A do not lie side by side, so no window can lie across the edge between them"
+          echo "SKIPPED: $step: STRADDLES is left where it is"
+        fi ;;
+      DESK) put "$step" DESK "$((hx + 230))" "$((hy + 250))" 620 460 wholly_on "$hx $hy $hw $hh" ;;
+      LITTLE)
+        # Asked once, and taken as it comes: macOS may refuse the place, and where the window then lies is what the round goes on with.
+        if [ "$edge" = "$ax" ] && [ -n "$edge" ] && [ $((ay + ah)) -ge $((hy + hh + 100)) ]; then
