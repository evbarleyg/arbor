index 00000000..0e0bff18
--- /dev/null
+++ b/scripts/mac-shell/words-before-the-news.py
@@ -0,0 +1,375 @@
+#!/usr/bin/env python3
+"""Does a window's own word of its move come before the news of the displays, by how much, and in which list's numbers?
+
+    scripts/mac-shell/words-before-the-news.py <folder>      what probe-the-main-display-goes.sh and its control left in mac-shell/
+    scripts/mac-shell/words-before-the-news.py --self-test
+
+The probe runs it at its end; anybody can run it again on the folder that came back. It judges nothing: it puts times side by side.
+
+It reads
+    changes.txt         written by the probe, two kinds of line:
+                        change <step> round <round> kind <goes|comes|A-main|H-main> marker <ms> until <ms> main-before <H|A> main-after <H|A> shift <dx> <dy> trace <name|-> slug <name>
+                        window <step> <NAME> <id> old <x y w h> resting <x y w h>
+                        marker: when the command that makes the change was given. shift: by how much the numbers of a place on the glass changed (the corner of H, the display
+                        that never goes, after the change less before it). old: the window server's frame just before the change. resting: 3.5 s after it.
+    screens.log         screens.swift: N and R (macOS's notices), C and X (its lists are new), H (a window's word, with both lists as they were read when it arrived)
+    macos-reports.log   apptool watch: AXMoved and AXResized with the frames they carry
+    traces/*-<name>.jsonl and trace-clock.txt     with Arbor
+
+It prints, for every change and window, one line for each witness that has anything to say. All times are milliseconds after the marker.
+    word <round> <kind> <NAME> <id> first-word <ms|none> list-new <ms|unknown> notice <ms|unknown> told <ms|no|no Arbor> | frame <x y w h> numbers <…> list-at-word <old|new|unknown>
+            before-list <yes|no|unknown> before-notice <yes|no|unknown>
+            screens.log alone: ONE process heard the word, the notice and the lists, on one thread. list-new: the earlier of C and X. notice: the earlier of N and R
+    word-reports …      the word by macos-reports.log, which is another process's; list-new and notice by screens.log
+    word-trace …        the trace alone, which is Arbor's own process: the word is a `changed`, the notice the raw line didChangeScreenParameters, list-new the first `screens` line or
+                        read of the displays that differs from the last before the step, list-at-word the read of the displays that follows the word
+    before-list, before-notice: within one witness's file by the ORDER OF ITS LINES, which tells two lines of one millisecond apart; between two files by their times.
+    told is the trace's `displaysChanged` in all three, brought to the Mac's clock by the remarks of trace-clock.txt (right to half of what `trace-zero` says they leave open).
+    numbers: in which list's numbers the first word's frame is:
+            same          the shift is 0 0: both lists count alike
+            old, new      the frame it had before the change; that same place on the glass in the new list's numbers (old + shift)
+            resting-new, resting-old      the frame it rests at 3.5 s after the change, which is in the new list's numbers; that place in the old list's numbers (resting - shift)
+            …-origin      the corner alone is that, the size is another            neither       none of these
+    early <witness> <round> <kind> <NAME> <id> <+ms> <what> frame <x y w h> numbers <…> list-at-word <…> before-list <…> before-notice <…> main-changed <yes|no>
+            EVERY word, not the first alone, that came before the witness's notice or before its list was new (or under a list that was read as the old one)
+    tally <witness> …   counts, at the end
+"""
+import calendar
+import glob
+import json
+import os
+import re
+import sys
+import tempfile
+import time
+
+
+def four(words):
+    try:
+        return tuple(float(word) for word in words)
+    except ValueError:
+        return None
+
+
+def text(frame):
+    return " ".join("%g" % number for number in frame) if frame else "- - - -"
+
+
+def read_changes(folder):
+    changes, order = {}, []
+    with open(os.path.join(folder, "changes.txt"), encoding="utf-8") as lines:
+        for words in (line.split() for line in lines):
+            if len(words) == 21 and words[0] == "change":
+                changes[words[1]] = {
+                    "step": words[1], "round": words[3], "kind": words[5], "marker": int(words[7]), "until": int(words[9]),
+                    "changed": words[11] != words[13], "shift": (float(words[15]), float(words[16])), "trace": words[18], "slug": words[20], "windows": []}
+                order.append(words[1])
+            elif len(words) == 14 and words[0] == "window" and words[1] in changes:
+                changes[words[1]]["windows"].append({"name": words[2], "id": words[3], "old": four(words[5:9]), "resting": four(words[10:14])})
+    return [changes[step] for step in order]
+
+
+def read_screens(folder):
+    """[(ms, kind, the rest)]"""
+    found = []
+    try:
+        with open(os.path.join(folder, "screens.log"), encoding="utf-8", errors="replace") as lines:
+            for line in lines:
+                words = line.rstrip("\n").split(" ", 2)
+                if len(words) >= 2 and words[0].isdigit():
+                    found.append((int(words[0]), words[1], words[2] if len(words) > 2 else ""))
+    except OSError:
+        pass
+    return found
+
+
+REPORT = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)\.(\d{3})Z MACOS pid \d+ (AXMoved|AXResized) w(\d+) \S+ (\S+) (\S+) (\S+) (\S+)")
+
+
+def read_reports(folder):
+    """[(ms, what, window id, frame)]"""
+    found = []
+    try:
+        with open(os.path.join(folder, "macos-reports.log"), encoding="utf-8", errors="replace") as lines:
+            for line in lines:
+                match = REPORT.match(line)
+                if match:
+                    seconds = calendar.timegm(time.strptime(match.group(1), "%Y-%m-%dT%H:%M:%S"))
+                    found.append((seconds * 1000 + int(match.group(2)), match.group(3), match.group(4), four(match.groups()[4:8])))
+    except OSError:
+        pass
+    return found
+
+
+def read_trace(folder, name):
+    """The trace's lines, and the moment of its t = 0 as (low, high) in ms since 1970, or None."""
+    paths = sorted(glob.glob(os.path.join(folder, "traces", "*-%s.jsonl" % name)))
+    if not paths:
+        return None, None
+    sent = {}
+    try:
+        with open(os.path.join(folder, "trace-clock.txt"), encoding="utf-8") as lines:
+            for words in (line.split() for line in lines):
+                if len(words) == 4:
+                    sent[words[1]] = (int(words[2]), int(words[3]))
+    except OSError:
+        pass
+    trace = []
+    with open(paths[-1], encoding="utf-8", errors="replace") as lines:
+        for line in lines:
+            try:
+                trace.append(json.loads(line))
+            except ValueError:
+                continue
+    low = high = None
+    for line in trace:
+        words = str(line.get("note", "")).split()
+        if len(words) == 2 and words[0] == "clock" and words[1] in sent and isinstance(line.get("t"), (int, float)):
+            first, second = (moment - line["t"] * 1000 for moment in sent[words[1]])
+            low = first if low is None else max(low, first)
+            high = second if high is None else min(high, second)
+    return trace, (None if low is None else (low, high))
+
+
+def numbers(frame, window, shift):
+    if frame is None:
+        return "unknown"
+    if shift == (0, 0):
+        return "same"
+
+    def moved(other, sign):
+        return None if other is None else (other[0] + sign * shift[0], other[1] + sign * shift[1], other[2], other[3])
+    named = [("old", window["old"]), ("new", moved(window["old"], 1)), ("resting-new", window["resting"]), ("resting-old", moved(window["resting"], -1))]
+    for name, other in named:
+        if other is not None and frame == other:
+            return name
+    for name, other in named:
+        if other is not None and frame[:2] == other[:2]:
+            return name + "-origin"
+    return "neither"
+
+
+def signature(displays):
+    return tuple((display.get("id"), tuple(display.get("frame", []))) for display in displays or [])
+
+
+def in_the_trace(change, trace, zero):
+    """{"notice", "list", "told": a moment or None; "words": [(moment, what, id, frame, old|new|unknown)]}, or None if the step is not in the trace.
+    A moment: (ms after the marker, the line's place in the file)."""
+    middle = (zero[0] + zero[1]) / 2
+
+    def after(line):
+        return (middle + line["t"] * 1000 - change["marker"], place)
+    before, inside, seen = None, False, {"notice": None, "list": None, "told": None, "words": []}
+    waiting = None
+    found = False
+    for place, line in enumerate(trace):
+        words = str(line.get("note", "")).split()
+        raw = str(line.get("raw", ""))
+        if len(words) >= 3 and words[0] == "step":
+            if inside:
+                break
+            inside = found = words[2] == change["slug"]
+            continue
+        lists = None
+        if line.get("call") == "displays":
+            lists = signature(line.get("result"))
+        elif line.get("event") == "displaysChanged":
+            lists = signature(line.get("to"))
+        elif "displays" in line and "settings" in line:
+            lists = signature(line.get("displays"))  # the header
+        if not inside:
+            before = lists if lists is not None else before
+            continue
+        if not isinstance(line.get("t"), (int, float)):
+            continue
+        if line.get("call") == "displays" and waiting is not None:
+            seen["words"][waiting] = seen["words"][waiting][:4] + ("old" if lists == before else "new",)
+        if line.get("call") != "displays" or waiting is not None:
+            waiting = None
+        if raw == "didChangeScreenParameters" and seen["notice"] is None:
+            seen["notice"] = after(line)
+        if (raw.startswith("screens ") or (lists is not None and lists != before)) and seen["list"] is None:
+            seen["list"] = after(line)
+        if line.get("event") == "displaysChanged" and seen["told"] is None:
+            seen["told"] = after(line)
+        if line.get("event") == "changed":
+            window = line.get("window", {})
+            frame = window.get("frame")
+            seen["words"].append((after(line), "changed", str(window.get("id")), tuple(float(n) for n in frame) if frame else None, "unknown"))
+            waiting = len(seen["words"]) - 1
+    return seen if found else None
+
+
+def ms(moment, missing):
+    return missing if moment is None else "%d" % round(moment[0])
+
+
+def before(word, news):
+    """Did the word come before the news? By their places in one file, if both have one."""
+    if news is None:
+        return "unknown"
+    if word[1] is not None and news[1] is not None:
+        return "yes" if word[1] < news[1] else "no"
+    return "yes" if word[0] < news[0] else "no"
+
+
+def report(folder, out=sys.stdout):
+    changes = read_changes(folder)
+    screens, reports = read_screens(folder), read_reports(folder)
+    traces = {}
+    tallies = {}
+
+    def say(*words):
+        print(*words, file=out)
+
+    def witness(name, change, words, notice, new, told):
+        """words: [(moment, what, id, frame, list at the word)], in order of time"""
+        tally = tallies.setdefault(name, {"changes": 0, "main": 0, "first": 0, "told": 0, "list": 0, "notice": 0, "silent": 0, "early": {}, "a": 0})
+        tally["changes"] += 1
+        tally["main"] += change["changed"]
+        for window in change["windows"]:
+            own = [word for word in words if word[2] == window["id"]]
+            line = ["word" if name == "screens" else "word-" + name, change["round"], change["kind"], window["name"], window["id"],
+                    "first-word", ms(own[0][0] if own else None, "none"), "list-new", ms(new, "unknown"), "notice", ms(notice, "unknown"),
+                    "told", told if isinstance(told, str) else ms(told, "no")]
+            if own:
+                line += ["|", "frame", text(own[0][3]), "numbers", numbers(own[0][3], window, change["shift"]), "list-at-word", own[0][4],
+                         "before-list", before(own[0][0], new), "before-notice", before(own[0][0], notice)]
+                tally["first"] += 1
+                tally["told"] += not isinstance(told, str) and told is not None and own[0][0][0] < told[0]
+                tally["list"] += before(own[0][0], new) == "yes"
+                tally["notice"] += before(own[0][0], notice) == "yes"
+            else:
+                tally["silent"] += 1
+            say(*line)
+            for word in own:
+                under_old = word[4] == "old" or (word[4] == "unknown" and before(word[0], new) == "yes")
+                if under_old or before(word[0], notice) == "yes":
+                    kind = numbers(word[3], window, change["shift"])
+                    say("early", name, change["round"], change["kind"], window["name"], window["id"], "%+d" % round(word[0][0]), word[1], "frame", text(word[3]),
+                        "numbers", kind, "list-at-word", word[4], "before-list", before(word[0], new), "before-notice", before(word[0], notice),
+                        "main-changed", "yes" if change["changed"] else "no")
+                    tally["early"][kind] = tally["early"].get(kind, 0) + 1
+                    if change["changed"] and under_old and before(word[0], notice) != "no" and kind.startswith(("new", "resting-new")):
+                        tally["a"] += 1
+
+    for change in changes:
+        marker, until = change["marker"], change["until"]
+        told = "no Arbor"
+        traced = None
+        if change["trace"] != "-":
+            if change["trace"] not in traces:
+                traces[change["trace"]] = read_trace(folder, change["trace"])
+                trace, zero = traces[change["trace"]]
+                say("trace-zero", change["trace"], "no such trace" if trace is None else "not known" if zero is None else "between %.1f and %.1f" % zero)
+            trace, zero = traces[change["trace"]]
+            told = "unknown"
+            if trace is not None and zero is not None:
+                traced = in_the_trace(change, trace, zero)
+                told = traced["told"] if traced else "unknown"
+        during = [(place,) + line for place, line in enumerate(screens) if marker <= line[0] <= until]
+        notice = next(((line[1] - marker, line[0]) for line in during if line[2] in "NR"), None)
+        new = next(((line[1] - marker, line[0]) for line in during if line[2] in "CX"), None)
+        last = {kind: next((line[2] for line in reversed(screens) if line[0] < marker and line[1] == kind), None) for kind in "CX"}
+        heard = []
+        for place, when, kind, rest in during:
+            if kind != "H":
+                continue
+            parts = [part.strip() for part in rest.split("|")]
+            words = parts[0].split()
+            lists = {part[0]: part[2:] for part in parts[1:] if len(part) > 2}
+            at = "unknown"
+            if last["C"] is not None and "C" in lists:
+                at = "old" if lists["C"] == last["C"] and lists.get("X", last["X"]) == last["X"] else "new"
+            if len(words) == 6:
+                heard.append(((when - marker, place), words[0], words[1], four(words[2:6]), at))
+        if any(line[1] == "H" for line in screens):
+            witness("screens", change, heard, notice, new, told)
+        said = [((when - marker, None), what, window, frame, "unknown") for when, what, window, frame in reports if marker <= when <= until]
+        if reports:
+            witness("reports", change, said, notice, new, told)
+        if traced:
+            witness("trace", change, traced["words"], traced["notice"], traced["list"], traced["told"])
+    for name in ("screens", "reports", "trace"):
+        tally = tallies.get(name)
+        if not tally:
+            say("tally", name, "has nothing to say")
+            continue
+        say("tally", name, "changes", tally["changes"], "in which the main display changed", tally["main"], "| windows that spoke", tally["first"], "that said nothing", tally["silent"],
+            "| first words before Arbor was told", tally["told"], "before the list was new", tally["list"], "before the notice", tally["notice"],
+            "| early words by their numbers:", " ".join("%s %d" % pair for pair in sorted(tally["early"].items())) or "none",
+            "| under the old list, before the notice, in the new list's numbers, the main display changing:", tally["a"])
+    return tallies
+
+
+def self_test():
+    with tempfile.TemporaryDirectory() as folder:
+        os.mkdir(os.path.join(folder, "traces"))
+
+        def write(name, lines):
+            with open(os.path.join(folder, name), "w", encoding="utf-8") as file:
+                file.write("\n".join(lines) + "\n")
+        base = 1792000000000  # 2026-10-14T17:46:40Z
+        old, new = "1 -1600 0 1600 900 - 0 ; 2 0 0 1920 1080 main 1", "1 0 0 1600 900 main 0"
+        write("changes.txt", [
+            "change a-R3-1-goes round a-R3-1 kind goes marker %d until %d main-before A main-after H shift 1600 0 trace G1 slug display-a-R3-1-goes" % (base, base + 4000),
+            "window a-R3-1-goes DESK 45 old -1370 250 620 460 resting 230 250 620 460",
+            "window a-R3-1-goes TEXT 41 old 90 70 640 420 resting 120 120 640 420",
+            "window a-R3-1-goes WIDE 44 old 110 560 1700 400 resting 0 31 1600 400"])
+        write("screens.log", [
+            "%d C %s" % (base - 9000, old), "%d X 2 0 0 1920 1080 ; 1 -1600 0 1600 900" % (base - 9000),
+            "%d H AXMoved 45 230 250 620 460 | C %s | X 2 0 0 1920 1080 ; 1 -1600 0 1600 900" % (base + 50, old),  # in the millisecond of the notice, and before it
+            "%d R 2 1 begin" % (base + 50), "%d C %s" % (base + 60, new), "%d N" % (base + 70),
+            "%d H AXMoved 41 120 120 640 420 | C %s | X 1 0 0 1600 900" % (base + 80, new)])
+        write("macos-reports.log", [
+            "2026-10-14T17:46:40.045Z MACOS pid 7 AXMoved w45 AXWindow/AXStandardWindow 230 250 620 460",
+            "2026-10-14T17:46:40.090Z MACOS pid 8 AXResized w41 AXWindow/AXStandardWindow -1480 120 640 420",
+            "2026-10-14T17:46:39.000Z MACOS pid 8 AXMoved w41 AXWindow/AXStandardWindow 1 2 3 4"])
+        write("trace-clock.txt", ["trace-clock a-R3-1-goes %d %d" % (base - 110, base - 90)])
+        two = [{"id": "H", "frame": [-1600, 0, 1600, 900]}, {"id": "A", "frame": [0, 0, 1920, 1080], "main": True}]
+        one = [{"id": "H", "frame": [0, 0, 1600, 900], "main": True}]
+        write("traces/2026-G1.jsonl", [json.dumps(line) for line in [
+            {"displays": two, "settings": {}}, {"t": 9.0, "note": "step 5 display-a-R3-1-goes"}, {"t": 9.9, "note": "clock a-R3-1-goes"},
+            {"t": 10.03, "raw": "AXMoved w45"}, {"t": 10.031, "event": "changed", "user": True, "window": {"id": 45, "frame": [230, 250, 620, 460]}},
+            {"t": 10.032, "call": "displays", "result": two}, {"t": 10.05, "raw": "didChangeScreenParameters"}, {"t": 10.051, "raw": "screens H 0,0 1600x900"},
+            {"t": 10.06, "event": "changed", "user": True, "window": {"id": 41, "frame": [120, 120, 640, 420]}}, {"t": 10.061, "call": "displays", "result": one},
+            {"t": 11.6, "event": "displaysChanged", "to": one}, {"t": 14.0, "note": "step 6 put-x"}]])
+
+        class Lines:
+            def __init__(self):
+                self.text = ""
+
+            def write(self, more):
+                self.text += more
+        lines = Lines()
+        tallies = report(folder, lines)
+        wanted = [
+            "word a-R3-1 goes DESK 45 first-word 50 list-new 60 notice 50 told 1600 | frame 230 250 620 460 numbers new list-at-word old before-list yes before-notice yes",
+            "word a-R3-1 goes TEXT 41 first-word 80 list-new 60 notice 50 told 1600 | frame 120 120 640 420 numbers resting-new list-at-word new before-list no before-notice no",
+            "word a-R3-1 goes WIDE 44 first-word none list-new 60 notice 50 told 1600",
+            "early screens a-R3-1 goes DESK 45 +50 AXMoved frame 230 250 620 460 numbers new list-at-word old before-list yes before-notice yes main-changed yes",
+            "word-reports a-R3-1 goes TEXT 41 first-word 90 list-new 60 notice 50 told 1600 | frame -1480 120 640 420 numbers resting-old list-at-word unknown before-list no before-notice no",
+            "word-trace a-R3-1 goes DESK 45 first-word 31 list-new 51 notice 50 told 1600 | frame 230 250 620 460 numbers new list-at-word old before-list yes before-notice yes",
+            "word-trace a-R3-1 goes TEXT 41 first-word 60 list-new 51 notice 50 told 1600 | frame 120 120 640 420 numbers resting-new list-at-word new before-list no before-notice no",
+            "trace-zero G1 between %.1f and %.1f" % (base - 10010, base - 9990),
+        ]
+        missing = [line for line in wanted if line not in lines.text.split("\n")]
+        for line in missing:
+            print("✘ not printed:", line)
+        if tallies["screens"]["a"] != 1 or tallies["trace"]["a"] != 1 or tallies["reports"]["a"] != 1:
+            missing.append("the tallies")
+            print("✘ the tallies:", tallies)
+        if missing:
+            print(lines.text)
+            return 1
+    print("words-before-the-news.py: its self-test holds")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--self-test"]:
+        sys.exit(self_test())
+    if len(sys.argv) != 2 or not os.path.isfile(os.path.join(sys.argv[1], "changes.txt")):
+        sys.exit(__doc__)
+    report(sys.argv[1])
