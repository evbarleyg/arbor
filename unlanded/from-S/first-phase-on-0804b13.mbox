index 0000000..f38c0c0
--- /dev/null
+++ b/scripts/side-by-side.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+"""Runs the lines of one rule of the Makefile side by side: what `make lint` proves, in a third of the time.
+
+  scripts/side-by-side.py lint           every line of the rule `lint`, as many at a time as there are cores
+  scripts/side-by-side.py --self-test    the rows below
+
+`make lint` is two dozen checks that know nothing of one another, and make runs them one after another: two minutes by now, on
+one core of four. `make gate` and CI's job `linux / lint` run them through this instead. The rule stays where it is and as it
+is: whoever adds a check adds a line to the Makefile, and `make lint` goes on meaning the same.
+
+Every line runs, whatever became of the others, so one round tells all; make stops at the first that fails. What each line
+printed is shown whole and in the order of the rule, as make would have shown it, so two runs can be compared. Then the lines
+that failed are named, with their exit codes, and the slowest, with their seconds. The last line names the tools of this machine: a
+sandbox has the image's git and a runner of GitHub's a newer one, and a check was once green in every sandbox and red on every runner for that.
+
+It reads what make would hand to the shell: a tab, an `@` that is dropped, `$$` for `$`, a line that ends in `\\` goes on in the
+next. What only make can work out (`$(…)`, `${…}`, `$@` and the like, a `-` or `+` in front) it refuses, rather than run something else.
+What the rule depends on is not run: `lint` depends on nothing.
+Exit code 0 when every line passed, 1 when one failed, 2 when the rule cannot be read.
+"""
+
+import concurrent.futures
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ONLY_MAKE_KNOWS = re.compile(r"(?<!\$)(?:\$\$)*\$(?!\$)")
+
+
+class Unreadable(Exception):
+    pass
+
+
+def lines_of(makefile, rule):
+    """The commands of a rule, as the shell gets them."""
+    found = re.search(rf"^{re.escape(rule)}:(?!=)([^\n]*)\n((?:\t[^\n]*\n|#[^\n]*\n)*)", makefile, re.M)
+    if not found:
+        raise Unreadable(f"the Makefile has no rule for {rule}")
+    if found.group(1).split("#")[0].strip():
+        raise Unreadable(f"{rule} depends on{found.group(1).split('#')[0].rstrip()}, which this would not run")
+    commands, going_on = [], False
+    for line in found.group(2).split("\n"):
+        if not line.startswith("\t"):
+            continue
+        text = line[1:]
+        if going_on:
+            commands[-1] += "\n" + text
+        else:
+            commands.append(text)
+        going_on = text.endswith("\\")
+    if not commands:
+        raise Unreadable(f"the rule for {rule} has no lines")
+    for index, command in enumerate(commands):
+        if command[:1] in "-+":
+            raise Unreadable(f"only make knows what to do with the `{command[0]}` before `{command[1:60]}`")
+        command = command[1:] if command.startswith("@") else command
+        if ONLY_MAKE_KNOWS.search(command):
+            raise Unreadable(f"only make knows what the `$` stands for in `{command[:80]}`")
+        commands[index] = command.replace("$$", "$")
+    return commands
+
+
+def run(commands, folder, jobs):
+    """(exit code, output, seconds) of each, in their order."""
+    def one(command):
+        began = time.monotonic()
+        done = subprocess.run(["/bin/sh", "-c", command], cwd=folder, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                              encoding="utf-8", errors="replace", check=False)
+        return done.returncode, done.stdout, time.monotonic() - began
+
+    with concurrent.futures.ThreadPoolExecutor(jobs) as pool:
+        return list(pool.map(one, commands))
+
+
+def tools():
+    """What the checks are run with here, each with its version."""
+    found = []
+    for name in ("git", "python3", "bash", "make"):
+        try:
+            said = subprocess.run([name, "--version"], capture_output=True, text=True, check=False, timeout=10).stdout
+        except (OSError, subprocess.TimeoutExpired):
+            said = ""
+        version = re.search(r"\d+(?:\.\d+)+", said)
+        found.append(f"{name} {version.group() if version else 'is not here'}")
+    return ", ".join(found)
+
+
+def side_by_side(makefile, rule, folder, jobs, out=sys.stdout):
+    try:
+        commands = lines_of(makefile, rule)
+    except Unreadable as error:
+        print(f"✘ side-by-side.py: {error}", file=out)
+        return 2
+    began = time.monotonic()
+    results = run(commands, folder, jobs)
+    for _, output, _ in results:
+        out.write(output)
+    failed = [(command, code) for command, (code, _, _) in zip(commands, results) if code]
+    for command, code in failed:
+        print(f"✘ exit code {code}: {command.splitlines()[0][:150]}", file=out)
+    slowest = sorted(zip(commands, results), key=lambda pair: -pair[1][2])[:3]
+    print(f"{rule}: {len(commands) - len(failed)} of {len(commands)} lines passed in {time.monotonic() - began:.0f} s, {jobs} at a time "
+          f"(one after another: {sum(seconds for _, _, seconds in results):.0f} s); the slowest: "
+          + ", ".join(f"{seconds:.0f} s {command.split('#')[0].strip()[:60]}" for command, (_, _, seconds) in slowest), file=out)
+    print(f"with {tools()}", file=out)
+    return 1 if failed else 0
+
+
+def self_test():
+    import io
+    rows = []
+
+    def read(text, rule="lint"):
+        try:
+            return lines_of(text, rule)
+        except Unreadable as error:
+            return str(error)
+
+    def tried(text, jobs=4):
+        said = io.StringIO()
+        with tempfile.TemporaryDirectory() as folder:
+            code = side_by_side(text, "lint", folder, jobs, said)
+            return code, said.getvalue(), sorted(os.listdir(folder))
+
+    rows += [
+        ("the lines of a rule, without their @", read("a:\n\ttrue\nlint:\n\t@one\n\ttwo --flag\n\nb:\n\tthree\n"), ["one", "two --flag"]),
+        ("a dollar for the shell", read("lint:\n\t@for x in a b; do echo $$x || [ $$? = 2 ]; done\n"), ["for x in a b; do echo $x || [ $? = 2 ]; done"]),
+        ("a remark after a command goes to the shell with it, as make does it", read("lint:\n\t@one  # why\n"), ["one  # why"]),
+        ("a remark of the Makefile's own among the lines", read("lint:\n\t@one\n# why\n\t@two\n"), ["one", "two"]),
+        ("a line that goes on in the next", read("lint:\n\t@one \\\n\t  two\n\t@three\n"), ["one \\\n  two", "three"]),
+        ("the rule ends at an empty line", read("lint:\n\t@one\n\n\t@stray\n"), ["one"]),
+        ("a rule that only begins like it", read("lint-fast:\n\t@one\n"), "the Makefile has no rule for lint"),
+        ("a variable of that name", read("lint:=x\n"), "the Makefile has no rule for lint"),
+        ("no lines", read("lint:\nother:\n\t@one\n"), "the rule for lint has no lines"),
+        ("it depends on something", read("lint: build\n\t@one\n"), "lint depends on build, which this would not run"),
+        ("a remark after the colon is none", read("lint: # all of it\n\t@one\n"), ["one"]),
+        ("a variable of make's", read("lint:\n\t@one $(ARGS)\n"), "only make knows what the `$` stands for in `one $(ARGS)`"),
+        ("the same in braces", read("lint:\n\t@one ${ARGS}\n"), "only make knows what the `$` stands for in `one ${ARGS}`"),
+        ("the target's name", read("lint:\n\t@echo $@\n"), "only make knows what the `$` stands for in `echo $@`"),
+        ("three dollars: one for the shell, one of make's", read("lint:\n\t@echo $$$x\n"), "only make knows what the `$` stands for in `echo $$$x`"),
+        ("four are two for the shell", read("lint:\n\t@echo $$$$\n"), ["echo $$"]),
+        ("a failure that make would overlook", read("lint:\n\t-one\n"), "only make knows what to do with the `-` before `one`"),
+    ]
+    code, said, _ = tried("lint:\n\t@sleep 0.3; echo first\n\t@echo second\n\t@echo third >&2\n")
+    rows.append(("all pass: what they printed, in the order of the rule, whichever ended first", (code, said.split("\n")[:3]), (0, ["first", "second", "third"])))
+    rows.append(("and how it went", "lint: 3 of 3 lines passed in " in said, True))
+    rows.append(("and with what", bool(re.search(r"^with git \d+\.\d+[.\d]*, python3 \d+\.\d+[.\d]*, bash \d+\.\d+[.\d]*, make \d+\.\d+[.\d]*$", said.rstrip("\n").split("\n")[-1])), True))
+    code, said, left = tried("lint:\n\t@echo one; exit 3\n\t@touch ran-all-the-same\n\t@false\n")
+    rows.append(("two fail: the others run all the same, and both are named", (code, left, [line for line in said.split("\n") if line.startswith("✘")]),
+                 (1, ["ran-all-the-same"], ["✘ exit code 3: echo one; exit 3", "✘ exit code 1: false"])))
+    rows.append(("and counted", "lint: 1 of 3 lines passed" in said, True))
+    began = time.monotonic()
+    code, _, _ = tried("lint:\n" + "\t@sleep 1\n" * 4)
+    rows.append(("they do run side by side, also on a machine that is busy", (code, time.monotonic() - began < 3), (0, True)))
+    began = time.monotonic()
+    tried("lint:\n" + "\t@sleep 0.3\n" * 4, jobs=1)
+    rows.append(("and no more at a time than was said", time.monotonic() - began > 1.1, True))
+    rows.append(("a line that waits for the keyboard gets none", tried("lint:\n\t@cat\n")[0], 0))
+    rows.append(("a rule that cannot be read: nothing runs", tried("lint:\n\t@touch ran\n\t@echo $(X)\n")[::2], (2, [])))
+    with open(os.path.join(ROOT, "Makefile"), encoding="utf-8") as handle:
+        real = read(handle.read())
+    rows.append(("the real rule can be read, and is long", isinstance(real, list) and len(real) > 15, True))
+
+    wrong = 0
+    for what, got, expected in rows:
+        if got != expected:
+            wrong += 1
+            print(f"✘ {what}: expected {expected!r}, got {got!r}")
+    print(f"{len(rows) - wrong} of {len(rows)} side-by-side situations came out as expected")
+    return 1 if wrong else 0
+
+
+def main(arguments):
+    if arguments == ["--self-test"]:
+        return self_test()
+    if len(arguments) != 1 or arguments[0].startswith("-"):
+        print(__doc__.split("\n\n")[1])
+        return 2
+    with open(os.path.join(ROOT, "Makefile"), encoding="utf-8") as handle:
+        makefile = handle.read()
+    return side_by_side(makefile, arguments[0], ROOT, len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else os.cpu_count() or 1)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
