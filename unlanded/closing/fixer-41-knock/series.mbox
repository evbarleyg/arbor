-      let answer: Keyboard = focused.map { .window($0?.windowID) } ?? .unanswered
       if state.isStillAwaited(now: answer) {
         done.signal()
       } else {
@@ -74,7 +79,8 @@ final class AXKnocks: @unchecked Sendable {
         }
       }
     }
-    _ = done.wait(timeout: .now() + max(patience, 0))
