diff --git a/scripts/mac-on-linux/tests/BusyApps.swift b/scripts/mac-on-linux/tests/BusyApps.swift
new file mode 100644
index 00000000..ff1ce19d
--- /dev/null
+++ b/scripts/mac-on-linux/tests/BusyApps.swift
@@ -0,0 +1,76 @@
+import ArborCore
+@testable import ArborKit
+import CoreGraphics
+import FakeMacOS
+import Foundation
+
+// Apps that are busy rather than hung: they work for a while, attend for a moment, and work again. They answer every call, late. What holds Arbor up then is not the moves but what it READS
+// on the main thread when the app's notifications arrive.
+//
+// Measured on a hosted Mac (`origin/mac-shell-out/hang.after`, check-hang.sh, session 6, a test app busy 0.7 s at a time): `arrange` took Arbor 67 ms; then one "focused window changed" of the busy app held
+// the main thread for 1.5 s (AXFullScreen 1.0 s, a whole timeout; AXFocusedWindow 0.66 s), the reply to `arrange` came after 1.64 s, and the OTHER app's reports of Arbor's own moves, served after that,
+// passed for the person's doing.
+
+extension FakeMac {
+  /// From now on, for `seconds`: the app works `work` seconds at a time, with `attention` between.
+  func keepsBusy(_ app: App, work: TimeInterval = 0.7, attention: TimeInterval = 0.03, for seconds: TimeInterval) {
+    guard seconds > 0 else { return }
+    hang(app, for: work)
+    // One after the other: what one source sends arrives in the order it was sent, so a wake would wait behind every burst that was foretold.
+    later(work + attention) { [self] in keepsBusy(app, work: work, attention: attention, for: seconds - work - attention) }
+  }
+}
+
+@MainActor
+func tellOfBusyApps(_ book: Book) {
+  // Every command asks which window has the keyboard, several times over, and the app in front is the one that is asked. On the hosted Mac a plain `state` took 0.42 s that way.
+  book.story("the app in front is busy 0.7 s at a time, and Arbor is given a command every 0.4 s") { story in
+    var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+    let two = StoreyTwo(story) { mac in
+      mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+      let busy = mac.launch("Busy")
+      theirs = [mac.open("a", in: busy, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: busy, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+    }
+    story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+    story.check("the busy app is in front", two.mac.frontmost === theirs[0].app)
+    two.mac.keepsBusy(theirs[0].app, for: 12)
+    two.mac.pass(0.1)
+    var slowest = (text: "", seconds: 0.0)
+    // None of them moves a window of the busy app: what they cost is what Arbor asks.
+    for command in ["state", "status", "state", "ascii", "state", "status", "state", "ascii"] {
+      let began = two.mac.now
+      _ = two.run(command, then: 0)
+      if two.mac.now - began > slowest.seconds { slowest = (command, two.mac.now - began) }
+      two.mac.pass(0.4)
+    }
+    story.check("each is answered within a tenth of a second", slowest.seconds <= 0.1, "`\(slowest.text)` took \(slowest.seconds) s")
+    let key = two.mac.keyWindow
+    story.check("and Arbor still knows which window has the keyboard", key != nil && two.layer.focusedWindow()?.rawValue == key?.number, "\(String(describing: two.layer.focusedWindow()))")
+  }
+
+  for first in [0.0, 0.02, 0.2, 0.5] {
+    book.story("an app is busy 0.7 s at a time, and \(first) s into its work its windows are arranged with another's") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        let busy = mac.launch("Busy")
+        theirs = [mac.open("a", in: busy, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: busy, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+      }
+      two.mac.keepsBusy(theirs[0].app, for: 12)
+      two.mac.pass(first)
+      two.heard.clear()
+      // The layer's own count of its calls, by thread. What the main thread waits for the lanes, its patience with a move, is another matter.
+      func inCalls() -> (total: Double, worst: Double) { CallStats.shared["accessibility calls by thread", "main thread"].map { ($0.total, $0.worst) } ?? (0, 0) }
+      CallStats.shared.reset()
+      let began = two.mac.now
+      story.check("Arbor takes the command", two.run("arrange", then: 0).ok)
+      story.check("and answers within 0.6 s", two.mac.now - began <= 0.6, "\(two.mac.now - began) s")
+      two.mac.pass(6)
+      story.check("in all that, and the six seconds that follow, its main thread spends 0.1 s at most in calls to apps", inCalls().total <= 0.1, "\(inCalls().total) s, the longest \(inCalls().worst) s")
+      two.mac.pass(10)
