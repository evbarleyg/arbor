@@ -0,0 +1,43 @@
+import ApplicationServices
+import Dispatch
+import Foundation
+
+/// Finds out, off the main thread, whether an app attends.
+///
+/// Whatever Arbor reads of an app it reads with a call that waits for the app's main thread. An app that hangs lets it wait a whole timeout,
+/// and one that is busy, which is every app now and then (loading, laying out, flying to the Dock), for as long as it is busy. What Arbor reads
+/// when an app's notifications arrive it reads on its own main thread, where its person's next key waits with it: on a hosted Mac one
+/// "focused window changed" of an app that was busy 0.7 s at a time held Arbor up for 1.5 s.
+///
+/// So somebody else knocks first: one cheap question, on a queue of the app's own, and the reading begins on the main thread when it has been
+/// answered. That is the moment the app attends, and what is asked at that moment is served at once (seen on the same Mac: the calls that
+/// followed a read that had waited for the app were all answered within milliseconds). Nothing is promised about the moment after.
+///
+/// Not on the app's lane (`AppLanes`): a lane that is busy turns moves away, and a knock is no reason for that.
+final class AXKnocks: @unchecked Sendable {
+  private let lock = NSLock()
+  private var doors: [pid_t: DispatchQueue] = [:]
+
+  /// `then` is called on the main thread, with whether the app answered. One that is gone fails at once, which is an answer.
+  func knock(at pid: pid_t, then: @escaping @MainActor @Sendable (_ attends: Bool) -> Void) {
+    lock.lock()
+    let door = doors[pid] ?? DispatchQueue(label: "dev.arbor.knock.\(pid)", qos: .userInteractive)
+    doors[pid] = door
+    lock.unlock()
+    door.async {
+      // This queue alone uses the element. It waits as long as every element made on the fly: the whole process's timeout.
+      let app = AXUIElementCreateApplication(pid)
+      let unanswered = AXCalls.wentUnanswered { app.read(kAXRoleAttribute).error }
+      DispatchQueue.main.async {
+        MainActor.assumeIsolated { then(!unanswered) }
+      }
+    }
+  }
+
+  /// Forgets an app that quit.
+  func forget(_ pid: pid_t) {
+    lock.lock()
+    defer { lock.unlock() }
+    doors[pid] = nil
+  }
+}
