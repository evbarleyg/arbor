--- a/Sources/ArborKit/AX/AXKnocks.swift
+++ b/Sources/ArborKit/AX/AXKnocks.swift
@@ -58,14 +58,19 @@ final class AXKnocks: @unchecked Sendable {
     door(of: pid).async {
       // This queue alone uses these elements.
       let app = AXUIElementCreateApplication(pid)
-      var focused: AXUIElement??
+      var answer = Keyboard.unanswered
       let unanswered = AXCalls.wentUnanswered {
-        focused = app.elementIfAnswered(kAXFocusedWindowAttribute)
-        return focused == nil ? .cannotComplete : .success
+        guard let focused = app.elementIfAnswered(kAXFocusedWindowAttribute) else { return .cannotComplete }
