diff --git a/scripts/mac-on-linux/tests/BusyAppsAndStrangers.swift b/scripts/mac-on-linux/tests/BusyAppsAndStrangers.swift
new file mode 100644
index 00000000..5926e301
--- /dev/null
+++ b/scripts/mac-on-linux/tests/BusyAppsAndStrangers.swift
@@ -0,0 +1,363 @@
+import ArborCore
+@testable import ArborKit
+import CoreGraphics
+import FakeMacOS
+import Foundation
+
+// Busy apps, third part: what a second adversarial reader found in "who has the keyboard is asked off the main thread", and what holds the cures.
+//
+// Its four large finds have one root. Reports wait behind a door until their app attends, and a question about the keyboard does not: so a command could be told of a window
+// that the controller had not heard of yet, or of one that shows no more. Where the keyboard of the app in front goes to a window that nobody has been told of, the report is
+// now waited for in its own turn, as every report used to be, for one timeout at most; everywhere else nothing is waited for.
+
+@MainActor
+func tellOfBusyAppsAndStrangers(_ book: Book) {
+  /// A window of mine and one of another app, which is in front, both docked.
+  func arranged(_ story: Story, theirsInFront: Bool = true) -> (two: StoreyTwo, mine: FakeMac.Window, theirs: FakeMac.Window) {
+    var mine: FakeMac.Window!, theirs: FakeMac.Window!
+    let two = StoreyTwo(story) { mac in
+      if !theirsInFront { theirs = mac.open("theirs", in: mac.launch("Notes"), frame: CGRect(x: 500, y: 60, width: 400, height: 300)) }
+      mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+      if theirsInFront { theirs = mac.open("theirs", in: mac.launch("Notes"), frame: CGRect(x: 500, y: 60, width: 400, height: 300)) }
+    }
+    story.check("two windows are arranged", two.run("arrange", then: 2).ok && [theirs!, mine!].allSatisfy { two.isDocked($0) })
+    return (two, mine, theirs)
+  }
+  func state(_ two: StoreyTwo) -> String { "\(two.controller.snapshot().windows.map { "\($0.id) \($0.docked ? "docked" : "floats")" })" }
+
+  // MARK: A door that is shut during a pause
+
+  // The later looks at a new element are booked by a timer, which fires whether or not the layer runs. The door it shut was opened by nobody, and after the pause
+  // everything about the app queued up behind it.
+  for (subrole, gap) in [("AXDialog", 0.1), ("AXUnknown", 0.1), ("AXDialog", 0.4)] {
+    book.story("an app opens a panel (\(subrole)), Arbor's layer is stopped \(gap) s later and started a second after that") { story in
+      var windows: [FakeMac.Window] = []
+      let one = StoreyOne(story) { mac in
+        let app = mac.launch("Notes")
+        windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+      }
+      _ = one.mac.open("Saving…", in: windows[0].app, frame: CGRect(x: 150, y: 150, width: 300, height: 100), subrole: subrole, takesKeyboard: false)
+      one.mac.pass(gap)
+      one.layer.stop()
+      one.mac.pass(1)
+      one.layer.start()
+      one.mac.pass(2)
+      one.heard.clear()
+      one.mac.appMoves(windows[0], to: CGRect(x: 120, y: 200, width: 400, height: 300))
+      one.mac.pass(3)
+      story.check("a window that its app then moves is reported", one.heard.all.contains(.changed(windows[0].number, byUser: true)), one.heard.texts)
+      let new = one.mac.open("new", in: windows[0].app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+      one.mac.pass(3)
+      story.check("a window that it then opens is announced", one.heard.all.contains(.appeared(new.number)), one.heard.texts)
+      one.mac.appMakesKey(windows[1])
+      one.mac.pass(3)
+      story.check("the window that then gets the keyboard is reported", one.heard.all.contains(.focused(windows[1].number)), one.heard.texts)
+    }
+  }
+  book.story("an app opens a panel, Arbor is paused 0.1 s later and resumed two seconds after that") { story in
+    let (two, _, theirs) = arranged(story)
+    _ = two.mac.open("Saving…", in: theirs.app, frame: CGRect(x: 550, y: 150, width: 300, height: 100), subrole: "AXDialog", takesKeyboard: false)
+    two.mac.pass(0.1)
+    story.check("Arbor pauses", two.run("pause", then: 2).ok)
+    story.check("and resumes", two.run("resume", then: 3).ok)
+    two.heard.clear()
+    let new = two.mac.open("new", in: theirs.app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+    two.mac.pass(3)
+    story.check("a window that the app then opens is announced", two.heard.all.contains(.appeared(new.number)), two.heard.texts)
+    two.mac.appMakesKey(theirs)
+    two.mac.pass(3)
+    story.check("the window that then gets the keyboard is reported", two.heard.all.contains(.focused(theirs.number)), two.heard.texts)
+  }
+
+  // What is served from behind the door is reported, and whoever hears a report may stop the layer there and then.
+  book.story("a window is renamed, its app is busy for 0.7 s and comes forward, and Arbor's layer is stopped by whoever hears of the new name") { story in
+    var behind: FakeMac.Window!, front: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      behind = mac.open("behind", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+      front = mac.open("front", in: mac.launch("Mail"), frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    }
+    one.mac.activate(behind.app)
+    one.mac.pass(1)
+    one.mac.activate(front.app)
+    one.mac.pass(1)
+    var heardAtTheStop: Int?
+    one.heard.onEvent = { event in
+      guard case .changed(behind.number, _) = event, heardAtTheStop == nil else { return }
+      one.layer.stop()
+      heardAtTheStop = one.heard.everything.count
+    }
+    one.mac.rename(behind, "another name")
+    one.mac.later(0.0005) { one.mac.hang(behind.app, for: 0.7) }
+    one.mac.later(0.001) { one.mac.activate(behind.app) }
+    one.mac.pass(4)
+    story.check("the layer was stopped", heardAtTheStop != nil, one.heard.texts)
+    story.check("and has reported nothing since", one.heard.everything.count == heardAtTheStop, one.heard.texts)
+  }
+
+  // MARK: The keyboard goes to a window that nobody has been told of
+
+  // ⌘N or ⌘T, and a key of Arbor's while the app loads what goes into the new window. The key is meant for that window.
+  for busy in [0.0, 0.7] {
+    book.story("the app in front opens a new window, is busy for \(busy) s, and 0.1 s later Arbor is told to dock the window that has the keyboard") { story in
+      let (two, _, theirs) = arranged(story)
+      theirs.app.reportsFocusBeforeCreated = true
+      let new = two.mac.open("new", in: theirs.app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+      if busy > 0 { two.mac.later(0.0005) { two.mac.hang(theirs.app, for: busy) } }
+      two.mac.pass(0.1)
+      let result = two.run("dock left", then: 4)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("in the end the new window is docked", two.isDocked(new), state(two))
+    }
+    book.story("the app in front opens a new tab, is busy for \(busy) s, and 0.1 s later Arbor is told to float the window that has the keyboard") { story in
+      let (two, mine, theirs) = arranged(story)
+      theirs.app.reportsFocusBeforeCreated = true
+      let new = two.mac.newTab(of: theirs)
+      if busy > 0 { two.mac.later(0.0005) { two.mac.hang(theirs.app, for: busy) } }
+      two.mac.pass(0.1)
+      let result = two.run("float", then: 4)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("in the end the new one floats", two.controller.snapshot().windows.contains { $0.id.rawValue == new.number && !$0.docked }, state(two))
+      story.check("and `mine` is docked as before", two.isDocked(mine), state(two))
+    }
+    // Opening a file from Finder, a link from a mail. What the app said before, of another window, is no longer so.
+    book.story("an app in the background opens a window and comes forward with it, is busy for \(busy) s, and 0.1 s later Arbor is told to float the window that has the keyboard") { story in
+      let (two, mine, theirs) = arranged(story, theirsInFront: false)
+      two.mac.activate(theirs.app)
+      two.mac.pass(1)
+      two.mac.activate(mine.app)
+      two.mac.pass(1)
+      theirs.app.reportsFocusBeforeCreated = true
+      let new = two.mac.open("new", in: theirs.app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+      two.mac.activate(theirs.app)
+      if busy > 0 { two.mac.later(0.0005) { two.mac.hang(theirs.app, for: busy) } }
+      two.mac.pass(0.1)
+      _ = two.run("float", then: 4)
+      story.check("the window it had before is docked as before", two.isDocked(theirs), state(two))
+      story.check("and Arbor knows the new one", two.controller.snapshot().windows.contains { $0.id.rawValue == new.number }, state(two))
+    }
+    // A native tab that is chosen is reported as the main window and nothing else.
+    book.story("another tab of a docked window is chosen, its app is busy for \(busy) s, and 0.1 s later Arbor is told to float the window that has the keyboard") { story in
+      var mine: FakeMac.Window!, window: FakeMac.Window!
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        window = mac.open("window", in: mac.launch("Safari"), frame: CGRect(x: 500, y: 60, width: 400, height: 300))
+      }
+      let tab = two.mac.newTab(of: window)
+      two.mac.pass(2)
+      story.check("two windows are arranged", two.run("arrange", then: 2).ok && two.isDocked(tab) && two.isDocked(mine), state(two))
+      two.heard.clear()
+      two.mac.chooseTab(window)
+      if busy > 0 { two.mac.later(0.0005) { two.mac.hang(window.app, for: busy) } }
+      two.mac.pass(0.1)
+      let result = two.run("float", then: 4)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("no tab is announced as a window of its own", !two.heard.all.contains(.appeared(window.number)) && !two.heard.all.contains(.found(window.number)), two.heard.texts)
+      let known = two.layer.allWindows().map(\.id.rawValue).sorted()
+      story.check("Arbor knows the tab that shows, and not the other", known == [mine.number, window.number].sorted(), "\(known)")
+      story.check("the tab that shows floats", two.controller.snapshot().windows.contains { $0.id.rawValue == window.number && !$0.docked }, state(two))
+      story.check("and shows", two.isInView(window), two.whereabouts(window))
+    }
+    book.story("the tab in front of a docked window closes, its app is busy for \(busy) s, and 0.1 s later Arbor is told to float the window that has the keyboard") { story in
+      var mine: FakeMac.Window!, window: FakeMac.Window!
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        window = mac.open("window", in: mac.launch("Safari"), frame: CGRect(x: 500, y: 60, width: 400, height: 300))
+      }
+      let tab = two.mac.newTab(of: window)
+      two.mac.pass(2)
+      story.check("two windows are arranged", two.run("arrange", then: 2).ok && two.isDocked(tab) && two.isDocked(mine), state(two))
+      two.heard.clear()
+      two.mac.close(tab)
+      if busy > 0 { two.mac.later(0.0135) { two.mac.hang(window.app, for: busy) } }
+      two.mac.pass(0.1)
+      let result = two.run("float", then: 4)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("the tab that shows now takes the place of the one that closed", two.heard.all.contains(.replaced(tab.number, by: window.number)), two.heard.texts)
+      story.check("it floats", two.controller.snapshot().windows.contains { $0.id.rawValue == window.number && !$0.docked }, state(two))
+    }
+  }
+
+  // What that costs when the app does not come back: one timeout, whatever is asked next and however often. A new window is reported three times over.
+  for command in ["state", "float", "arrange"] {
+    book.story("the app in front opens a window and hangs for 20 s half a millisecond later, and 0.1 s after that Arbor is told to `\(command)`") { story in
+      let (two, _, theirs) = arranged(story)
+      theirs.app.reportsFocusBeforeCreated = true
+      CallStats.shared.reset()
+      let (start, waited) = (two.mac.now, two.mac.secondsTheMainThreadWaited)
+      _ = two.mac.open("new", in: theirs.app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+      two.mac.later(0.0005) { two.mac.hang(theirs.app, for: 20) }
+      two.mac.pass(0.1)
+      _ = two.run(command, then: 0)
+      story.check("the command is answered within 1.2 s of the opening", two.mac.now - start <= 1.2, "\(two.mac.now - start) s")
+      two.mac.pass(5)
+      let really = two.mac.secondsTheMainThreadWaited - waited
+      story.check("Arbor's main thread waits for one timeout at most", really <= 1.1, "\(really) s")
+      // Waiting for another thread's call is no call of this thread's, and stands still all the same.
+      func total(_ group: String, _ name: String) -> Double { CallStats.shared[group, name]?.total ?? 0 }
+      let onTheBooks = total("accessibility calls by thread", "main thread") + total("window system", "wait for the apps to move") + total("window system", "wait for an app to say who has the keyboard")
+      story.check("and Arbor's statistics account for it, to within a tenth of a second", abs(really - onTheBooks) <= 0.1, "it waited \(really) s, and they have \(onTheBooks) s")
+    }
+  }
+  book.story("the app in front opens a window and hangs half a millisecond later, and Arbor's layer is asked five times in a row who has the keyboard") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    window.app.reportsFocusBeforeCreated = true
+    let began = one.mac.now
+    _ = one.mac.open("new", in: window.app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    one.mac.later(0.0005) { one.mac.hang(window.app, for: 20) }
+    one.mac.pass(0.1)
+    for _ in 0..<5 { _ = one.layer.focusedWindow() }
+    story.check("all in all that takes 1.2 s at most", one.mac.now - began <= 1.2, "\(one.mac.now - began) s")
+  }
+  // The question stands behind a knock that goes unanswered. The thread that waits for it cannot hear of the knock meanwhile.
+  book.story("a window of the app in front, which has never said who has its keyboard, is renamed, the app hangs half a millisecond later, and Arbor's layer is asked five times in a row who has it") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    one.mac.rename(window, "another name")
+    one.mac.later(0.0005) { one.mac.hang(window.app, for: 20) }
+    one.mac.pass(0.1)
+    let began = one.mac.now
+    for _ in 0..<5 { _ = one.layer.focusedWindow() }
+    story.check("the five together take 1.2 s at most", one.mac.now - began <= 1.2, "\(one.mac.now - began) s")
+  }
+
+  // Nobody's next key is meant for a window of an app in the background.
+  book.story("an app in the background opens a window and hangs for 5 s half a millisecond later") { story in
+    var behind: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      behind = mac.open("behind", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+      _ = mac.open("front", in: mac.launch("Mail"), frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    }
+    let waited = one.mac.secondsTheMainThreadWaited
+    let new = one.mac.open("new", in: behind.app, frame: CGRect(x: 300, y: 300, width: 400, height: 300))
+    one.mac.later(0.0005) { one.mac.hang(behind.app, for: 5) }
+    one.mac.pass(9)
+    story.check("Arbor's main thread has not waited for the app", one.mac.secondsTheMainThreadWaited - waited < 0.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+    story.check("in the end Arbor knows the new window", one.known.contains(new.number), "\(one.known)")
+  }
+
+  // Of an app that is busy moving its windows nothing is read when it attends, so there is nothing to wait for. And it has not given the keyboard away.
+  book.story("Arbor moves a window of an app that takes 0.3 s over every call, and meanwhile the app opens another") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    story.check("to begin with the window has the keyboard", one.layer.focusedWindow()?.rawValue == window.number)
+    window.app.answersIn = 0.3
+    _ = one.layer.setFrame(CGRect(x: 40, y: 60, width: 500, height: 400), of: WindowID(window.number))
+    story.check("the move is still under way", window.frame != CGRect(x: 40, y: 60, width: 500, height: 400), "\(window.frame)")
+    let waited = one.mac.secondsTheMainThreadWaited
+    story.check("the window has the keyboard still", one.layer.focusedWindow()?.rawValue == window.number, "\(String(describing: one.layer.focusedWindow()))")
+    _ = one.mac.open("new", in: window.app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    one.mac.pass(0.1)
+    story.check("Arbor's main thread has not waited for the app", one.mac.secondsTheMainThreadWaited - waited < 0.05, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+  }
+
+  // MARK: An app of which nothing is known
+
+  for command in ["arrange", "float", "state", "zoom", "focus left"] {
+    book.story("an app that has not been in front since Arbor started hangs and is switched to, and 0.1 s later Arbor is told to `\(command)`") { story in
+      let (two, _, theirs) = arranged(story, theirsInFront: false)
+      two.mac.hang(theirs.app, for: 30)
+      two.mac.pass(0.5)
+      let start = two.mac.now
+      two.mac.activate(theirs.app)
+      two.mac.pass(0.1)
+      _ = two.run(command, then: 0)
+      story.check("the key is answered within 1.2 s of the switch", two.mac.now - start <= 1.2, "\(two.mac.now - start) s")
+    }
+  }
+  // From the polite walk (`polite|955|click 52 18; hang 77 20; hide 63 88 +0.3; arborFocuses 89 67`).
+  book.story("an app that has not been in front since Arbor started hangs and comes forward, and 0.3 s later Arbor's layer is asked to give its window the keyboard") { story in
+    var theirs: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      theirs = mac.open("theirs", in: mac.launch("Hung"), frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+      _ = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+    }
+    one.mac.hang(theirs.app, for: 10)
+    one.mac.pass(1)
+    one.heard.clear()
+    let waited = one.mac.secondsTheMainThreadWaited
+    one.mac.activate(theirs.app)
+    one.mac.pass(0.3)
+    one.layer.focus(WindowID(theirs.number))
+    one.mac.pass(4)
+    story.check("Arbor's main thread waits for it for one timeout at most", one.mac.secondsTheMainThreadWaited - waited <= 1.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+    one.mac.pass(8)
+    story.check("when the app has woken its window is reported to have the keyboard", one.heard.all.contains(.focused(theirs.number)), one.heard.texts)
+  }
+  // "A window, but it did not say which" is not "none".
+  book.story("an app that has never said who has its keyboard answers which window has it, and hangs for 3 s before it has said the window's number") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    window.app.hangsAfterCalls = 1
+    one.mac.later(3) { one.mac.wake(window.app) }
+    _ = one.layer.focusedWindow()
+    one.mac.pass(6)
+    one.mac.keepsBusy(window.app, for: 3)
+    one.mac.pass(0.1)
+    story.check("later, when the app is busy, the answer is the window that has it all along", one.layer.focusedWindow()?.rawValue == window.number, "\(String(describing: one.layer.focusedWindow()))")
+  }
+
+  // MARK: What an app last said
+
+  // After its last window an app says nothing more about the keyboard.
+  for (name, act) in [("closes", { (mac: FakeMac, w: FakeMac.Window) in mac.close(w) }), ("is minimized", { mac, w in mac.minimize(w) })] {
+    book.story("the only window of the app in front \(name), the app is then busy 0.7 s at a time, and Arbor's layer is asked who has the keyboard") { story in
+      var window: FakeMac.Window!
+      let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+      story.check("to begin with it has it", one.layer.focusedWindow()?.rawValue == window.number)
+      act(one.mac, window)
+      one.mac.pass(0.6)
+      one.mac.keepsBusy(window.app, for: 5)
+      one.mac.pass(0.1)
+      story.check("nobody has it", one.layer.focusedWindow() == nil, "\(String(describing: one.layer.focusedWindow()))")
+    }
+  }
+  // An app that answers is believed, however slowly it answers within reason: two calls of 20 ms. What it last said is for one that does not.
+  book.story("the keyboard goes to another window of an app that takes 20 ms over every call and whose reports are 0.5 s late, and 0.2 s later Arbor's layer is asked who has it") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    story.check("to begin with the second has it", one.layer.focusedWindow()?.rawValue == windows[1].number)
+    windows[0].app.answersIn = 0.02
+    windows[0].app.reportsLateBy = 0.5
+    one.mac.appMakesKey(windows[0])
+    one.mac.pass(0.2)
+    story.check("the first has it", one.layer.focusedWindow()?.rawValue == windows[0].number, "\(String(describing: one.layer.focusedWindow()))")
+  }
+  // Of one that is known not to answer nobody knows. A ring drawn on the strength of what it last said would stay for as long as it hangs.
+  book.story("the app in front hangs for 10 s, and Arbor's layer is asked who has the keyboard at once and two seconds later") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    story.check("to begin with its window has it", one.layer.focusedWindow()?.rawValue == window.number)
+    one.mac.hang(window.app, for: 10)
+    story.check("at once: the window that had it, for all anybody knows", one.layer.focusedWindow()?.rawValue == window.number)
+    one.mac.pass(2)
+    story.check("two seconds later: nobody knows", one.layer.focusedWindow() == nil, "\(String(describing: one.layer.focusedWindow()))")
+  }
+
+  // Gone it is, also when the report of that finds the door shut by another.
+  book.story("an app has a window with two tabs and a plain one; the plain one closes, the app renames the other as it goes, and hangs for 5 s as both reports are on their way") { story in
+    var tabbed: FakeMac.Window!, plain: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      tabbed = mac.open("tabbed", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+      plain = mac.open("plain", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    }
+    let tab = one.mac.newTab(of: tabbed)
+    one.mac.pass(2)
+    one.mac.click(plain)
+    one.mac.pass(2)
+    one.heard.clear()
+    one.mac.close(plain)
+    // "Destroyed" is posted 12 ms after the window begins to go, and every report is 2 ms on its way.
+    one.mac.later(0.0115) { one.mac.rename(tab, "another name") }
+    one.mac.pass(0.013)
+    one.mac.hang(plain.app, for: 5)
+    one.mac.pass(2)
+    story.check("it is reported gone within two seconds", one.heard.all.contains(.destroyed(plain.number)), one.heard.texts)
+    one.mac.pass(7)
+    story.check("once", one.heard.all.filter { $0 == .destroyed(plain.number) }.count == 1, one.heard.texts)
+  }
+}
