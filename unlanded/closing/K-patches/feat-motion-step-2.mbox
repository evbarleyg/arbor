+  /// How much of the way is done when `time` of the time is up, both from 0 to 1: `curve` as a function. Core Animation
+  /// works this out for itself. It is for whoever draws a moment of a motion without it.
+  public static func progress(at time: Double) -> Double {
+    guard time.isFinite, time > 0 else { return 0 }
+    guard time < 1 else { return 1 }
+    func bezier(_ a: Double, _ b: Double, _ t: Double) -> Double {
+      let u = 1 - t
+      return 3 * u * u * t * a + 3 * u * t * t * b + t * t * t
+    }
+    // x grows with t, so halving the interval finds the t that belongs to `time`.
+    var (low, high) = (0.0, 1.0)
+    for _ in 0..<40 {
+      let middle = (low + high) / 2
+      if bezier(curve.x1, curve.x2, middle) < time { low = middle } else { high = middle }
+    }
+    return bezier(curve.y1, curve.y2, (low + high) / 2)
