+    let second = Transition(display: DisplayID("main"), frame: screen, duration: 0.46, items: [other, one], holes: [bar, box])
+    #expect(!first.endsLike(second) && first.endsLike(second, inAnyOrder: true))
+    first.items[0].to = right
+    #expect(!first.endsLike(second, inAnyOrder: true))
+    first.items[0].to = middle
+    first.holes[0] = box.offsetBy(dx: 5, dy: 0)
+    #expect(!first.endsLike(second, inAnyOrder: true))
+  }
+}
