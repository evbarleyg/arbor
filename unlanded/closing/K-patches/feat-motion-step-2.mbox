diff --git a/Sources/ArborCore/WallpaperFit.swift b/Sources/ArborCore/WallpaperFit.swift
new file mode 100644
index 00000000..fa074565
--- /dev/null
+++ b/Sources/ArborCore/WallpaperFit.swift
@@ -0,0 +1,28 @@
+/// How macOS lays a wallpaper's file on a display: what System Settings calls Fill Screen, Fit to Screen, Stretch to Fill
+/// Screen and Centre. Whoever draws the file in the wallpaper's place has to lay it the same way, or the Desktop
+/// changes for as long as that lasts.
+public enum WallpaperFit: String, Equatable, Sendable {
+  /// Scaled in proportion until it covers the display; what hangs over is cut off.
+  case fill
+  /// Scaled in proportion until all of it shows; the fill colour shows beside it.
+  case fit
+  /// Scaled to the display's width and height, out of proportion.
+  case stretch
+  /// At its own size, in the middle, over the fill colour.
+  case centre
+
+  /// From the options macOS reports for a display (`NSWorkspace.desktopImageOptions(for:)`).
+  ///
+  /// - Parameters:
+  ///   - scaling: the raw value of `NSImageScaling`: 0 in proportion but only down, 1 each axis by itself, 2 not at
+  ///     all, 3 in proportion up or down. Nil, or a number that means nothing, counts as 3, as the documentation says.
+  ///   - allowsClipping: whether a picture scaled in proportion may be cut off. Nil counts as true: Fill Screen is what a
+  ///     Mac has until somebody changes it.
+  public init(scaling: UInt?, allowsClipping: Bool?) {
+    switch scaling {
+    case 1: self = .stretch
+    case 2: self = .centre
+    default: self = allowsClipping ?? true ? .fill : .fit
+    }
+  }
+}
