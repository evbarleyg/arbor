diff --git a/Tests/ArborCoreTests/TransitionHolesTests.swift b/Tests/ArborCoreTests/TransitionHolesTests.swift
new file mode 100644
index 00000000..3c75473d
--- /dev/null
+++ b/Tests/ArborCoreTests/TransitionHolesTests.swift
@@ -0,0 +1,255 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+import Testing
+
+private let screen = CGRect(x: 0, y: 0, width: 1440, height: 900)
+private let a = WindowID(1)
+private let b = WindowID(2)
+private let c = WindowID(3)
+/// Windows Arbor knows nothing about.
+private let dialog = WindowID(90)
+private let panel = WindowID(91)
+
+private let left = CGRect(x: 12, y: 37, width: 464, height: 851)
+private let middle = CGRect(x: 488, y: 37, width: 464, height: 851)
+private let right = CGRect(x: 964, y: 37, width: 464, height: 851)
+
+private func still(_ window: WindowID, _ frame: CGRect, pid: Int32 = 0) -> Transition.Item {
+  Transition.Item(window: window, from: frame, to: frame, pid: pid)
+}
+
+private func moving(_ window: WindowID, _ from: CGRect, _ to: CGRect, pid: Int32 = 0) -> Transition.Item {
+  Transition.Item(window: window, from: from, to: to, pid: pid)
+}
+
+/// `items` with the stage left open for `stack`, frontmost first. Known windows are listed where they really are by
+/// then, which is where they end.
+private func opened(
+  _ items: [Transition.Item], stack: [StackedWindow], known: Set<WindowID> = [a, b, c],
+  inFlight: [WindowID: CGRect] = [:]
+) -> Transition {
+  var transition = Transition(display: DisplayID("main"), frame: screen, duration: 0.46, items: items)
+  transition.leaveOpen(stack: stack, known: known, inFlight: inFlight)
+  return transition
+}
+
+private func listed(_ item: Transition.Item) -> StackedWindow {
+  StackedWindow(id: item.window, frame: item.from, pid: item.pid)
+}
+
+/// Where the stage stays open (`Transition.leaveOpen`), so that what takes no part in a motion is seen live.
+@Suite struct TransitionHolesTests {
+  // MARK: Windows Arbor does not know
+
+  @Test func aStrangerInFrontIsLeftOpen() {
+    let box = CGRect(x: 500, y: 300, width: 400, height: 200)
+    let mover = moving(a, left, middle)
+    let result = opened([mover], stack: [StackedWindow(id: dialog, frame: box), listed(mover)])
+    #expect(result.holes == [box])
+    #expect(result.items == [mover], "what passes behind it is drawn as before")
+  }
+
+  @Test func aStrangerThatAMovingWindowInFrontCrossesIsCovered() {
+    let box = CGRect(x: 500, y: 300, width: 400, height: 200)
+    let mover = moving(a, left, right)
+    #expect(opened([mover], stack: [listed(mover), StackedWindow(id: dialog, frame: box)]).holes.isEmpty)
+    // One that keeps clear of it does no harm.
+    let shy = moving(a, left, left.offsetBy(dx: 0, dy: 20))
+    #expect(opened([shy], stack: [listed(shy), StackedWindow(id: dialog, frame: box)]).holes == [box])
+  }
+
+  @Test func aWindowThatLeavesTheDisplayStillCrossesWhatIsOnItsWay() {
+    let box = CGRect(x: 1000, y: 300, width: 300, height: 200)
+    let leaving = moving(a, left, left.offsetBy(dx: 1500, dy: 0))
+    #expect(opened([leaving], stack: [listed(leaving), StackedWindow(id: dialog, frame: box)]).holes.isEmpty)
+  }
+
+  @Test func strangersThatOverlapAreBothLeftOpen() {
+    let front = CGRect(x: 500, y: 300, width: 400, height: 200)
+    let back = CGRect(x: 700, y: 400, width: 400, height: 200)
+    let mover = moving(a, left, middle)
+    let result = opened(
+      [mover], stack: [StackedWindow(id: dialog, frame: front), StackedWindow(id: panel, frame: back), listed(mover)])
+    #expect(result.holes == [front, back])
+  }
+
+  @Test func aCoveredStrangerIsNotShownInPiecesThroughAHoleBehindIt() {
+    // The mover gets as far as x = 576: into the dialog, and nowhere near b.
+    let box = CGRect(x: 500, y: 300, width: 600, height: 200)
+    let mover = moving(a, left, left.offsetBy(dx: 100, dy: 0))
+    let behind = still(b, right)
+    #expect(opened([behind, mover], stack: [listed(mover), listed(behind)]).holes == [right], "without the dialog b is left open")
+    let result = opened([behind, mover], stack: [listed(mover), StackedWindow(id: dialog, frame: box), listed(behind)])
+    #expect(result.holes.isEmpty, "the mover crosses the dialog, and the dialog lies over b")
+    #expect(result[b] != nil, "b is drawn")
+  }
+
+  @Test func strangersOutOfSightOrWithoutAProperFrameAreNobodysBusiness() {
+    let mover = moving(a, left, middle)
+    let result = opened(
+      [mover],
+      stack: [
+        StackedWindow(id: dialog, frame: CGRect(x: 2000, y: 0, width: 300, height: 200)),
+        StackedWindow(id: panel, frame: CGRect(x: 0, y: 0, width: CGFloat.infinity, height: 100)), listed(mover),
+      ])
+    #expect(result.holes.isEmpty)
+  }
+
+  // MARK: Sheets and dialogs go with their window
+
+  @Test func aStrangerLyingOverAMovingWindowOfItsOwnAppIsTakenAlongByMacOS() {
+    let sheet = CGRect(x: 100, y: 60, width: 300, height: 200)
+    let parent = moving(a, left, right, pid: 7)
+    #expect(
+      opened([parent], stack: [StackedWindow(id: dialog, frame: sheet, pid: 7), listed(parent)]).holes.isEmpty,
+      "where it was listed is not where it is")
+    #expect(
+      opened([parent], stack: [StackedWindow(id: dialog, frame: sheet, pid: 8), listed(parent)]).holes == [sheet],
+      "another app's window stays")
+    #expect(
+      opened([parent], stack: [StackedWindow(id: dialog, frame: sheet), listed(parent)]).holes == [sheet],
+      "and so does one whose app is not known")
+    let nobodys = moving(a, left, right)
+    #expect(
+      opened([nobodys], stack: [StackedWindow(id: dialog, frame: sheet), listed(nobodys)]).holes == [sheet],
+      "two unknown apps are not the same app")
+    let elsewhere = sheet.offsetBy(dx: 900, dy: 0)
+    let shy = moving(a, left, left.offsetBy(dx: 0, dy: 20), pid: 7)
+    #expect(
+      opened([shy], stack: [StackedWindow(id: dialog, frame: elsewhere, pid: 7), listed(shy)]).holes == [elsewhere],
+      "a window of the same app that lies elsewhere is on its own")
+    let resting = still(a, left, pid: 7)
+    #expect(
+      opened([resting, moving(b, middle, right)], stack: [StackedWindow(id: dialog, frame: sheet, pid: 7), listed(resting)])
+        .holes == [sheet, left], "a sheet on a window that stays put stays put")
+  }
+
+  // MARK: Windows Arbor knows
+
+  @Test func aWindowInFrontThatStaysPutIsSeenLiveInsteadOfDrawn() {
+    let pinned = still(c, CGRect(x: 1000, y: 500, width: 400, height: 300))
+    let mover = moving(a, left, CGRect(x: 12, y: 37, width: 1416, height: 851))
+    let result = opened([mover, pinned], stack: [listed(pinned), listed(mover)])
+    #expect(result.holes == [pinned.to])
+    #expect(result.items == [mover])
+  }
+
+  @Test func aWindowBehindAMoverThatKeepsClearOfItIsLeftOpenToo() {
+    let resting = still(b, right)
+    let mover = moving(a, left, middle)
+    let result = opened([resting, mover], stack: [listed(mover), listed(resting)])
+    #expect(result.holes == [right] && result.items == [mover])
+  }
+
+  @Test func aWindowThatHasToBeDrawnBlocksAHoleBehindIt() {
+    // The mover crosses b, so b is drawn. c lies behind b and under it: through a hole, the real b would be seen twice.
+    let mover = moving(a, left, right)
+    let drawn = still(b, middle)
+    let behind = still(c, middle.insetBy(dx: 40, dy: 40))
+    let result = opened([behind, drawn, mover], stack: [listed(mover), listed(drawn), listed(behind)])
+    #expect(result.holes.isEmpty && result.items.count == 3)
+  }
+
+  @Test func aWindowOutOfViewIsNotAStranger() {
+    let mover = moving(a, left, middle)
+    let corner = CGRect(x: 1439, y: 899, width: 464, height: 851)
+    #expect(opened([mover], stack: [StackedWindow(id: b, frame: corner), listed(mover)]).holes.isEmpty)
+  }
+
+  @Test func aWindowTheStackDoesNotListCouldBeAnywhere() {
+    let box = CGRect(x: 500, y: 300, width: 400, height: 200)
+    let unlisted = moving(a, left, right)
+    #expect(opened([unlisted], stack: [StackedWindow(id: dialog, frame: box)]).holes.isEmpty)
+    let far = CGRect(x: 100, y: 10, width: 200, height: 20)
+    #expect(opened([unlisted], stack: [StackedWindow(id: dialog, frame: far)]).holes == [far], "it never gets there")
+  }
+
+  @Test func withoutAStackNothingIsLeftOpen() {
+    let items = [still(b, right), moving(a, left, middle)]
+    let result = opened(items, stack: [])
+    #expect(result.holes.isEmpty && result.items == items)
+  }
+
+  @Test func onlyAWindowThatShowsAsItselfAllTheWhileIsLeftOpen() {
+    let mover = moving(a, left, middle)
+    var cover = still(b, right)
+    cover.fromLook = .cover
+    cover.toLook = .cover
+    var unfolding = still(b, right)
+    unfolding.fromLook = .cover
+    var appearing = still(b, right)
+    appearing.fromOpacity = 0
+    for item in [cover, unfolding, appearing] {
+      let result = opened([item, mover], stack: [listed(item), listed(mover)])
+      #expect(result.holes.isEmpty && result[b] == item)
+    }
+  }
+
+  // MARK: A second motion before the first has ended
+
+  @Test func aWindowWhoseStandInIsStillOnItsWayIsNotLeftOpen() {
+    // The first motion took b from the left to the right. The real b has arrived, its stand-in has not.
+    let arrived = still(b, right)
+    let mover = moving(a, middle, middle.offsetBy(dx: 0, dy: 20))
+    let stack = [listed(arrived), listed(mover)]
+    #expect(opened([mover, arrived], stack: stack).holes == [right], "at rest it would be")
+    let result = opened([mover, arrived], stack: stack, inFlight: [b: left.union(right)])
+    #expect(result.holes.isEmpty && result[b] == arrived)
+  }
+
+  @Test func aStandInOnItsWayCrossesWhateverLiesBetweenWhereItMayBeAndItsGoal() {
+    let box = CGRect(x: 500, y: 300, width: 400, height: 200)
+    // By the plan it only moves within the right third. But it is still coming over from the left.
+    let late = moving(a, right, right.offsetBy(dx: 0, dy: 20))
+    let stack = [listed(late), StackedWindow(id: dialog, frame: box)]
+    #expect(opened([late], stack: stack).holes == [box])
+    #expect(opened([late], stack: stack, inFlight: [a: left.union(right)]).holes.isEmpty)
+  }
+
+  @Test func aSheetOnAWindowWhoseStandInIsStillOnItsWayIsCovered() {
+    let sheet = CGRect(x: 1000, y: 60, width: 300, height: 200)
+    let arrived = still(a, right, pid: 7)
+    let other = moving(b, left, left.offsetBy(dx: 0, dy: 20))
+    let stack = [StackedWindow(id: dialog, frame: sheet, pid: 7), listed(arrived), listed(other)]
+    #expect(opened([other, arrived], stack: stack, inFlight: [a: left.union(right)]).holes.isEmpty)
+  }
+
+  // MARK: In a trace
+
+  @Test func aStackRecordedBeforeThereWereHolesStillReads() throws {
+    // `stackedWindows` is written into traces as it is. Older ones have the window and its frame and nothing else.
+    let whole = StackedWindow(id: dialog, frame: left, pid: 7, floatsAbove: true)
+    let data = try JSONEncoder().encode(whole)
+    #expect(try JSONDecoder().decode(StackedWindow.self, from: data) == whole)
