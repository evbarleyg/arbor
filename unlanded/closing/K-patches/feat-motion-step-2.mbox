diff --git a/Tests/ArborKitTests/StagePictureTests.swift b/Tests/ArborKitTests/StagePictureTests.swift
new file mode 100644
index 00000000..9dfcc051
--- /dev/null
+++ b/Tests/ArborKitTests/StagePictureTests.swift
@@ -0,0 +1,328 @@
+#if os(macOS)
+  import AppKit
+  import ArborCore
+  import ArborTesting
+  import CoreGraphics
+  import Foundation
+  import QuartzCore
+  import Testing
+
+  @testable import ArborKit
+
+  /// A bitmap to draw into and to read back. Nothing here touches the screen or reads from it, so the pictures it
+  /// saves hold only what the test and Arbor drew.
+  @MainActor
+  private final class Sheet {
+    /// In points.
+    let size: CGSize
+    let scale: CGFloat
+    let bitmap: CGContext
+
+    init(size: CGSize, scale: CGFloat = 1) throws {
+      self.size = size
+      self.scale = scale
+      let space = try #require(CGColorSpace(name: CGColorSpace.sRGB))
+      bitmap = try #require(
+        CGContext(
+          data: nil, width: Int(size.width * scale), height: Int(size.height * scale), bitsPerComponent: 8,
+          bytesPerRow: 0, space: space, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue))
+      bitmap.scaleBy(x: scale, y: scale)
+    }
+
+    /// Red, green, blue and alpha, 0 to 1, at a point in GLOBAL coordinates: from the top-left corner, y downward.
+    func pixel(_ x: CGFloat, _ y: CGFloat) -> [Double] {
+      let column = Int(x * scale), row = Int(y * scale)
+      guard x >= 0, y >= 0, column < bitmap.width, row < bitmap.height,
+        let bytes = bitmap.data?.assumingMemoryBound(to: UInt8.self)
+      else { return [0, 0, 0, 0] }
+      // The first row in memory is the top one. The colours are multiplied by alpha.
+      let at = row * bitmap.bytesPerRow + column * 4
+      let alpha = Double(bytes[at + 3])
+      guard alpha > 0 else { return [0, 0, 0, 0] }
+      return [Double(bytes[at]) / alpha, Double(bytes[at + 1]) / alpha, Double(bytes[at + 2]) / alpha, alpha / 255]
+    }
+
+    func alpha(_ x: CGFloat, _ y: CGFloat) -> Double { pixel(x, y)[3] }
+
+    func image() throws -> CGImage { try #require(bitmap.makeImage()) }
+
+    /// Into `.build/pictures/F02` of the checkout, for people to look at.
+    func save(_ name: String) throws {
+      var root = URL(fileURLWithPath: #filePath)
+      for _ in 0..<3 { root.deleteLastPathComponent() }
+      let folder = root.appendingPathComponent(".build/pictures/F02")
+      try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+      let data = try #require(NSBitmapImageRep(cgImage: try image()).representation(using: .png, properties: [:]))
+      try data.write(to: folder.appendingPathComponent(name + ".png"))
+    }
+  }
+
+  private func colour(_ red: CGFloat, _ green: CGFloat, _ blue: CGFloat, _ alpha: CGFloat = 1) -> CGColor {
+    CGColor(srgbRed: red, green: green, blue: blue, alpha: alpha)
+  }
+
+  private func near(_ pixel: [Double], _ red: Double, _ green: Double, _ blue: Double, within tolerance: Double = 0.06) -> Bool {
+    abs(pixel[0] - red) <= tolerance && abs(pixel[1] - green) <= tolerance && abs(pixel[2] - blue) <= tolerance
+  }
+
+  /// What the stage draws, looked at without a screen: the real `Stage` and its layers, given transitions the real
+  /// controller planned, drawn into bitmaps (`Stage.draw`). The pictures are in `.build/pictures/F02`.
+  ///
+  /// What this cannot show: the level of the panel, the real windows through the holes, real pictures of windows, timing,
+  /// and whatever the render server does differently from `CALayer.render(in:)`.
+  @Suite @MainActor struct StagePictureTests {
+    let screen = FakeWindowSystem.standardDisplay.frame
+
+    // MARK: Things to draw with
+
+    /// A gradient with a line every 100 points, so that a backdrop that is shifted, stretched or upside down shows.
+    func desktop() throws -> CGImage {
+      let sheet = try Sheet(size: screen.size)
+      let context = sheet.bitmap
+      let space = try #require(CGColorSpace(name: CGColorSpace.sRGB))
+      let gradient = try #require(
+        CGGradient(
+          colorsSpace: space, colors: [colour(0.11, 0.17, 0.39), colour(0.97, 0.63, 0.25)] as CFArray, locations: [0, 1]))
+      // Dark at the top.
+      context.drawLinearGradient(
+        gradient, start: CGPoint(x: 0, y: screen.height), end: CGPoint(x: screen.width, y: 0), options: [])
+      context.setFillColor(colour(1, 1, 1, 0.35))
+      for x in stride(from: CGFloat(0), to: screen.width, by: 100) { context.fill(CGRect(x: x, y: 0, width: 1, height: screen.height)) }
+      for y in stride(from: CGFloat(0), to: screen.height, by: 100) {
+        context.fill(CGRect(x: 0, y: screen.height - y - 1, width: screen.width, height: 1))
+      }
+      return try sheet.image()
+    }
+
+    /// A window as ScreenCaptureKit hands it over: tight on the frame, with clear corners. The title bar, in `tint`, is at
+    /// the top and the three buttons at its left, so that a picture upside down or mirrored shows; the lines of
+    /// "text" show how it is stretched.
+    func window(_ size: CGSize, tint: CGColor) throws -> CGImage {
+      let sheet = try Sheet(size: size, scale: 2)
+      let context = sheet.bitmap
+      context.addPath(ContinuousCorners.path(CGRect(origin: .zero, size: size), radius: ContinuousCorners.windowRadius))
+      context.clip()
+      context.setFillColor(colour(0.98, 0.98, 0.98))
+      context.fill(CGRect(origin: .zero, size: size))
+      context.setFillColor(tint)
+      context.fill(CGRect(x: 0, y: size.height - 40, width: size.width, height: 40))
+      for (index, light) in [colour(1, 0.37, 0.34), colour(1, 0.74, 0.18), colour(0.16, 0.78, 0.25)].enumerated() {
+        context.setFillColor(light)
+        context.fillEllipse(in: CGRect(x: 14 + CGFloat(index) * 20, y: size.height - 26, width: 12, height: 12))
+      }
+      context.setFillColor(colour(0.75, 0.75, 0.78))
+      for y in stride(from: size.height - 70, to: CGFloat(20), by: -22) {
+        context.fill(CGRect(x: 24, y: y, width: (size.width - 48) * (Int(y) % 3 == 0 ? 0.6 : 0.9), height: 8))
+      }
+      return try sheet.image()
+    }
+
+    /// Light above, dark below.
+    func icon() throws -> CGImage {
+      let sheet = try Sheet(size: CGSize(width: 128, height: 128))
+      sheet.bitmap.addEllipse(in: CGRect(x: 8, y: 8, width: 112, height: 112))
+      sheet.bitmap.clip()
+      sheet.bitmap.setFillColor(colour(0.15, 0.15, 0.2))
+      sheet.bitmap.fill(CGRect(x: 0, y: 0, width: 128, height: 64))
+      sheet.bitmap.setFillColor(colour(0.95, 0.95, 1))
+      sheet.bitmap.fill(CGRect(x: 0, y: 64, width: 128, height: 64))
+      return try sheet.image()
+    }
+
+    static let tints: [(Double, Double, Double)] = [(0.2, 0.45, 0.9), (0.9, 0.7, 0.2), (0.3, 0.7, 0.4), (0.75, 0.3, 0.6)]
+
+    func tint(of window: WindowID) -> (Double, Double, Double) { Self.tints[Int(window.rawValue) % Self.tints.count] }
+
+    /// Dressed as the director dresses them: with pictures at the size each window has at the start, or without any.
+    func costumes(for transition: Transition, pictures: Bool) throws -> [WindowID: Costume] {
+      var costumes: [WindowID: Costume] = [:]
+      for item in transition.items {
+        let (red, green, blue) = tint(of: item.window)
+        let tint = colour(CGFloat(red), CGFloat(green), CGFloat(blue))
+        costumes[item.window] = Costume(
+          picture: pictures ? try window(item.fromLook == .picture ? item.from.size : item.to.size, tint: tint) : nil,
+          colour: tint, icon: try icon())
+      }
+      return costumes
+    }
+
+    // MARK: Looking
+
+    /// One moment, as large as life, on nothing: where the stage is open the picture is clear.
+    private func moment(
+      _ transition: Transition, at time: Double, pictures: Bool = true, scale: CGFloat = 1
+    ) throws -> Sheet {
+      let sheet = try Sheet(size: screen.size, scale: scale)
+      Stage().draw(
+        transition, at: Transition.progress(at: time), costumes: try costumes(for: transition, pictures: pictures),
+        backdrop: try desktop(), scale: scale, in: sheet.bitmap)
+      return sheet
+    }
+
+    /// Six moments of a motion side by side, a third of their size. Where the stage is open there is magenta.
+    func film(_ name: String, _ transition: Transition, pictures: Bool = true) throws {
+      let times = [0, 0.08, 0.16, 0.3, 0.55, 1]
+      let cell = CGSize(width: screen.width / 3, height: screen.height / 3)
+      let gap: CGFloat = 8
+      let sheet = try Sheet(size: CGSize(width: cell.width * 3 + gap * 4, height: cell.height * 2 + gap * 3))
+      let context = sheet.bitmap
+      context.setFillColor(colour(0.2, 0.2, 0.2))
+      context.fill(CGRect(origin: .zero, size: sheet.size))
+      let dressed = try costumes(for: transition, pictures: pictures)
+      let behind = try desktop()
+      for (index, time) in times.enumerated() {
+        let origin = CGPoint(
+          x: gap + CGFloat(index % 3) * (cell.width + gap), y: gap + CGFloat(1 - index / 3) * (cell.height + gap))
+        context.saveGState()
+        context.clip(to: CGRect(origin: origin, size: cell))
+        context.setFillColor(colour(1, 0, 1))
+        context.fill(CGRect(origin: origin, size: cell))
+        context.translateBy(x: origin.x, y: origin.y)
+        context.scaleBy(x: 1 / 3, y: 1 / 3)
+        Stage().draw(
+          transition, at: Transition.progress(at: time), costumes: dressed, backdrop: behind, scale: 1, in: context)
+        context.restoreGState()
+      }
+      try sheet.save(name)
+    }
+
+    /// A corner of the display, four times its size.
+    private func closeUp(_ name: String, _ transition: Transition, at time: Double, of area: CGRect, pictures: Bool = true) throws {
+      let sheet = try Sheet(size: area.size, scale: 4)
+      sheet.bitmap.setFillColor(colour(1, 0, 1))
+      sheet.bitmap.fill(CGRect(origin: .zero, size: area.size))
+      sheet.bitmap.translateBy(x: -area.minX, y: -(screen.height - area.maxY))
+      Stage().draw(
+        transition, at: Transition.progress(at: time), costumes: try costumes(for: transition, pictures: pictures),
+        backdrop: try desktop(), scale: 4, in: sheet.bitmap)
+      try sheet.save(name)
+    }
+
+    // MARK: The scenes of `StageScenes`, planned by the real controller
+
+    @Test func standInsAreTheirWindowsTheRightWayUpWhereTheWindowsAre() throws {
