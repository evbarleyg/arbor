index 00000000..7b032944
--- /dev/null
+++ b/Tests/ArborKitTests/StageScenes.swift
@@ -0,0 +1,132 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+extension Settings {
+  /// With the motion on, at 0.46 s, whatever the default is: for tests that are about the motion.
+  static var withMotion: Settings {
+    var settings = Settings()
+    settings.animationDuration = 0.46
+    return settings
+  }
+}
+
+/// The motions `StagePictureTests` draws, planned by the real controller, each with what the pictures take for granted about
+/// it checked on the spot.
+///
+/// They are here, where every platform compiles and runs them (`StageSceneTests`), because the pictures are macOS only. A
+/// change to what the controller does can take the ground from under a scene (F61 made room for the window that
+/// was to be a tile), and a test only a Mac runs says so hours later, if a Mac is at hand at all.
+@MainActor
+enum StageScenes {
+  /// [a | Desktop | b] with c floating on the Desktop, at rest.
+  static func arrangement(settings: Settings = Settings.withMotion) -> (h: Harness, a: WindowID, b: WindowID, c: WindowID) {
+    let h = Harness(settings: settings)
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let b = h.system.open(app: "Notes", pid: 12, frame: CGRect(x: 300, y: 200, width: 600, height: 400))
+    let c = h.system.open(app: "Mail", pid: 13, frame: CGRect(x: 520, y: 300, width: 400, height: 300))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) right")
+    h.system.userMove(c, to: CGRect(x: 520, y: 300, width: 400, height: 300))
+    rest(h)
+    return (h, a, b, c)
+  }
+
+  /// The motion under way ends, and what was played so far is forgotten.
+  static func rest(_ h: Harness) {
+    h.scheduler.advance(by: 1)
+    h.overlays.clearTransitions()
+  }
+
+  /// `command`, from rest, and the first thing it plays.
+  static func play(_ command: String, _ h: Harness, sourceLocation: SourceLocation = #_sourceLocation) throws -> Transition {
+    rest(h)
+    #expect(h.run(command).ok, "\(command)", sourceLocation: sourceLocation)
+    return try #require(h.overlays.transitions.first, "\(command) plays nothing", sourceLocation: sourceLocation)
+  }
+
+  /// a grows to fill the view. Everything travels as itself, and the stage is whole.
+  static func zoomIn() throws -> (h: Harness, transition: Transition, a: WindowID, b: WindowID, slotA: CGRect, slotB: CGRect) {
+    let (h, a, b, c) = arrangement()
+    let (slotA, slotB) = (try #require(h.frame(a)), try #require(h.frame(b)))
+    let transition = try play("zoom \(a.rawValue)", h)
+    for window in [a, b, c] {
+      let item = try #require(transition[window], "\(window)")
+      #expect(item.fromLook == .picture && item.toLook == .picture && item.fromOpacity == 1, "\(window)")
+    }
+    #expect(transition[a]?.from == slotA && transition[b]?.from == slotB && transition.holes.isEmpty)
+    #expect(!slotA.overlaps(slotB) && slotA.width > 300 && slotB.width > 300, "room for a title bar and three buttons")
+    // The strips the pictures look at the backdrop in: the outer gap at the left, and the menu bar's.
+    let full = try #require(transition[a]).to
+    #expect(full.minX >= 10 && full.minY >= 30)
+    return (h, transition, a, b, slotA, slotB)
+  }
+
+  /// c is docked below a. b takes no part, and nothing crosses it.
+  static func dockWithAHole() throws -> (h: Harness, transition: Transition, still: CGRect) {
+    let (h, a, b, c) = arrangement()
+    let still = try #require(h.frame(b))
+    let transition = try play("dock \(c.rawValue) beside \(a.rawValue) bottom", h)
+    #expect(transition.holes == [still] && transition[b] == nil)
+    return (h, transition, still)
+  }
+
+  /// a grows behind a pinned window and a dialog Arbor knows nothing about, which lies over the pinned window's corner.
+  static func pinnedWindowAndDialog() throws -> (h: Harness, transition: Transition, pinned: CGRect, dialog: CGRect) {
+    let (h, a, _, c) = arrangement()
+    #expect(h.run("pin \(c.rawValue)").ok)
+    h.scheduler.advance(by: 1)
+    let pinned = try #require(h.frame(c))
+    let dialog = CGRect(x: pinned.maxX - 120, y: pinned.maxY - 90, width: 320, height: 200)
+    h.system.strangers = [StackedWindow(id: WindowID(900), frame: dialog, pid: 99)]
+    let transition = try play("zoom \(a.rawValue)", h)
+    #expect(transition.holes.count == 2 && transition.holes.contains(dialog) && transition.holes.contains(pinned))
+    #expect(pinned.overlaps(dialog) && !pinned.contains(dialog) && !dialog.contains(pinned))
+    return (h, transition, pinned, dialog)
+  }
+
+  /// b, which refused half the display and is a tile, is framed: a cover that turns into the window.
+  static func tileUnfolds() throws -> (h: Harness, transition: Transition, b: WindowID) {
+    // Without F61, which would move the gaps until b fits: this wants the tile.
+    var settings = Settings.withMotion
+    settings.makeRoom = false
+    let h = Harness(settings: settings)
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let b = h.system.open(
+      app: "Notes", pid: 12, frame: CGRect(x: 300, y: 200, width: 900, height: 600), minimumSize: CGSize(width: 900, height: 600))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) right")
+    rest(h)
+    try #require(h.layout?.tiles.contains { $0.windows == [b] } == true, "b refuses half the display and is a tile")
+    let transition = try play("zoom \(b.rawValue)", h)
+    #expect(transition[b]?.fromLook == .cover && transition[b]?.toLook == .picture)
+    return (h, transition, b)
+  }
+
+  /// From a, framed, to c below it, and from there to everything.
+  static func walkAndShowEverything() throws -> (h: Harness, neighbour: Transition, everything: Transition) {
+    let (h, a, _, c) = arrangement()
+    h.run("dock \(c.rawValue) beside \(a.rawValue) bottom")
+    h.run("zoom \(a.rawValue)")
+    let neighbour = try play("neighbor down", h)
+    #expect(neighbour[a]?.moves == true && neighbour[c]?.to == h.frame(c))
+    let everything = try play("show-all", h)
+    #expect(everything.items.count >= 3)
+    return (h, neighbour, everything)
+  }
+}
+
+/// On every platform: the scenes are what the pictures take them for.
+@Suite @MainActor struct StageSceneTests {
+  @Test func theScenesAreWhatThePicturesTakeThemFor() throws {
+    _ = try StageScenes.zoomIn()
+    _ = try StageScenes.dockWithAHole()
+    _ = try StageScenes.pinnedWindowAndDialog()
+    _ = try StageScenes.tileUnfolds()
+    _ = try StageScenes.walkAndShowEverything()
+  }
+}
