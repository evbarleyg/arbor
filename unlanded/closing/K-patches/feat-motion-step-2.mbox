+
+/// When the ring flashes. A flash is over in a quarter of a second. Played while something covers the display (the
+/// stage, while windows move) nobody sees it, and that is after the very moves it is for: a move of the view that
+/// takes the keyboard to another window. So a flash that falls due on a covered display is owed until the display is
+/// in sight again.
+///
+/// Only the flash waits. The ring itself goes where its window is at once, so it is there when the cover lifts.
+public struct FocusRingFlashes: Equatable, Sendable {
+  /// The pulse last seen, on whichever display. The controller's count starts at 0 too.
+  private var lastPulse = 0
+  /// The display whose ring has still to flash. There is one ring, so there is at most one.
+  private var owed: DisplayID?
+
+  public init() {}
+
+  /// `display` shows `model` from now on. Returns whether its ring flashes now.
+  public mutating func shows(_ model: FocusRingModel?, on display: DisplayID, isCovered: Bool) -> Bool {
+    guard let model else {
+      // The ring went to another display or away, and with it what the flash was to point out.
+      if owed == display { owed = nil }
+      return false
+    }
+    if model.pulse != lastPulse {
+      lastPulse = model.pulse
+      owed = display
+    }
+    // Also one that nobody reported the end of the cover for: better late than never.
+    guard owed == display, !isCovered else { return false }
+    owed = nil
+    return true
+  }
+
+  /// What covered `display` is gone. Returns whether its ring flashes now.
+  public mutating func uncovered(_ display: DisplayID) -> Bool {
+    guard owed == display else { return false }
+    owed = nil
+    return true
+  }
+}
