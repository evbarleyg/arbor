+      TransitionPlanner.crosses(inFlight[item.window]?.union(item.from) ?? item.from, item.to, area)
+    }
+    func isOnItsWay(_ item: Item) -> Bool { item.moves || inFlight[item.window] != nil }
+    func isAttached(_ stranger: StackedWindow) -> Bool {
+      stranger.pid != 0
+        && items.contains { $0.pid == stranger.pid && isOnItsWay($0) && $0.from.overlaps(stranger.frame) }
+    }
     let stacked = Set(stack.map(\.id))
