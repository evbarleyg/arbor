+    let older = try JSONDecoder().decode(StackedWindow.self, from: JSONSerialization.data(withJSONObject: fields))
+    #expect(older == StackedWindow(id: dialog, frame: left))
+  }
+
+  // MARK: Comparing and printing
+
+  @Test func transitionsAroundDifferentHolesDoNotEndAlike() {
+    let mover = moving(a, left, middle)
+    let box = CGRect(x: 1000, y: 300, width: 300, height: 200)
+    let open = opened([mover], stack: [StackedWindow(id: dialog, frame: box), listed(mover)])
