       if item == nil, known.contains(window.id) { continue }
       let area = item?.to ?? window.frame
-      if item.map(\.isStill) ?? true, area.isFinite, area.overlaps(frame),
-        !inFront.contains(where: { TransitionPlanner.crosses($0.from, $0.to, area) })
