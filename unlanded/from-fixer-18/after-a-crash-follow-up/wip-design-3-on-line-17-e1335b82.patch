+  /// For `PersistedState.hadAt`.
+  func whereTheFloatingWindowsAre() -> [WindowID: CGRect] {
+    var frames: [WindowID: CGRect] = [:]
+    for window in workspaces.values.flatMap(\.floating.keys) where windows[window]?.isFullScreen == false {
