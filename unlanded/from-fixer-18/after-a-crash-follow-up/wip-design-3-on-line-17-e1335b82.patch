+  /// Whether the file is behind on something Arbor did: other windows are docked than it says, or a floating window is in a frame that is
+  /// not its own, and not where the file has it. A start that read of a window as floating at its own frame, and found it in the shape of a
+  /// slot, or squeezed, or fitted, would take that for somebody's doing. So this much is handed to the file at once, not half a second
+  /// later (`scheduleSave`). What a person does waits as ever: where they drag a floating window is its own frame as they go.
+  var theFileIsBehindOnWhatArborDid: Bool {
+    // After a quit and in a pause the file says where every window was left, and Arbor does nothing.
+    guard leftAt == nil else { return false }
+    let docked = Set(workspaces.values.flatMap(\.tree.allWindows))
+    guard let file = lastSaved else { return !docked.isEmpty }
+    if docked != Set(file.workspaces.values.flatMap(\.tree.allWindows)) { return true }
