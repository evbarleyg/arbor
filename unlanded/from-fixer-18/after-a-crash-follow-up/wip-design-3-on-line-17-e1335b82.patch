+      settle
+      flush
+      crash
+      launch
+      settle
+      displays main:0,0,2560,1440:25,0,0,0* windows-silent
+      settle
+      quit
+      """
+    ),
+    // Fitted, and the display has grown again by the time somebody starts Arbor.
+    (
+      101, CGSize(width: 2000, height: 1200),
+      """
+      displays main:0,0,2560,1440:25,0,0,0* windows-silent
+      launch
+      open 101 Notes pid 1001 at 300 200 2000 1200
+      settle
+      displays main:0,0,1440,900:25,0,0,0* windows-silent
+      settle
+      flush
+      crash
+      displays main:0,0,2560,1440:25,0,0,0* windows-silent
+      launch
+      settle
+      quit
+      """
+    ),
+    // Squeezed by a run in which floating windows made way; the setting is off when Arbor is started.
+    (
+      102, CGSize(width: 900, height: 400),
+      """
+      settings {"floatingWindowsMakeWay":true}
+      launch
+      open 101 Safari pid 1000 at 100 100 600 400
+      open 102 Notes pid 1001 at 300 300 900 400
+      dock 101 left
+      settle
+      flush
+      crash
+      settings {"floatingWindowsMakeWay":false}
+      launch
+      settle
+      quit
+      """
+    ),
+  ])
+  func foundInAFrameNobodyChoseItsOwnSizeIsStillKnown(window: UInt32, own: CGSize, script: String) {
+    #expect(played(script, window)?.size == own)
+  }
+
+  /// In the corner where Arbor keeps what is out of view, which a larger display shows when somebody starts Arbor. Its place is still known.
+  @Test func foundInACornerThatALargerDisplayShowsItGoesWhereItIsRemembered() {
+    let end = played(
+      """
+      launch
+      open 101 Safari pid 1000 at 100 100 600 400
+      open 102 Notes pid 1001 at 800 300 500 400
+      dock 101 left
+      zoom 101
+      settle
+      flush
+      crash
+      displays main:0,0,1680,1050:25,0,0,0* windows-silent
+      launch
+      settle
+      show-all
+      settle
+      """, 102)
+    #expect(end == CGRect(x: 800, y: 300, width: 500, height: 400))
+  }
+
+  /// Without the permission Arbor stops as it stands, and comes back when the permission does. Nobody has touched anything.
+  @Test func whenThePermissionIsBackWhereArborFittedItIsNotItsOwn() throws {
+    let large = DisplaySnapshot(
+      id: lap.id, frame: CGRect(x: 0, y: 0, width: 2560, height: 1440), visibleFrame: CGRect(x: 0, y: 25, width: 2560, height: 1415), isMain: true)
+    let h = Harness(displays: [large])
+    h.watchAccessibility()
+    let own = CGRect(x: 300, y: 200, width: 2000, height: 1200)
+    let notes = h.system.open(app: "Notes", pid: 1002, frame: own, minimumSize: CGSize(width: 1600, height: 960))
+    h.start()
+    settle(h)
+    h.system.setDisplays([lap])
+    settle(h)
+    try #require(h.frame(notes)?.size == CGSize(width: 1600, height: 960) && remembered(notes, h) == own, "\(String(describing: h.frame(notes)))")
+    h.revokeAccessibility()
+    h.scheduler.advance(by: 5)
+    try #require(!h.controller.isRunning)
+    h.grantAccessibility()
+    h.scheduler.advance(by: 5)
+    try #require(h.controller.isRunning)
+    #expect(remembered(notes, h) == own)
+  }
+
+  // MARK: The file is not behind on what is docked
+
+  /// Docked, and Arbor is killed before the half second is over after which that would have been saved. A file that still had it floating, at
+  /// its own frame, would pass the shape of its slot off as somebody's doing.
+  @Test(arguments: ["quit", "float-all"])
+  func dockedJustBeforeArborWasKilledItsOwnSizeIsStillKnown(wayOut: String) {
+    let end = played(
+      """
+      launch
+      open 101 Safari pid 1000 at 100 100 600 400
+      open 102 Notes pid 1001 at 800 300 400 300
+      dock 101 left
+      flush
+      dock 102 right
+      crash
+      launch
+      settle
+      \(wayOut)
+      """, 102)
+    #expect(end?.size == CGSize(width: 400, height: 300))
+  }
+
+  /// Docked, taken back, made larger, and then Arbor is killed, all within the half second. It floats, and is not docked by the start.
+  @Test func dockedAndTakenBackJustBeforeArborWasKilledItFloats() {
+    let end = played(
+      """
+      launch
+      open 101 Safari pid 1000 at 100 100 600 400
+      open 102 Notes pid 1001 at 800 300 400 300
+      dock 101 left
+      flush
+      dock 102 right
+      undo
+      edge 102 800 300 500 450
+      crash
+      launch
+      settle
+      quit
+      """, 102)
+    #expect(end == CGRect(x: 800, y: 300, width: 500, height: 450))
+  }
+
+  /// Who is docked goes to the file at once, whichever way it changed. Everything else still waits for the half second, a drag's hundred
+  /// reports among it. (Handed over at once: the store writes on a queue of its own.)
+  @Test func whoIsDockedGoesToTheFileAtOnceAndAMoveWaits() throws {
+    let (h, _, notes) = editorDockedNotesFloating()
+    func file() -> Workspace? { h.store.saved?.workspaces[lap.id] }
+    let before = try #require(file()?.floating[notes])
+    h.system.userMove(notes, to: before.offsetBy(dx: 40, dy: 40))
+    #expect(file()?.floating[notes] == before, "a move waits")
+    h.scheduler.advance(by: 0.5)
+    #expect(file()?.floating[notes] == before.offsetBy(dx: 40, dy: 40))
+    h.run("dock \(notes.rawValue) right")
+    #expect(file()?.isDocked(notes) == true)
+    h.run("float \(notes.rawValue)")
+    #expect(file()?.isFloating(notes) == true)
+  }
+
+  /// A process that has written nothing yet does not know what the file says. It may be the last run's, with the window floating.
+  /// (After a quit the start itself writes, to take `leftAt` out of the file.)
+  @Test(arguments: [true, false])
+  func theFirstDockOfARunGoesToTheFileAtOnceToo(afterAQuit: Bool) {
+    let old = Harness(displays: [lap])
+    let notes = old.system.open(app: "Notes", pid: 1002, frame: CGRect(x: 780, y: 100, width: 600, height: 420))
+    old.start()
+    settle(old)
+    if afterAQuit { old.controller.shutdown() } else { old.controller.saveNow() }
+    let h = newProcess(after: old)
+    h.start()
+    #expect(h.store.saved?.workspaces[lap.id]?.isFloating(notes) == true)
+    h.run("dock \(notes.rawValue) left")
+    #expect(h.store.saved?.workspaces[lap.id]?.isDocked(notes) == true)
+  }
+
+  /// A file says one or the other: where a quit or a pause left the windows, or where a running Arbor has those that float.
+  @Test func aFileSaysWhereArborHasTheFloatingWindowsOnlyWhileItRuns() throws {
+    let (h, editor, notes) = editorDockedNotesFloating()
+    h.controller.saveNow()
+    #expect(h.store.saved?.leftAt == nil)
+    #expect(h.store.saved?.hadAt == [notes: try #require(h.frame(notes))], "not the docked one: \(editor)")
+    h.run("pause")
+    #expect(h.store.saved?.leftAt != nil && h.store.saved?.hadAt == nil)
+    h.run("resume")
+    settle(h)
+    #expect(h.store.saved?.leftAt == nil && h.store.saved?.hadAt != nil)
+    h.controller.shutdown()
+    #expect(h.store.saved?.leftAt != nil && h.store.saved?.hadAt == nil)
+  }
 }
