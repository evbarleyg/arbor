+    one.mac.later(0.5) { one.mac.appMoves(window, to: target) }
+    one.mac.pass(4)
+    story.check("the window has the frame", window.frame == target, window.frame.text)
+    story.check("and nothing passed for the person's doing", !one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+  }
+
+  // What Arbor reads back after a move can be the old frame, and the reports that come so soon are not read: the books are no better until the second look has been TAKEN. At the
+  // door of an app that has fallen to work it waits. Whoever spared a call meanwhile, because the window "is there already", would leave it where the first move then lands.
+  book.story("an app applies a size 70 ms late and falls to work for a second; Arbor's layer gives its window a size, and 0.6 s later the old one again") { story in
+    var window: FakeMac.Window!
+    let old = CGRect(x: 100, y: 100, width: 400, height: 300)
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: old) }
+    window.app.appliesSizeAfter = 0.07
+    _ = one.layer.setFrame(CGRect(x: 100, y: 100, width: 600, height: 500), of: WindowID(window.number))
+    one.mac.pass(0.2)
+    one.mac.hang(window.app, for: 1)
+    one.mac.pass(0.4)
+    _ = one.layer.setFrame(old, of: WindowID(window.number))
+    one.mac.pass(5)
+    story.check("in the end it has the old size", window.frame == old, window.frame.text)
+  }
+
+  // A look that is dropped is no longer booked: or no call would ever be spared again.
+  book.story("an app applies a size 70 ms late and hangs for 5 s; once all is over Arbor's layer gives its window the frame it has") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    let target = CGRect(x: 100, y: 100, width: 600, height: 500)
+    window.app.appliesSizeAfter = 0.07
+    _ = one.layer.setFrame(target, of: WindowID(window.number))
+    one.mac.pass(0.2)
+    one.mac.hang(window.app, for: 5)
+    one.mac.pass(10)
+    story.check("it has the frame, and Arbor knows", window.frame == target && one.snapshot(window)?.frame == target, "\(window.frame.text); \(one.snapshot(window)?.frame.text ?? "")")
+    let calls = one.mac.calls
+    _ = one.layer.setFrame(target, of: WindowID(window.number))
+    story.check("nothing is asked of the app", one.mac.calls == calls, "\(one.mac.calls - calls) calls")
+  }
+
   // It is not only apps that are busy. A main thread that is held serves reports late: on a hosted Mac it drew tiles for the first time, for 830 ms, right after `arrange`, and of three reports of one
   // move, all of the frame that had been asked for, the first was served after 0.996 s and the others after 1.015 and 1.017 s, and passed for the person's doing. The frame decides, not the time.
   for held in [0.1, 0.5, 0.9, 1.2, 3.0] {
diff --git a/scripts/mac-on-linux/tests/BusyAppsAttacked.swift b/scripts/mac-on-linux/tests/BusyAppsAttacked.swift
new file mode 100644
index 00000000..9cf6c749
--- /dev/null
+++ b/scripts/mac-on-linux/tests/BusyAppsAttacked.swift
@@ -0,0 +1,570 @@
+import ArborCore
+@testable import ArborKit
+import CoreGraphics
+import FakeMacOS
+import Foundation
+
+// Busy apps (BusyApps.swift), attacked: the stories of a reader who was asked to break the first draft of "knock before reading", and did. That draft remembered who has the keyboard for a
+// second and forgot it at a scatter of events: it was believed when it was stale, so that a command acted on the window its person had just left, and thrown away too eagerly, so that
+// the next to ask asked on the main thread after all. All of these were red on it. Those that were green before anybody knocked say so.
+
+@MainActor
+func tellOfBusyAppsAttacked(_ book: Book) {
+  // cmd-` in an app that is then busy, and a command within its burst. Late is one thing, the wrong window another. The report that the keyboard has moved names the window, which costs no call.
+  for (name, busy) in [("is busy for 0.7 s", 0.7), ("is not busy", 0.0)] {
+    book.story("the keyboard goes to another window of the app in front, which then \(name), and 0.1 s later Arbor is told to float the window that has it") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        let app = mac.launch("Busy")
+        theirs = [mac.open("a", in: app, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+      }
+      story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+      story.check("the app in front is theirs", two.mac.frontmost === theirs[0].app)
+      // Twice there and back, so that the layer has reported who has it, and what was said is fresh.
+      two.mac.appMakesKey(theirs[0])
+      two.mac.pass(1)
+      two.mac.appMakesKey(theirs[1])
+      two.mac.pass(0.5)
+      let had = two.mac.keyWindow!
+      let other = theirs.first { $0 !== had }!
+      two.mac.appMakesKey(other)
+      if busy > 0 { two.mac.later(0.0005) { two.mac.hang(other.app, for: busy) } }
+      two.mac.pass(0.1)
+      story.check("the Mac has the keyboard in the other window", two.mac.keyWindow === other)
+      let result = two.run("float", then: 3)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("the window that has the keyboard floats", !two.isDocked(other), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+      story.check("the one that had it before stays docked", two.isDocked(had), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+    }
+  }
+
+  // The same of the layer alone.
+  book.story("the keyboard goes to another window of the app in front, which is then busy for 0.7 s, and Arbor's layer is asked who has it") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    one.mac.appMakesKey(windows[0])
+    one.mac.pass(1)
+    one.mac.appMakesKey(windows[1])
+    one.mac.pass(0.5)
+    let had = one.layer.focusedWindow()?.rawValue
+    let other = windows.first { $0.number != had }!
+    one.mac.appMakesKey(other)
+    one.mac.later(0.0005) { one.mac.hang(other.app, for: 0.7) }
+    one.mac.pass(0.1)
+    let answer = one.layer.focusedWindow()?.rawValue
+    story.check("a tenth of a second later the answer is the window that has it", answer == other.number, "answer \(String(describing: answer)), had \(String(describing: had)), at \(one.mac.now - one.mac.dawn)")
+  }
+
+  // cmd-Tab to an app that is busy, and has never said which of its windows has the keyboard. "Nobody" is a claim too: that is waited for, as ever.
+  book.story("an app that is busy for 0.7 s comes forward, and 0.1 s later Arbor is told to float the window that has the keyboard") { story in
+    var mine: FakeMac.Window!, theirs: FakeMac.Window!
+    let two = StoreyTwo(story) { mac in
+      theirs = mac.open("theirs", in: mac.launch("Busy"), frame: CGRect(x: 500, y: 60, width: 400, height: 300))
+      mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+    }
+    story.check("two windows are arranged", two.run("arrange", then: 2).ok && [theirs!, mine!].allSatisfy { two.isDocked($0) })
+    two.mac.activate(theirs.app)
+    two.mac.later(0.0005) { two.mac.hang(theirs.app, for: 0.7) }
+    two.mac.pass(0.1)
+    let result = two.run("float", then: 3)
+    story.check("Arbor takes the command", result.ok, result.message)
+    story.check("the window that has the keyboard floats", !two.isDocked(theirs), "theirs docked \(two.isDocked(theirs)), mine docked \(two.isDocked(mine))")
+    story.check("the other stays docked", two.isDocked(mine))
+  }
+
+  // That a window has gone is a fact, whatever waits behind the door: and the report of the keyboard that goes before every close has shut it.
+  for seconds in [5.0, 30.0] {
+    book.story("a window of an app like Safari closes, and half a millisecond later the app hangs for \(seconds) s") { story in
+      var windows: [FakeMac.Window] = []
+      let one = StoreyOne(story) { mac in
+        let app = mac.launch("Safari")
+        app.dropsAClosingWindowAtOnce = true
+        windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+      }
+      one.heard.clear()
+      one.mac.close(windows[1])
+      one.mac.later(0.0005) { one.mac.hang(windows[0].app, for: seconds) }
+      one.mac.pass(4)
+      story.check("it is reported gone within four seconds", one.heard.all.contains(.destroyed(windows[1].number)), one.heard.texts)
+      one.mac.pass(seconds + 3)
+      story.check("once", one.heard.all.filter { $0 == .destroyed(windows[1].number) }.count == 1, one.heard.texts)
+    }
+  }
+
+  // Where a tab may be taking its place the app's list is read first. Gone it is, whether or not the app ever answers with that.
+  for (name, then) in [("hangs for 5 s", { (mac: FakeMac, app: FakeMac.App) in mac.hang(app, for: 5) }), ("is busy 0.7 s at a time", { mac, app in mac.keepsBusy(app, for: 5) })] {
+    book.story("an app has a window with two tabs and a plain one; the plain one closes, and as that is on its way to Arbor the app \(name)") { story in
+      var tabbed: FakeMac.Window!, plain: FakeMac.Window!
+      let one = StoreyOne(story) { mac in
+        let app = mac.launch("Notes")
+        tabbed = mac.open("tabbed", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+        plain = mac.open("plain", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+      }
+      _ = one.mac.newTab(of: tabbed)
+      one.mac.pass(2)
+      one.mac.click(plain)
+      one.mac.pass(2)
+      one.heard.clear()
+      let waited = one.mac.secondsTheMainThreadWaited
+      one.mac.close(plain)
+      one.mac.pass(0.013)
+      then(one.mac, plain.app)
+      one.mac.pass(2)
+      story.check("it is reported gone within two seconds", one.heard.all.contains(.destroyed(plain.number)), one.heard.texts)
+      one.mac.pass(7)
+      story.check("once", one.heard.all.filter { $0 == .destroyed(plain.number) }.count == 1, one.heard.texts)
+      story.check("Arbor's main thread has not waited for the app", one.mac.secondsTheMainThreadWaited - waited < 0.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+    }
+  }
+
+  // A Mac on which other things happen. The price of asking every time: a twentieth of a second, once for each command, while the app in front is busy.
+  for (name, between) in [
+    ("the person clicks in its window", { (two: StoreyTwo, mine: FakeMac.Window, theirs: [FakeMac.Window]) in two.mac.click(two.mac.keyWindow!) }),
+    ("another app, in the background, shows a tooltip", { two, mine, theirs in
+      _ = two.mac.open("", in: mine.app, frame: CGRect(x: 80, y: 120, width: 100, height: 20), subrole: "AXUnknown", takesKeyboard: false)
+    }),
+    ("nothing else happens", { _, _, _ in }),
+  ] {
+    book.story("the app in front is busy 0.7 s at a time, \(name), and Arbor is given a command, every 0.4 s") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        let busy = mac.launch("Busy")
+        theirs = [mac.open("a", in: busy, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: busy, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+      }
+      story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+      two.mac.keepsBusy(theirs[0].app, for: 12)
+      two.mac.pass(0.1)
+      let waited = two.mac.secondsTheMainThreadWaited
+      var slowest = (text: "", seconds: 0.0)
+      for command in ["state", "status", "state", "ascii", "state", "status", "state", "ascii"] {
+        between(two, mine, theirs)
+        two.mac.pass(0.05)
+        let began = two.mac.now
+        _ = two.run(command, then: 0)
+        if two.mac.now - began > slowest.seconds { slowest = (command, two.mac.now - began) }
+        two.mac.pass(0.35)
+      }
+      story.check("each is answered within a tenth of a second", slowest.seconds <= 0.1, "`\(slowest.text)` took \(slowest.seconds) s")
+      story.check("Arbor's main thread has waited a twentieth of a second for each at most", two.mac.secondsTheMainThreadWaited - waited <= 8 * 0.05 + 0.01, "\(two.mac.secondsTheMainThreadWaited - waited) s")
+    }
+  }
+
+  // That a window has opened is a fact as well. Its number would have to be asked for; the element that comes with the report is kept instead.
+  book.story("an app opens a window and hangs for 5 s half a millisecond later") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    let waited = one.mac.secondsTheMainThreadWaited
+    let new = one.mac.open("new", in: window.app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    one.mac.later(0.0005) { one.mac.hang(window.app, for: 5) }
+    one.mac.pass(9)
+    story.check("Arbor's main thread has not waited for the app", one.mac.secondsTheMainThreadWaited - waited < 0.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+    story.check("in the end Arbor knows the new window", one.known.contains(new.number), "\(one.known)")
+  }
+
+  // Reports as late as Finder's and Terminal's of their moves (0.3 to 0.55 s; of the keyboard nobody has measured any). An app that attends is asked, and believed.
+  for late in [0.3, 0.55] {
+    book.story("the keyboard goes to another window of an app whose reports are \(late) s late, and 0.2 s later Arbor is told to float the window that has it") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        let app = mac.launch("Terminal")
+        theirs = [mac.open("a", in: app, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+      }
+      story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+      _ = two.run("state", then: 3)
+      let had = two.mac.keyWindow!
+      let other = theirs.first { $0 !== had }!
+      other.app.reportsLateBy = late
+      two.mac.appMakesKey(other)
+      two.mac.pass(0.2)
+      let result = two.run("float", then: 3)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("the window that has the keyboard floats", !two.isDocked(other), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+      story.check("the one that had it before stays docked", two.isDocked(had), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+    }
+  }
+
+  // The second and third look at a new element that is no window (yet), 0.3 and 0.6 s later.
+  for subrole in ["AXDialog", "AXUnknown"] {
+    book.story("an app that is busy 0.7 s at a time opens a panel (\(subrole)) in a moment of attention") { story in
+      var window: FakeMac.Window!
+      let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+      let waited = one.mac.secondsTheMainThreadWaited
+      _ = one.mac.open("Saving…", in: window.app, frame: CGRect(x: 150, y: 150, width: 300, height: 100), subrole: subrole, takesKeyboard: false)
+      one.mac.later(0.02) { one.mac.keepsBusy(window.app, for: 5) }
+      one.mac.pass(8)
+      story.check("Arbor's main thread has not waited for the app", one.mac.secondsTheMainThreadWaited - waited < 0.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+    }
+  }
+
+  // A pause and a resume while a knock is out.
+  book.story("an app moves a window and hangs, Arbor's layer is stopped and started while the knock is out, and the app wakes") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    one.mac.appMoves(windows[0], to: CGRect(x: 120, y: 200, width: 400, height: 300))
+    one.mac.later(0.0005) { one.mac.hang(windows[0].app, for: 0.6) }
+    one.mac.pass(0.1)
+    one.layer.stop()
+    one.mac.pass(0.1)
+    one.layer.start()
+    one.heard.clear()
+    one.mac.pass(0.1)
+    one.mac.later(0.5) { one.mac.appMoves(windows[1], to: CGRect(x: 540, y: 220, width: 400, height: 300)) }
+    one.mac.pass(6)
+    let known = Dictionary(uniqueKeysWithValues: one.layer.allWindows().map { ($0.id.rawValue, $0.frame) })
+    story.check("in the end Arbor knows both windows, where they are", windows.allSatisfy { known[$0.number] == $0.frame }, "\(known); \(one.heard.texts)")
+  }
+
+  book.story("an app moves a window and hangs, Arbor's layer is stopped while the knock is out, the app wakes, and the layer is started") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    one.mac.appMoves(windows[0], to: CGRect(x: 120, y: 200, width: 400, height: 300))
+    one.mac.later(0.0005) { one.mac.hang(windows[0].app, for: 0.3) }
+    one.mac.pass(0.1)
+    one.layer.stop()
+    one.mac.pass(0.5)
+    one.layer.start()
+    one.mac.pass(1)
+    one.mac.appMoves(windows[1], to: CGRect(x: 540, y: 220, width: 400, height: 300))
+    one.mac.pass(3)
+    let known = Dictionary(uniqueKeysWithValues: one.layer.allWindows().map { ($0.id.rawValue, $0.frame) })
+    story.check("what the app does from then on is heard", windows.allSatisfy { known[$0.number] == $0.frame }, "\(known); \(one.heard.texts)")
+  }
+
+  // While it is stopped the layer hears nothing: what an app said before is worth nothing after.
+  book.story("Arbor's layer is stopped, the keyboard goes to another window of the app in front, the layer is started, and is asked who has it while the app is busy for 0.7 s") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Notes")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    let had = one.layer.focusedWindow()?.rawValue
+    let other = windows.first { $0.number != had }!
+    one.layer.stop()
+    one.mac.appMakesKey(other)
+    one.mac.pass(1)
+    one.layer.start()
+    one.mac.pass(1)
+    one.mac.hang(other.app, for: 0.7)
+    story.check("the answer is the window that has it", one.layer.focusedWindow()?.rawValue == other.number)
+  }
+
+  // An echo is Arbor's own by its frame, until somebody else has moved the window. The filter has to hear of that whichever way Arbor does: here the report was dropped behind the door.
+  book.story("Arbor gives a window a frame; later its app moves it away and hangs for 3 s; later still it is moved back") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    let target = CGRect(x: 12, y: 43, width: 500, height: 650)
+    _ = one.layer.setFrame(target, of: WindowID(window.number))
+    one.mac.pass(5)
+    one.heard.clear()
+    let elsewhere = target.offsetBy(dx: 200, dy: 40)
+    one.mac.appMoves(window, to: elsewhere)
+    one.mac.later(0.0005) { one.mac.hang(window.app, for: 3) }
+    one.mac.pass(8)
+    story.check("the move away counts as somebody's doing", one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+    one.heard.clear()
+    one.mac.appMoves(window, to: target)
+    one.mac.pass(3)
+    story.check("so does the move back", one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+  }
+
+  book.story("Arbor gives a window a frame; later it is dragged away, its app saying nothing until it is over and hanging as it is let go; later still it is moved back") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    let target = CGRect(x: 12, y: 43, width: 500, height: 650)
+    _ = one.layer.setFrame(target, of: WindowID(window.number))
+    one.mac.pass(5)
+    window.app.isSilentDuringDrags = true
+    one.mac.drag(from: CGPoint(x: 200, y: 55), to: CGPoint(x: 500, y: 155))
+    one.mac.hang(window.app, for: 3)
+    one.mac.release()
+    one.mac.pass(0.5)
+    story.check("the drag counts as somebody's doing", one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+    one.heard.clear()
+    one.mac.changeSilently(window, to: target)
+    one.mac.pass(5)
+    one.mac.appMoves(window, to: target.offsetBy(dx: 1, dy: 0))
+    one.mac.pass(3)
+    story.check("so does the move back", one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+  }
+
+  // Whoever watches a window under a press asks about what the window server lists, which can be behind. That settles nothing.
+  book.story("Arbor gives a window of an app whose reports are 0.5 s late a frame, the window server lists it 0.2 s late, and 0.16 s after the call the person selects text in it") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Terminal"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    window.app.reportsLateBy = 0.5
+    one.mac.serverListsACallAfter = 0.2
+    let target = CGRect(x: 140, y: 120, width: 500, height: 400)
+    one.heard.clear()
+    _ = one.layer.setFrame(target, of: WindowID(window.number))
+    one.mac.pass(0.16)
+    one.mac.press(at: CGPoint(x: 300, y: 300))
+    one.mac.pass(0.01)
+    one.mac.moveMouse(to: CGPoint(x: 310, y: 300))
+    one.mac.pass(0.01)
+    one.mac.moveMouse(to: CGPoint(x: 320, y: 300))
+    one.mac.pass(0.3)
+    one.mac.release()
+    one.mac.pass(3)
+    story.check("the reports of Arbor's move are served", one.heard.all.contains { if case .changed = $0 { true } else { false } }, one.heard.texts)
+    story.check("and none of them counts as the person's doing", !one.heard.all.contains(.changed(window.number, byUser: true)), one.heard.texts)
+  }
+
+  // An app is hidden while a knock is out and goes unanswered.
+  book.story("a window is renamed, its app hangs for 4 s, and meanwhile the person hides the app") { story in
+    var mine: FakeMac.Window!, theirs: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      mine = mac.open("mine", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+      theirs = mac.open("theirs", in: mac.launch("Mail"), frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    }
+    _ = mine
+    one.mac.rename(theirs, "new")
+    one.mac.later(0.0005) { one.mac.hang(theirs.app, for: 4) }
+    one.mac.pass(0.2)
+    one.mac.hide(theirs.app)
+    one.mac.pass(9)
+    story.check("in the end Arbor knows that it is hidden", one.snapshot(theirs)?.isHidden == true, one.heard.texts)
+    story.check("and its new title", one.snapshot(theirs)?.title == "new")
+  }
+
+  // The window with the keyboard is sent to another Space, and nothing says so. What the app answers then is the model's guess.
+  book.story("the only window of the app in front is sent to another Space, and three seconds later Arbor's layer is asked who has the keyboard") { story in
+    var window: FakeMac.Window!
+    let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+    story.check("to begin with it has the keyboard", one.layer.focusedWindow()?.rawValue == window.number)
+    one.mac.send(window, toSpace: 2)
+    one.mac.pass(3)
+    story.check("nobody has it", one.layer.focusedWindow() == nil, "\(String(describing: one.layer.focusedWindow()))")
+  }
+
+  // Whether a window has the keyboard already, so that it need not be given it.
+  book.story("the keyboard goes to another window of an app whose reports are 0.5 s late, and 0.2 s later Arbor's layer is asked to give it back") { story in
+    var windows: [FakeMac.Window] = []
+    let one = StoreyOne(story) { mac in
+      let app = mac.launch("Terminal")
+      windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+    }
+    let had = windows.first { $0.number == one.layer.focusedWindow()?.rawValue }!
+    let other = windows.first { $0 !== had }!
+    other.app.reportsLateBy = 0.5
+    one.mac.appMakesKey(other)
+    one.mac.pass(0.2)
+    one.layer.focus(WindowID(had.number))
+    one.mac.pass(3)
+    story.check("it has it again", one.mac.keyWindow === had, "w\(one.mac.keyWindow?.number ?? 0) has it")
+  }
+
+  // "Shown" finds the app silent. Somebody has to look at the windows that could not be told from dialogs when it answers again. Red before anybody knocked, too.
+  book.story("a dialog opens as its app is hidden; later the app is shown again and hangs for 3 s half a millisecond later") { story in
+    var mine: FakeMac.Window!, theirs: FakeMac.Window!
+    let one = StoreyOne(story) { mac in
+      mine = mac.open("mine", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+      theirs = mac.open("theirs", in: mac.launch("Mail"), frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+    }
+    _ = one.mac.open("Save changes?", in: theirs.app, frame: CGRect(x: 570, y: 150, width: 300, height: 200), subrole: "AXDialog")
+    one.mac.pass(0.002)
+    one.mac.hide(theirs.app)
+    one.mac.pass(3)
+    one.mac.activate(theirs.app)
+    one.mac.later(0.0005) { one.mac.hang(theirs.app, for: 3) }
+    one.mac.pass(9)
+    story.check("Arbor knows that its window shows again", one.snapshot(theirs)?.isHidden == false)
+    story.check("and does not take the dialog for a window", one.known.sorted() == [mine.number, theirs.number], "\(one.known); \(one.heard.texts)")
+  }
+
+  // However long ago. Nobody has seen such a report lost.
+  for seconds in [3.0, 60.0] {
+    book.story("the keyboard goes to another window of the app in front, no report of that ever arrives, and \(seconds) s later Arbor is told to float the window that has it") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        let app = mac.launch("Terminal")
+        theirs = [mac.open("a", in: app, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+      }
+      story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+      _ = two.run("state", then: 3)
+      let had = two.mac.keyWindow!
+      let other = theirs.first { $0 !== had }!
+      other.app.reportsLateBy = 1000
+      two.mac.appMakesKey(other)
+      two.mac.pass(seconds)
+      let result = two.run("float", then: 3)
+      story.check("Arbor takes the command", result.ok, result.message)
+      story.check("the window that has the keyboard floats", !two.isDocked(other), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+      story.check("the one that had it before stays docked", two.isDocked(had), "docked: \(theirs.map { "w\($0.number) \(two.isDocked($0))" })")
+    }
+  }
+
+  // What that costs a person: a floating window, put back by hand where Arbor had once put it, is remembered where it is not.
+  book.story("a window floats where Arbor put it; something moves it away as its app hangs for 3 s; it is moved back; the view goes elsewhere and comes back") { story in
+    var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+    let two = StoreyTwo(story) { mac in
+      mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+      let app = mac.launch("Other")
+      theirs = [mac.open("a", in: app, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+    }
+    story.check("three windows are arranged", two.run("arrange", then: 2).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+    story.check("one is floated", two.run("float \(mine.number)", then: 3).ok && !two.isDocked(mine))
+    let home = mine.frame
+    let away = home.offsetBy(dx: 150, dy: 90)
+    two.mac.appMoves(mine, to: away)
+    two.mac.later(0.0005) { two.mac.hang(mine.app, for: 3) }
+    two.mac.pass(8)
+    two.mac.appMoves(mine, to: home)
+    two.mac.pass(3)
+    story.check("it stands where it was moved back to", mine.frame == home, two.whereabouts(mine))
+    let remembered = two.controller.workspaces.values.compactMap { $0.floating[WindowID(mine.number)] }.first
+    story.check("and that is where Arbor remembers it", remembered == home, "remembered \(remembered?.text ?? "nowhere"), home \(home.text), away \(away.text)")
+    _ = two.run("pause", then: 2)
+    _ = two.run("resume", then: 3)
+    story.check("after a pause it stands there still", mine.frame == home, two.whereabouts(mine))
+    _ = two.run("zoom \(theirs[0].number)", then: 3)
+    _ = two.run("show-all", then: 3)
+    story.check("after the view has been elsewhere it stands there again", mine.frame == home, "\(two.whereabouts(mine)), home \(home.text), away \(away.text)")
+  }
+
+  // From the polite walk (`polite|489|hide 71 93; open 21 15 +0.002; hang 62 1; space 92 92`). New it is at any moment, since the element is kept. On which Space it is, is the listed fault, and the
+  // moment up to which the hang brings it out is a hop later than before anybody knocked (2.3 ms against 1.9).
+  for tenths in [5, 21, 40] {
+    book.story("an app opens a window and hangs \(Double(tenths) / 10) ms later; the Space changes; the app wakes") { story in
+      var window: FakeMac.Window!
+      let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+      one.heard.clear()
+      window.app.reportsFocusBeforeCreated = true
+      let new = one.mac.open("new", in: window.app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))
+      one.mac.later(Double(tenths) / 10_000) { one.mac.hang(window.app) }
+      one.mac.pass(4)
+      one.mac.switchSpace(to: 3)
+      one.mac.pass(2)
+      one.mac.wake(window.app)
+      one.mac.pass(4)
+      story.check("the new window is announced as new", one.heard.all.contains(.appeared(new.number)) && !one.heard.all.contains(.found(new.number)), one.heard.texts)
+      story.check("and Arbor knows that it is not on the Space that shows", one.snapshot(new)?.isOnActiveSpace == false, "\(String(describing: one.snapshot(new)?.isOnActiveSpace))")
+    }
+  }
+
+  // The same with a plain AppKit app: something else of the app's shuts the door a moment before "destroyed" arrives.
+  for seconds in [5.0, 30.0] {
+    book.story("a window closes, its app renames another as it goes, and hangs for \(seconds) s as both reports are on their way") { story in
+      var windows: [FakeMac.Window] = []
+      let one = StoreyOne(story) { mac in
+        let app = mac.launch("Notes")
+        windows = [mac.open("a", in: app, frame: CGRect(x: 100, y: 100, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 520, y: 100, width: 400, height: 300))]
+      }
+      one.heard.clear()
+      one.mac.close(windows[1])
+      one.mac.later(0.0119) { one.mac.rename(windows[0], "a, alone") }
+      one.mac.later(0.0125) { one.mac.hang(windows[0].app, for: seconds) }
+      one.mac.pass(4)
+      story.check("it is reported gone within four seconds", one.heard.all.contains(.destroyed(windows[1].number)), one.heard.texts)
+      one.mac.pass(seconds + 3)
+      story.check("once", one.heard.all.filter { $0 == .destroyed(windows[1].number) }.count == 1, one.heard.texts)
+    }
+  }
+
+  // "Nothing is promised about the moment after" (`AXKnocks`): an app that answers the knock and is BUSY again, not hung, answers within the timeout and is never put on record. A limit of the idea:
+  // how many calls a busy app answers in a row only a Mac can say.
+  for calls in [1, 3, 10] {
+    book.story("an app moves its six windows; it is busy 0.7 s at a time, and each time it attends it answers \(calls) calls") { story in
+      var windows: [FakeMac.Window] = []
+      let one = StoreyOne(story) { mac in
+        let app = mac.launch("Notes")
+        windows = (0..<6).map { mac.open("w\($0)", in: app, frame: CGRect(x: 100 + 40 * CGFloat($0), y: 100, width: 400, height: 300)) }
+      }
+      let app = windows[0].app
+      let waited = one.mac.secondsTheMainThreadWaited
+      let end = one.mac.now + 20
+      var wakes = false
+      // Looks every millisecond, whatever Arbor's main thread does: an app that has begun to work goes on for 0.7 s, attends, and answers so many calls.
+      func watch() {
+        guard one.mac.now < end else { return app.hangsAfterCalls = nil }
+        if app.isHung, !wakes {
+          wakes = true
+          one.mac.later(0.7) {
+            one.mac.wake(app)
+            app.hangsAfterCalls = calls
+            wakes = false
+          }
+        }
+        one.mac.later(0.001) { watch() }
+      }
+      for window in windows { one.mac.appMoves(window, to: window.frame.offsetBy(dx: 0, dy: 120)) }
+      one.mac.later(0.0005) { one.mac.hang(app) }
+      watch()
+      one.mac.pass(21)
+      if app.isHung { one.mac.wake(app) }
+      one.mac.pass(5)
+      story.check("Arbor's main thread waits 0.1 s at most", one.mac.secondsTheMainThreadWaited - waited <= 0.1, "\(one.mac.secondsTheMainThreadWaited - waited) s")
+      let known = Dictionary(uniqueKeysWithValues: one.layer.allWindows().map { ($0.id.rawValue, $0.frame) })
+      story.check("in the end Arbor knows where all six are", windows.allSatisfy { known[$0.number] == $0.frame }, "\(known)")
+    }
+  }
+
+  // A close with the real controller on top: what the controller asks when it hears "gone".
+  for (name, then) in [("hangs for 5 s", { (mac: FakeMac, app: FakeMac.App) in mac.hang(app, for: 5) }), ("is busy 0.7 s at a time", { mac, app in mac.keepsBusy(app, for: 5) })] {
+    book.story("a docked window closes, and as that is on its way to Arbor its app \(name)") { story in
+      var mine: FakeMac.Window!, theirs: [FakeMac.Window] = []
+      let two = StoreyTwo(story) { mac in
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+        let app = mac.launch("Notes")
+        theirs = [mac.open("a", in: app, frame: CGRect(x: 500, y: 60, width: 400, height: 300)), mac.open("b", in: app, frame: CGRect(x: 500, y: 380, width: 400, height: 300))]
+      }
+      story.check("three windows are arranged", two.run("arrange", then: 3).ok && (theirs + [mine]).allSatisfy { two.isDocked($0) })
+      two.mac.pass(1)
+      func inCalls() -> (total: Double, worst: Double) { CallStats.shared["accessibility calls by thread", "main thread"].map { ($0.total, $0.worst) } ?? (0, 0) }
+      CallStats.shared.reset()
+      two.mac.close(theirs[1])
+      two.mac.pass(0.013)
+      then(two.mac, theirs[0].app)
+      two.mac.pass(0.3)
+      story.check("it is reported gone within a third of a second", two.heard.all.contains(.destroyed(theirs[1].number)))
+      two.mac.pass(9)
+      story.check("Arbor's main thread has spent 0.1 s at most in calls to apps", inCalls().total <= 0.1, "\(inCalls().total) s, the longest \(inCalls().worst) s")
+    }
+  }
+
+  // At "activated" and "deactivated" the controller asks at once who has the keyboard.
+  for ms in [5.0, 8.0] {
+    book.story("an app comes forward and is busy for 0.7 s from \(ms) ms after") { story in
+      var mine: FakeMac.Window!, theirs: FakeMac.Window!
+      let two = StoreyTwo(story) { mac in
+        theirs = mac.open("theirs", in: mac.launch("Busy"), frame: CGRect(x: 500, y: 60, width: 400, height: 300))
+        mine = mac.open("mine", in: mac.launch("Mine"), frame: CGRect(x: 60, y: 100, width: 400, height: 300))
+      }
+      story.check("two windows are arranged", two.run("arrange", then: 3).ok && [theirs!, mine!].allSatisfy { two.isDocked($0) })
+      func inCalls() -> (total: Double, worst: Double) { CallStats.shared["accessibility calls by thread", "main thread"].map { ($0.total, $0.worst) } ?? (0, 0) }
+      CallStats.shared.reset()
+      let waited = two.mac.secondsTheMainThreadWaited
+      two.mac.activate(theirs.app)
+      two.mac.later(ms / 1000) { two.mac.hang(theirs.app, for: 0.7) }
+      two.mac.pass(3)
+      story.check("Arbor's main thread has spent 0.1 s at most in calls to apps", inCalls().total <= 0.1, "\(inCalls().total) s, the longest \(inCalls().worst) s")
+      story.check("and has waited 0.1 s at most for another thread's", two.mac.secondsTheMainThreadWaited - waited <= 0.1, "\(two.mac.secondsTheMainThreadWaited - waited) s")
+    }
+  }
+
+  // From the polite walk at 100 steps (`polite|271|tab 81 94 +0.002; move 86 8`): the listed fault of a list that is read once, its gap a hop wider (2.3 ms against 1.9).
+  for tenths in [15, 21, 30] {
+    book.story("a window gets a new tab, which its app moves \(Double(tenths) / 10) ms later") { story in
+      var window: FakeMac.Window!
+      let one = StoreyOne(story) { mac in window = mac.open("window", in: mac.launch("Notes"), frame: CGRect(x: 100, y: 100, width: 400, height: 300)) }
+      one.heard.clear()
+      window.app.reportsFocusBeforeCreated = true
+      let tab = one.mac.newTab(of: window)
+      one.mac.later(Double(tenths) / 10_000) { one.mac.appMoves(tab, to: CGRect(x: 240, y: 110, width: 260, height: 300)) }
+      one.mac.pass(3)
+      story.check("the tab is not announced as a window of its own", !one.heard.all.contains(.appeared(tab.number)), one.heard.texts)
+    }
+  }
+}
