@@ -0,0 +1,1095 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// A floating window's frame is its person's, with one exception, because "never lost" outranks "never moved"
+/// (QUESTIONS, Q20): if the displays have changed and less than half of the window would show, it is fitted: moved
+/// the least that brings it wholly into view, and made smaller only if it is larger than the display.
+///
+/// What no display showed at all was always looked after. Between a sliver and a half nobody did: Arbor made no
+/// call, the window did not count as out of view, and so `home`, Show Everything, ⌘Tab, `focus` and `reveal` ("is in
+/// view") had nothing to fetch.
+@Suite @MainActor struct ADisplayThatShrankTests {
+  nonisolated static func display(_ width: CGFloat, _ height: CGFloat) -> DisplaySnapshot {
+    DisplaySnapshot(
+      id: DisplayID("main"), frame: CGRect(x: 0, y: 0, width: width, height: height),
+      visibleFrame: CGRect(x: 0, y: 25, width: width, height: height - 25), isMain: true, isBuiltIn: true)
+  }
+  nonisolated static let small = display(800, 600)
+
+  /// A quarter of it shows on the small display.
+  nonisolated static let chosen = CGRect(x: 724, y: 216, width: 300, height: 400)
+
+  enum Scene: String, CaseIterable, CustomTestStringConvertible {
+    /// `[Safari | Desktop | Notes]`, everything in view, and the chat partly over Notes, where only a hand puts a
+    /// window.
+    case overADockedWindow
+    /// Safari is framed, and the chat was opened over it.
+    case aGuestOfAFramedWindow
+    /// Safari is framed, and the chat has come back out of the Dock: in view over it, and nobody's guest.
+    case backFromTheDockOverAFramedWindow
+    var testDescription: String { rawValue }
+  }
+
+  /// The chat has a process of its own, so that it can hang alone.
+  func make(_ scene: Scene, chatAt frame: CGRect = chosen, restingFor rest: Double = 5) -> (Harness, chat: WindowID) {
+    let h = Harness()
+    let a = h.system.open(app: "Safari", pid: 1001)
+    let b = h.system.open(app: "Notes", pid: 1002)
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) right")
+    if scene == .aGuestOfAFramedWindow { h.run("zoom \(a.rawValue)") }
+    let chat = h.system.open(app: "Chat", pid: 1003, frame: CGRect(origin: CGPoint(x: 560, y: 200), size: frame.size))
+    if scene == .backFromTheDockOverAFramedWindow {
+      h.system.setMinimized(chat, true)
+      h.run("zoom \(a.rawValue)")
+      h.system.setMinimized(chat, false)
+      #expect(h.workspace.guests?[chat] == nil)
+      #expect(h.workspace.camera == h.workspace.tree.leaf(containing: a))
+    }
+    h.system.userMove(chat, to: frame)
+    h.scheduler.advance(by: rest)
+    #expect(h.frame(chat) == frame, "where its person put it")
+    h.system.clearFrameLog()
+    return (h, chat)
+  }
+
+  func moves(of window: WindowID, _ h: Harness) -> [CGRect] {
+    h.system.frameLog.filter { $0.window == window }.map(\.frame)
+  }
