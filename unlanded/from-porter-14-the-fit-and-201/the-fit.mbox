+  /// Plays a script of the chaos lab's. Where window 102 ends, how often Arbor asked it to move, and the rules broken.
+  func play(_ script: String) -> (frame: CGRect, requests: Int, broken: [String]) {
+    let runner = ChaosRunner()
+    var broken: [String] = []
+    for action in ChaosAction.script(script) { broken += runner.step(action).map(\.rule) }
+    return (runner.system.frame(of: WindowID(102))!, runner.system.frameLog.filter { $0.window == WindowID(102) }.count, broken)
+  }
+
+  /// Safari docked on the right, and a hand has pushed the chat aside over it until four tenths show. A minute passes, or
+  /// (`REST`) a moment: then what showed "before" is not believed on a display that has got smaller.
+  nonisolated static let pushedAside = """
+    mac-tiling off
+    displays main:0,0,1440,900:25,0,0,0* BESIDE ORDER
+    launch
+    open 101 Safari pid 1000 at 100 100 900 600 min 100 100
+    open 102 Chat pid 1001 at 100 200 400 400 min 100 100
+    open 103 Notes pid 1002 at 60 500 300 300 min 100 100
+    dock 101 right
+    settle
+    move 102 1280 300 400 400
+    settle
+    advance REST
+
+    """
+  nonisolated static func pushedAside(_ order: String, restingFor rest: Int = 60, beside: String = "", then later: String) -> String {
+    (pushedAside + later).replacingOccurrences(of: "BESIDE ", with: beside.isEmpty ? "" : beside + " ")
+      .replacingOccurrences(of: "ORDER", with: order).replacingOccurrences(of: "REST", with: "\(rest)")
+  }
+  nonisolated static let whereTheHandPushedIt = CGRect(x: 1280, y: 300, width: 400, height: 400)
+  nonisolated static let orders = ["windows-never", "windows-silent", "windows-late", "windows-first"]
+  nonisolated static let waysToBeAway = [
+    ["minimize 102", "restore 102"], ["hang 1001", "wake 1001"], ["hide 1001", "show 1001"], ["space 102 off", "space 102 on"],
+  ]
+
+  /// It could not be moved while the display was smaller, and the display is as it was again: as much shows as its person left
+  /// showing. Nothing is owed any more, however little that is. (It leapt 966 points when it came back, minutes later.)
+  @Test(arguments: waysToBeAway, orders) func whatTheDisplayGaveBackIsOwedNothing(_ away: [String], order: String) {
+    for rest in [5, 60] {
+      let end = play(
+        Self.pushedAside(
+          order, restingFor: rest,
+          then: """
+            \(away[0])
+            displays main:0,0,1340,840:25,0,0,0* ORDER
+            settle
+            advance 60
+            displays main:0,0,1440,900:25,0,0,0* ORDER
+            settle
+            advance 120
+            \(away[1])
+            settle
+            advance 10
+            focus 102
+            settle
+            """))
+      #expect(end.frame == Self.whereTheHandPushedIt, "put there \(rest) s before")
+      #expect(end.requests == 0, "put there \(rest) s before")
+      #expect(end.broken == [])
+    }
+  }
