+  /// The same display with another size: the menu bar and the Dock keep their heights.
+  static func resized(_ display: DisplaySnapshot, to size: CGSize) -> DisplaySnapshot {
+    var changed = display
+    let top = display.visibleFrame.minY - display.frame.minY
+    let bottom = display.frame.maxY - display.visibleFrame.maxY
+    changed.frame.size = size
+    changed.visibleFrame = CGRect(
+      x: display.frame.minX, y: display.frame.minY + top, width: size.width, height: size.height - top - bottom)
+    return changed
+  }
+
+  /// In a replay's harness nobody listens to the fake: the replayer delivers the events itself. So the controller is
+  /// told.
+  static func tell(_ h: Harness, of display: DisplaySnapshot) {
+    h.system.setDisplays([display])
+    h.controller.displaysChanged()
+    h.scheduler.runPending()
+  }
+
+  /// The traces are of one display that never changes. So every state that real apps and a real pointer brought
+  /// about (each trace cut before every stimulus, also in the middle of drags) has its display changed under it.
+  /// What was in view is in view afterwards, or stands in a tile that can be clicked, without anybody doing
+  /// anything.
+  @Test(arguments: TraceCorpusTests.names)
+  func underEveryStateOfATraceTheDisplayChangesAndNoWindowIsLeftBehind(name: String) throws {
+    let text = try String(contentsOf: TraceCorpusTests.folder.appendingPathComponent("\(name).jsonl"), encoding: .utf8)
+    let lines = text.split(separator: "\n", omittingEmptySubsequences: false)
+    let cuts = try Trace(text: text).entries.filter { $0.line.isStimulus && !$0.nested }.map(\.number) + [lines.count + 1]
+    for cut in cuts where cut > 2 {
+      let prefix = try Trace(text: lines.prefix(cut - 1).joined(separator: "\n"))
+      // A window that is being dragged is where the hand holds it, which can be half off the screen. Nobody misses
+      // it.
+      var inHand: WindowID?
+      for entry in prefix.entries {
+        switch entry.line {
+        case .dragBegan(let id, _): inHand = id
+        case .dragEnded, .other(.event, "dragCancelled", _, _): inHand = nil
+        default: break
+        }
+      }
+      let replayer = TraceReplayer(prefix)
+      replayer.run()
+      let h = replayer.harness
+      // A trace ends when Arbor pauses or quits.
+      guard h.controller.isRunning, let display = h.system.displayList.first else { continue }
+      let open = h.system.windows.values.map(\.snapshot)
+      let inView = Set(open.filter { $0.isPresent && h.system.isVisible($0.id) }.map(\.id))
+      for change in ["shrinks", "shrinks and is as it was"] {
+        Self.tell(h, of: change == "shrinks" ? Self.resized(display, to: CGSize(width: 800, height: 600)) : display)
+        let inTiles = Set(h.layout?.tiles.flatMap(\.windows) ?? [])
+        let lost = h.system.windows.values.map(\.snapshot)
+          .filter { $0.isPresent && inView.contains($0.id) && !h.system.isVisible($0.id) }
+          .filter { $0.id != inHand && !inTiles.contains($0.id) }
+          .map { "\($0.id) \($0.appName) at \(traceText($0.frame))" }.sorted()
+        #expect(lost == [], "After the first \(cut - 1) lines of \(name).jsonl the display \(change)")
+      }
+    }
+  }
+}
