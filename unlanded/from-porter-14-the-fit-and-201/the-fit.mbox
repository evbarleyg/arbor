+  @Test(arguments: orders, [5, 60]) func aDisplayThatOnlyGrowsPullsInNoStrip(order: String, restingFor rest: Int) {
+    let end = play(
+      """
+      mac-tiling off
+      displays main:0,0,1440,900:25,0,0,0* \(order)
+      launch
+      open 101 Safari pid 1000 at 100 100 900 600 min 100 100
+      open 102 Chat pid 1001 at 800 200 400 400 min 100 100
+      dock 101 left
+      settle
+      move 102 -250 300 400 400
+      settle
+      advance \(rest)
+      displays main:0,0,1728,1117:25,0,0,0* \(order)
+      settle
+      advance 10
+      """)
+    #expect(end.frame == CGRect(x: -250, y: 300, width: 400, height: 400))
+    #expect(end.requests == 0)
+  }
+
+  /// `soleFloatTakesDesktop`: alone on the Desktop it fills it, and is owed that as well when its app answers.
+  @Test func aloneOnTheDesktopItIsPaidToo() {
+    var settings = Settings()
+    settings.soleFloatTakesDesktop = true
+    let h = Harness(settings: settings)
+    let a = h.system.open(app: "Safari", pid: 1001)
+    let b = h.system.open(app: "Notes", pid: 1002)
+    let chat = h.system.open(app: "Chat", pid: 1003)
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) right")
+    h.scheduler.advance(by: 5)
+    #expect(h.frame(chat) == h.layout!.desktopFrame)
+    h.system.setUnresponsive(pid: 1003, true)
+    h.system.setDisplays([Self.small])
+    h.scheduler.advance(by: 5)
+    // Filling has its own entry in the books of missed moves. At macOS's next, idle report the debt stands all the same.
+    h.system.setDisplays([Self.small])
+    h.scheduler.advance(by: 5)
+    h.system.setUnresponsive(pid: 1003, false)
+    h.scheduler.advance(by: 5)
+    #expect(Self.small.visibleFrame.contains(h.frame(chat)!), "\(h.frame(chat)!)")
+  }
+
+  // MARK: Another display's doing
+
+  /// It hangs over to the neighbour, which goes. Its own display is as it was, so the place still looks like one its
+  /// person chose on this very display; but they chose it with a display beyond the edge.
+  @Test func whenTheNeighbourItHungOverToGoesItIsFitted() {
+    let h = Harness(displays: [FakeWindowSystem.standardDisplay, Self.side])
+    h.start()
+    let chat = h.system.open(app: "Chat", frame: CGRect(x: 300, y: 200, width: 1000, height: 780))
+    // Its middle is on the main display, and more of it shows on the other: 38 % and 48 %.
+    let place = CGRect(x: 930, y: 300, width: 1000, height: 780)
+    h.system.userMove(chat, to: place)
+    h.scheduler.advance(by: 5)
+    #expect(h.controller.workspaceID(containing: chat) == h.display)
+    h.system.clearFrameLog()
+    h.system.setDisplays([FakeWindowSystem.standardDisplay])
+    h.scheduler.advance(by: 5)
+    #expect(h.visibleFrame.contains(h.frame(chat)!), "\(h.frame(chat)!)")
