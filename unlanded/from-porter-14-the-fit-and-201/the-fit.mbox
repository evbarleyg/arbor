+  // MARK: Real windows
+
+  /// Where the fault was found: the last state of a trace of real windows, in which a gap had been dragged until the
+  /// Desktop was narrow. On the smaller display the Desktop's space is only a tile.
+  @Test(arguments: [CGSize(width: 800, height: 600), CGSize(width: 960, height: 600), CGSize(width: 900, height: 700)])
+  func theDesktopIsOnlyATileAfterwards(size: CGSize) throws {
+    let text = try String(contentsOf: TraceCorpusTests.folder.appendingPathComponent("seam-drag.jsonl"), encoding: .utf8)
+    let replayer = TraceReplayer(try Trace(text: text))
+    replayer.run()
+    let h = replayer.harness
+    let floating = try #require(h.workspace.floating.keys.sorted().first)
+    h.system.clearFrameLog()
+    let changed = Self.resized(h.system.displayList[0], to: size)
+    Self.tell(h, of: changed)
+    #expect(changed.visibleFrame.contains(h.frame(floating)!), "\(h.frame(floating)!)\n\(h.ascii())")
+    #expect(moves(of: floating, h).count <= 1, "\(moves(of: floating, h))")
+  }
