+  /// Asked through Accessibility for a place under the menu bar or above the display, a test window went to the top of the visible frame and
+  /// kept its x and its size: the eight recorded calls, by the visible frame they were made in (the Dock at the bottom, at the left, hidden;
+  /// 1920×1080 beside a second display) and the x the window stood at.
+  @Test(arguments: [
+    (CGSize(width: 1024, height: 768), CGRect(x: 0, y: 31, width: 1024, height: 674), 170),
+    (CGSize(width: 1024, height: 768), CGRect(x: 50, y: 31, width: 974, height: 737), 220),
+    (CGSize(width: 1024, height: 768), CGRect(x: 0, y: 31, width: 1024, height: 737), 170),
+    (CGSize(width: 1920, height: 1080), CGRect(x: 0, y: 31, width: 1920, height: 971), 170),
+  ] as [(CGSize, CGRect, CGFloat)], [0, -50] as [CGFloat])
+  func askedToGoUnderTheMenuBarAWindowStopsBelowIt(mac: (size: CGSize, visible: CGRect, x: CGFloat), y: CGFloat) {
+    var displays = [DisplaySnapshot(id: DisplayID("main"), frame: CGRect(origin: .zero, size: mac.size), visibleFrame: mac.visible, isMain: true)]
+    if mac.size.width == 1920 {
+      displays.append(
+        DisplaySnapshot(
+          id: DisplayID("beside"), frame: CGRect(x: 1920, y: 0, width: 800, height: 600), visibleFrame: CGRect(x: 1920, y: 31, width: 800, height: 569),
+          isMain: false))
+    }
+    let system = FakeWindowSystem(displays: displays)
+    let window = system.open(app: "Test", frame: CGRect(x: mac.x, y: 220, width: 480, height: 348))
+    let answer = system.setFrame(CGRect(x: mac.x, y: y, width: 480, height: 348), of: window)
+    #expect(answer == CGRect(x: mac.x, y: 31, width: 480, height: 348))
+    #expect(system.frame(of: window) == answer)
+  }
+
+  /// `[a | Desktop]` framed on `a`, so that `f`, which floats, is out of view; on a display with a menu bar and these others around it.
+  func withAWindowOutOfView(around: [CGRect], menuBars: CGFloat = 0, titleBar: CGFloat) -> (Harness, f: WindowID) {
+    let others = around.enumerated().map {
+      DisplaySnapshot(
+        id: DisplayID("other\($0)"), frame: $1, visibleFrame: CGRect(x: $1.minX, y: $1.minY + menuBars, width: $1.width, height: $1.height - menuBars),
+        isMain: false)
+    }
+    let h = Harness(displays: [FakeWindowSystem.standardDisplay] + others)
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let f = h.system.open(app: "Editor", pid: 12, frame: CGRect(x: 560, y: 300, width: 640, height: 420))
+    h.system.setTitleBar(f, titleBar)
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("zoom \(a.rawValue)")
+    return (h, f)
+  }
+
+  /// With a wider display below, the top right corner is where least of a window shows. By what was recorded in the middle of a display it comes to
+  /// rest below the menu bar there, which Arbor took for a refusal: at every report of the displays it asked again. No Mac has
+  /// been watched at a corner.
+  @Test func aWindowParkedAtTheTopIsNotAskedAgain() {
+    let (h, f) = withAWindowOutOfView(around: [CGRect(x: -240, y: 900, width: 1920, height: 1080)], titleBar: 28)
+    #expect(h.frame(f) == CGRect(x: 1439, y: 25, width: 640, height: 420))
+    for _ in 1...3 { #expect(h.measure { h.system.setDisplays(h.system.displayList) }.moves == 0) }
+    // The menu bar stops every window alike, so the stop says nothing of this window's title bar, and nothing is learnt from it: as before.
+    #expect(h.controller.titleBars[f] == nil)
+    #expect(h.controller.titleBar(ofAWindowAt: CGPoint(x: 1439, y: 25), sentTo: CGPoint(x: 1439, y: 0)) == nil)
+  }
+
+  /// Between two displays that begin 380 points lower, Arbor reckoned that 40 rows of a window at the top right corner would show on the neighbour. Below
+  /// the menu bar it is 65, and more than shows of it at the bottom, where its title bar stops it: so that is where it waits.
+  ///
+  /// By Arbor's measure, in which what lies behind a menu bar shows like anything else. With menu bars on the neighbours, as a Mac has them, 25 of
+  /// those 65 rows lie behind one, and clear of it less would show at the top than at the bottom: the choice is the same all the same.
+  @Test(arguments: [0, 25] as [CGFloat]) func whatTheMenuBarPushesIntoViewIsReckonedWith(menuBars: CGFloat) {
+    let around = [CGRect(x: 1440, y: 380, width: 1920, height: 1080), CGRect(x: -1920, y: 380, width: 1920, height: 1080)]
+    let (h, f) = withAWindowOutOfView(around: around, menuBars: menuBars, titleBar: 52)
+    #expect(h.frame(f) == CGRect(x: 0, y: 848, width: 640, height: 420))
+  }
+
+  /// Which display stops a corner that lies on none is a guess, the nearest, and here it decides where a window waits. The top left place lies 500
+  /// points above the left display and 639 from the main one, so that the left display's top is taken to stop it, with all of the
+  /// window in view: it waits at the bottom right, where a title bar's strip shows. Should the display that holds most of a
+  /// window stop it, it would have rested below the main display's menu bar with one point's width in view. No Mac has been asked.
+  @Test func whereTheGuessDecides() {
+    let around = [CGRect(x: 1440, y: 0, width: 1440, height: 900), CGRect(x: -1920, y: 500, width: 1920, height: 1080)]
+    let (h, f) = withAWindowOutOfView(around: around, titleBar: 28)
+    #expect(h.frame(f) == CGRect(x: 1439, y: 872, width: 640, height: 420))
+  }
+
+  /// A third thing follows from the same reckoning. A window of which nothing is known is asked for its size where it stands, before it goes to its
+  /// slot (Controller+AskFirst.swift). One that lies under the menu bar would hop below it at the question, so it is not asked there.
+  @Test(arguments: [(100, 2), (10, 1)] as [(CGFloat, Int)]) func aWindowThatLiesUnderTheMenuBarIsNotAskedForItsSizeThere(y: CGFloat, calls: Int) {
+    let h = Harness()
+    let a = h.system.open(app: "A", pid: 11, frame: CGRect(x: 200, y: y, width: 1000, height: 600))
+    h.start()
+    let mark = h.system.moveLog.count
+    h.run("dock \(a.rawValue) left")
+    #expect(h.system.moveLog[mark...].filter { $0.window == a }.count == calls, "\(h.system.moveLog[mark...])")
+    expectWindowsMatchLayout(h)
+  }
 }
