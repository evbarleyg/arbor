diff --git a/scripts/mac-shell/check-away-is-a-going.sh b/scripts/mac-shell/check-away-is-a-going.sh
new file mode 100755
index 00000000..0c77f0ec
--- /dev/null
+++ b/scripts/mac-shell/check-away-is-a-going.sh
@@ -0,0 +1,134 @@
+#!/bin/bash
+# For whoever is left alone a minimize and a hide are goings like any other (F68): two real apps in two halves, ⌘M and ⌘H by real keys
+# on one of them and back, three rounds each. The other is not named, and Arbor sets no frame on it, at the going or at the return.
+#
+#   scripts/mac-shell/run.sh scripts/mac-shell/check-away-is-a-going.sh
+#   scripts/mac-shell/run.sh scripts/mac-shell/check-away-is-a-going.sh <a branch with this script on the commit before>     the control: there the
+#                                                                        other leaps, and twelve checks say so
+#
+# THE QUESTION ONLY A MAC CAN ANSWER: a real ⌘M is a flight to the Dock of half a second, during which the app is deaf, and a real ⌘H and a click
+# in the Dock come as several reports in an order of macOS's own. Does Arbor hold still through all of them? And is the one that returns in its
+# half in one move?
+# BY THE TRACE: each going and each return is a trace of its own, in which the frames Arbor set are counted for each window. The samples of the screen
+# (lib-day.sh, jolts.py) say the same of what a person saw: `moved-unasked`, `jolt`.
+#
+# Safari and TextEdit: both go narrower than a half of any display here, so that no room has to be made (F61) and nothing moves for that.
+#
+# Only on GitHub's Macs: it opens real apps, quits them, and changes the display's size.
+export DAY_KEEP_PICTURES=1
+source "$(dirname "${BASH_SOURCE[0]}")/lib-day.sh"
+needs_throwaway_mac "open two real apps, minimize and hide them, quit them, and switch the display's size"
+apps_watchdog 900
+
+step "the Mac"
+echo "macOS $(sw_vers -productVersion) ($(sw_vers -buildVersion)) on $(uname -m)"
+day_build
+display_mode 1440x900 1600x900 1680x1050 1920x1080
+day_scratch
+sampler_start
+
+# frames_set <window>: how many frames Arbor has set on it in the trace that is being recorded, one by one or together with others.
+trace_file() { ls -t "$ARBOR_HOME"/traces/*.jsonl 2>/dev/null | head -n 1; }
+frames_set() {
+  local file
+  file=$(trace_file)
+  [ -n "$file" ] || { echo "?"; return; }
+  grep -c -E "\"call\":\"setFrame\".*\"id\":$1[,}]" "$file"
+}
+minimized() { apptool windows "$2" 2> /dev/null | awk -v id="$1" '$1 == id' | grep -q minimized; }
+not_minimized() { ! minimized "$@"; }
+shown() { ! is hidden "$1"; }
+in_front() { [ "$(apptool focused 2> /dev/null | cut -d ' ' -f 1)" = "$1" ]; }
+
+open_app() {
+  local name=$1 bundle=$2
+  shift 2
+  act open-close "open-$name" "opens $name"
+  APP_WAIT=25 APP_OPEN_LIMIT=90 meet "$name" "$bundle" "$@" || echo "$name opened no standard window"
+  app_dismiss "$APP_PID" || echo "a sheet or dialog stayed in the way"
+  acted setup=1
+}
+
+chapter "Before Arbor: two apps are open"
+open_app safari com.apple.Safari "$DAY_DOCUMENTS/$APPS_CANARY-page.html"
+open_app textedit com.apple.TextEdit "$DAY_DOCUMENTS/$APPS_CANARY-oak.txt"
+
+chapter "Two halves, by the two keys"
+act quit-and-start launch "starts Arbor"
+day_launch || die "Arbor did not start"
+acted moves=none everything=1
+welcome=$(arbor_window)
+if [ -n "$welcome" ]; then
+  act open-close close-welcome "closes Arbor's welcome window with its red button"
+  # shellcheck disable=SC2046
+  must click $(apptool button "$welcome" close)
+  acted
+fi
+act dock-key dock-left "clicks Safari and presses ⌃⌥←"
+must dock_click com.apple.Safari
+want "Safari is in front" eventually in_front "$W_safari"
+key ctrl+opt+left
+want "it is docked" eventually is docked "$W_safari"
+acted moves="$W_safari" first=1
+act dock-key dock-right "clicks TextEdit and presses ⌃⌥→"
+must dock_click com.apple.TextEdit
+want "TextEdit is in front" eventually in_front "$W_textedit"
+key ctrl+opt+right
+want "it is docked" eventually is docked "$W_textedit"
+acted moves="$W_textedit" docked="$W_safari,$W_textedit"
+left=$(slot_of "$W_safari") right=$(slot_of "$W_textedit")
+echo "Safari's slot: $left, TextEdit's: $right"
+
+# round <n> <the one that goes> <its bundle> <its pid> <its slot> <the one that stays> <its slot> <⌘M | ⌘H>
+round() {
+  local n=$1 goes=$2 bundle=$3 pid=$4 own=$5 stays=$6 slot=$7 how=$8 x y
+  chapter "$how, round $n"
+  act open-close "front-$n-$how" "clicks the one that is to go, in the Dock"
+  must dock_click "$bundle"
+  want "it is in front" eventually in_front "$goes"
+  acted moves=none front="$goes"
+
+  day_trace
+  act open-close "goes-$n-$how" "presses $how"
+  case "$how" in
+    ⌘M) key cmd+m; want "it is in the Dock" eventually minimized "$goes" "$pid" ;;
+    ⌘H) key cmd+h; want "its app is hidden" eventually is hidden "$goes" ;;
+  esac
+  sleep 2
+  want "at the going Arbor set no frame on the other" test "$(frames_set "$stays")" = 0
+  want "the other has its slot" has_slot "$stays" "$slot"
+  acted moves=none leaves="$goes"
+
+  day_trace
+  act open-close "returns-$n-$how" "brings it back from the Dock"
+  read -r x y <<< "$(apptool dock-window "$goes" 2> /dev/null)"
+  if [ "$how" = ⌘M ] && [ -n "${x:-}" ]; then
+    click "$x" "$y"
+    move "$x" "$((y - 200))"
+  else
+    must dock_click "$bundle"
+  fi
+  want "it is back" eventually not_minimized "$goes" "$pid"
+  want "and shown" eventually shown "$goes"
+  want "and in front" eventually in_front "$goes"
+  sleep 2
+  want "at the return Arbor set no frame on the other" test "$(frames_set "$stays")" = 0
+  want "the other has its slot" has_slot "$stays" "$slot"
+  want "the one that returns has its half" has_slot "$goes" "$own"
+  echo "frames Arbor set on the one that returned: $(frames_set "$goes")"
+  acted moves="$goes" comes="$goes" front="$goes" docked="$W_safari,$W_textedit"
+}
+
+for n in 1 2 3; do round "$n" "$W_safari" com.apple.Safari "$P_safari" "$left" "$W_textedit" "$right" ⌘M; done
+for n in 1 2 3; do round "$n" "$W_textedit" com.apple.TextEdit "$P_textedit" "$right" "$W_safari" "$left" ⌘H; done
+
+chapter "The way out"
+act way-out float-all "floats everything"
+ctl float-all
+acted moves=any restores=all everything=1
+act quit-and-start quit "quits Arbor"
+ctl quit
+want "Arbor ends within five seconds" day_gone
+acted moves=any restores=all everything=1
+
+day_report
-- 
