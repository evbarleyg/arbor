 /// A layout tree seen through which windows are currently present (not
 /// minimized, not hidden, still open). Absent windows keep their place in the
 /// tree but take no space, so they return to the same spot.
+///
+/// But for one: of the two places that everything consists of (`LayoutTree.everything`), with nothing left over, one is away. A minimize and
+/// a hide are goings like any other (F68): whoever is left alone stays as it is, and what is freed is left over. So that place
+/// keeps its room, and **the Desktop stands in for it** there (`leftOpen`). Nothing in the tree changes, so that there and back is nothing.
 public struct TreeView {
   public let tree: LayoutTree
   public let isPresent: (WindowID) -> Bool
+  /// The place that is away and keeps its room, in which the Desktop shows. Its weight is the room's: a gap dragged beside it and
+  /// whatever is lent out of it are the away window's, which comes back to what is left of it.
+  public let leftOpen: NodeID?
 
   public init(tree: LayoutTree, isPresent: @escaping (WindowID) -> Bool) {
     self.tree = tree
     self.isPresent = isPresent
+    leftOpen = Self.placeLeftOpen(in: tree, isPresent)
+  }
+
+  private static func placeLeftOpen(in tree: LayoutTree, _ isPresent: (WindowID) -> Bool) -> NodeID? {
+    guard !tree.desktopHasRoom else { return nil }
+    let places = tree.children(of: tree.everything).filter { $0 != tree.desktop }
+    guard places.count == 2 else { return nil }
+    let away = places.filter { !tree.windows(under: $0).contains(where: isPresent) }
+    // A place kept for a window that is not open is not away: it waits, with room or without (Controller+KeptRoom.swift).
+    guard away.count == 1, tree.windows(under: away[0]).contains(where: { !$0.isStandIn }) else { return nil }
+    return away[0]
   }
 
+  /// What a view that goes to `node` goes to: in the place that is left open, the Desktop.
+  public func shown(at node: NodeID) -> NodeID { node == leftOpen ? tree.desktop : node }
+
+  /// What gives first, and is nobody's to look at: the Desktop, or the place it stands in for.
+  public var whatIsLeftOver: NodeID { leftOpen ?? tree.desktop }
+
   /// Whether a node takes up space: a stack does if any of its windows is present, a split does if any child
   /// does. The Desktop does if it has room (`LayoutTree.desktopHasRoom`). It is what is left over, so it also does, whatever
-  /// its share, while no docked window is present anywhere: then everything is left over.
+  /// its share, while no docked window is present anywhere: then everything is left over. So does the place that is left open.
   public func isEffective(_ id: NodeID) -> Bool {
     guard let node = tree[id] else { return false }
+    if id == leftOpen { return true }
     switch node.kind {
     case .desktop: return node.weight > 0 || !tree.allWindows.contains(where: isPresent)
     case .stack(let windows, _): return windows.contains(where: isPresent)
@@ -46,7 +71,8 @@ public struct TreeView {
   public func effectiveAncestor(of id: NodeID) -> NodeID {
     guard id != tree.desktop else { return id }
     var current = tree.contains(id) ? id : tree.root
-    while !isEffective(current), let parent = tree.parent(of: current) {
+    // (There is nothing to look at in the place that is left open but the Desktop, which has a node of its own.)
+    while !isEffective(current) || current == leftOpen, let parent = tree.parent(of: current) {
       current = parent
     }
     return current
