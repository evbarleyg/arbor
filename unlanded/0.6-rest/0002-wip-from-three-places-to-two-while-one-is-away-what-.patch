+  /// What the one that stays had lent the other (F61) stands while that is away: no frame at the going, none at the return. A close gives it back.
+  @Test(arguments: Away.allCases) func aLoanToTheOneThatGoesStandsUntilItIsBack(_ way: Away) {
+    let h = Harness(settings: Settings())
+    let safari = h.system.open(app: "Safari")
+    let mail = h.system.open(app: "Mail", minimumSize: CGSize(width: 1100, height: 400))
+    h.start()
+    h.run("dock \(safari.rawValue) left")
+    h.run("dock \(mail.rawValue) right")
+    h.scheduler.advance(by: 2)
+    let (narrow, wide) = (h.frame(safari), h.frame(mail))
+    #expect(narrow?.width == 304 && wide?.width == 1100, "the premise")
+    let tree = h.workspace.tree
+    h.system.clearFrameLog()
+    set(mail, way, true, h)
+    #expect(h.frame(safari) == narrow)
+    #expect(h.workspace.tree == tree)
+    set(mail, way, false, h)
+    #expect(h.frame(safari) == narrow && h.frame(mail) == wide)
+    #expect(!h.system.frameLog.contains { $0.window == safari })
+    expectWindowsMatchLayout(h)
+    h.system.close(mail)
+    h.scheduler.advance(by: 2)
+    #expect(h.frame(safari)?.width == 702, "its own again")
+  }
