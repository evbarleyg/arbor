diff --git a/Sources/ArborCore/LayoutTree+Room.swift b/Sources/ArborCore/LayoutTree+Room.swift
index 58ad4a24..82df3c04 100644
--- a/Sources/ArborCore/LayoutTree+Room.swift
+++ b/Sources/ArborCore/LayoutTree+Room.swift
@@ -84,4 +84,27 @@ extension LayoutTree {
     nodes[visit.host]!.weight = visit.weights[host] + visit.weights[guest]
     return true
   }
+
+  /// `id`, which is there to see, is about to leave, and of the three places that everything consists of another is away. To the eye
+  /// these are two, and whoever is left alone stays as it is (F68): what is freed is left over where it was freed, and the one
+  /// that is away takes that room when it comes back. So it inherits the place and the weight of the one that leaves. What it had
+  /// itself, which the two had between them, goes the way of all room that is left, to the same two places as before.
+  ///
+  /// There and back is nothing comes first: a visitor that leaves the row as it found it gives back what it took.
+  mutating func handOnThePlace(of id: NodeID, isPresent: (WindowID) -> Bool) {
+    guard !desktopHasRoom, id != desktop, nodes[id]?.parent == everything else { return }
+    let places = children(of: everything).filter { $0 != desktop }
+    guard places.count == 3 else { return }
+    let away = places.filter { place in place != id && !windows(under: place).contains(where: isPresent) }
+    // (A place kept for a window that is not open is not away, `TreeView.leftOpen`.)
+    guard away.count == 1, let heir = away.first, windows(under: heir).contains(where: { !$0.isStandIn }) else { return }
+    var trial = self
+    trial.repayLoans(of: id)
+    guard !trial.endVisit(of: id, leaving: everything) else { return }
+    repayLoans(of: id)
+    swapSiblings(id, heir)
+    let own = nodes[id]!.weight
+    nodes[id]!.weight = nodes[heir]!.weight
+    nodes[heir]!.weight = own
+  }
 }
