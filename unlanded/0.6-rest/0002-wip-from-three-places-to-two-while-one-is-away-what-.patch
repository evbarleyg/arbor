+    h.system.setMinimized(w[0], false)
+    h.scheduler.advance(by: 2)
+    #expect(h.frame(w[0]) == above && h.frame(w[1]) == below)
+    #expect(!h.system.isVisible(w[2]))
+    #expect(!h.system.frameLog.contains { $0.window != w[0] }, "nobody else has been named")
+    expectWindowsMatchLayout(h)
+    // The view of everything has the Desktop in it, and what floats.
+    if held { h.run("release") }
+    h.system.setMinimized(w[0], true)
+    h.run("home")
+    #expect(h.layout?.desktopFrame == above && h.frame(w[1]) == below)
+    #expect(h.system.isVisible(w[2]))
+    #expect(h.controller.invariantViolations() == [])
+    expectWindowsMatchLayout(h)
+  }
