+    h.run("desktop")
+    h.run("dock \(w[2].rawValue) left")
+    h.run("home")
+    #expect(h.frame(w[1]) == CGRect(x: 12, y: 37, width: 702, height: 851))
+    #expect(h.frame(w[2]) == CGRect(x: 726, y: 37, width: 702, height: 851))
+    expectWindowsMatchLayout(h)
+  }
