diff --git a/Sources/ArborKit/Controller/Controller+Carry.swift b/Sources/ArborKit/Controller/Controller+Carry.swift
new file mode 100644
index 00000000..26a32c88
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+Carry.swift
@@ -0,0 +1,482 @@
+import ArborCore
+import CoreGraphics
+
+/// Carrying a window with the keyboard (docs/features/F59-carry-with-the-keyboard.md).
+///
+/// A carry is a drag without a pointer. `CarryMap` (ArborCore) knows the places a drag could put the
+/// window and which of them an arrow key leads to; this file holds the window, shows the drop preview
+/// at the place chosen, and lets go. Until then nothing is rearranged: the window stays where it is and
+/// only the preview and, with the view commands, the view move. Letting go ends in `finishDrop(_:on:)`, as a drag
+/// does, so a carried drop and a dragged one cannot differ.
+///
+/// While a window is carried Arbor holds plain keys (arrows, ↩, Space, ⎋) that belong to whatever app has the
+/// keyboard. So every way out gives them back, and there are many: a drop, a cancel, any command that is not
+/// part of carrying, the keyboard going anywhere else (to another window, or to a sheet, a panel or the wallpaper, of
+/// which no window reports anything), the window closing or leaving, a press of the mouse, a change of settings or
+/// displays, a pause, quitting, and half a minute without a key.
+///
+/// A carry that ends where it began has touched nothing: not the arrangement, not the view, and above all not the frame of
+/// a window that floats, which is its person's (collab/QUESTIONS.md).
+///
+/// Nothing but the view has moved before the drop, so the view is all there is to put back, and a window moves once:
+/// - ⎋, putting the window down where it was, and the half minute put the view back. Nothing follows them.
+/// - Whatever else ends a carry is followed by something that lays out for itself: the command, the view going after the
+///   keyboard, the mouse. The view stays as it is (`carryYields`), and ⌃⌥[ goes back.
+/// - Quitting and a pause move every window themselves. The view goes back on paper only (`carryYieldsToTheEnd`).
+extension Controller {
+  struct CarrySession {
+    var window: WindowID
+    /// The display whose places are offered.
+    var display: DisplayID
+    var map: CarryMap
+    var choice: CarryChoice
+    /// Every display's workspace as it was when the window was picked up, for the views.
+    var before: [DisplayID: Workspace]
+    /// The window that had the keyboard until this one was picked up by name (`carry <window>`). Put back, it has it again.
+    var keyboardBefore: WindowID?
+    /// Nobody chose the place chosen: the view changed and the carry arrived at an edge of the new one.
+    var hasOnlyArrived = false
+  }
+
+  /// One stored property of the controller.
+  struct Carrying {
+    var session: CarrySession?
+    /// The window that is just being picked up: the view may have to step out before there is a session.
+    var pickingUp: WindowID?
+    /// Set once the observer below is in place.
+    var isWatching = false
+
+    /// The window in hand. It keeps the keyboard, in view or not, and having the keyboard does not
+    /// bring it into view: the view is looking for a place for it.
+    var window: WindowID? { session?.window ?? pickingUp }
+  }
+
+  /// How long a carry waits for the next key, in seconds, before everything goes back.
+  static let carryPatience = 30.0
+  static let carryTimer = "carry"
+  /// Looks once more where the keyboard is: after the mouse has ended a carry (`carryYieldsToTheMouse`), and after another window
+  /// was reported focused during one (`carryYields(toFocusOn:)`).
+  static let carryKeyboardTimer = "carry-keyboard"
+
+  /// The window being carried, if any.
+  public var carriedWindow: WindowID? { carrying.session?.window }
+  /// Where it would land now.
+  public var carryChoice: CarryChoice? { carrying.session?.choice }
+  /// Every place it could land in the view it is choosing in.
+  public var carryChoices: CarryMap? { carrying.session?.map }
+  /// Whether the window in hand has the keyboard, as far as Arbor can tell. False with nothing in hand.
+  public var carriedWindowHasTheKeyboard: Bool { carrying.session.map { keyboardFocus() == $0.window } ?? false }
+  /// The plain keys a carry needs, for `temporaryShortcuts`.
+  /// None with shortcuts switched off: a script can still carry, with commands.
+  var carryShortcuts: [KeyBinding] {
+    carrying.session != nil && settings.hotkeysEnabled ? KeyBindings.whileCarrying : []
+  }
+
+  // MARK: The command
+
+  func carry(_ step: CarryStep) -> CommandResult {
+    switch step {
+    case .pickUp(let window):
+      guard let session = carrying.session else { return pickUp(window) }
+      // The key that picks up also puts down.
+      if window == nil || window == session.window { return dropCarried() }
+      cancelCarry()
+      return pickUp(window)
+    case .move(let edge):
+      return moveCarried(edge)
+    case .drop:
+      return dropCarried()
+    case .cancel:
+      guard carrying.session != nil else { return .failure(Self.notCarrying) }
+      cancelCarry()
+      return .success("put back: windows and view are as they were")
+    case .display(let next):
+      guard carrying.session == nil else { return carryToDisplay(next: next) }
+      // Asked before anything is picked up: a key that answers "no" must not have widened the view and taken the arrows.
+      guard displays.count > 1 else { return .failure(Self.onlyThisDisplay) }
+      let picked = pickUp(nil)
+      guard picked.ok else { return picked }
+      let carried = carryToDisplay(next: next)
+      if !carried.ok { cancelCarry() }
+      return carried
+    }
+  }
+
+  private static let notCarrying = "no window is being carried; `carry` picks up the focused one"
+  private static let onlyThisDisplay = "there is only this display"
+
+  private func pickUp(_ window: WindowID?) -> CommandResult {
+    let (id, display): (WindowID, DisplayID)
+    switch target(window) {
+    case .failure(let result): return result
+    case .window(let w, let d): (id, display) = (w, d)
+    }
+    guard drag == nil, edgeResize == nil else { return .failure("the mouse is holding a window; let go first") }
+    guard windows[id]?.isPresent == true else { return .failure("\(id) is minimized, hidden or on another of the macOS Spaces") }
+    guard !isPinned(id) else { return .failure("\(id) is kept in view wherever you look; `unpin` it to dock it") }
+    // Nor does a drag ever dock a window that comes and goes with `summon`.
+    guard role(of: id) == nil else { return .failure("\(id) comes and goes with `summon`; `float` it to dock it") }
+    // A script steers with commands. Whoever chose it in the menu has only keys to go on with.
+    guard settings.hotkeysEnabled || following.source != .menu else {
+      return .failure("shortcuts are off, and a carried window is steered with the arrow keys")
+    }
+    watchForCarry()
+    // The field has borrowed the keyboard from the window. Space, ↩ and ⎋ cannot be the field's and the carry's.
+    closeNamePrompt()
+
+    let before = workspaces
+    carrying.pickingUp = id
+    defer { carrying.pickingUp = nil }
+    showMoreThan(id, on: display)
+    guard let map = carryMap(for: id, on: display),
+      let choice = map.choice(for: workspaces[display]?.isDocked(id) == true ? DropTarget.none : .float)
+        ?? windows[id].flatMap({ map.nearest(to: $0.frame.center) })
+    else {
+      restoreViews(from: before)
+      return .failure("there is nowhere to put \(id)")
+    }
+    let keyboard = keyboardFocus()
+    carrying.session = CarrySession(
+      window: id, display: display, map: map, choice: choice, before: before, keyboardBefore: keyboard == id ? nil : keyboard)
+    // The keys that follow mean this window, and the keyboard going elsewhere ends the carry. Asked for as `focus` asks,
+    // so that the moment macOS needs to get there is not taken for the keyboard having left.
+    if keyboard != id { giveFocus(to: id) }
+    showCarry()
+    onTemporaryShortcuts?(temporaryShortcuts)
+    return .success("carrying \(appName(of: id)): arrows choose a place, ↩ puts it down, ⎋ puts it back")
+  }
+
+  /// Steps the view out until it shows the window and something besides it.
+  private func showMoreThan(_ window: WindowID, on display: DisplayID) {
+    guard let workspace = workspaces[display], let leaf = workspace.tree.leaf(containing: window),
+      let view = treeView(display)
+    else { return }
+    var camera = Navigation.commonAncestor(workspace.camera, leaf, in: workspace.tree)
+    if view.passThrough(view.effectiveAncestor(of: camera)) == leaf {
+      camera = Navigation.stepOut(from: camera, in: view) ?? camera
+    }
+    if camera != workspace.camera { moveCamera(on: display, to: camera) }
+  }
+
+  private func moveCarried(_ edge: Edge) -> CommandResult {
+    guard let session = carrying.session else { return .failure(Self.notCarrying) }
+    guard let next = session.map.next(from: session.choice, toward: edge) else {
+      waitForCarry()
+      return .failure("nothing further that way")
+    }
+    carrying.session?.choice = next
+    carrying.session?.hasOnlyArrived = false
+    showCarry()
+    return .success(words(for: next.target, on: session.display))
+  }
+
+  private func carryToDisplay(next: Bool) -> CommandResult {
+    guard let session = carrying.session else { return .failure(Self.notCarrying) }
+    // The order `move-to-display` and `focus-display` count by.
+    guard displays.count > 1, let display = resolve(next ? .next : .previous, from: session.display)?.display.id else {
+      waitForCarry()
+      return .failure(Self.onlyThisDisplay)
+    }
+    guard let choice = choose(on: display, { $0.choice(for: DropTarget.none) ?? $0.choice(for: .float) ?? $0.choices.first })
+    else {
+      waitForCarry()
+      return .failure("there is nowhere to put it on that display")
+    }
+    return .success("on the \(next ? "next" : "previous") display: " + words(for: choice.target, on: display))
+  }
+
+  /// The view has gone to a space on another display (`go <name>`). The window in hand keeps the keyboard, and the places
+  /// are those of the space gone to.
+  func carryFollows(to display: DisplayID) {
+    guard let session = carrying.session, session.display != display else { return }
+    if choose(on: display, { $0.choice(for: DropTarget.none) ?? $0.arrival(from: session.choice.anchor) }) == nil { cancelCarry() }
+  }
+
+  /// From now on the carry chooses among the places on `display`, beginning with the one `first` picks. Nil, and nothing
+  /// has changed, if there is none.
+  private func choose(on display: DisplayID, _ first: (CarryMap) -> CarryChoice?) -> CarryChoice? {
+    guard let session = carrying.session, let map = carryMap(for: session.window, on: display), let choice = first(map)
+    else { return nil }
+    carrying.session?.display = display
+    carrying.session?.map = map
+    carrying.session?.choice = choice
+    carrying.session?.hasOnlyArrived = false
+    showCarry()
+    return choice
+  }
+
+  // MARK: The places
+
+  /// The places `window` can be put down in what `displayID` shows now.
+  private func carryMap(for window: WindowID, on displayID: DisplayID) -> CarryMap? {
+    guard let workspace = workspaces[displayID], let layout = layouts[displayID] else { return nil }
+    let present = presentWindowIDs()
+    let minimums = minimumSizes
+    return CarryMap(
+      carrying: window, in: workspace, layout: layout, layoutOptions: options(for: displayID).layoutOptions,
+      dropOptions: options(for: displayID).dropOptions, floatingFrame: floatingFrame(ofCarried: window, on: displayID),
+      isPresent: { present.contains($0) }, minimumSize: { minimums[$0] },
+      makingRoom: settings.makeRoom ? roomTerms(on: displayID, docking: window) : nil)
+  }
+
+  /// Whether `window` floats on `display` and shows: there is a place where it is, Desktop in view or not.
+  private func floatsInView(_ window: WindowID, on display: DisplayID) -> Bool {
+    workspaces[display]?.isFloating(window) == true && !parked.contains(window)
+  }
+
+  /// Where the window would float on `displayID`'s Desktop. One that floats there already stays where it is.
+  /// Any other takes the size it floats at, in the middle of the Desktop as it will be without the window.
+  private func floatingFrame(ofCarried window: WindowID, on displayID: DisplayID) -> CGRect? {
+    guard var workspace = workspaces[displayID], let display = display(displayID), let current = windows[window] else {
+      return nil
+    }
+    if floatsInView(window, on: displayID) { return current.frame }
+    let home = workspaceID(containing: window).flatMap { workspaces[$0] }
+    let size = home?.undockedFrame(of: window)?.size ?? home?.floating[window]?.size ?? current.frame.size
+    workspace.forget(window, shareSpace: settings.shareRemovedSpace)
+    let present = presentWindowIDs()
+    let minimums = minimumSizes
+    let without = LayoutEngine.layout(
+      workspace.tree, camera: workspace.camera, in: display.visibleFrame,
+      options: options(for: displayID).layoutOptions,
+      isPresent: { present.contains($0) }, minimumSize: { minimums[$0] })
+    guard let desktop = without.desktopFrame else { return nil }
+    let middle = CGRect(
+      x: (desktop.midX - size.width / 2).rounded(), y: (desktop.midY - size.height / 2).rounded(),
+      width: size.width, height: size.height)
+    // On whole points, as it will land: on a Desktop narrower than the window the middle can fall between two.
+    var frame = floatingFrame(middle, on: floatingRegion(desktop, on: display), of: display, minimum: size)
+    frame.origin = CGPoint(x: frame.minX.rounded(), y: frame.minY.rounded())
+    return frame
+  }
+
+  /// A key of the carry was pressed: shows the preview at the place chosen and starts waiting for the next one.
+  private func showCarry() {
+    showCarryPreview()
+    waitForCarry()
+  }
+
+  private func showCarryPreview() {
+    guard let session = carrying.session else { return }
+    // Also with drop previews switched off for drags: a carry has nothing else to show where it is.
+    overlays.showDropPreview(session.choice.frame)
+  }
+
+  /// Only a key begins the wait again. Were it every layout, whatever goes on elsewhere (a window closing, an app that keeps
+  /// moving its window) could put the end off for ever, and this is the end that is left when all others fail.
+  private func waitForCarry() {
+    scheduler.schedule(Self.carryTimer, after: Self.carryPatience) { [weak self] in
+      guard let self, self.carrying.session != nil else { return }
+      Log.info("carry: no key for \(Int(Self.carryPatience)) s; put back")
+      self.cancelCarry(asked: false)
+    }
+  }
+
+  /// A command that is part of carrying is about to run. Looking somewhere else is a key like the arrows; a question is not.
+  func carryHears(_ command: Command) {
+    if carrying.session != nil, !command.isQuery { waitForCarry() }
+  }
+
+  // MARK: The ends
+
+  private func dropCarried() -> CommandResult {
+    guard let session = carrying.session else { return .failure(Self.notCarrying) }
+    let (window, display, choice) = (session.window, session.display, session.choice)
+    // Put down where it is. Nothing has changed then, the view included, and nothing is touched: going through a drop would
+    // take the frame a floating window has now for the one its person gave it, which it need not be (Arbor may have
+    // pushed it aside or stretched it over the Desktop), and move it back there if its app has moved it since.
+    if choice.target == .none || (choice.target == .float && floatsInView(window, on: display)) {
+      cancelCarry()
+      return .success("\(appName(of: window)) is back where it was")
+    }
+    letGoOfCarry()
+    // Said before the drop: it can merge or delete the space the words name.
+    let place = words(for: choice.target, on: display)
+    let source = workspaceID(containing: window)
+    // A drag has brought the window to where it is dropped. A carry says where that is.
+    finishDrop(
+      window, on: Hover(display: display, target: choice.target), floatingAt: choice.target == .float ? choice.frame : nil)
+    soleFloatDropped(window, from: source)
+    askForTheKeyboard(for: window)
+    return .success("\(appName(of: window)) is \(place)")
+  }
+
+  /// Puts everything back as it was when the window was picked up, the views included. Does nothing if no
+  /// window is being carried. The keyboard ends in a window in view.
+  /// Not `asked` for: a timer or a report ends the carry, and those move no view that is held (Controller+Hold.swift).
+  /// `keepingTheKeyboard`: it stays with the window in hand, because what follows means that window.
+  func cancelCarry(asked: Bool = true, keepingTheKeyboard: Bool = false) {
+    guard let session = carrying.session else { return }
+    letGoOfCarry()
+    let movesTheView = asked || !isHeld
+    if movesTheView { restoreViews(from: session.before) }
+    guard isRunning, keyboardFocus() == session.window else { return }
+    if !keepingTheKeyboard, let earlier = session.keyboardBefore, windows[earlier]?.isPresent == true, isManaged(earlier) {
+      return giveFocus(to: earlier)
+    }
+    // With every view as it was the keyboard is where it was too, be that out of view (a window that is only a tile).
+    guard session.before.contains(where: { workspaces[$0.key]?.camera != $0.value.camera }) else { return }
+    // A view could not go back: its space has closed meanwhile, or it is held. The keyboard does not stay out of view.
+    if movesTheView, windows[session.window]?.isPresent == true { bringIntoView(session.window) }
+    ensureFocusIsVisible(on: session.display)
+  }
+
+  /// Something else ends the carry, and will lay out for itself whatever it changes. The view stays as it is, so that no window
+  /// moves twice. Unless the window in hand is out of view: it has the keyboard, and what follows may mean "the focused window".
+  func carryYields(asked: Bool = false) {
+    guard let session = carrying.session else { return }
+    let home = workspaceID(containing: session.window)
+    guard windows[session.window]?.isPresent != true || home.flatMap({ frameInView(of: session.window, on: $0) }) != nil else {
+      return cancelCarry(asked: asked, keepingTheKeyboard: true)
+    }
+    letGoOfCarry()
+  }
+
+  /// Arbor is about to quit or to pause, and gives every window its own frame next. The views go back on paper, for what is
+  /// saved and for what a pause comes back to.
+  func carryYieldsToTheEnd() {
+    guard let session = carrying.session else { return }
+    letGoOfCarry()
+    for (id, earlier) in session.before { workspaces[id]?.restoreView(from: earlier) }
+  }
+
+  /// The mouse button went down. The carry is over, and the view stays as it is (⌃⌥[ goes back): putting it back would move
+  /// what is under the pointer, perhaps the very window it is about to take.
+  func carryYieldsToTheMouse() {
+    guard let session = carrying.session else { return }
+    letGoOfCarry()
+    guard parked.contains(session.window) else { return }
+    // The keyboard is in a window out of view. Not mended at once: the press may be giving it to the window under the
+    // pointer this moment, and a request of Arbor's could arrive later and win.
+    scheduler.schedule(Self.carryKeyboardTimer, after: FocusRequest.patience) { [weak self] in
+      guard let self, self.isRunning, self.carrying.session == nil, self.drag == nil, self.edgeResize == nil else { return }
+      self.ensureFocusIsVisible(on: session.display, alsoFromNothing: false)
+    }
+  }
+
+  /// The view is held from now on (F58). Every step of a carry would be refused, ⎋ among them, so it is over now, and the
+  /// view stays as it is, which is what holding it means. (`hold` as a command has ended the carry before it ran, like
+  /// any command that is not part of carrying. This is for whatever else may come to hold the view.)
+  func carryYieldsToTheHold() { letGoOfCarry() }
+
+  /// Ends the carry without touching windows or views: the preview, the timer and the keys go.
+  private func letGoOfCarry() {
+    guard carrying.session != nil else { return }
+    carrying.session = nil
+    scheduler.cancel(Self.carryTimer)
+    overlays.showDropPreview(nil)
+    onTemporaryShortcuts?(temporaryShortcuts)
+  }
+
+  private func restoreViews(from before: [DisplayID: Workspace]) {
+    guard isRunning else { return }
+    for id in workspaces.keys.sorted() {
+      guard let earlier = before[id], var workspace = workspaces[id] else { continue }
+      let camera = workspace.camera
+      workspace.restoreView(from: earlier)
+      guard workspace != workspaces[id] else { continue }
+      workspaces[id] = workspace
+      if workspace.camera != camera {
+        relayout(id, reason: .camera)
+        ensureFocusIsVisible(on: id)
+      }
+      notify(.camera(id))
+      scheduleSave()
+    }
+  }
+
+  // MARK: What happens meanwhile
+
+  /// Follows what happens to the arrangement and the keyboard during a carry. In place from the first carry on.
+  private func watchForCarry() {
+    guard !carrying.isWatching else { return }
+    carrying.isWatching = true
+    observe { [weak self] change in self?.carrySees(change) }
+  }
+
+  private func carrySees(_ change: Change) {
+    guard let session = carrying.session else { return }
+    switch change {
+    case .layout(let display):
+      guard isRunning, isManaged(session.window), windows[session.window]?.isPresent == true,
+        workspaces[session.display] != nil, drag == nil, edgeResize == nil
+      else { return carryYields() }
+      if display == session.display { refreshCarry() }
+    case .keyboard:
+      // A sheet, a dialog or a panel has it, the wallpaper was clicked, an app without a window came forward: no window
+      // reports taking the keyboard then. While the window is being picked up the request for it is still on its way.
+      if carrying.pickingUp == nil, keyboardFocus() != session.window { letGoOfCarry() }
+    case .frames:
+      // Its app, or another tool, has moved the floating window in hand, which no layout follows. Its own place is where it is now.
+      if floatsInView(session.window, on: session.display), session.map.choice(for: .float)?.frame != windows[session.window]?.frame {
+        refreshCarry()
+      }
+    case .settings, .input:
+      carryYields()
+    case .lifecycle:
+      // `shutdown` and `pause` have cancelled it before they began. This is for whatever else stops Arbor.
+      if !isRunning { letGoOfCarry() }
+    default:
+      break
+    }
+  }
+
+  /// `window` is reported focused. If the keyboard has left the window in hand, the plain keys belong to whoever has it
+  /// now. Called before the view follows the keyboard, which it does from where it is.
+  ///
+  /// A report is not the keyboard: an app in the background changes its own focused window too (a chat window that a
+  /// notification opens), and a carry ended by that would send the ↩ meant to put the window down to the app being typed in.
+  /// But macOS does not change everything at once, and its report can come a moment ahead of its answer. So Arbor looks again.
+  func carryYields(toFocusOn window: WindowID) {
+    guard let session = carrying.session, session.window != window else { return }
+    guard keyboardFocus() == session.window else { return letGoOfCarry() }
+    scheduler.schedule(Self.carryKeyboardTimer, after: 0.25) { [weak self] in
+      guard let self, let session = self.carrying.session else { return }
+      if self.keyboardFocus() != session.window { self.letGoOfCarry() }
+    }
+  }
+
+  /// The view or the arrangement changed under the carry: the places are looked up again. The same target
+  /// stays chosen if it is still there; otherwise the carry arrives at an edge of the new view. A place it only arrived at
+  /// is given up for the window's own as soon as that is in view again: there and back is nothing.
+  private func refreshCarry() {
+    guard let session = carrying.session, let map = carryMap(for: session.window, on: session.display) else { return carryYields() }
+    let own = map.choice(for: DropTarget.none) ?? (floatsInView(session.window, on: session.display) ? map.choice(for: .float) : nil)
+    if session.hasOnlyArrived, let own {
+      carrying.session?.choice = own
+      carrying.session?.hasOnlyArrived = false
+    } else if let same = map.choice(for: session.choice.target) {
+      carrying.session?.choice = same
+    } else if let arrival = map.arrival(from: session.choice.anchor) {
+      carrying.session?.choice = arrival
+      carrying.session?.hasOnlyArrived = true
+    } else {
+      return carryYields()
+    }
+    carrying.session?.map = map
+    showCarryPreview()
+  }
+
+  // MARK: Words
+
+  private func appName(of window: WindowID) -> String { windows[window]?.appName ?? "\(window)" }
+
+  /// "left of Mail (n3)", "at the top edge of the view", "floating on the Desktop".
+  private func words(for target: DropTarget, on display: DisplayID) -> String {
+    switch target {
+    case .none: return "back where it was"
+    case .float: return "floating on the Desktop"
+    case .cameraEdge(let edge): return "at the \(edge.rawValue) edge of the view"
+    case .stack(let node): return "in a tab group with \(name(of: node, on: display))"
+    case .beside(let node, let edge):
+      let side: String
+      switch edge {
+      case .left: side = "left of"
+      case .right: side = "right of"
+      case .top: side = "above"
+      case .bottom: side = "below"
+      }
+      return "\(side) \(name(of: node, on: display))"
+    }
+  }
+}
