diff --git a/Tests/ArborCoreTests/CarryTests.swift b/Tests/ArborCoreTests/CarryTests.swift
new file mode 100644
index 00000000..f4bca62f
--- /dev/null
+++ b/Tests/ArborCoreTests/CarryTests.swift
@@ -0,0 +1,396 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+private let screen = CGRect(x: 0, y: 25, width: 1440, height: 875)
+private let a = WindowID(1)
+private let b = WindowID(2)
+private let c = WindowID(3)
+private let d = WindowID(4)
+
+/// A small repeatable random number generator, so that a failure can be run again.
+private struct Dice {
+  var state: UInt64
+  mutating func roll(_ sides: Int) -> Int {
+    state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+    return Int((state >> 33) % UInt64(sides))
+  }
+}
+
+private func layout(_ workspace: Workspace, in frame: CGRect = screen, without gone: WindowID? = nil) -> Layout {
+  LayoutEngine.layout(workspace.tree, camera: workspace.camera, in: frame, isPresent: { $0 != gone })
+}
+
+private func map(
+  carrying window: WindowID, in workspace: Workspace, frame: CGRect = screen, tabs: Bool = false,
+  without gone: WindowID? = nil, band: CGFloat = 12, fraction: CGFloat = 0.3
+) -> CarryMap {
+  let shown = layout(workspace, in: frame, without: gone)
+  return CarryMap(
+    carrying: window, in: workspace, layout: shown, layoutOptions: LayoutOptions(),
+    dropOptions: DropOptions(screenEdgeBand: band, windowEdgeFraction: fraction, tabsEnabled: tabs),
+    floatingFrame: shown.desktopFrame.map { CGRect(x: 0, y: 0, width: 500, height: 400).fitted(into: $0) },
+    isPresent: { $0 != gone })
+}
+
+/// [a | Desktop | b].
+private func desk() -> Workspace {
+  var workspace = Workspace()
+  workspace.dock(a, at: .cameraEdge(.left))
+  workspace.dock(b, at: .cameraEdge(.right))
+  return workspace
+}
+
+/// A random arrangement of up to nine windows, a random view of it, and a window to carry, which may
+/// be docked in it or not.
+private func randomCase(_ seed: Int) -> (workspace: Workspace, carried: WindowID, frame: CGRect, tabs: Bool, gone: WindowID) {
+  var dice = Dice(state: UInt64(seed))
+  let frame = [
+    screen, CGRect(x: 1440, y: 0, width: 1024, height: 768), CGRect(x: -2560, y: -200, width: 2560, height: 1440),
+    CGRect(x: 0, y: 0, width: 1080, height: 1920),
+  ][dice.roll(4)]
+  var workspace = Workspace()
+  let count = 1 + dice.roll(9)
+  for number in 1...count {
+    let nodes = workspace.tree.preorder()
+    let edge = Edge.allCases[dice.roll(4)]
+    workspace.dock(
+      WindowID(UInt32(number)), at: dice.roll(4) == 0 ? .cameraEdge(edge) : .beside(nodes[dice.roll(nodes.count)], edge))
+  }
+  let nodes = workspace.tree.preorder()
+  workspace.moveCamera(to: dice.roll(3) == 0 ? nodes[dice.roll(nodes.count)] : workspace.tree.root)
+  let carried = WindowID(UInt32(1 + dice.roll(count + 1)))
+  // Picking a window up steps the view out until it shows more than that window.
+  if workspace.camera == workspace.tree.leaf(containing: carried) { workspace.moveCamera(to: workspace.tree.root) }
+  let tabs = dice.roll(2) == 0
+  // One window may be minimized, but not the one in hand.
+  let gone = WindowID(UInt32(dice.roll(12)))
+  return (workspace, carried, frame, tabs, gone == carried ? WindowID(0) : gone)
+}
