+    let h = Harness(displays: displays, settings: settings)
+    let safari = h.system.open(app: "Safari", pid: 1001, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let slack = h.system.open(app: "Slack", pid: 1002, frame: CGRect(x: 300, y: 200, width: 610, height: 410))
+    let terminal = h.system.open(app: "Terminal", pid: 1003, frame: CGRect(x: 500, y: 300, width: 620, height: 420))
+    h.start()
