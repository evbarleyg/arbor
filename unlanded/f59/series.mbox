+      let fraction: CGFloat = [0.05, 0.3, 0.5][seed % 3]
+      let found = map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone, band: band, fraction: fraction)
+      var links: [[Int]] = []
+      for choice in found.choices {
+        let next = Edge.allCases.compactMap { found.next(from: choice, toward: $0) }
+        #expect(!next.contains(choice), "seed \(seed): an arrow leads from \(choice.target) to itself")
+        links.append(next.compactMap(found.choices.firstIndex(of:)))
+      }
+      for start in found.choices.indices {
+        var seen: Set<Int> = [start]
+        var pending = [start]
+        while let index = pending.popLast() {
+          for next in links[index] where seen.insert(next).inserted { pending.append(next) }
+        }
+        #expect(seen.count == found.choices.count, "seed \(seed), band \(band), fraction \(fraction), from \(found.choices[start].target)")
+      }
+    }
+  }
