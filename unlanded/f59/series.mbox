+  /// Arbor makes room for a window that will not go as narrow as its place (F61). The preview counts on that.
+  @Test func thePreviewCountsOnTheRoomTheDropWillMake() {
+    func desk() -> (Harness, WindowID) {
+      let (h, _, slack, _) = makeHarness()
+      // Arbor learns a minimum when a window refuses its place.
+      h.system.setMinimumSize(slack, CGSize(width: 520, height: 300))
+      h.run("float \(slack.rawValue)")
+      h.run("dock \(slack.rawValue) right")
+      h.scheduler.runPending()
+      #expect(h.frame(slack)!.width >= 520)
+      h.run("carry")
+      return (h, slack)
+    }
+    let (scout, _) = desk()
+    var roomWasMade = 0
+    for (choice, keys) in ways(scout) where choice.target != .float {
+      let (h, slack) = desk()
+      for key in keys { h.run("carry \(key)") }
+      #expect(h.overlays.preview == choice.frame)
+      #expect(h.run("carry drop").ok)
+      h.scheduler.runPending()
+      guard h.layout?.windowFrames[slack] != nil else { continue }
+      #expect(h.frame(slack) == choice.frame, "\(choice.target)")
+      if choice.frame.width < 530 { roomWasMade += 1 }
+    }
+    #expect(roomWasMade > 0, "no place was narrow enough to need room")
+  }
