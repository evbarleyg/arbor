+      let found = map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone)
+      let links = found.choices.map { choice in
+        Edge.allCases.compactMap { found.next(from: choice, toward: $0).flatMap(found.choices.firstIndex(of:)) }
+      }
+      func reach(from start: Int) -> Set<Int> {
+        var seen: Set<Int> = [start]
+        var pending = [start]
+        while let index = pending.popLast() {
+          for next in links[index] where seen.insert(next).inserted { pending.append(next) }
+        }
+        return seen
+      }
+      for index in found.choices.indices {
+        #expect(reach(from: index).count == found.choices.count, "seed \(seed), from \(found.choices[index].target)")
+      }
+    }
+  }
