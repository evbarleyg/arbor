+      let shown = layout(workspace, in: frame, without: gone)
+      var reached: [DropTarget] = []
+      for x in stride(from: frame.minX + 3, to: frame.maxX, by: 23) {
+        for y in stride(from: frame.minY + 3, to: frame.maxY, by: 23) {
+          let target = DropResolver.resolve(
+            point: CGPoint(x: x, y: y), window: carried, layout: shown, tree: workspace.tree, visibleFrame: frame,
+            options: DropOptions(tabsEnabled: tabs))
+          if target != .float, !reached.contains(target) { reached.append(target) }
+        }
+      }
+      func arrangement(after target: DropTarget) -> Layout {
+        var dropped = workspace
+        dropped.dock(carried, at: target)
+        return LayoutEngine.layout(dropped.tree, camera: dropped.camera, in: frame, isPresent: { $0 == carried || $0 != gone })
+      }
+      for target in reached {
+        guard let choice = found.choice(for: target) else {
+          Issue.record("seed \(seed): no choice for \(target)")
+          continue
+        }
+        let (dragged, carriedThere) = (arrangement(after: target), arrangement(after: choice.target))
+        #expect(dragged.look == carriedThere.look, "seed \(seed): \(target) and \(choice.target)")
+      }
+    }
+  }
