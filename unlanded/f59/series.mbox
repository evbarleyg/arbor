diff --git a/scripts/mac-shell/check-F59.sh b/scripts/mac-shell/check-F59.sh
new file mode 100755
index 00000000..7f2318b3
--- /dev/null
+++ b/scripts/mac-shell/check-F59.sh
@@ -0,0 +1,105 @@
+#!/bin/bash
+# F59 on real windows, with real keys: carry a window with the keyboard.
+#
+#   scripts/mac-shell/run.sh scripts/mac-shell/check-F59.sh
+#
+# What only a Mac can say: whether plain keys (arrows, ↩, Space, ⎋) can be registered as global shortcuts for the length of a
+# carry and reach Arbor; whether all seven are the app's again after each ending tried here (a drop, ⎋, a click in another
+# window, the same key again); whether the carried window keeps the keyboard while the view moves; and what the preview
+# looks like as it walks.
+#
+# Touches nothing but its own test windows, the pointer and the keyboard. It presses arrow keys, ↩ and ⎋, which go to Arbor
+# or to a test window.
+source "$(dirname "$0")/lib.sh"
+
+arbor_build
+arbor_start 3 ARBOR_NO_HOTKEYS=0
+
+below() { # whether window $1 sits under window $2, in the same column
+  local a b
+  a=($(frame_of "$1")) b=($(frame_of "$2"))
+  [ ${#a[@]} -eq 4 ] && [ ${#b[@]} -eq 4 ] || return 1
+  [ "${a[0]}" -eq "${b[0]}" ] && [ "${a[1]}" -gt "${b[1]}" ]
+}
+same_frame() { [ "$(frame_of "$1")" = "$2" ]; }
+preview() { has_overlay 3; }
+no_preview() { ! has_overlay 3; }
+# A plain key that Arbor still holds runs `carry right` and the like, and with nothing in hand that fails without moving anything:
+# only the log tells. So: how many steps of a carry Arbor has heard of so far, and whether pressing every plain key adds none.
+steps_heard() { grep -c -E " carry (left|right|top|bottom|drop|cancel)( failed)?:" "$ARBOR_HOME/arbor.log" || true; }
+plain_keys_are_the_apps() {
+  local heard
+  heard=$(steps_heard)
+  key left && key right && key up && key down && key return && key space && key escape || return 1
+  sleep 0.5
+  [ "$(steps_heard)" = "$heard" ]
+}
+
+step "[w1 | Desktop | w2 | w3], w2 has the keyboard"
+ctl dock "$W1" left
+ctl dock "$W2" right
+ctl dock "$W3" right
+# shellcheck disable=SC2046
+click $(center_of "$W2")
+check "the clicked window has the keyboard" eventually is focused "$W2"
+before=$(frame_of "$W2")
+
+step "⌃⌥⌘Space → ↓ ↩ puts w2 under w3"
+key ctrl+opt+cmd+space
+check "a preview shows" eventually preview
+shot 01-picked-up
+key right
+shot 02-left-of-w3
+key down
+shot 03-below-w3
+check "nothing has moved yet" same_frame "$W2" "$before"
+key return
+check "w2 sits under w3" eventually below "$W2" "$W3"
+check "the preview is gone" eventually no_preview
+check "w2 still has the keyboard" eventually is focused "$W2"
+shot 04-put-down
+summary
+
+step "The plain keys are the app's again"
+after=$(frame_of "$W2")
+check "Arbor heard the arrows and ↩ while it carried" [ "$(steps_heard)" -ge 3 ]
+check "none of the seven reaches Arbor now" plain_keys_are_the_apps
+check "and they do nothing to the arrangement" same_frame "$W2" "$after"
+check "and bring up no preview" no_preview
+
+step "⎋ puts everything back, the view included"
+key ctrl+opt+cmd+space
+check "a preview shows" eventually preview
+key up
+key left
+key ctrl+opt+d
+check "the view went to the Desktop" eventually is parked "$W1"
+check "the carried window keeps the keyboard out of view" is focused "$W2"
+shot 05-looking-elsewhere
+key escape
+check "the view is back" eventually is in_slot "$W1"
+check "w2 is where it was" eventually same_frame "$W2" "$after"
+check "the preview is gone" eventually no_preview
+check "the plain keys are the app's again" plain_keys_are_the_apps
+
+step "A click in another window ends it"
+key ctrl+opt+cmd+space
+check "a preview shows" eventually preview
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+check "the preview is gone" eventually no_preview
+check "w2 is where it was" same_frame "$W2" "$after"
+check "the plain keys are the app's again" plain_keys_are_the_apps
+
+step "The same key twice changes nothing"
+# shellcheck disable=SC2046
+click $(center_of "$W2")
+check "the clicked window has the keyboard" eventually is focused "$W2"
+key ctrl+opt+cmd+space
+check "a preview shows" eventually preview
+key ctrl+opt+cmd+space
+check "the preview is gone" eventually no_preview
+check "w2 is where it was" same_frame "$W2" "$after"
+check "the plain keys are the app's again" plain_keys_are_the_apps
+
+arbor_stop 06-quit
