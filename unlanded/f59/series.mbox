+    #expect(h.registeredShortcuts.allSatisfy { !$0.chord.modifiers.isEmpty }, "a plain key is still held", sourceLocation: sourceLocation)
+    #expect(!h.scheduler.pendingKeys.contains("carry"), sourceLocation: sourceLocation)
