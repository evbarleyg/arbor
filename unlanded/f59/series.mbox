+  // MARK: Criterion 2
+
+  /// A random arrangement of `count` windows, made with commands, the same for the same seed.
+  func randomHarness(seed: Int, tabs: Bool) -> (Harness, [WindowID]) {
+    var dice = Dice(state: UInt64(seed))
+    let h = Harness(settings: settings { $0.tabsEnabled = tabs })
+    let windows = (0..<(3 + dice.roll(4))).map { number in
+      h.system.open(app: "App\(number)", frame: CGRect(x: 200 + 30 * number, y: 150 + 20 * number, width: 500, height: 380))
+    }
+    h.start()
+    let edges = ["left", "right", "top", "bottom"]
+    for (index, window) in windows.enumerated() where index == 0 || dice.roll(5) > 0 {
+      if index > 0, dice.roll(2) == 0, let other = h.workspace.tree.allWindows.randomElement(using: &dice) {
+        h.run("dock \(window.rawValue) beside \(other.rawValue) \(edges[dice.roll(4)])")
+      } else {
+        h.run("dock \(window.rawValue) \(edges[dice.roll(4)])")
+      }
+    }
+    h.run("show-all")
+    h.scheduler.runPending()
+    return (h, windows)
+  }
+
+  /// The arrow keys that lead from where a carry starts to each of its choices.
+  func ways(_ h: Harness) -> [(choice: CarryChoice, keys: [String])] {
+    guard let start = h.controller.carryChoice, let map = h.controller.carryChoices else { return [] }
+    var found: [(choice: CarryChoice, keys: [String])] = [(start, [])]
+    var next = 0
+    while next < found.count {
+      let (choice, keys) = found[next]
+      next += 1
+      for (key, edge) in [("left", Edge.left), ("right", .right), ("up", .top), ("down", .bottom)] {
+        guard let reached = map.next(from: choice, toward: edge), !found.contains(where: { $0.choice == reached })
+        else { continue }
+        found.append((reached, keys + [key]))
+      }
+    }
+    #expect(found.count == map.choices.count)
+    return found
+  }
+
+  @Test(arguments: 1...6) func carriedThereOrDraggedThereIsTheSame(seed: Int) {
+    let tabs = seed % 2 == 0
+    let (scout, windows) = randomHarness(seed: seed, tabs: tabs)
+    let carried = windows[seed % windows.count]
+    scout.system.userFocus(carried)
+    scout.scheduler.runPending()
+    guard scout.run("carry").ok else {
+      Issue.record("seed \(seed): could not pick \(carried) up")
+      return
+    }
+    // Picking up can step the view out. The drag starts from the same view.
+    let view = scout.workspace.camera
+    for (choice, keys) in ways(scout) {
+      // A pointer cannot choose the Desktop's edges, and floats a window where it lets go.
+      if case .beside(scout.workspace.tree.desktop, _) = choice.target { continue }
+      if choice.target == .float { continue }
+
+      let (byKeys, _) = randomHarness(seed: seed, tabs: tabs)
+      byKeys.system.userFocus(carried)
+      byKeys.scheduler.runPending()
+      byKeys.run("carry")
+      for key in keys { byKeys.run("carry \(key)") }
+      #expect(byKeys.overlays.preview == choice.frame)
+      #expect(byKeys.run("carry drop").ok)
+      // Put down where it was, nothing has changed, the view included, which a drag has no way to widen.
+      if choice.target == .none {
+        let (untouched, _) = randomHarness(seed: seed, tabs: tabs)
+        untouched.system.userFocus(carried)
+        untouched.scheduler.runPending()
+        #expect(byKeys.workspace == untouched.workspace, "seed \(seed)")
+        // The windows are where looking there and back leaves them without a carry. (That is not yet where they were for one that
+        // floats over docked windows: it is pushed onto the Desktop when that comes into view.)
+        if view != untouched.workspace.camera {
+          untouched.run("zoom-node \(view.rawValue)")
+          untouched.run("back")
+        }
+        byKeys.scheduler.runPending()
+        untouched.scheduler.runPending()
+        #expect(frames(byKeys) == frames(untouched), "seed \(seed)")
+        continue
+      }
+
+      let (byMouse, _) = randomHarness(seed: seed, tabs: tabs)
+      // With macOS's tiling on, a drag leaves the left, right and top edges of the screen to macOS. The keys do not.
+      byMouse.system.tiling = .off
+      byMouse.system.userFocus(carried)
+      byMouse.scheduler.runPending()
+      byMouse.run("zoom-node \(view.rawValue)")
+      let start = byMouse.frame(carried)!
+      // By way of the middle of the screen: an edge in whose band the pointer took hold offers nothing until it has left the band once.
+      byMouse.system.drag(
+        carried, through: [CGPoint(x: start.midX, y: start.minY + 10), byMouse.visibleFrame.center, choice.anchor])
+      byKeys.scheduler.runPending()
+      byMouse.scheduler.runPending()
+
+      #expect(byKeys.workspace.tree == byMouse.workspace.tree, "seed \(seed): \(choice.target)")
+      #expect(byKeys.layout?.windowFrames == byMouse.layout?.windowFrames, "seed \(seed): \(choice.target)")
+      #expect(byKeys.frame(carried) == byMouse.frame(carried), "seed \(seed): \(choice.target)")
+      if byKeys.layout?.windowFrames[carried] != nil { #expect(byKeys.frame(carried) == choice.frame, "seed \(seed): \(choice.target)") }
+    }
+  }
