+  /// Picking a framed window up has widened the view. Whatever ends the carry but ⎋ is followed by something that lays out for
+  /// itself. Were the view put back first, every window would go out of view and come back.
+  /// Not `carrying`: the same desk and the same wider view, reached by stepping out, with nothing in hand. The control.
+  func widened(carrying: Bool = true) -> (Harness, [WindowID], mark: Int) {
+    let (h, safari, slack, terminal) = makeHarness()
+    let notes = h.system.open(app: "Notes", pid: 1004, frame: CGRect(x: 390, y: 100, width: 300, height: 300))
+    h.system.userFocus(slack)
+    h.run("zoom \(slack.rawValue)")
+    h.scheduler.runPending()
+    #expect(h.run(carrying ? "carry" : "out").ok)
+    #expect(h.system.isVisible(safari) && h.system.isVisible(notes))
+    return (h, [safari, slack, terminal, notes], h.system.moveLog.count)
+  }
+
+  func expectNoWindowMovedTwice(_ h: Harness, _ windows: [WindowID], since mark: Int, _ what: String) {
+    h.scheduler.advance(by: 1)
+    expectNothingIsCarried(h)
+    for window in windows { #expect(moves(of: window, h, since: mark) <= 1, "\(window) at \(what)") }
+  }
+
+  @Test(arguments: ["float-all", "arrange", "float", "dock left", "pin", "exclude", "relayout", "toggle-pause", "pause", "home", "zoom", "undo"])
+  func noWindowMovesTwiceWhenAnotherCommandEndsIt(command: String) {
+    let (h, windows, mark) = widened()
+    // What the command does by itself from the same view. (`arrange` asks a window it knows nothing about for its size where it
+    // stands and then moves it, which is two by this count and the command's own road.) Ending the carry adds nothing to it.
+    let (plain, _, plainMark) = widened(carrying: false)
+    #expect(plain.workspace.camera == h.workspace.camera && frames(plain) == frames(h), "the control looks at what the carry looks at")
+    h.press(command)
+    plain.press(command)
+    plain.scheduler.advance(by: 1)
+    h.scheduler.advance(by: 1)
+    expectNothingIsCarried(h)
+    for window in windows {
+      #expect(moves(of: window, h, since: mark) <= max(1, moves(of: window, plain, since: plainMark)), "\(window) at \(command)")
+    }
+    #expect(frames(h) == frames(plain), "and it ends as it ends without a carry: \(command)")
+  }
