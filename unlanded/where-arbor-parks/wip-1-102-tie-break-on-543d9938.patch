+    func showing(_ origin: CGPoint) -> (CGFloat, atWorst: CGFloat) {
+      guard let titleBar else {
+        return (showing(origin, Self.guessedTitleBar), Self.measuredTitleBars.map { showing(origin, $0) }.max() ?? 0)
