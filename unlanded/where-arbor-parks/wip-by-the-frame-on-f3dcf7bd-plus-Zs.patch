index 00000000..bc9ecbca
--- /dev/null
+++ b/Tests/ArborKitTests/WhereArborParksTests.swift
@@ -0,0 +1,92 @@
+import ArborCore
+@testable import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// Where a window waits that is out of view. macOS does not leave a window where it is asked to go: its title bar stays within reach, and
+/// the display that sees to that is the one that has most of the window, not the one its corner is on (`Screens`, from 78 calls on a hosted
+/// Mac). Arbor reckoned by the corner, and only with the stop at the bottom.
+@Suite @MainActor struct WhereArborParksTests {
+  static func display(_ id: String, _ frame: CGRect, top: CGFloat = 31, bottom: CGFloat = 0, left: CGFloat = 0, right: CGFloat = 0) -> DisplaySnapshot {
+    let visible = CGRect(
+      x: frame.minX + left, y: frame.minY + top, width: frame.width - left - right, height: frame.height - top - bottom)
+    return DisplaySnapshot(id: DisplayID(id), frame: frame, visibleFrame: visible, isMain: id == "main")
+  }
+
+  /// The main display of the calls, with its Dock.
+  static let main = display("main", CGRect(x: 0, y: 0, width: 1600, height: 900), bottom: 78)
+  /// A left neighbour that begins 500 points lower, and a display at the right.
+  static let lowerLeft = display("lower-left", CGRect(x: -1280, y: 500, width: 1280, height: 800))
+  static let right = display("right", CGRect(x: 1600, y: 0, width: 1920, height: 1080))
+
+  /// `[a | Desktop]` framed on `a`, so that `f`, which floats, is out of view.
+  func withAWindowOutOfView(_ displays: [DisplaySnapshot], size: CGSize, titleBar: CGFloat) -> (Harness, f: WindowID) {
+    let h = Harness(displays: displays)
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let f = h.system.open(app: "Editor", pid: 12, frame: CGRect(origin: CGPoint(x: 300, y: 100), size: size))
+    h.system.setTitleBar(f, titleBar)
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("zoom \(a.rawValue)")
+    return (h, f)
+  }
+
+  func whatShows(_ h: Harness, of frame: CGRect) -> CGFloat {
+    h.system.displayList.map { frame.intersection($0.frame).area }.reduce(0, +)
+  }
+
+  /// Seen on the Mac: asked to the main display's top left corner, a window of 1000×600 went to -999,531, wholly in view on the neighbour, which
+  /// it is high enough to reach; one of 656×422, which is not, rested below the main display's menu bar with one point's width in view. Arbor chose
+  /// that corner for both.
+  @Test(arguments: [(CGSize(width: 656, height: 422), 32.0), (CGSize(width: 1000, height: 600), 52.0), (CGSize(width: 900, height: 750), 28.0)])
+  func besideANeighbourThatBeginsLowerAHighWindowDoesNotEndUpInView(size: CGSize, titleBar: Double) throws {
+    let (h, f) = withAWindowOutOfView([Self.main, Self.lowerLeft, Self.right], size: size, titleBar: CGFloat(titleBar))
+    let frame = try #require(h.frame(f))
+    #expect(h.controller.parked.contains(f))
+    #expect(whatShows(h, of: frame) < size.width * size.height / 4, "\(frame)")
+    let places = h.controller.parkingPlaces(for: size, on: Self.main)
+    let least = places.map { whatShows(h, of: h.system.whereMacOSPuts(CGRect(origin: $0, size: size), titleBar: CGFloat(titleBar))) }.min()
+    #expect(whatShows(h, of: frame) == least, "\(frame)")
+    #expect(h.measure { h.system.setDisplays(h.system.displayList) }.moves == 0, "and there it stays")
+  }
+
+  /// With a wider display below, the top right corner is where least of a window shows. It rests below the menu bar there (36 of 36 on the Mac),
+  /// which Arbor took for a refusal: at every report of the displays it asked again. The menu bar stops every window alike, so
+  /// nothing is learnt of this window's title bar.
+  @Test func aWindowParkedAtTheTopIsNotAskedAgain() {
+    let below = Self.display("below", CGRect(x: -160, y: 900, width: 1920, height: 1080))
+    let (h, f) = withAWindowOutOfView([Self.main, below], size: CGSize(width: 656, height: 422), titleBar: 32)
+    #expect(h.frame(f) == CGRect(x: 1599, y: 31, width: 656, height: 422))
+    for _ in 1...3 { #expect(h.measure { h.system.setDisplays(h.system.displayList) }.moves == 0) }
+    #expect(h.controller.titleBars[f] == nil)
+  }
+
+  /// A window of which nothing is known is asked for its size where it stands, before it goes to its slot. One that lies under the menu bar would
+  /// hop below it at the question, so it is not asked there.
+  @Test(arguments: [(100, 2), (10, 1)] as [(CGFloat, Int)]) func aWindowThatLiesUnderTheMenuBarIsNotAskedForItsSizeThere(y: CGFloat, calls: Int) {
+    let h = Harness()
+    let a = h.system.open(app: "A", pid: 11, frame: CGRect(x: 200, y: y, width: 1000, height: 600))
+    h.start()
+    let mark = h.system.moveLog.count
+    h.run("dock \(a.rawValue) left")
+    #expect(h.system.moveLog[mark...].filter { $0.window == a }.count == calls, "\(h.system.moveLog[mark...])")
+    expectWindowsMatchLayout(h)
+  }
+
+  /// With the Dock at the right what went out of view did not: asked for 1023,767 a window took 934,740, 20 times of 20: with nothing of it inside the
+  /// visible frame macOS pulls a window in until 40 points are, and the Dock's strip shows it besides. It waits at the side where one point
+  /// inside the visible frame is one point to see.
+  @Test(arguments: [(0.0, 50.0, -479.0), (50.0, 0.0, 1023.0)]) func besideADockAtTheSideItWaitsAtTheOtherSide(left: Double, right: Double, x: Double) {
+    let hosted = Self.display("main", CGRect(x: 0, y: 0, width: 1024, height: 768), left: CGFloat(left), right: CGFloat(right))
+    let h = Harness(displays: [hosted])
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 400, height: 400))
+    let f = h.system.open(app: "Editor", pid: 12, frame: CGRect(x: 300, y: 100, width: 480, height: 348))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    let budget = h.measure { h.run("zoom \(a.rawValue)") }
+    #expect(h.frame(f) == CGRect(x: x, y: 740, width: 480, height: 348))
+    #expect(budget.repeatMoves == 0 && budget.idleMoves == 0, "\(budget)")
+    #expect(h.measure { h.system.setDisplays(h.system.displayList) }.moves == 0, "and there it stays")
+  }
+}
