index 00000000..7089e871
--- /dev/null
+++ b/scripts/mac-shell/check-where-it-parks.sh
@@ -0,0 +1,102 @@
+#!/bin/bash
+# Where a window waits that is out of view, on real macOS: does it rest where Arbor reckoned, with as little of it to see, and is it left in peace there?
+#
+#   scripts/mac-shell/run.sh --no-preflight "<why>" scripts/mac-shell/check-where-it-parks.sh
+#
+# Why no pre-flight: the fake Mac has no stand-in for the Dock's side nor for a virtual display, so a rehearsal plays the first two claims with the Dock at the
+# bottom (the first is red there, rightly) and ends at the third.
+#
+# macOS does not leave a window where it is asked to go. Its title bar stays below the menu bar and above the bottom of the visible frame; with nothing of
+# it inside a visible frame it is pulled in until 40 points are; and the display that sees to that is the one that has most of the window, where the
+# display its corner is on has a column of it at most (Sources/ArborCore/Screens.swift, from bare calls with no Arbor running). Arbor reckoned by the
+# corner and only with the stop at the bottom. What only a Mac can say is whether ARBOR's own calls end as it now reckons:
+#   - the Dock at the right: out of view at the bottom LEFT, one column to see. It was asked to 1023,767 and took 934,740: 90 by 28 points in plain view.
+#   - the Dock at the left: at the bottom right.
+#   - a wider display below: at the top right, BELOW THE MENU BAR; and not asked again when the displays report. It was, at every report.
+#   - each time: one request on the way out, one on the way back, and back where it was.
+# After each claim: what Arbor asked of the window, from arbor.log.
+#
+# Only on GitHub's Macs: it moves the Dock to every side and puts it back, plugs a virtual display in and out and rearranges the displays.
+source "$(dirname "$0")/lib.sh"
+needs_throwaway_mac "move the Dock to every side, plug a virtual display in and out and rearrange the displays, at which macOS moves every window"
+
+whole() { awk '{ for (i = 1; i <= NF; i++) printf "%d ", $i + 0.5 }' | sed 's/ $//'; }
+now_at() { real_frame_of "$1" | whole; }
+is_at() { [ "$(now_at "$1")" = "$2" ] || { echo "    it is at $(now_at "$1"), not at $2"; return 1; }; }
+rests_at() { [ "$(now_at "$1" | cut -d' ' -f1-2)" = "$2" ] || { echo "    it is at $(now_at "$1"), its corner not at $2"; return 1; }; }
+asked_of() { arbor_log_since "$ARBOR_STEP_MARK" | grep -E "w$1\\b" | tail -n 8 | sed 's/^.*DEBUG /    (/; s/$/)/' || true; }
+# recorded <name> <command…>: a trace of its own around the command. frames_asked <name> <id>: how many frames Arbor asked that window for in it.
+recorded() {
+  local name=$1
+  shift
+  "$ARBOR_BIN/arborctl" trace on "$name" > /dev/null
+  "$@"
+  sleep 3
+  "$ARBOR_BIN/arborctl" trace off > /dev/null
+}
+frames_asked() { cat "$ARBOR_HOME"/traces/*-"$1".jsonl | grep -c "\"call\":\"setFrame\".*\"id\":$2\\b" || true; }
+
+DOCK_WAS="$(defaults read com.apple.dock orientation 2> /dev/null || echo bottom)"
+dock_at() {
+  defaults write com.apple.dock orientation "$1"
+  killall Dock
+  sleep 4 # the Dock comes back, and the visible frame follows a moment later
+  echo "> the Dock at the $1"
+}
+at_exit "dock_at $DOCK_WAS"
+
+arbor_build
+macos_tiling off
+
+for side in right left; do
+  dock_at "$side"
+  arbor_start 2
+  take "sx sy sw sh" screen_of 1
+  take "fx fy fw fh" display_frame_of 1
+  echo "the display $fx $fy $fw $fh, visible $sx $sy $sw $sh"
+  claim "the Dock at the $side: what goes out of view does"
+  # It waits at the width of its slot.
+  ctl dock "$W1" left
+  ctl dock "$W2" right
+  check "both are docked" eventually is in_slot "$W2"
+  slot=$(now_at "$W2")
+  width=$(echo "$slot" | cut -d' ' -f3)
+  ctl zoom "$W1"
+  check "it is out of view" eventually is parked "$W2"
+  if [ "$side" = right ]; then x=$((sx - width + 1)); else x=$((sx + sw - 1)); fi
+  check "at the side away from the Dock, one column inside the visible frame, its title bar above the bottom" \
+    eventually rests_at "$W2" "$x $((sy + sh - 28))"
+  check "and stays there" stays rests_at "$W2" "$x $((sy + sh - 28))"
+  asked_of "$W2"
+  shot "dock-$side"
+  ctl back
+  check "it is back in its slot" eventually is_at "$W2" "$slot"
+  arbor_stop
+done
+dock_at bottom
+
+arbor_start 2
+claim "a wider display below: it waits at the top right, below the menu bar, and is not asked again"
+display_add 1920 1080 below
+display_move below -160
+take "sx sy sw sh" screen_of 1
+take "fx fy fw fh" display_frame_of 1
+echo "the main display $fx $fy $fw $fh, visible $sx $sy $sw $sh"
+ctl dock "$W1" left
+ctl dock "$W2" right
+check "both are docked" eventually is in_slot "$W2"
+slot=$(now_at "$W2")
+ctl zoom "$W1"
+check "it is out of view" eventually is parked "$W2"
+check "at the top right corner, below the menu bar" eventually rests_at "$W2" "$((fx + fw - 1)) $sy"
+asked_of "$W2"
+shot top-right
+claim "the displays report, and nothing that matters to it has changed: it is left in peace"
+recorded peace display_move below -150
+check "it is where it was" rests_at "$W2" "$((fx + fw - 1)) $sy"
+check "and was asked for nothing" test "$(frames_asked peace "$W2")" = 0
+asked_of "$W2"
+ctl back
+check "it is back in its slot" eventually is_at "$W2" "$slot"
+display_remove
+arbor_stop
