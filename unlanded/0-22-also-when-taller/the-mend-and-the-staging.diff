-  claim "out of a slot as high as the screen, let go where its own size ends in the Dock's strip: its own size (drop $round)"
+# From the recording of the claim that is running: where the window stood when the button came up, and the frames Arbor asked it for since.
+this_claim() { ls -t "$ARBOR_HOME"/traces/*.jsonl | head -n 1; }
+stood_at() { grep -E "\"event\":\"changed\",\"user\":true.*\"id\":$1[,}]" "$(this_claim)" | tail -n 1 | sed -E 's/.*"frame":\[([^]]*)\].*/\1/; s/,/ /g' | whole; }
+asked_since_the_drop() { awk -v id="\"id\":$1[,}]" '/"dragEnded"/ { up = 1 } up && /"call":"setFrame"/ && $0 ~ id' "$(this_claim)"; }
+# It shrinks both ways, so it is sized where it stands: that is where its own height has to end in the strip. A check of its own, for a hosted Mac's
+# window lags a slow pointer by as much as 200 points: without it every drop passed by one request, and the way round was never gone.
+would_end_in_the_strip() {
+  local foot=$(($(stood_at "$1" | cut -d' ' -f2) + 348))
+  [ "$foot" -gt "$((bottom + 1))" ] && [ "$foot" -le "$((fy + fh))" ] || { echo "    it stood at $(stood_at "$1"): its own height would end at $foot"; return 1; }
+}
+more_than_one_request() { [ "$(asked_since_the_drop "$1" | wc -l)" -gt 1 ]; }
+# let_go_low <x> <options of the drag>
+let_go_low() {
+  local x=$1
+  shift
   ctl dock "$W2" left
   check "it is docked, as high as the screen" eventually taller_than "$W2" "$((sh - 40))"
   take "tx ty" titlebar_of "$W2"
-  drag "$tx" "$ty" "$((sx + sw * 3 / 4))" "$low" --steps 24 --duration 0.8 --plain
+  # So far down that it stands where its own height ends 30 points below the visible frame.
+  drag "$tx" "$ty" "$x" "$((ty + bottom + 30 - 348 - $(now_at "$W2" | cut -d' ' -f2)))" "$@" --plain
   check "it floats" eventually is floating "$W2"
   check "at its own size" eventually has_size "$W2" "$own"
   check "and stays so" stays has_size "$W2" "$own"
-  echo "    it is at $(now_at "$W2"): its foot at $(now_at "$W2" | awk '{ print $2 + $4 }'), the visible frame ends at $bottom, the display at $((fy + fh))"
+  echo "    it stood at $(stood_at "$W2") and is at $(now_at "$W2"); the visible frame ends at $bottom, the display at $((fy + fh))"
+  asked_since_the_drop "$W2" | sed -E 's/^/    /; s/,"id":[0-9]+//'
   asked_of "$W2"
+}
+for round in 1 2 3; do
+  claim "out of a slot as high as the screen, let go where its own size ends in the Dock's strip: its own size (drop $round)"
+  let_go_low "$((sx + sw * 3 / 5))" --duration 0.25 --steps 12 --hold 0
+  check "the case: where it stood its own height would end in the strip" would_end_in_the_strip "$W2"
+  check "so it was not done by one request" more_than_one_request "$W2"
   shot "let-go-in-the-strip-$round"
 done
 
