diff --git a/Tests/ArborKitTests/OneRequestForTheKeyboardTests.swift b/Tests/ArborKitTests/OneRequestForTheKeyboardTests.swift
new file mode 100644
index 00000000..1c328827
--- /dev/null
+++ b/Tests/ArborKitTests/OneRequestForTheKeyboardTests.swift
@@ -0,0 +1,153 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// What names a window gives THAT window the keyboard, and inside such an act nobody else is handed it (collab/BOARD.md, 1.89).
+///
+/// On the way to the window the view moves, the window that had the keyboard goes out of view, and Arbor used to hand the keyboard to a window in view,
+/// of another app, and ask for the window that was named in the same breath. On a Mac the first app's coming forward lands after the second
+/// request, which asks nobody forward because its app is still in front: the keyboard ends in a window nobody named. That lives below the
+/// seam, where only the model of a Mac can play it (`make mac-on-linux`). What shows here is its cause: two requests where one is due.
+@Suite @MainActor struct OneRequestForTheKeyboardTests {
+  /// Alpha's docked window fills the view and has the keyboard. Alpha and Beta each have a floating window, out of view with the Desktop, and
+  /// Beta's was used after Alpha's, which is what made Arbor pick it.
+  func aDockedWindowFillsTheView(_ more: (Harness) -> Void = { _ in }) -> (Harness, docked: WindowID, floating: WindowID, others: WindowID) {
+    let h = Harness()
+    let docked = h.system.open(app: "Alpha", pid: 11, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+    let floating = h.system.open(app: "Alpha", pid: 11, frame: CGRect(x: 840, y: 520, width: 300, height: 220))
+    let others = h.system.open(app: "Beta", pid: 12, frame: CGRect(x: 840, y: 80, width: 300, height: 220))
+    more(h)
+    h.start()
+    h.run("dock \(docked.rawValue) left")
+    for window in [floating, others, docked] { h.system.userFocus(window) }
+    h.run("zoom \(docked.rawValue)")
+    h.scheduler.advance(by: 2)
+    #expect(h.system.focusedWindow() == docked && !h.system.isVisible(floating) && !h.system.isVisible(others), "\(h.ascii())")
+    return (h, docked, floating, others)
+  }
+
+  func asked(_ h: Harness, since mark: Int) -> [WindowID] { h.system.focusLog.dropFirst(mark).map(\.window) }
+
+  @Test(arguments: ["reveal $w", "focus $w", "find $w"]) func aCommandThatNamesAFloatingWindow(line: String) {
+    let (h, _, floating, _) = aDockedWindowFillsTheView()
+    let mark = h.system.focusLog.count
+    #expect(h.run(line.replacingOccurrences(of: "$w", with: "\(floating.rawValue)")).ok)
+    h.scheduler.advance(by: 2)
+    #expect(asked(h, since: mark) == [floating], "one request, for the window that was named")
+    #expect(h.system.focusedWindow() == floating && h.system.isVisible(floating))
+    expectWindowsMatchLayout(h)
+  }
+
+  @Test func aRowOfGoTo() {
+    let (h, _, floating, _) = aDockedWindowFillsTheView()
+    #expect(h.run("find").ok)
+    let mark = h.system.focusLog.count
+    h.controller.finderChose(.window(floating))
+    h.scheduler.advance(by: 2)
+    #expect(asked(h, since: mark) == [floating])
+    #expect(h.system.focusedWindow() == floating)
+  }
+
+  /// The view is on the Desktop with the keyboard in Beta's floating window, and the docked window is named, by a command or by a click on it in the
+  /// minimap, which goes the way of a tile's click.
+  @Test(arguments: ["reveal", "zoom", "minimap"]) func theDockedWindowIsNamedFromTheDesktop(how: String) throws {
+    let (h, docked, _, others) = aDockedWindowFillsTheView()
+    #expect(h.run("desktop").ok)
+    h.system.userFocus(others)
+    h.scheduler.advance(by: 2)
+    let mark = h.system.focusLog.count
+    if how == "minimap" {
+      h.controller.tileActivated(display: FakeWindowSystem.standardDisplay.id, node: try #require(h.workspace.tree.leaf(containing: docked)))
+    } else {
+      #expect(h.run("\(how) \(docked.rawValue)").ok)
+    }
+    h.scheduler.advance(by: 2)
+    #expect(asked(h, since: mark) == [docked], "\(how)")
+    #expect(h.system.focusedWindow() == docked && h.system.isVisible(docked), "\(how)")
+  }
+
+  /// It lies in the Dock, is asked back by name, and the view waits for it: the move comes seconds after the request, and hands the keyboard to nobody else.
+  @Test func aWindowThatIsAskedBackOutOfTheDock() {
+    let (h, docked, floating, others) = aDockedWindowFillsTheView()
+    h.system.setMinimized(floating, true)
+    h.scheduler.advance(by: 2)
+    h.system.userFocus(docked)
+    let mark = h.system.focusLog.count
+    #expect(h.run("reveal \(floating.rawValue)").ok)
+    h.scheduler.advance(by: 5)
+    #expect(!asked(h, since: mark).contains(others), "\(asked(h, since: mark))")
+    #expect(h.system.focusedWindow() == floating && h.system.isVisible(floating))
+  }
+
+  /// The app of the window that was named does not answer: it cannot be fetched, and on a Mac the request reaches nobody. The keyboard does not stay in
+  /// the window that the move took out of view.
+  @Test func theAppOfTheWindowThatWasNamedHangs() {
+    var hung = WindowID(0)
+    let (h, docked, _, others) = aDockedWindowFillsTheView {
+      hung = $0.system.open(app: "Gamma", pid: 13, frame: CGRect(x: 500, y: 300, width: 300, height: 220))
+    }
+    #expect(!h.system.isVisible(hung))
+    h.system.setUnresponsive(pid: 13, true)
+    let mark = h.system.focusLog.count
+    _ = h.run("reveal \(hung.rawValue)")
+    #expect(!h.system.isVisible(docked) && asked(h, since: mark).first == others, "\(asked(h, since: mark)); \(h.ascii())")
+  }
+
+  /// A window is let be where it stood when Arbor started, with the keyboard in it (Controller+LetBe.swift), and another window is named. The one that
+  /// was let be goes into its tile, and the view does not go after it: the keyboard is about to leave it.
+  @Test(arguments: ["tile", "Go to…", "reveal"]) func anotherWindowIsNamedWhileOneIsLetBe(how: String) throws {
+    var settings = Settings()
+    settings.makeRoom = false
+    let old = Harness(settings: settings)
+    let player = old.system.open(app: "Music", pid: 11, frame: CGRect(x: 500, y: 300, width: 400, height: 300))
+    let browser = old.system.open(app: "Safari", pid: 12, frame: CGRect(x: 200, y: 100, width: 700, height: 500))
+    let chat = old.system.open(app: "Chat", pid: 13, frame: CGRect(x: 300, y: 200, width: 500, height: 400))
+    old.start()
+    for line in ["dock \(player.rawValue) left", "dock \(browser.rawValue) right", "dock \(chat.rawValue) right"] { old.run(line) }
+    for line in ["resize \(player.rawValue) right -300", "resize \(chat.rawValue) left -300"] { old.run(line) }
+    old.scheduler.advance(by: 3)
+    #expect(old.layout?.hiddenWindows == [player, chat], "the fixture: two tiles beside a window: \(old.ascii())")
+    old.controller.shutdown()
+    old.system.userFocus(player)
+    let h = old.newProcess()
+    h.start()
+    h.scheduler.advance(by: 3)
+    #expect(h.controller.windowLetBe == player && h.system.focusedWindow() == player)
+    h.system.clearFrameLog()
+    let (mark, place) = (h.system.focusLog.count, try #require(h.workspace.tree.leaf(containing: chat)))
+    switch how {
+    case "tile": h.overlays.clickTile(place)
+    case "Go to…":
+      #expect(h.run("find").ok)
+      h.controller.finderChose(.window(chat))
+    default: #expect(h.run("reveal \(chat.rawValue)").ok)
+    }
+    h.scheduler.advance(by: 3)
+    #expect(h.workspace.camera == place && h.system.isVisible(chat) && !h.system.isVisible(player), "\(how): \(h.ascii())")
+    #expect(asked(h, since: mark) == [chat] && h.system.focusedWindow() == chat, "\(how): \(asked(h, since: mark))")
+    #expect(movesWithoutWaste(h, of: player, since: h.system.movesWhenTheFrameLogWasCleared) == 1, "\(how): once, to the corner")
+    expectWindowsMatchLayout(h)
+  }
+
+  /// The control: a move of the view that names nobody still takes the keyboard out of the window it takes out of view.
+  @Test func aMoveThatNamesNobodyStillHandsTheKeyboardOn() {
+    let (h, docked, _, others) = aDockedWindowFillsTheView()
+    let mark = h.system.focusLog.count
+    #expect(h.run("desktop").ok)
+    h.scheduler.advance(by: 2)
+    #expect(!h.system.isVisible(docked) && asked(h, since: mark) == [others], "the one used last of those in view")
+  }
+
+  /// The promise ends with the act.
+  @Test func nothingIsLeftPromised() {
+    let (h, _, floating, _) = aDockedWindowFillsTheView()
+    #expect(h.run("reveal \(floating.rawValue)").ok)
+    h.scheduler.advance(by: 2)
+    let mark = h.system.focusLog.count
+    #expect(h.run("back").ok)
+    h.scheduler.advance(by: 2)
+    #expect(asked(h, since: mark).count == 1, "the next move of the view hands the keyboard on again: \(asked(h, since: mark))")
+  }
+}
diff --git a/scripts/mac-on-linux/tests/OneRequest.swift b/scripts/mac-on-linux/tests/OneRequest.swift
new file mode 100644
index 00000000..c67c14b2
--- /dev/null
+++ b/scripts/mac-on-linux/tests/OneRequest.swift
@@ -0,0 +1,59 @@
+import ArborCore
+@testable import ArborKit
+import CoreGraphics
+import FakeMacOS
+import Foundation
+
+// What names a window gives THAT window the keyboard, and inside such an act nobody else is handed it (collab/BOARD.md, 1.89).
+//
+// The race: inside one act Arbor asked for the keyboard twice. First for a window it picked itself, of ANOTHER app, because the window that had the keyboard went
+// out of view with the move; then for the window its person named, of the app that still read as in front, so that the layer's `focus` spared `activate()`. The other
+// app's coming forward landed last. The roads to it are told in N19Roads.swift. Here: two that lie beside them.
+
+/// Alpha in front with the keyboard in its docked window, which fills the view. `floating`, of `app`, and Beta's window float, out of view, and Beta's was used last of the two.
+@MainActor
+private func stage(_ story: Story, floatingOf app: String) -> (StoreyTwo, docked: FakeMac.Window, floating: FakeMac.Window, others: FakeMac.Window) {
+  var docked: FakeMac.Window!, floating: FakeMac.Window!, others: FakeMac.Window!
+  let two = StoreyTwo(story) { mac in
+    let alpha = mac.launch("Alpha")
+    docked = mac.open("docked", in: alpha, frame: CGRect(x: 40, y: 60, width: 400, height: 300))
+    floating = mac.open("floating", in: app == "Alpha" ? alpha : mac.launch(app), frame: CGRect(x: 640, y: 420, width: 300, height: 220))
+    others = mac.open("others", in: mac.launch("Beta"), frame: CGRect(x: 640, y: 80, width: 300, height: 220))
+  }
+  two.run("dock \(docked.number) left")
+  for window in [floating!, others!, docked!] {
+    two.mac.click(window)
+    two.mac.pass(1)
+  }
+  two.run("zoom \(docked.number)", then: 2)
+  story.check(
+    "the stage: the docked window fills the view and has the keyboard, what floats is out of view",
+    two.mac.keyWindow === docked && two.isOutOfView(floating) && two.isOutOfView(others))
+  return (two, docked, floating, others)
+}
+
+@MainActor
+func tellOfOneRequestForTheKeyboard(_ book: Book) {
+  book.story("the window that is named lies in the Dock, and its app takes longer than the view waits") { story in
+    let (two, docked, floating, others) = stage(story, floatingOf: "Alpha")
+    two.mac.minimize(floating)
+    two.mac.pass(2)
+    two.mac.click(docked)
+    two.mac.pass(1)
+    docked.app.carriesOutAfter = 1.5
+    others.app.carriesOutAfter = 1.5
+    two.run("reveal \(floating.number)", then: 8)
+    story.check("the window that was named has the keyboard", two.mac.keyWindow === floating, "w\(two.mac.keyWindow?.number ?? 0) has it")
+    story.check("and is in view", two.isInView(floating), two.whereabouts(floating))
+  }
+
+  book.story("the window that is named belongs to an app that hangs") { story in
+    let (two, docked, floating, _) = stage(story, floatingOf: "Gamma")
+    two.mac.hang(floating.app)
+    two.run("reveal \(floating.number)", then: 8)
+    story.check("the window that had the keyboard is out of view", two.isOutOfView(docked), two.whereabouts(docked))
+    story.check(
+      "the keyboard is in a window in view: the request for the one that was named reaches nobody", two.mac.keyWindow.map { two.isInView($0) } ?? false,
+      "w\(two.mac.keyWindow?.number ?? 0) has it")
+  }
+}
