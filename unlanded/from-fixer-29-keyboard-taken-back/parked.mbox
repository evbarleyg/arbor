new file mode 100644
index 00000000..3db8d4f0
--- /dev/null
+++ b/Sources/ArborCore/AppAskedForward.swift
@@ -0,0 +1,31 @@
+import Foundation
+
+/// Whether giving a window the keyboard has to activate its app.
+///
+/// Not if the app is in front already. But an activation takes a moment to land, 0 to 40 ms as measured on macOS 26.6, and until then macOS
+/// names the old app as the one in front. A request for a window of that app made meanwhile (⌃⌥→ and ⌃⌥← in one roll of the fingers)
+/// activated nobody, and the first activation landed all the same: the request that had been taken back came true, 6 of 6, and the
+/// view went after the keyboard a third time. Activated again, although it is named in front, the old app stays in front: 6 of 6. macOS then
+/// reports both, in the order they were asked for, within a millisecond (collab/evidence/a-request-taken-back.txt).
+///
+/// So the app that was asked forward is remembered until it has come, or for as long as it could still be on its way.
+public struct AppAskedForward: Equatable, Sendable {
+  public var pid: Int32
+  /// When it was asked, in seconds of the same clock as `now` below.
+  public var at: TimeInterval
+
+  public init(pid: Int32, at: TimeInterval) {
+    self.pid = pid
+    self.at = at
+  }
+
+  /// Half a second, over ten times what was measured. An activation that macOS refuses must not count as on its way for ever.
+  public static let patience: TimeInterval = 0.5
+
+  /// `inFront`: the app macOS names as the one in front. `asked`: the last one that was asked forward and has not come.
+  public static func mustActivate(_ pid: Int32, inFront: Int32?, asked: AppAskedForward?, now: TimeInterval) -> Bool {
+    if inFront != pid { return true }
+    guard let asked, asked.pid != pid else { return false }
+    return now - asked.at < patience
+  }
+}
