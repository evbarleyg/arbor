+@Suite struct AppAskedForwardTests {
+  @Test func anAppThatIsNotInFrontIsActivated() {
+    #expect(AppAskedForward.mustActivate(7, inFront: 3, asked: nil, now: 10))
+    #expect(AppAskedForward.mustActivate(7, inFront: nil, asked: nil, now: 10))
+    #expect(AppAskedForward.mustActivate(7, inFront: 3, asked: AppAskedForward(pid: 7, at: 9.99), now: 10), "asked again, it is asked again")
+  }
+
+  @Test func theAppInFrontIsLeftAlone() {
+    #expect(!AppAskedForward.mustActivate(3, inFront: 3, asked: nil, now: 10))
+    #expect(!AppAskedForward.mustActivate(3, inFront: 3, asked: AppAskedForward(pid: 3, at: 9.99), now: 10), "it was itself the last to be asked")
+  }
+
+  /// There and back in one roll of the fingers.
+  @Test func unlessAnotherIsStillOnItsWay() {
+    let asked = AppAskedForward(pid: 7, at: 10)
+    #expect(AppAskedForward.mustActivate(3, inFront: 3, asked: asked, now: 10.005))
+    #expect(AppAskedForward.mustActivate(3, inFront: 3, asked: asked, now: 10.04), "the longest an activation was seen to take")
+    #expect(!AppAskedForward.mustActivate(3, inFront: 3, asked: asked, now: 10 + AppAskedForward.patience), "macOS has refused it")
+  }
+}
