+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// After a login a place is kept for a docked window that is to come back (`Controller+PendingSlots.swift`). Titles being what they
+/// are, the app's only loose window is let in under another name, for now. But one whose title the saved file knows as a floating
+/// window's of that app is known to be somebody else: it took the place first and was thrown out when the owner came, and where
+/// the owner never came it stayed docked for good, a window nobody docked (found by the walks, once they restarted the Mac).
+@Suite @MainActor struct AKeptPlaceIsItsOwnersTests {
+  // MARK: The evening before, and the next morning
+
+  struct Evening {
+    var saved: PersistedState
+    /// Docked at the right, beside the Desktop.
+    var owner: WindowSnapshot
+    /// The same app's, never docked.
+    var sibling: WindowSnapshot
+    /// Where the owner was while it was docked.
+    var place: CGRect
+  }
+
+  /// One app with two windows: one docked, one floating. Then the Mac is shut down.
+  /// - Parameter another: the title of one more floating window of the app.
+  func evening(ownersTitle: String = "Letter", siblingsTitle: String = "Notes for the letter", another: String? = nil) throws -> Evening {
+    let h = Harness()
+    h.start()
+    let owner = h.system.open(app: "Pages", title: ownersTitle, pid: 1003, frame: CGRect(x: 618, y: 457, width: 710, height: 400))
+    let sibling = h.system.open(app: "Pages", title: siblingsTitle, pid: 1003, frame: CGRect(x: 71, y: 160, width: 516, height: 409))
+    if let another { h.system.open(app: "Pages", title: another, pid: 1003, frame: Self.whereTheThirdStands) }
+    h.scheduler.advance(by: 2)
+    h.system.userFocus(owner)
+    h.scheduler.advance(by: 2)
+    try #require(h.run("dock right", from: .shortcut).ok)
+    h.scheduler.advance(by: 5)
+    try #require(h.workspace.isDocked(owner) && h.workspace.isFloating(sibling) && h.layout?.tiles.isEmpty == true, "\(h.ascii())")
+    let place = try #require(h.frame(owner))
+    h.controller.shutdown()
+    func now(_ id: WindowID) throws -> WindowSnapshot { try #require(h.system.allWindows().first { $0.id == id }) }
+    return Evening(saved: try #require(h.store.saved), owner: try now(owner), sibling: try now(sibling), place: place)
+  }
+
+  static let whereTheThirdStands = CGRect(x: 120, y: 420, width: 420, height: 300)
+
+  /// Arbor is up before the apps. Numbers restart after a reboot: unrelated windows have the old ones.
+  func morning(_ evening: Evening) -> Harness {
+    let h = Harness(saved: evening.saved)
+    for _ in 0..<7 { h.system.open(app: "Filler", pid: 700, frame: CGRect(x: 100, y: 600, width: 300, height: 200)) }
+    h.start()
+    h.scheduler.advance(by: 2)
+    return h
+  }
+
+  func reopen(_ window: WindowSnapshot, in h: Harness, title: String? = nil) -> WindowID {
+    let id = h.system.open(app: window.appName, bundleID: window.bundleID, title: title ?? window.title, pid: window.pid, frame: window.frame)
+    h.scheduler.advance(by: 2)
+    return id
+  }
+
+  /// Everything Arbor asked of `window`, questions included.
+  func asked(of window: WindowID, in h: Harness) -> [CGRect] { h.system.moveLog.filter { $0.window == window }.map(\.after) }
+
+  func expectSound(_ h: Harness, sourceLocation: SourceLocation = #_sourceLocation) {
+    #expect(h.controller.invariantViolations().isEmpty, "\(h.controller.invariantViolations())", sourceLocation: sourceLocation)
+    expectWindowsMatchLayout(h, sourceLocation: sourceLocation)
+  }
+
+  // MARK: Known to be somebody else
+
+  /// It floats where it opened, no frame is set on it, and the place goes on waiting.
+  @Test func whoFloatedInTheFileFloatsWhereItOpensAndThePlaceGoesOnWaiting() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let sibling = reopen(evening.sibling, in: h)
+    #expect(h.workspace.isFloating(sibling), "\(h.ascii())")
+    #expect(h.frame(sibling) == evening.sibling.frame && asked(of: sibling, in: h).isEmpty, "\(asked(of: sibling, in: h))")
+    #expect(h.controller.snapshot().waiting.count == 1 && h.run("status").message.contains("1 place kept"))
+    expectSound(h)
+  }
+
+  /// The owner comes and goes straight to its place, and nobody is thrown out of it.
+  @Test func theOwnerThenTakesItsPlaceAndNobodyElseIsMoved() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let sibling = reopen(evening.sibling, in: h)
+    let owner = reopen(evening.owner, in: h)
+    #expect(h.workspace.isDocked(owner) && h.frame(owner) == evening.place, "\(h.ascii())")
+    #expect(h.workspace.isFloating(sibling) && asked(of: sibling, in: h).isEmpty, "\(asked(of: sibling, in: h))")
+    #expect(h.controller.snapshot().waiting.isEmpty)
+    expectSound(h)
+  }
+
+  /// The worse face: the owner never comes. Nobody docked the other one, and it is not docked when the wait is over either.
+  @Test func whereTheOwnerNeverComesNobodyIsDockedInItsStead() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let sibling = reopen(evening.sibling, in: h)
+    h.scheduler.advance(by: Controller.pendingSlotLifetime + 20)
+    #expect(h.run("relayout").ok)
+    h.scheduler.advance(by: 5)
+    #expect(h.workspace.isFloating(sibling) && asked(of: sibling, in: h).isEmpty, "\(h.ascii())")
+    #expect(h.frame(sibling) == evening.sibling.frame)
+    #expect(h.controller.snapshot().waiting.isEmpty, "its time is up")
+    expectSound(h)
+  }
+
+  /// Back before Arbor is up, it is matched no otherwise.
+  @Test func backBeforeArborItIsNotDockedEither() throws {
+    let evening = try evening()
+    let h = Harness(saved: evening.saved)
+    for _ in 0..<7 { h.system.open(app: "Filler", pid: 700, frame: CGRect(x: 100, y: 600, width: 300, height: 200)) }
+    let sibling = h.system.open(
+      app: evening.sibling.appName, bundleID: evening.sibling.bundleID, title: evening.sibling.title, pid: evening.sibling.pid,
+      frame: evening.sibling.frame)
+    h.start()
+    h.scheduler.advance(by: 2)
+    #expect(h.workspace.isFloating(sibling) && asked(of: sibling, in: h).isEmpty, "\(h.ascii())")
+    #expect(h.controller.snapshot().waiting.count == 1)
+    let owner = reopen(evening.owner, in: h)
+    #expect(h.workspace.isDocked(owner) && h.frame(owner) == evening.place && asked(of: sibling, in: h).isEmpty)
+    expectSound(h)
+  }
+
+  /// A terminal is called otherwise with every command, a browser with every page. Who it is does not change: once it has said the name
+  /// it is known, and is no stranger a moment later.
+  @Test func onceKnownItIsKnownWhateverItIsCalledLater() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let sibling = reopen(evening.sibling, in: h)
+    h.system.setTitle(sibling, "Notes for the letter (edited)")
+    h.scheduler.advance(by: 20)
+    #expect(h.workspace.isFloating(sibling) && asked(of: sibling, in: h).isEmpty, "\(h.ascii())")
+    #expect(h.controller.snapshot().waiting.count == 1)
+    h.scheduler.advance(by: Controller.pendingSlotLifetime + 20)
+    #expect(h.workspace.isFloating(sibling) && asked(of: sibling, in: h).isEmpty, "\(h.ascii())")
+    expectSound(h)
+  }
+
+  // MARK: May be the owner under another name: as before
+
+  /// The control. A stranger to the file (a count in the title, "Untitled", a welcome window) is let in, holds the place for now,
+  /// and gives it back when the owner comes.
+  @Test func aStrangerToTheFileIsLetInForNowAsBefore() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let stranger = reopen(evening.sibling, in: h, title: "Untitled")
+    #expect(h.workspace.isDocked(stranger) && h.frame(stranger) == evening.place, "\(h.ascii())")
+    let owner = reopen(evening.owner, in: h)
+    #expect(h.workspace.isDocked(owner) && h.frame(owner) == evening.place, "\(h.ascii())")
+    #expect(h.workspace.isFloating(stranger) && h.frame(stranger) == evening.sibling.frame, "back where it opened")
+    expectSound(h)
+  }
+
+  /// And where nobody else comes it was the owner, under another name.
+  @Test func aStrangerThatNobodyFollowsKeepsThePlace() throws {
+    let evening = try evening()
+    let h = morning(evening)
+    let renamed = reopen(evening.owner, in: h, title: "Letter (edited)")
+    h.scheduler.advance(by: Controller.pendingSlotLifetime + 20)
+    #expect(h.workspace.isDocked(renamed) && h.frame(renamed) == evening.place, "\(h.ascii())")
+    expectSound(h)
+  }
+
