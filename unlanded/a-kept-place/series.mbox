+  /// The one that came first is a new window after all. It floats where its app had put it.
+  /// - Parameter given: what came of sending it there, if it has been sent already.
+  private func floatWhereItOpened(_ holder: WindowID, _ held: ProvisionalSlot, orOn display: DisplayID, given: Given? = nil) {
+    let home = displayID(at: held.openedAt.center).flatMap { workspaces[$0] == nil ? nil : $0 } ?? display
+    workspaces[home]!.floating[holder] = held.openedAt
+    if let actual = (given ?? give(held.openedAt, to: holder))?.frame { windows[holder]?.frame = actual }
+    parked.remove(holder)
+    settled[holder] = nil
+    misfits[holder] = nil
+  }
+
+  /// `window` was let in as a stranger and has only now said its name, as many apps do a moment after showing a restored window: one
+  /// that the file has for a floating window. It never gets the place, from the moment that is known: back to where it opened,
+  /// and the slot waits again. The other end would be a window nobody docked, docked for good.
+  ///
+  /// Only where that is one move of one window that somebody can see, and nobody has had a hand in the arrangement since. Else
+  /// nothing happens, as before there was this: it holds the place for now, and the owner takes it over when it comes. As
+  /// `claimPendingSlot(for:)`: true if a display has been laid out for it.
+  private func giveBackTheSlot(heldForNowBy window: WindowSnapshot) -> Bool {
+    guard let held = provisionalSlots[window.id] else { return false }
+    if let display = workspaceID(containing: window.id), var workspace = workspaces[display], workspace.isDocked(window.id) {
+      // In the Dock, hidden, on another Space or in full screen no frame is set for a title nobody saw. Where it opened may be on a
+      // display that has gone since. And the window goes first: of an app that does not answer nothing is written down.
+      guard window.isPresent, workspace.tree.place(of: window.id) == held.place, !showsLessThanHalf(held.openedAt),
+        let given = give(held.openedAt, to: window.id)
+      else { return false }
+      provisionalSlots[window.id] = nil
+      moveToStandIn(window.id, hint: held.hint, in: &workspace)
+      workspaces[display] = workspace
+      floatWhereItOpened(window.id, held, orOn: display, given: given)
+      Log.info("\(window.id) is not the window its saved slot waited for, and gives it back")
+      relayout(display, reason: .structure)
+      scheduleSave()
+      return true
+    }
+    // On a display that is not connected it only had the place on paper, and floats here already.
+    for id in dormant.keys.sorted() where dormant[id]!.workspace.tree.place(of: window.id) == held.place && held.place != nil {
+      provisionalSlots[window.id] = nil
+      var workspace = dormant[id]!.workspace
+      moveToStandIn(window.id, hint: held.hint, in: &workspace)
+      dormant[id]!.workspace = workspace
+      scheduleSave()
+      break
+    }
+    return false
+  }
+
   /// `window`, docked on `display`, has closed. If it held its slot provisionally, the slot waits again (a
   /// welcome window often closes just before the real one opens) and this returns true.
