diff --git a/Sources/ArborKit/Controller/Controller+LeftBehind.swift b/Sources/ArborKit/Controller/Controller+LeftBehind.swift
new file mode 100644
index 00000000..c46df2ef
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+LeftBehind.swift
@@ -0,0 +1,98 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+
+/// Floating windows that a change of displays left mostly beyond the edge.
+///
+/// A floating window's frame is its person's, with one exception, because "never lost" outranks "never moved"
+/// (QUESTIONS, Q20): if the displays have changed and less than half of the window would show, it is fitted: moved
+/// the least that brings it wholly into view, and made smaller only if it is larger than the display. Its own frame
+/// stays remembered.
+///
+/// A window that no display shows counts as out of view, which is what fetches it (`treatStrandedWindowsAsParked`).
+/// One of which a quarter shows does not, and must not: people push windows aside until a strip is left. What tells
+/// the two apart is who did it, and that can only be told while the displays change. So it is noted then, and the
+/// layout that follows pays.
+///
+/// The debt has books of its own. `unplaced` and `owedMoves` do not say what is owed, and over a view without the
+/// Desktop they are paid as the way OUT of view.
+///
+/// Where the Desktop is in view and large enough to use, the window goes onto the Desktop, squeezed if need be, as
+/// every floating window does that Arbor places there (`floatingFrame`).
+extension Controller {
+  /// How much of `frame` shows, from 0 to 1. On all the displays together: a window across a border is in view.
+  /// (`isMostlyOffScreen` asks each display by itself, for windows that are to be on one.)
+  func shareShowing(of frame: CGRect) -> CGFloat { frame.area > 0 ? areaShowing(of: frame) / frame.area : 0 }
+
+  /// How much shows of each floating window, by the displays and frames Arbor knows. Asked before it reads them anew.
+  func sharesOfFloatingWindowsShowing() -> [WindowID: CGFloat] {
+    var shares: [WindowID: CGFloat] = [:]
+    for window in workspaces.values.flatMap(\.floating.keys) {
+      shares[window] = windows[window].map { shareShowing(of: $0.frame) }
+    }
+    return shares
+  }
+
+  /// Called once the new displays and the windows' frames on them are known, with how much of each window showed and
+  /// how large each display was. (After a pause nobody knows what showed.)
+  ///
+  /// Left behind is every floating window in view of which less than half shows, but for one that the change did not
+  /// touch: as much of it shows as before. Whoever put it there, a hand, its app or a tool, it is none of Arbor's
+  /// business. So the Dock, the menu bar, a lid that moves every corner, a display that grows and another display's
+  /// coming and going cost nobody a place who lost nothing.
+  ///
+  /// "As before" can be measured too late: an app may have reported its window's new place before anybody could know
+  /// that the displays were changing. So on a display of another size it is not believed of a window that has spoken
+  /// lately. Where in doubt, the window is wholly in view.
+  ///
+  /// What could not be moved yet (its app hangs, it is in the Dock) is still owed, whatever this change did. A window
+  /// that missed another move, because its app hung then, only looks as if it were in view: it is owed that move.
+  func noteWhatTheDisplaysLeftBehind(whichShowed before: [WindowID: CGFloat], sizes: [DisplayID: CGSize]) {
+    let lately = now().addingTimeInterval(-Self.spokenLately)
+    var left: Set<WindowID> = []
+    for window in workspaces.values.flatMap(\.floating.keys) where window != drag?.window && !parked.contains(window) {
+      guard let frame = windows[window]?.frame,
+        leftBehind.contains(window) || (!unplaced.contains(window) && !owedMoves.contains(window))
+      else { continue }
+      let showing = shareShowing(of: frame)
+      guard showing < 0.5 else { continue }
+      let host = displays.max { frame.fractionInside($0.frame) < frame.fractionInside($1.frame) }
+      let isAsLarge = host.map { sizes[$0.id] == $0.frame.size } == true
+      let showsAsMuch = before[window].map { showing >= $0 - 0.01 }
+      let measuredInTime = spokeOfItsPlace[window].map { $0 < lately } ?? true
+      let untouched = isAsLarge ? showsAsMuch ?? true : (showsAsMuch ?? false) && measuredInTime
+      guard leftBehind.contains(window) || !untouched else { continue }
+      left.insert(window)
+    }
+    leftBehind = left
+  }
+
+  /// Whether `window` is still owed the way into view. Asked again each time: macOS, its app or its person may have
+  /// fetched it since, or it has been docked and is in its slot.
+  private func isStillLeftBehind(_ window: WindowID) -> Bool {
+    guard leftBehind.contains(window), let frame = windows[window]?.frame else { return false }
+    return shareShowing(of: frame) < 0.5
+  }
+
+  /// Whether a layout is to pay now. Not on the window's flight out of the Dock: it takes no frame then, and its answer
+  /// would be taken for a refusal (Controller+OnTheWayBack.swift).
+  func isLeftBehind(_ window: WindowID) -> Bool {
+    isStillLeftBehind(window) && !(landsAt[window].map { $0 > now() } ?? false)
+  }
+
+  /// Called after every layout of `displayID`. What somebody else has fetched, what has been docked and what has closed is
+  /// owed nothing. What was in flight is asked once it has landed.
+  func lookAfterWhoIsLeftBehind(on displayID: DisplayID) {
+    guard !leftBehind.isEmpty else { return }
+    leftBehind = leftBehind.filter(isStillLeftBehind)
+    let flying = leftBehind.filter { workspaces[displayID]?.contains($0) == true && !isLeftBehind($0) }
+    guard let last = flying.compactMap({ landsAt[$0] }).max() else { return }
+    // A key of its own, so that this wait and the docked windows' do not replace each other.
+    scheduler.schedule("landed-floating-\(displayID.rawValue)", after: max(last.timeIntervalSince(now()), 0)) { [weak self] in
+      guard let self else { return }
+      // Once, whatever the clock says, as for docked windows: a clock that stands still would have Arbor wait for ever.
+      for window in flying { self.landsAt[window] = nil }
+      self.relayout(displayID, reason: .enforce)
+    }
+  }
+}
