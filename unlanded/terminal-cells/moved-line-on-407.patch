+  /// Another font again, unseen, with both its cells known, and lines that have sizes in common with the old ones: 480 is 32 lines of 15 points
+  /// and 24 of 20. Its width misses and is forgotten; its height is taken as it was asked, so that cell lives on. Offered its slot it
+  /// takes a line too many and comes down to those 480 by its own new lines. That is no app that is a request behind, though 480 is what it
+  /// was asked for a moment ago, by cells it no longer has: offered its slot once more, it took the line too many again and was a tile.
+  @Test(arguments: 0..<60) func comingDownToWhatTheOldCellsGaveIsNoSlowness(higher: Int) throws {
+    let (old, new) = (CGSize(width: 7, height: 15), CGSize(width: 9, height: 20))
+    let (h, terminal, notes) = makeHarness(cell: old, .nearest)
+    h.run("dock \(notes.rawValue) beside \(terminal.rawValue) bottom")
+    // Until its height has shown its cell, and its width.
+    for _ in 0..<6 { h.run("resize \(terminal.rawValue) bottom 4") }
+    for _ in 0..<9 { h.run("resize \(terminal.rawValue) right 1") }
+    h.run("resize \(terminal.rawValue) bottom \(higher)")
+    h.system.setSizeStep(terminal, new)
+    h.run("resize \(terminal.rawValue) right 4")
+    try expectInItsCorner(h, terminal, cell: new)
+    let frame = try #require(h.frame(terminal))
+    h.system.clearFrameLog()
+    for _ in 0..<3 { h.controller.apply(settings: h.controller.settings) }
+    #expect(h.system.frameLog.filter { $0.window == terminal }.isEmpty)
+    #expect(h.frame(terminal) == frame)
+  }
