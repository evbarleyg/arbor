diff --git a/Sources/ArborKit/Platform/PresetStore.swift b/Sources/ArborKit/Platform/PresetStore.swift
new file mode 100644
index 00000000..208a8c3b
--- /dev/null
+++ b/Sources/ArborKit/Platform/PresetStore.swift
@@ -0,0 +1,51 @@
+import ArborCore
+import ArborIPC
+import Foundation
+
+/// Where the text of `presets.json` is kept. What the text means, and how it is changed, is
+/// `PresetFile`'s business (ArborCore); a store only fetches it and puts it back.
+@MainActor
+public protocol PresetStore: AnyObject {
+  /// What the file holds, or nil if there is none. Throws, with the reason in words, if there is one that
+  /// cannot be read; nobody may then write to it.
+  func read() throws -> String?
+  func write(_ text: String) throws
+}
+
+/// `presets.json` in Arbor's home folder. People keep it in their dotfiles and edit it by hand, so it is read
+/// and written with the care `SettingsFile` takes, by the same code: a link is followed, a
+/// read-only file respected, permissions kept.
+@MainActor
+public final class FilePresetStore: PresetStore {
+  private let url: URL
+
+  public init(url: URL = ArborPaths.presetsFile) {
+    self.url = url
+  }
+
+  public func read() throws -> String? {
+    // Before reading it: the path may lead anywhere.
+    let size = try? FileManager.default.attributesOfItem(atPath: url.resolvingSymlinksInPath().path)[.size] as? Int
+    if let size, size > PresetFile.maximumSize {
+      throw PresetFile.Problem("it is larger than \(PresetFile.maximumSize / 1_000_000) MB")
+    }
+    guard let data = try SettingsFile.contents(of: url) else { return nil }
+    guard String(data: data, encoding: .utf8) != nil else { throw PresetFile.Problem("the file is not UTF-8 text") }
+    // Checked, then decoded without a check: that way a byte order mark stays in the text.
+    return String(decoding: data, as: UTF8.self)
+  }
+
+  public func write(_ text: String) throws {
+    try SettingsFile.write(text, to: url)
+  }
+
+  /// Writes a file without presets where there is none, or only a blank one, so that there is something to
+  /// open in an editor. Leaves any other file alone.
+  public func createIfMissing() {
+    do {
+      if try read() == nil { try write("{\n}\n") }
+    } catch {
+      Log.error("could not make presets.json: \(error)")
+    }
+  }
+}
