new file mode 100644
index 00000000..7598bdda
--- /dev/null
+++ b/Sources/ArborTesting/MemoryPresetStore.swift
@@ -0,0 +1,26 @@
+import ArborCore
+import ArborKit
+
+/// A `presets.json` that is only a string, for tests and arbor-sim.
+@MainActor
+public final class MemoryPresetStore: PresetStore {
+  /// What the file holds. Set it to write the file by hand.
+  public var text: String?
+  /// Set to make reading or writing fail, as for a file that cannot be opened or is read-only.
+  public var readProblem: String?
+  public var writeProblem: String?
+  public private(set) var writeCount = 0
+
+  public init(text: String? = nil) { self.text = text }
+
+  public func read() throws -> String? {
+    if let readProblem { throw PresetFile.Problem(readProblem) }
+    return text
+  }
+
+  public func write(_ text: String) throws {
+    if let writeProblem { throw PresetFile.Problem(writeProblem) }
+    self.text = text
+    writeCount += 1
+  }
+}
