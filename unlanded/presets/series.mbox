diff --git a/Sources/ArborKit/Controller/Controller+Presets.swift b/Sources/ArborKit/Controller/Controller+Presets.swift
new file mode 100644
index 00000000..d5ff3927
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+Presets.swift
@@ -0,0 +1,281 @@
+import ArborCore
+
+/// Presets: arrangements kept under a name (docs/features/F21-presets.md, docs/PRESETS.md).
+///
+/// A preset is a name for one or more lines of `LayoutNotation`, kept in presets.json (`PresetFile`, `PresetStore`).
+/// Saving writes down what `layout` would print; loading does what `layout` would do with each line. So there is
+/// no matching, building or opening of apps here: see Controller+LayoutNotation.swift.
+extension Controller {
+  // MARK: The file
+
+  /// Reads presets.json and hands it to `body`. It is read whenever it is needed: it is small, and people edit
+  /// it. What `body` throws is a change that could not be made.
+  private func withPresets(_ body: (PresetFile, any PresetStore) throws -> CommandResult) -> CommandResult {
+    guard let store = presetStore else { return .failure("there is nowhere to keep presets") }
+    let file: PresetFile
+    do {
+      file = try PresetFile(text: try store.read())
+    } catch {
+      return .failure("presets.json cannot be read, and is left as it is: \(remembered(error))")
+    }
+    presetFileProblem = nil
+    presetNamesMet.formUnion(file.presets.map(\.name))
+    // Once for each state of the file, however often it is read.
+    if file.skipped != reportedPresetProblems {
+      reportedPresetProblems = file.skipped
+      for reason in file.skippedWithoutNames { Log.error("presets.json: skipped \(reason)") }
+    }
+    do {
+      return try body(file, store)
+    } catch {
+      return .failure("presets.json could not be changed: \(remembered(error))")
+    }
+  }
+
+  /// `error` in words, for a reply. They can quote the file at the mistake, for whoever wrote it, so they are remembered
+  /// together with what the log and a trace get in their place (`forTheLog`), as for settings.json.
+  private func remembered(_ error: any Error) -> String {
+    presetFileProblem = (error as? PresetFile.Problem).map { ($0.description, $0.forTheLog) }
+    return "\(error)"
+  }
+
+  /// `message` without what it quotes from a presets.json that cannot be read.
+  func withoutWhatThePresetsFileHolds(_ message: String) -> String {
+    guard let (problem, safe) = presetFileProblem, problem != safe, let range = message.firstRange(of: problem) else { return message }
+    var message = message
+    message.replaceSubrange(range, with: safe)
+    return message
+  }
+
+  /// A reply for the log: without the names of presets the command met. Forgets them, so call it once per command.
+  func withoutPresetNames(_ message: String) -> String {
+    guard !presetNamesMet.isEmpty else { return message }
+    defer { presetNamesMet = [] }
+    return Preset.hiding(presetNamesMet, in: message)
+  }
+
+  /// The presets there are, in the order of the file; none if it cannot be read. For menus and pickers.
+  public var presets: [Preset] {
+    (try? PresetFile(text: try presetStore?.read()))?.presets ?? []
+  }
+
+  // MARK: Commands
+
+  func listPresets() -> CommandResult {
+    // A query is not logged.
+    defer { presetNamesMet = [] }
+    return withPresets { file, _ in listPresets(in: file) }
+  }
+
+  private func listPresets(in file: PresetFile) -> CommandResult {
+    guard !file.presets.isEmpty || !file.skipped.isEmpty else {
+      return .success("no presets yet; `preset save <name>` keeps the arrangement as it is now")
+    }
+    let width = file.presets.map(\.name.count).max() ?? 0
+    var lines: [String] = []
+    for preset in file.presets {
+      for (index, line) in preset.lines.enumerated() {
+        let name = index == 0 ? preset.name : ""
+        lines.append(name + String(repeating: " ", count: width - name.count + 2) + line.text)
+      }
+    }
+    lines += file.skipped.map { "skipped \($0)" }
+    var message = Self.count(file.presets.count, "preset")
+    if !file.skipped.isEmpty { message += ", \(file.skipped.count) skipped" }
+    return CommandResult(ok: true, message: message, text: lines.joined(separator: "\n"))
+  }
+
+  func savePreset(_ name: String, display: String?) -> CommandResult {
+    presetNamesMet.insert(name)
+    // Which displays, and what to call them in the file.
+    var sources: [(display: DisplayID, written: String?)] = []
+    if let display {
+      switch chooseDisplay(display) {
+      case .failure(let result): return result
+      case .display(let id): sources = [(id, nil)]
+      }
+    } else {
+      let connected = numberedDisplays
+      sources = connected.enumerated().map { ($1.id, connected.count > 1 ? String($0 + 1) : nil) }
+    }
+
+    sources = sources.filter { workspaces[$0.display] != nil }
+    var specs = sources.compactMap { layoutSpec(of: $0.display, naming: .titles, waiting: true) }
+    // A number means nothing once its window has closed.
+    var leftOut = 0
+    specs = specs.map { spec in
+      spec.compactMapSlots { slot in
+        if case .window = slot.owner {
+          leftOut += 1
+          return nil
+        }
+        return slot
+      }
+    }
+    // A title is worth writing only where it tells the windows of one app apart. What the user wrote stays.
+    var slotsOfApp: [String: Int] = [:]
+    for case .app(let app) in specs.flatMap(\.slots).map(\.owner) { slotsOfApp[app.lowercased(), default: 0] += 1 }
+    let asWritten = Array(writtenSlots.values)
+    specs = specs.map { spec in
+      spec.compactMapSlots { slot in
+        guard case .app(let app) = slot.owner, slotsOfApp[app.lowercased()] == 1, !asWritten.contains(slot) else { return slot }
+        return .app(app, takesAll: slot.takesAll)
+      }
+    }
+    guard specs.contains(where: { !$0.slots.isEmpty }) else {
+      return .failure("nothing is docked, so there is nothing to save")
+    }
+
+    let preset = Preset(name: name, lines: zip(sources, specs).map { Preset.Line(display: $0.written, spec: $1) })
+    return withPresets { file, store in
+      let (text, replaced) = try file.saving(preset)
+      try store.write(text)
+      if presetPrompt != nil { closeNamePrompt() }
+      var message = "saved \(file.preset(named: name)?.name ?? name)\(replaced ? ", replacing what it was" : ""): \(preset.summary)"
+      if leftOut > 0 { message += "; left out \(Self.count(leftOut, "window")) whose app has no name that can be written" }
+      return Self.success(message, was: file.written(name))
+    }
+  }
+
+  /// `preset save` without a name: opens the field F20 built for naming spaces. ↩ there runs `preset save <name>`.
+  func askPresetName(display: String?) -> CommandResult {
+    if let display, case .failure(let result) = chooseDisplay(display) { return result }
+    guard case .display(let shown) = chooseDisplay(nil), let workspace = workspaces[shown] else { return .failure("no display") }
+    guard anythingIsDocked else { return .failure("nothing is docked, so there is nothing to save") }
+    closeNamePrompt()
+    namePrompt = (shown, workspace.camera, system.focusedWindow())
+    presetPrompt = .some(display)
+    showScene(on: shown)
+    return .success("type a name for the preset")
+  }
+
+  /// What the field has to know. Read when the scene is put together, so that it is never older than the field.
+  func presetSubject(_ display: String?) -> NamePromptModel.Subject {
+    do {
+      return .preset(display: display, existing: try PresetFile(text: try presetStore?.read()).presets.map(\.name), problem: nil)
+    } catch {
+      return .preset(display: display, existing: [], problem: "presets.json cannot be read: \(remembered(error))")
+    }
+  }
+
+  private var anythingIsDocked: Bool {
+    workspaces.values.contains { workspace in workspace.tree.allWindows.contains { windows[$0] != nil } }
+  }
+
+  func deletePreset(_ name: String) -> CommandResult {
+    presetNamesMet.insert(name)
+    return withPresets { file, store in
+      guard let text = try file.deleting(name) else { return .failure(noPreset(name, in: file)) }
+      try store.write(text)
+      return Self.success("deleted \(file.preset(named: name)?.name ?? name)", was: file.written(name))
+    }
+  }
+
+  /// `save` typed for `load`, or a `delete` too many, destroys a preset. What it was is printed, to be put back by hand: in
+  /// the reply's text, which is shown and not logged, because it can hold parts of titles.
+  private static func success(_ message: String, was old: String?) -> CommandResult {
+    CommandResult(ok: true, message: message, text: old.map { "\(message)\nit was: \($0)" })
+  }
+
+  func loadPreset(_ name: String, display: String?, open: Bool) -> CommandResult {
+    presetNamesMet.insert(name)
+    return withPresets { file, _ in
+      guard let preset = file.preset(named: name) else { return .failure(noPreset(name, in: file)) }
+      return load(preset, display: display, open: open)
+    }
+  }
+
+  private func load(_ preset: Preset, display: String?, open: Bool) -> CommandResult {
+    var lines: [(display: DisplayID, spec: LayoutNotation.Spec)] = []
+    var absent: [String] = []
+    if preset.lines.count == 1, preset.lines[0].display == nil {
+      switch chooseDisplay(display) {
+      case .failure(let result): return result
+      case .display(let id): lines = [(id, preset.lines[0].spec)]
+      }
+    } else {
+      guard display == nil else {
+        return .failure("\(preset.name) says itself which display each line is for; load it without @\(display ?? "")")
+      }
+      for line in preset.lines {
+        guard case .display(let id) = chooseDisplay(line.display) else {
+          absent.append(line.display ?? "")
+          continue
+        }
+        // `@1` and the id of the main display are one display: the first line counts.
+        if !lines.contains(where: { $0.display == id }) { lines.append((id, line.spec)) }
+      }
+      guard !lines.isEmpty else {
+        return .failure("\(preset.name) is for display \(Self.list(absent, joinedBy: "and")), which \(absent.count == 1 ? "is" : "are") not connected")
+      }
+      // That nothing is docked on a display that is not there needs no saying.
+      absent = preset.lines.filter { !$0.spec.slots.isEmpty }.compactMap(\.display).filter(absent.contains)
+    }
+
+    let result = arrange(lines, open: open, wait: .aloud)
+    guard result.ok else { return .failure("\(preset.name): \(result.message)") }
+    var message = "loaded \(preset.name): \(result.message)"
+    if !absent.isEmpty { message += "; display \(Self.list(absent, joinedBy: "and")) \(absent.count == 1 ? "is" : "are") not connected" }
+    return .success(message)
+  }
+
+  /// "no preset Desk; there are Writing and Call".
+  private func noPreset(_ name: String, in file: PresetFile) -> String {
+    if let reason = file.reasonSkipped(name) { return "\(name) in presets.json cannot be read: \(reason)" }
+    guard !file.presets.isEmpty else { return "no preset \(name); there are none yet (`preset save <name>` makes one)" }
+    let names = file.presets.map(\.name)
+    return "no preset \(name); there \(names.count == 1 ? "is" : "are") \(Self.list(names, joinedBy: "and"))"
+  }
+
+  // MARK: The menu
+
+  /// What the menu's "Presets" submenu holds now. `saveCommand` is what "Save This Arrangement…" runs, which has to ask for the name.
+  public func presetMenu(saveCommand: Command? = .presetAskName(display: nil)) -> PresetMenu {
+    // Asking which display commands act on is remembered as what the last command followed (InputLead), and this is no
+    // command: the menu asks whenever it is opened.
+    let lead = following.lead
+    defer { following.lead = lead }
+    func isThere(_ window: WindowID) -> Bool { windows[window] != nil }
+    var arrangement: String?
+    if isRunning, case .display(let display) = chooseDisplay(nil), workspaces[display]?.tree.allWindows.contains(where: isThere) == true {
+      arrangement = layoutSpec(of: display, naming: .apps)?.text
+    }
+    do {
+      let file = try PresetFile(text: try presetStore?.read())
+      let docked = workspaces.values.contains { $0.tree.allWindows.contains(where: isThere) }
+      return PresetMenu(
+        presets: file.presets, skipped: file.skipped.count, saveCommand: saveCommand, canSave: isRunning && docked, arrangement: arrangement)
+    } catch {
+      return PresetMenu(problem: "\(error)", showsSave: saveCommand != nil, arrangement: arrangement)
+    }
+  }
+
+  /// The same as rows of Arbor's menu (Controller+Menu.swift).
+  func presetSections() -> [MenuModel.Section] {
+    presetMenu().items.split(separator: .separator).map { rows in
+      MenuModel.Section {
+        for row in rows {
+          switch row {
+          case .command(let title, let command, let alternateTitle, let alternate):
+            if let alternateTitle, let alternate {
+              // AppKit swaps two rows only if they differ in nothing but the modifiers, and nearly every shortcut of Arbor's has ⌥.
+              MenuModel.Item.command(title, command).withoutShortcut()
+              MenuModel.Item.command(alternateTitle, alternate).withoutShortcut().alternate()
+            } else {
+              MenuModel.Item.command(title, command)
+            }
+          case .copy(let title, _): MenuModel.Item.app(title, .copyArrangement)
+          case .note(let text): MenuModel.Item.text(text)
+          case .separator: []
+          }
+        }
+      }
+    }
+  }
+
+  /// What "Copy Arrangement as Text" copies. The app has the pasteboard, the controller the line.
+  public func arrangementAsText() -> String? {
+    for case .copy(_, let text) in presetMenu().items { return text }
+    return nil
+  }
+}
