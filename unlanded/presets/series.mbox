@@ -0,0 +1,393 @@
+import ArborCore
+import Foundation
+import Testing
+
+/// presets.json as text: what is read from it, what is skipped and why, and how little a change changes
+/// (docs/features/F21-presets.md, criteria 2 to 4).
+@Suite struct PresetFileTests {
+  func line(_ text: String) throws -> Preset.Line { try Preset.Line(text) }
+
+  func preset(_ name: String, _ lines: String...) throws -> Preset {
+    Preset(name: name, lines: try lines.map { try Preset.Line($0) })
+  }
+
+  static let handWritten = """
+    {
+      "Writing": "Safari | (Notes / Terminal)",
+      "Call": "zoom.us:2 | Notes",
+      "Desk": [
+        "@1 Xcode:2 | (Simulator / Terminal)",
+        "@2 Slack | Mail"
+      ]
+    }
+
+    """
+
+  // MARK: Reading
+
+  @Test func aHandWrittenFileLoads() throws {
+    let file = try PresetFile(text: Self.handWritten)
+    #expect(file.skipped.isEmpty)
+    #expect(file.presets.map(\.name) == ["Writing", "Call", "Desk"])
+    #expect(file.presets[0].lines.map(\.text) == ["Safari | (Notes / Terminal)"])
+    #expect(file.presets[0].lines[0].display == nil)
+    #expect(file.presets[2].lines.map(\.display) == ["1", "2"])
+    #expect(file.presets[2].lines.map(\.spec.text) == ["Xcode:2 | (Simulator / Terminal)", "Slack | Mail"])
+    #expect(file.presets[2].summary == "@1 Xcode:2 | (Simulator / Terminal); @2 Slack | Mail")
+  }
+
+  @Test(arguments: [nil, "", "  \n\t ", "\u{FEFF}", "\u{FEFF}\n"])
+  func noFileOrABlankOneHasNoPresets(text: String?) throws {
+    let file = try PresetFile(text: text)
+    #expect(file.presets.isEmpty && file.skipped.isEmpty)
+  }
+
+  @Test func anEmptyObjectHasNoPresets() throws {
+    #expect(try PresetFile(text: "{}").presets.isEmpty)
+  }
+
+  @Test func aListOfOneLineMayNameItsDisplayOrNot() throws {
+    let file = try PresetFile(text: #"{"A": ["Safari"], "B": ["@2 Safari"], "C": "@2 Safari", "D": "Safari @2"}"#)
+    #expect(file.skipped.isEmpty)
+    #expect(file.presets.map { $0.lines[0].display } == [nil, "2", "2", "2"])
+  }
+
+  @Test func escapesInJSONAreRead() throws {
+    let file = try PresetFile(text: #"{"Café": "\"Visual Studio Code\" | Safari~\"In\\box\""}"#)
+    #expect(file.skipped.isEmpty)
+    #expect(file.presets[0].name == "Café")
+    #expect(file.presets[0].lines[0].spec.slots == [.app("Visual Studio Code"), .app("Safari", title: "In\\box")])
+  }
+
+  @Test func namesAreFoundWhateverTheirCapitalsAndSpacing() throws {
+    let file = try PresetFile(text: #"{"Deep  Work": "Safari", "a/b": "Mail"}"#)
+    #expect(file.presets.map(\.name) == ["Deep Work", "a b"])
+    for name in ["Deep Work", "deep work", "DEEP   WORK", " deep\twork ", "deep/work"] {
+      #expect(file.preset(named: name)?.name == "Deep Work", "\(name)")
+    }
+    #expect(file.preset(named: "A B")?.lines[0].text == "Mail")
+    #expect(file.preset(named: "Deep") == nil)
+    #expect(file.preset(named: "DeepWork") == nil)
+    #expect(file.preset(named: "") == nil)
+  }
+
+  // MARK: Entries that are skipped
+
+  @Test(arguments: [
+    (#""Safari | Mail / Notes""#, "column 15: `|` and `/` are mixed here"),
+    (#""""#, "column 1: expected an arrangement"),
+    (#""@2""#, "column 3: expected an arrangement"),
+    (#""--open Safari""#, "column 1: `--open` is an option of a command, not part of a preset"),
+    (#""Safari --one --two""#, "column 8: `--one` is an option of a command"),
+    (#""Safari |""#, "column 9"),
+    ("12", "expected a line in quotes, or a list of lines in [ and ]"),
+    ("null", "expected a line in quotes"),
+    ("true", "expected a line in quotes"),
+    (#"{"lines": ["Safari"]}"#, "expected a line in quotes"),
+    ("[]", "it has no lines"),
+    (#"["Safari", 3]"#, "expected a line in quotes"),
+    (#"[["Safari"]]"#, "expected a line in quotes"),
+    (#"["@1 Safari", "@2 Mail | "]"#, "line 2, column 11"),
+    (#"["@1 Safari", "Mail"]"#, "with several lines, each begins with its display: @1, @2 and so on"),
+    (#"["Safari", "Mail"]"#, "with several lines, each begins with its display"),
+    (#"["@1 Safari", "@1 Mail"]"#, "it has two lines for display 1"),
+    (#"["@side Safari", "@SIDE Mail"]"#, "it has two lines for display SIDE"),
+    (#"["@1 @2 Safari"]"#, "one display at a time"),
+  ])
+  func anEntryThatCannotBeReadIsSkippedWithTheReason(value: String, reason: String) throws {
+    let file = try PresetFile(text: "{\"Good\": \"Safari\", \"Bad\": \(value), \"Fine\": \"Mail\"}")
+    #expect(file.presets.map(\.name) == ["Good", "Fine"])
+    #expect(file.skipped.count == 1)
+    #expect(file.skipped[0].hasPrefix("\"Bad\": "), "\(file.skipped)")
+    #expect(file.skipped[0].contains(reason), "\(file.skipped)")
+  }
+
+  @Test(arguments: [
+    ("", "a preset's name is missing"), ("   ", "a preset's name is missing"), ("/", "a preset's name is missing"),
+    ("--open", "has no word that begins with `--`"), ("Work --fast", "has no word that begins with `--`"),
+    ("@2", "has no word that begins with `@`"), ("Work @home", "has no word that begins with `@`"),
+    (String(repeating: "x", count: 41), "is at most 40 characters long"),
+    ("a\\u0007b", "holds only characters that can be seen"), ("a\\u200bb", "holds only characters that can be seen"),
+    ("\\u202eevil", "holds only characters that can be seen"),
+  ])
