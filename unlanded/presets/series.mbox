+/// What a reading of presets and of the places that wait found (docs/features/F21-presets.md).
+@Suite @MainActor struct PresetReviewTests {
+  func harness(_ apps: String..., displays: [DisplaySnapshot] = [FakeWindowSystem.standardDisplay]) -> Harness {
+    let h = Harness(displays: displays)
+    for app in apps { h.system.open(app: app) }
+    h.start()
+    return h
+  }
+
+  func waiting(_ h: Harness) -> Int { h.controller.snapshot().waiting.count }
