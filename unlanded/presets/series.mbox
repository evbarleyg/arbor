+  /// The same at random: windows, presets and what was done before. Every load, every undo and redo of one, and every window that comes late moves
+  /// each window at most once, and the layout after a load leaves what the load has placed where it is.
+  @Test(arguments: walks) func atRandom(seed: Int) {
+    var random = ChaosRandom(seed: UInt64(seed) &* 104_729 &+ 3)
+    let apps = ["Safari", "Mail", "Notes", "Slack", "Xcode", "Music"]
+    let two = random.chance(50)
+    let h = Harness(displays: two ? [FakeWindowSystem.standardDisplay, side] : [FakeWindowSystem.standardDisplay])
+    // On one display or the other. (One that lies across both is pulled onto its own by that display's next layout, whatever causes it.)
+    func open(_ app: String, _ r: inout ChaosRandom) {
+      let left = two && r.chance(50) ? 1440 : 0
+      let (x, y) = (r.int(0...800), r.int(40...300))
+      h.system.open(
+        app: app, frame: CGRect(x: left + x, y: y, width: min(r.int(300...900), two ? 1280 - x : 2000), height: min(r.int(250...600), two ? 800 - y : 2000)))
+    }
+    for _ in 0..<random.int(2...6) { open(random.pick(apps)!, &random) }
+    h.start()
+    func space(_ r: inout ChaosRandom, _ depth: Int) -> String {
+      var text = r.pick(apps)!
+      if depth < 2, r.chance(20) {
+        text = "(" + (0..<r.int(2...3)).map { _ in space(&r, depth + 1) }.joined(separator: r.chance(50) ? " | " : " / ") + ")"
+      } else if r.chance(12) {
+        text = "[\(r.pick(apps)!) \(r.pick(apps)!)]"
+      } else if r.chance(8) {
+        text += "*"
+      }
+      return text + (r.chance(30) ? ":" + r.pick(["2", "3", "0.5", "1.5"])! : "")
+    }
+    func line(_ r: inout ChaosRandom) -> String {
+      var parts = (0..<r.int(1...4)).map { _ in space(&r, 1) }
+      if r.chance(30) { parts.insert("Desktop" + r.pick(["", ":0.3", ":2"])!, at: r.int(0...parts.count)) }
+      return parts.joined(separator: r.chance(70) ? " | " : " / ")
+    }
+    func somethingIsPinned() -> Bool { h.controller.workspaces.values.contains { $0.pinned != nil } }
+    var script: [String] = []
+    func check(_ what: String, _ body: () -> Void) {
+      script.append(what)
+      expectOneMoveEach(h, "seed \(seed): \(script.joined(separator: "; "))", body)
+    }
+    for _ in 0..<12 {
+      let window = random.pick(h.system.windows.keys.sorted()) ?? WindowID(101)
+      let edge = random.pick(["left", "right", "top", "bottom"])!
+      switch random.int(0...11) {
+      case 0...3:
+        let text = two && random.chance(50) ? "[\"@1 \(line(&random))\", \"@2 \(line(&random))\"]" : "\"\(line(&random))\""
+        h.presets.text = "{\"P\": \(text)}"
+        var loaded = false
+        check("preset load P = \(text)") { loaded = h.run("preset load P").ok }
+        guard loaded else { continue }
+        // Where the load has put a window it stays. (What it has not touched is the business of the rule for floating windows, QUESTIONS Q20.)
+        let placed = Set(h.system.frameLog.map(\.window))
+        let before = frames(h)
+        h.system.clearFrameLog()
+        // Not the command `relayout`, which also forgets what Arbor has learnt about the windows' sizes.
+        h.controller.relayoutAll(reason: .structure)
+        h.scheduler.advance(by: 5)
+        let moved = moves(h, since: before).keys.filter(placed.contains).sorted().map { window in
+          let floats = h.controller.workspaces.values.contains { $0.isFloating(window) }
+          return "\(window), \(floats ? "floating" : "docked"), from \(before[window] ?? .null) to \(h.frame(window) ?? .null)"
+        }
+        #expect(moved.isEmpty, "seed \(seed): the next layout moved \(moved): \(script.joined(separator: "; "))")
+      // Of a load. What other steps do when they are taken back is theirs to prove. (Not with a window pinned since: `undo` squeezes it onto the
+      // Desktop it is no longer on and then gives it its size back, whichever step it takes back. About one walk in a thousand met that.)
+      case 4: if h.controller.nextStepLabel(.undo) == "preset load", !somethingIsPinned() { check("undo") { h.run("undo") } }
+      case 5: if h.controller.nextStepLabel(.redo) == "preset load", !somethingIsPinned() { check("redo") { h.run("redo") } }
+      case 6:
+        // In the background, as `--open` starts apps. One that comes with the keyboard is brought into view as well, which is another matter.
+        let app = random.pick(apps)!
+        h.system.echoes.keyboard = false
+        check("open \(app)") { open(app, &random) }
+        h.system.echoes.keyboard = true
+      case 7: check("wait") { h.scheduler.advance(by: 200) }
+      default:
+        let text = random.pick([
+          "dock \(window.rawValue) \(random.pick(["left", "right", "top", "bottom"])!)", "float \(window.rawValue)", "zoom \(window.rawValue)", "show-all", "desktop",
+          "pin \(window.rawValue)", "arrange", "float-all",
+        ])!
+        script.append(text)
+        h.run(text)
+      }
+    }
+  }
