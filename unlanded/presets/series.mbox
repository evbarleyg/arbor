diff --git a/Sources/ArborCore/Preset.swift b/Sources/ArborCore/Preset.swift
new file mode 100644
index 00000000..7dc854e2
--- /dev/null
+++ b/Sources/ArborCore/Preset.swift
@@ -0,0 +1,322 @@
+import Foundation
+
+/// A name for an arrangement (docs/features/F21-presets.md, docs/PRESETS.md).
+///
+/// An arrangement is written as `LayoutNotation` writes it, one line per display, so a preset is
+/// a name and one or more of those lines. Nothing here matches windows or builds trees:
+/// that is `WindowSlot` and `LayoutNotation`, for presets as for the `layout` command.
+public struct Preset: Equatable, Sendable {
+  /// What could follow the word `layout`: an arrangement, and perhaps the display it is for.
+  public struct Line: Equatable, Sendable {
+    /// What follows `@`: a number counted from the main display, or an id from `state`. Nil is
+    /// whichever display the preset is loaded on.
+    public var display: String?
+    public var spec: LayoutNotation.Spec
+
+    public init(display: String? = nil, spec: LayoutNotation.Spec) {
+      self.display = display
+      self.spec = spec
+    }
+
+    /// Reads `@2 Slack | Mail` or `Slack | Mail`.
+    public init(_ text: String) throws(LayoutNotation.ParseError) {
+      let line = try LayoutNotation.parseLine(text)
+      if let option = line.options.first {
+        throw LayoutNotation.ParseError(
+          column: option.column, message: "`--\(option.name)` is an option of a command, not part of a preset")
+      }
+      guard let spec = line.spec else {
+        throw LayoutNotation.ParseError(column: text.count + 1, message: "expected an arrangement, such as Safari | Mail")
+      }
+      self.init(display: line.display?.name, spec: spec)
+    }
+
+    /// The line as the file holds it. `init(_:)` reads it back as the same value.
+    public var text: String { (display.map { "@\($0) " } ?? "") + spec.text }
+
+    /// The same without the parts of window titles it may hold, for replies and the log.
+    public var textWithoutTitles: String { (display.map { "@\($0) " } ?? "") + spec.textWithoutTitles }
+  }
+
+  public var name: String
+  public var lines: [Line]
+
+  public init(name: String, lines: [Line]) {
+    self.name = name
+    self.lines = lines
+  }
+
+  /// `Safari | Mail`, or `@1 Xcode | Terminal; @2 Slack | Mail`. Without titles.
+  public var summary: String { lines.map(\.textWithoutTitles).joined(separator: "; ") }
+
+  /// Why these lines cannot make a preset together, or nil if they can.
+  static func problem(with lines: [Line]) -> String? {
+    guard !lines.isEmpty else { return "it has no lines" }
+    guard lines.count <= maximumLines else { return "it has more than \(maximumLines) lines" }
+    guard lines.count > 1 else { return nil }
+    var seen = Set<String>()
+    for line in lines {
+      guard let display = line.display else {
+        return "with several lines, each begins with its display: @1, @2 and so on"
+      }
+      guard seen.insert(display.lowercased()).inserted else { return "it has two lines for display \(display)" }
+    }
+    return nil
+  }
+
+  /// More displays than a Mac can drive.
+  static let maximumLines = 16
+
+  // MARK: Names
+
+  public struct NameError: Error, Equatable, Sendable, CustomStringConvertible {
+    public let description: String
+  }
+
+  /// Names are shown in a menu. As long as the name of a space may be (F20).
+  public static let maximumNameLength = 40
+
+  /// The name `words` make, joined by one space each. Throws a `NameError` that completes the
+  /// sentence "a preset's name …".
+  ///
+  /// A name must survive being typed after `preset load`, where spaces and slashes separate words, `--`
+  /// begins an option and `@` a display, and being shown in a menu, a reply and the log.
+  public static func name(of words: [String]) throws(NameError) -> String {
+    let words = words.flatMap { $0.split(whereSeparator: isSeparator) }
+    guard !words.isEmpty else { throw NameError(description: "is missing") }
+    for word in words {
+      if word.hasPrefix("--") { throw NameError(description: "has no word that begins with `--`") }
+      if word.hasPrefix("@") { throw NameError(description: "has no word that begins with `@`") }
+    }
+    let name = words.joined(separator: " ")
+    guard name.count <= maximumNameLength else {
+      throw NameError(description: "is at most \(maximumNameLength) characters long")
+    }
+    guard LayoutNotation.canBeWritten(name) else {
+      throw NameError(description: "holds only characters that can be seen")
+    }
+    return name
+  }
+
+  /// Two names are the same preset if these are equal: capitals do not count, nor what separates the words.
+  public static func key(_ name: String) -> String {
+    name.split(whereSeparator: isSeparator).joined(separator: " ").lowercased()
+  }
+
+  /// What the log has in place of a name. A name is a client, a project, something nobody else should know of, and the log
+  /// is what people paste into a bug report.
+  public static let nameInLog = "‹name›"
+
+  /// `text` for the log: whatever reads like one of `names` goes. So a preset called Mail also costs the log the app's
+  /// name: too much rather than too little.
+  public static func hiding(_ names: Set<String>, in text: String) -> String {
+    // The longest first: "Mail" must not take a bite out of "Mail Room".
+    names.filter { !$0.isEmpty }.sorted { ($0.count, $0) > ($1.count, $1) }
+      .reduce(text) { $0.replacingOccurrences(of: $1, with: nameInLog, options: .caseInsensitive) }
+  }
+
+  /// As in `Command.parse`: a slash separates words in a URL.
+  private static func isSeparator(_ character: Character) -> Bool { character.isWhitespace || character == "/" }
+}
+
+/// The contents of `presets.json`: an object of names, each with a line or a list of lines.
+///
+///     {
+///       "Writing": "Safari | (Notes / Terminal)",
+///       "Desk": ["@1 Xcode:2 | (Simulator / Terminal)", "@2 Slack | Mail"]
+///     }
+///
+/// People write this file by hand, so it is treated as `settings.json` is (`Settings.rewrite`):
+/// - an entry that cannot be read is skipped, with a reason, and the others work;
+/// - a change is made to the text, in one place, and every other byte stays (`JSONText`);
+/// - text that is not JSON is never rewritten: `init` throws and says where the mistake is.
+public struct PresetFile: Sendable {
+  /// Why the file as a whole cannot be used, in words for the person who edits it.
+  public struct Problem: Error, Equatable, Sendable, CustomStringConvertible {
+    public let description: String
+
+    /// Parts of the file can be in it, and it goes into replies and the log: so it is kept short and visible.
+    public init(_ description: String) {
+      let visible = description.unicodeScalars.map { LayoutNotation.isForbidden($0) ? "?" : Character($0) }
+      self.description = visible.count > 300 ? String(visible.prefix(300)) + "…" : String(visible)
+    }
+
+    /// For the log and for traces, which do not get to see what the file holds: where the mistake is, without the text found there,
+    /// which can be a name or a title. What quotes nothing is said as it is.
+    public var forTheLog: String {
+      if let place = description.prefixMatch(of: /line \d+, column \d+/) { return String(place.0) }
+      return description.contains { "`\"'“”‘’".contains($0) } ? "something in it is not as it should be" : description
+    }
+  }
+
+  /// The presets that can be used, in the order of the file.
+  public private(set) var presets: [Preset] = []
+  /// One line for each entry that cannot: its name and why.
+  public var skipped: [String] { skippedEntries.map { "\(Self.label($0.key)): \($0.reason)" } }
+  /// The same for the log, which does not get to see names: the entry's place in the file instead.
+  public var skippedWithoutNames: [String] { skippedEntries.map { "entry \($0.place): \($0.reason)" } }
+  private var skippedEntries: [(key: String, place: Int, reason: String)] = []
+  /// Nil where there is no file yet.
+  private let document: JSONText?
+
+  /// A thousand times what anyone would write, and read in no time.
+  public static let maximumSize = 1_000_000
+  /// Each entry is looked up among all the others.
+  public static let maximumEntries = 1000
+
+  /// `text` is what the file holds; nil, or nothing but white space, is a file that does not exist yet.
+  public init(text: String?) throws(Problem) {
+    guard let text, text.contains(where: { !$0.isWhitespace && $0 != "\u{FEFF}" }) else {
+      document = nil
+      return
+    }
+    guard text.utf8.count <= Self.maximumSize else {
+      throw Problem("it is larger than \(Self.maximumSize / 1_000_000) MB")
+    }
+    let document: JSONText
+    do {
+      document = try JSONText(text, strict: true)
+    } catch {
+      throw Problem("\(error)")
+    }
+    guard let keys = document.keys(at: []) else { throw Problem("the presets must be inside { and }") }
+    guard keys.count <= Self.maximumEntries else { throw Problem("it has more than \(Self.maximumEntries) entries") }
+    self.document = document
+
+    var seen = Set<String>()
+    var exact = Set<String>()
+    for (index, key) in keys.enumerated() {
+      let place = index + 1
+      // `value(at:)` finds the first of a key written twice.
+      guard exact.insert(key).inserted else {
+        skippedEntries.append((key, place, "the name is used twice; the first counts"))
+        continue
+      }
+      do {
+        let name = try Preset.name(of: [key])
+        guard seen.insert(Preset.key(name)).inserted else {
+          throw Problem("the name is used twice (capitals do not count); the first counts")
+        }
+        presets.append(Preset(name: name, lines: try Self.lines(of: key, in: document)))
+      } catch let error as Preset.NameError {
+        skippedEntries.append((key, place, "a preset's name \(error)"))
+      } catch {
+        skippedEntries.append((key, place, "\(error)"))
+      }
+    }
+  }
+
+  public func preset(named name: String) -> Preset? {
+    let key = Preset.key(name)
+    return presets.first { Preset.key($0.name) == key }
+  }
+
+  /// Why the entry called `name` was skipped, if there is one and no preset of that name.
+  public func reasonSkipped(_ name: String) -> String? {
+    guard preset(named: name) == nil else { return nil }
+    let key = Preset.key(name)
+    return skippedEntries.first { Preset.key($0.key) == key }?.reason
+  }
+
+  /// The entry called `name` as the file has it, readable or not: `"Safari | Mail"`, or a list. To be shown when it is about to go.
+  public func written(_ name: String) -> String? {
+    keys(meaning: name).first.flatMap { document?.value(at: [$0]) }
+  }
+
+  // MARK: Changing
+
+  /// The file's text with `preset` in it, in place of the entry of that name if there is one (then
+  /// `replaced` is true, and the file keeps its spelling of the name).
+  public func saving(_ preset: Preset) throws(Problem) -> (text: String, replaced: Bool) {
+    if let problem = Preset.problem(with: preset.lines) { throw Problem(problem) }
+    let lines = preset.lines.map { JSONText.quote($0.text) }
+    let existing = keys(meaning: preset.name).first
+    let text: String
+    if let document {
+      let value = lines.count == 1 ? lines[0] : "[" + lines.joined(separator: ",") + "]"
+      do {
+        text = try document.setting([existing ?? preset.name], to: value).text
+      } catch {
+        throw Problem("\(error)")
+      }
+    } else {
+      let value = lines.count == 1 ? lines[0] : "[\n" + lines.map { "    " + $0 }.joined(separator: ",\n") + "\n  ]"
+      text = "{\n  \(JSONText.quote(preset.name)): \(value)\n}\n"
+    }
+    // Never hand back text that would not read back as what was asked for.
+    guard let written = try PresetFile(text: text).preset(named: preset.name), written.lines == preset.lines else {
+      throw Problem("`\(preset.name)` could not be written")
+    }
+    return (text, existing != nil)
+  }
+
+  /// The file's text without the entry called `name`, readable or not; nil if there is none.
+  public func deleting(_ name: String) throws(Problem) -> String? {
+    let keys = keys(meaning: name)
+    guard var document, !keys.isEmpty else { return nil }
+    do {
+      for key in keys { document = try document.removing([key]) }
+    } catch {
+      throw Problem("\(error)")
+    }
+    return document.text
+  }
+
+  /// The keys of the file that `name` means, as written. Several if the file has the name twice.
+  private func keys(meaning name: String) -> [String] {
+    let wanted = Preset.key(name)
+    var seen = Set<String>()
+    return (document?.keys(at: []) ?? []).filter { Preset.key($0) == wanted && seen.insert($0).inserted }
+  }
+
+  // MARK: Reading
+
+  private static func lines(of key: String, in document: JSONText) throws -> [Preset.Line] {
+    let written: [String]
+    if let elements = document.elements(at: [key]) {
+      written = try elements.map(string)
+    } else {
+      written = [try string(document.value(at: [key]) ?? "null")]
+    }
+    var lines: [Preset.Line] = []
+    for (index, text) in written.enumerated() {
+      do {
+        lines.append(try Preset.Line(text))
+      } catch {
+        throw Problem((written.count > 1 ? "line \(index + 1), " : "") + "\(error)")
+      }
+    }
+    if let problem = Preset.problem(with: lines) { throw Problem(problem) }
+    return lines
+  }
+
+  /// What a JSON string says. `json` has passed the strict parser.
+  private static func string(_ json: String) throws -> String {
+    guard json.hasPrefix("\""), let list = try? JSONDecoder().decode([String].self, from: Data("[\(json)]".utf8)),
+      let text = list.first
+    else { throw Problem("expected a line in quotes, or a list of lines in [ and ]") }
+    return text
+  }
+
+  /// A key for a message: short, on one line, with nothing invisible in it.
+  private static func label(_ key: String) -> String {
+    let visible = key.unicodeScalars.map { LayoutNotation.isForbidden($0) ? "?" : Character($0) }
+    let text = String(visible.prefix(Preset.maximumNameLength))
+    return "\"" + text + (visible.count > Preset.maximumNameLength ? "…" : "") + "\""
+  }
+}
+
+extension LayoutNotation.Spec {
+  /// The same arrangement with each slot replaced by what `transform` makes of it. A slot for which that is
+  /// nil is left out, and the space around it closes up as `init(root:)` closes it.
+  public func compactMapSlots(_ transform: (WindowSlot) -> WindowSlot?) -> LayoutNotation.Spec {
+    func changed(_ space: LayoutNotation.Space) -> LayoutNotation.Space {
+      switch space.kind {
+      case .desktop: space
+      case .windows(let slots): LayoutNotation.Space(.windows(slots.compactMap(transform)), size: space.size)
+      case .group(let axis, let members): LayoutNotation.Space(.group(axis, members.map(changed)), size: space.size)
+      }
+    }
+    return LayoutNotation.Spec(root: changed(root))
+  }
+}
diff --git a/Sources/ArborCore/PresetMenu.swift b/Sources/ArborCore/PresetMenu.swift
new file mode 100644
index 00000000..d1dc3766
--- /dev/null
+++ b/Sources/ArborCore/PresetMenu.swift
@@ -0,0 +1,50 @@
+/// What the "Presets" submenu of Arbor's menu holds (docs/MENU.md, docs/features/F21-presets.md). The app draws the items in
+/// order and runs their commands; it decides nothing.
+public struct PresetMenu: Equatable, Sendable {
+  public enum Item: Equatable, Sendable {
+    /// Runs `command`. With ⌥ held it reads `alternateTitle` and runs `alternate`, if there is one.
+    case command(title: String, Command, alternateTitle: String? = nil, alternate: Command? = nil)
+    /// Puts `text` on the pasteboard.
+    case copy(title: String, text: String)
+    /// A row in grey: a remark, or a command that cannot act now and keeps its place.
+    case note(String)
+    case separator
+  }
+
+  public var items: [Item]
+
+  /// A menu is not the place for more. The file has them all, and so does `presets`.
+  public static let mostPresets = 20
+  public static let saveTitle = "Save This Arrangement…"
+  public static let copyTitle = "Copy Arrangement as Text"
+
+  /// - Parameters:
+  ///   - skipped: how many entries of the file cannot be read.
+  ///   - saveCommand: what "Save This Arrangement…" runs, which has to ask for the name. Nil leaves the row out.
+  ///   - canSave: whether anything is docked.
+  ///   - arrangement: the line of the display that commands act on, or nil if nothing is docked there.
+  public init(presets: [Preset], skipped: Int = 0, saveCommand: Command? = nil, canSave: Bool = true, arrangement: String? = nil) {
+    items = presets.prefix(Self.mostPresets).map { preset in
+      .command(
+        title: preset.name, .presetLoad(name: preset.name, display: nil, open: false),
+        alternateTitle: "\(preset.name), Opening Its Apps", alternate: .presetLoad(name: preset.name, display: nil, open: true))
+    }
+    if presets.isEmpty { items.append(.note("No Presets Yet")) }
+    if presets.count > Self.mostPresets { items.append(.note("and \(presets.count - Self.mostPresets) more in the file")) }
+    if skipped > 0 { items.append(.note(skipped == 1 ? "1 entry of the file cannot be read" : "\(skipped) entries of the file cannot be read")) }
+    items += Self.rowsBelow(saveCommand: canSave ? saveCommand : nil, showsSave: saveCommand != nil, arrangement: arrangement)
+  }
+
+  /// For a file that cannot be read at all, and so cannot be saved to.
+  public init(problem: String, showsSave: Bool = false, arrangement: String? = nil) {
+    items = [.note("presets.json cannot be read"), .note(problem)]
+      + Self.rowsBelow(saveCommand: nil, showsSave: showsSave, arrangement: arrangement)
+  }
+
+  private static func rowsBelow(saveCommand: Command?, showsSave: Bool, arrangement: String?) -> [Item] {
+    var rows: [Item] = [.separator]
+    if showsSave { rows.append(saveCommand.map { .command(title: saveTitle, $0) } ?? .note(saveTitle)) }
+    rows.append(arrangement.map { .copy(title: copyTitle, text: $0) } ?? .note(copyTitle))
+    return rows
+  }
+}
