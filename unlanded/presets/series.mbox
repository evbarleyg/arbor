+++ b/Tests/ArborKitTests/PresetTests.swift
@@ -0,0 +1,1747 @@
+import ArborCore
+@testable import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// A 1280×800 display to the right of the standard one.
+private let side = DisplaySnapshot(
+  id: DisplayID("side"), frame: CGRect(x: 1440, y: 0, width: 1280, height: 800),
+  visibleFrame: CGRect(x: 1440, y: 0, width: 1280, height: 800), isMain: false)
+
+/// Every window Arbor arranges is docked or floating on exactly one display, every tree is sound, and what else
+/// a tree holds is a slot that is known to be waiting.
+@MainActor
+private func expectNothingLost(_ h: Harness, sourceLocation: SourceLocation = #_sourceLocation) {
+  var seen: [WindowID: Int] = [:]
+  for workspace in h.controller.workspaces.values {
+    #expect(workspace.tree.invariantViolations().isEmpty, sourceLocation: sourceLocation)
+    #expect(workspace.tree.contains(workspace.camera), sourceLocation: sourceLocation)
+    for window in workspace.tree.allWindows + Array(workspace.floating.keys) { seen[window, default: 0] += 1 }
+  }
+  for window in h.system.windows.keys { #expect(seen[window] == 1, "\(window)", sourceLocation: sourceLocation) }
+  for window in seen.keys where h.system.windows[window] == nil {
+    #expect(window.rawValue >= 0xFFFF_0000, "\(window) does not exist", sourceLocation: sourceLocation)
+    #expect(seen[window] == 1, "\(window)", sourceLocation: sourceLocation)
+    #expect(!h.controller.workspaces.values.contains { $0.isFloating(window) }, "a place cannot float", sourceLocation: sourceLocation)
+  }
+}
+
+/// No slot is waiting, and no trace of one is left anywhere a person or a script could meet it.
+@MainActor
+private func expectNobodyIsWaitedFor(_ h: Harness, sourceLocation: SourceLocation = #_sourceLocation) {
+  func isReal(_ window: WindowID) -> Bool { h.system.windows[window] != nil }
+  for workspace in h.controller.workspaces.values {
+    #expect(workspace.allWindows.allSatisfy(isReal), "\(workspace.allWindows)", sourceLocation: sourceLocation)
+  }
+  for display in h.controller.snapshot().displays {
+    #expect(display.tree.allWindows.allSatisfy(isReal), sourceLocation: sourceLocation)
+  }
+  h.controller.saveNow()
+  for workspace in (h.store.saved?.workspaces ?? [:]).values {
+    #expect(workspace.allWindows.allSatisfy(isReal), "state.json", sourceLocation: sourceLocation)
+  }
+  let hints = h.store.saved?.hints ?? [:]
+  #expect(hints.keys.allSatisfy(isReal), "state.json", sourceLocation: sourceLocation)
+  #expect(!h.scheduler.pendingKeys.contains("pending-slots"), sourceLocation: sourceLocation)
+}
+
+/// Presets against the real controller (docs/features/F21-presets.md; the numbers are its acceptance criteria).
+@Suite @MainActor struct PresetTests {
+  /// One window of each app, opened in this order (ids from 101), floating.
+  func harness(_ apps: String..., displays: [DisplaySnapshot] = [FakeWindowSystem.standardDisplay], settings: Settings = Settings()) -> Harness {
+    let h = Harness(displays: displays, settings: settings)
+    for app in apps { h.system.open(app: app) }
+    h.start()
+    return h
+  }
+
+  /// Safari and Mail on the main display, Notes and Slack on the side one.
+  func twoDisplays(settings: Settings = Settings()) -> Harness {
+    let h = Harness(displays: [FakeWindowSystem.standardDisplay, side], settings: settings)
+    h.system.open(app: "Safari", frame: CGRect(x: 100, y: 100, width: 500, height: 400))
+    h.system.open(app: "Mail", frame: CGRect(x: 300, y: 150, width: 500, height: 400))
+    h.system.open(app: "Notes", frame: CGRect(x: 1600, y: 100, width: 500, height: 400))
+    h.system.open(app: "Slack", frame: CGRect(x: 1800, y: 150, width: 500, height: 400))
+    h.start()
+    return h
+  }
+
+  func w(_ id: UInt32) -> WindowID { WindowID(id) }
+
+  /// Where the window of each app is. For harnesses with one window per app.
+  func framesByApp(_ h: Harness) -> [String: CGRect] {
+    Dictionary(uniqueKeysWithValues: h.system.windows.values.map { ($0.snapshot.appName, $0.snapshot.frame) })
+  }
+
+  func line(_ h: Harness, _ display: Int = 1) -> String? { h.run("layout @\(display)").text }
+
+  /// A window of an app that `open -g` started: it appears and becomes its app's focused window, but the app is not in
+  /// front, so the keyboard stays where it was.
+  func openInBackground(_ h: Harness, _ app: String) -> WindowID {
+    let echoes = h.system.echoes
+    h.system.echoes.keyboard = false
+    let window = h.system.open(app: app)
+    h.system.echoes = echoes
+    h.system.backgroundFocus(window)
+    return window
+  }
+
+  /// Opens a window of `app` and says whether it was docked on `display` (the main one by default).
+  func docks(_ h: Harness, _ app: String, title: String? = nil, on display: DisplayID? = nil) -> Bool {
+    let window = h.system.open(app: app, title: title)
+    return h.controller.workspaces[display ?? h.display]?.isDocked(window) == true
+  }
