@@ -0,0 +1,99 @@
+import ArborCore
+
+/// Slots of an arrangement that was written down, waiting for a window of their app.
+///
+/// `layout --open` and `preset load` can name apps that have no window yet. Their slots wait as saved slots wait
+/// after launch (Controller+PendingSlots.swift): a stand-in number sits in the tree where the window
+/// belongs and takes no space, like a minimised window. So the place moves with the tree while
+/// the user drags gaps or docks other windows, and the window that comes is simply swapped in.
+///
+/// What differs is who may take the slot. A saved slot knows the bundle id and title of the window it lost.
+/// A written slot knows what was written (`WindowSlot`), and `WindowSlot` decides, as it did for the
+/// windows that were there in time. These stand-ins have no hint, so the next launch drops them.
+extension Controller {
+  /// How long a written slot waits, in seconds. Big apps take half a minute to start from cold, and someone who
+  /// loads a preset and then opens the missing app by hand takes longer.
+  public static let writtenSlotPatience: Double = 180
+  /// A line can hold a thousand names.
+  static let mostWrittenSlots = 50
+
+  /// Call with the windows each of `slots` got, before building the tree. Returns them with a stand-in in every
+  /// slot that names an app and found no window, and notes which slot each window has, so that the slot
+  /// waits again if the window closes. Then call `startWaitingForWrittenSlots()`.
+  func holdingPlaces(_ windows: [[WindowID]], of slots: [WindowSlot]) -> [[WindowID]] {
+    var filled = windows
+    for (index, slot) in slots.enumerated() where index < filled.count {
+      // A window's number is never given out again, so there is nothing to wait for.
+      guard case .app = slot.owner else { continue }
+      for window in filled[index] { filledSlots[window] = slot }
+      if filled[index].isEmpty, let standIn = standIn(for: slot) { filled[index] = [standIn] }
+    }
+    return filled
+  }
+
+  /// A number that holds a place in a tree for `slot`. Nil if too many are waiting already.
+  private func standIn(for slot: WindowSlot) -> WindowID? {
+    guard writtenSlots.count < Self.mostWrittenSlots, let standIn = freeStandIn() else { return nil }
+    // At once, so that the next search passes it over.
+    pendingSlots.insert(standIn)
+    writtenSlots[standIn] = slot
+    return standIn
+  }
+
+  /// Whether a place of a line is still waiting for its window on `display`.
+  func hasWrittenSlots(on display: DisplayID) -> Bool {
+    writtenSlots.keys.contains { workspaces[display]?.isDocked($0) == true }
+  }
+
+  func startWaitingForWrittenSlots() {
+    guard !writtenSlots.isEmpty || !filledSlots.isEmpty else { return }
+    scheduler.schedule("written-slots", after: Self.writtenSlotPatience) { [weak self] in self?.expireWrittenSlots() }
+  }
+
+  /// Time is up. Nothing moves by a timer (`expireSlots`): a place whose going would move a window stays, overdue, until the next
+  /// layout that somebody causes.
+  private func expireWrittenSlots() {
+    filledSlots.removeAll()
+    expireSlots { writtenSlots[$0] != nil }
+    endWaitIfOver()
+  }
+
+  /// Ends the wait everywhere, at once. Called from `shutdown`, so also by `pause`.
+  func forgetWrittenSlots() {
+    scheduler.cancel("written-slots")
+    filledSlots.removeAll()
+    forgetPendingSlots { writtenSlots[$0] != nil }
+    endWaitIfOver()
+  }
+
+  /// `undo` or `redo` has put back other arrangements (`forgetPendingSlotsWithoutAPlace`). Places that are still in a tree go on waiting.
+  /// The windows of the line are where the person has now put them, not where the line did, so none of them leaves a
+  /// place behind when it closes. And a wait for nothing is over.
+  func forgetWrittenSlotsWithoutAPlace() {
+    filledSlots.removeAll()
+    if writtenSlots.isEmpty { scheduler.cancel("written-slots") }
+  }
+
+  /// The written slot `window` may take: the first, as written, that asks for its title, otherwise the first for
+  /// its app. Only a window that has just appeared is given one. One that floats already was left out
+  /// by the line, or taken out of the arrangement by the user, and stays where it is.
+  func writtenSlot(waitingFor window: WindowSnapshot) -> WindowID? {
+    guard !writtenSlots.isEmpty, workspaceID(containing: window.id) == nil else { return nil }
+    let candidate = Self.candidate(window)
+    // Stand-ins are handed out from the largest number down. Those of a display that went away wait for it.
+    let free = writtenSlots.keys.sorted(by: >).filter { standIn in
+      writtenSlots[standIn]?.accepts(candidate) == true && workspaces.values.contains { $0.isDocked(standIn) }
+    }
+    return free.first { writtenSlots[$0]?.title != nil && writtenSlots[$0]?.matchesTitle(window.title) == true } ?? free.first
+  }
+
+  /// `id`, which was on `display`, has closed. A window of the line that closes so soon was a splash screen, or its app is
+  /// being started again: if it was docked, its slot waits for the next one, and this returns true.
+  func writtenSlotWaitsAgain(after id: WindowID, on display: DisplayID) -> Bool {
+    guard let slot = filledSlots.removeValue(forKey: id), workspaces[display]?.isDocked(id) == true, let standIn = standIn(for: slot)
+    else { return false }
+    workspaces[display]!.replaceWindow(id, with: standIn)
+    undoHistory.renumber(id, as: standIn)
+    return true
+  }
+}
