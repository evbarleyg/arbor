+import ArborCore
+import ArborKit
+import ArborTesting
+import Foundation
+import Testing
+
+/// presets.json on disk, through the commands that read and write it (docs/features/F21-presets.md, criteria 2 and 3).
+@Suite @MainActor struct PresetStoreTests {
+  /// A folder of its own for each test, removed when the test ends.
+  final class Folder {
+    let url = FileManager.default.temporaryDirectory.appendingPathComponent("arbor-presets-\(UUID().uuidString)")
+    var file: URL { url.appendingPathComponent("presets.json") }
+
+    init() throws { try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true) }
+    deinit { try? FileManager.default.removeItem(at: url) }
+
+    func write(_ text: String) throws { try Data(text.utf8).write(to: file) }
+    func read() throws -> String { String(decoding: try Data(contentsOf: file), as: UTF8.self) }
+    var exists: Bool { FileManager.default.fileExists(atPath: file.path) }
+  }
+
+  /// A controller wired to the file the way `ArborApp` wires it, with Safari beside Mail.
+  func harness(_ folder: Folder) -> Harness {
+    let h = Harness()
+    h.controller.presetStore = FilePresetStore(url: folder.file)
+    h.system.open(app: "Safari")
+    h.system.open(app: "Mail")
+    h.start()
+    h.run("layout Safari | Mail | Desktop")
+    return h
+  }
+
+  @Test func theFirstPresetMakesTheFileAndItCanBeLoadedFromIt() throws {
+    let folder = try Folder()
+    let h = harness(folder)
+    #expect(h.run("presets").message.hasPrefix("no presets yet"))
+    #expect(!folder.exists, "asking makes no file")
+    #expect(h.run("preset save Work").ok)
+    #expect(try folder.read() == "{\n  \"Work\": \"Safari | Mail | Desktop\"\n}\n")
+    h.run("float-all")
+    #expect(h.run("preset load Work").ok)
+    #expect(h.run("layout").text == "Safari | Mail | Desktop")
+    #expect(h.run("preset delete Work").ok)
+    #expect(try PresetFile(text: try folder.read()).presets.isEmpty)
+  }
+
+  @Test func theFolderIsMadeIfNeeded() throws {
+    let folder = try Folder()
+    let h = Harness()
+    let file = folder.url.appendingPathComponent("not/yet/presets.json")
+    h.controller.presetStore = FilePresetStore(url: file)
+    h.system.open(app: "Safari")
+    h.start()
+    h.run("dock 101 left")
+    #expect(h.run("preset save Work").ok)
+    #expect(FileManager.default.fileExists(atPath: file.path))
+  }
+
+  @Test(arguments: ["", "\n", "  \r\n\t"]) func aBlankFileCountsAsNoFile(blank: String) throws {
+    let folder = try Folder()
+    try folder.write(blank)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").ok)
+    #expect(try folder.read() == "{\n  \"Work\": \"Safari | Mail | Desktop\"\n}\n")
+  }
+
+  @Test func anEditOnDiskCountsAtOnce() throws {
+    let folder = try Folder()
+    let h = harness(folder)
+    try folder.write(#"{"Mine": "Mail / Safari"}"#)
+    #expect(h.run("preset load Mine").ok)
+    #expect(h.run("layout").text == "(Mail / Safari) | Desktop:0.5")
+  }
+
+  @Test func aFileWithATypoIsLeftAloneByteForByte() throws {
+    let folder = try Folder()
+    let text = "{\n  \"Work\": \"Safari\",,\n}\n"
+    try folder.write(text)
+    let h = harness(folder)
+    for command in ["preset save Work", "preset save Other", "preset delete Work", "preset load Work", "presets"] {
+      let result = h.run(command)
+      #expect(!result.ok, "\(command)")
+      #expect(result.message.hasPrefix("presets.json cannot be read, and is left as it is: line 2, column 20"), "\(result.message)")
+    }
+    #expect(try folder.read() == text)
+  }
+
+  @Test func aByteOrderMarkStays() throws {
+    let folder = try Folder()
+    try folder.write("\u{FEFF}{\"Old\": \"Mail\"}")
+    let h = harness(folder)
+    #expect(h.run("preset save Work").ok)
+    #expect(try folder.read() == "\u{FEFF}{\"Old\": \"Mail\", \"Work\": \"Safari | Mail | Desktop\"}")
+  }
+
+  @Test func aFileThatIsNotUTF8IsLeftAlone() throws {
+    let folder = try Folder()
+    let bytes = Data([0x7B, 0x22, 0xFF, 0xFE, 0x22, 0x3A, 0x22, 0x41, 0x22, 0x7D])
+    try bytes.write(to: folder.file)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").message == "presets.json cannot be read, and is left as it is: the file is not UTF-8 text")
+    #expect(try Data(contentsOf: folder.file) == bytes)
+  }
+
+  @Test func aFileThatIsTooLargeIsNotEvenRead() throws {
+    let folder = try Folder()
+    try Data(repeating: 0x20, count: PresetFile.maximumSize + 1).write(to: folder.file)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").message == "presets.json cannot be read, and is left as it is: it is larger than 1 MB")
+    #expect(try Data(contentsOf: folder.file).count == PresetFile.maximumSize + 1)
+  }
+
+  @Test func aFileOfExactlyTheLargestSizeIsRead() throws {
+    let folder = try Folder()
+    try folder.write("{\"Old\": \"Mail\"" + String(repeating: " ", count: PresetFile.maximumSize - 15) + "}")
+    #expect(try Data(contentsOf: folder.file).count == PresetFile.maximumSize)
+    #expect(harness(folder).run("presets").text == "Old  Mail")
+  }
+
+  @Test func aLinkToTheFileStaysALink() throws {
+    let folder = try Folder()
+    let real = folder.url.appendingPathComponent("dotfiles-presets.json")
+    try Data(#"{"Old": "Mail"}"#.utf8).write(to: real)
+    try FileManager.default.createSymbolicLink(at: folder.file, withDestinationURL: real)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").ok)
+    #expect(try FileManager.default.destinationOfSymbolicLink(atPath: folder.file.path) == real.path)
+    #expect(String(decoding: try Data(contentsOf: real), as: UTF8.self) == #"{"Old": "Mail", "Work": "Safari | Mail | Desktop"}"#)
+  }
+
+  @Test func aLinkToNothingIsCalledThat() throws {
+    let folder = try Folder()
+    try FileManager.default.createSymbolicLink(at: folder.file, withDestinationURL: folder.url.appendingPathComponent("gone.json"))
+    let h = harness(folder)
+    let result = h.run("preset save Work")
+    #expect(!result.ok)
+    #expect(result.message == "presets.json cannot be read, and is left as it is: it is a link to a file that does not exist")
+  }
+
+  @Test func theFileKeepsItsPermissions() throws {
+    let folder = try Folder()
+    try folder.write(#"{"Old": "Mail"}"#)
+    try FileManager.default.setAttributes([.posixPermissions: 0o640], ofItemAtPath: folder.file.path)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").ok)
+    #expect(try FileManager.default.attributesOfItem(atPath: folder.file.path)[.posixPermissions] as? Int == 0o640)
+  }
+
+  @Test(.enabled(if: getuid() != 0)) func aReadOnlyFileIsRespected() throws {
+    let folder = try Folder()
+    try folder.write(#"{"Old": "Mail"}"#)
+    try FileManager.default.setAttributes([.posixPermissions: 0o444], ofItemAtPath: folder.file.path)
+    let h = harness(folder)
+    #expect(h.run("preset save Work").message == "presets.json could not be changed: the file is read-only")
+    #expect(h.run("preset load Old").ok)
+    #expect(try folder.read() == #"{"Old": "Mail"}"#)
+  }
+
+  @Test func aFolderInItsPlaceIsReported() throws {
+    let folder = try Folder()
+    try FileManager.default.createDirectory(at: folder.file, withIntermediateDirectories: true)
+    let h = harness(folder)
+    let result = h.run("preset save Work")
+    #expect(!result.ok)
+    #expect(result.message.hasPrefix("presets.json cannot be read, and is left as it is: the file cannot be opened"), "\(result.message)")
+  }
+
+  // MARK: Something to open in an editor
+
+  @Test func anEmptyFileIsMadeOnlyWhereThereIsNone() throws {
+    let folder = try Folder()
+    let store = FilePresetStore(url: folder.file)
+    store.createIfMissing()
+    #expect(try folder.read() == "{\n}\n")
+    #expect(try PresetFile(text: try store.read()).presets.isEmpty)
+    // The first preset goes into it as into a new file.
+    let h = harness(folder)
+    h.run("preset save Work")
+    #expect(try PresetFile(text: try folder.read()).presets.map(\.name) == ["Work"])
+
+    for text in [#"{"Mine": "Mail"}"#, "{ not JSON"] {
+      try folder.write(text)
+      store.createIfMissing()
+      #expect(try folder.read() == text)
+    }
+  }
+}
