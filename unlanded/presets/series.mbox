+  /// What is said on screen is logged as well, and that line went by the names of spaces and by the name as it was typed.
+  @Test func theLineOnScreenIsLoggedWithoutTheNamesOfPresets() {
+    let h = harness("Safari")
+    h.presets.text = #"{"Desk": "Mail | Notes", "Client Acme": "Safari"}"#
+    for name in ["desk", "nobody", "client acme"] {
+      let reply = h.controller.perform(.presetLoad(name: name, display: nil, open: false), from: .shortcut).message
+      #expect(reply.contains("Desk") || reply.contains("Client Acme"), "\(reply)")
+      let logged = h.controller.headsUp.logged
+      #expect(!logged.isEmpty && !logged.contains("Desk") && !logged.contains("Acme"), "\(logged)")
+    }
+    _ = h.controller.perform(.presetDelete(name: "DESK"), from: .menu)
+    #expect(!h.controller.headsUp.logged.contains("Desk"), "\(h.controller.headsUp.logged)")
+  }
+
+  /// The field is answer enough, as it is for the name of a space.
+  @Test func askingForANameSaysNothingBesideTheField() {
+    #expect(Command.presetAskName(display: nil).opensItsOwnAnswer)
+    let h = harness("Safari")
+    h.run("dock 101 left")
+    #expect(h.controller.perform(.presetAskName(display: nil), from: .menu).ok)
+    #expect(h.overlays.headsUp.isEmpty)
+  }
+
+  // MARK: Places
+
+  /// A number that has kept a place for one app is not given to a place for another while `undo` can bring the first tree back.
+  @Test func takingALoadBackLeavesNoPlaceOfItsPredecessorToAnotherApp() {
+    let h = harness("Safari")
+    h.presets.text = #"{"A": "Safari | Mail", "B": "Slack | Safari"}"#
+    #expect(h.run("preset load A").message.hasSuffix("waiting for Mail"))
+    #expect(h.run("preset load B").message.hasSuffix("waiting for Slack"))
