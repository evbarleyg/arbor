+  /// Every window on every display is where it was, as large as it was, docked or floating as it was, in view or out of it as it was, and the
+  /// view shows what it showed. (Only a wait that the load ended stays ended: its places took no room.)
+  @Test(arguments: ["", "arrange all", "layout @1 Slack | Notes | Mail | Safari", "preset load Desk", "preset load Away", "preset load Tabs", "dock 103 left"])
+  func undoTakesALoadBackWhole(first: String) {
+    for look in ["", "zoom 101", "desktop"] {
+      for name in Self.names {
+        let h = twoDisplays()
+        h.presets.text = Self.desk
+        if !first.isEmpty { #expect(h.run(first).ok) }
+        if !look.isEmpty { #expect(h.run(look).ok) }
+        h.scheduler.advance(by: 5)
+        let (before, arranged, away) = (frames(h), h.controller.workspaces, h.controller.parked)
+        #expect(h.run("preset load \(name)").ok)
+        h.scheduler.advance(by: 5)
+        guard h.controller.workspaces.mapValues(\.tree) != arranged.mapValues(\.tree) else { continue }
+        let what = "\(name) after \(first), \(look)"
+        #expect(h.run("undo").message == "undid preset load", "\(what)")
+        h.scheduler.advance(by: 5)
+        #expect(h.controller.parked == away, "\(what)")
+        for (window, frame) in frames(h).sorted(by: { $0.key < $1.key }) where !away.contains(window) {
+          #expect(frame == before[window], "\(what): \(window) was at \(before[window] ?? .null) and is at \(frame)")
+        }
+        for (display, workspace) in h.controller.workspaces {
+          var tree = arranged[display]!.tree
+          for place in tree.allWindows where Controller.isStandIn(place) && !workspace.isDocked(place) { tree.remove(place) }
+          #expect(workspace.tree == tree, "\(what)")
+          #expect(workspace.camera == arranged[display]?.camera, "\(what)")
+          #expect(workspace.floating == arranged[display]?.floating, "\(what)")
+        }
+      }
+    }
+  }
