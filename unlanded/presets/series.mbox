+step "two displays, one preset"
+arbor_start 4
+printf '{\n  "Desk": ["@1 %s | %s", "@2 %s / %s"]\n}\n' "$W1" "$W2" "$W3" "$W4" > "$ARBOR_HOME/presets.json"
+display_add 1280 800 right
+sleep 2
+ctl preset load Desk
+check "3 goes to the second display" eventually is display2 "$W3"
+check "and is docked there" is docked "$W3"
+check "so is 4" eventually is docked "$W4"
+panorama 06-desk
+ctl preset save Both
+presets_file
+check "saving writes a line for each display" grep -q '"@2 ' "$ARBOR_HOME/presets.json"
+display_remove
+sleep 2
+ctl preset load Desk
+check "with one display its line is applied" eventually prints "$W1 | $W2 | Desktop:0.5"
+check "and 3 floats on the display that is left" is floating "$W3"
+arbor_stop 07-quit
+
+step "a place waits for a real app, with Arbor arranging everything"
+on_throwaway_mac && { pkill -x TextEdit; pkill -x Terminal; }
+sleep 1
+arbor_new_home
+printf '{\n  "Work": "Finder | Terminal | Desktop"\n}\n' > "$ARBOR_HOME/presets.json"
+# safe anywhere: on a person's Mac the script has ended above; arranging every window is what part 4 is about
+env ARBOR_NO_PROMPT=1 ARBOR_DEBUG=1 ARBOR_NO_HOTKEYS=1 ARBOR_NO_STATUS_ITEM=1 ARBOR_NO_WATCHDOG=1 "$ARBOR_BIN/Arbor" > "$ARBOR_OUT/arbor-stderr-wait.log" 2>&1 &
+ARBOR_PID=$!
+started "$ARBOR_PID"
+running() { "$ARBOR_BIN/arborctl" status | grep -q "^running"; }
+check "Arbor runs" eventually running
+on_throwaway_mac && open -a Finder "$ARBOR_ROOT"
+sleep 2
+ctl preset load Work
+printed
+on_throwaway_mac && open -a Terminal
+for second in 1 2 3 4 5 6 7 8; do
+  sleep 1
+  echo "after ${second}s: $(printed)"
+done
+check "Terminal's window took the place that waited for it" sh -c "'$ARBOR_BIN/arborctl' layout | grep -q 'Finder | Terminal'"
+shot 08-waited
+on_throwaway_mac && pkill -x Terminal
+sleep 2
+echo "after Terminal quit: $(printed)"
+ctl preset load Work --open
+for second in 1 2 3 4 5 6 7 8; do
+  sleep 1
+  echo "after ${second}s: $(printed)"
+done
+check "opened by Arbor, it takes the place again" sh -c "'$ARBOR_BIN/arborctl' layout | grep -q 'Finder | Terminal'"
+grep -i "preset\|waiting for it" "$ARBOR_HOME/arbor.log" | tail -n 10
+arbor_stop 09-quit
+on_throwaway_mac && { pkill -x TextEdit; pkill -x Terminal; }
