+  @Test func noFileNameOrCommandLosesAWindowOrBreaksATree() {
+    let h = Harness(displays: [FakeWindowSystem.standardDisplay, side])
+    for app in ["Safari", "Safari", "Mail", "Notes", "Visual Studio Code", "Desktop", "412"] { h.system.open(app: app) }
+    h.system.open(app: "Slack", frame: CGRect(x: 1700, y: 100, width: 400, height: 300))
+    h.start()
+    var state: UInt64 = 2121
+    func next(_ bound: Int) -> Int {
+      state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+      return Int((state >> 33) % UInt64(bound))
+    }
+    let pieces = [
+      "Safari", "Safari*", "Mail", "Notes", "'Visual Studio Code'", "Code", "'Desktop'", "Desktop", "412", "101", "w103", "Slack", "Zed", "Xcode",
+      "|", "|", "/", "(", ")", "[", "]", ":2", ":0.001", "~Safari", "@1", "@2", "@3", "--open", " ",
+    ]
+    let sound = [
+      "Safari | Mail", "Safari* | (Notes / Zed)", "[Safari Safari Xcode] | Slack", "@1 Mail / Notes", "@2 Slack | Zed | Safari~Safari", "@2 Desktop", "@1 Code:2 | 412",
+      "Xcode | Zed", "@3 Mail", "Desktop", "Safari | Safari | Safari",
+    ]
+    func randomLine() -> String {
+      next(3) > 0 ? sound[next(sound.count)] : (0..<(1 + next(8))).map { _ in pieces[next(pieces.count)] }.joined(separator: " ")
+    }
+    let allNames = ["A", "B", "Deep Work", "a", "é", "--x", "@1", ""]
+    /// Mostly one that can be used.
+    func name() -> String { allNames[next(next(5) == 0 ? allNames.count : 5)] }
+    var loaded = 0
+    for round in 0..<6000 {
+      switch next(12) {
+      case 0:
+        // Somebody edits the file.
+        let entries = (0..<next(5)).map { _ -> String in
+          let value = next(3) == 0 ? "[" + (0..<next(4)).map { _ in JSONText.quote(randomLine()) }.joined(separator: ",") + "]" : JSONText.quote(randomLine())
+          return JSONText.quote(name()) + ": " + (next(9) == 0 ? "12" : value)
+        }
+        h.presets.text = "{" + entries.joined(separator: ", ") + (next(15) == 0 ? "" : "}")
+      case 1: h.run("preset save \(name())")
+      case 2: h.run("preset save @\(1 + next(3)) \(name())")
+      case 3: h.run("preset delete \(name())")
+      case 4: h.run(["zoom 101", "out", "float 103", "dock 104 left", "arrange", "desktop", "float-all", "dock 102 beside 101 top", "presets"][next(9)])
+      case 5: h.system.close(h.system.open(app: ["Zed", "Safari", "Mail", "Xcode"][next(4)]))
+      case 6: h.scheduler.advance(by: Double(next(120)))
+      case 7: h.system.cursor = CGPoint(x: next(2) == 0 ? 700 : 2000, y: 400)
+      case 8 where round % 5 == 0: h.system.setDisplays(next(2) == 0 ? [FakeWindowSystem.standardDisplay] : [FakeWindowSystem.standardDisplay, side])
+      default:
+        if h.run("preset load \(name())\(next(4) == 0 ? " --open" : "")\(next(6) == 0 ? " @\(1 + next(3))" : "")").ok { loaded += 1 }
+      }
+      if round % 20 == 0 { expectNothingLost(h) }
+    }
+    expectNothingLost(h)
+    #expect(loaded > 300, "\(loaded)")
+    h.system.setDisplays([FakeWindowSystem.standardDisplay, side])
+    h.scheduler.advance(by: 400)
+    expectNobodyIsWaitedFor(h)
+    h.run("home")
+    expectWindowsMatchLayout(h, on: h.display)
+    expectWindowsMatchLayout(h, on: side.id)
+  }
+}
