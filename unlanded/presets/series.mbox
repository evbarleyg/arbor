diff --git a/scripts/mac-shell/check-F21.sh b/scripts/mac-shell/check-F21.sh
new file mode 100755
index 00000000..bba654b1
--- /dev/null
+++ b/scripts/mac-shell/check-F21.sh
@@ -0,0 +1,143 @@
+#!/bin/bash
+# F21, presets, on real windows, through the real arborctl, the real presets.json and the real menu:
+#
+#   scripts/mac-shell/run.sh scripts/mac-shell/check-F21.sh
+#
+# 1. On test windows, safe on anybody's Mac (the file is in the session's temporary home): a preset is saved, read, loaded after a
+#    scramble, edited by hand, broken by hand and left alone; titles and names stay out of the log; nobody but its user can read the file.
+# 2. The menu: the Presets submenu is there, and a click on a preset loads it. Moves the pointer, like every session.
+# 3. Two displays (a virtual one, so only on a throwaway Mac): one preset arranges both, and is loaded again with one unplugged.
+# 4. Only on a throwaway Mac, because Arbor then arranges every window there is: a slot waits for an app that is opened by hand
+#    later, and `--open` opens one. How long real apps take is recorded rather than judged.
+source "$(dirname "$0")/lib.sh"
+
+printed() { "$ARBOR_BIN/arborctl" layout "$@"; }
+prints() { [ "$(printed --ids)" = "$1" ]; }
+presets_file() { cat "$ARBOR_HOME/presets.json"; }
+fails() { ! "$ARBOR_BIN/arborctl" "$@" > /dev/null 2>&1; }
+
+arbor_build
+
+step "save, scramble, load"
+arbor_start 4
+line="$W2:2 | Desktop | ($W3 / $W1)"
+ctl layout "$line"
+ctl preset save Deep Work
+presets_file
+check "presets.json has the name" grep -q '"Deep Work": "' "$ARBOR_HOME/presets.json"
+check "the windows of one app are told apart by their titles" test "$(grep -o '~' "$ARBOR_HOME/presets.json" | wc -l | tr -d ' ')" = 3
+check "nobody but its user can read the file" test "$(ls -l "$ARBOR_HOME/presets.json" | cut -c 1-10)" = "-rw-------"
+ctl arrange
+ctl preset load deep work
+check "every window is back in its place" eventually prints "$line"
+check "and really there" eventually is in_slot "$W1"
+check "4 was not part of it and floats" is floating "$W4"
+shot 01-loaded
+ctl presets
+
+step "titles and names stay out of the log"
+check "the commands are logged" grep -q "preset save ‹name›: saved ‹name›" "$ARBOR_HOME/arbor.log"
+check "without titles" test "$(grep -c "Arbor Test" "$ARBOR_HOME/arbor.log")" = 0
+check "without the preset's name" test "$(grep -ci "Deep Work" "$ARBOR_HOME/arbor.log")" = 0
+
+step "a file edited by hand counts at once"
+printf '{\n  "Mine": "%s / %s",\n  "Odd": 12\n}\n' "$W4" "$W1" > "$ARBOR_HOME/presets.json"
+ctl preset load Mine
+check "it is loaded without any reload" eventually prints "($W4 / $W1) | Desktop:0.5"
+ctl presets
+check "the entry that cannot be read is listed" sh -c "'$ARBOR_BIN/arborctl' presets | grep -q 'skipped \"Odd\"'"
+ctl preset save Another
+check "and survives a save" grep -q '"Odd": 12' "$ARBOR_HOME/presets.json"
+
+step "a file with a typo is left alone"
+printf '{\n  "Mine": "%s"\n  "Other": "%s"\n}\n' "$W4" "$W1" > "$ARBOR_HOME/presets.json"
+before=$(cksum < "$ARBOR_HOME/presets.json")
+ctl preset save Third
+check "saving fails" fails preset save Third
+check "deleting fails" fails preset delete Mine
+check "the file has not changed" test "$(cksum < "$ARBOR_HOME/presets.json")" = "$before"
+arbor_stop 02-quit
+
+step "the menu"
+arbor_start 3 ARBOR_NO_STATUS_ITEM=0
+printf '{\n  "Side By Side": "%s | %s | %s"\n}\n' "$W1" "$W2" "$W3" > "$ARBOR_HOME/presets.json"
+# With a test window in front: the menu names the app in front, and the keys below are that app's should the menu close.
+# shellcheck disable=SC2046
+click $(center_of "$W1")
+check "the menu has a row for it" sh -c "'$ARBOR_BIN/arborctl' menu | grep -q '^ *Side By Side$'"
+check "and one for ⌥" sh -c "'$ARBOR_BIN/arborctl' menu | grep -q 'Side By Side, Opening Its Apps  (with ⌥)'"
+if [ -n "${ARBOR_REHEARSAL:-}" ]; then
+  echo "choosing the row skipped: of the keys an open menu takes, a rehearsal's knows only Escape"
+elif item=$(status_item); then
+  # shellcheck disable=SC2086
+  click $item
+  shot 03-menu
+  # The submenu opens when its title is typed and → is pressed, as in any menu.
+  key p; key r; key e; key right
+  shot 04-presets-submenu
+  key return
+  check "choosing the preset loads it" eventually prints "$W1 | $W2 | $W3 | Desktop:0.5"
+else
+  check "Arbor's menu bar item can be found" false
+fi
+arbor_stop 05-quit
+
+on_throwaway_mac || { echo; echo "parts 3 and 4 skipped: they plug in a virtual display, let Arbor arrange every window and open apps, and the Mac it runs on is somebody's"; exit 0; }
+
