diff --git a/Tests/ArborCoreTests/PresetCommandTextTests.swift b/Tests/ArborCoreTests/PresetCommandTextTests.swift
new file mode 100644
index 00000000..5c1ccf93
--- /dev/null
+++ b/Tests/ArborCoreTests/PresetCommandTextTests.swift
@@ -0,0 +1,150 @@
+import ArborCore
+import Foundation
+import Testing
+
+/// The text form of the preset commands: from a terminal, settings.json's `bindings` and `arbor://` URLs
+/// (docs/features/F21-presets.md, criteria 4 and 12).
+@Suite struct PresetCommandTextTests {
+  static let samples: [Command] = [
+    .presets, .presetSave(name: "Desk", display: nil), .presetSave(name: "Deep Work", display: "2"),
+    .presetLoad(name: "Desk", display: nil, open: false), .presetLoad(name: "Deep Work", display: nil, open: true),
+    .presetLoad(name: "Café 2", display: "side", open: true), .presetDelete(name: "Deep Work"),
+    .presetLoad(name: "load", display: nil, open: false), .presetSave(name: "save me", display: nil),
+    .presetAskName(display: nil), .presetAskName(display: "2"),
+  ]
+
+  @Test(arguments: samples) func textRoundTrips(command: Command) throws {
+    #expect(try Command.parse(command.text) == command)
+    #expect(try Command.parse(words: command.text.split(separator: " ").map(String.init)) == command)
+  }
+
+  @Test(arguments: samples) func codableRoundTrips(command: Command) throws {
+    #expect(try JSONDecoder().decode(Command.self, from: try JSONEncoder().encode(command)) == command)
+  }
+
+  @Test func theLogDoesNotGetToSeeTheName() {
+    #expect(Command.presetSave(name: "Acme Pitch", display: "2").logText == "preset save @2 ‹name›")
+    #expect(Command.presetLoad(name: "Acme Pitch", display: nil, open: true).logText == "preset load --open ‹name›")
+    #expect(Command.presetDelete(name: "Acme Pitch").logText == "preset delete ‹name›")
+    #expect(Command.presets.logText == "presets")
+  }
+
+  @Test func theTextIsWhatTheHelpSays() {
+    #expect(Command.presetSave(name: "Deep Work", display: "2").text == "preset save @2 Deep Work")
+    #expect(Command.presetLoad(name: "Deep Work", display: "2", open: true).text == "preset load @2 --open Deep Work")
+    #expect(Command.presetDelete(name: "Desk").text == "preset delete Desk")
+    #expect(Command.presets.text == "presets")
+    for words in ["preset save [@display] [name]", "preset load [@display] [--open] <name>", "preset delete <name> | presets"] {
+      #expect(Command.helpText.contains(words), "\(words)")
+    }
+  }
+
+  @Test func aNameIsAllTheWordsThatAreNotOptions() throws {
+    let expected = Command.presetLoad(name: "Deep Work", display: "2", open: true)
+    for text in [
+      "preset load Deep Work @2 --open", "preset load --open @2 Deep Work", "preset load Deep --open Work @2", "PRESET LOAD @2 Deep   Work --OPEN",
+      "preset/load/Deep/Work/@2/--open", "preset apply Deep Work --open @2", "  preset\tload\tDeep\tWork --open --open @2 ",
+    ] {
+      #expect(try Command.parse(text) == expected, "\(text)")
+    }
+  }
+
+  @Test func namesKeepTheirCapitals() throws {
+    #expect(try Command.parse("preset save iOS Work") == .presetSave(name: "iOS Work", display: nil))
+  }
+
+  @Test func otherWaysToSayIt() throws {
+    #expect(try Command.parse("preset list") == .presets)
+    #expect(try Command.parse("preset remove Desk") == .presetDelete(name: "Desk"))
+  }
+
+  @Test(arguments: [
+    ("preset", "usage: preset save"), ("preset nonsense Desk", "usage: preset save"), ("preset Desk", "usage: preset save"),
+    ("preset load", "the preset's name is missing"),
+    ("preset load --open", "the preset's name is missing"), ("preset delete", "the preset's name is missing"),
+    ("preset save Desk --open", "`--open` is not an option here"), ("preset delete Desk --open", "`--open` is not an option here"),
+    ("preset load Desk --force", "`--force` is not an option here; there is `preset load --open`"),
+    ("preset load Desk --", "`--` is not an option here"),
+    ("preset delete @2 Desk", "`preset delete` takes no display"), ("preset list @2", "`preset list` takes no display"),
+    ("preset load @1 @2 Desk", "one display at a time"), ("preset load @ Desk", "expected a display after `@`"),
+    ("preset list Desk", "`preset list` takes no arguments"), ("presets Desk", "`presets` takes no arguments"),
+    ("preset save " + String(repeating: "x", count: 41), "is at most 40 characters long"),
+    ("preset save a\u{200B}b", "holds only characters that can be seen"),
+    ("preset load @" + String(repeating: "9", count: 65) + " Desk", "expected a display after `@`"),
+  ])
+  func mistakesAreNamed(text: String, reason: String) {
+    #expect {
+      _ = try Command.parse(text)
+    } throws: { error in
+      "\(error)".contains(reason)
+    }
+  }
+
+  @Test func errorsStayShortHoweverLongTheWords() {
+    for text in ["preset load --" + String(repeating: "x", count: 5000), "preset " + String(repeating: "y", count: 5000) + " @2"] {
+      #expect {
+        _ = try Command.parse(text)
+      } throws: { error in
+        "\(error)".count < 250
+      }
+    }
+  }
+
+  @Test func whatIsRepeatedOfAWordIsCutAfterTwentyFourCharacters() {
+    func complaint(_ option: String) -> String {
+      do {
+        _ = try Command.parse("preset load Desk \(option)")
+        return ""
+      } catch {
+        return "\(error)"
+      }
+    }
+    let exactly = "--" + String(repeating: "x", count: 22)
+    #expect(complaint(exactly).hasPrefix("`\(exactly)` is not an option here"))
+    #expect(complaint(exactly + "y").hasPrefix("`\(exactly)…` is not an option here"))
+  }
+
+  @Test func aDisplaysNameHasAtMostSixtyFourCharacters() throws {
+    let name = String(repeating: "9", count: 64)
+    #expect(try Command.parse("preset load @\(name) Desk") == .presetLoad(name: "Desk", display: name, open: false))
+  }
+
+  @Test func onlyThePresetsCommandIsAQuery() {
+    #expect(Command.presets.isQuery)
+    for command in Self.samples where command != .presets { #expect(!command.isQuery, "\(command.text)") }
+    for command in Self.samples { #expect(!command.endsPause) }
+  }
+
+  // MARK: URLs
+
+  @Test func wordsOfAURLAreSeparatedBySlashes() throws {
+    #expect(try Command.parse(url: "arbor://preset/load/Desk") == .presetLoad(name: "Desk", display: nil, open: false))
+    #expect(try Command.parse(url: "arbor://preset/load/Deep/Work") == .presetLoad(name: "Deep Work", display: nil, open: false))
+    #expect(try Command.parse(url: "arbor:preset/load/Caf%C3%A9/@2") == .presetLoad(name: "Café", display: "2", open: false))
+    #expect(try Command.parse(url: "arbor://preset/load/Desk/--open") == .presetLoad(name: "Desk", display: nil, open: true))
+    // A space inside a word could smuggle in more words, here as everywhere.
+    #expect(throws: Command.ParseError.self) { try Command.parse(url: "arbor://preset/load/Deep%20Work") }
+  }
+
+  @Test func aURLMayLoadAPresetAndNothingElse() {
+    #expect(Command.presetLoad(name: "Desk", display: nil, open: false).isAllowedFromURL)
+    #expect(Command.presetLoad(name: "Desk", display: "2", open: false).isAllowedFromURL)
+    #expect(!Command.presetLoad(name: "Desk", display: nil, open: true).isAllowedFromURL, "a web page does not open apps")
+    #expect(!Command.presetSave(name: "Desk", display: nil).isAllowedFromURL)
+    #expect(!Command.presetAskName(display: nil).isAllowedFromURL)
+    #expect(!Command.presetDelete(name: "Desk").isAllowedFromURL)
+    #expect(!Command.presets.isAllowedFromURL)
+  }
+
+  // MARK: Anything at all
+
+  @Test func noWordsCrashTheParser() {
+    var generator = SystemRandomNumberGenerator()
+    let pieces = ["preset", "presets", "save", "load", "delete", "list", "--open", "--", "@", "@2", "@@", "/", " ", "Desk", "é", "\u{202E}", "\u{0}", "%", "\"", "'", "|", "-", "9999999999999999999999"]
+    for _ in 0..<20_000 {
+      let text = "preset " + (0..<Int.random(in: 0...6, using: &generator)).map { _ in pieces.randomElement(using: &generator)! }.joined(separator: Bool.random(using: &generator) ? " " : "")
+      guard let command = try? Command.parse(text) else { continue }
+      #expect((try? Command.parse(command.text)) == command, "\(text)")
+    }
+  }
+}
