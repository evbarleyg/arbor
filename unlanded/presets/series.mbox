+  @Test func randomArrangementsComeBack() {
+    var state: UInt64 = 21
+    func next(_ bound: Int) -> Int {
+      state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+      return Int((state >> 33) % UInt64(bound))
+    }
+    let apps = ["Safari", "Mail", "Notes", "Xcode", "Terminal", "Slack", "Music"]
+    for round in 0..<60 {
+      let h = Harness(displays: round % 2 == 0 ? [FakeWindowSystem.standardDisplay] : [FakeWindowSystem.standardDisplay, side])
+      for app in apps { h.system.open(app: app) }
+      h.start()
+      for _ in 0..<(3 + next(12)) {
+        let window = 101 + next(apps.count)
+        let edge = ["left", "right", "top", "bottom"][next(4)]
+        switch next(6) {
+        case 0: h.run("float \(window)")
+        case 1: h.run("resize \(window) \(edge) \(20 + next(120))")
+        case 2: h.run("dock \(window) beside \(101 + next(apps.count)) \(edge)")
+        case 3: h.system.cursor = CGPoint(x: next(2) == 0 ? 700 : 2000, y: 400)
+        default: h.run("dock \(window) \(edge)")
+        }
+      }
+      h.run("home")
+      guard h.run("preset save Round \(round)").ok else { continue }
+      let lines = [line(h, 1), line(h, 2)]
+      let docked = h.controller.workspaces.mapValues(\.tree.allWindows)
+      let frames = h.controller.layouts.values.flatMap(\.windowFrames)
+      h.run(["float-all", "arrange all", "layout Music | Slack | Safari"][next(3)])
+      #expect(h.run("preset load round \(round)").ok)
+      #expect([line(h, 1), line(h, 2)] == lines, "round \(round)")
+      #expect(h.controller.workspaces.mapValues(\.tree.allWindows) == docked, "round \(round)")
+      for (window, frame) in frames {
+        // Sizes are written to three decimals.
+        #expect(h.frame(window)?.approximatelyEquals(frame, tolerance: 2) == true, "round \(round): \(window)")
+      }
+      expectNothingLost(h)
+    }
+  }
