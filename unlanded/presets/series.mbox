+import ArborCore
+@testable import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// A 1280×800 display to the right of the standard one.
+private let side = DisplaySnapshot(
+  id: DisplayID("side"), frame: CGRect(x: 1440, y: 0, width: 1280, height: 800),
+  visibleFrame: CGRect(x: 1440, y: 0, width: 1280, height: 800), isMain: false)
+
+/// `ARBOR_CHAOS_SEEDS=20000 swift test --filter PresetMovesTests.atRandom` walks for longer.
+private let walks = 0..<max(ProcessInfo.processInfo.environment["ARBOR_CHAOS_SEEDS"].flatMap { Int($0) } ?? 0, 300)
+
+/// What presets move, when, and how often (docs/features/F21-presets.md).
+///
+/// A load was asked for, so it moves windows: each of them once, to where it ends up. It arranges the windows it names and lets go of those
+/// it leaves out; what floats where somebody put it stays there. `undo` takes all of it back. A place that waits was asked for by the load, so
+/// the window it waits for is docked when it comes, once, and its neighbours make room, once. Nothing else moves anything: not the
+/// end of the wait, not a window of another app, not a display that comes or goes. And what a preset docked gets its own size back.
+@Suite @MainActor struct PresetMovesTests {
+  static let own = CGSize(width: 500, height: 400)
+
+  /// Safari and Mail on the main display, Notes and Slack on the side one, floating, all of one size.
+  func twoDisplays() -> Harness {
+    let h = Harness(displays: [FakeWindowSystem.standardDisplay, side])
+    h.system.open(app: "Safari", frame: CGRect(origin: CGPoint(x: 100, y: 100), size: Self.own))
+    h.system.open(app: "Mail", frame: CGRect(origin: CGPoint(x: 300, y: 150), size: Self.own))
+    h.system.open(app: "Notes", frame: CGRect(origin: CGPoint(x: 1600, y: 100), size: Self.own))
+    h.system.open(app: "Slack", frame: CGRect(origin: CGPoint(x: 1800, y: 150), size: Self.own))
+    h.start()
+    return h
+  }
+
+  func oneDisplay(_ apps: String...) -> Harness {
+    let h = Harness()
+    for (index, app) in apps.enumerated() {
+      h.system.open(app: app, frame: CGRect(origin: CGPoint(x: 100 + 60 * index, y: 100 + 40 * index), size: Self.own))
+    }
+    h.start()
+    return h
+  }
+
+  func frames(_ h: Harness) -> [WindowID: CGRect] { h.system.windows.mapValues(\.snapshot.frame) }
+
+  /// How often each window changed its frame at Arbor's hand since `before` was taken and the log cleared. Being told again to be where
+  /// it is shows nothing and does not count.
+  func moves(_ h: Harness, since before: [WindowID: CGRect]) -> [WindowID: Int] {
+    var last = before
+    var count: [WindowID: Int] = [:]
+    for (window, frame) in h.system.frameLog where last[window] != frame {
+      count[window, default: 0] += 1
+      last[window] = frame
+    }
+    return count
+  }
+
+  /// Runs `body`, lets every short timer run out, and expects no window to have moved more than once.
+  func expectOneMoveEach(_ h: Harness, _ what: String, sourceLocation: SourceLocation = #_sourceLocation, _ body: () -> Void) {
+    h.scheduler.advance(by: 5)
+    let before = frames(h)
+    h.system.clearFrameLog()
+    body()
+    h.scheduler.advance(by: 5)
+    for (window, count) in moves(h, since: before).sorted(by: { $0.key < $1.key }) {
+      let path = h.system.frameLog.filter { $0.window == window }.map { "\($0.frame)" }.joined(separator: " → ")
+      #expect(count == 1, "\(what): \(window) moved \(count) times: \(path)", sourceLocation: sourceLocation)
+    }
+  }
+
+  // MARK: A load moves each window once
+
+  static let desk = #"""
+    {"Desk": ["@1 Safari | Mail", "@2 Notes / Slack"], "Crossed": ["@1 Notes:2 | Safari", "@2 Mail / Slack"], "Few": ["@1 Safari", "@2 Slack | Desktop"],
+     "Tabs": ["@1 [Safari Notes] | Mail", "@2 Slack"], "Chat": "Slack / Notes", "Away": ["@1 Safari:3 | Xcode:2 | Mail", "@2 (Notes / Terminal:4) | Slack"],
+     "Roomy": ["@1 Safari | Desktop", "@2 Slack | Desktop"]}
+    """#
+  static let names = ["Desk", "Crossed", "Few", "Tabs", "Chat", "Away", "Roomy"]
+
+  /// From floating, from docked, from the other display, into a tab group, out of the arrangement (onto a Desktop that has room for the
+  /// window and onto one that is narrower than it), beside places that wait.
+  @Test func aLoadMovesEachWindowOnce() {
+    for first in Self.names {
+      for second in Self.names {
+        let h = twoDisplays()
+        h.presets.text = Self.desk
+        expectOneMoveEach(h, first) { #expect(h.run("preset load \(first)").ok) }
+        expectOneMoveEach(h, "\(second) after \(first)") { #expect(h.run("preset load \(second)").ok) }
+        expectWindowsMatchLayout(h, on: h.display)
+        expectWindowsMatchLayout(h, on: side.id)
+      }
+    }
+  }
+
+  /// Where a load puts a window is where it stays: the next layout, whoever causes it, finds everything in place.
+  @Test func theNextLayoutMovesNothing() {
+    for name in Self.names {
+      let h = twoDisplays()
+      h.presets.text = Self.desk
+      #expect(h.run("preset load \(name)").ok)
+      h.scheduler.advance(by: 5)
+      let before = frames(h)
+      h.system.clearFrameLog()
+      h.controller.relayoutAll(reason: .structure)
+      h.scheduler.advance(by: 5)
+      #expect(moves(h, since: before).isEmpty, "\(name): \(h.system.frameLog)")
+    }
+  }
