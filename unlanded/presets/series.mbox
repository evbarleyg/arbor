index 00000000..16b9e0d0
--- /dev/null
+++ b/Sources/ArborCore/Command+Preset.swift
@@ -0,0 +1,65 @@
+/// The text form of the preset commands (docs/PRESETS.md):
+///
+///     preset save [@display] <name…>      (without a name: asks for one on screen)
+///     preset load [@display] [--open] <name…>
+///     preset delete <name…>
+///     presets
+///
+/// A name is all the words that are not an option or a display, so `preset load Deep Work --open` needs no quotes,
+/// and `arbor://preset/load/Deep/Work` no escapes.
+extension Command {
+  static let presetUsage =
+    "usage: preset save [@display] [name] | preset load [@display] [--open] <name> | preset delete <name> | presets"
+
+  /// `arguments` are the words after `preset`, as typed.
+  static func parsePreset(_ arguments: [String]) throws -> Command {
+    guard let typed = arguments.first?.lowercased() else { throw ParseError(presetUsage) }
+    let verb = ["apply": "load", "remove": "delete"][typed] ?? typed
+    var words: [String] = []
+    var display: String?
+    var open = false
+    for word in arguments.dropFirst() {
+      if word.hasPrefix("--") {
+        guard word.lowercased() == "--open", verb == "load" else {
+          throw ParseError("`\(clipped(word))` is not an option here; there is `preset load --open`")
+        }
+        open = true
+      } else if word.hasPrefix("@") {
+        guard verb == "save" || verb == "load" else { throw ParseError("`preset \(clipped(verb))` takes no display") }
+        guard display == nil else { throw ParseError("one display at a time") }
+        let name = String(word.dropFirst())
+        guard name.count <= 64, LayoutNotation.canBeWritten(name) else {
+          throw ParseError("expected a display after `@`, as in @2")
+        }
+        display = name
+      } else {
+        words.append(word)
+      }
+    }
+    func name() throws -> String {
+      do {
+        return try Preset.name(of: words)
+      } catch {
+        throw ParseError("the preset's name \(error); \(presetUsage)")
+      }
+    }
+    switch verb {
+    case "save": return words.isEmpty ? .presetAskName(display: display) : .presetSave(name: try name(), display: display)
+    case "load": return .presetLoad(name: try name(), display: display, open: open)
+    case "delete": return .presetDelete(name: try name())
+    case "list":
+      guard words.isEmpty else { throw ParseError("`preset list` takes no arguments") }
+      return .presets
+    default: throw ParseError(presetUsage)
+    }
+  }
+
+  static func presetText(_ verb: String, name: String, display: String? = nil, open: Bool = false) -> String {
+    (["preset", verb] + (display.map { ["@\($0)"] } ?? []) + (open ? ["--open"] : []) + [name]).joined(separator: " ")
+  }
+
+  /// What was typed, short enough to repeat in an error.
+  private static func clipped(_ word: String) -> String {
+    word.count > 24 ? String(word.prefix(24)) + "…" : word
+  }
+}
