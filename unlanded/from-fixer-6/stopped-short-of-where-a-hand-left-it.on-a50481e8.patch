+  /// A hand can leave a window lower than anybody else can put it: asked to place one, macOS keeps its title bar above the Dock. So the
+  /// first way back ends some points short of where the hand left it. That is as near as it comes, and it is still where its person
+  /// pushed it: the second way back took it for a place nobody chose, under half of it showing, and pulled it wholly in.
+  @Test func stoppedShortOfWhereAHandLeftItItComesBackThereEveryTime() {
+    let h = Harness(displays: [Self.display], settings: Settings())
+    let a = h.system.open(app: "Finder", frame: CGRect(x: 340, y: 120, width: 920, height: 436))
+    let f = h.system.open(app: "Terminal", frame: CGRect(x: 40, y: 51, width: 877, height: 499))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.system.userMove(f, to: CGRect(x: 600, y: 850, width: 877, height: 499))
+    let asNearAsItComes = CGRect(x: 600, y: 822 - FakeWindowSystem.measuredTitleBars["Terminal"]!, width: 877, height: 499)
+    for trip in 1...3 {
+      h.run("zoom \(a.rawValue)")
+      h.scheduler.advance(by: 5)
+      h.system.clearFrameLog()
+      h.run("show-all")
+      h.scheduler.advance(by: 5)
+      #expect(h.frame(f) == asNearAsItComes, "trip \(trip)")
+      #expect(h.system.frameLog.filter { $0.window == f }.count == 1, "trip \(trip): \(h.system.frameLog)")
+    }
+    // Nor do a pause, its end and a quit touch it there.
+    h.system.clearFrameLog()
+    for act in ["pause", "resume", "home"] {
+      #expect(h.run(act).ok)
+      h.scheduler.advance(by: 5)
+    }
+    h.controller.shutdown()
+    #expect(h.frame(f) == asNearAsItComes && !h.system.frameLog.contains { $0.window == f }, "\(h.system.frameLog)")
+  }
+
+  /// The control: at the same place, where no hand is known to have left it (its app took it there from another display), it is pulled in.
+  @Test func whereNoHandLeftItUnderHalfShowingIsNoPlaceToComeBackTo() {
+    let side = ReviewFloatingFrameTests.display("side", CGRect(x: 1600, y: 0, width: 1440, height: 900))
+    let h = Harness(displays: [Self.display, side], settings: Settings())
+    let a = h.system.open(app: "Finder", frame: CGRect(x: 340, y: 120, width: 920, height: 436))
+    let f = h.system.open(app: "Terminal", frame: CGRect(x: 1800, y: 51, width: 877, height: 499))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.system.userMove(f, to: CGRect(x: 600, y: 850, width: 877, height: 499))
+    h.run("zoom \(a.rawValue)")
+    h.scheduler.advance(by: 5)
+    h.run("show-all")
+    h.scheduler.advance(by: 5)
+    #expect(h.frame(f) == CGRect(x: 600, y: 822 - 499, width: 877, height: 499))
+  }
