+      let (byMouse, _) = randomHarness(seed: seed, tabs: tabs)
+      byMouse.system.userFocus(carried)
+      byMouse.scheduler.runPending()
+      byMouse.run("zoom-node \(view.rawValue)")
+      let start = byMouse.frame(carried)!
+      byMouse.system.drag(carried, through: [CGPoint(x: start.midX, y: start.minY + 10), choice.anchor])
+      byKeys.scheduler.runPending()
