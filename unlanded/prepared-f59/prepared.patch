+  @Test(arguments: 1...6) func carriedThereOrDraggedThereIsTheSame(seed: Int) {
+    let tabs = seed % 2 == 0
+    let (scout, windows) = randomHarness(seed: seed, tabs: tabs)
+    let carried = windows[seed % windows.count]
+    scout.system.userFocus(carried)
+    scout.scheduler.runPending()
+    guard scout.run("carry").ok else {
+      Issue.record("seed \(seed): could not pick \(carried) up")
+      return
+    }
+    // Picking up can step the view out. The drag starts from the same view.
+    let view = scout.workspace.camera
+    for (choice, keys) in ways(scout) {
+      // A pointer cannot choose the Desktop's edges, and floats a window where it lets go.
+      if case .beside(scout.workspace.tree.desktop, _) = choice.target { continue }
+      if choice.target == .float { continue }
+
+      let (byKeys, _) = randomHarness(seed: seed, tabs: tabs)
+      byKeys.system.userFocus(carried)
