+      #expect(byKeys.workspace.tree == byMouse.workspace.tree, "seed \(seed): \(choice.target)")
+      #expect(byKeys.layout?.windowFrames == byMouse.layout?.windowFrames, "seed \(seed): \(choice.target)")
+      #expect(byKeys.frame(carried) == byMouse.frame(carried), "seed \(seed): \(choice.target)")
