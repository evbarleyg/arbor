+  public mutating func restoreView(from earlier: Workspace) {
+    if tree.contains(earlier.camera) { camera = earlier.camera }
+    back = earlier.back.filter(tree.contains)
+    forward = earlier.forward.filter(tree.contains)
+    // Where its space is gone the view stays where it is, which may be the last place in the old history.
+    tidyHistory()
+  }
