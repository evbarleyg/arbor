+  }
+
+  @Test func aTabCanBePutBesideTheRestOfItsGroup() {
+    var workspace = desk()
+    let leaf = workspace.tree.leaf(containing: a)!
+    workspace.dock(c, at: .stack(leaf))
+    let found = map(carrying: c, in: workspace, tabs: true)
+    #expect(found.choices.first?.target == DropTarget.none)
+    let right = found.next(from: found.choices[0], toward: .right)
+    #expect(right?.target == .beside(leaf, .right))
+    var dropped = workspace
+    dropped.dock(c, at: right!.target)
+    #expect(dropped.tree.windows(under: leaf) == [a])
+    #expect(layout(dropped).place(of: c) == right?.frame)
+  }
+
+  /// Criterion 2, the first half: the arrows lead from every choice to every other.
+  @Test func theArrowsLeadFromEveryChoiceToEveryOther() {
+    for seed in 1...100 {
+      let (workspace, carried, frame, tabs, gone) = randomCase(seed)
+      let found = map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone)
+      let links = found.choices.map { choice in
+        Edge.allCases.compactMap { found.next(from: choice, toward: $0).flatMap(found.choices.firstIndex(of:)) }
+      }
+      func reach(from start: Int) -> Set<Int> {
+        var seen: Set<Int> = [start]
+        var pending = [start]
+        while let index = pending.popLast() {
+          for next in links[index] where seen.insert(next).inserted { pending.append(next) }
+        }
+        return seen
+      }
+      for index in found.choices.indices {
+        #expect(reach(from: index).count == found.choices.count, "seed \(seed), from \(found.choices[index].target)")
+      }
+    }
+  }
