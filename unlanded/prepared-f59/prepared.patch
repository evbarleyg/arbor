+++ b/Sources/ArborCore/Carry.swift
@@ -0,0 +1,367 @@
+import CoreGraphics
+
+/// Carrying a window with the keyboard (docs/features/F59-carry-with-the-keyboard.md).
+///
+/// A drag chooses among targets by pointing. A carry chooses among the same targets with the arrow
+/// keys. Everything here is pure: which places there are to put the window down, and which of them
+/// an arrow key goes to next. `Controller+Carry.swift` holds the window and does the drop.
+
+/// The steps of a carry, as commands: `carry`, `carry left`, `carry drop`, `carry cancel`,
+/// `carry next-display`.
+public enum CarryStep: Equatable, Sendable, Codable {
+  /// Pick a window up (the focused one if nil). With a window already in hand and no other named,
+  /// put it down: the key that picks up also lets go.
+  case pickUp(WindowID?)
+  /// Go to the next place in that direction.
+  case move(Edge)
+  /// Put the window down where the preview is.
+  case drop
+  /// Put everything back as it was, the view included.
+  case cancel
+  /// Choose among the places on the next display, or the previous one.
+  case display(next: Bool)
+}
+
+extension Command {
+  /// Whether a carry goes on when this command runs. Looking somewhere else is part of carrying: that is how
+  /// a window gets to a space that was out of view. Any other command puts everything back first.
+  public var keepsCarrying: Bool {
+    switch self {
+    case .carry: true
+    case .showAll, .home, .stepOut, .stepIn, .neighbor, .back, .forward, .goToView, .saveView: true
+    case .zoomNode, .desktop, .frameRect, .goToSpace: true
+    // Recording is about Arbor, not about the arrangement: a carry can be recorded from the middle.
+    case .trace: true
+    default: isQuery
+    }
+  }
+}
+
+extension Layout {
+  /// Where `window` is: its frame, or the tile it is inside.
+  public func place(of window: WindowID) -> CGRect? {
+    windowFrames[window] ?? tiles.first(where: { $0.windows.contains(window) })?.frame
+  }
+
+  /// What a layout looks like, whatever its spaces are numbered and however a tile is arranged inside:
+  /// to choose a place in there, look closer first.
+  public struct Look: Equatable, Sendable {
+    var windows: [WindowID: CGRect]
+    /// In reading order. Not a dictionary by frame: a `CGRect` can be hashed only from macOS 15 on.
+    var tiles: [TileLook]
+    var desktop: CGRect?
+  }
+
+  struct TileLook: Equatable, Sendable {
+    var frame: CGRect
+    var windows: Set<WindowID>
+  }
+
+  public var look: Look {
+    Look(
+      windows: windowFrames,
+      tiles: tiles.map { TileLook(frame: $0.frame, windows: Set($0.windows)) }
+        .sorted { ($0.frame.minY, $0.frame.minX) < ($1.frame.minY, $1.frame.minX) },
+      desktop: desktopFrame)
+  }
+}
+
+/// One place a carried window can be put down.
+public struct CarryChoice: Equatable, Sendable {
+  public var target: DropTarget
+  /// Where the window would land: what the drop preview shows.
+  public var frame: CGRect
+  /// A point where a pointer would choose this target in a drag. The arrow keys start from here.
+  public var anchor: CGPoint
+
+  public init(target: DropTarget, frame: CGRect, anchor: CGPoint) {
+    self.target = target
+    self.frame = frame
+    self.anchor = anchor
+  }
+}
+
+/// The places a carried window can be put down in one view, and the way from one to the next.
+///
+/// The arrow keys move an imaginary pointer. It starts in the middle of the current choice's part of
+/// the screen and travels straight in the arrow's direction until `DropResolver` would choose something
+/// else, so a key pressed toward a window crosses it as a pointer would: its near edge, its
+/// middle, its far edge. What an arrow reaches is therefore what a drag that way would reach.
+public struct CarryMap: Sendable {
+  /// Its own place first, if that is in view; then windows and tiles in reading order, the edges
+  /// of the view, and the Desktop.
+  public private(set) var choices: [CarryChoice] = []
+  /// Which choice stands for each target. Two targets that lead to the same arrangement count as one;
+  /// the first stays.
+  private var standIns: [(target: DropTarget, choice: Int)] = []
+  /// For each choice, the choice each arrow key leads to, in the order of `Edge.allCases`.
+  private var links: [[Int?]] = []
+
+  private let window: WindowID
+  private let tree: LayoutTree
+  private let layout: Layout
+  private let gap: CGFloat
+  private let dropOptions: DropOptions
+  /// The window's leaf, if other tabs share it: the window can be put beside the rest of its group.
+  private let sharedLeaf: NodeID?
+
+  /// - Parameters:
+  ///   - workspace: the display's workspace. The window may be docked in it, float on it, or come
+  ///     from another display.
+  ///   - layout: what the display shows now.
+  ///   - floatingFrame: where the window would float if it were dropped on the Desktop.
+  ///   - terms: on what terms the drop will make room (F61), so that the previews do; nil if it will not.
+  public init(
+    carrying window: WindowID, in workspace: Workspace, layout: Layout, layoutOptions: LayoutOptions,
+    dropOptions: DropOptions = .init(), floatingFrame: CGRect?, isPresent: @escaping (WindowID) -> Bool,
+    minimumSize: @escaping (WindowID) -> CGSize? = { _ in nil }, makingRoom terms: MakeRoom.Terms? = nil
+  ) {
+    self.window = window
+    self.layout = layout
+    self.dropOptions = dropOptions
+    let tree = workspace.tree
+    self.tree = tree
+    gap = max(layoutOptions.gap, 0)
+    let ownLeaf = tree.leaf(containing: window)
+    let sharedLeaf = ownLeaf.flatMap { tree.windows(under: $0) == [window] ? nil : $0 }
+    self.sharedLeaf = sharedLeaf
+
+    // What is in view, in reading order, so that the result does not depend on dictionary order.
+    var places: [(node: NodeID, frame: CGRect)] = []
+    for (shown, frame) in layout.windowFrames {
+      if let leaf = tree.leaf(containing: shown) { places.append((leaf, frame)) }
+    }
+    for tile in layout.tiles where tile.node != tree.desktop { places.append((tile.node, tile.frame)) }
+    places.sort { ($0.frame.minY, $0.frame.minX, $0.node.rawValue) < ($1.frame.minY, $1.frame.minX, $1.node.rawValue) }
+
+    var found: [CarryChoice] = []
+    var stands: [(target: DropTarget, choice: Int)] = []
+    /// What each choice leads to, as far as anyone can see. Nil for floating, which is like nothing else.
+    var outcomes: [Layout.Look?] = []
+    func add(_ target: DropTarget, at anchor: CGPoint, outcome: Layout? = nil, landing: CGRect? = nil) {
+      let outcome =
+        outcome
+        ?? workspace.previewLayout(
+          for: window, at: target, in: layout.frame, options: layoutOptions, isPresent: isPresent,
+          minimumSize: minimumSize, makingRoom: terms)
+      guard let frame = landing ?? outcome?.place(of: window), frame.width > 0, frame.height > 0 else { return }
+      if let look = outcome?.look, let same = outcomes.firstIndex(of: look) {
+        stands.append((target, same))
+      } else {
+        stands.append((target, found.count))
+        found.append(CarryChoice(target: target, frame: frame, anchor: anchor))
+        outcomes.append(outcome?.look)
+      }
+    }
+
+    if let ownLeaf,
+      let own = layout.windowFrames[window] ?? layout.tiles.first(where: { $0.windows.contains(window) })?.frame
+        ?? (layout.hiddenWindows.contains(window) ? layout.nodeFrames[ownLeaf] : nil)
+    {
+      add(.none, at: own.center, outcome: layout, landing: own)
+    }
+    for place in places where place.node != ownLeaf || sharedLeaf != nil {
+      for edge in Edge.allCases {
+        add(.beside(place.node, edge), at: Self.anchor(beside: place.frame, edge, dropOptions))
+      }
+      if dropOptions.tabsEnabled, tree.isStack(place.node), place.node != ownLeaf {
+        add(.stack(place.node), at: place.frame.center)
+      }
+    }
+    let view = layout.frame
+    let band = max(dropOptions.screenEdgeBand, 0) / 2
+    add(.cameraEdge(.left), at: CGPoint(x: view.minX + band, y: view.midY))
+    add(.cameraEdge(.right), at: CGPoint(x: view.maxX - band, y: view.midY))
+    add(.cameraEdge(.top), at: CGPoint(x: view.midX, y: view.minY + band))
+    add(.cameraEdge(.bottom), at: CGPoint(x: view.midX, y: view.maxY - band))
+    if let desktop = layout.desktopFrame, let floatingFrame {
+      add(.float, at: desktop.center, landing: floatingFrame)
+    }
+    // A pointer cannot tell the Desktop's edges from the Desktop. The keyboard can.
+    if let desktop = layout.nodeFrames[tree.desktop] {
+      for edge in Edge.allCases {
+        add(.beside(tree.desktop, edge), at: Self.anchor(beside: desktop, edge, dropOptions))
+      }
+    }
+    choices = found
+    standIns = stands
+    links = found.map { choice in
+      Edge.allCases.map { edge in travel(from: choice, toward: edge).flatMap { found.firstIndex(of: $0) } }
+    }
+    connect()
+  }
+
+  /// The middle of the band along `edge` of `frame` in which a pointer docks beside it.
+  private static func anchor(beside frame: CGRect, _ edge: Edge, _ options: DropOptions) -> CGPoint {
+    let inset = min(max(options.windowEdgeFraction, 0.02), 0.5) / 2
+    switch edge {
+    case .left: return CGPoint(x: frame.minX + frame.width * inset, y: frame.midY)
+    case .right: return CGPoint(x: frame.maxX - frame.width * inset, y: frame.midY)
+    case .top: return CGPoint(x: frame.midX, y: frame.minY + frame.height * inset)
+    case .bottom: return CGPoint(x: frame.midX, y: frame.maxY - frame.height * inset)
+    }
+  }
+
+  /// The choice that stands for `target`, if it can be chosen in this view.
+  public func choice(for target: DropTarget) -> CarryChoice? {
+    standIns.first { $0.target == target }.map { choices[$0.choice] }
+  }
+
+  /// What a pointer at `point` chooses. Nil where there is nothing to choose: in a gap, in the
+  /// middle of a window that takes no tabs, outside the view.
+  public func choice(at point: CGPoint) -> CarryChoice? { target(at: point).flatMap(choice(for:)) }
+
+  /// The same, but nil where another part of the screen already stands for what a pointer would choose
+  /// here: the imaginary pointer passes over it instead of jumping there.
+  private func ownChoice(at point: CGPoint) -> CarryChoice? {
+    guard let target = target(at: point), let choice = choice(for: target), choice.target == target else {
+      return nil
+    }
+    return choice
+  }
+
+  private func target(at point: CGPoint) -> DropTarget? {
+    guard layout.frame.contains(point) else { return nil }
+    let target = DropResolver.resolve(
+      point: point, window: window, layout: layout, tree: tree, visibleFrame: layout.frame, options: dropOptions)
+    /// The edge of `frame` whose band `point` is in, or with `always` simply the nearest.
+    func edge(of frame: CGRect, always: Bool = false) -> Edge? {
+      guard frame.width > 0, frame.height > 0 else { return nil }
+      let fractions: [(Edge, CGFloat)] = [
+        (.left, (point.x - frame.minX) / frame.width), (.right, (frame.maxX - point.x) / frame.width),
+        (.top, (point.y - frame.minY) / frame.height), (.bottom, (frame.maxY - point.y) / frame.height),
+      ]
+      guard let nearest = fractions.min(by: { $0.1 < $1.1 }),
+        always || nearest.1 <= dropOptions.windowEdgeFraction
+      else { return nil }
+      return nearest.0
+    }
+    switch target {
+    case .float:
+      // A drag floats a window wherever it is let go. A carried one floats on the Desktop.
+      guard let desktop = layout.nodeFrames[tree.desktop], desktop.contains(point) else { return nil }
+      // Nothing can float on a Desktop that is only a tile.
+      let isTile = layout.desktopFrame == nil
+      return edge(of: desktop, always: isTile).map { .beside(tree.desktop, $0) } ?? .float
+    case .none:
+      guard let sharedLeaf, let frame = layout.nodeFrames[sharedLeaf] else { return DropTarget.none }
+      return edge(of: frame).map { .beside(sharedLeaf, $0) } ?? DropTarget.none
+    case .cameraEdge, .beside, .stack:
+      return target
+    }
+  }
+
+  /// The choice an arrow key goes to from `current`. Nil if nothing else lies that way.
+  public func next(from current: CarryChoice, toward direction: Edge) -> CarryChoice? {
+    guard let index = choices.firstIndex(of: current), let edge = Edge.allCases.firstIndex(of: direction) else {
+      return nil
+    }
+    return links[index][edge].map { choices[$0] }
+  }
+
+  /// What the imaginary pointer meets first on its way from `current`.
+  private func travel(from current: CarryChoice, toward direction: Edge) -> CarryChoice? {
+    let step: CGFloat = 4
+    let (dx, dy): (CGFloat, CGFloat)
+    switch direction {
+    case .left: (dx, dy) = (-step, 0)
+    case .right: (dx, dy) = (step, 0)
+    case .top: (dx, dy) = (0, -step)
+    case .bottom: (dx, dy) = (0, step)
+    }
+    // A pointer that travels along a gap (below the middle of a window that sits above two halves,
+    // say) meets nothing. It looks to both sides of the gap, the left or upper side first.
+    let aside = gap + 1
+    var point = current.anchor
+    while layout.frame.contains(point) {
+      point.x += dx
+      point.y += dy
+      if let hit = ownChoice(at: point) {
+        if hit != current { return hit }
+        continue
+      }
+      guard layout.leafOrTile(at: point, in: tree) == nil else { continue }
+      for offset in [-aside, aside] {
+        let beside = CGPoint(x: point.x + (dy != 0 ? offset : 0), y: point.y + (dx != 0 ? offset : 0))
+        if let hit = ownChoice(at: beside), hit != current { return hit }
+      }
+    }
+    return nil
+  }
+
+  /// Makes sure the arrow keys lead from every choice to every other. The pointer's travels nearly
+  /// always do. What they miss has no part of the screen to itself (the place of a window inside a
+  /// tile) or lies behind something that has none. Each such choice is put on the way out of the
+  /// nearest choice that is connected, in the direction it lies in: one more stop on that line.
+  private mutating func connect() {
+    guard choices.count > 1 else { return }
+    func reach(from start: Int) -> Set<Int> {
+      var seen: Set<Int> = [start]
+      var pending = [start]
+      while let index = pending.popLast() {
+        for case let next? in links[index] where seen.insert(next).inserted { pending.append(next) }
+      }
+      return seen
+    }
+    // The largest set of choices that all lead to each other.
+    let reaches = choices.indices.map(reach)
+    var connected: Set<Int> = []
+    for index in choices.indices where !connected.contains(index) {
+      let mutual = reaches[index].filter { reaches[$0].contains(index) }
+      if mutual.count > connected.count { connected = mutual }
+    }
+    for index in choices.indices where !connected.contains(index) {
+      let anchor = choices[index].anchor
+      func distance(_ other: Int) -> CGFloat {
+        let (x, y) = (choices[other].anchor.x - anchor.x, choices[other].anchor.y - anchor.y)
+        return x * x + y * y
+      }
+      guard let near = connected.min(by: { (distance($0), $0) < (distance($1), $1) }) else { return }
+      let (x, y) = (anchor.x - choices[near].anchor.x, anchor.y - choices[near].anchor.y)
+      let direction: Edge = abs(x) >= abs(y) ? (x >= 0 ? .right : .left) : (y >= 0 ? .bottom : .top)
+      guard let out = Edge.allCases.firstIndex(of: direction),
+        let back = Edge.allCases.firstIndex(of: direction.opposite)
+      else { return }
+      let beyond = links[near][out]
+      links[near][out] = index
+      links[index][out] = beyond
+      links[index][back] = near
+      if let beyond, links[beyond][back] == near { links[beyond][back] = index }
+      // Its other two keys may lead to choices that are not connected yet; those get their turn.
+      connected.insert(index)
+    }
+  }
+
+  /// The choice whose anchor is nearest to `point`.
+  public func nearest(to point: CGPoint) -> CarryChoice? { Self.nearest(to: point, among: choices) }
+
+  /// Where to go on when the view has changed and what was chosen is not in it any more: the edge of the new
+  /// view nearest to `point`, where the choice was on screen. An edge of the view puts the window into the
+  /// space being looked at, which is what someone who carries a window to a space means; the edge of a
+  /// window in it can mean the row that window belongs to, beyond the view.
+  public func arrival(from point: CGPoint) -> CarryChoice? {
+    let view = layout.frame
+    let middles: [(Edge, CGPoint)] = [
+      (.left, CGPoint(x: view.minX, y: view.midY)), (.right, CGPoint(x: view.maxX, y: view.midY)),
+      (.top, CGPoint(x: view.midX, y: view.minY)), (.bottom, CGPoint(x: view.midX, y: view.maxY)),
+    ]
+    func distance(_ middle: CGPoint) -> CGFloat {
+      (middle.x - point.x) * (middle.x - point.x) + (middle.y - point.y) * (middle.y - point.y)
+    }
+    for (edge, _) in middles.sorted(by: { distance($0.1) < distance($1.1) }) {
+      // Another target may stand for it, if it leads to the same arrangement.
+      if let choice = choice(for: .cameraEdge(edge)) { return choice }
+    }
+    return nearest(to: point)
+  }
+
+  private static func nearest(to point: CGPoint, among choices: [CarryChoice]) -> CarryChoice? {
+    func distance(_ choice: CarryChoice) -> CGFloat {
+      let (x, y) = (choice.anchor.x - point.x, choice.anchor.y - point.y)
+      return x * x + y * y
+    }
+    var best: CarryChoice?
+    for choice in choices where best == nil || distance(choice) < distance(best!) - 0.01 { best = choice }
+    return best
+  }
+}
