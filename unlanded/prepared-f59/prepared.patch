index 0000000..53aa735
--- /dev/null
+++ b/Tests/ArborCoreTests/CarryTests.swift
@@ -0,0 +1,370 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+private let screen = CGRect(x: 0, y: 25, width: 1440, height: 875)
+private let a = WindowID(1)
+private let b = WindowID(2)
+private let c = WindowID(3)
+private let d = WindowID(4)
+
+/// A small repeatable random number generator, so that a failure can be run again.
+private struct Dice {
+  var state: UInt64
+  mutating func roll(_ sides: Int) -> Int {
+    state = state &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
+    return Int((state >> 33) % UInt64(sides))
+  }
+}
+
+private func layout(_ workspace: Workspace, in frame: CGRect = screen, without gone: WindowID? = nil) -> Layout {
+  LayoutEngine.layout(workspace.tree, camera: workspace.camera, in: frame, isPresent: { $0 != gone })
+}
+
+private func map(
+  carrying window: WindowID, in workspace: Workspace, frame: CGRect = screen, tabs: Bool = false,
+  without gone: WindowID? = nil
+) -> CarryMap {
+  let shown = layout(workspace, in: frame, without: gone)
+  return CarryMap(
+    carrying: window, in: workspace, layout: shown, layoutOptions: LayoutOptions(),
+    dropOptions: DropOptions(tabsEnabled: tabs),
+    floatingFrame: shown.desktopFrame.map { CGRect(x: 0, y: 0, width: 500, height: 400).fitted(into: $0) },
+    isPresent: { $0 != gone })
+}
+
+/// [a | Desktop | b].
+private func desk() -> Workspace {
+  var workspace = Workspace()
+  workspace.dock(a, at: .cameraEdge(.left))
+  workspace.dock(b, at: .cameraEdge(.right))
+  return workspace
+}
+
+/// A random arrangement of up to nine windows, a random view of it, and a window to carry, which may
+/// be docked in it or not.
+private func randomCase(_ seed: Int) -> (workspace: Workspace, carried: WindowID, frame: CGRect, tabs: Bool, gone: WindowID) {
+  var dice = Dice(state: UInt64(seed))
+  let frame = [
+    screen, CGRect(x: 1440, y: 0, width: 1024, height: 768), CGRect(x: -2560, y: -200, width: 2560, height: 1440),
+    CGRect(x: 0, y: 0, width: 1080, height: 1920),
+  ][dice.roll(4)]
+  var workspace = Workspace()
+  let count = 1 + dice.roll(9)
+  for number in 1...count {
+    let nodes = workspace.tree.preorder()
+    let edge = Edge.allCases[dice.roll(4)]
+    workspace.dock(
+      WindowID(UInt32(number)), at: dice.roll(4) == 0 ? .cameraEdge(edge) : .beside(nodes[dice.roll(nodes.count)], edge))
+  }
+  let nodes = workspace.tree.preorder()
+  workspace.moveCamera(to: dice.roll(3) == 0 ? nodes[dice.roll(nodes.count)] : workspace.tree.root)
+  let carried = WindowID(UInt32(1 + dice.roll(count + 1)))
+  // Picking a window up steps the view out until it shows more than that window.
+  if workspace.camera == workspace.tree.leaf(containing: carried) { workspace.moveCamera(to: workspace.tree.root) }
+  let tabs = dice.roll(2) == 0
+  // One window may be minimized, but not the one in hand.
+  let gone = WindowID(UInt32(dice.roll(12)))
+  return (workspace, carried, frame, tabs, gone == carried ? WindowID(0) : gone)
+}
+
+@Suite struct CarryMapTests {
+  @Test func aFloatingWindowCanGoWhereverADragCouldPutIt() {
+    let workspace = desk()
+    let targets = map(carrying: c, in: workspace).choices.map(\.target)
+    let (leafA, leafB) = (workspace.tree.leaf(containing: a)!, workspace.tree.leaf(containing: b)!)
+    for edge in Edge.allCases {
+      #expect(targets.contains(.beside(leafA, edge)))
+      #expect(targets.contains(.beside(leafB, edge)))
+      #expect(targets.contains(.cameraEdge(edge)))
+      #expect(targets.contains(.beside(workspace.tree.desktop, edge)), "the keyboard can tell the Desktop's edges")
+    }
+    #expect(targets.contains(.float))
+    #expect(!targets.contains(DropTarget.none), "it has no slot to go back to")
+    #expect(!targets.contains(.stack(leafA)), "no tabs unless they are on")
+    #expect(map(carrying: c, in: workspace, tabs: true).choices.map(\.target).contains(.stack(leafA)))
+  }
+
+  @Test func aDockedWindowsOwnPlaceComesFirstAndItsOwnEdgesAreNotOffered() {
+    let workspace = desk()
+    let found = map(carrying: a, in: workspace)
+    #expect(found.choices.first?.target == DropTarget.none)
+    #expect(found.choices.first?.frame == layout(workspace).windowFrames[a])
+    let own = workspace.tree.leaf(containing: a)!
+    #expect(!found.choices.contains { $0.target == .beside(own, .left) || $0.target == .stack(own) })
+  }
+
+  @Test func everyChoiceShowsTheFrameTheDropWouldGive() {
+    for seed in 1...40 {
+      let (workspace, carried, frame, tabs, gone) = randomCase(seed)
+      for choice in map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone).choices {
+        var dropped = workspace
+        guard dropped.dock(carried, at: choice.target) else { continue }
+        let result = LayoutEngine.layout(
+          dropped.tree, camera: dropped.camera, in: frame, isPresent: { $0 == carried || $0 != gone })
+        let landed = result.windowFrames[carried] ?? result.tiles.first { $0.windows.contains(carried) }?.frame
+        #expect(landed == choice.frame, "seed \(seed): \(choice.target)")
+      }
+    }
+  }
+
+  @Test func noTwoChoicesLeadToTheSameArrangement() {
+    for seed in 1...40 {
+      let (workspace, carried, frame, tabs, gone) = randomCase(seed)
+      let choices = map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone).choices
+      let outcomes = choices.map { choice -> Layout? in
+        workspace.previewLayout(
+          for: carried, at: choice.target, in: frame, options: LayoutOptions(), isPresent: { $0 != gone })
+      }
+      for (index, outcome) in outcomes.enumerated() {
+        guard let outcome else { continue }
+        for case let other? in outcomes.dropFirst(index + 1) {
+          #expect(outcome.look != other.look, "seed \(seed): \(choices[index].target)")
+        }
+      }
+    }
+  }
+
+  @Test func aPointerAtAChoicesAnchorWouldChooseIt() {
+    for seed in 1...40 {
+      let (workspace, carried, frame, tabs, gone) = randomCase(seed)
+      let found = map(carrying: carried, in: workspace, frame: frame, tabs: tabs, without: gone)
+      let shown = layout(workspace, in: frame, without: gone)
+      for choice in found.choices {
+        // A window inside a group's tile has no part of the screen to itself.
+        if choice.target == DropTarget.none, shown.windowFrames[carried] == nil { continue }
+        #expect(found.choice(at: choice.anchor) == choice, "seed \(seed): \(choice.target)")
+        if case .beside(workspace.tree.desktop, _) = choice.target { continue }
+        let dragged = DropResolver.resolve(
+          point: choice.anchor, window: carried, layout: shown, tree: workspace.tree, visibleFrame: frame,
+          options: DropOptions(tabsEnabled: tabs))
+        #expect(dragged == choice.target, "seed \(seed)")
+      }
+    }
+  }
+
+  // MARK: The arrow keys
+
+  @Test func anArrowCrossesAWindowAsAPointerWould() {
+    let workspace = desk()
+    let found = map(carrying: c, in: workspace, tabs: true)
+    let leaf = workspace.tree.leaf(containing: b)!
+    var choice = found.choice(for: .float)!
+    var passed: [DropTarget] = []
+    while let next = found.next(from: choice, toward: .right) {
+      passed.append(next.target)
+      choice = next
+    }
+    #expect(
+      passed == [
+        .beside(workspace.tree.desktop, .right), .beside(leaf, .left), .stack(leaf), .beside(leaf, .right),
+        .cameraEdge(.right),
+      ])
+  }
+
+  @Test func withoutTabsTheMiddleOfAWindowIsPassedOver() {
+    let workspace = desk()
+    let found = map(carrying: c, in: workspace)
+    let leaf = workspace.tree.leaf(containing: b)!
+    #expect(found.next(from: found.choice(for: .beside(leaf, .left))!, toward: .right)?.target == .beside(leaf, .right))
+  }
+
+  @Test func upAndDownReachAWindowsTopAndBottom() {
+    let workspace = desk()
+    let found = map(carrying: c, in: workspace)
+    let leaf = workspace.tree.leaf(containing: b)!
+    let left = found.choice(for: .beside(leaf, .left))!
+    #expect(found.next(from: left, toward: .top)?.target == .beside(leaf, .top))
+    #expect(found.next(from: left, toward: .bottom)?.target == .beside(leaf, .bottom))
+    #expect(found.next(from: found.choice(for: .beside(leaf, .top))!, toward: .top)?.target == .cameraEdge(.top))
+  }
+
+  @Test func nothingLiesBeyondTheEdgeOfTheView() {
+    let found = map(carrying: c, in: desk())
+    #expect(found.next(from: found.choice(for: .cameraEdge(.left))!, toward: .left) == nil)
+    #expect(found.next(from: found.choice(for: .cameraEdge(.bottom))!, toward: .bottom) == nil)
+  }
+
+  @Test func aPointerTravellingAlongAGapLooksToItsSides() {
+    // a over [b | c]: straight down from the middle of a runs the gap between b and c.
+    var workspace = Workspace()
+    workspace.dock(b, at: .cameraEdge(.left))
+    let leafB = workspace.tree.leaf(containing: b)!
+    workspace.dock(a, at: .beside(leafB, .top))
+    workspace.dock(c, at: .beside(leafB, .right))
+    workspace.moveCamera(to: workspace.tree.parent(of: workspace.tree.leaf(containing: a)!)!)
+    let found = map(carrying: d, in: workspace)
+    let under = found.choice(for: .beside(workspace.tree.leaf(containing: a)!, .bottom))!
+    #expect(found.next(from: under, toward: .bottom)?.target == .beside(leafB, .top), "the left one first")
+  }
+
+  @Test func aDesktopThatIsOnlyATileStillHasEdgesAndLetsThePointerBy() {
+    var workspace = Workspace()
+    for window in [a, b, c] { workspace.dock(window, at: .cameraEdge(.left)) }
+    let seamed = layout(workspace)
+    let last = seamed.seams.last!
+    workspace.tree.moveBoundary(
+      leading: last.leading, trailing: last.trailing, by: 250, pointsPerWeight: Double(last.pointsPerWeight))
+    #expect(layout(workspace).desktopFrame == nil)
