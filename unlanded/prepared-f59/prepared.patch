+  /// A random arrangement of `count` windows, made with commands, the same for the same seed.
+  func randomHarness(seed: Int, tabs: Bool) -> (Harness, [WindowID]) {
+    var dice = Dice(state: UInt64(seed))
+    let h = Harness(settings: settings { $0.tabsEnabled = tabs })
+    let windows = (0..<(3 + dice.roll(4))).map { number in
+      h.system.open(app: "App\(number)", frame: CGRect(x: 200 + 30 * number, y: 150 + 20 * number, width: 500, height: 380))
+    }
+    h.start()
+    let edges = ["left", "right", "top", "bottom"]
+    for (index, window) in windows.enumerated() where index == 0 || dice.roll(5) > 0 {
+      if index > 0, dice.roll(2) == 0, let other = h.workspace.tree.allWindows.randomElement(using: &dice) {
+        h.run("dock \(window.rawValue) beside \(other.rawValue) \(edges[dice.roll(4)])")
+      } else {
+        h.run("dock \(window.rawValue) \(edges[dice.roll(4)])")
+      }
+    }
+    h.run("show-all")
+    h.scheduler.runPending()
+    return (h, windows)
+  }
