+
+  nonisolated static let waysOut = ["quit", "pause", "float-all"]
+
+  private func leave(_ h: Harness, by way: String) {
+    if way == "quit" { h.controller.shutdown() } else { #expect(h.run(way).ok, "\(way)") }
+    letTimePass(h)
