+    let message = h.system.open(app: "Mail", frame: beside)
+    letTimePass(h)
+    #expect(moves(of: message, h).count == 1, "\(h.system.frameLog)")
+    #expect(h.visibleFrame.contains(h.frame(message)!), "\(h.frame(message)!)")
+  }
