+++ b/Sources/ArborTesting/ChaosInvariants+Undone.swift
@@ -0,0 +1,14 @@
+import ArborCore
+import ArborKit
+
+/// "A person's ⌘M is never undone" (collab/QUESTIONS.md). The stand-in plays what a Mac does to a window that is asked to take the keyboard on its way
+/// to the Dock: it comes straight back out (`FakeWindowSystem.land`). Whoever asks, on whichever road, this net sees what came of it.
+extension ChaosRunner {
+  func undoneViolations(after action: ChaosAction) -> [InvariantViolation] {
+    guard case .minimize(let window, true) = action, let fake = system.windows[window] else { return [] }
+    // Counted where it could have gone wrong: Arbor was looking.
+    if isRunning { Self.questionsAsked["undone", default: 0] += 1 }
+    guard !fake.snapshot.isMinimized else { return [] }
+    return [.init("minimize-undone", "its user minimized \(window), and it is back out of the Dock: somebody asked it to take the keyboard on its way there")]
+  }
+}
