diff --git a/Sources/ArborKit/Controller/Controller+TheScreensAnswer.swift b/Sources/ArborKit/Controller/Controller+TheScreensAnswer.swift
new file mode 100644
index 0000000..c16db81
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+TheScreensAnswer.swift
@@ -0,0 +1,77 @@
+import ArborCore
+import CoreGraphics
+
+/// The screen's answer is not the window's.
+///
+/// A call that sets a window's size makes it grow no further than to the bottom of the visible frame (less a point above a Dock) and the
+/// right edge of its display, from where it stands at that moment; with its bottom in the Dock's strip it does not grow at all. A call that
+/// sets its position is not held back so. (Recordings and a probe of bare calls on hosted Macs, macOS 26; real apps alike.) So a window
+/// cannot grow into a frame that hangs over such a line once it stands there, and what it answers is the room there was: 400×319 for a
+/// window of 400×600, let go low on the display. Written down as its own size, that is what it got back from then on.
+///
+/// A frame is set with three calls, size, position, size (`FramePlan`), so one request will do wherever the size fits at either end of the
+/// way. Where it fits at neither, the window is **sized where the size fits, and then only moved**.
+extension Controller {
+  /// Gives `window` the frame it is to have, which may hang over an edge of its display: what a hand left there, or its own size at the
+  /// place where a hand let go of it. Returns what it has afterwards, or nil if its app does not answer.
+  ///
+  /// For a frame that lies on the screen this is `setFrame`. A docked window's slot does, and `place` sees to its own.
+  func give(_ frame: CGRect, to window: WindowID) -> CGRect? {
+    guard let standing = windows[window]?.frame, let place = whereItHasToBeSized(for: frame, from: standing) else {
+      return system.setFrame(frame, of: window)
+    }
+    guard let sized = system.setFrame(CGRect(origin: place, size: frame.size), of: window) else { return nil }
+    windows[window]?.frame = sized
+    // At the size it took: short of what was asked where there was room for it, that is its app's answer.
+    return system.setFrame(CGRect(origin: frame.origin, size: sized.size), of: window) ?? sized
+  }
+
+  /// What to write down as a window's own frame when it was asked for `frame` and has `actual`. A side that fell short where the screen may
+  /// have stopped it (there was no place to size it in, or the Dock has moved) is not the window's: it keeps the size it was asked for.
+  /// Each side by itself, and by as little as the point that a window as high as the visible frame falls short above a Dock.
+  func ownFrame(of actual: CGRect, askedFor frame: CGRect) -> CGRect {
+    func isTheScreens(_ took: CGSize) -> Bool {
+      mayHaveBeenStoppedByTheScreen(took, shortOf: frame.size, at: actual.origin, byMoreThan: 0)
+    }
+    return CGRect(
+      origin: actual.origin,
+      size: CGSize(
+        width: isTheScreens(CGSize(width: actual.width, height: frame.height)) ? frame.width : actual.width,
+        height: isTheScreens(CGSize(width: frame.width, height: actual.height)) ? frame.height : actual.height))
+  }
+
+  /// How far above a Dock a size has to end to count as fitting. Growth stops a point above it, and it is as high as it is at that moment,
+  /// whatever Arbor has been told: it was seen to change by two points as a window went into it, a third of a second before the news
+  /// came. The edges of the display itself are where they are, and growth goes all the way to them.
+  static let clearOfTheDock: CGFloat = 4
+
+  /// How far down and to the right a window on `display` can be made to grow.
+  private func lines(of display: DisplaySnapshot) -> (right: CGFloat, bottom: CGFloat) {
+    let visible = display.visibleFrame
+    return (display.frame.maxX, visible.maxY < display.frame.maxY ? visible.maxY - Self.clearOfTheDock : visible.maxY)
+  }
+
+  /// Where a window that stands at `standing` has to go to be given the size of `frame`, before it is moved there. Nil if it need not go
+  /// anywhere for that, or if there is no such place: as near to where it is going as the size fits, so straight above it or beside it.
+  func whereItHasToBeSized(for frame: CGRect, from standing: CGRect) -> CGPoint? {
+    // Each side by itself: the first call may see to the one and the last to the other.
+    let (here, there) = (canGrow(from: standing.size, to: frame.size, at: standing.origin), canGrow(from: standing.size, to: frame.size, at: frame.origin))
+    let (wide, high) = (here.wide || there.wide, here.high || there.high)
+    guard !wide || !high, let display = stopper(of: frame.origin) else { return nil }
+    let place = CGPoint(
+      x: wide ? frame.minX : min(frame.minX, lines(of: display).right - frame.width),
+      y: high ? frame.minY : min(frame.minY, lines(of: display).bottom - frame.height))
+    return place.y >= display.visibleFrame.minY && stopper(of: place)?.id == display.id ? place : nil
+  }
+
+  /// Whether macOS lets a window of size `has`, with its corner at `origin`, become as wide and as high as `size`. A side that is off the
+  /// display already is free.
+  private func canGrow(from has: CGSize, to size: CGSize, at origin: CGPoint) -> (wide: Bool, high: Bool) {
+    guard let display = stopper(of: origin) else { return (true, true) }
+    let lines = lines(of: display)
+    return (
+      size.width <= has.width + 1 || origin.x + has.width > display.frame.maxX || origin.x + size.width <= lines.right,
+      size.height <= has.height + 1 || origin.y + has.height > display.frame.maxY || origin.y + size.height <= lines.bottom
+    )
+  }
+}
