diff --git a/Tests/ArborKitTests/InTheHandTests.swift b/Tests/ArborKitTests/InTheHandTests.swift
new file mode 100644
index 00000000..983dca03
--- /dev/null
+++ b/Tests/ArborKitTests/InTheHandTests.swift
@@ -0,0 +1,115 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// A docked window gets its own size in the hand, as it leaves its slot (Controller+InTheHand.swift): a size, once, and never a place.
+@Suite @MainActor struct InTheHandTests {
+  /// `window`, whose own frame is `own`, docked on the left of the display of the recordings, in a slot 12,43 325×650, with another at the right.
+  func desk(own: CGRect) throws -> (h: Harness, window: WindowID, slot: CGRect) {
+    let h = Harness(displays: [TheScreensAnswerTests.withADock])
+    let other = h.system.open(app: "Other", frame: CGRect(x: 600, y: 100, width: 380, height: 348))
+    let window = h.system.open(app: "Mine", frame: own)
+    h.start()
+    h.system.tiling = .off
+    h.run("dock \(window.rawValue) left")
+    h.run("dock \(other.rawValue) right")
+    let slot = try #require(h.layout?.windowFrames[window])
+    try #require(h.frame(window) == slot)
+    return (h, window, slot)
+  }
+
+  func asked(_ h: Harness, of window: WindowID, since mark: Int) -> [FakeWindowSystem.Move] {
+    h.system.moveLog[mark...].filter { $0.window == window }
+  }
+
+  /// The fake's hand takes hold in the middle of the title bar.
+  func hold(_ slot: CGRect) -> CGPoint { CGPoint(x: slot.midX, y: slot.minY + 10) }
+
+  @Test func asItLeavesItsSlotItHasItsOwnSizeAndTheDropIsADropAndNothingMore() throws {
+    let (h, window, slot) = try desk(own: CGRect(x: 300, y: 100, width: 400, height: 300))
+    let (from, mark) = (hold(slot), h.system.moveLog.count)
+    h.system.beginDrag(window, at: from)
+    h.system.moveDrag(to: CGPoint(x: from.x + 30, y: from.y + 10))
+    let inTheHand = asked(h, of: window, since: mark)
+    #expect(inTheHand.count == 1 && inTheHand.allSatisfy(\.sizeOnly), "a size, once, and no place: \(inTheHand)")
+    #expect(h.frame(window) == CGRect(x: slot.minX + 30, y: slot.minY + 10, width: 400, height: 300), "its corner stays with the hand: \(h.frame(window) as Any)")
+    h.system.moveDrag(to: CGPoint(x: 640, y: 300))
+    h.system.moveDrag(to: CGPoint(x: 660, y: 320), holding: 1)
+    let carried = try #require(h.frame(window))
+    h.system.endDrag()
+    #expect(asked(h, of: window, since: mark).count == 1, "nothing more on the way, and nothing at the drop: \(asked(h, of: window, since: mark))")
+    #expect(h.workspace.isFloating(window) && h.frame(window) == carried && h.workspace.floating[window] == carried)
+  }
+
+  @Test func aSlipOfTheHandAsksNothing() throws {
+    let (h, window, slot) = try desk(own: CGRect(x: 300, y: 100, width: 400, height: 300))
+    let (from, mark) = (hold(slot), h.system.moveLog.count)
+    h.system.beginDrag(window, at: from)
+    h.system.moveDrag(to: CGPoint(x: from.x + 16, y: from.y + 16))
+    #expect(asked(h, of: window, since: mark).isEmpty, "23 points")
+    h.system.moveDrag(to: CGPoint(x: from.x + 17, y: from.y + 17))
+    #expect(asked(h, of: window, since: mark).count == 1, "24")
+    h.system.loseTheReleaseOfTheDrag()
+  }
+
+  /// Narrower than where it is held, it would shrink away from under the pointer and follow it from afar (seen on a Mac: 496 points off).
+  @Test func whereItWouldNotStayUnderTheHandItIsSizedAtTheDrop() throws {
+    let (h, window, slot) = try desk(own: CGRect(x: 300, y: 100, width: 180, height: 300))
+    let (from, mark) = (hold(slot), h.system.moveLog.count)
+    h.system.beginDrag(window, at: from)
+    h.system.moveDrag(to: CGPoint(x: 600, y: 300))
+    h.system.moveDrag(to: CGPoint(x: 660, y: 320), holding: 1)
+    #expect(asked(h, of: window, since: mark).isEmpty, "162 along a title bar that would be 180 long: 18 left")
+    #expect(h.frame(window)?.size == slot.size)
+    h.system.endDrag()
+    let frame = try #require(h.frame(window))
+    #expect(frame.size == CGSize(width: 180, height: 300))
+    #expect(abs((660 - frame.minX) / frame.width - 0.5) < 0.01, "the pointer as far along its title bar as it held the tile: \(frame)")
+  }
+
+  /// Out of a low slot the screen cuts it in the hand as at rest (300 for 600 on a Mac). Not written down; asked once more at the drop.
+  @Test func cutInTheHandItIsAskedOnceMoreAtTheDrop() throws {
+    let h = Harness(displays: [TheScreensAnswerTests.withADock])
+    let a = h.system.open(app: "A", frame: CGRect(x: 170, y: 100, width: 480, height: 348))
+    let tall = h.system.open(app: "Tall", frame: CGRect(x: 300, y: 60, width: 400, height: 600))
+    h.start()
+    h.system.tiling = .off
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(tall.rawValue) beside \(a.rawValue) bottom")
+    let slot = try #require(h.frame(tall))
+    let (from, mark) = (hold(slot), h.system.moveLog.count)
+    h.system.beginDrag(tall, at: from)
+    h.system.moveDrag(to: CGPoint(x: from.x + 200, y: from.y + 10))
+    let inTheHand = asked(h, of: tall, since: mark)
+    #expect(inTheHand.count == 1 && inTheHand[0].sizeOnly && inTheHand[0].after.height < 600, "the case: \(inTheHand)")
+    h.system.moveDrag(to: CGPoint(x: 760, y: 414), holding: 1)
+    #expect(asked(h, of: tall, since: mark).count == 1, "nobody chases the hand with calls")
+    h.system.endDrag()
+    #expect(h.frame(tall)?.size == CGSize(width: 400, height: 600), "\(asked(h, of: tall, since: mark).map(\.after))")
+    #expect(h.workspace.floating[tall]?.size == CGSize(width: 400, height: 600))
+  }
+
+  /// Let go where nothing is dropped, or the drag given up: back into its slot, at the slot's size.
+  @Test func aDragThatComesToNothingPutsItBackIntoItsSlot() throws {
+    let (h, window, slot) = try desk(own: CGRect(x: 300, y: 100, width: 400, height: 300))
+    h.system.beginDrag(window, at: hold(slot))
+    h.system.moveDrag(to: CGPoint(x: 500, y: 300))
+    try #require(h.frame(window)?.size == CGSize(width: 400, height: 300))
+    h.system.loseTheReleaseOfTheDrag()
+    h.scheduler.advance(by: 2)
+    #expect(h.workspace.isDocked(window) && h.frame(window) == slot, "\(h.frame(window) as Any)")
+    h.run("float \(window.rawValue)")
+    #expect(h.frame(window)?.size == CGSize(width: 400, height: 300), "and its own size is still its own")
+  }
+
+  /// A floating window is nobody's but its person's: nothing is asked of it in the hand.
+  @Test func aFloatingWindowIsAskedNothing() throws {
+    let (h, _, _) = try desk(own: CGRect(x: 300, y: 100, width: 400, height: 300))
+    let floating = h.system.open(app: "Floats", frame: CGRect(x: 350, y: 200, width: 300, height: 200))
+    let mark = h.system.moveLog.count
+    h.system.drag(floating, through: [CGPoint(x: 500, y: 210), CGPoint(x: 560, y: 300), CGPoint(x: 600, y: 340)])
+    #expect(asked(h, of: floating, since: mark).isEmpty)
+  }
+}
