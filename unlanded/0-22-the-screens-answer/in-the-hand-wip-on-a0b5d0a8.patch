diff --git a/Sources/ArborKit/Controller/Controller+InTheHand.swift b/Sources/ArborKit/Controller/Controller+InTheHand.swift
new file mode 100644
index 00000000..bfe51841
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+InTheHand.swift
@@ -0,0 +1,46 @@
+import ArborCore
+import CoreGraphics
+
+/// Its own size in the hand.
+///
+/// A docked window that is dragged out of its slot has the shape of the slot, and used to keep it until it was let go: a column carried
+/// across the screen that turned into a window at the drop. macOS's own tiles get their size back in the hand, as they leave their place, and
+/// so does a docked window now: **the moment it has left its slot it is asked for its own size, once. Never for a place: that is the
+/// hand's. The drop is a drop and nothing more.**
+///
+/// What a Mac makes of a size set during a drag was measured first (a hosted Mac, macOS 26, 60 calls with the button down, a test window and
+/// TextEdit): it is taken as at rest, the window's corner stays where it is, the window goes on following the pointer at the distance it
+/// had, and the release is a release. So a window that becomes narrower than the point it is held at shrinks away from under the
+/// pointer, and follows it from afar. Hence the one condition.
+extension Controller {
+  /// How far the pointer carries a docked window before it has left its slot. Less is a slip of the hand.
+  static let slipOfTheHand: CGFloat = 24
+
+  /// How much of the title bar has to be left to the right of the pointer once the window has its own width.
+  static let leftUnderTheHand: CGFloat = 24
+
+  /// Called with every move of a drag.
+  func giveItsOwnSizeInTheHand() {
+    guard let session = drag, !session.wasAskedInTheHand, let home = session.sourceDisplay,
+      workspaces[home]?.isDocked(session.window) == true, let hold = session.hold,
+      hypot(session.point.x - hold.at.x, session.point.y - hold.at.y) >= Self.slipOfTheHand,
+      let has = windows[session.window]?.frame,
+      var own = session.sizeOwed ?? frameToTakeAlong(of: session.window, from: home, ifDocked: true)?.size
+    else { return }
+    drag?.wasAskedInTheHand = true
+    // It may be carried over a smaller display than the one it floated on.
+    if let room = displayID(at: session.point).flatMap({ display($0) })?.visibleFrame.size {
+      own = CGSize(width: min(own.width, room.width), height: min(own.height, room.height))
+    }
+    guard abs(own.width - has.width) > 1 || abs(own.height - has.height) > 1 else { return }
+    // It stays under the hand. Where it would not, it carries the shape of its slot until it is let go, and is then placed with the
+    // pointer as far along its title bar as it held the tile (`droppedFrame`): dull, not wrong.
+    guard hold.alongTheTitleBar <= own.width - Self.leftUnderTheHand else { return }
+    guard let actual = system.setSize(own, of: session.window) else { return }
+    windows[session.window]?.frame = actual
+    Log.debug("\(session.window) has left its slot and took its own size in the hand, \(Int(actual.width))×\(Int(actual.height))")
+    // Out of a low slot the screen cuts it in the hand as it would at rest. That is not its size: it is asked once more when it is let
+    // go, wherever that is (`give`). Nobody chases the hand with calls meanwhile.
+    drag?.sizeOwed = ownFrame(of: actual, askedFor: own).size == actual.size ? nil : own
+  }
+}
