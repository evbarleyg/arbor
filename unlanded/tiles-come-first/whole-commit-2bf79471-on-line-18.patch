diff --git a/Sources/ArborKit/Controller/Controller+InOnePiece.swift b/Sources/ArborKit/Controller/Controller+InOnePiece.swift
new file mode 100644
index 00000000..9a434e74
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+InOnePiece.swift
@@ -0,0 +1,35 @@
+import ArborCore
+import CoreGraphics
+
+/// At once, and in one piece (collab/BOARD.md, 0.18).
+///
+/// Windows are asked one after another, and without motion a display shows every state in between. So the order is chosen for what is to
+/// be seen on the way: ground that windows cover before and after is not bare meanwhile. What arrives or grows comes first, over what is
+/// still there; what shrinks comes next, and uncovers what has arrived; what leaves goes last, from behind what has grown. Within one
+/// window the same holds of size and place (`FramePlan`).
+///
+/// `apply` asks in this order and `movesInSight` foretells in it. A window system that moves windows together keeps the order within an app;
+/// apps work side by side, which shortens what is bare where windows cross to the slowest answer. So the one order that must hold between
+/// apps is kept by two forecasts: those who stay, and, when they have their frames, those who leave (`leavesInSight`).
+extension Controller {
+  /// No empty desk: what stands in for a window is on the display before the window leaves. Tiles lie behind every window, so they are put up
+  /// unseen, and the windows leave from on top of them. Called by `relayout` before anything is foretold or moved. Not with a stage up, which
+  /// covers all this and lifts on the tiles; and only for tiles that are not there yet, since every update moves and orders panels.
+  func tilesComeFirst(in layout: Layout, on displayID: DisplayID, behindAStage: Bool) {
+    guard !behindAStage, !layout.tiles.isEmpty, layout.tiles != tilesPutUp[displayID] else { return }
+    tilesPutUp[displayID] = layout.tiles
+    overlays.update(display: displayID, scene: overlayScene(for: layout, on: displayID))
+  }
+
+  /// The docked windows a layout shows, with their slots, in the order in which they are asked.
+  func inOnePiece(_ slots: [WindowID: CGRect]) -> [(window: WindowID, slot: CGRect)] {
+    func turn(_ window: WindowID, _ slot: CGRect) -> Int {
+      // Out of view, it arrives.
+      guard let frame = windows[window]?.frame, !parked.contains(window) else { return 0 }
+      if slot.insetBy(dx: -1, dy: -1).contains(frame) { return 0 }
+      return frame.insetBy(dx: -1, dy: -1).contains(slot) ? 2 : 1
+    }
+    return slots.map { (window: $0.key, slot: $0.value, turn: turn($0.key, $0.value)) }
+      .sorted { ($0.turn, $0.window) < ($1.turn, $1.window) }.map { ($0.window, $0.slot) }
+  }
+}
