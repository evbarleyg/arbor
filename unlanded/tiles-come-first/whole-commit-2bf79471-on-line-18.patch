+/// No empty desk: filmed, a dock that turned every window into a tile left nothing at all on the display for half a second, and then tiles faded in.
+@MainActor
+@Suite struct NoEmptyDeskTests {
+  /// Four windows side by side, and a least width that none of their slots will have once there is a fourth.
+  private func threeDockedAndAFourth(_ settings: Settings) -> (Harness, [WindowID]) {
+    var settings = settings
+    settings.minimumUsableWidth = 300
+    let h = Harness(settings: settings)
+    let windows = (0..<4).map { index in
+      h.system.open(app: "App\(index + 1)", pid: Int32(1001 + index), frame: CGRect(x: 120 + 40 * CGFloat(index), y: 90, width: 520, height: 380))
+    }
+    h.start()
+    for window in windows.dropLast() { h.run("dock \(window.rawValue) right") }
+    #expect(h.layout?.tiles.isEmpty == true)
+    return (h, windows)
+  }
+
+  @Test func aTileIsThereBeforeItsWindowLeaves() {
+    let (h, windows) = threeDockedAndAFourth(light)
+    // At the moment a window is sent out of view, is what stands in for it on the display already?
+    var left: [WindowID: Bool] = [:]
+    h.system.willSetFrame = { window, frame in
+      guard !h.system.displayList.contains(where: { frame.fractionInside($0.frame) > 0.5 }), left[window] == nil else { return }
+      left[window] = h.overlays.tiles[h.display]?.contains { $0.items.contains { $0.window == window } } == true
+    }
+    h.run("dock \(windows[3].rawValue) right")
+    h.system.willSetFrame = nil
+    #expect(h.layout?.tiles.isEmpty == false)
+    #expect(!left.isEmpty)
+    for (window, tileWasThere) in left.sorted(by: { $0.key < $1.key }) {
+      #expect(tileWasThere, "\(window) left before its tile was there")
+    }
+  }
+
+  /// Every update moves and orders a panel per tile. Tiles that are there are not put up again: a layout that keeps them costs what it cost.
+  @Test func tilesThatAreThereAreNotPutUpAgain() {
+    let (h, windows) = threeDockedAndAFourth(light)
+    h.run("dock \(windows[3].rawValue) right")
+    let tiles = h.layout?.tiles
+    #expect(tiles?.isEmpty == false)
+    let budget = h.measure { h.run("show-all") }
+    #expect(h.layout?.tiles == tiles, "the story: everything shows already, so no tile changes")
+    #expect(budget.overlayUpdates == 1, "laid out again, and one update as ever: \(budget)")
+  }
+
+  /// With motion a stage covers the road and lifts on the tiles: nothing is put up behind it beforehand.
+  @Test func behindAStageNothingIsPutUpFirst() {
+    var moving = light
+    moving.animationDuration = 0.46
+    let (h, windows) = threeDockedAndAFourth(moving)
+    var calls: [String] = []
+    h.overlays.onCall = { call in
+      switch call {
+      case .update(_, let scene) where !scene.tiles.isEmpty: calls.append("tiles")
+      case .animate: calls.append("stage")
+      default: break
+      }
+    }
+    h.run("dock \(windows[3].rawValue) right")
+    h.overlays.onCall = nil
+    #expect(calls == ["stage", "tiles"], "the stage goes up, and the tiles are put up once, for when it lifts")
+  }
+
+  @Test func withoutMotionATileDoesNotFade() {
+    let (h, windows) = threeDockedAndAFourth(light)
+    h.run("dock \(windows[3].rawValue) right")
+    #expect(h.overlays.scenes[h.display]?.tiles.isEmpty == false)
+    #expect(h.overlays.scenes[h.display]?.tileFade == 0)
+  }
+
+  @Test func withMotionItFadesAsItDid() {
+    var moving = light
+    moving.animationDuration = 0.46
+    let (h, windows) = threeDockedAndAFourth(moving)
+    h.run("dock \(windows[3].rawValue) right")
+    #expect(h.overlays.scenes[h.display]?.tileFade == 0.2)
+  }
+}
