+
+  # How far the stand-ins are from a real Mac: the same script on both, compared step by step (docs/TESTING.md, "Reality"). The number, and every
+  # divergence that collab/evidence/reality-known.txt does not have or has and is gone, come out as annotations.
+  reality:
+    needs: [real-windows, linux]
+    # Whenever a Mac ran, even if one of its checks or a test on Linux failed: both halves are written down before those.
+    if: ${{ !cancelled() && needs.real-windows.result != 'skipped' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v5
+      - uses: actions/download-artifact@v4
+        with:
+          name: reality-mac
+          path: reality/mac
+      - uses: actions/download-artifact@v4
+        with:
+          name: reality-linux
+          path: reality/linux
+      - name: The Mac against the rehearsal
+        run: >-
+          ./scripts/ci-step.py --summary '^reality:' reality
+          python3 scripts/reality-diff.py reality/mac reality/linux
+          --known collab/evidence/reality-known.txt --check --markdown "$GITHUB_STEP_SUMMARY"
