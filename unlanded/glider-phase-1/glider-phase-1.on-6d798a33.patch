@@ -0,0 +1,140 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+private let a = WindowID(101)
+private let b = WindowID(102)
+
+/// The walks with the glider in them (`ChaosInvariants+Glider.swift`): a glide breaks no rule, the exemption is no wider than the rule says, and what
+/// pays for it is watched. Each net has its control, as in `ChaosSevenRulesTests`.
+@Suite @MainActor struct ChaosGliderTests {
+  private let desk = [
+    "settings {\"windowPictures\":true}", "launch", "open 101 Notes pid 1001 at 100 100 500 400", "open 102 Mail pid 1002 at 800 300 500 400", "settle",
+    "focus 101", "react",
+  ]
+
+  private func rect(_ x: CGFloat, _ y: CGFloat, _ width: CGFloat, _ height: CGFloat) -> CGRect { CGRect(x: x, y: y, width: width, height: height) }
+
+  /// Plays `lines` and returns the rules each broke.
+  private func play(_ lines: [String], on runner: ChaosRunner = ChaosRunner()) -> [[String]] {
+    lines.map { runner.step(ChaosAction(text: $0)).map(\.rule) }
+  }
+
+  /// Plays the desk and a dock, then `last` with `fault` done as part of it. Returns the rules that `last` broke.
+  private func rules(after lines: [String] = ["dock 101 left"], then last: String, fault: @escaping (ChaosRunner) -> Void) -> Set<String> {
+    let runner = ChaosRunner()
+    let broken = play(desk + lines, on: runner).flatMap { $0 }
+    #expect(broken.isEmpty, "\(broken)")
+    #expect(runner.harness.overlays.aloft?.window == a, "the story is about a window that is aloft")
+    runner.beforeTheNextCheck = fault
+    return Set(runner.step(ChaosAction(text: last)).map(\.rule))
+  }
+
+  @Test func aGlideBreaksNoRuleAtAnyStep() {
+    let runner = ChaosRunner()
+    let story = desk + [
+      "dock 101 left", "react", "advance 0.2", "save", "advance 0.3", "react", "settle", "focus 102", "react", "dock 102 right", "advance 0.1", "dock 102 left",
+      "react", "settle", "focus 101", "react", "float 101", "advance 0.1", "react", "crash", "launch", "settle", "quit",
+    ]
+    for (line, broken) in zip(story, play(story, on: runner)) { #expect(broken.isEmpty, "\(line): \(broken)") }
+  }
+
+  /// The control for all of it: without the exemption the nets say of a glide what they say of any window that goes out of view and comes back.
+  @Test func withoutTheExemptionTheNetsCallItWhatTheBareLogSays() {
+    let runner = ChaosRunner()
