+  struct Act: CustomTestStringConvertible, Sendable {
+    var testDescription: String
+    var perform: @MainActor @Sendable (Desk) -> Void
+    init(_ name: String, _ perform: @escaping @MainActor @Sendable (Desk) -> Void) { (testDescription, self.perform) = (name, perform) }
+  }
+
+  nonisolated static let acts: [Act] = [
+    Act("a command about another window") { $0.h.run("pin \($0.b.rawValue)") },
+    Act("a command that fails") { $0.h.run("float 999") },
+    Act("a command that changes a setting") { $0.h.run("set gap 20") },
+    Act("a press of the pointer") { $0.h.system.click() },
+    Act("a drag of another window") { $0.h.system.beginDrag($0.b) },
+    Act("an edge of another window in the hand") { $0.h.system.userResize($0.b, to: CGRect(x: 500, y: 300, width: 620, height: 400), release: false) },
+    Act("a key of Arbor's that runs no command yet") { $0.h.keyDown("ctrl+opt+0") },
+    Act("another window closing") { $0.h.system.close($0.b) },
+    Act("another window minimized") { $0.h.system.setMinimized($0.b, true) },
+    Act("another app quitting") { $0.h.system.quit(pid: 1002) },
+    Act("the keyboard going elsewhere") { $0.h.system.userFocus($0.b) },
+    Act("another app coming forward") { $0.h.system.userSwitchesApp(to: $0.b) },
+    Act("sleep, or another macOS Space") { $0.h.overlays.interruptGlide() },
+    Act("a click on the minimap, a tile, a gap: a press comes first") { $0.h.system.click() },
+  ]
