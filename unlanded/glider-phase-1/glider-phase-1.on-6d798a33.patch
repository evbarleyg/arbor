diff --git a/Sources/ArborCore/Glide.swift b/Sources/ArborCore/Glide.swift
new file mode 100644
index 00000000..1dbf1e1b
--- /dev/null
+++ b/Sources/ArborCore/Glide.swift
@@ -0,0 +1,42 @@
+import CoreGraphics
+
+/// One window that travels as a picture of itself (Controller+Glider.swift): the numbers, and the one rule by which its road is judged.
+public enum Glide {
+  /// The real window is never out of view for longer than this, in seconds, whatever `animationDuration` says and whatever becomes
+  /// of the panel.
+  public static let longestAway = 0.5
+
+  /// How long a presenter may take over a picture, in seconds. From the key to the first frame a glide costs at most this much
+  /// more than a jump; a picture that takes longer is none.
+  public static let longestWaitForAPicture = 0.05
+
+  /// The window level of the panel: above every window, the stage and Arbor's passing panels. No other panel of Arbor's is at it,
+  /// because that is what the detector on a Mac knows the glider by (scripts/mac-shell/jolts.py, `GLIDER`).
+  public static let panelLevel = 7
+
+  /// A window whose place and size all end within this many points of what they are has no journey worth a picture.
+  public static let trifle: CGFloat = 8
+
+  /// How long a glide takes where a motion takes `motion` seconds.
+  public static func duration(motion: Double) -> Double { min(max(motion, 0), longestAway) }
+
+  public static func isAJourney(from: CGRect, to: CGRect) -> Bool { !from.approximatelyEquals(to, tolerance: trifle) }
+
+  /// "A window moves once, to where it ends up" is about what a person sees. From its picture's going up until its coming down a
+  /// person sees the picture of the one window that glides, so in that time its road is not judged and its end is.
+  ///
+  /// `road` is every frame the real window had in that time, beginning with where it stood when the picture went up and ending with
+  /// where it was when the picture came down; `shows` says whether a person could see a window at a frame. What a person saw of it
+  /// is its two ends, if it went from a place in view out of view and from there to a place in view, and nowhere else. Nil for
+  /// any other road, which is judged as ever: a third place in view, a second time out of view, an end that nobody can
+  /// see, or a window that never left.
+  ///
+  /// The one rule for whoever measures roads: `FakeWindowSystem.asSeen` hands it the fake's log, which `road(of:)`, `jolts(since:)` and the
+  /// chaos lab's nets read, and scripts/mac-shell/jolts.py (`glider_came_down`) says the same of a Mac's window list.
+  public static func whatWasSeen(of road: [CGRect], shows: (CGRect) -> Bool) -> [CGRect]? {
+    guard road.count > 2, let first = road.first, let last = road.last, shows(first), shows(last),
+      !road.dropFirst().dropLast().contains(where: shows)
+    else { return nil }
+    return [first, last]
+  }
+}
diff --git a/Tests/ArborCoreTests/GlideTests.swift b/Tests/ArborCoreTests/GlideTests.swift
new file mode 100644
index 00000000..b52fa7f4
--- /dev/null
+++ b/Tests/ArborCoreTests/GlideTests.swift
@@ -0,0 +1,51 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+@Suite struct GlideTests {
+  static let display = CGRect(x: 0, y: 0, width: 1440, height: 900)
+  static func shows(_ frame: CGRect) -> Bool {
+    let showing = frame.intersection(display)
+    return !showing.isNull && showing.width > 2 && showing.height > 2
+  }
+
+  let old = CGRect(x: 300, y: 200, width: 640, height: 420)
+  let new = CGRect(x: 12, y: 37, width: 702, height: 781)
+  let away = CGRect(x: 1439, y: 37, width: 640, height: 420)
+  let sized = CGRect(x: 1439, y: 37, width: 702, height: 781)
+  let third = CGRect(x: 700, y: 37, width: 702, height: 781)
+
+  func seen(_ road: [CGRect]) -> [CGRect]? { Glide.whatWasSeen(of: road, shows: Self.shows) }
+
+  @Test func fromAPlaceInViewOutOfViewAndFromThereToAPlaceInViewIsSeenAsItsTwoEnds() {
+    #expect(seen([old, away, new]) == [old, new])
+    #expect(seen([old, away, sized, new]) == [old, new], "what it does out of view nobody sees")
+  }
+
+  @Test func anyOtherRoadIsJudgedAsEver() {
+    #expect(seen([old, away, third, new]) == nil, "a third place")
+    #expect(seen([old, third, away, new]) == nil)
+    #expect(seen([old, away, new, away, new]) == nil, "a second time out of view")
+    #expect(seen([old, away]) == nil, "an end nobody can see")
+    #expect(seen([old, away, sized]) == nil)
+    #expect(seen([away, sized, new]) == nil, "it was not in view when its picture went up")
+    #expect(seen([old, new]) == nil, "it never left: there is nothing to leave out")
+    #expect(seen([old]) == nil)
+    #expect(seen([]) == nil)
+  }
+
+  @Test func aGlideLastsAsLongAsAMotionAndNeverLongerThanTheWindowMayBeAway() {
+    #expect(Glide.duration(motion: 0.46) == 0.46)
+    #expect(Glide.duration(motion: 2) == Glide.longestAway)
+    #expect(Glide.duration(motion: 0) == 0)
+    #expect(Glide.duration(motion: -1) == 0)
+    #expect(Glide.longestAway == 0.5)
+  }
+
+  @Test func aTrifleIsNoJourney() {
+    #expect(!Glide.isAJourney(from: old, to: old))
+    #expect(!Glide.isAJourney(from: old, to: old.offsetBy(dx: 8, dy: -8)))
+    #expect(Glide.isAJourney(from: old, to: old.offsetBy(dx: 9, dy: 0)))
+    #expect(Glide.isAJourney(from: old, to: CGRect(x: 300, y: 200, width: 640, height: 440)), "a size is a journey too")
+  }
+}
