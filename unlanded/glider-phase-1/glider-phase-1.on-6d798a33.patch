diff --git a/Sources/ArborKit/Controller/Controller+Glider.swift b/Sources/ArborKit/Controller/Controller+Glider.swift
new file mode 100644
index 00000000..90468987
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+Glider.swift
@@ -0,0 +1,421 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+
+/// One window travels as a picture of itself, over the real display.
+///
+/// With motion on, `windowPictures` on and a picture to be had, the window an act is about does not jump: the presenter puts a picture of
+/// it up on a small panel that lies exactly over it and lets the panel glide to where the window is going (`OverlayPresenter.liftOff`).
+/// Nothing else is covered. The other windows jump, in plain view, exactly as without motion. There is no stage, no card and no
+/// picture of the desktop, and nothing is kept when the glide is over. Where there is no glider, everything is as it is without one.
+///
+/// A window cannot be seen twice, so the real one is out of view meanwhile. Its road is: where it stood, out of view, where it ends
+/// up, and nothing else. Out of view it takes its final size, where nobody sees it lay itself out; at the end it is only moved,
+/// under the panel, and the panel goes. What a person sees is one window that moves once, to where it ends up.
+///
+/// The window away is the one in use, so:
+/// - **the way back is written down before it leaves** (`takeOff`): the arrangement as it will be is on disk, and where the window waits
+///   is a place from which every start fetches a window (`treatStrandedWindowsAsParked`, `reconcile`);
+/// - **there is a limit by the clock**: it is back when the glide's time is up, half a second at the most (`Glide.longestAway`), by the
+///   controller's own timer, whatever becomes of the panel;
+/// - **whatever a person does ends the glide at once, at its end** (`landTheGlider`): nothing queues, and what comes next starts from there;
+/// - **its own parking is no news to Arbor**: when the layout that began it is done, `windows` has it at the frame it is going to, so the menu, Go to…, the
+///   line on screen, the focus ring, the minimap, `state`, the invariants and what is saved all speak of that frame. It is not in
+///   `parked`, nothing is learnt from where it waits, and the keyboard stays with it. What its app reports of its place
+///   meanwhile is Arbor's own doing come back (`whatIsNews`);
+/// - **where it ends is found out while it is away** (`aim`): it is asked for its size where it waits, as others are asked where they stand
+///   (Controller+AskFirst.swift). If it will not be as small as its slot, or a neighbour's answer changes the layout, it is asked again for the
+///   layout that follows, and the panel is told where to go instead;
+/// - **whatever else is not as foreseen calls the glide off**: the books say where the window really is, the layout under way places it as
+///   it places any window, and the panel goes when that is done. It has then jumped, once.
+extension Controller {
+  /// One stored property of the controller.
+  struct Glider {
+    /// The window the act under way is about, if it names one or means the one with the keyboard.
+    var named: WindowID?
+    var flight: Flight?
+    /// The picture is up and where its window ends is still to be found. Only while a layout is under way.
+    var unaimed: Picture?
+    /// The panel is up and nothing glides: it goes when the layout under way has placed the window.
+    var panelIsToGo = false
+  }
+
+  /// The picture that is up.
+  struct Picture {
+    var window: WindowID
+    var display: DisplayID
+    /// Where it went up, when, and for how long.
+    var from: CGRect
+    var began: Date
+    var duration: Double
+    /// Where the panel has been told to go.
+    var goesTo: CGRect
+  }
+
+  /// The glide under way.
+  struct Flight {
+    var picture: Picture
+    /// Where it is going, which is where everybody but the window system has it.
+    var to: CGRect
+    /// Where it really is.
+    var waitsAt: CGRect
+    /// The slot it is to fill. Nil for a floating window.
+    var slot: CGRect?
+
+    var window: WindowID { picture.window }
+    var display: DisplayID { picture.display }
+  }
+
+  static let glideKey = "glide"
+
+  /// The window that is out of view under its own picture, for tests and the chaos lab.
+  public var glidingWindow: WindowID? { glider.flight?.window }
+
+  // MARK: Going up
+
+  /// Where a layout takes a window, and by whose books.
+  private enum Destination {
+    case slot(CGRect)
+    /// Handed to `relayout` to be put back (`putBack`).
+    case ownFrame(CGRect)
+    /// `FloatingMove.place`.
+    case onTheDesktop(CGRect)
+  }
+
+  /// Called by `relayout` before it moves anything, in the stage's place. True if a picture went up: then there is no stage, whatever
+  /// becomes of the glide. A window that glides to the frame it was to be put back at is taken off `puttingBack`.
+  func takeOff(
+    on displayID: DisplayID, to layout: Layout, reason: RelayoutReason, motion: Motion,
+    puttingBack: inout [(window: WindowID, frame: CGRect)]
+  ) -> Bool {
+    // With either off, not one line of this runs.
+    guard settings.windowPictures, settings.motionDuration > 0 else { return false }
+    guard reason != .enforce, motion == .animated, drag == nil, edgeResize == nil, glider.flight == nil, !glider.panelIsToGo,
+      let display = display(displayID), let window = glider.named ?? keyboardFocus(), let current = windows[window],
+      isFitToGlide(current, on: display),
+      let destination = destination(of: current, in: layout, on: displayID, reason: reason, puttingBack: puttingBack)
+    else { return false }
+    // What is asked of it, and where it is expected to end up if its app does as it did before.
+    let (asked, expected): (CGRect, CGRect)
+    switch destination {
+    case .slot(let slot): (asked, expected) = (request(for: current, in: slot), expectedFrame(of: current, in: slot))
+    case .ownFrame(let frame), .onTheDesktop(let frame): (asked, expected) = (frame, frame)
+    }
+    guard Glide.isAJourney(from: current.frame, to: expected), !showsOnlyASliver(expected),
+      wing(for: current.frame.size, then: asked, of: window, on: display) != nil,
+      // macOS is showing its desktop: the window is not where its picture would go up.
+      !isSweptAside(system.stackedWindows())
+    else { return false }
+    let duration = Glide.duration(motion: settings.motionDuration)
+    let picture = Picture(window: window, display: displayID, from: current.frame, began: now(), duration: duration, goesTo: expected)
+    guard overlays.liftOff(window, from: current.frame, to: expected, duration: duration) else { return false }
+    // Before it leaves: should Arbor die now, the start that follows reads where everything belongs. Not before there is a picture: where
+    // there is none, nothing is done that is not done without a glider.
+    saveNow()
+    store.flush()
+    // A stage still up from an earlier change would hide the others as they jump, and lift on something it did not lead to.
+    overlays.finishAnimations()
+    rehearsalWaits(for: duration)
+    // From here on the panel is up, and comes down when the window is in a place.
+    glider.panelIsToGo = true
+    glider.unaimed = picture
+    // What it says to its slot is for `askingFirst` to hear, which comes next.
+    guard leaves(for: asked) else { return true }
+    if case .slot = destination { return true }
+    _ = aim(at: destination)
+    glider.unaimed = nil
+    if glider.flight != nil { puttingBack.removeAll { $0.window == window } }
+    return true
+  }
+
+  /// The place alone: the window whose picture is up goes to where it will be asked for `asked`. False, and the glide is off, if it does not.
+  private func leaves(for asked: CGRect) -> Bool {
+    guard let picture = glider.unaimed, let current = windows[picture.window], let display = display(picture.display),
+      let wing = wing(for: current.frame.size, then: asked, of: picture.window, on: display)
+    else {
+      glider.unaimed = nil
+      return false
+    }
+    guard current.frame.origin != wing else { return true }
+    let left = system.setFrame(CGRect(origin: wing, size: current.frame.size), of: picture.window)
+    if let left { windows[picture.window]?.frame = left }
+    guard let left, isOutOfView(left) else {
+      glider.unaimed = nil
+      return false
+    }
+    return true
+  }
+
+  /// Asks the window whose picture is up for the size it is to have, out of view, and sets it on its way if the answer is one that `place` and
+  /// `putBack` would leave it with. Each of the two calls goes by the steps the window system takes for it (`FramePlan`).
+  ///
+  /// Returns true if it will not be as small as its slot and that is news (a new minimum size was learned): it waits for the layout
+  /// that follows. In every other case in which nothing glides when this returns, the glide is off.
+  private func aim(at destination: Destination) -> Bool {
+    guard var picture = glider.unaimed, let current = windows[picture.window] else { return false }
+    let window = picture.window
+    let asked: CGRect
+    switch destination {
+    case .slot(let slot): asked = request(for: current, in: slot)
+    case .ownFrame(let frame), .onTheDesktop(let frame): asked = frame
+    }
+    guard leaves(for: asked), var took = windows[window]?.frame else { return false }
+    glider.unaimed = nil
+    let wing = took.origin
+    if abs(asked.width - took.width) > 0.5 || abs(asked.height - took.height) > 0.5 {
+      let question = CGRect(origin: wing, size: asked.size)
+      guard let answer = system.setFrame(question, of: window) else { return false }
+      took = answer
+      if case .slot = destination { took = askForLess(window, slot: question, took: took) }
+      windows[window]?.frame = took
+    }
+    // An answer that may be the screen's says nothing about the window.
+    guard isOutOfView(took), !mayHaveBeenStoppedByTheScreen(took.size, shortOf: asked.size, at: wing) else { return false }
+    let origin: CGPoint
+    switch destination {
+    case .slot(let slot):
+      let isNews = learn(from: window, was: current.frame.size, took: took.size, offered: slot.size)
+      // Should `place` have to see to it after all, it is only moved: a terminal would round up again and be talked down again, in view.
+      justAnswered[window] = asked.size
+      guard took.width <= slot.width + 2, took.height <= slot.height + 2 else {
+        if isNews { glider.unaimed = picture }
+        return isNews
+      }
+      let isSmaller = took.width < slot.width - 2 || took.height < slot.height - 2
+      origin = isSmaller ? Self.centred(took.size, in: slot).origin : slot.origin
+    case .ownFrame(let frame), .onTheDesktop(let frame):
+      guard abs(took.width - frame.width) <= 1, abs(took.height - frame.height) <= 1 else { return false }
+      origin = frame.origin
+    }
+    // macOS puts windows on whole points, and the picture ends on the window to the point.
+    let end = CGRect(x: origin.x.rounded(.down), y: origin.y.rounded(.down), width: took.width, height: took.height)
+    // Now that it has answered there may be nowhere to go: a command that thought again (`shrink`) leaves it where it was.
+    guard !showsOnlyASliver(end), Glide.isAJourney(from: picture.from, to: end) else { return false }
+
+    // It glides. From now on it is where it is going, for everybody.
+    let elapsed = now().timeIntervalSince(picture.began)
+    // Its app rounds sizes, has stopped growing elsewhere than it did, or the layout is another.
+    if end != picture.goesTo {
+      picture.goesTo = end
+      _ = overlays.liftOff(window, from: picture.from, to: end, duration: Transition.timeLeft(of: picture.duration, after: elapsed))
+    }
+    glider.panelIsToGo = false
+    glider.flight = Flight(picture: picture, to: end, waitsAt: took, slot: nil)
+    windows[window]?.frame = end
+    unplaced.remove(window)
+    switch destination {
+    case .slot(let slot):
+      glider.flight?.slot = slot
+      settled[window] = end
+      misfits[window] = end.approximatelyEquals(slot, tolerance: 1) ? nil : (slot, end)
+    case .ownFrame:
+      // As `putBack` leaves it: where its user had it, not where Arbor chose to put it.
+      settled[window] = nil
+    case .onTheDesktop(let frame):
+      settled[window] = end
+      misfits[window] = end.approximatelyEquals(frame, tolerance: 1) ? nil : (frame, end)
+    }
+    // By the clock that began when the picture went up, whatever the answers took.
+    scheduler.schedule(Self.glideKey, after: max(picture.duration - max(elapsed, 0), 0)) { [weak self] in self?.landTheGlider() }
+    Log.debug("\(window) glides to \(end.brief)")
+    return false
+  }
+
+  /// In view, as itself, in nobody's hand, and with an app that can be taken at its word.
+  private func isFitToGlide(_ window: WindowSnapshot, on display: DisplaySnapshot) -> Bool {
+    // Present: not minimized, not hidden, not in full screen, not on another Space.
+    window.isPresent && isManaged(window.id) && workspaces[display.id]?.contains(window.id) == true && !parked.contains(window.id)
+      && window.frame.overlaps(display.frame) && !showsOnlyASliver(window.frame) && !isLetBe(window.id)
+      && !unplaced.contains(window.id) && !enforcement.givenUp.contains(window.id)
+      // Only just back, or on its way out of full screen: macOS may still be flying it in.
+      && landsAt[window.id] == nil && metAhead[window.id] == nil
+  }
+
+  /// Nil for a window that the layout leaves where it is, turns into a tile or takes out of view.
+  private func destination(
+    of window: WindowSnapshot, in layout: Layout, on displayID: DisplayID, reason: RelayoutReason,
+    puttingBack: [(window: WindowID, frame: CGRect)]
+  ) -> Destination? {
+    if let own = puttingBack.last(where: { $0.window == window.id }) { return .ownFrame(own.frame) }
+    if let slot = layout.windowFrames[window.id] { return isStillToBePlaced(window, in: slot) ? .slot(slot) : nil }
+    guard case .place(let frame, _)? = floatingMoves(on: displayID, layout: layout, reason: reason).first(where: { $0.window == window.id })?.move
+    else { return nil }
+    return .onTheDesktop(frame)
+  }
+
+  /// Where the real window waits: beside the display, a point of it showing, at the height of the frame it is going to. macOS lets a window
+  /// grow no further than the bottom of the visible frame where it stands, so in a bottom corner, where Arbor parks windows, the
+  /// answer would be the screen's. Here the height fits as it will at the end, and the width is free: the far edge is off the display.
+  ///
+  /// To the right. To the left what shows depends on the width, so that is a place only for a window that keeps its width: as in
+  /// `question`, it must neither grow into view nor shrink out of reach. Nil where a neighbouring display would show it.
+  private func wing(for size: CGSize, then asked: CGRect, of window: WindowID, on display: DisplaySnapshot) -> CGPoint? {
+    [CGPoint(x: display.frame.maxX - 1, y: asked.minY), CGPoint(x: display.frame.minX - size.width + 1, y: asked.minY)].first { origin in
+      let (first, second) = (CGRect(origin: origin, size: size), CGRect(origin: origin, size: asked.size))
+      return isOutOfView(first.union(second)) && [first, second].allSatisfy { frame in displays.contains { frame.overlaps($0.frame) } }
+        // macOS would stop it higher up than that.
+        && whereItStops(origin, titleBar: titleBars[window] ?? Self.guessedTitleBar) == origin
+    }
+  }
+
+  // MARK: During the layout that began it
+
+  /// Called with every layout of the display, before anybody is asked or moved for it. The window that is away is asked for what it is to be
+  /// in this one, unless it is on its way there already: another window's answer can change the layout, and the glide then leads to
+  /// a slot that is no longer there. Returns true if `layout` does not hold, because it will not be as small as its slot.
+  ///
+  /// `orNever`: by whoever goes on to place every window of `layout`, whatever this one answers. There is an end to the asking because
+  /// there is one to the layouts (`askingFirst`, `relayout`).
+  func aimTheGlide(at layout: Layout, on displayID: DisplayID, orNever: Bool = false) -> Bool {
+    defer { if orNever { glider.unaimed = nil } }
+    if let flight = glider.flight, flight.display == displayID, let slot = flight.slot, layout.windowFrames[flight.window] != slot {
+      callOffTheGlide()
+    }
+    guard let picture = glider.unaimed, picture.display == displayID else { return false }
+    // A tile, or out of view: that is no journey for a picture.
+    guard let slot = layout.windowFrames[picture.window] else {
+      glider.unaimed = nil
+      return false
+    }
+    return aim(at: .slot(slot))
+  }
+
+  /// The books say where the window really is. It may yet be aimed anew; if not, whoever lays out next places it like any window that stands
+  /// in a wrong place.
+  private func callOffTheGlide() {
+    guard let flight = glider.flight else { return }
+    glider.flight = nil
+    glider.panelIsToGo = true
+    scheduler.cancel(Self.glideKey)
+    Log.debug("the glide of \(flight.window) to \(flight.to.brief) is called off")
+    // Unless somebody has given it another frame meanwhile: then the books are right already.
+    guard windows[flight.window]?.frame == flight.to else { return }
+    windows[flight.window]?.frame = flight.waitsAt
+    settled[flight.window] = nil
+    misfits[flight.window] = nil
+    glider.unaimed = flight.picture
+  }
+
+  /// Called by `relayout` when everything is in place.
+  func settleTheGlide(on displayID: DisplayID) {
+    // Somebody has given it another frame meanwhile, which is a place: there is nothing left to do but to show it.
+    if let flight = glider.flight, flight.display == displayID, windows[flight.window]?.frame != flight.to {
+      glider.flight = nil
+      glider.panelIsToGo = true
+      scheduler.cancel(Self.glideKey)
+    }
+    thePanelGoesIfNothingGlides()
+  }
+
+  private func thePanelGoesIfNothingGlides() {
+    glider.unaimed = nil
+    guard glider.panelIsToGo else { return }
+    glider.panelIsToGo = false
+    overlays.touchDown()
+  }
+
+  /// The displays have changed, and `seeingToThem` is what Arbor does about that. Where the window was going may be nowhere now, so it is not sent
+  /// there first: the books say where it is, out of view, and it is fetched from there like any window the displays have left
+  /// stranded (`treatStrandedWindowsAsParked`). It moves once.
+  func theGlideEndsWithTheDisplays(_ seeingToThem: () -> Void) {
+    callOffTheGlide()
+    glider.unaimed = nil
+    seeingToThem()
+    thePanelGoesIfNothingGlides()
+  }
+
+  // MARK: Coming down
+
+  /// Ends the glide at its end, at once: when its time is up, and whenever a person does anything. The window is placed first,
+  /// then the panel goes. Costs a test of a flag while nothing glides.
+  func landTheGlider() {
+    guard let flight = glider.flight else { return }
+    glider.flight = nil
+    scheduler.cancel(Self.glideKey)
+    defer { overlays.touchDown() }
+    guard !isStoppingWithoutMoving, let actual = system.setFrame(flight.to, of: flight.window) else {
+      // Its app does not answer, or nothing can be moved. It is where it waits, and counts as what it is: a window out of view that has
+      // a place in view, which is given it when its app answers, at the next start, or when Arbor quits.
+      windows[flight.window]?.frame = flight.waitsAt
+      unplaced.insert(flight.window)
+      treatStrandedWindowsAsParked()
+      return
+    }
+    guard !actual.approximatelyEquals(flight.to, tolerance: 1) else {
+      windows[flight.window]?.frame = actual
+      if settled[flight.window] != nil { settled[flight.window] = actual }
+      return
+    }
+    // Only moved, it has ended elsewhere or at another size. That is where it is, and the put-back sees to the rest.
+    windows[flight.window]?.frame = actual
+    if isRunning { scheduleEnforce(flight.display) }
+  }
+
+  /// A window has closed. If it is the one that glides there is nothing left to place.
+  func theGlideEnds(withTheGoingOf window: WindowID) {
+    guard glider.flight?.window == window else { return landTheGlider() }
+    glider.flight = nil
+    scheduler.cancel(Self.glideKey)
+    overlays.touchDown()
+  }
+
+  /// A layout of the display it is on starts from the glide's end.
+  func landTheGlider(before displayID: DisplayID) {
+    if glider.flight?.display == displayID { landTheGlider() }
+  }
+
+  /// Called where a command begins. A question is no act.
+  func anActBegins(_ command: Command) {
+    glider.named = nil
+    if !command.isQuery { landTheGlider() }
+  }
+
+  /// `OverlayActions`.
+  public func glideWasInterrupted() { landTheGlider() }
+
+  /// The keyboard has gone to `window`, or to nothing Arbor knows. Its going to the window that glides is the act's own doing.
+  func theGlideEndsIfTheKeyboardWentElsewhere(_ window: WindowID?) {
+    if let flight = glider.flight, flight.window != window { landTheGlider() }
+  }
+
+  // MARK: What its app reports meanwhile
+
+  /// What is news in a report about a window. That the one that glides is where it waits, at the size it has there, is Arbor's own doing come
+  /// back, and no report of that is taken for the window's frame. Anything else that has changed about it (it is minimized, hidden, in
+  /// full screen, on another Space) ends the glide first. So does a report from anywhere else: somebody has moved it. If that is
+  /// a place in view, it is in view, and there is nothing to do but to take the panel away and hear the report like any other.
+  func whatIsNews(in report: WindowSnapshot) -> WindowSnapshot {
+    guard let flight = glider.flight, flight.window == report.id, var known = windows[report.id] else { return report }
+    if !report.frame.approximatelyEquals(flight.waitsAt, tolerance: 2), !isOutOfView(report.frame) {
+      glider.flight = nil
+      scheduler.cancel(Self.glideKey)
+      overlays.touchDown()
+      return report
+    }
+    var news = report
+    news.frame = known.frame
+    // A title is no reason to end anything.
+    known.title = news.title
+    if news != known {
+      landTheGlider()
+      news.frame = windows[report.id]?.frame ?? report.frame
+    }
+    return news
+  }
+
+  // MARK: Invariants
+
+  func gliderViolations(_ problems: inout [InvariantViolation]) {
+    if glider.panelIsToGo || glider.unaimed != nil { problems.append(.init("glider", "nothing glides, and the panel is still up")) }
+    guard let flight = glider.flight else { return }
+    guard let window = windows[flight.window] else {
+      return problems.append(.init("leak", "the window that glides, \(flight.window), no longer exists"))
+    }
+    if window.frame != flight.to {
+      problems.append(.init("glider", "\(flight.window) glides to \(flight.to.brief), and Arbor has it at \(window.frame.brief)"))
+    }
+    if parked.contains(flight.window) { problems.append(.init("glider", "\(flight.window) glides, and counts as out of view")) }
+    if !window.isPresent { problems.append(.init("glider", "\(flight.window) glides, and takes up no space")) }
+    if !isOutOfView(flight.waitsAt) { problems.append(.init("glider", "\(flight.window) waits in view, at \(flight.waitsAt.brief)")) }
+  }
+}
