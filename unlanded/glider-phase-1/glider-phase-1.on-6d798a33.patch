+
+/// One window travels as a picture of itself (Controller+Glider.swift): with motion on, `windowPictures` on and a picture to be had.
+@Suite @MainActor struct GliderTests {
+  /// Two windows that float on a display with a Dock, and a Mac that hands out pictures.
+  @MainActor final class Desk {
+    let h: Harness
+    let a: WindowID
+    let b: WindowID
+    static let display = DisplaySnapshot(
+      id: DisplayID("main"), frame: CGRect(x: 0, y: 0, width: 1440, height: 900),
+      visibleFrame: CGRect(x: 0, y: 25, width: 1440, height: 805), isMain: true, isBuiltIn: true)
+
+    init(
+      pictures: Bool = true, setting: Bool = true, motion: Double = 0.46, displays: [DisplaySnapshot] = [Desk.display],
+      change: (inout Settings) -> Void = { _ in }
+    ) {
+      var settings = Settings()
+      settings.windowPictures = setting
+      settings.animationDuration = motion
+      change(&settings)
+      h = Harness(displays: displays, settings: settings)
+      h.overlays.hasPicture = { _ in pictures }
+      a = h.system.open(app: "A", pid: 1001, frame: CGRect(x: 300, y: 200, width: 640, height: 420))
+      b = h.system.open(app: "B", pid: 1002, frame: CGRect(x: 500, y: 300, width: 600, height: 400))
+      h.start()
+      h.system.userFocus(a)
+    }
+
+    var flight: FakeOverlays.Flight? { h.overlays.flights.last }
+    var isAloft: Bool { h.overlays.aloft != nil }
+    func believed(_ window: WindowID) -> CGRect? { h.controller.windows[window]?.frame }
+    func slot(_ window: WindowID) -> CGRect? { h.layout?.windowFrames[window] }
+    func isInView(_ window: WindowID) -> Bool { h.system.isVisible(window) }
+    /// The time of every motion is over.
+    func land() { h.scheduler.advance(by: 1) }
+
+    /// Every frame `window` really had from `mark` on, the exemption left aside.
+    func rawRoad(of window: WindowID, since mark: Int = 0) -> [CGRect] {
+      var road: [CGRect] = []
+      for move in h.system.moveLog[mark...] where move.window == window && move.before != move.after {
+        if road.last != move.before { road.append(move.before) }
+        road.append(move.after)
