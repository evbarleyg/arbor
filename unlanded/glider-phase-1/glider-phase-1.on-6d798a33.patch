@@ -0,0 +1,107 @@
+import ArborCore
+import ArborKit
+import CoreGraphics
+
+/// The walks with the glider in them (Controller+Glider.swift): a window that travels as a picture of itself is out of view meanwhile, which
+/// every net about where windows are would rightly call lost, flashed or moved twice.
+///
+/// The exemption is the rule's own and no wider. From its picture's going up until its coming down the road of the one window that glides is not
+/// judged, and its end is: so while the picture is up every net is asked about a Mac on which that window is where its picture takes it
+/// (`withTheGliderAtItsEnd`), and the nets that read the log of moves read it through `FakeWindowSystem.asSeen`. Every other window, and
+/// that one at any other time, is judged as ever. What pays for it has nets of its own (`gliderViolations`).
+extension ChaosRunner {
+  /// What the nets about the glider remember from step to step.
+  struct GliderWatch {
+    /// How many pictures this walk has asked for.
+    var asked = 0
+    /// How many pictures had gone up and been refused when the step began, and whether the last of them was still up.
+    var flightsBefore = 0
+    var refusalsBefore = 0
+    var wasUpBefore = false
+    /// The picture that is up, by its number among this run's, and the time it was first seen up.
+    var up: (flight: Int, since: Double)?
+  }
+
+  /// How often a walk met the glider, over every runner of the process: a walk that never does proves nothing about it.
+  public nonisolated(unsafe) static var pictures = (up: 0, refused: 0, calledOff: 0)
+
+  /// Called for every run of Arbor. Three times out of four there is a picture, by how many this walk has asked for: so a script
+  /// replays as it was walked, and no walk without `windowPictures` is another walk than it was.
+  func handOutPictures() {
+    harness.overlays.hasPicture = { [unowned self] _ in
+      self.gliderWatch.asked += 1
+      return self.gliderWatch.asked % 4 != 0
+    }
+  }
+
+  func noteBeforeTheGlider() {
+    gliderWatch.flightsBefore = harness.overlays.flights.count
+    gliderWatch.refusalsBefore = harness.overlays.refusedLiftOffs.count
+    gliderWatch.wasUpBefore = harness.overlays.aloft != nil
+    // Where it was before the step, to a person.
+    if isRunning, !system.judgesTheGliderAsEver, let up = harness.overlays.aloft, framesBefore[up.window] != nil {
+      framesBefore[up.window] = up.to
+    }
+  }
+
+  /// Does `body` on a Mac as a person sees it: the window whose picture is up is where the picture takes it.
+  func withTheGliderAtItsEnd<Result>(_ body: () -> Result) -> Result {
+    guard isRunning, !system.judgesTheGliderAsEver, let up = harness.overlays.aloft, let real = system.windows[up.window]
+    else { return body() }
+    var seen = real
+    seen.snapshot.frame = up.to
+    // Looking moves nothing.
+    (seen.placeIsArborsDoing, seen.movesNotArbors, seen.home) = (real.placeIsArborsDoing, real.movesNotArbors, real.home)
+    seen.lastRequest = (up.to, up.to)
+    system.windows[up.window] = seen
+    defer { system.windows[up.window] = real }
+    return body()
+  }
+
+  /// What pays for the exemption.
+  func gliderViolations() -> [InvariantViolation] {
+    var problems: [InvariantViolation] = []
+    let overlays = harness.overlays
+    let new = overlays.flights.indices.dropFirst(min(gliderWatch.flightsBefore, overlays.flights.count))
+    Self.pictures.up += new.count
+    Self.pictures.refused += max(overlays.refusedLiftOffs.count - gliderWatch.refusalsBefore, 0)
+    let settings = controller.settings
+    if !settings.windowPictures || settings.motionDuration <= 0, overlays.aloft != nil, isRunning {
+      problems.append(.init("glider-while-off", "a picture is up with motion or `windowPictures` off"))
+    }
+    if overlays.liftOffsUnderAnother > 0 { problems.append(.init("glider-two-at-once", "a picture was asked for while another was up")) }
+    for flight in new.map({ overlays.flights[$0] }) where flight.stoodAt != flight.from {
+      problems.append(
+        .init("glider-went-up-elsewhere", "the picture of \(flight.window) went up at \(flight.from.brief), and the window stood at \(flight.stoodAt?.brief ?? "nowhere")"))
+    }
+    // Those that came down in this step.
+    let first = max(gliderWatch.flightsBefore - (gliderWatch.wasUpBefore ? 1 : 0), 0)
+    for flight in overlays.flights.dropFirst(first) where flight.isDown {
+      // A glide that was called off ends where the layout put the window, which the other nets judge.
+      if flight.landedAt != flight.to { Self.pictures.calledOff += 1 }
+    }
+    guard isRunning, let up = overlays.aloft else {
+      gliderWatch.up = nil
+      if isRunning, let window = controller.glidingWindow {
+        problems.append(.init("glider-left-behind", "no picture is up, and Arbor still has \(window) out of view for one"))
+      }
+      return problems
+    }
+    let now = harness.scheduler.now
+    if gliderWatch.up?.flight != overlays.flights.count { gliderWatch.up = (overlays.flights.count, now) }
+    if let since = gliderWatch.up?.since, now - since > Glide.longestAway + 0.001 {
+      problems.append(.init("glider-away-too-long", "\(up.window) has been out of view under its picture for \(now - since) s"))
+    }
+    if !harness.scheduler.pendingKeys.contains("glide") {
+      problems.append(.init("glider-away-too-long", "\(up.window) is out of view under its picture, and no timer is going to bring it back"))
+    }
+    if controller.glidingWindow != up.window {
+      problems.append(.init("glider", "the picture of \(up.window) is up, and Arbor has \(controller.glidingWindow.map { "\($0)" } ?? "nobody") gliding"))
+    }
+    // An app that takes its window back is seen to.
+    if let fake = system.windows[up.window], cooperates(fake), isInView(fake.snapshot.frame) {
+      problems.append(.init("glider-seen-twice", "\(up.window) is in view at \(fake.snapshot.frame.brief) while its picture is up"))
+    }
+    return problems
+  }
+}
