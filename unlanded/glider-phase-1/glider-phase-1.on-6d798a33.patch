+      system.setFrame(away, of: b)
+      system.setFrame(new, of: b)
+      system.pictureCameDown()
+    }
+    #expect(system.jolts(since: 0).map(\.window) == [b] && FakeWindowSystem.detour(system.road(of: b)) != nil, "another window")
+
+    (system, a, b) = play { system, a, _ in
+      system.setFrame(away, of: a)
+      system.pictureWentUp(over: a, goingTo: new)
+      system.setFrame(new, of: a)
+      system.pictureCameDown()
+    }
+    #expect(system.jolts(since: 0).count == 1 && FakeWindowSystem.detour(system.road(of: a)) != nil, "it left before its picture was up")
+
+    (system, a, b) = play { system, a, _ in
+      system.pictureWentUp(over: a, goingTo: new)
+      system.setFrame(away, of: a)
+      system.pictureCameDown()
+      system.setFrame(new, of: a)
+    }
+    #expect(system.jolts(since: 0).count == 1 && FakeWindowSystem.detour(system.road(of: a)) != nil, "it came back after its picture was down")
+
+    (system, a, b) = play { system, a, _ in
+      system.pictureWentUp(over: a, goingTo: new)
+      system.setFrame(away, of: a)
+      system.setFrame(new, of: a)
+      system.pictureCameDown()
+      system.setFrame(CGRect(x: 726, y: 37, width: 702, height: 781), of: a)
+    }
+    #expect(system.jolts(since: 0).count == 1 && FakeWindowSystem.detour(system.road(of: a)) != nil, "its end is judged: moved again, it has moved twice")
+
+    (system, a, b) = play { system, a, _ in
+      for _ in 0..<2 {
+        system.pictureWentUp(over: a, goingTo: new)
+        system.setFrame(away, of: a)
+        system.setFrame(system.frame(of: a) == away && system.moveLog.count > 2 ? old : new, of: a)
+        system.pictureCameDown()
