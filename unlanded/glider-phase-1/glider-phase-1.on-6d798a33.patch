+      system.setFrame(away, of: a)
+      system.setFrame(CGRect(x: 700, y: 37, width: 640, height: 420), of: a)
+      system.setFrame(new, of: a)
+      system.pictureCameDown()
+    }
+    #expect(!system.jolts(since: 0).isEmpty && FakeWindowSystem.detour(system.road(of: a)) != nil, "a third place")
+
+    (system, a, b) = play { system, a, _ in
+      system.pictureWentUp(over: a, goingTo: new)
+      system.setFrame(away, of: a)
+      system.setFrame(new, of: a)
+      system.setFrame(away, of: a)
+      system.setFrame(new, of: a)
+      system.pictureCameDown()
+    }
+    #expect(!system.jolts(since: 0).isEmpty && FakeWindowSystem.detour(system.road(of: a)) != nil, "a second detour")
+
+    (system, a, b) = play { system, a, b in
