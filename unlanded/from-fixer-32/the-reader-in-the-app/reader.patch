diff --git a/Sources/ArborCore/MenuShortcut.swift b/Sources/ArborCore/MenuShortcut.swift
new file mode 100644
index 00000000..2b33ac87
--- /dev/null
+++ b/Sources/ArborCore/MenuShortcut.swift
@@ -0,0 +1,75 @@
+/// A shortcut in an app's menu bar, as Accessibility tells it (collab/IDEAS.md, I16).
+///
+/// A global shortcut is taken from every app, so an app that has the same keys in a menu loses them while Arbor holds them, and gets them
+/// back, with whatever it does on them, the moment Arbor does not: paused, quit, crashed. The fingers do not know the difference. So that a
+/// clash is found before a person meets it, Arbor reads the menu bar of the app in front when somebody asks (`bindings`, `doctor`, `bind`) and
+/// lists each of its own keys that the app has too.
+///
+/// What the attributes hold was read from 62 menu bars on a hosted Mac (macOS 26, 2026-10-15; collab/evidence/menu-keys):
+/// - `AXMenuItemCmdChar`: a letter in CAPITALS, whatever ⇧ says; a digit or a sign as it is typed, so that ⌃⌥: comes as `:` with no ⇧ among the
+///   modifiers; for the keys below a control character or one from the private-use area, which is passed over here.
+/// - `AXMenuItemCmdVirtualKey`: the key code, for arrows, ↩, Space, ⎋, ⇥, ⌫, Page Up and the like, and the F-keys. Never for a letter, digit or sign.
+/// - `AXMenuItemCmdModifiers`: 1 is ⇧, 2 is ⌥, 4 is ⌃, 8 is **no** ⌘, and 16, which no header mentions, is fn (the Globe key): macOS's own
+///   Window → Move & Resize is full of it.
+///
+/// Only numbers and one character are read. **Never an item's title**: it can hold a person's words (a document, a conversation, a bookmark).
+public struct MenuShortcut: Hashable, Sendable, Codable {
+  public var modifiers: Int
+  public var character: String?
+  public var virtualKey: Int?
+
+  public init(modifiers: Int, character: String? = nil, virtualKey: Int? = nil) {
+    self.modifiers = modifiers
+    self.character = character
+    self.virtualKey = virtualKey
+  }
+
+  /// A key and the modifiers held with it: what a hot key is registered for, and what is compared.
+  public struct Press: Hashable, Sendable {
+    public var keyCode: UInt32
+    public var modifiers: KeyChord.Modifiers
+
+    public init(keyCode: UInt32, modifiers: KeyChord.Modifiers) {
+      self.keyCode = keyCode
+      self.modifiers = modifiers
+    }
+  }
+
+  /// What has to be pressed for it on `layout`. Nil if that cannot be a shortcut of Arbor's (it needs fn), or cannot be told (a character
+  /// the layout does not type).
+  public func press(on layout: KeyLayout) -> Press? {
+    guard modifiers >= 0, modifiers & 16 == 0 else { return nil }
+    var held: KeyChord.Modifiers = []
+    if modifiers & 1 != 0 { held.insert(.shift) }
+    if modifiers & 2 != 0 { held.insert(.option) }
+    if modifiers & 4 != 0 { held.insert(.control) }
+    if modifiers & 8 == 0 { held.insert(.command) }
+    if let virtualKey { return UInt32(exactly: virtualKey).map { Press(keyCode: $0, modifiers: held) } }
+    guard let character, character.count == 1, let typed = character.first else { return nil }
+    if let code = layout.code(typing: typed) { return Press(keyCode: code, modifiers: held) }
+    // ⌃⌥: is pressed as ⌃⌥⇧; where ⇧; types the colon.
+    return layout.code(typingWithShift: typed).map { Press(keyCode: $0, modifiers: held.union(.shift)) }
+  }
+}
+
+/// The shortcuts of one app's menu bar, as far as they were read.
+public struct MenuBarReading: Equatable, Sendable, Codable {
+  /// Nil for a program that is not in a bundle.
+  public var bundleID: String?
+  /// What people call the app, for replies. The log gets the bundle id.
+  public var appName: String
+  public var shortcuts: [MenuShortcut]
+  /// False if the time allowed ran out, or the app stopped answering, before the end: a menu bar has hundreds of items, and an app
+  /// takes between a tenth of a second and three seconds over them.
+  public var isComplete: Bool
+
+  public init(bundleID: String?, appName: String, shortcuts: [MenuShortcut], isComplete: Bool = true) {
+    self.bundleID = bundleID
+    self.appName = appName
+    self.shortcuts = shortcuts
+    self.isComplete = isComplete
+  }
+
+  /// Everything in it that can be pressed on `layout`.
+  public func presses(on layout: KeyLayout) -> Set<MenuShortcut.Press> { Set(shortcuts.compactMap { $0.press(on: layout) }) }
+}
