diff --git a/Sources/ArborTesting/MenuShortcut+Chord.swift b/Sources/ArborTesting/MenuShortcut+Chord.swift
new file mode 100644
index 00000000..b1c80988
--- /dev/null
+++ b/Sources/ArborTesting/MenuShortcut+Chord.swift
@@ -0,0 +1,18 @@
+import ArborCore
+
+extension MenuShortcut {
+  /// What Accessibility says of a menu item that shows `chord`, on a US keyboard: a letter in capitals, a key that types nothing by its code
+  /// (`MenuShortcut`'s header has what was read from real menu bars). For stand-ins' menu bars.
+  public init(showing chord: KeyChord) {
+    var modifiers = 0
+    if chord.modifiers.contains(.shift) { modifiers |= 1 }
+    if chord.modifiers.contains(.option) { modifiers |= 2 }
+    if chord.modifiers.contains(.control) { modifiers |= 4 }
+    if !chord.modifiers.contains(.command) { modifiers |= 8 }
+    if let character = chord.key.character {
+      self.init(modifiers: modifiers, character: String(character).uppercased())
+    } else {
+      self.init(modifiers: modifiers, virtualKey: Int(chord.key.code))
+    }
+  }
+}
