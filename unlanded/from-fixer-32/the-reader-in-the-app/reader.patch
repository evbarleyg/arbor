diff --git a/Sources/ArborKit/Input/MenuBarReader.swift b/Sources/ArborKit/Input/MenuBarReader.swift
new file mode 100644
index 00000000..517003db
--- /dev/null
+++ b/Sources/ArborKit/Input/MenuBarReader.swift
@@ -0,0 +1,59 @@
+import AppKit
+import ApplicationServices
+import ArborCore
+
+/// Reads the shortcuts in the menu bar of the app in front as the list `MenuShortcut` decides with. No decisions here.
+///
+/// Three numbers and one character of each item, and its children. Never a title. A menu bar has 150 to 750 items, and on a hosted Mac an app took
+/// between a tenth of a second and three seconds over them at four calls an item; here it is one call an item. It runs on the main thread, because
+/// whoever asked is waiting for the answer, so it gives up at `limit`, and says that it did.
+@MainActor
+enum MenuBarReader {
+  /// How long a person who asked may be kept waiting, in seconds.
+  static let limit = 1.5
+  /// And how long any one answer may take: an app that hangs costs this once, not for every item.
+  private static let patience: Float = 0.3
+  private static let attributes =
+    ["AXChildren", "AXMenuItemCmdChar", "AXMenuItemCmdVirtualKey", "AXMenuItemCmdModifiers"] as CFArray
+
+  /// Nil if no app owns the menu bar, or it does not say what is in it.
+  static func read() -> MenuBarReading? {
+    // Not the frontmost app: that is Arbor itself while one of its windows has the keyboard, and the menu bar stays the other's.
+    guard let app = NSWorkspace.shared.menuBarOwningApplication else { return nil }
+    let element = AXUIElementCreateApplication(app.processIdentifier)
+    AXUIElementSetMessagingTimeout(element, patience)
+    var value: CFTypeRef?
+    guard AXUIElementCopyAttributeValue(element, "AXMenuBar" as CFString, &value) == .success, let value,
+      CFGetTypeID(value) == AXUIElementGetTypeID()
+    else { return nil }
+    var reading = MenuBarReading(
+      bundleID: app.bundleIdentifier, appName: app.localizedName ?? app.bundleIdentifier ?? "the app in front", shortcuts: [])
+    let deadline = DispatchTime.now().uptimeNanoseconds + UInt64(limit * 1_000_000_000)
+    walk(value as! AXUIElement, depth: 0, until: deadline, into: &reading)
+    return reading
+  }
+
+  private static func walk(_ element: AXUIElement, depth: Int, until deadline: UInt64, into reading: inout MenuBarReading) {
+    // Deeper than any menu goes: an app that answers with a loop must not keep this busy until the time is up.
+    guard depth < 8, reading.isComplete else { return }
+    guard DispatchTime.now().uptimeNanoseconds < deadline else {
+      reading.isComplete = false
+      return
+    }
+    AXUIElementSetMessagingTimeout(element, patience)
+    var answer: CFArray?
+    guard AXUIElementCopyMultipleAttributeValues(element, attributes, AXCopyMultipleAttributeOptions(), &answer) == .success,
+      let values = answer as? [Any], values.count == 4
+    else {
+      reading.isComplete = false
+      return
+    }
+    // An attribute the item does not have comes as an error wrapped in a value, which is none of these types.
+    let character = (values[1] as? String).flatMap { $0.isEmpty ? nil : $0 }
+    let key = values[2] as? Int
+    if character != nil || key != nil {
+      reading.shortcuts.append(MenuShortcut(modifiers: values[3] as? Int ?? 0, character: character, virtualKey: key))
+    }
+    for child in values[0] as? [AXUIElement] ?? [] { walk(child, depth: depth + 1, until: deadline, into: &reading) }
+  }
+}
