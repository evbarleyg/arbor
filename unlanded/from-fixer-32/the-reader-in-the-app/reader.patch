+++ b/Tests/ArborCoreTests/MenuShortcutTests.swift
@@ -0,0 +1,69 @@
+import ArborCore
+import Testing
+
+/// What Accessibility says of a menu item's shortcut, and what has to be pressed for it. Every row is as a hosted Mac gave it (macOS 26, 2026-10-15;
+/// collab/evidence/menu-keys).
+@Suite struct MenuShortcutTests {
+  typealias Press = MenuShortcut.Press
+
+  @Test func aLetterComesInCapitalsAndMeansTheKeyAlone() {
+    // ⌘Q, ⇧⌘Q and ⌃⌥⌘S.
+    #expect(MenuShortcut(modifiers: 0, character: "Q").press(on: .us) == Press(keyCode: 12, modifiers: [.command]))
+    #expect(MenuShortcut(modifiers: 1, character: "Q").press(on: .us) == Press(keyCode: 12, modifiers: [.command, .shift]))
+    #expect(MenuShortcut(modifiers: 6, character: "S").press(on: .us) == Press(keyCode: 1, modifiers: [.command, .control, .option]))
+  }
+
+  @Test func eightMeansWithoutCommand() {
+    #expect(MenuShortcut(modifiers: 14, character: "A").press(on: .us) == Press(keyCode: 0, modifiers: [.control, .option]))
+    #expect(MenuShortcut(modifiers: 15, character: "A").press(on: .us) == Press(keyCode: 0, modifiers: [.control, .option, .shift]))
+    #expect(MenuShortcut(modifiers: 8, character: "A").press(on: .us) == Press(keyCode: 0, modifiers: []))
+  }
+
+  /// An editor's ⌃⌥; and ⌃⌥: come as 14 with `;` and 14 with `:`.
+  @Test func aSignTypedWithShiftComesAsThatSignWithoutTheShift() {
+    #expect(MenuShortcut(modifiers: 14, character: ";").press(on: .us) == Press(keyCode: 41, modifiers: [.control, .option]))
+    #expect(MenuShortcut(modifiers: 14, character: ":").press(on: .us) == Press(keyCode: 41, modifiers: [.control, .option, .shift]))
+    #expect(MenuShortcut(modifiers: 0, character: "?").press(on: .us) == Press(keyCode: 44, modifiers: [.command, .shift]))
+  }
+
+  /// Arrows come with a character from the private-use area beside the key code, and macOS's own Move & Resize with the code alone.
+  @Test func aVirtualKeyIsTheKeyWhateverTheCharacterSays() {
+    #expect(
+      MenuShortcut(modifiers: 6, character: "\u{F702}", virtualKey: 123).press(on: .us)
+        == Press(keyCode: 123, modifiers: [.command, .control, .option]))
+    #expect(MenuShortcut(modifiers: 12, virtualKey: 36).press(on: .us) == Press(keyCode: 36, modifiers: [.control]))
+    #expect(MenuShortcut(modifiers: 2, character: "\u{238B}", virtualKey: 53).press(on: .us) == Press(keyCode: 53, modifiers: [.command, .option]))
+  }
+
+  /// 16 is fn, which no header mentions. No shortcut of Arbor's has it, and fn⌃← is not ⌃←.
+  @Test func whatNeedsTheGlobeKeyIsNoShortcutOfArbors() {
+    for modifiers in [20, 24, 28, 29, 31] { #expect(MenuShortcut(modifiers: modifiers, virtualKey: 123).press(on: .us) == nil) }
+  }
+
+  @Test func whatCannotBeToldIsLeftOut() {
+    #expect(MenuShortcut(modifiers: 0).press(on: .us) == nil)
+    #expect(MenuShortcut(modifiers: 0, character: "").press(on: .us) == nil)
+    #expect(MenuShortcut(modifiers: 0, character: "AB").press(on: .us) == nil)
+    #expect(MenuShortcut(modifiers: 0, character: "ü").press(on: .us) == nil, "this keyboard does not type it")
+    #expect(MenuShortcut(modifiers: -1, character: "A").press(on: .us) == nil)
+    #expect(MenuShortcut(modifiers: 0, virtualKey: -3).press(on: .us) == nil)
+  }
+
+  /// A menu's letter means the key that types it, as a shortcut of Arbor's does (F44).
+  @Test func theLetterFollowsTheKeyboardLayout() {
+    let german = KeyLayout(name: "German", plain: [6: "y", 16: "z", 41: "ö", 43: ","], shifted: [43: ";"])
+    #expect(MenuShortcut(modifiers: 14, character: "Z").press(on: german) == Press(keyCode: 16, modifiers: [.control, .option]))
+    #expect(MenuShortcut(modifiers: 14, character: ";").press(on: german) == Press(keyCode: 43, modifiers: [.control, .option, .shift]))
+    #expect(MenuShortcut(modifiers: 14, character: ":").press(on: german) == nil, "nothing is guessed from a US keyboard on another")
+  }
+
+  @Test func aReadingIsTheSetOfWhatCanBePressed() {
+    let reading = MenuBarReading(
+      bundleID: "com.example.editor", appName: "Editor",
+      shortcuts: [
+        MenuShortcut(modifiers: 0, character: "Q"), MenuShortcut(modifiers: 0, character: "Q"), MenuShortcut(modifiers: 28, virtualKey: 123),
+      ])
+    #expect(reading.presses(on: .us) == [Press(keyCode: 12, modifiers: [.command])])
+    #expect(reading.isComplete)
+  }
+}
diff --git a/Tests/ArborKitTests/AppShortcutTests.swift b/Tests/ArborKitTests/AppShortcutTests.swift
new file mode 100644
index 00000000..a4e1f627
--- /dev/null
+++ b/Tests/ArborKitTests/AppShortcutTests.swift
@@ -0,0 +1,177 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import Foundation
+import Testing
+
+/// Arbor's shortcuts that the app in front has in its own menu bar (Controller+AppShortcuts.swift; collab/IDEAS.md, I16).
+@Suite @MainActor struct AppShortcutTests {
+  /// An app whose menu bar has ⌘Q, ⌃⌥Z, ⌃⌥⇧/ written as ⌃⌥?, ⌃⌥⌘←, and fn⌃⌥⇧←, which is nobody's business.
+  static let chat = MenuBarReading(
+    bundleID: "com.example.chat", appName: "Chat",
+    shortcuts: [
+      MenuShortcut(modifiers: 0, character: "Q"), MenuShortcut(modifiers: 14, character: "Z"), MenuShortcut(modifiers: 14, character: "?"),
+      MenuShortcut(modifiers: 6, character: "\u{F702}", virtualKey: 123), MenuShortcut(modifiers: 31, virtualKey: 123),
+    ])
+
+  final class Asked { var times = 0 }
+
+  func makeHarness(_ reading: MenuBarReading? = chat, settings: Settings = Settings()) -> (Harness, Asked) {
+    let h = Harness(settings: settings)
+    let asked = Asked()
+    h.controller.menuBarOfTheAppInFront = {
+      asked.times += 1
+      return reading
+    }
+    h.system.open(app: "Chat", bundleID: "com.example.chat")
+    h.start()
+    return (h, asked)
+  }
+
+  @Test func bindingsListsEachKeyTheAppHasToo() {
+    let (h, _) = makeHarness()
+    let reply = h.run("bindings")
+    #expect(reply.message.hasSuffix(", 3 also Chat's"), "\(reply.message)")
+    let text = reply.text ?? ""
+    #expect(text.contains("⌃⌥Z is in Chat’s menu bar too: Arbor takes it for `undo`, and paused or quit it is Chat’s."))
+    #expect(text.contains("⌃⌥⇧/ is in Chat’s menu bar too: Arbor takes it for `show-shortcuts`"), "the menu writes it ⌃⌥?: \(text)")
+    #expect(text.contains("⌃⌥⌘← is in Chat’s menu bar too: Arbor takes it for `dock left`"))
+    #expect(!text.contains("⌃⌥⇧← is in"), "what needs the Globe key is another shortcut")
+    #expect(text.contains(AppShortcutClashes.limit), "a list must not pass for a clean bill")
+  }
+
+  @Test func anAppWithNoneOfThemIsSaidToo() {
+    let (h, _) = makeHarness(MenuBarReading(bundleID: "com.example.notes", appName: "Notes", shortcuts: [MenuShortcut(modifiers: 0, character: "N")]))
+    let reply = h.run("bindings")
+    #expect(!reply.message.contains("also Notes"))
+    #expect(reply.text?.contains("Notes has none of Arbor’s shortcuts in its menu bar.") == true)
+    #expect(reply.text?.contains(AppShortcutClashes.limit) == true)
+  }
+
+  @Test func aMenuBarReadInPartSaysSo() {
+    var slow = Self.chat
+    slow.isComplete = false
+    let (h, _) = makeHarness(slow)
+    #expect(h.run("bindings").text?.contains("There may be more (as far as it could be read: Chat was slow to answer).") == true)
+    slow.shortcuts = []
+    let (other, _) = makeHarness(slow)
+    #expect(
+      other.run("bindings").text?.contains("Chat has none of Arbor’s shortcuts in its menu bar (as far as it could be read: Chat was slow to answer).") == true)
+  }
+
+  @Test func doctorHasARowForIt() {
+    let (h, _) = makeHarness()
+    let text = h.run("doctor").text ?? ""
+    #expect(text.contains("Shortcuts of the app in front: ⌃⌥⌘← is in Chat’s menu bar too"), "\(text)")
+    #expect(text.contains(AppShortcutClashes.limit))
+  }
+
+  /// Making a shortcut is asking about it.
+  @Test func bindSaysThatTheAppInFrontHasTheKey() {
+    let reading = MenuBarReading(bundleID: "com.example.chat", appName: "Chat", shortcuts: [MenuShortcut(modifiers: 14, character: "X")])
+    let (h, _) = makeHarness(reading)
+    #expect(h.run("bind ctrl+opt+x show-all").message.hasSuffix("; mind that ⌃⌥X is in Chat’s menu bar too"))
+    #expect(!h.run("bind ctrl+opt+y show-all").message.contains("menu bar"))
+  }
+
+  /// Hundreds of calls into every app a person opens, unasked and unseen, would be Arbor doing something by itself (QUESTIONS Q29).
+  @Test func nobodyReadsAMenuBarUnasked() {
+    let (h, asked) = makeHarness()
+    let notes = h.system.open(app: "Notes")
+    h.system.userFocus(notes)
+    h.run("dock \(notes.rawValue) left")
+    h.key("ctrl+opt+space")
+    h.run("status")
+    h.run("pause")
+    h.run("resume")
+    h.scheduler.advance(by: 600)
+    // What the app does at every start, for the log.
+    h.controller.logSetupProblems()
+    #expect(asked.times == 0)
+    h.run("bindings")
+    #expect(asked.times == 1)
+  }
+
+  @Test func whereNobodyCanTellNothingIsSaid() {
+    let (silent, _) = makeHarness(nil)
+    #expect(silent.run("bindings").text?.contains("menu bar") == false)
+    var off = Settings()
+    off.hotkeysEnabled = false
+    let (h, asked) = makeHarness(settings: off)
+    #expect(h.run("bindings").text?.contains("menu bar") == false)
+    #expect(asked.times == 0, "with no shortcut of Arbor's there is nothing to clash")
+  }
+
+  /// Without the permission Accessibility answers nothing, and asking would only take time.
+  @Test func withoutThePermissionNobodyAsks() {
+    let (h, asked) = makeHarness()
+    h.watchAccessibility()
+    h.controller.accessibilityGranted = false
+    h.run("bindings")
+    h.run("doctor")
+    #expect(asked.times == 0)
+  }
+
+  /// The log gets the bundle id and the keys. Not the app's name, not the command of a person's own shortcut, which can hold a name they gave.
+  @Test func theLogHoldsTheBundleIDAndTheKeysAndNothingElse() {
+    let (h, _) = makeHarness()
+    h.run("bind ctrl+opt+z go Letters to Anna")
+    let clashes = h.controller.appShortcutClashes(with: Self.chat)
+    #expect(clashes.logged == "shortcuts: com.example.chat has ⌃⌥⌘← ⌃⌥Z ⌃⌥⇧/ in its menu bar too (5 read)", "\(clashes.logged)")
+    #expect(!clashes.logged.contains("Anna") && !clashes.logged.contains("Chat"))
+  }
+
+  @Test func theLetterIsTheOneTheKeyboardTypes() {
+    let (h, _) = makeHarness(MenuBarReading(bundleID: nil, appName: "Chat", shortcuts: [MenuShortcut(modifiers: 14, character: "Z")]))
+    h.controller.keyboardLayoutChanged(SampleKeyLayouts.byName["german"]!)
+    #expect(h.run("bindings").text?.contains("⌃⌥Z is in Chat’s menu bar too: Arbor takes it for `undo`") == true)
+  }
+}
+
+/// The census: Arbor's defaults held against the menu bars of the apps on a hosted Mac (collab/evidence/menu-keys; docs/KEYBOARD.md has the table).
+/// So that a default that an app also uses is found here, before a person meets it.
+@Suite @MainActor struct MenuKeyCensusTests {
+  static let folder = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+    .appendingPathComponent("collab/evidence/menu-keys")
+
+  /// Bundle id to what its menu bar held: a line is modifiers, the character's scalars in hex or `-`, the virtual key or `-`.
+  static func readings() throws -> [MenuBarReading] {
+    try FileManager.default.contentsOfDirectory(at: folder, includingPropertiesForKeys: nil).filter { $0.pathExtension == "tsv" }
+      .sorted { $0.path < $1.path }
+      .map { file in
+        let shortcuts = try String(contentsOf: file, encoding: .utf8).split(separator: "\n").compactMap { line -> MenuShortcut? in
+          let fields = line.split(separator: "\t").map(String.init)
+          guard fields.count == 3, let modifiers = Int(fields[0]) else { return nil }
+          let scalars = fields[1] == "-" ? [] : fields[1].split(separator: ",").compactMap { UInt32($0, radix: 16).flatMap(Unicode.Scalar.init) }
+          return MenuShortcut(
+            modifiers: modifiers, character: scalars.isEmpty ? nil : String(String.UnicodeScalarView(scalars)), virtualKey: Int(fields[2]))
+        }
+        let name = file.deletingPathExtension().lastPathComponent
+        return MenuBarReading(bundleID: name, appName: name, shortcuts: shortcuts)
+      }
+  }
+
+  func clashes() throws -> [String] {
+    let h = Harness()
+    return try Self.readings().flatMap { reading in
+      h.controller.appShortcutClashes(with: reading).bindings.map { "\($0.chord.text) \(reading.appName)" }
+    }
+  }
+
+  @Test func theCensusIsThere() throws {
+    let readings = try Self.readings()
+    #expect(readings.count >= 60)
+    #expect(readings.allSatisfy { $0.shortcuts.count >= 20 }, "every app has at least the Apple menu's and its own ⌘Q, ⌘H, ⌘W")
+  }
+
+  /// The core of the map: ⌃⌥ and one key. None of them is in any menu bar that was read.
+  @Test func noDefaultOnControlOptionAndOneKeyIsInAnyMenuBar() throws {
+    #expect(try clashes().filter { !$0.contains("cmd") && !$0.contains("shift") } == [])
+  }
+
+  /// Whoever adds a default that an app has too hears of it here, and either chooses another key or writes the clash into docs/KEYBOARD.md and this list.
+  @Test func theWholeMapClashesOnlyWhereTheTableSaysSo() throws {
+    let known: Set<String> = ["ctrl+opt+cmd+left com.apple.dt.Xcode", "ctrl+opt+cmd+right com.apple.dt.Xcode"]
+    #expect(Set(try clashes()).subtracting(known) == [])
+  }
+}
