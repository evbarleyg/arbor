+# Story: a chat app has a shortcut of its own on ⌃⌥Z, in its menu bar. While Arbor runs the key is Arbor's; paused or quit, the same fingers reach the
+# app. So that the clash is found before a person meets it, Arbor reads the menu bar of the app in front when somebody asks, and lists each of
+# its own keys that the app has too (IDEAS I16; QUESTIONS Q29, 2; board 0.1). Only then: it reads nothing by itself.
+open Chat
+open Notes
+menu-key Chat ctrl+opt+z
+menu-key Chat cmd+q
+menu-key Notes cmd+n
+focus 101
+bindings
+expect replied ⌃⌥Z is in Chat’s menu bar too: Arbor takes it for `undo`, and paused or quit it is Chat’s.
+# A short list must not pass for a clean bill.
+expect replied Only what an app shows in its menus can be seen
+doctor
+expect replied Shortcuts of the app in front: ⌃⌥Z is in Chat’s menu bar too
+# Another app in front, another answer.
+focus 102
+bindings
+expect replied Notes has none of Arbor’s shortcuts in its menu bar.
+# Making a shortcut is asking about it.
+menu-key Notes ctrl+opt+x
+bind ctrl+opt+x show-all
+expect replied mind that ⌃⌥X is in Notes’s menu bar too
diff --git a/scripts/mac-shell/check-app-shortcuts.sh b/scripts/mac-shell/check-app-shortcuts.sh
new file mode 100755
index 00000000..1b2d61ce
--- /dev/null
+++ b/scripts/mac-shell/check-app-shortcuts.sh
@@ -0,0 +1,104 @@
+#!/bin/bash
+# Arbor lists each of its own shortcuts that the app in front has in its menu bar too (collab/IDEAS.md, I16; Controller+AppShortcuts.swift). On real menu bars:
+#
+#   scripts/mac-shell/run.sh scripts/mac-shell/check-app-shortcuts.sh
+#
+# THE QUESTIONS ONLY A MAC CAN ANSWER: does Input/MenuBarReader.swift, which asks for an item's four attributes in ONE call, read what menukeys.swift reads in
+# four; how long does it keep whoever asked waiting, with a small app and with one of 300 items in front; does it read the menu bar of the app a
+# person is in while a window of Arbor's own has the keyboard; and is it true that nothing is read unasked.
+#
+# The witness (keys.swift) has ⌃⌥A in its menu bar. TextEdit has none of Arbor's keys and some three hundred items.
+#
+# Only on GitHub's Macs: it opens and quits TextEdit, and brings apps to the front.
+source "$(dirname "$0")/lib-apps.sh"
+needs_throwaway_mac "open and quit TextEdit, and bring apps to the front"
+
+KEYS="$ARBOR_ROOT/.build/mac-shell/keys"
+KEYS_APP="$ARBOR_ROOT/.build/mac-shell/ArborKeys.app"
+KEYS_ID=dev.arbor.test.keys
+KEYS_LOG="$ARBOR_OUT/keys.log"
+KEYS_PID=""
+
+front_is() { [ "$("$KEYS" frontmost)" = "$1" ]; }
+now_ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000'; }
+reads() { grep -c "in its menu bar" "$ARBOR_HOME/arbor.log" 2>/dev/null || true; }
+# ask <command…>: the reply in $REPLY_TEXT, how long it took in $TOOK.
+ask() {
+  local began
+  began=$(now_ms)
+  REPLY_TEXT=$("$ARBOR_BIN/arborctl" "$@" 2>&1)
+  TOOK=$(($(now_ms) - began))
+  echo "> $* ($TOOK ms)"
+}
+replied() { printf '%s\n' "$REPLY_TEXT" | grep -qF "$1"; }
+quick() { [ "$TOOK" -lt 2500 ]; }
+
+apps_build
+swiftc -O -swift-version 5 "$ARBOR_ROOT/scripts/mac-shell/keys.swift" -o "$KEYS" > "$ARBOR_OUT/build-keys.log" 2>&1 || {
+  cat "$ARBOR_OUT/build-keys.log"
+  die "scripts/mac-shell/keys.swift did not compile"
+}
+rm -rf "$KEYS_APP"
+mkdir -p "$KEYS_APP/Contents/MacOS"
+cp "$KEYS" "$KEYS_APP/Contents/MacOS/keys"
+cat > "$KEYS_APP/Contents/Info.plist" <<PLIST
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+  <key>CFBundleIdentifier</key><string>$KEYS_ID</string>
+  <key>CFBundleExecutable</key><string>keys</string>
+  <key>CFBundleName</key><string>ArborKeys</string>
+  <key>CFBundlePackageType</key><string>APPL</string>
+</dict></plist>
+PLIST
+at_exit 'kill_started $KEYS_PID; rm -rf "$KEYS_APP"'
+
+step "Arbor, and an app in front that has ⌃⌥A in its menu bar"
+arbor_start 1 ARBOR_NO_HOTKEYS=0 ARBOR_NO_STATUS_ITEM=0
+ctl bind ctrl+opt+a show-all
+KEYS_ROADS=menu "$KEYS_APP/Contents/MacOS/keys" app "$KEYS_LOG" 20 520 260 160 9>&- &
+KEYS_PID=$!
+started "$KEYS_PID"
+keys_ready() { grep -q "ready pid=$KEYS_PID " "$KEYS_LOG" 2>/dev/null; }
+eventually keys_ready || die "the witness did not start"
+click 150 620
+eventually front_is "$KEYS_ID"
+sleep 3
+check "nothing was read unasked: not at the start, not when the app came forward" test "$(reads)" = 0
+
+step "bindings, doctor, bind"
+ask bindings
+printf '%s\n' "$REPLY_TEXT" | grep -i "menu" | sed 's/^/  /'
+check "bindings lists the key" replied "⌃⌥A is in ArborKeys’s menu bar too: Arbor takes it for \`show-all\`"
+check "and says what cannot be seen" replied "Only what an app shows in its menus can be seen"
+check "nobody waited long" quick
+check "the log has the bundle id and the key" grep -q "shortcuts: $KEYS_ID has ⌃⌥A in its menu bar too" "$ARBOR_HOME/arbor.log"
+check "and not the app's name" test "$(grep -c "ArborKeys" "$ARBOR_HOME/arbor.log")" = 0
+ask doctor
+check "doctor has the row" replied "Shortcuts of the app in front: ⌃⌥A is in ArborKeys’s menu bar too"
+ctl unbind ctrl+opt+a
+ask bind ctrl+opt+a show-all
+check "bind says so of the key it makes" replied "mind that ⌃⌥A is in ArborKeys’s menu bar too"
+
+step "with a window of Arbor's own in front it is still the person's app that is read"
+ctl settings-window
+sleep 1
+ask bindings
+check "the app whose menu bar it is" replied "⌃⌥A is in ArborKeys’s menu bar too"
+ctl settings-window close
+shot 10-asked
+
+step "an app with some three hundred items"
+apps_scratch
+app_open com.apple.TextEdit "$APPS_SCRATCH/oak.txt"
+apptool activate "$APP_PID"
+eventually front_is com.apple.TextEdit
+ask bindings
+printf '%s\n' "$REPLY_TEXT" | grep -i "menu bar" | sed 's/^/  /'
+check "TextEdit has none of them" replied "TextEdit has none of Arbor’s shortcuts in its menu bar."
+check "nobody waited long" quick
+grep "in its menu bar" "$ARBOR_HOME/arbor.log" | tail -n 1 | sed 's/.*shortcuts:/  shortcuts:/'
+ask bindings
+echo "  a second time: $TOOK ms"
+app_quit "$APP_PID"
+arbor_stop
diff --git a/scripts/mac-shell/probe-claimed-keys-electron.sh b/scripts/mac-shell/probe-claimed-keys-electron.sh
new file mode 100755
index 00000000..1c81c421
--- /dev/null
+++ b/scripts/mac-shell/probe-claimed-keys-electron.sh
@@ -0,0 +1,137 @@
+#!/bin/bash
+# Does an app built on Electron hear a key that is Arbor's hot key? (collab/IDEAS.md, I16; the companion of check-claimed-keys.sh.)
+#
+#   scripts/mac-shell/run.sh --priority 1 scripts/mac-shell/probe-claimed-keys-electron.sh
+#
+# Many widely used desktop apps are web pages in Electron, and take their shortcuts in ways of their own: an accelerator in the menu, a listener in
+# the page, a listener before the page, a "global shortcut". The witness here is such an app, made on the spot, that has ⌃⌥A in all four ways and writes
+# down which of them ran.
+#
+# THE QUESTION ONLY A MAC CAN ANSWER: with ⌃⌥A registered by Arbor, does any of the four hear it? If one does, both act, and taking the key is not enough.
+# The controls: without Arbor, and with Arbor paused, the first three must run.
+#
+# Only on GitHub's Macs: it downloads Electron from the package registry and types into whatever has the keyboard.
+source "$(dirname "$0")/lib-apps.sh"
+needs_throwaway_mac "download Electron, and press keys that land in whichever app has the keyboard"
+
+scratch_dir electron WORK
+LOG="$ARBOR_OUT/electron-keys.log"
+RESULTS="$ARBOR_OUT/results-electron.txt"
+WITNESS_PID=""
+X=180
+Y=560
+: > "$RESULTS"
+
+apps_build
+cd "$WORK" || die "no scratch folder"
+cat > package.json <<'JSON'
+{ "name": "witness", "version": "1.0.0", "main": "main.js" }
+JSON
+cat > index.html <<'HTML'
+<!doctype html><body><input id="field" autofocus>
+<script>
+  const { ipcRenderer } = require('electron')
+  for (const kind of ['keydown', 'keyup']) {
+    document.addEventListener(kind, event =>
+      ipcRenderer.send('heard', `page ${kind} code=${event.code} ctrl=${event.ctrlKey} alt=${event.altKey} repeat=${event.repeat}`), true)
+  }
+</script></body>
+HTML
+cat > main.js <<'JS'
+const { app, BrowserWindow, Menu, globalShortcut, ipcMain } = require('electron')
+const fs = require('fs')
+const write = text => fs.appendFileSync(process.env.WITNESS_LOG, new Date().toISOString().slice(11, 23) + ' ' + text + '\n')
+ipcMain.on('heard', (event, text) => write(text))
+app.whenReady().then(() => {
+  Menu.setApplicationMenu(Menu.buildFromTemplate([
+    { label: 'Witness', submenu: [{ label: 'Witness', accelerator: 'Ctrl+Alt+A', click: () => write('menu accelerator ran') }, { role: 'quit' }] },
+  ]))
+  const window = new BrowserWindow({
+    x: 20, y: 440, width: 320, height: 240, webPreferences: { nodeIntegration: true, contextIsolation: false },
+  })
+  window.webContents.on('before-input-event', (event, input) =>
+    write(`before-input ${input.type} code=${input.code} ctrl=${input.control} alt=${input.alt}`))
+  if (process.env.WITNESS_GLOBAL) {
+    write('globalShortcut registered: ' + globalShortcut.register('Ctrl+Alt+A', () => write('globalShortcut ran')))
+  }
+  window.loadFile('index.html').then(() => write('ready pid=' + process.pid + ' electron=' + process.versions.electron))
+})
+JS
+step "Electron, from the package registry"
+limit 300 npm install --no-audit --no-fund --loglevel=error electron > "$ARBOR_OUT/npm.log" 2>&1 || { tail -n 20 "$ARBOR_OUT/npm.log"; die "Electron did not install"; }
+ELECTRON="$WORK/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
+# The package fetches the app itself in a step of its own, which the registry's client does not run everywhere (a hosted Mac, 2026-10-15: 13 packages, no app).
+[ -x "$ELECTRON" ] || limit 300 node node_modules/electron/install.js >> "$ARBOR_OUT/npm.log" 2>&1 || tail -n 20 "$ARBOR_OUT/npm.log"
+[ -x "$ELECTRON" ] || die "there is no $ELECTRON"
+at_exit 'kill_started $WITNESS_PID'
+
+count() { grep -c "$1" "$LOG" 2>/dev/null || true; }
+witness() {
+  [ -n "$WITNESS_PID" ] && { kill_started "$WITNESS_PID"; WITNESS_PID=""; sleep 1; }
+  rm -f "$LOG"
+  WITNESS_LOG="$LOG" WITNESS_GLOBAL="${1:-}" "$ELECTRON" "$WORK" > "$ARBOR_OUT/electron-stderr.log" 2>&1 9>&- &
+  WITNESS_PID=$!
+  started "$WITNESS_PID"
+  ready() { grep -q "ready pid=" "$LOG" 2>/dev/null; }
+  eventually ready || eventually ready || eventually ready || die "the Electron app did not start"
+  grep "ready\|registered" "$LOG" | sed 's/^/  /'
+}
+HEARD=0
+press() {
+  local before lines
+  # `arrange` lays the test window over everything.
+  apptool activate "$WITNESS_PID"
+  sleep 0.4
+  click "$X" "$Y"
+  sleep 0.4
+  before=$(wc -l < "$LOG" | tr -d ' ')
+  lines=$(arbor_log_lines)
+  key ctrl+opt+a
+  sleep 1
+  HEARD=$(tail -n "+$((before + 1))" "$LOG" | grep -c "KeyA\|ran")
+  echo "RESULT | $1 | in front: $("$ARBOR_POINTER" front 2>/dev/null) (the witness: $WITNESS_PID) | the app heard: $HEARD | lines in Arbor's log: $(arbor_log_since "$lines" | grep -c "arrange")" \
+    | tee -a "$RESULTS"
+  tail -n "+$((before + 1))" "$LOG" | grep "KeyA\|ran" | sed 's/^/    /'
+}
+heard() { [ "$HEARD" -gt 0 ]; }
+nothing() { [ "$HEARD" -eq 0 ]; }
+
+step "0. the control: no Arbor"
+witness
+shot 00-the-electron-witness
+press "no Arbor"
+check "with nobody to take it, the app hears ⌃⌥A: the witness works" heard
+
+step "1. Arbor runs and holds ⌃⌥A"
+arbor_start 1 ARBOR_NO_HOTKEYS=0 ARBOR_NO_STATUS_ITEM=0
+press "Arbor running"
+check "the app hears nothing" nothing
+press "Arbor running, a second time"
+apptool activate "$WITNESS_PID"
+sleep 0.4
+click "$X" "$Y"
+before=$(wc -l < "$LOG" | tr -d ' ')
+key ctrl+opt+a --down
+key ctrl+opt+a --repeat 12
+key ctrl+opt+a --up
+sleep 0.6
+echo "RESULT | Arbor running, the key held with 12 repeats | the app heard: $(tail -n "+$((before + 1))" "$LOG" | grep -c "KeyA\|ran")" | tee -a "$RESULTS"
+
+step "2. Arbor is paused: the second control"
+ctl pause
+press "Arbor paused"
+ctl resume
+
+step "3. the app has a global shortcut on the same chord, registered after Arbor's"
+witness 1
+press "Arbor running; the app's globalShortcut came second"
+
+step "4. and registered before Arbor's"
+arbor_quit
+arbor_relaunch
+press "Arbor running; the app's globalShortcut came first"
+grep "already in use\|registered [0-9]* shortcuts" "$ARBOR_HOME/arbor.log" | tail -n 2
+
+step "the table"
+cat "$RESULTS"
+arbor_stop
