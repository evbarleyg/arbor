diff --git a/Sources/ArborKit/Controller/Controller+AppShortcuts.swift b/Sources/ArborKit/Controller/Controller+AppShortcuts.swift
new file mode 100644
index 00000000..aa721e44
--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+AppShortcuts.swift
@@ -0,0 +1,80 @@
+import ArborCore
+
+/// The shortcuts of Arbor's that the app in front has in its own menu bar (`MenuShortcut`; collab/IDEAS.md, I16).
+///
+/// While Arbor holds a key the app does not get it. The moment Arbor does not (paused, quit, crashed) the same fingers reach the app, which does
+/// with the key whatever it does. So a clash is worth knowing before anybody meets it.
+///
+/// **Arbor reads a menu bar only when a person asks** (QUESTIONS Q29): `bindings`, `doctor`, and `bind`, which is an asking too. Not when an app
+/// comes to the front: hundreds of calls into every app a person opens, unasked and unseen, is Arbor doing something by itself. What guards the
+/// defaults is the census on hosted Macs (docs/KEYBOARD.md).
+///
+/// What this cannot see, and says so: a shortcut that an app takes without showing it in a menu, as a web page in an app's window can, and a
+/// global hot key of another program's, which macOS tells nobody about.
+public struct AppShortcutClashes: Equatable, Sendable {
+  public let reading: MenuBarReading
+  /// Arbor's shortcuts that are in the app's menu bar too, sorted as `bindings` lists them.
+  public let bindings: [KeyBinding]
+
+  /// What cannot be seen, in one sentence, wherever the list is shown: a short list must not pass for a clean bill.
+  public static let limit = "Only what an app shows in its menus can be seen: not a shortcut it takes in a page, nor another program’s global one."
+
+  /// For `bindings` and `doctor`: one line for each, or one that says there is none.
+  public var sentences: [String] {
+    let partly = reading.isComplete ? "" : " (as far as it could be read: \(reading.appName) was slow to answer)"
+    guard !bindings.isEmpty else { return ["\(reading.appName) has none of Arbor’s shortcuts in its menu bar\(partly)."] }
+    return bindings.map { "\($0.label) is in \(reading.appName)’s menu bar too: Arbor takes it for `\($0.command.text)`, and paused or quit it is \(reading.appName)’s." }
+      + (partly.isEmpty ? [] : ["There may be more\(partly)."])
+  }
+
+  /// For the log: the bundle id and the keys, and nothing else. Never a title, which is not even read, nor the command of a person's own shortcut.
+  public var logged: String {
+    let app = reading.bundleID ?? "an app without a bundle id"
+    let partly = reading.isComplete ? "" : ", read in part"
+    return bindings.isEmpty
+      ? "shortcuts: \(app) has none of Arbor's in its menu bar (\(reading.shortcuts.count) read\(partly))"
+      : "shortcuts: \(app) has \(bindings.map(\.label).joined(separator: " ")) in its menu bar too (\(reading.shortcuts.count) read\(partly))"
+  }
+}
+
+extension Controller {
+  /// Reads the menu bar of the app in front, now, and holds the shortcuts in effect against it. Nil where nobody can tell: `menuBarOfTheAppInFront`
+  /// is not set, there is no such app, it has no menu bar, Arbor lacks the permission; or with Arbor's shortcuts off, when there is nothing to clash.
+  /// Writes what it found to the log. Takes as long as the app takes to answer, up to the reader's limit: only for when somebody asks.
+  func askAboutAppShortcuts() -> AppShortcutClashes? {
+    guard let reading = readMenuBar() else { return nil }
+    let clashes = appShortcutClashes(of: effectiveBindings.bindings, with: reading)
+    Log.info(clashes.logged)
+    return clashes
+  }
+
+  /// It does not go through a protocol in Platform/, so it sees to its own line in a trace: numbers, a character each, the app. No title is read.
+  private func readMenuBar() -> MenuBarReading? {
+    guard settings.hotkeysEnabled, accessibilityGranted, let read = menuBarOfTheAppInFront else { return nil }
+    return traceRecorder?.read("menuBarOfTheAppInFront") { read() } ?? read()
+  }
+
+  func appShortcutClashes(of bindings: [KeyBinding], with reading: MenuBarReading) -> AppShortcutClashes {
+    let presses = reading.presses(on: layoutInEffect)
+    return AppShortcutClashes(
+      reading: reading,
+      bindings: bindings.filter { presses.contains(MenuShortcut.Press(keyCode: $0.keyCode, modifiers: $0.modifiers)) }
+        .sorted { ($0.command.text, $0.chord.text) < ($1.command.text, $1.chord.text) })
+  }
+
+  /// What `bind` adds to its reply about a shortcut that was just made, or nil.
+  func cautionAboutTheAppInFront(_ chord: KeyChord, running command: Command) -> String? {
+    guard let reading = readMenuBar() else { return nil }
+    let clashes = appShortcutClashes(of: [KeyBinding(chord, command, layout: layoutInEffect)], with: reading)
+    guard let binding = clashes.bindings.first else { return nil }
+    Log.info(clashes.logged)
+    return "\(binding.label) is in \(reading.appName)’s menu bar too"
+  }
+}
+
+extension Controller {
+  /// The shortcuts in effect held against a menu bar that was read some other time, as the census does (`MenuKeyCensusTests`). It only asks.
+  public func appShortcutClashes(with reading: MenuBarReading) -> AppShortcutClashes {
+    appShortcutClashes(of: effectiveBindings.bindings, with: reading)
+  }
+}
