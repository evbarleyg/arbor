@@ -0,0 +1,208 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+/// `Screens` held to what hosted Macs did with position calls through Accessibility, no Arbor running.
+@Suite struct ScreensTests {
+  /// The three windows of the first table, at the sizes they had, with the title bars that their rest above the Dock showed.
+  enum Window {
+    case text, lives, java
+    var size: CGSize {
+      switch self {
+      case .text: CGSize(width: 656, height: 422)
+      case .lives: CGSize(width: 1000, height: 600)
+      case .java: CGSize(width: 900, height: 750)
+      }
+    }
+    var titleBar: CGFloat {
+      switch self {
+      case .text: 32
+      case .lives: 52
+      case .java: 28
+      }
+    }
+  }
+
+  /// The six arrangements, each display with the visible frame it had. t1: the main display alone; t2: a wider one below, to which macOS took the Dock; t3: a left neighbour that
+  /// begins 500 lower; t4: that and one at the right; t5: one above; t6: a right neighbour that begins 700 higher.
+  static func arrangement(_ name: String) -> Screens {
+    let main = (frame: CGRect(x: 0, y: 0, width: 1600, height: 900), visibleFrame: CGRect(x: 0, y: 31, width: 1600, height: name == "t2" ? 869 : 791))
+    let leftAndLower = (frame: CGRect(x: -1280, y: 500, width: 1280, height: 800), visibleFrame: CGRect(x: -1280, y: 531, width: 1280, height: 769))
+    switch name {
+    case "t2": return Screens([main, (CGRect(x: -160, y: 900, width: 1920, height: 1080), CGRect(x: -160, y: 931, width: 1920, height: 971))])
+    case "t3": return Screens([main, leftAndLower])
+    case "t4": return Screens([main, leftAndLower, (CGRect(x: 1600, y: 0, width: 1920, height: 1080), CGRect(x: 1600, y: 31, width: 1920, height: 1049))])
+    case "t5": return Screens([main, (CGRect(x: 0, y: -800, width: 1280, height: 800), CGRect(x: 0, y: -769, width: 1280, height: 769))])
+    case "t6": return Screens([main, (CGRect(x: 1600, y: -700, width: 1920, height: 1080), CGRect(x: 1600, y: -669, width: 1920, height: 1049))])
+    default: return Screens([main])
+    }
+  }
+
+  /// All 78 calls of one run: the arrangement, the window, the x and y it was asked for, the y that was read back at once, the y it lay at a second later. x and the size were kept in all.
+  static let calls: [(String, Window, CGFloat, CGFloat, CGFloat, CGFloat)] = [
+    ("t2", .text, 1599, 0, 31, 31), ("t2", .text, 1599, -50, 31, 31), ("t2", .text, -655, 0, 31, 31), ("t2", .text, -655, -50, 31, 31),
+    ("t2", .text, 1599, 899, 931, 931), ("t2", .lives, 1599, 0, 31, 31), ("t2", .lives, 1599, -50, 31, 31), ("t2", .lives, -999, 0, 31, 31),
+    ("t2", .lives, -999, -50, 31, 31), ("t2", .lives, 1599, 899, 931, 931), ("t2", .java, 1599, 0, 31, 31), ("t2", .java, 1599, -50, 31, 31),
+    ("t2", .java, -899, 0, 31, 31), ("t2", .java, -899, -50, 31, 31), ("t2", .java, 1599, 899, 931, 931), ("t3", .text, 1599, 0, 31, 31),
+    ("t3", .text, 1599, -50, 31, 31), ("t3", .text, -655, 0, 31, 31), ("t3", .text, -655, -50, 531, 531), ("t3", .lives, 1599, 0, 31, 31),
+    ("t3", .lives, 1599, -50, 31, 31), ("t3", .lives, -999, 0, 31, 531), ("t3", .lives, -999, -50, 31, 531), ("t3", .java, 1599, 0, 31, 31),
+    ("t3", .java, 1599, -50, 31, 31), ("t3", .java, -899, 0, 31, 531), ("t3", .java, -899, -50, 531, 531), ("t5", .text, 1599, 0, 31, 31),
+    ("t5", .text, 1599, -50, 31, 31), ("t5", .text, -655, 0, 31, 31), ("t5", .text, -655, -50, -50, 31), ("t5", .lives, 1599, 0, 31, 31),
+    ("t5", .lives, 1599, -50, 31, 31), ("t5", .lives, -999, 0, 31, 31), ("t5", .lives, -999, -50, -52, 31), ("t5", .java, 1599, 0, 31, 31),
+    ("t5", .java, 1599, -50, 31, 31), ("t5", .java, -899, 0, 31, 31), ("t5", .java, -899, -50, -50, 31), ("t4", .text, 1599, 0, 31, 31),
+    ("t4", .text, 1599, -50, 31, 31), ("t4", .text, -655, 0, 31, 31), ("t4", .text, -655, -50, 531, 531), ("t4", .lives, 1599, 0, 31, 31),
+    ("t4", .lives, 1599, -50, 31, 31), ("t4", .lives, -999, 0, 31, 531), ("t4", .lives, -999, -50, 31, 531), ("t4", .java, 1599, 0, 31, 31),
+    ("t4", .java, 1599, -50, 31, 31), ("t4", .java, -899, 0, 31, 531), ("t4", .java, -899, -50, 531, 531), ("t1", .text, 1599, 0, 31, 31),
+    ("t1", .text, 1599, -50, 31, 31), ("t1", .text, -655, 0, 31, 31), ("t1", .text, -655, -50, 31, 31), ("t1", .text, 1599, 899, 790, 790),
+    ("t1", .lives, 1599, 0, 31, 31), ("t1", .lives, 1599, -50, 31, 31), ("t1", .lives, -999, 0, 31, 31), ("t1", .lives, -999, -50, 31, 31),
+    ("t1", .lives, 1599, 899, 770, 770), ("t1", .java, 1599, 0, 31, 31), ("t1", .java, 1599, -50, 31, 31), ("t1", .java, -899, 0, 31, 31),
+    ("t1", .java, -899, -50, 31, 31), ("t1", .java, 1599, 899, 794, 794), ("t6", .text, 1599, 0, 0, 0), ("t6", .text, 1599, -50, -50, -50),
+    ("t6", .text, -655, 0, 31, 31), ("t6", .text, -655, -50, 31, 31), ("t6", .lives, 1599, 0, 0, 0), ("t6", .lives, 1599, -50, -50, -50),
+    ("t6", .lives, -999, 0, 31, 31), ("t6", .lives, -999, -50, 31, 31), ("t6", .java, 1599, 0, 0, 0), ("t6", .java, 1599, -50, -50, -50),
+    ("t6", .java, -899, 0, 31, 31), ("t6", .java, -899, -50, 31, 31),
+  ]
+  /// The two that `rest` does not give.
+  static func isNotPlayed(_ call: (String, Window, CGFloat, CGFloat, CGFloat, CGFloat)) -> Bool {
+    (call.0 == "t3" || call.0 == "t4") && call.1 == .text && call.3 == -50 && call.2 < 0
+  }
+
+  @Test func whereItCameToRest() {
+    #expect(Self.calls.count == 78 && Self.calls.filter(Self.isNotPlayed).count == 2)
+    for call in Self.calls where !Self.isNotPlayed(call) {
+      let (name, window, x, y, _, rested) = call
+      let rest = Self.arrangement(name).rest(of: CGRect(origin: CGPoint(x: x, y: y), size: window.size), titleBar: window.titleBar)
+      #expect(rest == CGPoint(x: x, y: rested), "\(name): \(window) asked for \(x),\(y)")
+    }
+  }
+
+  /// TextEdit's window, asked to go 50 points above the top left corner beside a left neighbour that begins lower, shares a strip of 1 by 372 points with the main display and nothing
+  /// with the neighbour, and went to the neighbour, below its menu bar, wholly in view. `rest` says the main display's top, and this says that it does.
+  @Test func notPlayed() {
+    for call in Self.calls where Self.isNotPlayed(call) {
+      #expect(call.5 == 531)
+      #expect(Self.arrangement(call.0).rest(of: CGRect(origin: CGPoint(x: call.2, y: call.3), size: call.1.size), titleBar: call.1.titleBar).y == 31)
+    }
+  }
+
+  /// The guess gives every place of all 78: what was read back at once, and where the window lay a second later. In nine the two differ.
+  @Test func theGuessGivesTheWholeWay() {
+    #expect(Self.calls.filter { $0.4 != $0.5 }.count == 9)
+    for (name, window, x, y, atOnce, rested) in Self.calls {
+      let stages = Self.arrangement(name).stages(of: CGRect(origin: CGPoint(x: x, y: y), size: window.size), titleBar: window.titleBar)
+      #expect(stages == (atOnce == rested ? [rested] : [atOnce, rested]).map { CGPoint(x: x, y: $0) }, "\(name): \(window) asked for \(x),\(y)")
+    }
+  }
+
+  /// At the places Arbor asks for, a display's own top and its bottom less 1, the guess ends where `rest` does: 42 of 42.
+  @Test func atADisplaysOwnTopAndBottomTheTwoEndAlike() {
+    let own = Self.calls.filter { $0.3 == 0 || $0.3 == 899 }
+    #expect(own.count == 42)
+    for (name, window, x, y, _, _) in own {
+      let asked = CGRect(origin: CGPoint(x: x, y: y), size: window.size)
+      #expect(Self.arrangement(name).stages(of: asked, titleBar: window.titleBar).last == Self.arrangement(name).rest(of: asked, titleBar: window.titleBar))
+    }
+  }
+
+  // MARK: Sideways
+
+  static let small = CGRect(x: 0, y: 0, width: 1024, height: 768)
+  static let size = CGSize(width: 480, height: 348)
+
+  /// Six places on one display of 1024×768 with the Dock at the right, a window of 480×348, once each; the first of them 20 times of 20 besides.
+  @Test(arguments: [
+    (CGPoint(x: 1023, y: 767), CGPoint(x: 934, y: 740)), (CGPoint(x: 973, y: 767), CGPoint(x: 973, y: 740)), (CGPoint(x: -479, y: 767), CGPoint(x: -479, y: 740)),
+    (CGPoint(x: -479, y: 400), CGPoint(x: -479, y: 400)), (CGPoint(x: -600, y: 767), CGPoint(x: -440, y: 740)), (CGPoint(x: 300, y: 767), CGPoint(x: 300, y: 740)),
+  ]) func besideTheDock(asked: CGPoint, rested: CGPoint) {
+    let screens = Screens([(Self.small, CGRect(x: 0, y: 31, width: 974, height: 737))])
+    #expect(screens.rest(of: CGRect(origin: asked, size: Self.size), titleBar: 28) == rested)
+    #expect(screens.stages(of: CGRect(origin: asked, size: Self.size), titleBar: 28).last == rested)
+  }
+
+  /// That first place with the Dock at the bottom, at the left, and on 1920×1080 beside a second display.
+  @Test func theSameCornerWithTheDockElsewhere() {
+    let corner = CGRect(origin: CGPoint(x: 1023, y: 767), size: Self.size)
+    #expect(Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 674))]).rest(of: corner, titleBar: 28) == CGPoint(x: 1023, y: 677))
+    #expect(Screens([(Self.small, CGRect(x: 50, y: 31, width: 974, height: 737))]).rest(of: corner, titleBar: 28) == CGPoint(x: 1023, y: 740))
+    let two = Screens([
+      (CGRect(x: 0, y: 0, width: 1920, height: 1080), CGRect(x: 0, y: 31, width: 1920, height: 971)),
+      (CGRect(x: 1920, y: 0, width: 1280, height: 720), CGRect(x: 1920, y: 31, width: 1280, height: 689)),
+    ])
+    #expect(two.rest(of: CGRect(origin: CGPoint(x: 1919, y: 1079), size: Self.size), titleBar: 28) == CGPoint(x: 1919, y: 974))
+  }
+
+  /// Wholly off the display, on another day: pulled in until 40 points show; past a Dock at the left, 40 points past the Dock.
+  @Test func whollyOffTheDisplay() {
+    let bottom = Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 674))])
+    #expect(bottom.rest(of: CGRect(origin: CGPoint(x: 1524, y: 200), size: Self.size), titleBar: 28).x == 984)
+    #expect(bottom.rest(of: CGRect(origin: CGPoint(x: -600, y: 200), size: Self.size), titleBar: 28).x == -440)
+    let left = Screens([(Self.small, CGRect(x: 50, y: 31, width: 974, height: 737))])
+    #expect(left.rest(of: CGRect(origin: CGPoint(x: -600, y: 200), size: Self.size), titleBar: 28).x == -390)
+  }
+
+  /// Narrower than 40 points, all of it shows. A guess: nothing narrower than 480 was asked.
+  @Test func narrowerThanWhatIsPulledIn() {
+    let screens = Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 674))])
+    #expect(screens.rest(of: CGRect(x: -600, y: 200, width: 20, height: 300), titleBar: 28).x == 0)
+    #expect(screens.rest(of: CGRect(x: 1524, y: 200, width: 20, height: 300), titleBar: 28).x == 1004)
+  }
+
+  // MARK: Where nobody has looked
+
+  /// What goes further than a Mac was asked is switched off, and there a window rests where the stand-ins had it before any of this was measured. With the switch: what the rule would make
+  /// of it. Each is owed a Mac.
+  @Test func whereNobodyHasLooked() {
+    func rests(_ screens: Screens, _ asked: CGRect, _ titleBar: CGFloat, again: Bool = false, wherever: Bool = false) -> CGPoint {
+      var screens = screens
+      (screens.judgesAgain, screens.mostOfItJudgesWhereverTheCornerIs) = (again, wherever)
+      return screens.rest(of: asked, titleBar: titleBar)
+    }
+    let usual = (frame: CGRect(x: 0, y: 0, width: 1440, height: 900), visibleFrame: CGRect(x: 0, y: 25, width: 1440, height: 875))
+
+    // A bottom corner beside a neighbour that ends 60 points higher: stopped by the main display, the window reaches the neighbour, which has most of it then.
+    let endsHigher = CGRect(x: 1440, y: 0, width: 1280, height: 840)
+    let corner = CGRect(x: 1439, y: 899, width: 640, height: 420)
+    #expect(rests(Screens([usual, (endsHigher, endsHigher)]), corner, 80).y == 820)
+    #expect(rests(Screens([usual, (endsHigher, endsHigher)]), corner, 80, again: true).y == 760)
+
+    // Pushed below the main display's menu bar, a window 480 high comes to reach the left neighbour that begins 500 lower.
+    let high = CGRect(x: -655, y: 0, width: 656, height: 480)
+    #expect(rests(Self.arrangement("t3"), high, 32).y == 31)
+    #expect(rests(Self.arrangement("t3"), high, 32, again: true).y == 531)
+
+    // A desk people have: across a laptop and the monitor below it, the title bar 512 points wide in view above, most of the window below.
+    let desk = Screens([
+      (CGRect(x: 0, y: 0, width: 1512, height: 982), CGRect(x: 0, y: 37, width: 1512, height: 945)),
+      (CGRect(x: -500, y: 982, width: 2560, height: 1440), CGRect(x: -500, y: 1007, width: 2560, height: 1415)),
+    ])
+    let across = CGRect(x: 1000, y: 680, width: 800, height: 600)
+    #expect(rests(desk, across, 28).y == 680)
+    #expect(rests(desk, across, 28, wherever: true).y == 1007)
+
+    // Under the bottom edge, above a display below: all of its width and one row of it on the display its corner is on.
+    let below = (frame: CGRect(x: 0, y: 900, width: 1440, height: 900), visibleFrame: CGRect(x: 0, y: 925, width: 1440, height: 875))
+    let under = CGRect(x: 0, y: 899, width: 640, height: 420)
+    #expect(rests(Screens([usual, below]), under, 28).y == 872)
+    #expect(rests(Screens([usual, below]), under, 28, wherever: true).y == 925)
+  }
+
+  /// Neither switch changes where any of the 78 came to rest, nor any of the places sideways: no call that was made tells them apart.
+  @Test(arguments: [(true, false), (false, true), (true, true)]) func noCallThatWasMadeTellsTheSwitchesApart(again: Bool, wherever: Bool) {
+    for (name, window, x, y, _, _) in Self.calls {
+      var screens = Self.arrangement(name)
+      let asked = CGRect(origin: CGPoint(x: x, y: y), size: window.size)
+      let plain = screens.rest(of: asked, titleBar: window.titleBar)
+      (screens.judgesAgain, screens.mostOfItJudgesWhereverTheCornerIs) = (again, wherever)
+      #expect(screens.rest(of: asked, titleBar: window.titleBar) == plain, "\(name): \(window) asked for \(x),\(y)")
+    }
+  }
+
+  @Test func whoJudges() {
+    let screens = Self.arrangement("t6")
+    #expect(screens.judge(of: CGRect(x: 1599, y: 0, width: 656, height: 422)) == 1, "its corner is on the main display, all but a column of it on the neighbour")
+    #expect(screens.judge(of: CGRect(x: 300, y: 200, width: 656, height: 422)) == 0)
+    #expect(screens.judge(of: CGRect(x: 1598, y: 0, width: 656, height: 422)) == 0, "two columns of it on the display its corner is on: nobody has looked")
+    #expect(screens.judge(of: CGRect(x: -5000, y: 0, width: 10, height: 10)) == 0, "on none: the nearest")
+    #expect(Screens([]).judge(of: .zero) == nil)
+    #expect(Screens([]).rest(of: CGRect(x: 5, y: 6, width: 7, height: 8), titleBar: 28) == CGPoint(x: 5, y: 6))
+  }
+}
