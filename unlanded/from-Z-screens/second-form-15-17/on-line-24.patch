@@ -0,0 +1,94 @@
+import CoreGraphics
+
+/// Where macOS leaves a window that is asked to go somewhere.
+///
+/// A call that sets a window's position is not always taken as it stands: the title bar stays within reach. Which display sees to that, and how, was asked of one hosted
+/// Mac (macOS 26.6, no Arbor running): 78 position calls through Accessibility, of TextEdit, Notes and a Java app, from the main display to its top corners, to 50
+/// points above them and to its bottom right corner; with that display alone, with a wider one below, one above, a left neighbour that begins lower, that and
+/// one at the right, and a right neighbour that begins higher. And six places on one display with the Dock at the right (`collab/reality.json`:
+/// a-title-bar-never-goes-under-the-menu-bar). Arbor reckons with it, and the stand-ins play it: one rule, so that the two cannot part.
+public struct Screens: Equatable, Sendable {
+  public struct Screen: Equatable, Sendable {
+    public var frame: CGRect
+    public var visibleFrame: CGRect
+  }
+  public var screens: [Screen]
+  /// OFF, UNTIL A MAC HAS BEEN ASKED: a window is judged a second time where the first stop has put it, by whoever has most of it then. Nine of the 78 did come to rest in two
+  /// moves, each below one display's menu bar and then below another's, but none of them tells `rest` with this from `rest` without. At a bottom corner beside a
+  /// neighbour that ends higher it would push the window up a second time, into view.
+  public var judgesAgain = false
+  /// OFF, UNTIL A MAC HAS BEEN ASKED: the display that has most of a window judges it wherever its corner is (`judge(of:)`). So a window across a laptop and a monitor below it,
+  /// its title bar well in view above and most of it below, would be pushed down below the monitor's menu bar. AppKit's own words on the call behind this speak for it
+  /// (`constrainFrameRect(_:to:)`: "so that its top edge lies on a specific screen"): that is support and no measurement.
+  public var mostOfItJudgesWhereverTheCornerIs = false
+
+  public init(_ screens: [(frame: CGRect, visibleFrame: CGRect)]) {
+    self.screens = screens.map { Screen(frame: $0.frame, visibleFrame: $0.visibleFrame) }
+  }
+
+  /// The display that judges a window at `frame`.
+  ///
+  /// The one that has most of it, as AppKit's `NSWindow.screen` has it; the first of two that have as much. That gave the resting place of 76 of the 78, and of all 42 that were
+  /// asked for the display's own top or bottom; the display the corner is on, or the nearest, of 67 at best. BUT ONLY WHERE A MAC WAS ASKED: in every one of
+  /// those calls the display the window's corner was on had one column of it at most, or the corner lay on no display. Where the corner's display has more of
+  /// the window than a column nobody has looked, and that display judges, as it did before any of this was measured.
+  /// Where no display has anything of the window, the one nearest its corner: a guess, which 4 of the 78 bear out and nothing else was held against.
+  public func judge(of frame: CGRect) -> Int? {
+    func part(_ index: Int) -> CGRect { screens[index].frame.intersection(frame) }
+    guard let most = screens.indices.max(by: { part($0).area < part($1).area }) else { return nil }
+    guard part(most).area > 0 else {
+      return screens.indices.min { screens[$0].frame.distance(to: frame.origin) < screens[$1].frame.distance(to: frame.origin) }
+    }
+    if !mostOfItJudgesWhereverTheCornerIs, let corner = screens.indices.first(where: { screens[$0].frame.contains(frame.origin) }), part(corner).width > 1 {
+      return corner
+    }
+    return most
+  }
+
+  /// Where a window comes to rest that is asked to be at `asked`, with a title bar this high. Its size is not touched.
+  ///
+  /// - Up and down, by the display that judges it: the title bar stays above the bottom of the visible frame (TextEdit rested 32 points above it, Notes 52, the Java app
+  ///   28) and below its top (y 31 at both top corners, 36 of 36; and 8 of 8 in the middle of a display, on another day). So a window asked to the bottom right
+  ///   corner above a wider display goes down, below that display's menu bar: 3 of 3.
+  /// - Sideways: one point inside a visible frame is enough to be left as asked (x was kept in all 78); with none inside, the window is pulled in until 40 points show.
+  ///   Six places with the Dock at the right, once each, one of them 20 times of 20 besides: 1023 became 934 where the visible frame ends at 974; and three
+  ///   on another day. All on one display: that ANY display's visible frame will do is a guess. So is what becomes of a window narrower than 40: all of it shows.
+  ///
+  /// Not played: TextEdit's window asked to go 50 points above the top left corner beside a left neighbour that begins lower, of which the main display has a strip and the
+  /// neighbour nothing, went to the neighbour, twice of twice (`stages`). Asked to go where this has put it, a window may be put elsewhere: the pull sideways comes last.
+  public func rest(of asked: CGRect, titleBar: CGFloat) -> CGPoint {
+    guard var judge = judge(of: asked) else { return asked.origin }
+    var frame = stopped(asked, by: judge, titleBar: titleBar)
+    if judgesAgain, let second = self.judge(of: frame) {
+      (judge, frame) = (second, stopped(frame, by: second, titleBar: titleBar))
+    }
+    return pulledIn(frame, by: judge).origin
+  }
+
+  /// A GUESS, MADE AFTER SEEING THE 78, ON WHICH NOTHING THAT SHIPS IS TO LEAN: the places a window passes through, the last of them where it rests. In 9 of the 78 it came to
+  /// rest in two moves, 20 to 150 ms apart, the second after the last call had returned: what was read back at once was the first. First the display that has most
+  /// of the TITLE BAR as asked stops it (none: the nearest to the corner), then the display that has most of the window where that put it. That gives every
+  /// place of all 78, the two that `rest` misses among them. Some five choices went into it, three other rules fit as well, which differ where the title
+  /// bar lies on no display, and that it is the title bar and not a strip of some other height hangs on two calls and 2 points.
+  public func stages(of asked: CGRect, titleBar: CGFloat) -> [CGPoint] {
+    guard let first = judge(of: CGRect(x: asked.minX, y: asked.minY, width: asked.width, height: titleBar)) else { return [asked.origin] }
+    let one = stopped(asked, by: first, titleBar: titleBar)
+    guard let second = judge(of: one) else { return [one.origin] }
+    let two = pulledIn(stopped(one, by: second, titleBar: titleBar), by: second)
+    return one.origin == two.origin ? [two.origin] : [one.origin, two.origin]
+  }
+
+  private func stopped(_ frame: CGRect, by judge: Int, titleBar: CGFloat) -> CGRect {
+    let visible = screens[judge].visibleFrame
+    return CGRect(origin: CGPoint(x: frame.minX, y: max(min(frame.minY, visible.maxY - titleBar), visible.minY)), size: frame.size)
+  }
+
+  private func pulledIn(_ frame: CGRect, by judge: Int) -> CGRect {
+    guard !screens.contains(where: { $0.visibleFrame.overlaps(frame) }) else { return frame }
+    let (visible, shows) = (screens[judge].visibleFrame, min(40, frame.width))
+    var pulled = frame
+    if frame.minX >= visible.maxX { pulled.origin.x = visible.maxX - shows }
+    if frame.maxX <= visible.minX { pulled.origin.x = visible.minX + shows - frame.width }
+    return pulled
+  }
+}
