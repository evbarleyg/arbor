new file mode 100644
index 00000000..3291cb3b
--- /dev/null
+++ b/Sources/ArborCore/Screens.swift
@@ -0,0 +1,141 @@
+import CoreGraphics
+
+/// Where macOS leaves a window that is asked to go somewhere.
+///
+/// A call that sets a window's position is not always taken as it stands: the title bar stays within reach. Which display sees to that, and
+/// how, was asked of one hosted Mac (macOS 26.6, no Arbor running; `mac-shell-out/top.corners`): 78 position calls through Accessibility, of
+/// TextEdit, Notes and a Java app, from the main display to its top corners, to 50 points above them and to its bottom right corner; with
+/// that display alone, with a wider one below, one above, a left neighbour that begins lower, that and one at the right, and a right
+/// neighbour that begins higher. Other runs asked for places in the middle of one display and beside its Dock.
+///
+/// IT SAYS WHAT WAS SEEN, AND WHERE NOTHING WAS SEEN WHAT THE STAND-INS SAID BEFORE: the display the window's corner is on, or the nearest,
+/// keeps the title bar above its bottom. What goes further is a switch here, off, and owed a Mac.
+///
+/// One rule, for the fake window system to play (`echoes.restsWhereAMacLeavesIt`) and for Arbor to reckon by, so that the two cannot part.
+/// The model of macOS behind `make mac-on-linux` has a rule of its own still.
+public struct Screens: Equatable, Sendable {
+  public struct Screen: Equatable, Sendable {
+    public var frame: CGRect
+    public var visibleFrame: CGRect
+  }
+  public var screens: [Screen]
+
+  /// A GUESS, OFF UNTIL A MAC HAS BEEN ASKED: the display that has most of a window judges it wherever its corner is (`judge(of:)`). So a window
+  /// across a laptop and a monitor below it, its title bar well in view above and most of it below, would be pushed down below the
+  /// monitor's menu bar. AppKit's own words on the call behind this speak for it (`constrainFrameRect(_:to:)`: "so that its top edge lies on
+  /// a specific screen"): that is support and no measurement.
+  public var mostOfItJudgesWhereverTheCornerIs = false
+  /// A GUESS, OFF UNTIL A MAC HAS BEEN ASKED: the display that judges a window also keeps its title bar above ITS bottom. In the 78 calls no display
+  /// but the corner's ever stopped a window at a bottom: it stopped it at its top or left it as asked. At a bottom corner beside a
+  /// neighbour that reaches lower this would leave the window as asked, and beside one with a lower Dock let it go lower.
+  public var judgeStopsItAtTheBottomToo = false
+  /// A GUESS, OFF UNTIL A MAC HAS BEEN ASKED: a window is judged a second time where the first stop has put it. Nine of the 78 did come to rest in two
+  /// moves (`stages`), but none of them tells `rest` with this from `rest` without. With the switch above, at a bottom corner beside a
+  /// neighbour that ends higher, it would push the window up a second time, into view.
+  public var judgesAgain = false
+  /// FOUR GUESSES, OFF UNTIL A MAC HAS BEEN ASKED: what the rule makes of cases that lie beside ones that were seen. Each answer takes its clause out from behind this switch, by name.
+  /// - The stop at the top and the pull sideways together: a top corner behind a Dock at a side. Every pull that was seen was at a display's bottom or half way up.
+  /// - A column of the window under a Dock at the LEFT counts as out of reach, as one under a Dock at the right was seen to.
+  /// - Where the window's corner is ON a display, another display judges it with one column of it. 161 columns were the fewest seen to do.
+  /// - With several displays, a window of which none has anything is stopped at the top and pulled in by the nearest. It was asked for on one display alone.
+  public var playsTheGuessesBesideWhatWasSeen = false
+
+  public init(_ screens: [(frame: CGRect, visibleFrame: CGRect)]) {
+    self.screens = screens.map { Screen(frame: $0.frame, visibleFrame: $0.visibleFrame) }
+  }
+
+  /// The display a window's corner is on, or the nearest to it: what the stand-ins and Arbor went by before any of this was measured. A point on a
+  /// shared edge belongs to the display it is inside.
+  public func cornersDisplay(of frame: CGRect) -> Int? {
+    screens.indices.first { screens[$0].frame.contains(frame.origin) }
+      ?? screens.indices.min { screens[$0].frame.distance(to: frame.origin) < screens[$1].frame.distance(to: frame.origin) }
+  }
+
+  /// The display that has most of `frame`, as AppKit's `NSWindow.screen` has it; the first of two that have as much, which is a guess. None has
+  /// anything of it: the corner's.
+  private func most(of frame: CGRect) -> Int? {
+    func part(_ index: Int) -> CGFloat { screens[index].frame.intersection(frame).area }
+    guard let most = screens.indices.max(by: { part($0) < part($1) }) else { return nil }
+    return part(most) > 0 ? most : cornersDisplay(of: frame)
+  }
+
+  /// The display below whose menu bar a window at `frame` is kept.
+  ///
+  /// The one that has most of it. That gave the resting place of 76 of the 78, and of all 42 that were asked for the display's own top or bottom; the
+  /// corner's display, with the same stop at the top, of 67. BUT ONLY WHERE A MAC WAS ASKED: in every call in which the two part, the
+  /// corner's display had one column of the window at most. Where it has more than a column nobody has looked, and it judges, as it did.
+  /// So it does where the corner is on it and the other display has a column and no more (`playsTheGuessesBesideWhatWasSeen`).
+  public func judge(of frame: CGRect) -> Int? {
+    guard let corners = cornersDisplay(of: frame), let most = most(of: frame) else { return nil }
+    func columns(_ index: Int) -> CGFloat { screens[index].frame.intersection(frame).width }
+    if !mostOfItJudgesWhereverTheCornerIs, columns(corners) > 1 { return corners }
+    if !playsTheGuessesBesideWhatWasSeen, screens[corners].frame.contains(frame.origin), columns(most) <= 1 { return corners }
+    return most
+  }
+
+  /// Where a window comes to rest that is asked to be at `asked`, with a title bar this high. Its size is not touched.
+  ///
+  /// - Down: the title bar stays above the bottom of the visible frame of the corner's display. TextEdit rested 32 points above it, Notes 52, the Java
+  ///   app 28.
+  /// - Up: it stays below the top of the visible frame of the display that judges it (`judge(of:)`): y 31 at both top corners, 36 of 36; and 8 of 8
+  ///   in the middle of a display, in another run. That wins over the bottom: a window asked to the bottom right corner above a wider
+  ///   display went down, below that display's menu bar, 3 of 3.
+  /// - Sideways: one point inside a visible frame is enough to be left as asked (x was kept in all 78); with none inside, the window is pulled in
+  ///   until 40 points show. Six places with the Dock at the right, once each, one of them 20 times of 20 besides: 1023 became 934 where
+  ///   the visible frame ends at 974; and places wholly off a display, in another run. All on one display, at its bottom or half way up.
+  ///   Two small guesses are played: that a point inside ANY display's visible frame will do, and that all of a window narrower than 40 shows.
+  ///
+  /// NOT PLAYED. TextEdit's window asked to go 50 points above the top left corner beside a left neighbour that begins lower, of which the main display
+  /// has a strip and the neighbour nothing, went to the neighbour, twice of twice. And in 9 of the 78 the window lay elsewhere first,
+  /// for a tenth of a second, and that is what was read back at once (`stages`): this is where it rests.
+  /// Asked to go where this has put it, a window may be put elsewhere: it is judged once, by where it was asked to be.
+  public func rest(of asked: CGRect, titleBar: CGFloat) -> CGPoint {
+    var frame = asked
+    if !playsTheGuessesBesideWhatWasSeen, screens.count > 1, !screens.contains(where: { $0.frame.overlaps(asked) }), let corners = cornersDisplay(of: asked) {
+      return CGPoint(x: asked.minX, y: min(asked.minY, screens[corners].visibleFrame.maxY - titleBar))
+    }
+    guard var judge = stop(&frame, titleBar: titleBar) else { return asked.origin }
+    if judgesAgain, let second = stop(&frame, titleBar: titleBar) { judge = second }
+    if !playsTheGuessesBesideWhatWasSeen, asked.minY < screens[judge].visibleFrame.minY { return frame.origin }
+    return pulledIn(frame, by: judge, pastADockAtTheLeft: playsTheGuessesBesideWhatWasSeen).origin
+  }
+
+  /// A GUESS, MADE AFTER SEEING THE 78, ON WHICH NOTHING THAT SHIPS IS TO LEAN: the places a window passes through, the last of them where it rests. In 9 of
+  /// the 78 it came to rest in two moves, the second 19 to 118 ms after the first by the apps' own reports and after the last call had
+  /// returned: what was read back at once was the first. Six lay below the main display's menu bar first and then below the neighbour's;
+  /// three as asked, or a title bar above the upper display's bottom, and then below the main display's.
+  /// First the display that has most of the TITLE BAR as asked stops it, at its top and its bottom (none has any of it: the nearest to the corner); then
+  /// the display that has most of the window where that put it. That gives every place of all 78, the two that `rest` misses among them.
+  /// Some five choices went into it; three other rules fit as well, which differ where the title bar lies on no display; and that it is
+  /// the title bar and not a strip of some other height hangs on two calls and 2 points. None of the switches above touches it.
+  public func stages(of asked: CGRect, titleBar: CGFloat) -> [CGPoint] {
+    guard let first = most(of: CGRect(x: asked.minX, y: asked.minY, width: asked.width, height: titleBar)) else { return [asked.origin] }
+    let one = stopped(asked, by: first, titleBar: titleBar)
+    guard let second = most(of: one) else { return [one.origin] }
+    let two = pulledIn(stopped(one, by: second, titleBar: titleBar), by: second, pastADockAtTheLeft: true)
+    return one.origin == two.origin ? [two.origin] : [one.origin, two.origin]
+  }
+
+  /// Returns the display that judged it.
+  private func stop(_ frame: inout CGRect, titleBar: CGFloat) -> Int? {
+    guard let judge = judge(of: frame), let corners = cornersDisplay(of: frame) else { return nil }
+    let bottom = screens[judgeStopsItAtTheBottomToo ? judge : corners].visibleFrame.maxY
+    frame.origin.y = max(min(frame.minY, bottom - titleBar), screens[judge].visibleFrame.minY)
+    return judge
+  }
+
+  private func stopped(_ frame: CGRect, by judge: Int, titleBar: CGFloat) -> CGRect {
+    let visible = screens[judge].visibleFrame
+    return CGRect(origin: CGPoint(x: frame.minX, y: max(min(frame.minY, visible.maxY - titleBar), visible.minY)), size: frame.size)
+  }
+
+  /// `pastADockAtTheLeft`: also a window that has a column on the display, under its Dock. Without: only one that is wholly off the display at that side.
+  private func pulledIn(_ frame: CGRect, by judge: Int, pastADockAtTheLeft: Bool) -> CGRect {
+    guard !screens.contains(where: { $0.visibleFrame.overlaps(frame) }) else { return frame }
+    let (visible, shows) = (screens[judge].visibleFrame, min(40, frame.width))
+    var pulled = frame
+    if frame.minX >= visible.maxX { pulled.origin.x = visible.maxX - shows }
+    if frame.maxX <= (pastADockAtTheLeft ? visible.minX : screens[judge].frame.minX) { pulled.origin.x = visible.minX + shows - frame.width }
+    return pulled
+  }
+}
