diff --git a/Tests/ArborKitTests/WhereAMacLeavesAWindowTests.swift b/Tests/ArborKitTests/WhereAMacLeavesAWindowTests.swift
new file mode 100644
index 00000000..7a4ba0c4
--- /dev/null
+++ b/Tests/ArborKitTests/WhereAMacLeavesAWindowTests.swift
@@ -0,0 +1,118 @@
+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// The stand-in can leave a window where a hosted Mac left it (`echoes.restsWhereAMacLeavesIt`, `Screens.rest`; the Mac's own numbers are in `ScreensTests`). It is off so far, because of what
+/// shows as soon as it is on: Arbor reckons where a window out of view will rest by another rule than macOS has.
+@Suite @MainActor struct WhereAMacLeavesAWindowTests {
+  static func display(_ name: String, _ frame: CGRect, visible: CGRect, isMain: Bool = false) -> DisplaySnapshot {
+    DisplaySnapshot(id: DisplayID(name), frame: frame, visibleFrame: visible, isMain: isMain)
+  }
+  /// The probe's main display, and three of the displays it stood beside. (Beside the wider one below, macOS took the Dock there; here the main display keeps its own.)
+  static let main = display("main", CGRect(x: 0, y: 0, width: 1600, height: 900), visible: CGRect(x: 0, y: 31, width: 1600, height: 791), isMain: true)
+  static let leftAndLower = display("B", CGRect(x: -1280, y: 500, width: 1280, height: 800), visible: CGRect(x: -1280, y: 531, width: 1280, height: 769))
+  static let right = display("A", CGRect(x: 1600, y: 0, width: 1920, height: 1080), visible: CGRect(x: 1600, y: 31, width: 1920, height: 1049))
+  static let widerBelow = display("below", CGRect(x: -160, y: 900, width: 1920, height: 1080), visible: CGRect(x: -160, y: 931, width: 1920, height: 971))
+
+  // MARK: The switch
+
+  @Test func offAWindowRestsAsOfOld() {
+    let system = FakeWindowSystem(displays: [Self.main, Self.leftAndLower])
+    #expect(!system.echoes.restsWhereAMacLeavesIt)
+    let window = system.open(app: "Notes", frame: CGRect(x: 300, y: 200, width: 1000, height: 600))
+    #expect(system.setFrame(CGRect(x: -999, y: 0, width: 1000, height: 600), of: window)?.origin == CGPoint(x: -999, y: 0))
+    #expect(system.setFrame(CGRect(x: 1599, y: 899, width: 1000, height: 600), of: window)?.origin == CGPoint(x: 1599, y: 794), "the bottom alone")
+  }
+
+  /// Three calls of the probe, through the road Arbor's own calls take: where the window came to rest. At the first of them a Mac's answer at once was -999,31, and the window went on to
+  /// 531 a tenth of a second later by itself: that is not played (board 1.109).
+  @Test func onItRestsWhereAMacLeftIt() {
+    let system = FakeWindowSystem(displays: [Self.main, Self.leftAndLower])
+    system.echoes.restsWhereAMacLeavesIt = true
+    let window = system.open(app: "Notes", frame: CGRect(x: 300, y: 200, width: 1000, height: 600))
+    system.setTitleBar(window, 52)
+    #expect(system.setFrame(CGRect(x: -999, y: 0, width: 1000, height: 600), of: window)?.origin == CGPoint(x: -999, y: 531))
+    #expect(system.setFrame(CGRect(x: 1599, y: -50, width: 1000, height: 600), of: window)?.origin == CGPoint(x: 1599, y: 31))
+    #expect(system.setFrame(CGRect(x: 1599, y: 899, width: 1000, height: 600), of: window)?.origin == CGPoint(x: 1599, y: 770))
+  }
+
+  @Test func theSilentStandInPutsAWindowWhereItIsAsked() {
+    let system = FakeWindowSystem(displays: [Self.main, Self.leftAndLower])
+    system.echoes = .none
+    system.echoes.restsWhereAMacLeavesIt = true
+    let asked = CGRect(x: -999, y: -50, width: 1000, height: 600)
+    #expect(system.whereMacOSPuts(asked, titleBar: 52) == asked, "it hangs on the switch that keeps a title bar within reach")
+  }
+
+  /// Sent to the left corner that was reckoned for its old width and made narrower in the same request, a window would lie wholly off the display, and is pulled in until 40 points show. Like
+  /// two places that were asked of a Mac (-600 became -440); this very request was not. On one display: with several it is a guess that is switched off (`Screens`), and with it what board 1.118 says.
+  @Test func narrowerThanTheCornerWasReckonedForItIsPulledIn() {
+    let system = FakeWindowSystem(displays: [Self.main])
+    system.echoes.restsWhereAMacLeavesIt = true
+    let window = system.open(app: "Editor", frame: CGRect(x: -899, y: 794, width: 900, height: 700))
+    #expect(system.setFrame(CGRect(x: -899, y: 899, width: 464, height: 419), of: window) == CGRect(x: -424, y: 794, width: 464, height: 419))
+  }
+
+  // MARK: What shows of Arbor as soon as it is on
+
+  /// `[a | Desktop]` framed, so that `f`, which floats, is sent out of view.
+  func withAWindowOutOfView(_ displays: [DisplaySnapshot], size: CGSize, titleBar: CGFloat) -> (Harness, f: WindowID) {
+    let h = Harness(displays: displays)
+    h.system.echoes.restsWhereAMacLeavesIt = true
+    let a = h.system.open(app: "Safari", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let f = h.system.open(app: "Editor", pid: 12, frame: CGRect(origin: CGPoint(x: 300, y: 200), size: size))
+    h.system.setTitleBar(f, titleBar)
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("zoom \(a.rawValue)")
+    return (h, f)
+  }
+  func whatShows(_ h: Harness, of frame: CGRect) -> CGFloat { h.system.displayList.map { frame.intersection($0.frame).area }.reduce(0, +) }
+  /// The least that can show of a window of this size at the five places Arbor knows around the main display, by where the stand-in would leave it at each.
+  func leastThatShows(_ h: Harness, size: CGSize, titleBar: CGFloat) -> CGFloat {
+    let home = h.system.displayList[0].frame
+    let (right, left, bottom): (CGFloat, CGFloat, CGFloat) = (home.maxX - 1, home.minX - size.width + 1, home.maxY - 1)
+    let places: [CGPoint] = [
+      CGPoint(x: right, y: bottom), CGPoint(x: left, y: bottom), CGPoint(x: home.minX, y: bottom), CGPoint(x: right, y: home.minY), CGPoint(x: left, y: home.minY),
+    ]
+    let shown: [CGFloat] = places.map { whatShows(h, of: h.system.whereMacOSPuts(CGRect(origin: $0, size: size), titleBar: titleBar)) }
+    return shown.min()!
+  }
+
+  /// A left neighbour that begins 500 points lower and a display at the right. For a window of 1000×600 Arbor chooses the top left corner, reckoning that a strip will show. A hosted Mac, asked for
+  /// just that place, put Notes' window of that size at -999,531: all of it in view on the neighbour. (The least that is held against it lies under the bottom edge, a place no Mac was asked for.)
+  @Test func sentOutOfViewItLandsWhollyInView() {
+    let size = CGSize(width: 1000, height: 600)
+    let (h, f) = withAWindowOutOfView([Self.main, Self.leftAndLower, Self.right], size: size, titleBar: 52)
+    #expect(h.controller.parked.contains(f), "or this proves nothing")
+    withKnownIssue("board 0.22, its third face: where Arbor parks: a window sent out of view lies wholly in view") {
+      #expect(whatShows(h, of: h.frame(f)!) == leastThatShows(h, size: size, titleBar: 52), "\(h.frame(f)!)")
+    }
+  }
+
+  /// Above a wider display Arbor chooses the top right corner, and rightly: one column shows. The window rests below the menu bar there, at y 31 and not at 0, as a hosted Mac was seen to leave it.
+  /// Arbor takes that for a window that has left its corner, and sends it there again at every report of the displays.
+  @Test func atATopCornerItIsAskedAgain() {
+    let size = CGSize(width: 656, height: 422)
+    let (h, f) = withAWindowOutOfView([Self.main, Self.widerBelow], size: size, titleBar: 32)
+    #expect(h.frame(f)?.origin == CGPoint(x: 1599, y: 31))
+    #expect(whatShows(h, of: h.frame(f)!) == leastThatShows(h, size: size, titleBar: 32))
+    withKnownIssue("board 0.22, its third face: a window that rests below the menu bar is asked again") {
