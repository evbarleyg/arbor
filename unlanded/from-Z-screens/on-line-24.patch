index 00000000..30e4c920
--- /dev/null
+++ b/Tests/ArborCoreTests/ScreensTests.swift
@@ -0,0 +1,303 @@
+import ArborCore
+import CoreGraphics
+import Testing
+
+/// `Screens` held to what hosted Macs did with position calls through Accessibility, no Arbor running.
+@Suite struct ScreensTests {
+  /// The three windows of the first table, at the sizes they had, with the title bars that their rest above the Dock showed.
+  enum Window {
+    case text, notes, java
+    var size: CGSize {
+      switch self {
+      case .text: CGSize(width: 656, height: 422)
+      case .notes: CGSize(width: 1000, height: 600)
+      case .java: CGSize(width: 900, height: 750)
+      }
+    }
+    var titleBar: CGFloat {
+      switch self {
+      case .text: 32
+      case .notes: 52
+      case .java: 28
+      }
+    }
+  }
+  typealias Call = (arrangement: String, window: Window, x: CGFloat, y: CGFloat, atOnce: CGFloat, rested: CGFloat)
+
+  /// The six arrangements, each display with the visible frame it had. t1: the main display alone; t2: a wider one below, to which macOS took the Dock;
+  /// t3: a left neighbour that begins 500 lower; t4: that and one at the right; t5: one above; t6: a right neighbour that begins 700 higher.
+  static func arrangement(_ name: String) -> Screens {
+    let main = (frame: CGRect(x: 0, y: 0, width: 1600, height: 900), visibleFrame: CGRect(x: 0, y: 31, width: 1600, height: name == "t2" ? 869 : 791))
+    let leftAndLower = (frame: CGRect(x: -1280, y: 500, width: 1280, height: 800), visibleFrame: CGRect(x: -1280, y: 531, width: 1280, height: 769))
+    switch name {
+    case "t2": return Screens([main, (CGRect(x: -160, y: 900, width: 1920, height: 1080), CGRect(x: -160, y: 931, width: 1920, height: 971))])
+    case "t3": return Screens([main, leftAndLower])
+    case "t4": return Screens([main, leftAndLower, (CGRect(x: 1600, y: 0, width: 1920, height: 1080), CGRect(x: 1600, y: 31, width: 1920, height: 1049))])
+    case "t5": return Screens([main, (CGRect(x: 0, y: -800, width: 1280, height: 800), CGRect(x: 0, y: -769, width: 1280, height: 769))])
+    case "t6": return Screens([main, (CGRect(x: 1600, y: -700, width: 1920, height: 1080), CGRect(x: 1600, y: -669, width: 1920, height: 1049))])
+    default: return Screens([main])
+    }
+  }
+
+  /// All 78 calls of one run: the arrangement, the window, the x and y it was asked for, the y that was read back at once, the y it lay at a second later.
+  /// x and the size were kept in all.
+  static let calls: [Call] = [
+    ("t2", .text, 1599, 0, 31, 31), ("t2", .text, 1599, -50, 31, 31), ("t2", .text, -655, 0, 31, 31), ("t2", .text, -655, -50, 31, 31),
+    ("t2", .text, 1599, 899, 931, 931), ("t2", .notes, 1599, 0, 31, 31), ("t2", .notes, 1599, -50, 31, 31), ("t2", .notes, -999, 0, 31, 31),
+    ("t2", .notes, -999, -50, 31, 31), ("t2", .notes, 1599, 899, 931, 931), ("t2", .java, 1599, 0, 31, 31), ("t2", .java, 1599, -50, 31, 31),
+    ("t2", .java, -899, 0, 31, 31), ("t2", .java, -899, -50, 31, 31), ("t2", .java, 1599, 899, 931, 931), ("t3", .text, 1599, 0, 31, 31),
+    ("t3", .text, 1599, -50, 31, 31), ("t3", .text, -655, 0, 31, 31), ("t3", .text, -655, -50, 531, 531), ("t3", .notes, 1599, 0, 31, 31),
+    ("t3", .notes, 1599, -50, 31, 31), ("t3", .notes, -999, 0, 31, 531), ("t3", .notes, -999, -50, 31, 531), ("t3", .java, 1599, 0, 31, 31),
+    ("t3", .java, 1599, -50, 31, 31), ("t3", .java, -899, 0, 31, 531), ("t3", .java, -899, -50, 531, 531), ("t5", .text, 1599, 0, 31, 31),
+    ("t5", .text, 1599, -50, 31, 31), ("t5", .text, -655, 0, 31, 31), ("t5", .text, -655, -50, -50, 31), ("t5", .notes, 1599, 0, 31, 31),
+    ("t5", .notes, 1599, -50, 31, 31), ("t5", .notes, -999, 0, 31, 31), ("t5", .notes, -999, -50, -52, 31), ("t5", .java, 1599, 0, 31, 31),
+    ("t5", .java, 1599, -50, 31, 31), ("t5", .java, -899, 0, 31, 31), ("t5", .java, -899, -50, -50, 31), ("t4", .text, 1599, 0, 31, 31),
+    ("t4", .text, 1599, -50, 31, 31), ("t4", .text, -655, 0, 31, 31), ("t4", .text, -655, -50, 531, 531), ("t4", .notes, 1599, 0, 31, 31),
+    ("t4", .notes, 1599, -50, 31, 31), ("t4", .notes, -999, 0, 31, 531), ("t4", .notes, -999, -50, 31, 531), ("t4", .java, 1599, 0, 31, 31),
+    ("t4", .java, 1599, -50, 31, 31), ("t4", .java, -899, 0, 31, 531), ("t4", .java, -899, -50, 531, 531), ("t1", .text, 1599, 0, 31, 31),
+    ("t1", .text, 1599, -50, 31, 31), ("t1", .text, -655, 0, 31, 31), ("t1", .text, -655, -50, 31, 31), ("t1", .text, 1599, 899, 790, 790),
+    ("t1", .notes, 1599, 0, 31, 31), ("t1", .notes, 1599, -50, 31, 31), ("t1", .notes, -999, 0, 31, 31), ("t1", .notes, -999, -50, 31, 31),
+    ("t1", .notes, 1599, 899, 770, 770), ("t1", .java, 1599, 0, 31, 31), ("t1", .java, 1599, -50, 31, 31), ("t1", .java, -899, 0, 31, 31),
+    ("t1", .java, -899, -50, 31, 31), ("t1", .java, 1599, 899, 794, 794), ("t6", .text, 1599, 0, 0, 0), ("t6", .text, 1599, -50, -50, -50),
+    ("t6", .text, -655, 0, 31, 31), ("t6", .text, -655, -50, 31, 31), ("t6", .notes, 1599, 0, 0, 0), ("t6", .notes, 1599, -50, -50, -50),
+    ("t6", .notes, -999, 0, 31, 31), ("t6", .notes, -999, -50, 31, 31), ("t6", .java, 1599, 0, 0, 0), ("t6", .java, 1599, -50, -50, -50),
+    ("t6", .java, -899, 0, 31, 31), ("t6", .java, -899, -50, 31, 31),
+  ]
+  static func asked(_ call: Call) -> CGRect { CGRect(origin: CGPoint(x: call.x, y: call.y), size: call.window.size) }
+  /// The two that `rest` does not give.
+  static func isNotPlayed(_ call: Call) -> Bool {
+    (call.arrangement == "t3" || call.arrangement == "t4") && call.window == .text && call.y == -50 && call.x < 0
+  }
+
+  @Test func whereItCameToRest() {
+    #expect(Self.calls.count == 78 && Self.calls.filter(Self.isNotPlayed).count == 2)
+    for call in Self.calls where !Self.isNotPlayed(call) {
+      let rest = Self.arrangement(call.arrangement).rest(of: Self.asked(call), titleBar: call.window.titleBar)
+      #expect(rest == CGPoint(x: call.x, y: call.rested), "\(call.arrangement): \(call.window) asked for \(call.x),\(call.y)")
+    }
+  }
+
+  /// TextEdit's window, asked to go 50 points above the top left corner beside a left neighbour that begins lower, shares a strip of 1 by 372 points with the
+  /// main display and nothing with the neighbour, and went to the neighbour, below its menu bar, wholly in view. `rest` says the main display's
+  /// top, and this says that it does.
+  @Test func notPlayed() {
+    for call in Self.calls where Self.isNotPlayed(call) {
+      #expect(call.rested == 531)
+      #expect(Self.arrangement(call.arrangement).rest(of: Self.asked(call), titleBar: call.window.titleBar).y == 31)
+    }
+  }
+
+  /// The guess gives every place of all 78: what was read back at once, and where the window lay a second later. In nine the two differ.
+  @Test func theGuessGivesTheWholeWay() {
+    #expect(Self.calls.filter { $0.atOnce != $0.rested }.count == 9)
+    for call in Self.calls {
+      let stages = Self.arrangement(call.arrangement).stages(of: Self.asked(call), titleBar: call.window.titleBar)
+      var way = [CGPoint(x: call.x, y: call.rested)]
+      if call.atOnce != call.rested { way.insert(CGPoint(x: call.x, y: call.atOnce), at: 0) }
+      #expect(stages == way, "\(call.arrangement): \(call.window) asked for \(call.x),\(call.y)")
+    }
+  }
+
+  /// At the places Arbor asks for, a display's own top and its bottom less 1, the guess ends where `rest` does: 42 of 42.
+  @Test func atADisplaysOwnTopAndBottomTheTwoEndAlike() {
+    let own = Self.calls.filter { $0.y == 0 || $0.y == 899 }
+    #expect(own.count == 42)
+    for call in own {
+      let screens = Self.arrangement(call.arrangement)
+      #expect(screens.stages(of: Self.asked(call), titleBar: call.window.titleBar).last == screens.rest(of: Self.asked(call), titleBar: call.window.titleBar))
+    }
+  }
+
+  /// Where the display that has most of a window is not the one its corner is on, or nearest to, the corner's had one column of it at most, in every call: that
+  /// is as far as a Mac was looked at, and as far as `judge(of:)` goes by most of it.
+  @Test func asFarAsAMacWasLookedAt() {
+    var parted = 0
+    for call in Self.calls {
+      var screens = Self.arrangement(call.arrangement)
+      let corners = screens.cornersDisplay(of: Self.asked(call))!
+      screens.mostOfItJudgesWhereverTheCornerIs = true
+      guard screens.judge(of: Self.asked(call)) != corners else { continue }
+      parted += 1
+      #expect(screens.screens[corners].frame.intersection(Self.asked(call)).width <= 1, "\(call.arrangement): \(call.window) asked for \(call.x),\(call.y)")
+    }
+    #expect(parted == 19)
+  }
+
+  // MARK: One display
+
+  static let small = CGRect(x: 0, y: 0, width: 1024, height: 768)
+  static let size = CGSize(width: 480, height: 348)
+  static let dockBelow = Screens([(small, CGRect(x: 0, y: 31, width: 1024, height: 674))])
+  static let dockAtTheRight = Screens([(small, CGRect(x: 0, y: 31, width: 974, height: 737))])
+  static let dockAtTheLeft = Screens([(small, CGRect(x: 50, y: 31, width: 974, height: 737))])
+  func rests(_ screens: Screens, _ x: CGFloat, _ y: CGFloat, size: CGSize = Self.size, titleBar: CGFloat = 28) -> CGPoint {
+    screens.rest(of: CGRect(origin: CGPoint(x: x, y: y), size: size), titleBar: titleBar)
+  }
+
+  /// In the middle of a display, asked for y 0 and for y -50: y 31, with x and the size kept. 8 of 8 in another run, at x 170 and 220.
+  @Test func inTheMiddleOfADisplayItStopsBelowTheMenuBarToo() {
+    for x: CGFloat in [170, 220] {
+      #expect(rests(Self.dockBelow, x, 0) == CGPoint(x: x, y: 31))
+      #expect(rests(Self.dockBelow, x, -50) == CGPoint(x: x, y: 31))
+    }
+  }
+
+  /// Six places with the Dock at the right, a window of 480×348, once each; the first of them 20 times of 20 besides.
+  @Test(arguments: [
+    (CGPoint(x: 1023, y: 767), CGPoint(x: 934, y: 740)), (CGPoint(x: 973, y: 767), CGPoint(x: 973, y: 740)),
+    (CGPoint(x: -479, y: 767), CGPoint(x: -479, y: 740)), (CGPoint(x: -479, y: 400), CGPoint(x: -479, y: 400)),
+    (CGPoint(x: -600, y: 767), CGPoint(x: -440, y: 740)), (CGPoint(x: 300, y: 767), CGPoint(x: 300, y: 740)),
+  ]) func besideTheDock(asked: CGPoint, rested: CGPoint) {
+    #expect(rests(Self.dockAtTheRight, asked.x, asked.y) == rested)
+    #expect(Self.dockAtTheRight.stages(of: CGRect(origin: asked, size: Self.size), titleBar: 28).last == rested)
+  }
+
+  /// That first place with the Dock at the bottom, at the left, and on 1920×1080 beside a second display.
+  @Test func theSameCornerWithTheDockElsewhere() {
+    #expect(rests(Self.dockBelow, 1023, 767) == CGPoint(x: 1023, y: 677))
+    #expect(rests(Self.dockAtTheLeft, 1023, 767) == CGPoint(x: 1023, y: 740))
+    let two = Screens([
+      (CGRect(x: 0, y: 0, width: 1920, height: 1080), CGRect(x: 0, y: 31, width: 1920, height: 971)),
+      (CGRect(x: 1920, y: 0, width: 1280, height: 720), CGRect(x: 1920, y: 31, width: 1280, height: 689)),
+    ])
+    #expect(rests(two, 1919, 1079) == CGPoint(x: 1919, y: 974))
+  }
+
+  /// Wholly off the display, in another run: pulled in until 40 points show; past a Dock at the left, 40 points past the Dock.
+  @Test func whollyOffTheDisplay() {
+    #expect(rests(Self.dockBelow, 1524, 200).x == 984)
+    #expect(rests(Self.dockBelow, -600, 200).x == -440)
+    #expect(rests(Self.dockAtTheLeft, -600, 200).x == -390)
+    #expect(rests(Self.dockBelow, 1024, 200).x == 984, "its left edge on the display's right edge: nothing of it is on the display")
+    #expect(rests(Self.dockBelow, -480, 200).x == -440)
+  }
+
+  // MARK: Guesses
+
+  /// Two small ones that are played, and what is no guess but a choice.
+  @Test func smallGuessesThatArePlayed() {
+    // Narrower than 40 points, all of it shows.
+    #expect(rests(Self.dockBelow, -600, 200, size: CGSize(width: 20, height: 300)).x == 0)
+    #expect(rests(Self.dockBelow, 1524, 200, size: CGSize(width: 20, height: 300)).x == 1004)
+    // A point inside ANY display's visible frame will do: behind the main display's Dock at the right, all but a column of it on a neighbour.
+    #expect(rests(Screens([(Self.small, CGRect(x: 0, y: 31, width: 974, height: 737)), Self.neighbour]), 1023, 400).x == 1023)
+    // Of two displays that have as much of it, the first.
+    let twins = Screens([
+      (CGRect(x: 500, y: 0, width: 500, height: 500), CGRect(x: 500, y: 31, width: 500, height: 469)),
+      (CGRect(x: 0, y: 0, width: 500, height: 500), CGRect(x: 0, y: 31, width: 500, height: 469)),
+    ])
+    let astride = CGRect(x: 499, y: -50, width: 2, height: 70)
+    #expect(twins.cornersDisplay(of: astride) == 1, "its corner lies above the second")
+    #expect(twins.judge(of: astride) == 0, "a column of 20 rows on each")
+    // A title bar higher than the visible frame: the top wins.
+    #expect(rests(Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 20))]), 100, 400).y == 31)
+  }
+
+  static let neighbour = (frame: CGRect(x: 1024, y: 0, width: 1024, height: 768), visibleFrame: CGRect(x: 1024, y: 31, width: 1024, height: 737))
+
+  /// The four behind one switch, which is off: each lies beside a case that was seen, none was asked of a Mac. Without the switch a window rests as by the old rule, but for the stop at the
+  /// top, which was seen; with it, where the rule would put it.
+  @Test func theFourGuessesBesideWhatWasSeen() {
+    func both(_ screens: Screens, _ x: CGFloat, _ y: CGFloat, size: CGSize = Self.size) -> [CGPoint] {
+      var guessing = screens
+      guessing.playsTheGuessesBesideWhatWasSeen = true
+      return [rests(screens, x, y, size: size), rests(guessing, x, y, size: size)]
+    }
+    // The stop at the top and the pull sideways together.
+    #expect(both(Self.dockAtTheRight, 1023, 0) == [CGPoint(x: 1023, y: 31), CGPoint(x: 934, y: 31)])
+    // One column under a Dock at the left: the mirror of 1023 beside a Dock at the right.
+    #expect(both(Self.dockAtTheLeft, -479, 767) == [CGPoint(x: -479, y: 740), CGPoint(x: -390, y: 740)])
+    // Its corner on the display, one column of it on the display below, which has most of it.
+    let below = (frame: CGRect(x: 0, y: 768, width: 1024, height: 768), visibleFrame: CGRect(x: 0, y: 799, width: 1024, height: 737))
+    #expect(both(Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 737)), below]), 1023, 767) == [CGPoint(x: 1023, y: 740), CGPoint(x: 1023, y: 799)])
+    // Wholly off two displays.
+    let two = Screens([(Self.small, CGRect(x: 0, y: 31, width: 1024, height: 674)), Self.neighbour])
+    #expect(both(two, 2600, -50) == [CGPoint(x: 2600, y: -50), CGPoint(x: 2008, y: 31)])
+    #expect(both(two, -600, 767) == [CGPoint(x: -600, y: 677), CGPoint(x: -440, y: 677)])
+  }
+
+  // MARK: Where nobody has looked
+
+  /// What goes further than a Mac was asked is switched off, and there a window comes to rest as by the old rule: the corner's display keeps the title bar above its
+  /// bottom. With the switch: what the rule would make of it. Each is owed a Mac.
+  @Test func whereNobodyHasLooked() {
+    func rests(_ screens: Screens, _ asked: CGRect, _ titleBar: CGFloat, wherever: Bool = false, bottom: Bool = false, again: Bool = false) -> CGFloat {
+      var screens = screens
+      (screens.mostOfItJudgesWhereverTheCornerIs, screens.judgeStopsItAtTheBottomToo, screens.judgesAgain) = (wherever, bottom, again)
+      return screens.rest(of: asked, titleBar: titleBar).y
+    }
+    let usual = (frame: CGRect(x: 0, y: 0, width: 1440, height: 900), visibleFrame: CGRect(x: 0, y: 25, width: 1440, height: 875))
+
+    // A desk people have: across a laptop and the monitor below it, the title bar well in view above, most of the window below.
+    let desk = Screens([
+      (CGRect(x: 0, y: 0, width: 1512, height: 982), CGRect(x: 0, y: 37, width: 1512, height: 945)),
+      (CGRect(x: -500, y: 982, width: 2560, height: 1440), CGRect(x: -500, y: 1007, width: 2560, height: 1415)),
+    ])
+    for x: CGFloat in [1000, -100] {  // its corner on the laptop; and off its left edge, on no display
+      let across = CGRect(x: x, y: 680, width: 800, height: 600)
+      #expect(rests(desk, across, 28) == 680)
+      #expect(rests(desk, across, 28, wherever: true) == 1007)
+    }
+
+    // Under the bottom edge, above a display below: all of its width and one row of it on the display its corner is on.
+    let below = (frame: CGRect(x: 0, y: 900, width: 1440, height: 900), visibleFrame: CGRect(x: 0, y: 925, width: 1440, height: 875))
+    let under = CGRect(x: 0, y: 899, width: 640, height: 420)
+    #expect(rests(Screens([usual, below]), under, 28) == 872)
+    #expect(rests(Screens([usual, below]), under, 28, wherever: true) == 925)
+
+    // The bottom right corner beside a neighbour that reaches lower, which has most of the window.
+    #expect(rests(Self.arrangement("t4"), CGRect(x: 1599, y: 899, width: 1000, height: 600), 52) == 770)
+    #expect(rests(Self.arrangement("t4"), CGRect(x: 1599, y: 899, width: 1000, height: 600), 52, bottom: true) == 899)
+
+    // Two displays side by side that end alike, the Dock on the first: one row of the window on the second.
+    let sideBySide = Screens([
+      (CGRect(x: 0, y: 0, width: 1600, height: 900), CGRect(x: 0, y: 31, width: 1600, height: 799)),
+      (CGRect(x: 1600, y: 0, width: 1600, height: 900), CGRect(x: 1600, y: 31, width: 1600, height: 869)),
+    ])
+    #expect(rests(sideBySide, CGRect(x: 1599, y: 899, width: 656, height: 422), 28) == 802)
+    #expect(rests(sideBySide, CGRect(x: 1599, y: 899, width: 656, height: 422), 28, bottom: true) == 872)
+
+    // A bottom corner beside a neighbour that ends 60 points higher: stopped by the main display, the window reaches the neighbour, which has most of it then.
+    let endsHigher = CGRect(x: 1440, y: 0, width: 1280, height: 840)
+    let corner = CGRect(x: 1439, y: 899, width: 640, height: 420)
+    #expect(rests(Screens([usual, (endsHigher, endsHigher)]), corner, 80) == 820)
+    #expect(rests(Screens([usual, (endsHigher, endsHigher)]), corner, 80, again: true) == 820, "the bottom is the corner's display's still")
+    #expect(rests(Screens([usual, (endsHigher, endsHigher)]), corner, 80, bottom: true, again: true) == 760)
+  }
+
+  /// Here the old rule is not kept, for the stop at the top was seen: pushed below the main display's menu bar, a window 480 high comes to reach the left neighbour
+  /// that begins 500 lower. Whether that neighbour then has its say nobody has asked.
+  @Test func pushedDownItReachesANeighbour() {
+    var screens = Self.arrangement("t3")
+    let high = CGRect(x: -655, y: 0, width: 656, height: 480)
+    #expect(screens.rest(of: high, titleBar: 32).y == 31)
+    screens.judgesAgain = true
+    #expect(screens.rest(of: high, titleBar: 32).y == 531)
+  }
+
+  /// No switch changes where any of the 78 came to rest: no call that was made tells them apart, which is why they are guesses. Nor does any touch `stages`.
+  @Test(arguments: [(true, false, false, false), (false, true, false, false), (false, false, true, false), (false, false, false, true), (true, true, true, true)])
+  func noCallThatWasMadeTellsTheSwitchesApart(wherever: Bool, bottom: Bool, again: Bool, guesses: Bool) {
+    for call in Self.calls {
+      var screens = Self.arrangement(call.arrangement)
+      let (plain, way) = (screens.rest(of: Self.asked(call), titleBar: call.window.titleBar), screens.stages(of: Self.asked(call), titleBar: call.window.titleBar))
+      (screens.mostOfItJudgesWhereverTheCornerIs, screens.judgeStopsItAtTheBottomToo, screens.judgesAgain) = (wherever, bottom, again)
+      screens.playsTheGuessesBesideWhatWasSeen = guesses
+      #expect(screens.rest(of: Self.asked(call), titleBar: call.window.titleBar) == plain, "\(call.arrangement): \(call.window) asked for \(call.x),\(call.y)")
+      #expect(screens.stages(of: Self.asked(call), titleBar: call.window.titleBar) == way)
+    }
+  }
+
+  @Test func whoJudges() {
+    let screens = Self.arrangement("t6")
+    #expect(screens.judge(of: CGRect(x: 1599, y: 0, width: 656, height: 422)) == 1, "its corner is on the main display, all but a column of it on the neighbour")
+    #expect(screens.cornersDisplay(of: CGRect(x: 1599, y: 0, width: 656, height: 422)) == 0)
+    #expect(screens.cornersDisplay(of: CGRect(x: 1600, y: 0, width: 656, height: 422)) == 1, "a point on a shared edge belongs to the display it is inside")
+    #expect(screens.judge(of: CGRect(x: 300, y: 200, width: 656, height: 422)) == 0)
+    #expect(screens.judge(of: CGRect(x: 1598, y: 0, width: 656, height: 422)) == 0, "two columns of it on the display its corner is on: nobody has looked")
+    #expect(screens.judge(of: CGRect(x: -5000, y: 0, width: 10, height: 10)) == 0, "on none: the nearest")
+    #expect(Screens([]).judge(of: .zero) == nil)
+    #expect(Screens([]).rest(of: CGRect(x: 5, y: 6, width: 7, height: 8), titleBar: 28) == CGPoint(x: 5, y: 6))
+    #expect(Screens([]).stages(of: CGRect(x: 5, y: 6, width: 7, height: 8), titleBar: 28) == [CGPoint(x: 5, y: 6)])
+  }
+}
