@@ -0,0 +1,354 @@
+import ArborCore
+@testable import ArborKit
+import ArborTesting
+import CoreGraphics
+import Testing
+
+/// What is heard of the stand-in: of a window whether it is in the Dock, and of the displays that they changed, each with the main display's visible frame as macOS
+/// has it at that moment.
+@MainActor
+private final class Heard: WindowSystemEvents {
+  unowned let system: FakeWindowSystem
+  var lines: [String] = []
+  init(_ system: FakeWindowSystem) { self.system = system }
+
+  var visible: String {
+    let frame = system.displays()[0].visibleFrame
+    return "\(Int(frame.minX)),\(Int(frame.minY)) \(Int(frame.width))×\(Int(frame.height))"
+  }
+  func windowChanged(_ window: WindowSnapshot, userInitiated: Bool) { lines.append("\(window.isMinimized ? "in the Dock" : "out of it"), \(visible)") }
+  func displaysChanged() { lines.append("told, \(visible)") }
+  func windowAppeared(_ window: WindowSnapshot) {}
+  func windowDestroyed(_ id: WindowID) { lines.append("gone, \(visible)") }
+  func windowFocused(_ id: WindowID) {}
+  func applicationActivated(_ app: FrontmostApp?) {}
+  func accessibilityWasRefused() {}
+  func dragBegan(_ id: WindowID, at point: CGPoint) {}
+  func dragMoved(_ id: WindowID, to point: CGPoint) {}
+  func dragEnded(_ id: WindowID, at point: CGPoint) {}
+  func resizeBegan(_ id: WindowID) {}
+  func resizeEnded(_ id: WindowID) {}
+  func keyboardFocusMoved() {}
+  func dragCancelled(_ id: WindowID) {}
+  func windowReplaced(_ old: WindowID, by window: WindowSnapshot) {}
+  func pointerPressed() {}
+}
+
+/// A Dock that is full changes its size with what is in it, and the visible frame with it (`FakeWindowSystem.theDockTakes`).
+@Suite @MainActor struct TheDockMakesRoomTests {
+  static func display(_ size: CGSize, visible: CGRect) -> DisplaySnapshot {
+    DisplaySnapshot(id: DisplayID("main"), frame: CGRect(origin: .zero, size: size), visibleFrame: visible, isMain: true)
+  }
+  /// Displays of the recordings. The small one's Dock is full, the wide one's has room.
+  static let small = display(CGSize(width: 1024, height: 768), visible: CGRect(x: 0, y: 31, width: 1024, height: 674))
+  static let wide = display(CGSize(width: 1600, height: 900), visible: CGRect(x: 0, y: 31, width: 1600, height: 791))
+
+  /// The stand-in with one window and somebody who listens. What comes later is kept, with the seconds, until `tell` is called.
+  fileprivate func listening(on display: DisplaySnapshot) -> (FakeWindowSystem, WindowID, Heard, later: () -> [Double], tell: () -> Void) {
+    let system = FakeWindowSystem(displays: [display])
+    let window = system.open(app: "Notes", pid: 11, frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+    let heard = Heard(system)
+    system.events = heard
+    system.start()
+    final class Kept { var work: [String: (Double, @MainActor () -> Void)] = [:] }
+    let kept = Kept()
+    system.later = { name, seconds, work in kept.work[name] = work.map { (seconds, $0) } }
+    return (
+      system, window, heard, { kept.work.values.map { ($0.0 * 100).rounded() / 100 } },
+      {
+        let work = kept.work.values.map(\.1)
+        kept.work = [:]
+        for piece in work { piece() }
+      }
+    )
+  }
+
+  /// As it was recorded most often. A window that goes into the Dock speaks while macOS still has the old list, 36 times of 54; then the list is new. One that leaves it
+  /// speaks under the new list, 50 times of 58. Arbor is told a third of a second after each, and the restore undoes the minimize to the point, 50 of 50.
+  @Test func intoTheDockAndOutOfIt() {
+    let (system, window, heard, later, tell) = listening(on: Self.small)
+    system.setMinimized(window, true)
+    #expect(heard.lines == ["in the Dock, 0,31 1024×674"])
+    #expect(system.displays() == [Self.display(CGSize(width: 1024, height: 768), visible: CGRect(x: 0, y: 31, width: 1024, height: 676))])
+    #expect(later() == [0.35])
+    tell()
+    #expect(heard.lines == ["in the Dock, 0,31 1024×674", "told, 0,31 1024×676"])
+
+    heard.lines = []
+    system.setMinimized(window, false)
+    #expect(heard.lines == ["out of it, 0,31 1024×674"])
+    #expect(system.displays() == [Self.small])
+    #expect(later() == [0.35])
+    tell()
+    #expect(heard.lines == ["out of it, 0,31 1024×674", "told, 0,31 1024×674"])
+  }
+
+  /// The other order, which was recorded in the same scripts: 18 of 54 and 8 of 58.
+  @Test func theOtherWayRound() {
+    let (system, window, heard, _, tell) = listening(on: Self.small)
+    system.theDockSpeaksTheOtherWay = true
+    system.setMinimized(window, true)
+    tell()
+    system.setMinimized(window, false)
+    tell()
+    #expect(heard.lines == ["in the Dock, 0,31 1024×676", "told, 0,31 1024×676", "out of it, 0,31 1024×676", "told, 0,31 1024×674"])
+  }
+
+  /// At a side it is the width, by a point: two minimizes and two restores were recorded with the Dock at the left, as many with it at the right.
+  @Test(arguments: [
+    (CGRect(x: 50, y: 31, width: 974, height: 737), CGRect(x: 49, y: 31, width: 975, height: 737)),
+    (CGRect(x: 0, y: 31, width: 974, height: 737), CGRect(x: 0, y: 31, width: 975, height: 737)),
+  ]) func atASide(visible: CGRect, withOneInIt: CGRect) {
+    let (system, window, _, _, _) = listening(on: Self.display(CGSize(width: 1024, height: 768), visible: visible))
+    system.setMinimized(window, true)
+    #expect(system.displays()[0].visibleFrame == withOneInIt)
+    system.setMinimized(window, false)
+    #expect(system.displays()[0].visibleFrame == visible)
+  }
+
+  /// A Dock at its full size has room, keeps its size, and macOS says nothing: 48 of the 56 that were recorded so. In the other 8, where it looks to have held one app more, the
+  /// height went from 791 to 793 and back. A lower one on the same display changed 4 times of 4.
+  @Test func aDockWithRoom() {
+    let (system, window, heard, later, _) = listening(on: Self.wide)
+    system.setMinimized(window, true)
+    system.setMinimized(window, false)
+    #expect(heard.lines == ["in the Dock, 0,31 1600×791", "out of it, 0,31 1600×791"])
+    #expect(later().isEmpty)
+
+    system.dockIsFull = true
+    system.setMinimized(window, true)
+    #expect(system.displays()[0].visibleFrame.height == 793)
+    system.setMinimized(window, false)
+    #expect(system.displays() == [Self.wide])
+
