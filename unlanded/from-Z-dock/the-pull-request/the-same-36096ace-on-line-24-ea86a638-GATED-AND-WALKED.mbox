+  /// Two windows docked one above the other on the small display, and a third that floats.
+  func desk() -> (Harness, a: WindowID, b: WindowID, c: WindowID) {
+    let h = Harness(displays: [Self.small], settings: Settings())
+    let a = h.system.open(app: "Notes", pid: 11, frame: CGRect(x: 100, y: 100, width: 400, height: 300))
+    let b = h.system.open(app: "Mail", pid: 12, frame: CGRect(x: 200, y: 150, width: 400, height: 300))
+    let c = h.system.open(app: "Safari", pid: 13, frame: CGRect(x: 300, y: 200, width: 400, height: 300))
+    h.start()
+    h.run("dock \(a.rawValue) left")
+    h.run("dock \(b.rawValue) beside \(a.rawValue) bottom")
+    h.scheduler.advance(by: 2)
+    return (h, a, b, c)
+  }
+
+  /// In a harness the news comes by its clock: Arbor goes by the old visible frame for a third of a second, as on a Mac, and then by the new one.
+  @Test func arborHearsOfItAThirdOfASecondLater() {
+    let (h, _, _, c) = desk()
+    h.system.setMinimized(c, true)
+    #expect(h.system.displays()[0].visibleFrame.height == 676)
+    h.scheduler.advance(by: 0.34)
+    #expect(h.system.displaysLastTold == [Self.small])
+    h.scheduler.advance(by: 0.02)
+    #expect(h.system.displaysLastTold == h.system.displays())
+    #expect(h.controller.displays == h.system.displays())
+  }
+
+  /// Each word begins the wait anew: of two windows that go into the Dock a fifth of a second apart Arbor hears once, a third of a second after the second.
+  @Test func twoOneAfterTheOther() {
+    let (h, _, b, c) = desk()
+    h.system.setMinimized(c, true)
+    h.scheduler.advance(by: 0.2)
+    h.system.setMinimized(b, true)
+    h.scheduler.advance(by: 0.34)
+    #expect(h.system.displaysLastTold == [Self.small], "0.54 s after the first")
+    h.scheduler.advance(by: 0.02)
+    #expect(h.system.displaysLastTold[0].visibleFrame.height == 678)
+  }
+
+  /// A display is plugged in while the news of the Dock is on its way. At macOS's word the layer lets go of that wait, and Arbor hears of both when it would have heard
+  /// of the display: not a third of a second after the minimize.
+  @Test func aDisplayComesWhileTheNewsIsOnItsWay() {
+    let (h, _, _, c) = desk()
+    h.system.setMinimized(c, true)
+    let side = DisplaySnapshot(
+      id: DisplayID("side"), frame: CGRect(x: 1024, y: 0, width: 1280, height: 800), visibleFrame: CGRect(x: 1024, y: 31, width: 1280, height: 769),
+      isMain: false)
+    var toldAfterASecond: [DisplaySnapshot] = []
+    h.scheduler.schedule("a look", after: 1) { toldAfterASecond = h.system.displaysLastTold }
+    h.system.changeDisplaysAsAMacDoes(h.system.displays() + [side])
+    #expect(toldAfterASecond == [Self.small])
+    #expect(h.system.displaysLastTold.map(\.visibleFrame.height) == [676, 769])
+  }
