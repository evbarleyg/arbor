+// MARK: The Dock makes room
+
+extension FakeWindowSystem {
+  /// What is `later` is called while Arbor has not been told yet of a list that macOS has already.
+  static let newsOfTheScreens = "macOS has spoken of its screens"
+
+  /// A window goes into the Dock. From 826 recordings of hosted Macs (all but one macOS 26.6), 164 minimizes and restores that stand alone, all of test windows
+  /// where the display is the small one:
+  ///
+  /// - A Dock lower than 78 points, or narrower at a side, changed its size at every one that could be seen: 100 of 100 on 1024×768, where it was 58 to 63 high or 50
+  ///   wide, and 4 of 4 on 1600×900, where it was 73 and 75 high. One of 78, on 1600×900 and 1920×1080, at 8 of 56: that is its full size, it has
+  ///   room, and what parts the 8 from the 48 looks like one more app in it. (The 48 rest on macOS's silence: no word, no news, one value all
+  ///   through 22 recordings.) So a Dock lower than 78 is taken to be squeezed, and full. A person can make a Dock small that has
+  ///   room: nobody has recorded one, and there this is a guess. `dockIsFull` says otherwise.
+  /// - It is the main display's, and the Dock's side of it alone. At the bottom the height grew by 2 at a minimize (43 times; by 1 five times, further up the
+  ///   ladder, which is not played); at a side the width by 1 (2 and 2, in two runs). The restore of the same window undid it to the
+  ///   point, 50 of the 50 that had something to undo.
+  /// - In one step. Of the 112 that have a word of macOS's about its screens at all each has one, and macOS's list is new at that word: no look before
+  ///   it had the new list, the nearest 6 ms before, and none after it the old, the nearest 1 ms after.
+  /// - Arbor is told as the Accessibility layer tells it (`macOSSpeaksOfItsScreens`): 0.35 s after the word in the middle. No time passes here: that
+  ///   comes `later`. Between a window's report and the word no timer of Arbor's ran that lays anything out.
+  ///
+  /// A display without a Dock, as `standardDisplay` is, was never recorded: nothing happens there. Not played either: what an app does that joins or leaves the
+  /// Dock (674 to 677, once); several windows at once (four in 1.2 s: three words, +1 +3 +1), against which each counts alike here; a window that
+  /// fills the visible frame and that macOS itself makes higher with it (once); a Dock that is hidden or on another display; news that came
+  /// late or never because Arbor was busy.
+  ///
+  /// A list of displays that a caller gives while a window is in the Dock is taken to be the list with that window in it: when it leaves, the Dock takes its 2 points
+  /// from that list.
+  func theDockTakes(_ window: WindowID) {
+    guard echoes.dockMakesRoom, roomTheDockMade[window] == nil, let main = displayList.firstIndex(where: \.isMain) else { return }
+    let (frame, visible) = (displayList[main].frame, displayList[main].visibleFrame)
+    let (bottom, left, right) = (frame.maxY - visible.maxY, visible.minX - frame.minX, frame.maxX - visible.maxX)
+    let dock = max(bottom, left, right)
+    guard dock > 2, dockIsFull ?? (dock < 78) else { return }
+    let change =
+      dock == bottom ? CGRect(x: 0, y: 0, width: 0, height: 2) : CGRect(x: dock == left ? -1 : 0, y: 0, width: 1, height: 0)
+    roomTheDockMade[window] = (displayList[main].id, change)
+    theVisibleFrame(of: displayList[main].id, changesBy: change, 1)
+  }
+
+  /// A window leaves the Dock, which takes back what it gave up for that window, on the display where it gave it. Nothing, for one that was in it from the beginning.
+  func theDockLetsGo(of window: WindowID) {
+    guard let made = roomTheDockMade.removeValue(forKey: window) else { return }
+    theVisibleFrame(of: made.display, changesBy: made.change, -1)
+  }
+
+  private func theVisibleFrame(of display: DisplayID, changesBy change: CGRect, _ sign: CGFloat) {
+    guard let index = displayList.firstIndex(where: { $0.id == display }) else { return }
+    let visible = displayList[index].visibleFrame
+    displayList[index].visibleFrame = CGRect(
+      x: visible.minX + sign * change.minX, y: visible.minY, width: visible.width + sign * change.width, height: visible.height + sign * change.height)
+    macOSSpeaksOfItsScreens()
+  }
+
+  /// What the Accessibility layer does at a word of macOS's about its screens (`AXWindowSystem.screensChanged`): it lets go of what it was waiting for, waits anew if the
+  /// list is another than Arbor was last told, and looks again when the time has come.
+  func macOSSpeaksOfItsScreens() {
+    later?(Self.newsOfTheScreens, 0, nil)
+    guard started, let quiet = DisplayChange.settleTime(from: displaysLastTold, to: displayList) else { return }
+    let tell: @MainActor () -> Void = { [weak self] in
+      guard let self, started, DisplayChange.settleTime(from: displaysLastTold, to: displayList) != nil else { return }
+      setDisplays(displayList)
+    }
+    if let later { later(Self.newsOfTheScreens, quiet + 0.05, tell) } else { tell() }
+  }
+}
