+  /// What Arbor makes of it today, as 23 minimizes in 17 recordings have it: a docked window goes into the Dock, its neighbour takes the room at once, by the visible frame macOS still had,
+  /// and gets 2 points of height more when Arbor hears of the Dock. Two points are no move by the measures of docs/VIABLE.md. Where macOS's list was new
+  /// at the act, as mostly at a restore, there is one layout.
+  @Test func aNeighbourIsLaidOutAtTheActAndAgainAtTheNews() {
+    let (h, a, b, _) = desk()
+    var set: [(frame: CGRect, after: Double)] = []
+    var began = h.scheduler.now
+    h.system.willSetFrame = { window, frame in if window == a { set.append((frame, ((h.scheduler.now - began) * 100).rounded() / 100)) } }
+    let before = h.frame(a)!
+    h.system.setMinimized(b, true)
+    h.scheduler.advance(by: 1)
+    #expect(set.map(\.after) == [0, 0.35])
+    #expect(set[0].frame.height > before.height, "it takes the room")
+    #expect(set[1].frame == CGRect(x: set[0].frame.minX, y: set[0].frame.minY, width: set[0].frame.width, height: set[0].frame.height + 2))
+
+    (set, began) = ([], h.scheduler.now)
+    h.system.setMinimized(b, false)
+    h.scheduler.advance(by: 1)
+    #expect(set.map(\.after) == [0])
+    #expect(h.frame(a) == before)
+    expectWindowsMatchLayout(h)
+  }
