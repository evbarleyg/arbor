+/// `rotate` cannot know how small the apps let their windows get. Each is asked where it stands, before anybody moves, and where one refuses
+/// the command takes itself back on paper.
+@Suite @MainActor struct RotateIsOneLayoutTests {
+  /// One above the other they need 1000 points of the display's 875: no room can be made.
+  @Test func whereThereIsNotEnoughRoomNobodyGoesAnywhere() {
+    let h = Harness()
+    let a = h.system.open(app: "A", pid: 1001, frame: CGRect(x: 100, y: 100, width: 400, height: 520), minimumSize: CGSize(width: 300, height: 500))
+    let b = h.system.open(app: "B", pid: 1002, frame: CGRect(x: 300, y: 100, width: 400, height: 520), minimumSize: CGSize(width: 300, height: 500))
+    h.start()
+    runOK(h, "dock \(a.rawValue) left")
+    runOK(h, "dock \(b.rawValue) right")
+    let (before, frames) = (h.workspace, [h.frame(a)!, h.frame(b)!])
+    let roads = Roads(h) { #expect(h.run("rotate").message.hasPrefix("not enough room: rotated, ")) }
+    #expect(roads.roads.values.allSatisfy { FakeWindowSystem.changesOfPlace($0) == 0 }, "\(roads.roads.mapValues { $0.map(\.brief) })")
+    #expect(h.workspace == before && [h.frame(a)!, h.frame(b)!] == frames)
+    expectSound(h)
+  }
+
+  /// Where there is room it turns, and everybody moves once.
+  @Test func whereThereIsRoomEverybodyMovesOnce() {
+    let (h, _) = tilingScenario(["A", "B"], ["dock $0 left", "dock $1 right"])
+    let roads = Roads(h) { runOK(h, "rotate") }
+    roads.expectOneRoadEach()
+    expectSound(h)
+  }
+
+  /// Ordinary apps on ordinary displays. Ten moves, and nothing had changed.
+  @Test(arguments: [
+    """
+    displays side:0,0,1920,1080:25,0,70,0* windows-never
+    launch
+    open 101 Safari pid 1000 at 100 80 1200 800 min 574 240
+    focus 101
+    open 102 Mail pid 1002 at 160 120 1100 700 min 760 400
+    focus 102
+    open 103 Music pid 1006 at 220 160 980 600 min 680 480
+    focus 103
+    via shortcut arrange
+    cursor 5 5
+    key down rotate
+    """,
+    """
+    displays side:0,0,2560,1440:25,0,0,70* windows-never
+    open 101 Safari pid 1000 at 861 153 972 864 min 574 240
+    open 102 Notes pid 1001 at 157 794 819 516 min 709 300
+    open 103 Xcode pid 1004 at 677 463 1188 744 min 1188 685
+    launch
+    via shortcut arrange
+    key down rotate
+    """,
+  ]) func nobodyChangesPlaceForARefusal(_ script: String) {
+    let runner = ChaosRunner()
+    let actions = ChaosAction.script(script)
+    for action in actions.dropLast() { _ = runner.step(action) }
+    let mark = runner.system.moveLog.count
+    let broken = runner.step(actions.last!).map(\.rule)
+    #expect(runner.system.moveLog.count > mark, "the story needs a window that is asked and refuses")
+    for window in Set(runner.system.moveLog[mark...].map(\.window)).sorted() {
+      let road = runner.system.road(of: window, since: mark)
+      #expect(FakeWindowSystem.changesOfPlace(road) == 0, "\(window): \(road.map(\.brief))")
+    }
+    #expect(!broken.contains { $0.hasPrefix("flashed-") || $0.hasPrefix("moved-twice") }, "\(broken)")
+  }
+}
