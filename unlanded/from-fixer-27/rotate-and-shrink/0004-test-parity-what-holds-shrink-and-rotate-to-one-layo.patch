+        "theWholeViewTurnsAndStaysTheView",
+        "whereThereIsNotEnoughRoomNobodyGoesAnywhere",
+        "whereThereIsRoomEverybodyMovesOnce"
       ],
       "e2e": [
         "choose Adjust, Balance Sizes and Adjust, Mirror Group from the menu: they do what the shortcuts do",
