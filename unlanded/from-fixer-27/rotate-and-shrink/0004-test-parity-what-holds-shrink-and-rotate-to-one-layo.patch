 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/collab/parity.json b/collab/parity.json
index f5a09634..404d6825 100644
--- a/collab/parity.json
+++ b/collab/parity.json
@@ -2461,6 +2461,8 @@
         "aFloatingWindowPutOverDockedWindowsGrowsWhereItIs",
         "aGroupThatRunsAlongItsRowCountsForAsManyPlacesAsItShows",
