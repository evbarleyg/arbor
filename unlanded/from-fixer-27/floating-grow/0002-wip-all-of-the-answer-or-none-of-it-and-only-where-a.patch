+  /// How many places a window is sent to at the last line of a script of the walks, and how often it is asked for anything.
+  private func atTheEnd(of script: String, _ window: WindowID) -> (places: Int, requests: Int) {
+    let runner = ChaosRunner()
+    let actions = ChaosAction.script(script)
+    for action in actions.dropLast() { _ = runner.step(action) }
+    let mark = runner.system.moveLog.count
+    _ = runner.step(actions.last!)
+    return (
+      FakeWindowSystem.changesOfPlace(runner.system.road(of: window, since: mark)),
+      runner.system.moveLog[mark...].filter { $0.window == window }.count
+    )
+  }
+
+  /// All or nothing. A window that grows neither way stands on the line above the Dock when it is asked to grow: its height may be the
+  /// screen's answer. With its width alone on record it went to the middle one way, back to the corner to be asked the other, and to the
+  /// middle again: three places, where knowing nothing costs two.
+  @Test func halfAnAnswerIsNotWrittenDown() {
+    let (places, requests) = atTheEnd(
+      of: """
+        displays side:0,0,2560,1440:25,0,59,0* windows-never
+        launch
+        open 107 Settings pid 1007 at 900 796 723 585 min 723 470 max 723 585
+        settle
+        focus 107
+        key down grow
+        settle
+        key down dock right
+        """, WindowID(107))
+    #expect(places == 2, "as if nothing were known; \(requests) requests")
+  }
+
+  /// A terminal takes the whole cells nearest to what it is offered: neither what it was offered nor a stop. Nothing is written down, and it is
+  /// treated as if it had never been asked. (A walk's own script: with its answer on record it was set right by a point in its slot.)
+  @Test func aTerminalsAnswerIsNotWrittenDown() {
+    let (places, requests) = atTheEnd(
+      of: """
+        displays main:0,0,1440,900:25,0,48,0* side:-1920,-200,1920,1080:25,0,0,0 windows-never
+        open 101 Terminal pid 1003 at -987 144 912 564 min 177 64 cells 7 15 2 4
+        launch
+        key down zoom
+        key down grow
+        edge 101 -2638 -35 1920 972
+        key down toggle-float
+        """, WindowID(101))
+    #expect(places == 1 && requests == 1, "\(places) places, \(requests) requests")
+  }
+
+  /// An app that hangs does not answer at all, which looks like a window that grows neither way. One that has heard has at least moved: a
+  /// window grows about its middle.
+  @Test func anAppThatHangsHasSaidNothing() {
+    let (places, requests) = atTheEnd(
+      of: """
+        displays side:0,0,2560,1440:25,0,59,0* windows-never
+        launch
+        open 107 Notes pid 1001 at 1358 463 723 585 min 300 200
+        settle
+        focus 107
+        behave 107 frozen
+        key down grow
+        settle
+        behave 107 normal
+        key down dock right
+        """, WindowID(107))
+    #expect(places == 1, "it fills its slot in one move; \(requests) requests")
+  }
+
+  /// A few points short is what a terminal's rounding looks like (`SeenSizes.largestStep`): nobody calls that a stop.
+  @Test func aFewPointsShortSayNothing() {
+    let (h, window) = settings()
+    runOK(h, "grow 20")
+    h.scheduler.advance(by: 1)
+    let roads = Roads(h) { runOK(h, "dock right") }
+    #expect(roads.roads[window].map(FakeWindowSystem.changesOfPlace) == 2, "as if nothing were known: \(roads.roads[window]?.map(\.brief) ?? [])")
+  }
 }
