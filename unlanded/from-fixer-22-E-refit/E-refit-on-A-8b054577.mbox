@@ -625,14 +625,21 @@ extension Controller {
     }
   }
 
-  /// Whether `window` floats on `displayID` and is meant to show with the view there as it is: told to stay in view, or on a
-  /// Desktop that is part of the view. By the layout in effect, not a fresh one, which widens to the surroundings of a view
-  /// whose window takes up no room; and a held view that shows nothing gives nothing away, wherever its camera has got to.
+  /// Whether `window` floats on `displayID` and is meant to show with the view there as it is. Told to stay in view, it is. So is one that is off
+  /// the screen, over a view framed on something else than the Desktop too: it is as a window that comes out of the Dock, nobody has asked
+  /// Arbor for anything, and in sight macOS would have brought it there to stay (`takeFloatingWindowsFromWhereTheyAre`; the product owner,
+  /// 2026-10-15).
+  ///
+  /// Not so while the view is held, which gives nothing away, or where floating windows make way; and about a window on the screen the layout
+  /// has had its say. These show only on a Desktop that is part of the view. By the layout in effect, not a fresh one, which widens to
+  /// the surroundings of a view whose window takes up no room; and a held view that shows nothing lets nothing in, wherever its camera
+  /// has got to.
   private func floatsInView(_ window: WindowID, on displayID: DisplayID) -> Bool {
     guard let workspace = workspaces[displayID], workspace.isFloating(window), !workspace.isStashed(window),
       !holdKeepsOut(window)
     else { return false }
     if workspace.staysInView(window) { return true }
+    guard holdLevel == .view || settings.floatingWindowsMakeWay || windows[window]?.isPresent == true else { return true }
     guard !displaysHeldEmpty.contains(displayID) else { return false }
     return layouts[displayID].map { workspace.tree.subtree($0.camera, contains: workspace.tree.desktop) } ?? false
   }
