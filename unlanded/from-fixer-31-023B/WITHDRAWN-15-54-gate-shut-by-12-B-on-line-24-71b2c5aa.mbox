--- /dev/null
+++ b/Sources/ArborKit/Controller/Controller+SpokeAhead.swift
@@ -0,0 +1,125 @@
+import ArborCore
+import CoreGraphics
+import Foundation
+
+/// The window that speaks before the displays have changed.
+///
+/// At a change of displays macOS moves windows and their apps say so. Those reports find macOS with other displays than Arbor was told of
+/// and are turned away (`knowsTheDisplays`). One comes earlier. With eleven real apps on a hosted Mac, in 10 of 13 changes exactly one
+/// window reported its new frame 0.003 to 0.7 s before macOS's own list was new. At that moment nothing tells it from an app's or a
+/// tool's own move, so it is booked like one, by the displays that are about to change: a new place, a hand's note, and a new home where
+/// it crossed a border. It had then left the arrangement that goes to sleep with its display, and did not come back with it; or it kept
+/// the home its report gave it where a display came under it.
+///
+/// So it is booked, and what the books said before is kept for a moment. If macOS turns out to have other displays by then, the entry is
+/// taken back and the window counts as one that macOS moved behind Arbor's back, like all the others. From there on it is one of them:
+/// it is taken from where it is, by the displays that are (`takeFloatingWindowsFromWhereTheyAre`). Books only: no frame is set here.
+///
+/// An app's or a tool's own move in that second is overtaken the same way and loses nothing: the window is taken from where it is. What a hand
+/// or a command of Arbor's has done to it since the report stands: an entry is taken back only while the books say what the report wrote.
+extension Controller {
+  /// Where the books have a floating window, and as what.
+  struct Entry: Equatable {
+    var home: DisplayID
+    var place: CGRect
+    var role: FloatingRole?
+    var fillsAt: CGRect?
+  }
+
+  /// What the books said of a floating window before a report gave it another place.
+  struct BookedAhead {
+    var at: Date
+    var before: Entry
+    /// Filed under another display it is nobody's guest, and being filed back alone does not make it one again.
+    var host: NodeID?
+    /// Of a window that fills the view: that it has been let be where it is would outlive the fill's return.
+    var settled: CGRect?
+    var misfit: (slot: CGRect, frame: CGRect)?
+    var chosen: (frame: CGRect, display: CGRect, showing: CGFloat)?
+    var spoke: Date?
+    var fitted: FittedWindow?
+    /// Alone on its Desktop, a window that its user has moved is not stretched over it again.
+    var wasInHand: Bool
+    /// What the report wrote.
+    var booked: Entry?
+  }
+
+  private func entry(of window: WindowID) -> Entry? {
+    guard let home = workspaceID(containing: window), let place = workspaces[home]!.floating[window] else { return nil }
+    return Entry(home: home, place: place, role: workspaces[home]!.role(of: window), fillsAt: workspaces[home]!.filled?[window])
+  }
+
+  /// How long before macOS's list of displays is new a window may speak of what the change did to it. 0.7 s is the longest recorded.
+  static let aheadOfTheDisplays: TimeInterval = 1
+
+  /// Called before a report of a floating window is booked as a move of its user's. With a button down it is one, whatever was reported
+  /// before. Nor is anything kept of a summoned window: carried to another display it sends away the one that is there, which no book
+  /// brings back. Returns whether the entry may yet be taken back: then nothing is laid out for it until it is known to stay.
+  func keepWhatTheBooksSay(of window: WindowID) -> Bool {
+    guard !system.isMouseButtonDown(), floatingEdgeInHand != window, !fills.inHand.contains(window), let before = entry(of: window),
+      before.role == nil || before.role == .pinned
+    else {
+      bookedAhead[window] = nil
+      return false
+    }
+    // It may speak more than once on its way: that it moved, then that its size changed. What counts is where it was before the first.
+    if let kept = bookedAhead[window], isYoung(kept) { return true }
+    bookedAhead[window] = BookedAhead(
+      at: now(), before: before, host: workspaces[before.home]!.guests?[window], settled: settled[window], misfit: misfits[window],
+      chosen: chosenOnShape[window], spoke: spokeOfItsPlace[window], fitted: fittedToADisplay[window],
+      wasInHand: soleFloats.inHand[before.home] == window)
+    // Nobody else may speak and no key be pressed: Arbor looks by itself.
+    scheduler.schedule("spoke-ahead", after: Self.aheadOfTheDisplays) { [weak self] in self?.theMomentIsOver() }
+    return true
+  }
+
+  /// Called when the report has been booked.
+  func noteWhatWasBookedAhead(of window: WindowID) {
+    if bookedAhead[window] != nil { bookedAhead[window]!.booked = entry(of: window) }
+  }
+
+  private func isYoung(_ kept: BookedAhead) -> Bool { now().timeIntervalSince(kept.at) <= Self.aheadOfTheDisplays + 0.01 }
+
+  /// Called at every sign that macOS has other displays than Arbor was told of, and at the report of the displays. With the displays
+  /// as Arbor knows them nothing is decided yet: a report that is only about the Dock ends no moment.
+  func takeBackWhatWasBookedAhead() {
+    guard !bookedAhead.isEmpty, isRunning, !knowsTheDisplays else { return }
+    let entries = bookedAhead.sorted { $0.key < $1.key }
+    bookedAhead = [:]
+    scheduler.cancel("spoke-ahead")
+    for (window, kept) in entries where isYoung(kept) {
+      // Docked, closed, given or relieved of a part, dropped or sent elsewhere meanwhile: somebody has decided since.
+      let home = kept.before.home
+      guard let booked = kept.booked, booked == entry(of: window), workspaces[home] != nil else { continue }
+      if booked.home != home { workspaces[booked.home]!.floating[window] = nil }
+      workspaces[home]!.floating[window] = kept.before.place
+      workspaces[home]!.setRole(kept.before.role, of: window)
+      // (The end of a fill over a view without the Desktop makes a guest.)
+      if let host = kept.host { workspaces[home]!.receive(window, asGuestOf: host) } else { workspaces[home]!.endVisit(of: window) }
+      if let fillsAt = kept.before.fillsAt {
+        workspaces[home]!.fill(window, at: fillsAt)
+        (settled[window], misfits[window]) = (kept.settled, kept.misfit)
+      }
+      chosenOnShape[window] = kept.chosen
+      spokeOfItsPlace[window] = kept.spoke
+      fittedToADisplay[window] = kept.fitted
+      if !kept.wasInHand { for (display, held) in soleFloats.inHand where held == window { soleFloats.inHand[display] = nil } }
+      Log.debug("window \(window) spoke before the displays changed: not its user's move")
+      if booked.home != home { notify(.windows) }
+      noteMoveBehindArborsBack(of: window)
+    }
+    scheduleSave()
+  }
+
+  /// A moment after the last entry. The displays are other: see above. They are as they were: the moves were what they looked like, they
+  /// stay booked, and what was owed to them is laid out now.
+  private func theMomentIsOver() {
+    takeBackWhatWasBookedAhead()
+    let entries = bookedAhead.sorted { $0.key < $1.key }
+    bookedAhead = [:]
+    for (window, kept) in entries {
+      guard let home = workspaceID(containing: window), home != kept.before.home else { continue }
+      floatingWindowMoved(window, from: kept.before.home)
+    }
+  }
+}
