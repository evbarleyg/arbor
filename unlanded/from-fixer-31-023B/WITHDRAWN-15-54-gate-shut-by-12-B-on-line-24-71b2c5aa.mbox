+  /// That it moved, and then that its size changed: what counts is where it was before the first.
+  @Test(arguments: Change.allCases)
+  func itSpeaksTwice(_ change: Change) {
+    func play(early: Bool) -> Harness {
+      let h = make()
+      let (displays, moves) = plan(change, h)
+      func speaks(_ window: WindowID, _ frame: CGRect) {
+        h.system.userMove(window, to: CGRect(origin: frame.origin, size: h.frame(window)!.size))
+        h.system.userMove(window, to: frame)
+      }
+      let smaller = moves.map { ($0.0, $0.0 == WindowID(105) ? $0.1.insetBy(dx: 40, dy: 30) : $0.1) }
+      for (window, frame) in smaller where early && window == WindowID(105) { speaks(window, frame) }
+      h.scheduler.advance(by: 0.3)
+      h.system.displayList = displays
+      for (window, frame) in smaller where !early || window != WindowID(105) { speaks(window, frame) }
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays(displays)
+      h.scheduler.advance(by: 5)
+      return h
+    }
+    expectTheSameEnd(play(early: true), play(early: false), "\(change)")
+  }
