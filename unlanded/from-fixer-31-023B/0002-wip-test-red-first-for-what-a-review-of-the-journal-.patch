+  /// Nor is it lost where the second ends early: a hand takes the window, or it closes.
+  @Test(arguments: ["a hand takes its edge", "it closes"])
+  func whatWasOwedIsLaidOutWhereTheMomentEndsEarly(_ what: String) {
+    var settings = Settings.makingWay
+    settings.soleFloatTakesDesktop = true
+    let h = make(settings)
+    #expect(h.run("dock 102 left").ok && h.run("dock 105 left").ok)
+    h.system.close(WindowID(106))
+    h.scheduler.advance(by: 5)
+    // 101 and 103 share the laptop's Desktop, 104 has the side's. A tool takes 103 over to the side.
+    let shared = h.frame(WindowID(101))!
+    h.system.userMove(WindowID(103), to: CGRect(x: 2600, y: 300, width: 480, height: 348))
+    h.scheduler.advance(by: 0.1)
+    if what == "it closes" {
+      h.system.close(WindowID(103))
+    } else {
+      h.system.userResize(WindowID(103), to: CGRect(x: 2600, y: 300, width: 520, height: 348))
+    }
+    h.scheduler.advance(by: 0.5)
+    #expect(h.frame(WindowID(101)) != shared, "alone on the laptop's Desktop, it takes it")
+    expectWindowsMatchLayout(h)
+  }
+
+  /// In its user's hand long before, taken over to the laptop by macOS, and a word about the Dock lays everything out in between.
+  @Test func inHandBeforeAndALayoutInBetween() {
+    var settings = Settings.makingWay
+    settings.soleFloatTakesDesktop = true
+    var withDock = Self.laptop
+    withDock.visibleFrame.size.height -= 60
+    func play(early: Bool) -> Harness {
+      let h = make(settings)
+      leaveOneOnEachDesktop(h)
+      h.system.userMove(WindowID(104), to: CGRect(x: 2500, y: 200, width: 480, height: 348))
+      h.scheduler.advance(by: 5)
+      let over = h.frame(WindowID(104))!.offsetBy(dx: -1740, dy: 0)
+      if early { h.system.userMove(WindowID(104), to: over) }
+      h.scheduler.advance(by: 0.1)
+      h.system.setDisplays([withDock, Self.side])
+      h.scheduler.advance(by: 0.2)
+      h.system.displayList = [withDock]
+      if !early { h.system.userMove(WindowID(104), to: over) }
+      h.system.userMove(WindowID(105), to: h.frame(WindowID(105))!.offsetBy(dx: -1440, dy: 0))
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays([withDock])
+      h.scheduler.advance(by: 5)
+      h.system.setDisplays([withDock, Self.side])
+      h.scheduler.advance(by: 5)
+      return h
+    }
+    expectTheSameEnd(play(early: true), play(early: false), "in hand, and back")
+  }
+
