+  /// A timer on a Mac that is busy changing its displays comes late. The entry lasts as long as its timer.
+  @Test func theLookOutComesLate() {
+    let (early, late) = (make(), make())
+    for h in [early, late] {
+      for window in [WindowID(105), WindowID(106)] { h.system.close(window) }
+      h.scheduler.advance(by: 2)
+    }
+    let (displays, moves) = plan(.theSideGoes, early)
+    early.system.userMove(moves[0].0, to: moves[0].1)
+    early.scheduler.advance(by: 0.3)
+    early.system.displayList = displays
+    early.scheduler.advance(to: early.scheduler.now + 1, holding: { key, _ in key.hasPrefix("spoke-ahead") })
+    for key in early.scheduler.pendingKeys where key.hasPrefix("spoke-ahead") { early.scheduler.fire(key) }
+    early.scheduler.advance(by: DisplayChange.comingAndGoing - 1)
+    early.system.setDisplays(displays)
+    early.scheduler.advance(by: 5)
+    play(.theSideGoes, ahead: [], on: late)
+    expectTheSameEnd(early, late, "a late timer")
+  }
+
+  /// Two speak one after the other, the list is new, and nobody speaks after that.
+  @Test func oneAfterTheOtherAndThenNobody() {
+    func play(early: Bool) -> Harness {
+      let h = make()
+      h.system.close(WindowID(106))
+      h.scheduler.advance(by: 2)
+      let (displays, moves) = plan(.theSideGoes, h)
+      if early { h.system.userMove(moves[0].0, to: moves[0].1) }
+      h.scheduler.advance(by: 0.3)
+      if early { h.system.userMove(moves[1].0, to: moves[1].1) }
+      h.scheduler.advance(by: 0.2)
+      h.system.displayList = displays
+      if !early { for (window, frame) in moves { h.system.userMove(window, to: frame) } }
+      h.scheduler.advance(by: DisplayChange.comingAndGoing)
+      h.system.setDisplays(displays)
+      h.scheduler.advance(by: 5)
+      return h
+    }
+    expectTheSameEnd(play(early: true), play(early: false), "one after the other")
+  }
+
