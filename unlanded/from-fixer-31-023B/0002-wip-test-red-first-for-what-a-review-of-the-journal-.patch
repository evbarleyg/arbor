+  /// The window speaks again after the command, settling: what the command wrote still stands.
+  @Test func itSpeaksAgainAfterACommand() {
+    let h = make()
+    h.system.userMove(WindowID(105), to: CGRect(x: 1700, y: 300, width: 480, height: 348))
+    h.scheduler.advance(by: 0.1)
+    #expect(h.run("move-to-display next 105").ok)
+    h.scheduler.advance(by: 0.1)
+    let there = h.frame(WindowID(105))!.offsetBy(dx: 3, dy: 3)
+    h.system.userMove(WindowID(105), to: there)
+    #expect(h.workspace.floating[WindowID(105)] == there, "the story needs it on the laptop")
+    h.scheduler.advance(by: 0.1)
+    h.system.displayList = [Self.laptop]
+    for window in [WindowID(104), WindowID(106)] { h.system.userMove(window, to: h.frame(window)!.offsetBy(dx: -1440, dy: 0)) }
+    h.scheduler.advance(by: DisplayChange.comingAndGoing)
+    h.system.setDisplays([Self.laptop])
+    h.scheduler.advance(by: 5)
+    #expect(h.controller.dormant[Self.side.id]?.workspace.floating[WindowID(105)] == nil)
+    #expect(h.workspace.floating[WindowID(105)] == there)
+  }
+
+  /// Whoever has just clicked or pressed a modifier key has asked for it: a tool's shortcut, the Window menu. And the reports that trail a hand.
+  @Test(arguments: ["a key or a click", "a hand just now"])
+  func whatFollowsThePersonsOwnActBeginsNoMoment(_ what: String) {
+    let h = make()
+    if what == "a hand just now" {
+      h.system.drag(WindowID(105), through: [CGPoint(x: 1900, y: 170), CGPoint(x: 2000, y: 310)], holding: 0)
+    } else {
+      h.system.secondsSinceInput = 0.4
+    }
+    h.system.userMove(WindowID(105), to: h.frame(WindowID(105))!.offsetBy(dx: 5, dy: 5))
+    #expect(!h.scheduler.pendingKeys.contains { $0.hasPrefix("spoke-ahead") })
+  }
+
+  /// Arbor pauses in that second, the window goes, and Arbor is back before the second is over.
+  @Test func aPauseAndAResumeWithinTheMoment() {
+    let h = make()
+    h.system.userMove(WindowID(105), to: CGRect(x: 300, y: 200, width: 480, height: 348))
+    #expect(h.run("pause").ok)
+    h.system.close(WindowID(105))
+    #expect(h.run("resume").ok)
+    #expect(h.controller.invariantViolations().isEmpty, "\(h.controller.invariantViolations())")
+    #expect(!h.scheduler.pendingKeys.contains { $0.hasPrefix("spoke-ahead") })
+  }
