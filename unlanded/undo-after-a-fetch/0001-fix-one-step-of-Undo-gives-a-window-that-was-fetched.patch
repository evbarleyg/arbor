@@ -0,0 +1,869 @@
+import ArborCore
+@testable import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// A floating window that hangs over an edge and is asked for by name comes in whole (`fetchWhole`, Controller+OpenWindows.swift). Arbor moved
+/// a window at a person's word, and Undo is the way out everywhere else: one step gives it its place at the edge back (board 1.91).
+@MainActor @Suite struct UndoAfterAFetchTests {
+  /// Where its person parked it: 140 of its 400 points show.
+  static let parked = CGRect(x: 1300, y: 500, width: 400, height: 300)
+  /// The shortest way in from there.
+  static let fetched = CGRect(x: 1040, y: 500, width: 400, height: 300)
+
+  /// Safari and Notes float in view, Mail is parked over the right edge by hand, and Safari is being typed in.
+  func desk(settings: Settings = Settings()) -> (Harness, safari: WindowID, notes: WindowID, mail: WindowID) {
+    let h = Harness(settings: settings)
+    let safari = h.system.open(app: "Safari", title: "Arbor docs", pid: 11, frame: CGRect(x: 100, y: 100, width: 600, height: 400))
+    let notes = h.system.open(app: "Notes", title: "Shopping", pid: 12, frame: CGRect(x: 300, y: 200, width: 500, height: 400))
+    let mail = h.system.open(app: "Mail", title: "Inbox", pid: 13, frame: CGRect(x: 500, y: 300, width: 400, height: 300))
+    h.start()
+    h.system.userMove(mail, to: Self.parked)
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    return (h, safari, notes, mail)
+  }
+
+  /// A click on its row in Windows ▸, in the order a Mac reports in.
+  @discardableResult func ask(_ h: Harness, for window: WindowID) -> CommandResult {
+    h.system.restoresLate = true
+    let result = h.controller.perform(.reveal(window), from: .menu)
+    settle(h)
+    return result
+  }
+
+  func settle(_ h: Harness) {
+    h.system.deliverEchoes()
+    h.system.reportFocus()
+    h.system.finishRestoring()
+    h.system.restoresLate = false
+    h.scheduler.advance(by: 2)
+  }
+
+  /// ⌃⌥Z.
+  @discardableResult func undo(_ h: Harness) -> CommandResult {
+    let result = h.controller.perform(.undo, from: .shortcut)
+    settle(h)
+    return result
+  }
+
+  @discardableResult func redo(_ h: Harness) -> CommandResult {
+    let result = h.controller.perform(.redo, from: .shortcut)
+    settle(h)
+    return result
+  }
+
+  func title(_ h: Harness, beginning: String) -> MenuModel.Item? {
+    h.controller.menuModel().allItems.first { $0.title.hasPrefix(beginning) }
+  }
+
+  // MARK: One step, there and back
+
+  @Test func oneStepGivesItItsPlaceAtTheEdgeBack() {
+    let (h, _, _, mail) = desk()
+    #expect(ask(h, for: mail).ok)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+    expectWindowsMatchLayout(h)
+  }
+
+  /// A layout fits what nobody chose. This its person chose twice.
+  @Test func andItStaysThereThroughTheLayoutsThatFollow() {
+    let (h, safari, _, mail) = desk()
+    ask(h, for: mail)
+    undo(h)
+    for line in ["relayout", "dock \(safari.rawValue) left", "zoom \(safari.rawValue)", "show-all", "float \(safari.rawValue)", "relayout"] {
+      h.run(line)
+      h.scheduler.advance(by: 2)
+    }
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  @Test func itGoesBackInOneMoveAndNothingElseMoves() {
+    let (h, safari, notes, mail) = desk()
+    ask(h, for: mail)
+    let others = [h.frame(safari), h.frame(notes)]
+    let mark = h.system.moveLog.count
+    undo(h)
+    #expect(h.system.moveLog[mark...].filter { $0.before != $0.after }.map(\.window) == [mail])
+    #expect(h.system.jolts(since: mark) == [])
+    #expect([h.frame(safari), h.frame(notes)] == others)
+  }
+
+  @Test func redoBringsItInAgainAndUndoTakesItOutAgain() {
+    let (h, _, _, mail) = desk()
+    ask(h, for: mail)
+    undo(h)
+    #expect(redo(h).ok)
+    #expect(h.frame(mail) == Self.fetched)
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+    #expect(!undo(h).ok, "it was one step")
+  }
+
+  // MARK: What a person reads
+
+  @Test func theMenuAndTheLineOnScreenCallItAMove() throws {
+    let (h, _, _, mail) = desk()
+    #expect(title(h, beginning: "Undo")?.isEnabled == false, "nothing to undo yet, or this proves nothing")
+    ask(h, for: mail)
+    let row = try #require(title(h, beginning: "Undo"))
+    #expect(row.title == "Undo Move" && row.isEnabled)
+    undo(h)
+    #expect(h.controller.wordsOnScreen(after: .undo) == "Undid Move")
+    #expect(title(h, beginning: "Redo")?.title == "Redo Move")
+  }
+
+  /// Replies quote labels, and replies are logged.
+  @Test func theStepIsCalledByTheWindowsNumber() {
+    let (h, _, _, mail) = desk()
+    ask(h, for: mail)
+    let label = h.controller.nextStepLabel(.undo)
