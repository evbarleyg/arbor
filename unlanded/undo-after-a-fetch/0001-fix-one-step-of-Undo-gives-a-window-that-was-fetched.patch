+    h.system.moveSilently(mail, to: Self.parked)
+    h.system.report(mail, userInitiated: false)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    h.run("zoom \(safari.rawValue)")
+    h.scheduler.advance(by: 2)
+    let refused = undo(h)
+    #expect(!refused.ok && refused.message == "cannot undo reveal \(mail); undo again to take back dock \(safari) left", "\(refused.message)")
+    #expect(ScenarioExpectation.check(["camera", "\(safari.rawValue)"], harness: h, lastCommandOK: true) == nil, "the view stays")
+  }
+
+  /// However short the way was.
+  @Test func aFetchOfOnePointGoesBackOnePoint() {
+    let (h, safari, _, mail) = desk()
+    h.run("dock \(safari.rawValue) left")
+    let near = CGRect(x: 1041, y: 500, width: 400, height: 300)
+    h.system.userMove(mail, to: near)
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == near)
+    #expect(h.workspace.isDocked(safari))
+  }
+
+  /// Moved by hand since and out of view now: where it is cannot be asked of the screen, and what is remembered says that there is nothing to do.
+  @Test func movedByHandSinceAndOutOfViewNowNothingIsOffered() {
+    let (h, safari, _, mail) = desk()
+    h.run("dock \(safari.rawValue) left")
+    ask(h, for: mail)
+    h.system.userMove(mail, to: CGRect(x: 800, y: 400, width: 400, height: 300))
+    h.scheduler.advance(by: 2)
+    h.run("zoom \(safari.rawValue)")
+    h.scheduler.advance(by: 2)
+    #expect(h.controller.parked.contains(mail), "or this proves nothing")
+    #expect(title(h, beginning: "Undo")?.title == "Undo Dock")
+  }
+
+  // MARK: Among other steps
+
+  @Test func stepsAreTakenBackInTheirOrder() {
+    let (h, safari, _, mail) = desk()
+    h.run("dock \(safari.rawValue) left")
+    ask(h, for: mail)
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+    #expect(h.workspace.isDocked(safari), "the dock is an older step")
+    #expect(undo(h).ok)
+    #expect(h.workspace.isFloating(safari))
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  /// A step made after the fetch is taken back first, and leaves the window where it was fetched to.
+  @Test func aLaterStepLeavesItWhereItWasFetchedTo() {
+    let (h, safari, _, mail) = desk()
+    ask(h, for: mail)
+    h.run("dock \(safari.rawValue) left")
+    #expect(undo(h).ok)
+    #expect(h.workspace.isFloating(safari))
+    #expect(h.frame(mail) == Self.fetched)
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  // MARK: Fetched where nobody saw it
+
+  /// Framed on Safari, Mail is out of view. Asked for, the view goes to it; taken back, the view is on Safari again, and when everything shows
+  /// Mail is at its edge.
+  @Test func askedForWhileItWasOutOfView() {
+    let (h, safari, _, mail) = desk()
+    h.run("dock \(safari.rawValue) left")
+    h.run("zoom \(safari.rawValue)")
+    h.scheduler.advance(by: 2)
+    #expect(ScenarioExpectation.check(["hidden", "\(mail.rawValue)"], harness: h, lastCommandOK: true) == nil, "or this proves nothing")
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(undo(h).ok)
+    #expect(ScenarioExpectation.check(["camera", "\(safari.rawValue)"], harness: h, lastCommandOK: true) == nil, "the view is on Safari again")
+    #expect(ScenarioExpectation.check(["hidden", "\(mail.rawValue)"], harness: h, lastCommandOK: true) == nil)
+    h.run("show-all")
+    h.scheduler.advance(by: 2)
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  /// The same, and in the Dock since: no layout places it there, so it is moved where nobody sees it, as the fetch does.
+  @Test func askedForWhileItWasOutOfViewAndInTheDockSince() {
+    let (h, safari, _, mail) = desk()
+    h.run("dock \(safari.rawValue) left")
+    h.run("zoom \(safari.rawValue)")
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    h.system.setMinimized(mail, true)
+    h.scheduler.advance(by: 2)
+    #expect(undo(h).ok)
+    #expect(ScenarioExpectation.check(["camera", "\(safari.rawValue)"], harness: h, lastCommandOK: true) == nil, "the view is on Safari again")
+    #expect(title(h, beginning: "Redo")?.title == "Redo Move")
+    h.system.setMinimized(mail, false)
+    settle(h)
+    h.run("show-all")
+    h.scheduler.advance(by: 2)
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  /// Asking for it moves the view, and from further out Arbor moves the gaps to make room for a docked window (F61). That alone is no step:
+  /// nobody rearranged anything. The fetch is one all the same.
+  @Test func roomThatArborMakesOnTheWayHidesNoStep() {
+    let (h, safari, notes, mail) = desk()
+    let big = h.system.open(
+      app: "Xcode", title: "Project", pid: 14, frame: CGRect(x: 400, y: 200, width: 900, height: 500),
+      minimumSize: CGSize(width: 900, height: 300))
+    for line in ["dock \(safari.rawValue) left", "dock \(notes.rawValue) right", "zoom \(notes.rawValue)", "dock \(big.rawValue) bottom"] {
+      #expect(h.run(line).ok)
+      h.scheduler.advance(by: 2)
+    }
+    #expect(h.controller.parked.contains(mail), "or this proves nothing")
+    let gaps = h.workspace.tree
+    ask(h, for: mail)
+    #expect(!h.workspace.tree.hasSameArrangement(as: gaps), "room was made, or this proves nothing")
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(h.controller.nextStepTitle(.undo) == "Move" && h.controller.nextStepLabel(.undo) == "reveal \(mail)")
+    #expect(undo(h).ok)
+    #expect(h.workspace.isDocked(big), "the dock is an older step, and stays")
+    h.run("show-all")
+    h.scheduler.advance(by: 2)
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  @Test func askedForOutOfTheDock() {
+    let (h, _, _, mail) = desk()
+    h.system.setMinimized(mail, true)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+    #expect(h.controller.windows[mail]?.isMinimized == false, "that it came out of the Dock is macOS's, and no step of Arbor's")
+  }
+
+  // MARK: Where floating windows make way
+
+  /// With that setting on, where a floating window is follows from the view: docked windows push it aside and squeeze it, and every layout
+  /// places it anew. There is no place to promise, so none is: it is a move that cannot be taken back.
+  @Test func whereFloatingWindowsMakeWayThereIsNoPlaceToPromise() {
+    let (h, safari, notes, mail) = desk(settings: .makingWay)
+    h.run("dock \(safari.rawValue) bottom")
+    h.run("dock \(notes.rawValue) bottom")
+    h.system.userMove(mail, to: CGRect(x: 1416, y: 400, width: 400, height: 300))
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    let fetched = h.frame(mail)
+    #expect(fetched?.maxX == 1440, "it was fetched, or this proves nothing")
+    #expect(title(h, beginning: "Undo")?.title == "Undo Dock")
+    let mark = h.system.moveLog.count
+    let refused = undo(h)
+    #expect(!refused.ok && refused.message == "cannot undo reveal \(mail); undo again to take back dock \(notes) bottom", "\(refused.message)")
+    #expect(h.system.moveLog[mark...].allSatisfy { $0.before == $0.after }, "nothing moves, and nothing is sized")
+    #expect(h.frame(mail) == fetched)
+    #expect(title(h, beginning: "Undo")?.title == "Undo Dock")
+  }
+
+  @Test(arguments: ["in view", "hidden", "minimized"]) func whereTheyMakeWayAndNothingIsOlderThereIsNothingToUndo(how: String) {
+    let (h, _, _, mail) = desk(settings: .makingWay)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    if how == "hidden" { h.system.setHidden(pid: 13, true) }
+    if how == "minimized" { h.system.setMinimized(mail, true) }
+    h.scheduler.advance(by: 2)
+    #expect(title(h, beginning: "Undo")?.isEnabled == false)
+    #expect(undo(h).message.hasPrefix("nothing to undo"))
+    #expect(h.frame(mail) == Self.fetched)
+  }
+
+  // MARK: It is saved
+
+  @Test func whereItIsAfterTheUndoIsSaved() throws {
+    let (h, _, _, mail) = desk()
+    ask(h, for: mail)
+    undo(h)
+    h.scheduler.advance(by: 5)
+    let saved = try #require(h.store.saved?.workspaces[h.display])
+    #expect(saved.floating[mail] == Self.parked)
+  }
+}
