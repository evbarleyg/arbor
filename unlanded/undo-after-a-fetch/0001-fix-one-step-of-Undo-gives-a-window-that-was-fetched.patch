+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  @Test(arguments: ["find Inbox", "reveal 103"]) func askedForByACommand(line: String) {
+    let (h, _, _, mail) = desk()
+    #expect(mail == WindowID(103))
+    #expect(h.run(line).ok)
+    settle(h)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(h.controller.nextStepLabel(.undo) == "reveal \(mail)" && h.controller.nextStepTitle(.undo) == "Move", "one name, by every road")
+    #expect(undo(h).ok)
+    #expect(h.frame(mail) == Self.parked)
+  }
+
+  // MARK: What is no step
+
+  /// Going to a window is no change to anything. Only the move is.
+  @Test func aWindowThatWasWholeLeavesNothingToUndo() {
+    let (h, _, notes, _) = desk()
+    #expect(ask(h, for: notes).ok)
+    #expect(!undo(h).ok)
+    #expect(title(h, beginning: "Undo")?.isEnabled == false)
+  }
+
+  /// Undo takes back what Arbor did, not what its person has done since.
+  @Test func movedByHandSinceItStaysWhereTheHandPutIt() {
+    let (h, _, _, mail) = desk()
+    ask(h, for: mail)
+    let since = CGRect(x: 200, y: 400, width: 400, height: 300)
+    h.system.userMove(mail, to: since)
+    h.scheduler.advance(by: 2)
+    #expect(title(h, beginning: "Undo")?.isEnabled == false, "and the menu offers nothing that would do nothing")
+    #expect(!undo(h).ok)
+    #expect(h.frame(mail) == since)
+  }
+
+  @Test func closedSinceThereIsNothingToUndo() {
+    let (h, _, _, mail) = desk()
+    ask(h, for: mail)
+    h.system.close(mail)
+    h.scheduler.advance(by: 2)
+    #expect(!undo(h).ok)
+  }
+
+  /// Arbor puts no window where no hand could get hold of it, whoever did before. So from there it was fetched for good, and an undo that
+  /// said "undid" and moved nothing would be worse than none.
+  @Test(arguments: [CGPoint(x: 1417, y: 500), CGPoint(x: 2000, y: 500), CGPoint(x: -377, y: 500), CGPoint(x: 500, y: 889)])
+  func aPlaceNoHandCouldReachIsNoPlaceToGoBackTo(origin: CGPoint) {
+    let (h, safari, _, mail) = desk()
+    h.system.userMove(mail, to: CGRect(origin: origin, size: Self.parked.size))
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    let fetched = h.frame(mail)
+    #expect(fetched.map { FakeWindowSystem.standardDisplay.visibleFrame.contains($0) } == true, "it was fetched, or this proves nothing")
+    #expect(title(h, beginning: "Undo")?.isEnabled == false)
+    #expect(!undo(h).ok)
+    #expect(h.frame(mail) == fetched)
+  }
+
+  /// Moved, never sized: there and back.
+  @Test(arguments: [1300, 1416, 1417] as [CGFloat]) func aWindowLargerThanTheDisplayKeepsItsSize(x: CGFloat) {
+    let (h, safari, _, mail) = desk()
+    let large = CGRect(x: x, y: 100, width: 1600, height: 500)
+    h.system.userMove(mail, to: large)
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: mail)
+    #expect(h.frame(mail) == CGRect(x: 0, y: 100, width: 1600, height: 500), "it was fetched, or this proves nothing")
+    // 24 points of its title bar are what a hand needs.
+    #expect(undo(h).ok == (x <= 1416))
+    #expect(h.frame(mail) == (x <= 1416 ? large : CGRect(x: 0, y: 100, width: 1600, height: 500)))
+    redo(h)
+    for line in ["relayout", "pause", "resume"] { h.run(line); h.scheduler.advance(by: 2) }
+    #expect(h.frame(mail)?.size == large.size)
+  }
+
+  /// One that is kept in view, summoned, or the guest of a view has its place by that, and layouts see to it. Nothing is offered that
+  /// the next layout would take back.
+  @Test(arguments: ["pinned", "summoned", "guest"]) func aWindowWithAPlaceOfAnotherKindIsNoStep(kind: String) {
+    let (h, safari, _, mail) = desk()
+    h.system.userMove(mail, to: CGRect(x: 500, y: 300, width: 400, height: 300))
+    switch kind {
+    case "pinned": #expect(h.run("pin \(mail.rawValue)").ok)
+    case "summoned": #expect(h.run("summon Mail").ok)
+    default:
+      h.system.close(mail)
+      h.run("dock \(safari.rawValue) left")
+      h.run("zoom \(safari.rawValue)")
+    }
+    let window = kind == "guest" ? h.system.open(app: "Mail", title: "Inbox", pid: 13, frame: CGRect(x: 500, y: 300, width: 400, height: 300)) : mail
+    h.scheduler.advance(by: 2)
+    h.system.userMove(window, to: Self.parked)
+    h.system.userFocus(safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: window)
+    #expect(h.frame(window) == Self.fetched, "it was fetched, or this proves nothing")
+    let mark = h.system.moveLog.count
+    #expect(!undo(h).ok, "nothing to undo, or, with something older in the history, that this cannot be")
+    #expect(h.system.moveLog[mark...].allSatisfy { $0.before == $0.after })
+    #expect(h.frame(window) == Self.fetched)
+  }
+
+  // MARK: A move that cannot be taken back is said once
+
+  /// Whoever has just seen Mail move and presses ⌃⌥Z means Mail. That Safari floats instead would be a window nobody meant, moved by one of
+  /// the nine keys. So it says once that the move cannot be undone and what the next press would undo, and moves nothing. The key is blind;
+  /// whoever reads the menu's row is told what is older, as after a close: a row names nothing that it will not do (the product owner,
+  /// 2026-10-15).
+  @Test(arguments: ["out of reach", "pinned", "guest"]) func aMoveThatCannotBeTakenBackIsSaidOnce(kind: String) throws {
+    let (h, safari, notes, mail) = desk()
+    #expect(h.run("dock \(notes.rawValue) left").ok)
+    var window = mail
+    switch kind {
+    case "pinned": #expect(h.run("pin \(mail.rawValue)").ok)
+    case "guest":
+      h.system.close(mail)
+      h.run("zoom \(notes.rawValue)")
+      window = h.system.open(app: "Mail", title: "Inbox", pid: 13, frame: CGRect(x: 500, y: 300, width: 400, height: 300))
+    default: break
+    }
+    h.scheduler.advance(by: 2)
+    h.system.userMove(window, to: kind == "out of reach" ? CGRect(x: 1430, y: 500, width: 400, height: 300) : Self.parked)
+    h.system.userFocus(kind == "guest" ? notes : safari)
+    h.scheduler.advance(by: 2)
+    ask(h, for: window)
+    #expect(h.frame(window) == Self.fetched, "it was fetched, or this proves nothing")
+    let row = try #require(title(h, beginning: "Undo"))
+    #expect(row.title == "Undo Dock" && row.isEnabled, "\(row.title)")
+
+    let mark = h.system.moveLog.count
+    let refused = undo(h)
+    #expect(!refused.ok && refused.message == "cannot undo reveal \(window); undo again to take back dock \(notes) left", "\(refused.message)")
+    #expect(h.system.moveLog[mark...].allSatisfy { $0.before == $0.after }, "nothing moves")
+    #expect(h.workspace.isDocked(notes))
+    // In words a person reads: no window's number on screen.
+    #expect(h.overlays.headsUp.values.map(\.line) == ["That move cannot be undone · ⌃⌥Z again undoes Dock"])
+
+    // Once.
+    #expect(title(h, beginning: "Undo")?.title == "Undo Dock")
+    #expect(undo(h).ok)
+    #expect(h.workspace.isFloating(notes))
+    #expect(h.frame(window) == Self.fetched)
+  }
