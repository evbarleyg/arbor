+    #expect(label?.contains("Inbox") == false && label?.contains("Mail") == false)
+    #expect(undo(h).message.contains("Inbox") == false)
+  }
+
+  // MARK: Whichever way it was asked for
+
+  @Test func askedForInGoTo() {
+    let (h, _, _, mail) = desk()
+    h.run("find")
+    h.overlays.typeInFinder("Inbox")
+    #expect(h.overlays.chooseInFinder())
+    settle(h)
+    #expect(h.frame(mail) == Self.fetched, "it was fetched, or this proves nothing")
+    #expect(h.controller.nextStepLabel(.undo) == "reveal \(mail)" && h.controller.nextStepTitle(.undo) == "Move", "one name, by every road")
