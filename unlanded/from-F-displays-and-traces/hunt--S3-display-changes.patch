+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// A HUNT, not a test for the suite: it takes a minute and a half and prints what it finds (lines that begin with DISPLAYHUNT). Kept on a plain branch.
+/// Run it with: swift test --filter LocalDisplayHunt 2>&1 | grep ^DISPLAYHUNT
+/// On c1adfe81 and on 1ccdffce alike: 18918 states, 255 lines, all one pattern (see LocalOneCaseTests).
+/// The corpus is of one display that never changes. So every real state
+/// (each trace cut before every stimulus) has its display changed under it, and then each way back of the guide is tried ALONE.
+@Suite @MainActor struct LocalDisplayHuntTests {
+  nonisolated static let folder = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+    .appendingPathComponent("collab/evidence/traces")
+  nonisolated static var names: [String] {
+    ((try? FileManager.default.contentsOfDirectory(atPath: folder.path)) ?? []).filter { $0.hasSuffix(".jsonl") }.sorted()
+  }
+
+  /// The same display with another size: the menu bar and the Dock keep their heights.
+  func resized(_ display: DisplaySnapshot, to size: CGSize) -> DisplaySnapshot {
+    var changed = display
+    let top = display.visibleFrame.minY - display.frame.minY
+    let bottom = display.frame.maxY - display.visibleFrame.maxY
+    changed.frame.size = size
+    changed.visibleFrame = CGRect(x: display.frame.minX, y: display.frame.minY + top, width: size.width, height: size.height - top - bottom)
+    return changed
+  }
+
+  @Test(arguments: names) func afterTheDisplayChangedEveryWayBackReturnsEveryWindow(name: String) throws {
+    let text = try String(contentsOf: Self.folder.appendingPathComponent(name), encoding: .utf8)
+    let lines = text.split(separator: "\n", omittingEmptySubsequences: false).map(String.init)
+    var cuts = try Trace(text: text).entries.filter { $0.line.isStimulus && !$0.nested }.map(\.number)
+    cuts.append(lines.count + 1)
+    var states = 0
+    var failures: [String] = []
+    var heard = true
+    for cut in cuts where cut > 2 {
+      let prefix = try Trace(text: lines.prefix(cut - 1).joined(separator: "\n"))
+      var inHand: WindowID?
+      for entry in prefix.entries {
+        switch entry.line {
+        case .dragBegan(let id, _): inHand = id
+        case .dragEnded, .other(.event, "dragCancelled", _, _): inHand = nil
+        default: break
+        }
+      }
+      for change in ["shrinks", "grows", "shrinks and is as it was"] {
+        for way in ["nothing", "home", "show-all", "float-all", "quit", "quit, start, float-all"] {
+          let replayer = TraceReplayer(prefix)
+          replayer.run()
+          let h = replayer.harness
+          guard h.controller.isRunning, let display = h.system.displayList.first else { continue }
+          states += 1
+          let before = Set(h.system.windows.values.map(\.snapshot).filter { $0.isPresent && h.system.isVisible($0.id) }.map(\.id))
+          // In a replay's harness nobody listens to the fake (`events` is nil: the replayer delivers events itself), so the controller is told.
+          func become(_ new: DisplaySnapshot) {
+            h.system.setDisplays([new])
+            h.controller.displaysChanged()
+            h.scheduler.runPending()
+          }
+          become(resized(display, to: change == "grows" ? CGSize(width: 1728, height: 1117) : CGSize(width: 800, height: 600)))
+          if change.hasSuffix("as it was") { become(display) }
+          heard = heard && h.controller.display(display.id)?.frame == h.system.displayList[0].frame
+          switch way {
+          case "nothing": break
+          case "quit": h.controller.shutdown()
+          case "quit, start, float-all":
+            h.controller.shutdown()
+            h.controller.start()
+            h.scheduler.runPending()
+            h.run("float-all")
+          default: h.run(way)
+          }
+          h.scheduler.runPending()
+          // A space too small to show its window is a tile, which stands for it and can be clicked: that window is not lost.
+          let inTiles = Set(["nothing", "home", "show-all"].contains(way) ? (h.layout?.tiles.flatMap(\.windows) ?? []) : [])
+          let lost = h.system.windows.values.map(\.snapshot).filter { $0.isPresent && !h.system.isVisible($0.id) && $0.id != inHand && !inTiles.contains($0.id) }
+          // With nothing done, only what WAS in view counts: Arbor keeps windows out of view on purpose.
+          for window in lost.sorted(by: { $0.id < $1.id }) where way != "nothing" || before.contains(window.id) {
+            failures.append("\(change) | \(way) | line \(cut) | \(window.id) \(window.appName) at \(traceText(window.frame))")
+          }
+        }
+      }
+    }
+    print("DISPLAYHUNT \(name): \(cuts.count) cuts, \(states) states, \(failures.count) failures")
+    #expect(heard, "the controller did not hear of a change")
+    for failure in failures { print("DISPLAYHUNT   \(name) | \(failure)") }
+  }
+}
