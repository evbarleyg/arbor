+import ArborCore
+import ArborKit
+import ArborTesting
+import CoreGraphics
+import Foundation
+import Testing
+
+/// The one pattern the hunt found, every way a person has, each alone (lines that begin with WAYS). When a display shrinks so far that the Desktop's
+/// space becomes a tile, a floating window squeezed onto it is not refitted: Arbor makes no call for it. home, show-all, ⌘Tab, focus and reveal do
+/// not fetch it; `desktop`, a click on the Desktop's tile, arrange, float-all and quitting do.
+@Suite @MainActor struct LocalOneCaseTests {
+  @Test func theSqueezedWindowEveryWay() throws {
+    let text = try String(contentsOf: LocalDisplayHuntTests.folder.appendingPathComponent("seam-drag.jsonl"), encoding: .utf8)
+    let id = WindowID(30)
+    for size in [CGSize(width: 800, height: 600), CGSize(width: 960, height: 600), CGSize(width: 900, height: 700)] {
+      for way in ["home", "show-all", "desktop", "click the Desktop's tile", "cmd-tab to it", "reveal 30", "focus 30", "arrange", "zoom 31", "float-all", "quit"] {
+        let replayer = TraceReplayer(try Trace(text: text))
+        replayer.run()
+        let h = replayer.harness
+        var display = h.system.displayList[0]
+        display.frame.size = size
+        display.visibleFrame = CGRect(x: 0, y: 31, width: size.width, height: size.height - 94)
+        h.system.setDisplays([display])
+        h.controller.displaysChanged()
+        h.scheduler.runPending()
+        let after = h.system.frame(of: id)!
+        let desktopIsATile = h.layout?.tiles.contains { $0.kind == .desktop } ?? false
+        var reply = ""
+        switch way {
+        case "quit": h.controller.shutdown()
+        case "cmd-tab to it":
+          h.system.focused = id
+          h.controller.windowFocused(id)
+        case "click the Desktop's tile":
+          if let tile = h.layout?.tiles.first(where: { $0.kind == .desktop }) { h.controller.tileActivated(display: display.id, node: tile.node) } else { reply = "(no tile)" }
+        default: reply = h.run(way).message
+        }
+        h.scheduler.runPending()
+        let frame = h.system.frame(of: id)!
+        let share = frame.fractionInside(display.frame)
+        print("WAYS \(Int(size.width))x\(Int(size.height)) desktop a tile: \(desktopIsATile) | after the change \(traceText(after)) | \(way) | \(traceText(frame)) | in view \((share * 100).rounded())% | \(reply.prefix(60))")
+      }
+    }
+  }
+}
