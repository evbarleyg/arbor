@@ -0,0 +1,57 @@
+#!/bin/bash
+# What lies on the display after the permission has come late: on a first day, and on a later day (collab/BOARD.md, 1.114). A probe.
+#
+#   scripts/mac-shell/run.sh --as-a-person late --no-preflight "<why>" scripts/mac-shell/probe-the-welcome-after-a-late-grant.sh
+#
+# Every script starts Arbor with ARBOR_NO_PROMPT=1, which no person sets: it keeps the welcome window shut. Read in the source: whoever starts Arbor without the
+# permission gets that window, on any day, before anybody looks whether it has been seen (`welcomed` in state.json). That it opens is right. What follows is the
+# question: whoever had been welcomed before this launch is no newcomer, and at the grant the window has done what it came for.
+#
+# Here, without the variable: a first day (no state.json; the app through Launch Services, seen waiting, granted while it waits), a quit, and a later day that
+# begins the same way, as after every update of a build without a certificate. After each grant: a picture at once, one ten seconds later, and Arbor's own
+# windows as the window server has them.
+#
+# Nothing here is a verdict but its premises: the pictures and the lists are the point, before 1.114 and after it. It cannot be rehearsed: the fake Mac has no Launch Services and no privacy database.
+source "$(dirname "$0")/lib.sh"
+needs_throwaway_mac "write to the privacy database and open Arbor.app"
+# Whatever the run says: this is about the late grant.
+ARBOR_AS_A_PERSON=late
+
+arbor_build
+
+# look <name>: a picture, Arbor's own windows, who is in front, what the file says
+look() {
+  shot "$1"
+  echo "Arbor's own windows (id pid level x y w h on owner):"
+  overlays
+  echo "in front: $(lsappinfo info -only name "$(lsappinfo front)" 2>&1 | tr -d '\n')"
+  echo "state.json says of the welcome: $(grep -o '"welcomed" *: *[a-z]*' "$ARBOR_HOME/state.json" 2>/dev/null || echo "nothing (no file, or no such key)")"
+  "$ARBOR_BIN/arborctl" status | head -n 2
+}
+
+step "a first day: no state.json, the permission comes while Arbor waits"
+arbor_start 3 ARBOR_NO_PROMPT=0 ARBOR_NO_STATUS_ITEM=0 ARBOR_NO_HOTKEYS=0
+look 01-first-day-at-the-grant
+sleep 10
+look 02-first-day-ten-seconds-later
+summary
+check "the first day's launch wrote down that the welcome has been seen" eventually grep -q '"welcomed" *: *true' "$ARBOR_HOME/state.json"
+arbor_quit
+look_file() { grep -o '"welcomed" *: *[a-z]*' "$ARBOR_HOME/state.json"; }
+echo "after the quit: $(look_file)"
+
+step "a later day, the permission late again: a build over an earlier one"
+# arbor_launch and not arbor_relaunch: the entry is forgotten again, and the same home, settings and state.json are there.
+arbor_launch ARBOR_NO_PROMPT=0 ARBOR_NO_STATUS_ITEM=0 ARBOR_NO_HOTKEYS=0
+look 03-later-day-at-the-grant
+sleep 10
+look 04-later-day-ten-seconds-later
+summary
+
+step "a day after that, the permission in place"
+arbor_quit
+arbor_relaunch ARBOR_NO_PROMPT=0 ARBOR_NO_STATUS_ITEM=0 ARBOR_NO_HOTKEYS=0
+sleep 2
+look 05-the-day-after
+grep -iE "welcome|onboard" "$ARBOR_HOME/arbor.log" | cut -c 12- | tail -n 30
+arbor_stop 06-quit
