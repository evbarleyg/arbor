#!/usr/bin/env python3
"""Stands in, under their names, for what a Mac shell script about REAL APPS calls, in a rehearsal (scripts/mac-shell/rehearse.sh):
`open -g`, `swiftc`, and the helper tool apptool. Each knows the few uses probe-place.sh makes of it, and refuses the rest with exit code 64, so that a script that needs more is noticed.

arbor-fakemac knows test windows and Arbor. These apps it does not know, and Arbor cannot be started on them: this is for acts in which Arbor does not run.

An app's window is a file, $ARBOR_REHEARSAL_DIR/apps/<window>, of one line:  pid bundle-id x y w h <ms the app takes to answer a call>
Whoever moves the window rewrites the file in one go. There is no process behind an app: its pid is a number Linux never hands out (they end at 4194304), so that no signal meant for an
app can reach anybody.

  swiftc     compiles nothing: where the tool was to be it leaves a link to this file. But glide.swift is compiled, by the real compiler: it has a few lines
             for this world, so that the rest of it is rehearsed and not a copy of it.
"""
import glob
import os
import sys

TOOL = os.path.basename(sys.argv[0])
ARGUMENTS = sys.argv[1:]
WORLD = os.path.join(os.environ.get("ARBOR_REHEARSAL_DIR", "."), "apps")
# Manners, so that whoever judges a rehearsal has something to find: one app that answers late.
SLOW = {"com.apple.mail": 45}


def refuse():
    sys.exit(print(f"{TOOL} (rehearsal): no stand-in for: {TOOL} {' '.join(ARGUMENTS)}", file=sys.stderr) or 64)


def windows():
    """{window: [pid, bundle, x, y, w, h, ms]}, all strings."""
    found = {}
    for path in glob.glob(os.path.join(WORLD, "[0-9]*")):
        try:
            with open(path, encoding="utf-8") as file:
                fields = file.read().split()
        except OSError:
            continue
        if len(fields) >= 7 and os.path.basename(path).isdigit():
            found[int(os.path.basename(path))] = fields
    return found


def put(window, fields):
    path = os.path.join(WORLD, str(window))
    with open(path + ".new", "w", encoding="utf-8") as file:
        file.write(" ".join(fields))
    os.replace(path + ".new", path)


def open_app():
    if "-g" not in ARGUMENTS:
        os.execv(os.environ["ARBOR_FAKEMAC"], [os.environ["ARBOR_FAKEMAC"], "open"] + ARGUMENTS)
    bundle = ARGUMENTS[ARGUMENTS.index("-b") + 1] if "-b" in ARGUMENTS else refuse()
    os.makedirs(WORLD, exist_ok=True)
    known = windows()
    if any(fields[1] == bundle for fields in known.values()):
        return
    count = len(known)
    put(9001 + count, [str(5000001 + count), bundle, str(100 + 30 * count), str(60 + 25 * count), "640", "460", str(SLOW.get(bundle, 1))])


def swiftc():
    source = next((word for word in ARGUMENTS if word.endswith(".swift")), None)
    if source is None or "-o" not in ARGUMENTS:
        refuse()
    tool, out = os.path.basename(source)[:-6], ARGUMENTS[ARGUMENTS.index("-o") + 1]
    if tool == "glide":
        here = os.path.dirname(os.path.abspath(sys.argv[0]))
        for folder in os.environ["PATH"].split(":"):
            if os.path.abspath(folder) != here and os.access(os.path.join(folder, "swiftc"), os.X_OK):
                os.execv(os.path.join(folder, "swiftc"), ["swiftc"] + ARGUMENTS)
        refuse()
    if tool != "apptool":
        refuse()
    if os.path.lexists(out):
        os.remove(out)
    os.symlink(os.path.realpath(__file__), out)


def apptool():
    command, rest, known = ARGUMENTS[0] if ARGUMENTS else "", ARGUMENTS[1:], windows()
    if command == "pid":
        pids = [fields[0] for fields in known.values() if fields[1] == rest[0]]
        print(*pids[:1])
        sys.exit(0 if pids else 1)
    elif command in ("windows", "wait-window"):
        for window, fields in sorted(known.items()):
            if fields[0] == rest[0]:
                print(window, "AXWindow AXStandardWindow", *fields[2:6], "main")
    elif command not in ("raise", "activate"):
        refuse()


{"open": open_app, "swiftc": swiftc, "apptool": apptool}.get(TOOL, refuse)()
