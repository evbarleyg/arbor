#!/bin/bash
# Stands in, under their names, for the macOS commands that Mac shell scripts call, in a rehearsal
# (scripts/mac-shell/rehearse.sh). Each knows the few uses that lib.sh and the scripts make of it and refuses
# the rest, so that a script that needs more is noticed.
tool=${0##*/}
display=${ARBOR_REHEARSAL_DISPLAY:-1024x768}
display=${display%% *}

refuse() {
  echo "$tool (rehearsal): no stand-in for: $tool $*" >&2
  exit 64
}

case "$tool" in
  screencapture)
    # The path comes last. A black pixel: a picture of a Mac that is not there.
    for path in "$@"; do :; done
    case "${path:-}" in "" | -*) refuse "$@" ;; esac
    {
      printf '\211\120\116\107\015\012\032\012\000\000\000\015\111\110\104\122\000\000\000\001\000\000\000\001'
      printf '\010\000\000\000\000\072\176\233\125\000\000\000\012\111\104\101\124\170\332\143\140\000\000\000'
      printf '\002\000\001\345\047\336\374\000\000\000\000\111\105\116\104\256\102\140\202'
    } > "$path"
    ;;

  sips)
    case "${1:-}" in
      -g) [ "${2:-}" = pixelWidth ] || refuse "$@"; echo "${3:-}"; echo "  pixelWidth: ${display%x*}" ;;
      --resampleWidth) ;;
      *) refuse "$@" ;;
    esac
    ;;

  sw_vers)
    case "${1:-}" in
      -productVersion | -buildVersion) echo rehearsal ;;
      -productName) echo macOS ;;
      *) refuse "$@" ;;
    esac
    ;;

  defaults)
    store="$ARBOR_REHEARSAL_DIR/defaults"
    mkdir -p "$store"
    case "${1:-}" in
      read)
        [ $# -eq 3 ] || refuse "$@"
        if [ -f "$store/$2.$3" ]; then
          cat "$store/$2.$3"
        else
          echo "The domain/default pair of ($2, $3) does not exist" >&2
          exit 1
        fi
        ;;
      write)
        case "${4:-}" in
          -bool) case "${5:-}" in true | yes | 1) echo 1 ;; *) echo 0 ;; esac > "$store/$2.$3" ;;
          -int | -string | -float) echo "${5:-}" > "$store/$2.$3" ;;
          *) refuse "$@" ;;
        esac
        ;;
      delete) [ $# -eq 3 ] || refuse "$@"; rm -f "$store/$2.$3" ;;
      *) refuse "$@" ;;
    esac
    ;;

  killall) ;;

  launchctl)
    case "${1:-}" in
      managername) echo Aqua ;;
      *) refuse "$@" ;;
    esac
    ;;

  system_profiler)
    [ "${1:-}" = SPDisplaysDataType ] || refuse "$@"
    echo "Graphics/Displays:"
    echo "    Rehearsal:"
    echo "      Chipset Model: none"
    echo "      Displays:"
    echo "        Display:"
    echo "          Resolution: ${display%x*} x ${display#*x}"
    echo "          UI Looks like: ${display%x*} x ${display#*x}"
    ;;

  sysctl)
    [ "${1:-}" = -n ] && [ "${2:-}" = hw.ncpu ] || refuse "$@"
    echo 1
    ;;

  # Linux images often lack it. One expression on stdin, as `film` gives it.
  bc) python3 -c 'import sys; print(round(eval(sys.stdin.read(), {"__builtins__": {}}), 2))' ;;

  # The world's clock moves with what is done to it, not with the real one. A wait of under a second is polling,
  # and only has to give the stand-ins that run in the background their turn. A longer one waits for something
  # that takes time (a timed pause, say), so it is one more thing done to the world: that much time passes
  # there.
  sleep)
    case "${1:-}" in
      0 | 0.0 | 0.00) ;;
      0.* | .*) exec /bin/sleep 0.02 ;;
      *) if [ -n "${ARBOR_HOME:-}" ]; then exec "$ARBOR_FAKEMAC" sleep "$@"; else exec /bin/sleep 0.02; fi ;;
    esac
    ;;

  *) refuse "$@" ;;
esac
