#!/bin/bash
# Stands in for Arbor in a rehearsal (scripts/mac-shell/rehearse.sh). The Arbor of the session's world starts,
# and this process lives for as long as that one does: until a command, the menu or a signal ends it. Started
# under a path like Arbor.app/Contents/MacOS/Arbor it is the installed app.

# Where nobody collects the dead (a container whose first process does not), an orphan that was killed stays for
# ever as a zombie, which still takes signals.
alive() {
  local state=""
  kill -0 "$1" 2>/dev/null || return 1
  [ -r "/proc/$1/stat" ] || return 0
  read -r _ _ state _ 2>/dev/null < "/proc/$1/stat"
  [ "$state" != Z ]
}

# `Arbor --watchdog <pid>`: waits for that Arbor to end and, unless it quit in good order, starts it again.
if [ "${1:-}" = --watchdog ]; then
  while alive "$2"; do
    /bin/sleep 0.05
  done
  verdict=$("$ARBOR_FAKEMAC" arbor-watchdog "$2") || exit
  case "$verdict" in
    "") exit 0 ;;
    rescue*) export ARBOR_RESCUE=1 ;;
  esac
  export ARBOR_RESTARTS=${verdict#* }
  exec "$0"
fi

case "$0" in
  *.app/Contents/MacOS/*) bundled=1 ;;
  *) bundled=0 ;;
esac
marker="${ARBOR_HOME%/*}/arbor.pid"

# The real one's signal handlers quit cleanly. SIGKILL cannot be caught: the next stand-in to run notices.
ended() {
  "$ARBOR_FAKEMAC" arbor-term $$
  exit 0
}
trap ended TERM INT HUP

# As ArborEnvironment reads a flag. A rescue has no watchdog.
watchdog=""
case "${ARBOR_NO_WATCHDOG:-}${ARBOR_RESCUE:+ rescue}" in
  "" | 0 | [Ff][Aa][Ll][Ss][Ee] | [Nn][Oo])
    "$0" --watchdog $$ > /dev/null 2>&1 &
    watchdog=$! ;;
esac

"$ARBOR_FAKEMAC" arbor-start $$ "$bundled" ${watchdog:+"watchdog=$watchdog"}
code=$?
if [ "$code" -ne 0 ]; then
  # A second copy leaves (75) before it has a watchdog.
  [ -z "$watchdog" ] || kill "$watchdog" 2>/dev/null
  exit "$code"
fi
# Nor does it outlive the script that started it, should that be killed: nobody would be left to end it.
while read -r pid 2>/dev/null < "$marker" && [ "$pid" = $$ ] && kill -0 "$PPID" 2>/dev/null; do
  /bin/sleep 0.05
done
exit 0
