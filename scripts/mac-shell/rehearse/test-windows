#!/bin/bash
# Stands in for ArborTestWindows in a rehearsal (scripts/mac-shell/rehearse.sh): says hello, answers one request
# per line of stdin, and ends, closing its windows, when stdin closes. Under a name that ends in 2 it is the
# second app. Its own process id is the app's: scripts signal it and look for it in the list of windows.
case "${0##*/}" in
  *2) bundle=dev.arbor.testwindows2 name=ArborTestWindows2 ;;
  *) bundle=dev.arbor.testwindows name=ArborTestWindows ;;
esac

ended() {
  trap - TERM INT HUP
  "$ARBOR_FAKEMAC" app-exit $$
  exit 0
}
trap ended TERM INT HUP
# The real app comes to the front on the first and opens one more window on the second.
trap '"$ARBOR_FAKEMAC" app-request $$ SIGUSR1' USR1
trap '"$ARBOR_FAKEMAC" app-request $$ SIGUSR2' USR2

"$ARBOR_FAKEMAC" app-start $$ "$bundle" "$name" "$@" || exit
while :; do
  if IFS= read -r request; then
    "$ARBOR_FAKEMAC" app-request $$ "$request"
  else
    # Above 128 a signal interrupted the wait; anything else is the end of stdin.
    [ $? -gt 128 ] || break
  fi
done
ended
