#!/bin/sh
# Your eyes and hands on a Mac far away. HOWTO.md, beside this file, says how to use it.
#
#   ./mac look                     fetch the newest picture: screen.jpg, and a few lines about it
#   ./mac <an act>                 e.g. ./mac click 200 300: send it, wait until it has been carried out, fetch the picture after it
#   ./mac <a remark>               e.g. ./mac stuck "I cannot find where to begin": kept, and sent along with your next act
#
# Needs git, a shell and, for whatever holds words of your own, python3. Everything travels through two branches of a PUBLIC repository, so whatever
# you send can be read by anybody, for good. This script lets nothing through that it has not taken apart: see `numbers_and_names` and `clean` below.
LC_ALL=C TZ=UTC
export LC_ALL TZ
cd "$(dirname "$0")" || exit 2
run=$(cat run 2>/dev/null)
case "$run" in "" | *[!A-Za-z0-9-]*) echo "mac: there is no file 'run' here: is this the folder you cloned?" >&2; exit 2 ;; esac
screen="refs/heads/mac-shell-out/newcomer.$run.screen"
action="refs/heads/mac-shell-out/newcomer.$run.action"

die() { echo "mac: $*" >&2; exit 1; }

# fetch_screen: true when there is a picture newer than the one here. Only the picture and the lines about it are taken from what was fetched, never this
# script or what it runs: what you run here is what you cloned and could read.
fetch_screen() {
  git fetch --quiet --no-tags --depth 1 origin "+$screen:refs/newcomer/screen" 2>/dev/null || return 1
  [ "$(git show refs/newcomer/screen:round 2>/dev/null)" != "$(cat round 2>/dev/null)" ] || return 1
  for file in screen.jpg status.txt answers first.jpg over round; do
    git cat-file -e "refs/newcomer/screen:$file" 2>/dev/null || continue
    git show "refs/newcomer/screen:$file" > ".$file.new" && mv ".$file.new" "$file"
  done
}

show() {
  cat status.txt
  echo "the picture: $PWD/screen.jpg"
  [ ! -f over ] || echo "(it is over: nothing you send is looked at any more)"
}

is_modifier() { case "$1" in fn | ctrl | opt | shift | cmd) return 0 ;; esac; return 1; }
is_key() {
  case "$1" in
    [a-z0-9] | "[" | "]" | - | = | , | . | / | ";" | "'" | '`' | "\\") return 0 ;;
    space | return | enter | tab | escape | esc | delete | left | right | down | up | f[1-9] | f1[0-2]) return 0 ;;
  esac
  return 1
}
# chord <word> <keys too?>: ctrl+opt, or ctrl+opt+a
chord() {
  rest=$1
  while :; do
    case "$rest" in
      *+?*) piece=${rest%%+*}; rest=${rest#*+}; is_modifier "$piece" || return 1 ;;
      *) if [ -n "$2" ]; then is_key "$rest"; else is_modifier "$rest"; fi; return ;;
    esac
  done
}
# An act that is not text is numbers, `holding` with the names of keys, `keep`, or chords: nothing of anybody's can be spelled with those.
numbers_and_names() {
  for word in "$@"; do
    case "$word" in
      holding | keep) [ "$verb" != key ] || return 1 ;;
      -[0-9] | -[0-9][0-9] | [0-9] | [0-9][0-9] | [0-9][0-9][0-9] | [0-9][0-9][0-9][0-9]) [ "$verb" != key ] || is_key "$word" || return 1 ;;
      *) if [ "$verb" = key ]; then chord "$word" keys || return 1; else chord "$word" "" || return 1; fi ;;
    esac
  done
}

# clean <text>: whether words of your own may be made public. The repository's own check reads them; without it, or when it cannot tell, nothing is sent.
clean() {
  case "$1" in *[!\ -~]*) die "only plain ASCII characters can be sent" ;; esac
  case "$1" in
    *@* | *session_* | *claude.ai* | */Users/* | */home/* | */root/* | */mnt/* | */tmp/* | *ghp_* | *ghs_* | *github_pat* | *Bearer* | *sk-ant*)
      die "that looks like an address, a path on some machine, a working session or a key, and all you send is public: say it without" ;;
  esac
  command -v python3 > /dev/null 2>&1 || die "words of your own are read by a check that needs python3, and there is none here: only acts without words can be sent"
  printf '%s\n' "$1" | python3 check/scripts/public-check.py --text --mask > .checked 2>&1
  case $? in
    0) ;;
    1) grep '^✘' .checked >&2; die "all you send is public, and the repository's check found that in it: say it without" ;;
    *) die "the check that reads what you send could not tell whether it may be public, so it was not sent" ;;
  esac
}
remark() {
  case "$1" in "") die "$verb takes a few words: what happened, what you expected" ;; esac
  case "$1" in *[!A-Za-z0-9\ .,:\;\'\(\)?!+\"-]*) die "a remark is letters, digits, spaces and . , : ; ' ( ) ? ! + - only" ;; esac
  [ "$(printf '%s' "$1" | wc -c)" -le 200 ] || die "a remark is at most 200 characters long"
  clean "$1"
}

[ $# -gt 0 ] || { sed -n '2,9p' "$0" | cut -c 3-; exit 0; }
verb=$1
shift
case "$verb" in
  look)
    fetch_screen
    show
    exit 0 ;;
  stuck | surprised | wrong | lookup)
    [ ! -f .remarks ] || [ "$(wc -l < .remarks)" -lt 5 ] || die "five remarks are waiting already: act first (./mac wait 1 will do)"
    remark "$*"
    printf '%s %s\n' "$verb" "$*" >> .remarks
    echo "noted: it goes along with your next act"
    exit 0 ;;
  giveup) remark "$*" ;;
  type)
    [ -n "$*" ] || die "type takes the text to type"
    [ "$(printf '%s' "$*" | wc -c)" -le 120 ] || die "type takes at most 120 characters at a time"
    clean "$*" ;;
  ready | done | password) [ $# -eq 0 ] || die "$verb stands alone. What you want to say goes into a remark: ./mac surprised \"...\"" ;;
  click | double-click | right-click | move | drag | release | scroll | key | wait)
    [ $# -le 8 ] && numbers_and_names "$@" || die "after $verb come numbers, 'holding' with fn ctrl opt shift cmd, 'keep', or for key the names of keys: HOWTO.md has examples" ;;
  *) die "'$verb' is no word of this language: HOWTO.md lists them" ;;
esac

[ ! -f over ] || die "it is over: nothing you send is looked at any more"
round=$(cat round 2>/dev/null)
case "$round" in "" | *[!0-9]*) die "look first: ./mac look" ;; esac

# One commit without history, as everything under mac-shell-out/ is, under a name that is nobody's.
GIT_AUTHOR_NAME=mac-shell GIT_AUTHOR_EMAIL=mac-shell@users.noreply.github.com
GIT_COMMITTER_NAME=mac-shell GIT_COMMITTER_EMAIL=mac-shell@users.noreply.github.com
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
blob=$({ echo "$round"; cat .remarks 2>/dev/null; printf '%s\n' "$verb${*:+ $*}"; } | git hash-object -w --stdin) || die "git could not write the message"
tree=$(printf '100644 blob %s\taction\n' "$blob" | git mktree) || die "git could not write the message"
commit=$(git commit-tree "$tree" -m "mac-shell: newcomer $run answers picture $round") || die "git could not write the message"
tries=0
until git push --quiet --force origin "$commit:$action" 2> .push; do
  tries=$((tries + 1))
  [ "$tries" -lt 3 ] || { cat .push >&2; die "could not push; nothing was sent. Try the same again"; }
  sleep 2
done

# The Mac looks every two seconds, acts, lets the windows come to rest and pushes the next picture.
waited=0
until fetch_screen || [ "$(cat round 2>/dev/null)" != "$round" ]; do
  waited=$((waited + 1))
  [ "$waited" -lt "${NEWCOMER_TRIES:-90}" ] || die "no new picture after two minutes. ./mac look tries again; if it stays so, the Mac has gone"
  sleep "${NEWCOMER_NAP:-1}"
done
# Remarks that went with a word that came too late or was not understood were not written down: they wait for the next.
if [ "$(cat answers 2>/dev/null)" != "$round" ]; then
  echo "NOTE: the picture had changed before your word arrived, so it was NOT carried out. Look again, then act."
elif ! grep -q '^not understood' status.txt; then
  rm -f .remarks
fi
show
